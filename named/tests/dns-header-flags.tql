  server_ip: 192.0.2.53, query_name: "example.test",
  query_class: "IN", query_type: "A", flags: "+E(0)DCK"},
  {category: "query", time: 2025-01-01, client_ip: 192.0.2.1, client_port: 12345,
  server_ip: 192.0.2.53, query_name: "example.test",
  query_class: "IN", query_type: "A", flags: "+E(0)K"}
source = this
named::ocsf::map source, ocsf
this = ocsf
ocsf_cast
select flag_ids, unmapped.flags
