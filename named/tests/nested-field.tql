// Verifies that the normalizer only writes its selected output field, preserves
// unrelated siblings, and accepts nested input and output paths.
from {
  keep: "outer",
  event: {
    time: 2026-01-01T00:00:00Z,
    message: "client @0x7f00 192.0.2.44#53000 (www.example.com): query: www.example.com IN A +E(0)K (192.0.2.53)",
    keep: "inner",
  },
}

named::ocsf::normalize event, into=normalized
normalized.unmapped.source_keep = move event.keep
normalized.unmapped.has_message = event.message? != null
normalized.unmapped.outer_keep = move keep
this = move normalized
ocsf::cast

drop_null_fields
