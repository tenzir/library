// Verifies that the parser and mapper only write their selected output fields,
// preserve unrelated siblings, and accept nested field paths.
from {
  keep: "outer",
  event: {
    time: 2026-01-01T00:00:00Z,
    message: "client @0x7f00 192.0.2.44#53000 (www.example.com): query: www.example.com IN A +E(0)K (192.0.2.53)",
    keep: "inner",
  },
}

named::parse event.message, event.named
event.named.time = event.time
named::ocsf::map event.named, event.ocsf
event.ocsf.raw_data = event.message
event.ocsf.raw_data_size = event.message.length_bytes()
event.ocsf.unmapped.source_keep = move event.keep
event.ocsf.unmapped.has_message = event.message? != null
event.ocsf.unmapped.outer_keep = move keep
this = move event.ocsf
ocsf_cast

drop_null_fields
