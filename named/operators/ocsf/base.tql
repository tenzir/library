---
description: BIND named parsed record -> OCSF Base Event.
args:
  positional:
    - name: event
      description: The active mapping scope.
      type: field
---

@name = "ocsf.base_event"

$event.ocsf = {
  time: move $event.named.time,
  category_uid: 0,
  class_uid: 0,
  activity_id: 0,
  severity_id: 1,
  type_uid: 0,
  status_id: 0,
  metadata: {
    version: "1.9.0",
    log_name: "named",
    log_provider: "BIND",
    log_source: "named",
    original_time: move $event.named.native_time?,
    product: {
      name: "BIND named",
      vendor_name: "ISC",
    },
  },
}
