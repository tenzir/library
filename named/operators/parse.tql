---
description: |
  Parses an ISC BIND `named` message body.

  The first positional field holds the raw message body, not the full Syslog
  envelope. The second receives the structured BIND event:

  ```tql
  named::parse message, event
  ```

  The parser leaves the input field unchanged. It does not add a timestamp or
  provenance because those belong to the carrier around the message.
args:
  positional:
    - name: log
      type: field
      description: The source field to parse.
    - name: named
      type: field
      description: The field that receives the parsed event.
---

if $log == null {
  @name = "named.parser_error"
  $named = {
    category: "parser",
    template: "missing_message",
    parser: {
      warning: "missing required input field",
      field: "message",
    },
  }
} else {
  // Snapshot the input so the output may safely replace its carrier.
  $named = {source: $log, event: null}
  named::parsers::client $named.source, $named.event
  if $named.event.category? == null {
    named::parsers::fallback $named.source, $named.event
  }
  $named = move $named.event
}
