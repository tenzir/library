// One segment per datagram.
// Synthetic ISE record; every value is invented.
from_file env("TENZIR_INPUT") {
  read_lines
}
this = line.parse_syslog(accept_pri_only=true)
at = 2026-05-11T06:14:21Z
cisco::ise::reassemble message=content, on=at, span=1s
drop at
cisco::ise::parse message=content
cisco::ise::ocsf::normalize
select message, class_uid, user=user.name, truncated=metadata.is_truncated?
