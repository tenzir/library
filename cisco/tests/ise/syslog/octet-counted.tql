// RFC 6587 octet counting, as some TCP senders use it.
// Synthetic ISE record; every value is invented.
from_file env("TENZIR_INPUT") {
  read_syslog accept_pri_only=true
}
body = move content? else message?
category = app_name? if app_name?.starts_with("CISE_")
// The syslog time of a finite file replaces the arrival time.
at = 2026-05-11T06:14:21Z
cisco::ise::reassemble message=body, category=category, on=at, span=1s
drop category, at
cisco::ise::parse message=body
cisco::ise::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
sort metadata.sequence
select message, class_uid, incomplete=metadata.is_truncated?
