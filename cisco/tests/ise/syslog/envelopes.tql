// The envelopes that ISE and relays write. One segment per line stays one event.
// Synthetic ISE record; every value is invented.
from_file env("TENZIR_INPUT") {
  read_syslog accept_pri_only=true
}
// The syslog time of a finite file replaces the arrival time.
at = 2026-05-11T06:14:21Z
cisco::ise::ocsf::normalize on=at, span=1s
this = ocsf_cast(ocsf_derive(this))
sort metadata.sequence
select user=user.name, time, category=metadata.log_name, reporter=metadata.reporter?, relay=metadata.loggers?[0]?.name?, truncated=metadata.is_truncated?, class_uid
