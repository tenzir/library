// An alarm has neither counters nor an own time.
// Synthetic ISE record; every value is invented.
from_file env("TENZIR_INPUT") {
  read_syslog accept_pri_only=true
}
cisco::ise::ocsf::normalize timezone="Europe/Berlin"
this = ocsf_cast(ocsf_derive(this))
// The year of the header time follows the clock of the test.
time = time.format_time("%m-%dT%H:%M:%SZ")
