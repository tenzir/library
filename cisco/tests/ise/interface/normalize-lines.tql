// Raw lines, without a syslog parser in front.
// Synthetic ISE record; every value is invented.
from_file env("TENZIR_INPUT") {
  read_lines
}
at = 2026-05-11T06:14:21Z
cisco::ise::ocsf::normalize on=at, span=1s
select sequence=metadata.sequence, class_uid, user=user.name?, node=metadata.reporter?.hostname?, relay=metadata.loggers?[0]?.name?, truncated=metadata.is_truncated?, unmapped
sort sequence
