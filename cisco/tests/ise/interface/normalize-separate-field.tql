// The same events next to the fields of the source event.
// Synthetic ISE record; every value is invented.
from_file env("TENZIR_INPUT") {
  read_syslog accept_pri_only=true
}
this = {syslog: this, at: 2026-05-11T06:14:21Z}
cisco::ise::ocsf::normalize syslog, into=ocsf, on=at, span=1s
sort ocsf.metadata.sequence, ocsf.raw_data
