// After three spans, a repeated message counts again.
// Synthetic ISE record; every value is invented.
from_file env("TENZIR_INPUT") {
  read_ndjson
}
delay ts
cisco::ise::reassemble on=ts, span=500ms
select message_id=message.split(" ")[1], message, reassembly
sort message_id, reassembly.origin?, message
