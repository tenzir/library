// A collector keeps the sending node in an own field.
// Synthetic ISE record; every value is invented.
from_file env("TENZIR_INPUT") {
  read_ndjson
}
cisco::ise::reassemble message, reassembly, on=ts, span=1s, origin=sender
select message_id=reassembly.message.split(" ")[1], reassembly
sort message_id, reassembly.origin?, reassembly.message
