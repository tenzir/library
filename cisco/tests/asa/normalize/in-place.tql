// In-place and separate-field calls give the same result.
from {
  event: {
    timestamp: "Mar 05 2026 09:17:59",
    hostname: "fw-north",
    content: "%ASA-6-605005: Login permitted from 198.51.100.48/50822 to mgmt:192.0.2.1/ssh for user \"noc-48\"",
  },
}, {
  event: {
    raw: "<166>Mar 05 2026 09:18:01 fw-north : %ASA-6-605005: Login permitted from 198.51.100.53/50822 to mgmt:192.0.2.1/ssh for user \"noc-53\"",
  },
}, {
  event: {
    hostname: "fw-north",
    content: "Link inside is up",
  },
}
cisco::asa::ocsf::normalize event, into=separate
cisco::asa::ocsf::normalize event, into=event
assert event == separate
select raw_data=event.raw_data, class_uid=event.class_uid
sort raw_data
