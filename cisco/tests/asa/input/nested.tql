// The operators stay within their fields, and a shipper can parse the header.
from {
  shipper: "collector-2",
  log: {
    timestamp: 2026-03-05T09:10:35Z,
    hostname: "fw-north",
    body: "%ASA-6-605005: Login permitted from 198.51.100.28/50822 to mgmt:192.0.2.1/ssh for user \"noc-28\"",
  },
}
cisco::asa::parse message=log.body, event=log
cisco::asa::ocsf::map log, ocsf
ocsf = ocsf_cast(ocsf_derive(ocsf))
