// Stages in between add what the message lacks, and the mapper adds no provenance.
from {
  keep: "outer",
  log: {
    time: 2026-03-05T09:10:35Z,
    message: "%ASA-6-605005: Login permitted from 198.51.100.52/50822 to mgmt:192.0.2.1/ssh for user \"noc-52\"",
    keep: "inner",
  },
}
cisco::asa::parse log.message, log.asa
log.asa.timestamp = log.time
log.asa.hostname = "fw-north"
cisco::asa::ocsf::map log.asa, log.ocsf
