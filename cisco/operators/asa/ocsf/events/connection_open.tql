---
description: Cisco ASA built connections → OCSF Network Activity
args:
  positional:
    - name: event
      type: field
      description: The parsed Cisco ASA event.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

@name = "ocsf.network_activity"
$ocsf.category_uid = 4
$ocsf.class_uid = 4001
$ocsf.activity_id = 1
$ocsf.type_uid = 400101
$ocsf.metadata.profiles = ["security_control"]

cisco::asa::ocsf::network_endpoints $event, $ocsf

// ASA names the endpoint on the less secure interface first, which initiated
// an inbound connection. The other endpoint initiated an outbound one. A
// state-bypass connection has no direction and names the initiator first.
$ocsf.initiator_id = 1
if $ocsf.connection_info.direction_id == 2 {
  $ocsf = {
    ...$ocsf,
    src_endpoint: $ocsf.dst_endpoint,
    dst_endpoint: $ocsf.src_endpoint,
  }
}
// ASA builds a connection for the first packet, so the message doesn't tell
// whether the responder accepts it.
$ocsf.status_id = 0
$ocsf.action_id = 1
$ocsf.disposition_id = 1

// The name at the end is the user of the host that initiated the connection.
if $event.user? != null {
  $ocsf.metadata.profiles = ["host", "security_control"]
  cisco::asa::ocsf::user $event.user, $ocsf.actor.user
}
