---
description: Cisco ASA address translations → OCSF Network Activity
args:
  positional:
    - name: event
      type: field
      description: The parsed Cisco ASA event.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

@name = "ocsf.network_activity"
$ocsf.category_uid = 4
$ocsf.class_uid = 4001
// A translation is no connection: ASA builds it before the connections that
// use it and keeps it after them.
$ocsf.activity_id = 99
$ocsf.activity_name = f"{move $event.operation} translation"
$ocsf.type_uid = 400199
$ocsf.status_id = 1

cisco::asa::ocsf::network_endpoints $event, $ocsf
$ocsf.duration = int(move $event.duration? / 1ms)
