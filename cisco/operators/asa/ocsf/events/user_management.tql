---
description: Cisco ASA changes of local users → OCSF User Management
args:
  positional:
    - name: event
      type: field
      description: The parsed Cisco ASA event.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

@name = "ocsf.user_management"
$ocsf.category_uid = 3
$ocsf.class_uid = 3007
let $activities = {
  "113006": 6,
  "502101": 1,
  "502102": 3,
}
$ocsf.activity_id = $activities[$event.message_id.string()]
$ocsf.type_uid = 300700 + $ocsf.activity_id
$ocsf.status_id = 1
if $event.user? != null {
  cisco::asa::ocsf::user $event.user, $ocsf.user
}
