---
description: Cisco ASA torn down connections → OCSF Network Activity
args:
  positional:
    - name: event
      type: field
      description: The parsed Cisco ASA event.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

@name = "ocsf.network_activity"
$ocsf.category_uid = 4
$ocsf.class_uid = 4001
$ocsf.activity_id = 2
$ocsf.status_id = 1

cisco::asa::ocsf::network_endpoints $event, $ocsf

// A teardown names the endpoint on the less secure interface first but not who
// initiated the connection, except for state-bypass connections.
$ocsf.initiator_id = 1 if $event.message_id == 302304 else 0
$ocsf.duration = int(move $event.duration? / 1ms)
if $event.bytes? != null {
  $ocsf.traffic = {bytes: move $event.bytes}
}

// Reasons that tell an abnormal end, without spaces. Cisco writes resets of a
// host as `TCP Reset-I` and as `TCP Reset - I`.
let $reset_reasons = [
  "tcpreset-i",
  "tcpreset-o",
  "tcpreset-appliance",
  "invalidsyn",
  "tcpinvalidsyn",
  "tcpbadretransmission",
  "tcpsegmentpartialoverlap",
  "tcpunexpectedwindowsizevariation",
  "flowisaloopback",
  "syncontrol",
]
let $block_reasons = [
  "denyterminate",
  "flowclosedbyinspection",
  "flowterminatedbyips",
  "flowresetbyips",
  "flowterminatedbytcpintercept",
  "ipsfail-close",
  "unauthdeny",
]
let $fail_reasons = [
  "syntimeout",
  "novalidadjacency",
  "probemaximumretriesofretransmissionexceeded",
  "probemaximumretransmissiontimeelapsed",
]
$ocsf.status_detail = move $event.reason?
if $ocsf.status_detail != null {
  $ocsf._reason = $ocsf.status_detail.to_lower().replace(" ", "")
  if $ocsf._reason in $reset_reasons {
    // A reset can answer the first packet or end an established connection.
    $ocsf.activity_id = 3
    $ocsf.status_id = 0
  } else if $ocsf._reason in $block_reasons {
    $ocsf.activity_id = 3
    $ocsf.status_id = 2
    $ocsf.metadata.profiles = ["security_control"]
    $ocsf.action_id = 2
    $ocsf.disposition_id = 2
  } else if $ocsf._reason in $fail_reasons {
    $ocsf.activity_id = 4
    $ocsf.status_id = 2
  }
  drop $ocsf._reason
}
$ocsf.type_uid = 400100 + $ocsf.activity_id

if $event.user? != null {
  $ocsf.metadata.profiles = ["host", ...$ocsf.metadata.profiles?]
  cisco::asa::ocsf::user $event.user, $ocsf.actor.user
}
