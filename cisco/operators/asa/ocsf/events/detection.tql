---
description: Cisco ASA intrusion signatures and threat detection → OCSF Detection Finding
args:
  positional:
    - name: event
      type: field
      description: The parsed Cisco ASA event.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

@name = "ocsf.detection_finding"
$ocsf.category_uid = 2
$ocsf.class_uid = 2004
$ocsf.activity_id = 1
$ocsf.type_uid = 200401
$ocsf.metadata.profiles = ["security_control"]
$ocsf.is_alert = true

// ASA has no identifier for the occurrence of a signature or a threat.
if $event.signature? != null {
  $ocsf.finding_info = {
    title: $event.signature,
    analytic: {
      type_id: 1,
      name: move $event.signature,
      uid: (move $event.signature_id).string(),
    },
  }
  cisco::asa::ocsf::network_endpoints $event, $ocsf
  $ocsf.evidences = [{
    src_endpoint: (move $ocsf.src_endpoint).drop_null_fields(),
    dst_endpoint: (move $ocsf.dst_endpoint).drop_null_fields(),
  }]
  drop $ocsf.connection_info
} else if $event.rate? != null {
  $ocsf.finding_info = {
    title: f"{$event.object}: {$event.rate} exceeded",
    analytic: {
      type_id: 3,
      name: move $event.rate,
    },
  }
} else {
  $ocsf.finding_info = {
    title: f"{$event.host_type} {$event.host} is {$event.host_role}",
  }
  if $event.host_type == "Host" and $event.host_role == "attacking" {
    $ocsf.evidences = [{src_endpoint: {ip: (move $event.host).ip()}}]
  } else if $event.host_type == "Host" {
    $ocsf.evidences = [{dst_endpoint: {ip: (move $event.host).ip()}}]
  }
}
