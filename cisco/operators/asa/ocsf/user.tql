---
description: Cisco ASA user name → OCSF user
args:
  positional:
    - name: name
      type: field
      description: The user name, optionally with its domain. The operator consumes it.
    - name: user
      type: field
      description: The field that receives the OCSF user.
---

$user = {
  name: $name.split("\\", max=1)[1]? else $name,
  domain: $name.split("\\", max=1)[0] if $name.split("\\", max=1).length() == 2 else null,
}
drop $name
