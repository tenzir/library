---
description: Cisco Umbrella DNS logs → OCSF DNS Activity
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.dns_activity"
$ocsf.category_uid = 4
$ocsf.class_uid = 4003
$ocsf.activity_id = 1
$ocsf.opcode_id = 0
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.time = move $event.timestamp?
$ocsf.query_time = $ocsf.time
$ocsf.src_endpoint.ip = move $event.external_ip?
$ocsf.device.ip = move $event.internal_ip?
$ocsf.dst_endpoint.name = "Cisco Umbrella DNS"
$ocsf.query.hostname = move $event.domain?
$event.query_type = $event.query_type?.parse_grok(
  r"%{NUMBER:value} \(%{WORD:name}\)",
)
$ocsf.query.type = move $event.query_type?.name?

let $rcode_mapping = {
  NOERROR: {rcode_id: 0, rcode: "NoError"},
  FORMERROR: {rcode_id: 1, rcode: "FormError"},
  SERVERROR: {rcode_id: 2, rcode: "ServError"},
  SERVFAIL: {rcode_id: 2, rcode: "ServError"},
  NXDOMAIN: {rcode_id: 3, rcode: "NXDomain"},
  NOTIMP: {rcode_id: 4, rcode: "NotImp"},
  REFUSED: {rcode_id: 5, rcode: "Refused"},
  YXDOMAIN: {rcode_id: 6, rcode: "YXDomain"},
  YXRRSET: {rcode_id: 7, rcode: "YXRRSet"},
  NXRRSET: {rcode_id: 8, rcode: "NXRRSet"},
  NOTAUTH: {rcode_id: 9, rcode: "NotAuth"},
  NOTZONE: {rcode_id: 10, rcode: "NotZone"},
  DSOTYPENI: {rcode_id: 11, rcode: "DSOTYPENI"},
  BADSIG_VERS: {rcode_id: 99, rcode: "BADSIG_VERS"},
  BADKEY: {rcode_id: 17, rcode: "BADKEY"},
  BADTIME: {rcode_id: 18, rcode: "BADTIME"},
  BADMODE: {rcode_id: 19, rcode: "BADMODE"},
  BADNAME: {rcode_id: 20, rcode: "BADNAME"},
  BADALG: {rcode_id: 21, rcode: "BADALG"},
  BADTRUNC: {rcode_id: 22, rcode: "BADTRUNC"},
  BADCOOKIE: {rcode_id: 23, rcode: "BADCOOKIE"},
}
if $event.response_code? != null {
  $ocsf.rcode_id = $rcode_mapping[$event.response_code]?.rcode_id else 99
  $ocsf.rcode = $rcode_mapping[$event.response_code]?.rcode else $event.response_code
  drop $event.response_code
}

match $event.action? {
  "Allowed" => {
    $ocsf.action_id = 1
  }
  "Denied" => {
    $ocsf.action_id = 2
  }
  _ => {
    $ocsf.action_id = 0
  }
}
$ocsf.action = move $event.action?

$ocsf.status_id = 1
