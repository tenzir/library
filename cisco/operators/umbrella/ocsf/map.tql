---
description: Maps a structured Cisco Umbrella event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---


$ocsf = {}

$ocsf.metadata = {
  product: {
    name: "Umbrella",
    vendor_name: "Cisco",
  },
  profiles: ["host", "security_control"],
  version: "1.9.0",
}
$ocsf.severity_id = 1

match @name {
  "cisco.umbrella.dns" => {
    cisco::umbrella::ocsf::events::dns $event, $ocsf
  }
  _ => {
    cisco::umbrella::ocsf::base $event, $ocsf
  }
}



$ocsf.unmapped = move $event
