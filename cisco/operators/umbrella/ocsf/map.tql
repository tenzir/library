---
description: Maps a structured Cisco Umbrella event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The structured Umbrella event to map.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the OCSF event.
---


$into = {umbrella: $event, ocsf: {}}

$into.ocsf.metadata = {
  product: {
    name: "Umbrella",
    vendor_name: "Cisco",
  },
  profiles: ["host", "security_control"],
  version: "1.9.0",
}
$into.ocsf.severity_id = 1

match @name {
  "cisco.umbrella.dns" => {
    cisco::umbrella::ocsf::events::dns event=$into
  }
  _ => {
    cisco::umbrella::ocsf::base event=$into
  }
}



$into = {...$into.ocsf, unmapped: $into.umbrella}
