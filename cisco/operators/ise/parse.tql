---
description: |
  Parses a Cisco ISE message body.

  The first field holds the raw message body, not the full Syslog envelope, and
  the second receives the structured ISE event:

  ```tql
  cisco::ise::parse message, ise
  ```

  The operator writes `null` when the body is no ISE message. A segment of a
  message, as well as a message with a damaged header, has `complete: false`.
  To complete segmented messages, call `cisco::ise::reassemble` first.

  The parser leaves the input field unchanged. It does not add provenance or
  the Syslog envelope because those belong to the carrier around the message.
args:
  positional:
    - name: input
      description: The field that holds the raw ISE message body.
      type: field
    - name: ise
      description: The field that receives the structured ISE event.
      type: field
  named:
    - name: category
      description: |
        A field that holds the `CISE_<Category>` tag when a shipper splits it
        from the body, for example the RFC 5424 application name.
      type: field
      default: null
    - name: reassembly
      description: The field that `cisco::ise::reassemble` wrote, if any.
      type: field
      default: null
---

// Cisco documents the remote-target body as:
//
//   CISE_<Category> <msg_id> <total_seg> <seg_num> <date> <time> <offset>
//   <sequence_num> <msg_code> <severity> <Class>: <text>, key=value, key=value
//
// Some categories, such as CISE_MONITORING_DATA_PURGE_AUDIT, omit the segment
// counters. Alarms carry neither counters nor a message code:
//
//   CISE_Alarm <severity>: <text>: key=value; key=value
//
// Source: https://www.cisco.com/c/en/us/td/docs/security/ise/syslog/Cisco_ISE_Syslogs/m_IntrotoSyslogs.html
// Some relays keep the header of the ISE node in front of the tag.
let $frame = r"(?s)^\s*(?:(?:[A-Z][a-z]{2} +\d{1,2} \d{2}:\d{2}:\d{2}(?:\.\d+)? )?(?:(?<host>[^\s=,]+) )?(?<category>CISE_\S+)\s+)?(?:(?<id>\d+)\s+(?<total>\d+)\s+(?<index>\d+)(?:\s+(?<body>.*))?|(?<rest>.*))$"
// A syslog reader appends a line without a recognized header to the previous
// message. Then the body holds several segments.
let $glued = r"\n.*CISE_\S+\s+\d+\s+\d+\s+\d+\s"
let $header = r"(?s)^(?:(?<date>\d{4}-\d{2}-\d{2}) (?<clock>\d{2}:\d{2}:\d{2})(?:(?<point>[.:])(?<fraction>\d+))? (?<sign>[+-])(?<hours>\d{2})(?<colon>:)?(?<minutes>\d{2})\s+(?:(?<sequence>\d+)\s+)?(?<code>\d+)\s+(?<severity>[A-Z]+)\s+(?:(?<class>[A-Za-z][A-Za-z0-9 /+_-]*):\s+)?(?<text>.*?)(?:,[\s,]+(?<attributes>[[:alnum:]](?:[^,;:={}]*[^,;:={}\s])?=.*?))?[\s,]*|.*)$"
let $alarm = r"(?s)^(?:(?<severity>[A-Z]+):\s+(?<text>.*?)(?:\s*:\s+(?<attributes>[[:alnum:]][^;=:]*=.*))?|.*)$"

// A comma separates two attributes only when whitespace and the next name
// follow and no backslash escapes it, because values can contain commas. Names
// contain no punctuation of nested values. An even run of backslashes is data
// that ISE escaped. If ISE escapes nothing, a value with a trailing backslash
// is ambiguous and includes the next attribute. The run counts doubled, see
// below.
let $separator = r"(?:^|[^\\])(?:\\\\\\\\)*(,[\s,]+)[[:alnum:]](?:[^,;:={}]*[^,;:={}\s])?="
let $alarm_separator = r"(?:^|[^\\])(?:\\\\\\\\)*(;\s+)[[:alnum:]][^;=]*="

// Snapshot the input so the output may safely replace its carrier.
$ise = {
  input: $input,
  category: $category,
  reassembly: $reassembly,
}
if not $ise.category.string().starts_with("CISE_") {
  $ise.category = null
}
$ise.frame = $ise.input.parse_grok($frame, raw=true)
$ise.category = $ise.frame.category? else $ise.category
$ise.body = $ise.frame.body? else $ise.frame.rest?
$ise.header = $ise.body.parse_grok($header, raw=true)
// Three numbers alone are no segment of ISE. The tag or the header tell.
if $ise.category == null and $ise.header.code? == null {
  $ise = null
} else {
  if $ise.header.code? == null and $ise.category == "CISE_Alarm" and $ise.frame.id? == null {
    $ise.alarm = $ise.body.parse_grok($alarm, raw=true)
  } else {
    $ise.alarm = {}
  }
  $ise.event = {
    category: $ise.category,
    message_id: int($ise.frame.id?),
    segment_total: int($ise.frame.total?),
    segment_number: int($ise.frame.index?),
    // Only the first segment of a message carries the header. An unnumbered
    // body is complete, unless it starts like damaged counters.
    complete: (($ise.header.code? != null and ($ise.reassembly?.complete? else ($ise.frame.total == "1" and $ise.frame.index == "0")) if $ise.frame.id? != null
        else $ise.header.code? != null or not $ise.body.match_regex(r"^(?:\w+\s+)?\d+(?:\s|$)"))
      and not $ise.input.match_regex($glued)),
    origin: $ise.frame.host? else $ise.reassembly?.origin?,
    timestamp: null,
    original_time: null,
    sequence_number: int($ise.header.sequence?),
    message_code: int($ise.header.code?),
    severity: $ise.header.severity? else $ise.alarm.severity?,
    message_class: $ise.header.class? if $ise.header.class? != "null" else null,
    message_text: $ise.header.text? else $ise.alarm.text? else $ise.body?.trim().trim_end(","),
  }
  if $ise.header.code? != null {
    // The header carries the local time of the ISE node with its UTC offset.
    $ise.event.timestamp = time(f"{$ise.header.date}T{$ise.header.clock}.{$ise.header.fraction? else "0"}{$ise.header.sign}{$ise.header.hours}:{$ise.header.minutes}")
    $ise.event.original_time = f"{$ise.header.date} {$ise.header.clock}{$ise.header.point? else ""}{$ise.header.fraction? else ""} {$ise.header.sign}{$ise.header.hours}{$ise.header.colon? else ""}{$ise.header.minutes}"
    $ise.event.timezone_offset = int($ise.header.hours) * 60 + int($ise.header.minutes)
    if $ise.header.sign == "-" {
      $ise.event.timezone_offset = -$ise.event.timezone_offset
    }
  }

  // Values stay strings: ISE values are identifiers, such as MAC addresses and
  // session IDs. `parse_kv` unescapes backslash sequences that ISE does not
  // escape, so double the backslashes. It collects repeated names into a list.
  $ise.attributes = $ise.header.attributes?
  if $ise.header.code? == null and $ise.frame.id? != null and $ise.body?.match_regex(r"^\s*[[:alnum:]](?:[^,;:={}]*[^,;:={}\s])?=") {
    // A continuation segment without its header still names its attributes.
    $ise.attributes = $ise.body.trim().trim_end(",")
    $ise.event.message_text = null
  }
  // Nested values use the same separator as the attributes: sets in braces, and
  // the commands that an administrator typed, which can even look like further
  // attributes. Hide the separators within.
  $ise.text = $ise.attributes
  if $ise.text?.search("CmdSet=[") {
    $ise.text = ($ise.text
      .split("CmdSet=[")
      .map(x => x.split(" ], ", max=1, reverse=true)[0].replace(", ", "\x1f") + " ], " + x.split(" ], ", max=1, reverse=true)[1] if x.search(" ], ") else x.replace(", ", "\x1f") if x.trim().ends_with(" ]") else x)
      .join("CmdSet=["))
  }
  if $ise.text?.match_regex(r"\{[^{}]*,\s+[[:alnum:]][^,={}]*=") {
    $ise.text = ($ise.text
      .split("{")
      .map(x => x.split("}", max=1)[0].replace(", ", "\x1f") + "}" + x.split("}", max=1)[1] if x.search("}") else x)
      .join("{"))
  }
  if $ise.alarm.attributes? != null {
    $ise.event.attributes = $ise.alarm.attributes.replace("\\", "\\\\").parse_kv(field_split=$alarm_separator, value_split="=\\s*", quotes="", raw=true)
  } else if $ise.text != null {
    $ise.event.attributes = $ise.text.replace("\\", "\\\\").parse_kv(field_split=$separator, value_split="=", quotes="", raw=true)
  } else {
    $ise.event.attributes = {}
  }
  if $ise.text != $ise.attributes {
    $ise.event.attributes = $ise.event.attributes.entries().map(x => {
      key: x.key,
      value: x.value.map(y => y?.replace("\x1f", ", ")) if type_kind(x.value) == "list" else x.value?.replace("\x1f", ", "),
    }).collect_record()
  }

  if $ise.reassembly != null {
    $ise.event.reassembly = $ise.reassembly
    drop $ise.event.reassembly.message?, $ise.event.reassembly.origin?, $ise.event.reassembly.complete?
    if $ise.event.reassembly == {} {
      drop $ise.event.reassembly
    }
  }

  if not $ise.event.complete {
    @name = "cisco.ise.incomplete"
  } else if $ise.category?.starts_with("CISE_") {
    @name = "cisco.ise." + $ise.category.replace("CISE_", "").to_lower()
  } else {
    @name = "cisco.ise.event"
  }
  $ise = move $ise.event
}
