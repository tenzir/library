---
description: "Maps the authorization policy result of a request."
args:
  positional:
    - name: ise
      type: field
      description: The structured ISE event to read.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

// Network access selects authorization profiles, device administration selects
// a shell profile.
_profiles = ($ise.repeated.SelectedAuthorizationProfiles? else [$ise.attributes.SelectedAuthorizationProfiles?]).append($ise.attributes.SelectedShellProfile?).where(x => x != null).distinct()
drop $ise.repeated.SelectedAuthorizationProfiles?, $ise.attributes.SelectedAuthorizationProfiles?, $ise.attributes.SelectedShellProfile?

// The status tells the outcome that the message code states, for example of the
// authentication. The authorization has an own outcome: the action, the
// disposition, and the decision of each profile. A user can authenticate and
// still get no access.
//
// DenyAccess and PermitAccess are the built-in profiles. Other profiles can
// redirect or restrict the session, so their names are no decision. Reason
// 15039 is a rejection by the authorization profile. The authorization codes
// state the decision, except for those that report an error.
if $ocsf.class_uid == 3003 and $ocsf.status_id == 1 {
  _decision = "Allowed"
} else if $ocsf.class_uid == 3003 {
  _decision = "Denied" if not $ocsf.metadata.event_code in ["5409", "5410"] else null
} else if "DenyAccess" in _profiles or $ocsf.status_code? == "15039" {
  _decision = "Denied"
} else if _profiles == ["PermitAccess"] and $ocsf.status_id? == 1 {
  _decision = "Allowed"
} else {
  _decision = null
}
if _decision == "Allowed" {
  $ocsf.action_id = 1
  $ocsf.disposition_id = 1
} else if _decision == "Denied" {
  $ocsf.action_id = 2
  $ocsf.disposition_id = 26
} else if [$ise.attributes.Response?].concatenate($ise.repeated.Response? else []).where(x => x?.search("RadiusPacketType=AccessReject")) != [] {
  $ocsf.action_id = 2
  $ocsf.disposition_id = 2
}
// One of several profiles only holds the decision if it is the cause.
if _profiles.length() == 1 {
  $ocsf.authorizations = _profiles.map(x => {decision: _decision, policy: {name: x}})
} else if _profiles != [] {
  $ocsf.authorizations = _profiles.map(x => {decision: "Denied" if x == "DenyAccess" else null, policy: {name: x}})
}
drop _profiles, _decision
if $ise.attributes.AuthorizationPolicyMatchedRule? != null {
  $ocsf.policy = {name: move $ise.attributes.AuthorizationPolicyMatchedRule}
  if $ise.attributes.ISEPolicySetName? != null {
    $ocsf.policy.group = {name: move $ise.attributes.ISEPolicySetName}
  }
}
