---
description: "Maps the administrator who acts on an ISE node, and the interface in use, to the OCSF actor."
args:
  positional:
    - name: event
      type: field
      description: The event from `cisco::ise::parse`.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

// ISE repeats the administrator as operator.
if $event.attributes.OperatorName? != null and $event.attributes.OperatorName == $event.attributes.AdminName? {
  drop $event.attributes.OperatorName
}
cisco::ise::ocsf::administrator $event, $ocsf.actor.user
if $ocsf.actor?.user? != null and ($event.attributes.AdminInterface? else "UNKNOWN") != "UNKNOWN" {
  $ocsf.actor.application.name = move $event.attributes.AdminInterface
}
