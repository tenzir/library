---
description: "Maps the endpoint that asks for access to an OCSF network endpoint."
args:
  positional:
    - name: ise
      type: field
      description: The structured ISE event to read.
    - name: ocsf
      type: field
      description: The field that receives the endpoint.
---

let $address = "^([0-9]{1,3}[.]){3}[0-9]{1,3}$|^[0-9A-Fa-f]*:[0-9A-Fa-f:.]*$"
let $mac = "^([0-9A-Fa-f]{2}[:-]?){5}[0-9A-Fa-f]{2}$|^([0-9A-Fa-f]{4}[.]){2}[0-9A-Fa-f]{4}$"

// The calling station is a MAC address, the client address of a VPN, or a phone
// number. Twelve digits without separators are no evidence of a MAC address.
_calling = $ise.attributes["Calling-Station-ID"]?
_mac = [
  $ise.attributes.EndPointMACAddress?,
  $ise.attributes.EndpointMacAddress?,
  $ise.attributes.EPMacAddress?,
  _calling if not _calling?.match_regex("^[0-9]{12}$") else null,
].where(x => x?.match_regex($mac)).first()
_ip = [
  $ise.attributes["Framed-IP-Address"]?,
  $ise.attributes.IpAddress?,
  $ise.attributes.AdminIPAddress?,
  $ise.attributes.EndPointIPAddress?,
  $ise.attributes.EndpointIPAddress?,
  $ise.attributes["Remote-Address"]?,
  $ise.attributes["Framed-IPv6-Address"]?,
  _calling,
].where(x => x?.match_regex($address) and not x?.match_regex($mac)).first()
if _mac != null or _ip != null {
  $ocsf = {}
  if _ip != null {
    $ocsf.ip = ip(_ip)
  }
  if _mac != null {
    // The MAC address is the key of an endpoint in ISE. ISE writes it in several
    // notations.
    $ocsf.mac = _mac.replace_regex("[^0-9A-Fa-f]", "").to_upper().replace_regex("^(..)(..)(..)(..)(..)(..)$", r"\1:\2:\3:\4:\5:\6")
    $ocsf.uid = $ocsf.mac
  }
  // The profile is the type that ISE assigned to the endpoint.
  _profile = $ise.attributes.EndPointMatchedProfile? else $ise.attributes.EndpointMatchedPolicy? else $ise.attributes.EndPointPolicy?
  if _profile != null and _profile != "Unknown" {
    $ocsf.type_id = 99
    $ocsf.type = _profile
    if $ise.attributes.EndPointMatchedProfile? == _profile {
      drop $ise.attributes.EndPointMatchedProfile
    }
    if $ise.attributes.EndpointMatchedPolicy? == _profile {
      drop $ise.attributes.EndpointMatchedPolicy
    }
    if $ise.attributes.EndPointPolicy? == _profile {
      drop $ise.attributes.EndPointPolicy
    }
  }
  drop _profile
  // Other notations of the same addresses carry no further information.
  let $names = ["EndPointMACAddress", "EndpointMacAddress", "EPMacAddress", "Calling-Station-ID", "Framed-IP-Address", "IpAddress", "AdminIPAddress", "EndPointIPAddress", "EndpointIPAddress", "Remote-Address", "Framed-IPv6-Address"]
  $ise.attributes = $ise.attributes.entries().where(x => not (x.key in $names and (x.value == _ip or (_mac != null and x.value.replace_regex("[^0-9A-Fa-f]", "").to_lower() == _mac.replace_regex("[^0-9A-Fa-f]", "").to_lower())))).collect_record()
}
drop _calling, _mac, _ip
