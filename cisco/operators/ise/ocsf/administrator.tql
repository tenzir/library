---
description: "Maps the administrator of an ISE node to an OCSF user."
args:
  positional:
    - name: event
      type: field
      description: The event from `cisco::ise::parse`.
    - name: ocsf
      type: field
      description: The field that receives the user.
---

// ISE hides unknown user names unless the administrator discloses them.
if $event.attributes.AdminName? != null and not $event.attributes.AdminName in ["INVALID", "USERNAME"] {
  // The node itself acts as system.
  $ocsf = {
    name: $event.attributes.AdminName,
    type_id: 3 if $event.attributes.AdminName == "system" else 2,
  }
  drop $event.attributes.AdminName
}
