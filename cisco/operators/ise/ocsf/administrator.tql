---
description: "Maps the administrator of an ISE node to an OCSF user."
args:
  positional:
    - name: ise
      type: field
      description: The structured ISE event to read.
    - name: ocsf
      type: field
      description: The field that receives the user.
---

// ISE hides unknown user names unless the administrator discloses them.
if $ise.attributes.AdminName? != null and not $ise.attributes.AdminName in ["INVALID", "USERNAME"] {
  // The node itself acts as system.
  $ocsf = {
    name: $ise.attributes.AdminName,
    type_id: 3 if $ise.attributes.AdminName == "system" else 2,
  }
  drop $ise.attributes.AdminName
}
