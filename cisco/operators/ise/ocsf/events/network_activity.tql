---
description: "Cisco ISE RADIUS accounting → OCSF Network Activity (4001)"
args:
  positional:
    - name: ise
      type: field
      description: The structured ISE event to read.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

@name = "ocsf.network_activity"

$ocsf.category_uid = 4
$ocsf.class_uid = 4001
// The start and the stop of a session, and interim updates of a running one.
match $ocsf.metadata.event_code {
  "3000" => {
    $ocsf.activity_id = 1
    $ocsf.status_id = 1
  }
  "3001" => {
    $ocsf.activity_id = 2
    $ocsf.status_id = 1
  }
  _ => { $ocsf.activity_id = 6 }
}
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
// The code repeats the status type.
let $status_types = {"3000": "Start", "3001": "Stop", "3002": "Interim-Update"}
if $ise.attributes["Acct-Status-Type"]? == $status_types[$ocsf.metadata.event_code] {
  drop $ise.attributes["Acct-Status-Type"]
}
$ocsf.status_detail = move $ise.attributes["Acct-Terminate-Cause"]?

cisco::ise::ocsf::device $ise, $ocsf
cisco::ise::ocsf::endpoint $ise, $ocsf.src_endpoint
// The VLAN of the session, with the tag of the tunnel in front.
if $ocsf.src_endpoint? != null and $ise.attributes["Tunnel-Type"]?.ends_with("VLAN") and $ise.attributes["Tunnel-Private-Group-ID"]? != null {
  $ocsf.src_endpoint.vlan_uid = (move $ise.attributes["Tunnel-Private-Group-ID"]).replace_regex(r"^\(tag=\d+\) ", "")
  drop $ise.attributes["Tunnel-Type"]
}
cisco::ise::ocsf::user $ise, $ocsf.actor.user
cisco::ise::ocsf::session $ise, $ocsf.connection_info.session
if $ise.attributes["Acct-Session-Id"]? != null {
  $ocsf.connection_info.uid = move $ise.attributes["Acct-Session-Id"]
}
if $ocsf.connection_info? != null {
  $ocsf.connection_info.direction_id = 0
}

// The counters run from the start of the session. Input is what the network
// device received from the endpoint, and the gigawords are the high 32 bits.
// Source: https://www.rfc-editor.org/rfc/rfc2869#section-5.1
_attributes = $ise.attributes
if _attributes["Acct-Input-Octets"]?.match_regex("^[0-9]+$") {
  $ocsf.cumulative_traffic.bytes_out = int(_attributes["Acct-Input-Octets"]) + int(_attributes["Acct-Input-Gigawords"]? else "0") * 4294967296
  drop $ise.attributes["Acct-Input-Octets"], $ise.attributes["Acct-Input-Gigawords"]?
}
if _attributes["Acct-Output-Octets"]?.match_regex("^[0-9]+$") {
  $ocsf.cumulative_traffic.bytes_in = int(_attributes["Acct-Output-Octets"]) + int(_attributes["Acct-Output-Gigawords"]? else "0") * 4294967296
  drop $ise.attributes["Acct-Output-Octets"], $ise.attributes["Acct-Output-Gigawords"]?
}
if _attributes["Acct-Input-Packets"]?.match_regex("^[0-9]+$") {
  $ocsf.cumulative_traffic.packets_out = int(move $ise.attributes["Acct-Input-Packets"])
}
if _attributes["Acct-Output-Packets"]?.match_regex("^[0-9]+$") {
  $ocsf.cumulative_traffic.packets_in = int(move $ise.attributes["Acct-Output-Packets"])
}
if _attributes["Acct-Session-Time"]?.match_regex("^[0-9]+$") {
  $ocsf.cumulative_traffic.timespan = {
    duration_secs: int(move $ise.attributes["Acct-Session-Time"]),
    type_id: 2,
  }
}
drop _attributes
