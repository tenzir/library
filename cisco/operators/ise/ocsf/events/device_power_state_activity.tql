---
description: "Cisco ISE server reload and shutdown → OCSF Device Power State Activity (1011)"
args:
  positional:
    - name: ise
      type: field
      description: The structured ISE event to read.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

@name = "ocsf.device_power_state_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1011
$ocsf.activity_id = 5 if $ocsf.metadata.event_code == "60113" else 2
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
// The server only initiates the change.
$ocsf.status_id = 0
cisco::ise::ocsf::status_detail $ise, $ocsf
cisco::ise::ocsf::device $ise, $ocsf
cisco::ise::ocsf::administrator_actor $ise, $ocsf
