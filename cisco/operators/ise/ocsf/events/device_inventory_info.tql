---
description: "Cisco ISE profiler endpoint events → OCSF Device Inventory Info (5001)"
args:
  positional:
    - name: ise
      type: field
      description: The structured ISE event to read.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

@name = "ocsf.device_inventory_info"

$ocsf.category_uid = 5
$ocsf.class_uid = 5001
$ocsf.activity_id = 2
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
cisco::ise::ocsf::endpoint $ise, $ocsf.device
if $ocsf.device? != null {
  $ocsf.device.type_id = $ocsf.device.type_id? else 0
  $ocsf.device.mac_vendor = move $ise.attributes.EndpointOUI?
}
