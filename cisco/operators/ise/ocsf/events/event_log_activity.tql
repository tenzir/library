---
description: "Cisco ISE log deletion and log collection control → OCSF Event Log Activity (1008)"
args:
  positional:
    - name: event
      type: field
      description: The event from `cisco::ise::parse`.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

@name = "ocsf.event_log_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1008
_code = $ocsf.metadata.event_code
match _code {
  "59203" | "59204" | "59205" => {
    $ocsf.activity_id = 6
    $ocsf.log_provider = "Log Collector"
  }
  "59206" | "59207" | "59208" => {
    $ocsf.activity_id = 7
    $ocsf.log_provider = "Log Collector"
  }
  "57000" | "58015" => { $ocsf.activity_id = 2 }
  _ => {
    $ocsf.activity_id = 2
    $ocsf.log_name = "Local Store"
  }
}
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.log_type_id = 2
// Requests do not tell whether they succeed.
match _code {
  "59100" | "59203" | "59206" => { $ocsf.status_id = 0 }
  "59103" | "59205" | "59208" => { $ocsf.status_id = 2 }
  _ => { $ocsf.status_id = 1 }
}
drop _code
cisco::ise::ocsf::status_detail $event, $ocsf
cisco::ise::ocsf::device $event, $ocsf
cisco::ise::ocsf::administrator_actor $event, $ocsf
cisco::ise::ocsf::endpoint $event, $ocsf.src_endpoint
