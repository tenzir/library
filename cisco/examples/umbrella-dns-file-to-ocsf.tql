---
name: Cisco Umbrella DNS file → OCSF
description: |
  Reads a Cisco Umbrella DNS CSV file and maps it to OCSF DNS Activity.
---

from_file "umbrella-dns.csv.gz" {
  decompress_gzip
  cisco::umbrella::dns::read
}
this = {source: this, ocsf: {}}
cisco::umbrella::ocsf::map source, ocsf
this = ocsf
ocsf_derive
ocsf_cast
