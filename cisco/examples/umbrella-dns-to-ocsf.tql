---
name: Cisco Umbrella DNS → OCSF
description: |
  Maps parsed Cisco Umbrella DNS records from the `cisco` topic to OCSF DNS
  Activity events.
---

subscribe "cisco"
where @name == "cisco.umbrella.dns"
this = {source: this, ocsf: {}}
cisco::umbrella::ocsf::map source, ocsf
this = ocsf
ocsf_derive
ocsf_cast
publish "ocsf"
