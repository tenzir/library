---
name: Cisco ISE syslog over TCP → OCSF
description: |
  Receives Cisco ISE remote-target syslog over TCP, reassembles segmented
  messages, and publishes OCSF events to `ocsf`.
---

accept_tcp "0.0.0.0:514" {
  // Without `accept_pri_only`, a line with an unusual header would continue the
  // previous message and corrupt its last segment.
  read_syslog accept_pri_only=true
}
// Segments arrive one by one. Batches keep up with many messages per second.
batch timeout=250ms
cisco::ise::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
publish "ocsf"
