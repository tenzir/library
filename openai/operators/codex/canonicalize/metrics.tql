---
description: Canonicalizes codex metrics records in the selected field.
args:
  named:
    - name: event
      type: field
      default: this
      description: The record to canonicalize.
---

where @name.starts_with("otel.metric.")
where $event.metric.name in ["codex.skill.injected", "codex.tool.call"]

$event._raw_data = $event.print_json()
$event._attributes = $event.attributes
$event._resource_attributes = $event.resource.attributes
$event._tool_name = $event._attributes.tool?

$event._success = $event._attributes.success.string() == "true" if $event._attributes.success? != null else
           $event._attributes.status == "ok" if $event._attributes.status? != null else
           null

$event = {
  signal: "metric",
  raw_data: $event._raw_data,
  raw_data_size: $event._raw_data.length_bytes(),
  event_name: $event.metric.name,
  metric_name: $event.metric.name,
  metric_value: $event.value.int_value? else $event.value.double_value?,
  aggregation_temporality: $event.aggregation_temporality,
  is_monotonic: $event.monotonic?,
  time: $event.time,
  start_time: $event.start_time,
  end_time: $event.time,
  duration: int(($event.time - $event.start_time).count_milliseconds()) if $event.time? != null and $event.start_time? != null else null,
  app_version: $event._attributes["app.version"]? else $event._resource_attributes["service.version"]?,
  app_entrypoint: $event._attributes.originator?,
  model: $event._attributes.model?,
  provider: "OpenAI",
  auth_mode: $event._attributes.auth_mode?,
  session_source: $event._attributes.session_source?,
  skill_name: $event._attributes.skill?,
  invocation_type: $event._attributes.invoke_type?,
  source_status: $event._attributes.status?,
  // Tool-call metrics are aggregates, not individual invocations.
  tool_name: $event._tool_name,
  success: $event._success,
  sandbox: $event._attributes.sandbox?,
  sandbox_policy: $event._attributes.sandbox_policy?,
  // The receiver records how the record arrived; every signal carries it.
  transport: $event.transport? else $event.receiver?.transport?,
  scope: {
    name: $event.scope.name?,
    version: $event.scope.version?,
  },
  resource: {
    service_name: $event._resource_attributes["service.name"]?,
    service_version: $event._resource_attributes["service.version"]?,
    host_name: $event._resource_attributes["host.name"]?,
    host_arch: $event._resource_attributes["host.arch"]?,
    os_type: $event._resource_attributes["os.type"]? else $event._resource_attributes.os?,
    os_version: $event._resource_attributes["os.version"]? else $event._resource_attributes.os_version?,
  },
  attributes: $event._attributes
}

@name = "openai.codex.event"
