---
description: Converts a legacy Codex OTLP/JSON export envelope to OCSF 1.9.0.
args:
  named:
    - name: include_content
      type: bool
      default: false
      description: Retain prompts, responses, commands, and tool parameters.
---

openai::codex::normalize_legacy_envelope include_content=$include_content
openai::codex::ocsf::map
