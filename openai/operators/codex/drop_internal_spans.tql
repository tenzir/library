---
description: Drops internal runtime spans before serializing raw data.
args:
  named:
    - name: event
      type: field
      default: this
      description: The span record.
    - name: name
      type: field
      default: event_name
      description: The field that holds the span name.
---

where $name.starts_with("codex.") or
      $name in [
        "built_tools",
        "endpoint_session.execute_with",
        "list_tools_for_server",
        "plugins_for_config",
        "recommended_plugins_mode_for_config",
        "session_task.turn",
      ] or
      $event.attributes.tool_name? != null or
      $event.attributes.file_operation? != null or
      $event.attributes["rpc.method"]? != null or
      $event.attributes["http.request.method"]? != null or
      $event.attributes["http.method"]? != null or
      $event.attributes["span.type"]? != null
