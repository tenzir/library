---
description: Normalizes a legacy Codex OTLP/JSON export envelope.
args:
  named:
    - name: include_content
      type: bool
      default: false
      description: Retain prompts, responses, commands, and tool parameters.
---

match signal {
  "/v1/logs" => {
    otel::unroll_logs
  }
  "/v1/traces" => {
    otel::unroll_traces
  }
  _ => {
    discard
  }
}

// Export envelopes always arrive as OTLP/JSON over HTTP.
transport = "json"
openai::codex::normalize_event include_content=$include_content
