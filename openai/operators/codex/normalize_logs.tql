---
description: Normalizes unrolled Codex OTLP log records.
args:
  named:
    - name: include_content
      type: bool
      default: false
      description: Retain prompts, responses, and copied tool parameters. Shell commands are always retained.
---

_a = attributes? else {}
_event_name = _a["event.name"]? else body? else "unknown"

where _event_name not in ["codex.startup_phase", "codex.turn_ttft"]
where _event_name != "codex.sse_event" or _a["event.kind"]? == "response.completed"
where not _event_name.starts_with("runtime metrics reset skipped:")
where not _event_name.starts_with("metrics counter [")

_tool_name = _a.tool_name?
_tool_name_lower = _tool_name.to_lower() if _tool_name? != null else ""
_tool_namespace = _a.tool_namespace?
_tool_payload_text = _a.tool_input? else _a.tool_parameters? else _a.arguments?
_tool_payload = _tool_payload_text.parse_json() if _tool_payload_text? != null and _tool_payload_text.starts_with("{") else {}
_namespace_mcp_parts = _tool_namespace.split("__") if (_tool_namespace? else "").starts_with("mcp__") else []
_name_mcp_parts = _tool_name.split("__") if (_tool_name? else "").starts_with("mcp__") else []
_payload_server = _tool_payload.server? if _tool_name_lower in ["list_mcp_resources", "read_mcp_resource"] else null
_api_service = _a.mcp_server? if (_a.mcp_server? else "") != "" else
               _payload_server? else
               _namespace_mcp_parts[1]? if _namespace_mcp_parts.length() >= 2 else
               _name_mcp_parts[1]? if _name_mcp_parts.length() >= 3 else
               "web" if _tool_namespace == "web" or _tool_name_lower == "webrun" else
               null
_api_operation = f"web.{_tool_name}" if _tool_namespace == "web" else
                 "web.run" if _tool_name_lower == "webrun" else
                 _name_mcp_parts[2]? if _name_mcp_parts.length() >= 3 else
                 _tool_name
_direct_target_uri = _tool_payload.uri? if _tool_name_lower == "read_mcp_resource" else
                     _tool_payload.url?
_open_target_uris = (_tool_payload.open? else []).where(x => x.ref_id? != null and (
  x.ref_id.starts_with("http://") or x.ref_id.starts_with("https://")
)).map(x => x.ref_id)
_target_resource_uris = [
  _direct_target_uri,
  ..._open_target_uris,
].where(x => x != null)
_remote_tool = _namespace_mcp_parts.length() >= 2 or
               _name_mcp_parts.length() >= 3 or
               (_a.mcp_server? else "") != "" or
               (_tool_name_lower in ["list_mcp_resources", "read_mcp_resource"] and _payload_server? != null) or
               _tool_namespace == "web" or
               _tool_name_lower == "webrun"
// An `apply_patch` payload can touch several files. Every `*** ... File:`
// header is one file operation, and each becomes its own event below. A
// `*** Move to:` header follows the `*** Update File:` it renames, so each
// header is paired with its neighbours and that pair reads as one rename
// with the old and the new path. A `*** Move to:` without such a predecessor
// still counts as a rename that names only the new path.
_patch_headers = _a.arguments.split("\n").where(line => line.starts_with("*** Add File: ") or line.starts_with("*** Update File: ") or line.starts_with("*** Delete File: ") or line.starts_with("*** Move to: ")) if _a.arguments? != null else []
_patch_next = [..._patch_headers, ""].slice(begin=1)
_patch_prev = ["", ..._patch_headers].slice(end=-1)
_patch_operations = zip(zip(_patch_headers, _patch_next), _patch_prev).where(triple =>
  not (triple.left.left.starts_with("*** Move to: ") and triple.right.starts_with("*** Update File: "))
).map(triple => {
  operation: "rename" if triple.left.right.starts_with("*** Move to: ") or triple.left.left.starts_with("*** Move to: ") else
             "create" if triple.left.left.starts_with("*** Add File: ") else
             "delete" if triple.left.left.starts_with("*** Delete File: ") else
             "update",
  path: triple.left.left.replace_regex("^\\*\\*\\* (Add|Update|Delete) File: |^\\*\\*\\* Move to: ", ""),
  new_path: triple.left.right.replace_regex("^\\*\\*\\* Move to: ", "") if triple.left.right.starts_with("*** Move to: ") else null,
})
_file_path = _tool_payload.file_path? else _tool_payload.path?
// A generic Write does not establish whether the file was newly created.
_file_operation = "create" if _tool_name_lower in ["create", "artifact"] else
                  "delete" if _tool_name_lower in ["delete", "remove"] else
                  "rename" if _tool_name_lower in ["rename", "move"] else
                  "update" if _tool_name_lower in ["write", "edit", "notebookedit"] else
                  "read" if _tool_name_lower in ["read", "view_image"] else
                  null
_command_value = _tool_payload.command? else _tool_payload.full_command? else _tool_payload.cmd?
// Parsed tool payloads may infer a shell literal such as `true` as a boolean.
// A command is text regardless of its spelling, and its hash must cover that
// text rather than the inferred scalar representation.
_command = _command_value.string() if _command_value? != null else null
_tool_success = _a.success.string() == "true" if _a.success? != null else null
_tool_output = _a.output?
// For `exec_command`, Codex's `success` says that the tool call returned a
// result, not that the shell command succeeded. Preserve that fact while also
// extracting the command state from the human-readable result envelope.
_command_result = _event_name == "codex.tool_result" and _tool_name_lower == "exec_command"
// This producer error occurs before execution. Match the result prefix, not
// text printed inside a command's output, and require a failed tool call.
_argument_error = _command_result and _tool_success == false and
                  (_tool_output? else "").starts_with("failed to parse function arguments:")
_exit_lines = _tool_output.split("\n").where(line => line.starts_with("Process exited with code ")) if _command_result and _tool_output? != null else []
_exit_line = _exit_lines[0]? if _exit_lines.length() > 0 else null
_command_exit_code = int(_exit_line.replace_regex("^Process exited with code ", "")) if _exit_line? != null else null
_command_running = _command_result and _tool_output? != null and
                   _tool_output.contains("Process running with session ID ")
_session_lines = _tool_output.split("\n").where(line => line.contains("Process running with session ID ")) if _command_running else []
_session_line = _session_lines[0]? if _session_lines.length() > 0 else null
_terminal_session_id = _tool_payload.session_id.string() if _tool_payload.session_id? != null else
                       _session_line.replace_regex("^.*Process running with session ID ", "") if _session_line? != null else
                       null
// Conversation text lives in the `prompt`, `response` or `body` attribute.
// The record body itself is never content: Codex leaves it empty on every
// structured event, and its free-text log lines are filtered out above.
_content = _a.body? else _a.response? else _a.prompt?

select signal = "log",
  raw_data,
  raw_data_size,
  event_name = _event_name,
  event_kind = _a["event.kind"]?,
  time = time? else time(_a["event.timestamp"].string()) if _a["event.timestamp"]? != null else null,
  observed_time = observed_time?,
  event_sequence = int(_a["event.sequence"]) if _a["event.sequence"]? != null else null,
  session_id = _a["session.id"]? else _a["conversation.id"]?,
  prompt_id = _a["prompt.id"]?,
  user_id = _a["user.id"]? else _a["user.account_id"]?,
  user_uid_alt = _a["user.account_uuid"]?,
  user_email = _a["user.email"]?,
  organization_id = _a["organization.id"]?,
  app_version = _a["app.version"]? else resource["service.version"]?,
  app_entrypoint = _a["app.entrypoint"]? else _a.originator?,
  terminal_type = _a["terminal.type"]?,
  model = _a.model?,
  provider = _a.provider_name? else "OpenAI" if _a.model? != null else null,
  auth_mode = _a.auth_mode?,
  reasoning_effort = _a.model_reasoning_effort? else _a.reasoning_effort?,
  approval_policy = _a.approval_policy?,
  sandbox_policy = _a.sandbox_policy?,
  mcp_servers = _a.mcp_servers?,
  tool_name = _tool_name,
  tool_namespace = _tool_namespace,
  api_operation = _api_operation,
  api_service = _api_service,
  remote_tool = _remote_tool,
  tool_use_id = _a.tool_use_id? else _a.call_id?,
  mcp_server = _a.mcp_server? if (_a.mcp_server? else "") != "" else null,
  mcp_server_origin = _a.mcp_server_origin? if (_a.mcp_server_origin? else "") != "" else null,
  request_data = _tool_payload if $include_content and _tool_payload_text? != null and _tool_payload_text.starts_with("{") else null,
  target_resource_uris = _target_resource_uris if _target_resource_uris.length() > 0 else null,
  target_resource_type = "MCP Resource" if _tool_name_lower == "read_mcp_resource" else
                         "Web Resource" if _tool_namespace == "web" or _tool_payload.url? != null else
                         null,
  file_path = _file_path,
  file_name = _file_path.split("/")[-1] if _file_path? != null else null,
  file_operation = _file_operation,
  file_new_path = null,
  patch_operations = _patch_operations if _patch_operations.length() > 0 else null,
  process_name = "bash" if _tool_name_lower == "bash" else
                 "shell" if _tool_name_lower in ["exec", "exec_command", "shell", "terminal"] and not _argument_error else
                 null,
  command = _command,
  command_hash = hash_sha256(_command) if _command? != null else null,
  // `codex.tool_decision` reports `decision` plus `source`;
  // `codex.sandbox_outcome` reports the sandbox's verdict as `outcome` with no
  // source, so the sandbox itself is the authorizing control.
  decision = _a.decision? else _a.outcome?,
  tool_source = _a.tool_source?,
  decision_source = _a.source? else "sandbox" if _a.outcome? != null else null,
  success = _command_exit_code == 0 if _command_exit_code != null else _tool_success,
  command_exit_code = _command_exit_code,
  command_running = _command_running if _command_result else null,
  terminal_session_id = _terminal_session_id,
  duration = int(_a.duration_ms) if _a.duration_ms? != null else null,
  arguments_length = int(_a.arguments_length) if _a.arguments_length? != null else null,
  output_length = int(_a.output_length) if _a.output_length? != null else null,
  output_line_count = int(_a.output_line_count) if _a.output_line_count? != null else null,
  output_truncated = _a.output_truncated?,
  tool_origin = _a.tool_origin?,
  tool_result_seq = int(_a.tool_result_seq) if _a.tool_result_seq? != null else null,
  agent_name = _a.agent_name?,
  is_mcp_tool = _a.mcp_tool?,
  error = _tool_output if _argument_error else _a.error?,
  error_type = _a.error_type?,
  source_status_code = _a.status_code?,
  request_id = _a.request_id?,
  endpoint = _a.endpoint?,
  http_method = _a["http.request.method"]?,
  http_status = int(_a["http.response.status_code"]) if _a["http.response.status_code"]? != null else null,
  startup_phase = _a["startup.phase"]?,
  startup_status = _a["startup.status"]?,
  input_tokens = int(_a.input_tokens) if _a.input_tokens? != null else int(_a.input_token_count) if _a.input_token_count? != null else null,
  output_tokens = int(_a.output_tokens) if _a.output_tokens? != null else int(_a.output_token_count) if _a.output_token_count? != null else null,
  cached_input_tokens = int(_a.cached_token_count) if _a.cached_token_count? != null else null,
  cache_write_tokens = int(_a.cache_write_token_count) if _a.cache_write_token_count? != null else null,
  ttft_ms = int(_a.ttft_ms) if _a.ttft_ms? != null else null,
  // Which credential source a model request used is the security-relevant
  // part of the request record; the completed response carries the usage.
  auth_openai_api_key_present = _a["auth.env_openai_api_key_present"]?,
  auth_codex_api_key_present = _a["auth.env_codex_api_key_present"]?,
  auth_codex_api_key_enabled = _a["auth.env_codex_api_key_enabled"]?,
  auth_connection_reused = _a["auth.connection_reused"]?,
  reasoning_output_tokens = int(_a.reasoning_token_count) if _a.reasoning_token_count? != null else null,
  total_tokens = int(_a.tool_token_count) if _a.tool_token_count? != null else null,
  content = _content if $include_content else null,
  content_hash = hash_sha256(_content) if _content? != null else null,
  // Keep the source's own keys with the source's own values: a record may
  // carry both, and relabelling one as the other loses a real attribute.
  tool_input = _a.tool_input? if $include_content else null,
  tool_parameters = _a.tool_parameters? if $include_content else null,
  arguments = _a.arguments? if $include_content else null,
  tool_input_hash = hash_sha256(_a.tool_input) if _a.tool_input? != null else null,
  tool_parameters_hash = hash_sha256(_a.tool_parameters) if _a.tool_parameters? != null else null,
  arguments_hash = hash_sha256(_a.arguments) if _a.arguments? != null else null,
  trace_id = trace_id?,
  span_id = span_id?,
  severity_number = severity_number?,
  severity_text = severity_text?,
  flags = flags?,
  scope,
  // The receiver records how the record arrived; every signal carries it.
  transport = transport? else receiver?.transport?,
  resource = {
    service_name: resource["service.name"]?,
    service_version: resource["service.version"]?,
    host_name: resource["host.name"]?,
    host_arch: resource["host.arch"]?,
    os_type: resource["os.type"]? else resource.os?,
    os_version: resource["os.version"]? else resource.os_version?,
  },
  attributes = attributes?

if patch_operations != null {
  // One record, one event per patched file. Everything else about the record
  // is duplicated onto each event, including `raw_data`.
  unroll patch_operations
  file_operation = patch_operations.operation
  file_path = patch_operations.path
  file_name = patch_operations.path.split("/")[-1]
  file_new_path = patch_operations.new_path
}
drop patch_operations

@name = "openai.codex.event"
