---
description: Maps shared codex context when used by an event.
args:
  positional:
    - name: codex
      type: field
      description: The canonical source event.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

$ocsf.ai_agent = $ocsf._mapping.ai_agent
if $ocsf.ai_agent.ai_model? != null {
  drop $codex.model?, $codex.provider?
}
