---
description: Maps api activity fields.
args:
  positional:
    - name: codex
      type: field
      description: The canonical codex event to consume.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

$ocsf._mapping.api_operation = $codex.rpc_method? else
                 $codex.event_kind? if $codex.event_name == "codex.sse_event" else
                 $codex.http_method? else
                 $codex.api_operation? else
                 $codex.tool_name? else
                 $codex.event_name
$ocsf._mapping.http_verb = ($codex.http_method? else "").to_lower()
$ocsf._mapping.api_activity_id = 2 if $ocsf._mapping.http_verb in ["get", "head"] else
                   3 if $ocsf._mapping.http_verb in ["put", "patch"] else
                   4 if $ocsf._mapping.http_verb == "delete" else
                   1 if $ocsf._mapping.http_verb == "post" or $codex.event_name in [
                          "codex.api_request",
                          "codex.websocket_request",
                          "codex.websocket_connect",
                        ] or $codex.span_type? == "llm_request" else
                   2 if $codex.event_name == "list_tools_for_server" else
                   99
$ocsf.category_uid = 6
$ocsf.class_uid = 6003
@name = "ocsf.api_activity"
$ocsf.activity_id = $ocsf._mapping.api_activity_id
$ocsf.activity_name = "Invoke" if $ocsf._mapping.api_activity_id == 99 and ($codex.tool_name? else "") != "" else
                            "Call" if $ocsf._mapping.api_activity_id == 99 and ($codex.rpc_method? else "") != "" else
                            "Prompt" if $codex.event_name == "codex.user_prompt" else
                            "Respond" if $codex.event_name == "codex.sse_event" else
                            "Turn" if $codex.event_name == "session_task.turn" else
                            $ocsf._mapping.api_operation if $ocsf._mapping.api_activity_id == 99 else null
$ocsf.api = {
  operation: $ocsf._mapping.api_operation,
}
if $codex.rpc_request_id? != null {
  $ocsf.api.request.uid = move $codex.rpc_request_id
} else if $codex.request_id? != null {
  $ocsf.api.request.uid = move $codex.request_id
} else if $codex.tool_use_id? != null {
  $ocsf.api.request.uid = move $codex.tool_use_id
}
if $ocsf.api.request?.uid? != null {
  if $codex.request_data? != null {
    $ocsf.api.request.data = move $codex.request_data
    drop $codex.tool_input?,
         $codex.tool_parameters?,
         $codex.arguments?
  }
}
$ocsf.message = "User prompted the agent" if $codex.event_name == "codex.user_prompt" else
                      "Model response completed" if $codex.event_name == "codex.sse_event" else
                      "Agent called the vendor API" if $codex.event_name == "codex.api_request" else
                      "Agent opened a websocket to the vendor" if $codex.event_name == "codex.websocket_connect" else
                      "Agent sent a model request over the websocket" if $codex.event_name == "codex.websocket_request" else
                      f"Agent sent an HTTP {$ocsf._mapping.api_operation} request" if ($codex.http_method? else "") != "" else
                      f"Agent called {$ocsf._mapping.api_operation}" if ($codex.rpc_method? else "") != "" else
                      f"Agent called tool {$ocsf._mapping.api_operation}" if ($codex.tool_name? else "") != "" else
                      f"Agent called {$ocsf._mapping.api_operation}"
$ocsf.actor = $ocsf._mapping.actor
$ocsf.src_endpoint = {
  hostname: $codex.resource.host_name?,
  svc_name: $codex.resource.service_name,
}
if $codex.server_address? != null or $codex.server_port? != null {
  $ocsf.dst_endpoint = {
    hostname: $codex.server_address.string() if $codex.server_address? != null else null,
    port: $codex.server_port?,
  }
}
$ocsf._mapping.mcp_parts = $codex.tool_name.split("__") if ($codex.tool_name? else "").starts_with("mcp__") else []
$ocsf._mapping.mcp_server = $codex.api_service? else
              $codex.mcp_server? else
              $codex.server_name? else
              ($ocsf._mapping.mcp_parts[1]? if $ocsf._mapping.mcp_parts.length() >= 3 else null)
if $ocsf._mapping.mcp_server != null {
  $ocsf.api.service = {name: $ocsf._mapping.mcp_server}
  $ocsf.dst_endpoint = {
    ...($ocsf.dst_endpoint? else {}),
    svc_name: $ocsf._mapping.mcp_server,
  }
}
if $codex.target_resource_uris? != null {
  $ocsf.resources = (move $codex.target_resource_uris).map(uri => {
    uid: uri,
    type: $codex.target_resource_type?,
    role_id: 1,
  })
}
$ocsf._mapping.total_tokens = $codex.total_tokens? else
                $codex.input_tokens + $codex.output_tokens if
                $codex.input_tokens? != null and
                $codex.output_tokens? != null else
                null
openai::codex::ocsf::message_context $codex, $ocsf
$ocsf.message_context.prompt_tokens = move $codex.input_tokens?
$ocsf.message_context.completion_tokens = move $codex.output_tokens?
$ocsf.message_context.total_tokens = $ocsf._mapping.total_tokens
// #1674 gave conversation text a schema home in 1.9; the hash stays in
// `unmapped.content_hash` as the integrity handle, which has none yet.
if $codex.event_name == "codex.user_prompt" {
  $ocsf.message_context.prompt_text = move $codex.content?
} else if $codex.event_name == "codex.sse_event" {
  $ocsf.message_context.response_text = move $codex.content?
}
$ocsf.metadata.profiles = ["ai_operation"]
openai::codex::ocsf::ai_agent $codex, $ocsf
if ($codex.trace_id? else "") != "" {
  $ocsf.trace = {
    uid: move $codex.trace_id,
    service: {
      name: $codex.resource.service_name,
      version: $codex.resource.service_version?,
    },
  }
  // Logs have span context but not the required span lifetime. Move IDs
  // only inside this branch so log context remains in unmapped.
  if $codex.signal? == "trace" and $codex.start_time? != null and $codex.end_time? != null {
    $ocsf.trace.span = {
      uid: move $codex.span_id,
      parent_uid: move $codex.parent_span_id?,
      operation: $codex.event_name,
      start_time: $codex.start_time,
      end_time: $codex.end_time,
      duration: $codex.duration?,
      status_code: $codex.status_code.string() if $codex.status_code? != null else null,
    }
  }
  $ocsf.metadata.profiles = ["ai_operation", "trace"]
}

// These source values selected the emitted API operation.
drop $codex.api_operation?, $codex.remote_tool?, $codex.http_method?
if $codex.api_service? != null and $ocsf.api.service?.name? == $codex.api_service {
  drop $codex.api_service
}
if $codex.server_name? != null and $ocsf.api.service?.name? == $codex.server_name {
  drop $codex.server_name
}
if $codex.mcp_server? != null and $ocsf.api.service?.name? == $codex.mcp_server {
  drop $codex.mcp_server
}
if $codex.resource.host_name? != null and $ocsf.src_endpoint.hostname? == $codex.resource.host_name {
  drop $codex.resource.host_name
}
if $ocsf.dst_endpoint?.hostname? != null {
  drop $codex.server_address?, $codex.server_port?
}
if $ocsf.resources? != null {
  drop $codex.target_resource_type?
}
if $ocsf.message_context.total_tokens? != null {
  drop $codex.total_tokens?
}
