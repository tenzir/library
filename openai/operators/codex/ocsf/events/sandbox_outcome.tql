---
description: Maps sandbox outcome fields.
args:
  positional:
    - name: codex
      type: field
      description: The canonical codex event to consume.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

// The sandbox verdict controls an operation attempted by the shell. It does
// not represent another launch of that shell process.
$ocsf.category_uid = 0
$ocsf.class_uid = 0
$ocsf.activity_id = 99
$ocsf.activity_name = "Sandbox Outcome"
$ocsf.message = "Codex sandbox allowed the operation" if $ocsf._mapping.decision_status_id == 1 else
                      "Codex sandbox blocked the operation" if $ocsf._mapping.decision_status_id == 2 else
                      "Codex sandbox reported an outcome"
$ocsf.metadata.profiles = ["host"]
$ocsf.actor = $ocsf._mapping.actor
$ocsf.device = $ocsf._mapping.device
