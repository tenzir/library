---
description: Maps authorize session fields.
args:
  positional:
    - name: codex
      type: field
      description: The canonical codex event to consume.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

$ocsf._mapping.approval_policy = move $codex.approval_policy?
$ocsf._mapping.sandbox_policy = move $codex.sandbox_policy?
// Two independent policies. Qualify them, so a rule matching on one cannot
// accidentally match the other.
$ocsf._mapping.privileges = [f"approval:{$ocsf._mapping.approval_policy}" if $ocsf._mapping.approval_policy != null else null,
               f"sandbox:{$ocsf._mapping.sandbox_policy}" if $ocsf._mapping.sandbox_policy != null else null].where(p => p != null)
$ocsf.category_uid = 3
$ocsf.class_uid = 3003
$ocsf.activity_id = 1
$ocsf.actor = $ocsf._mapping.actor
$ocsf.user = $ocsf._mapping.actor.user
$ocsf.session = $ocsf._mapping.actor.session
$ocsf.privileges = $ocsf._mapping.privileges if $ocsf._mapping.privileges.length() > 0 else ["unknown"]
$ocsf.severity_id = 3 if $ocsf._mapping.sandbox_policy == "danger-full-access" else 1
$ocsf.message = f"Agent session started with approval policy {$ocsf._mapping.approval_policy else "unknown"} and sandbox {$ocsf._mapping.sandbox_policy else "unknown"}"
$ocsf.metadata.profiles = ["ai_operation"]
$ocsf.ai_agent = $ocsf._mapping.ai_agent
