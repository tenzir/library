---
description: Maps skill activation fields.
args:
  positional:
    - name: codex
      type: field
      description: The canonical codex event to consume.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

$ocsf._mapping.skill_name = move $codex.skill_name? else "Unknown"
$ocsf.category_uid = 6
$ocsf.class_uid = 6002
$ocsf.activity_id = 6
$ocsf.application = {name: $ocsf._mapping.skill_name}
$ocsf.message = f"Skill {$ocsf._mapping.skill_name} injected into the agent context"
// Application Lifecycle defines no actor of its own; the Host profile adds
// it, so the session and the user are typed here as on every other class.
$ocsf.metadata.profiles = ["ai_operation", "host"]
$ocsf.actor = $ocsf._mapping.actor
$ocsf.device = $ocsf._mapping.device
$ocsf.ai_agent = {...$ocsf._mapping.ai_agent, charter: {name: $ocsf._mapping.skill_name, type_id: 1}}
