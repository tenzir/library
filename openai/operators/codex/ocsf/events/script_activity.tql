---
description: Maps script activity fields.
args:
  positional:
    - name: codex
      type: field
      description: The canonical codex event to consume.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

$ocsf.category_uid = 1
$ocsf.class_uid = 1009
$ocsf.activity_id = 1
// The `exec` tool evaluates its input as JavaScript in a V8 isolate. Only
// calls whose script text is retained reach this mapping.
$ocsf.script = {
  uid: move $codex.tool_use_id?,
  type_id: 4,
  script_content: {value: move $codex.arguments},
  hashes: [{algorithm_id: 3, value: move $codex.arguments_hash}] if $codex.arguments_hash? != null else null,
}
replace $ocsf.script.uid, what="", with=null
$ocsf.message = "Agent tool script denied" if $ocsf._mapping.decision_status_id == 2 else
                "Agent requested a tool script" if $codex.event_name == "codex.tool_decision" else
                "Agent tool script failed" if $codex.success? == false else
                "Agent ran a tool script"
$ocsf.actor = $ocsf._mapping.actor
$ocsf.device = $ocsf._mapping.device
$ocsf.message_context = {...$ocsf._mapping.message_context, ai_role_id: 3}
$ocsf.metadata.profiles = ["ai_operation"]
$ocsf.ai_agent = $ocsf._mapping.ai_agent
