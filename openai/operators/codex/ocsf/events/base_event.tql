---
description: Maps base event fields.
args:
  positional:
    - name: codex
      type: field
      description: The canonical codex event to consume.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

$ocsf._mapping.fallback_tool = $codex.tool_name?
$ocsf.category_uid = 0
$ocsf.class_uid = 0
$ocsf.activity_id = 99
$ocsf.activity_name = $codex.event_name
$ocsf.metadata.profiles = ["host"]
$ocsf.actor = $ocsf._mapping.actor
$ocsf.device = $ocsf._mapping.device
$ocsf.message = f"Tool call {$ocsf._mapping.fallback_tool} " + (
                        "allowed" if $ocsf._mapping.decision_status_id == 1 else
                        "denied" if $ocsf._mapping.decision_status_id == 2 else "decided") if $codex.event_name == "codex.tool_decision" and $ocsf._mapping.fallback_tool != null else
                      f"Tool call {$ocsf._mapping.fallback_tool} " + (
                        "succeeded" if $codex.success? == true else
                        "failed" if $codex.success? == false else "completed") if $codex.event_name == "codex.tool_result" and $ocsf._mapping.fallback_tool != null else
                      f"{$codex.metric_value} tool calls to {$ocsf._mapping.fallback_tool} under sandbox {$codex.sandbox? else "unknown"} ({$codex.sandbox_policy? else "unknown"})" if $codex.metric_name? == "codex.tool.call" else
                      f"Metric {$codex.metric_name}: {$codex.metric_value}" if $codex.signal? == "metric" else
                      $codex.event_name
