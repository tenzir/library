---
description: Maps posture read fields.
args:
  positional:
    - name: codex
      type: field
      description: The canonical codex event to consume.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

$ocsf.category_uid = 6
$ocsf.class_uid = 6003
$ocsf.activity_id = 2
$ocsf.api = {
  operation: $codex.event_name,
}
$ocsf.message = f"Agent read its configured posture ({$codex.event_name})"
$ocsf.actor = $ocsf._mapping.actor
$ocsf.src_endpoint = {
  hostname: $codex.resource.host_name?,
  svc_name: $codex.resource.service_name,
}
$ocsf.message_context = {...$ocsf._mapping.message_context, ai_role_id: 4}
$ocsf.metadata.profiles = ["ai_operation"]
$ocsf.ai_agent = $ocsf._mapping.ai_agent
if ($codex.trace_id? else "") != "" {
  $ocsf.trace = {
    uid: move $codex.trace_id,
    service: {
      name: $codex.resource.service_name,
      version: $codex.resource.service_version?,
    },
  }
  // Logs have span context but not the required span lifetime. Move IDs
  // only inside this branch so log context remains in unmapped.
  if $codex.signal? == "trace" and $codex.start_time? != null and $codex.end_time? != null {
    $ocsf.trace.span = {
      uid: move $codex.span_id,
      parent_uid: move $codex.parent_span_id?,
      operation: $codex.event_name,
      start_time: $codex.start_time,
      end_time: $codex.end_time,
      duration: $codex.duration?,
      status_code: $codex.status_code.string() if $codex.status_code? != null else null,
    }
  }
  $ocsf.metadata.profiles = ["ai_operation", "trace"]
}
