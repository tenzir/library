---
description: Maps shared codex context when used by an event.
args:
  positional:
    - name: codex
      type: field
      description: The canonical source event.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

$ocsf.message_context = $ocsf._mapping.message_context
if $codex.client_name? != null {
  drop $codex.client_name
} else {
  drop $codex.app_entrypoint?
}
if $codex.client_version? != null {
  drop $codex.client_version
} else {
  drop $codex.app_version?
}
