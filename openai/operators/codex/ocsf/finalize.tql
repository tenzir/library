---
description: Preserves governance and unmapped source fields.
args:
  positional:
    - name: codex
      type: field
      description: The canonical codex event to consume.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

if $ocsf._mapping.decision_status_id != null {
  // A decision without a named decider must not imply that a rule fired, so
  // its disposition stays `Unknown` and no `policy` is attached.
  $ocsf.action_id = $ocsf._mapping.decision_status_id
  $ocsf.authorizations = $ocsf._mapping.authorizations
  $ocsf.disposition_id = (8 if $ocsf._mapping.human_decision else 1 if $ocsf._mapping.policy_decision else 0) if $ocsf._mapping.decision_status_id == 1 else
                               (25 if $ocsf._mapping.human_decision else 2 if $ocsf._mapping.policy_decision else 0)
  if $ocsf._mapping.policy_decision {
    // Neither product names the rule that fired, so `name` stays empty rather
    // than repeating the decider. `type` is where the kind of decider belongs.
    $ocsf.policy = {
      type: $codex.decision_source,
      is_applied: true,
    }
  }
  $ocsf.metadata.profiles = [...($ocsf.metadata.profiles? else []), "security_control"]
  drop $codex.decision?
}

// Consume shared context only when it was emitted by this event builder.
drop $codex.event_name?, $codex.time?, $codex.observed_time?, $codex.transport?
// Attributes duplicate canonical inputs; signal is an internal discriminator.
drop $codex.attributes?, $codex.resource.service_name?, $codex.resource.service_version?
// Preserve unselected error details even when their values happen to match.
if $codex.error? != null {
  if $ocsf.status_detail? == $codex.error {
    drop $codex.error
  }
} else if $codex.error_type? != null {
  if $ocsf.status_detail? == $codex.error_type {
    drop $codex.error_type
  }
} else if $codex.status_message? != null {
  if $ocsf.status_detail? == $codex.status_message {
    drop $codex.status_message
  }
} else if $codex.startup_status? != null {
  if $ocsf.status_detail? == $codex.startup_status {
    drop $codex.startup_status
  }
} else if $codex.source_status? != null {
  if $ocsf.status_detail? == $codex.source_status {
    drop $codex.source_status
  }
}
if $codex.source_status_code? != null and $ocsf.status_code? == $codex.source_status_code.string() {
  drop $codex.source_status_code
}
if $codex.http_status? != null and $ocsf.status_code? == $codex.http_status.string() {
  drop $codex.http_status
}
if $codex.command_exit_code? != null and $ocsf.status_code? == $codex.command_exit_code.string() {
  drop $codex.command_exit_code
}
if $ocsf.policy?.type? == $codex.decision_source? {
  drop $codex.decision_source?
}
if $codex.success? != null {
  // Status, or tool_success on background requests, carries this outcome.
  drop $codex.success
}
if $codex.signal? == "metric" or $ocsf.trace?.span? != null {
  drop $codex.duration?, $codex.start_time?, $codex.end_time?
} else if $codex.duration? != null {
  $codex.duration_ms = move $codex.duration
}
drop $codex.signal?
if $codex.resource? != null and drop_null_fields($codex.resource).is_empty() {
  drop $codex.resource
}
if $codex.scope? != null and drop_null_fields($codex.scope).is_empty() {
  drop $codex.scope
}
$ocsf.unmapped = drop_null_fields(move $codex)
drop $ocsf._mapping

// Warn once while preserving the known activity and all events.
fork {
  where $ocsf.category_uid == 1 and $ocsf.device? == null
  head 1
  assert false, message="Missing host identity for file/process activity: add host.name or host.id to the OpenTelemetry resource attributes (OTEL_RESOURCE_ATTRIBUTES). Host enrichment is required for complete OCSF file/process activity."
  discard
}
