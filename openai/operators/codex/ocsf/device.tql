---
description: Maps shared codex context when used by an event.
args:
  positional:
    - name: codex
      type: field
      description: The canonical source event.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

$ocsf.device = $ocsf._mapping.device
if $ocsf.device?.uid? != null {
  drop $codex.resource.host_id?
}
if $ocsf.device?.hostname? != null {
  drop $codex.resource.host_name?
}
if $ocsf.device?.os? != null {
  drop $codex.resource.os_type?, $codex.resource.os_version?
}
