---
description: Normalizes a decoded Codex OTLP log, span, or metric point.
args:
  named:
    - name: include_content
      type: bool
      default: false
      description: Retain prompts, responses, and copied tool parameters. Shell commands are always retained.
---

// Codex reports a different service name per client: `codex_cli_rs` for the
// terminal client, `codex_exec` for non-interactive runs and
// `codex-app-server` for the desktop and IDE apps. All emit the same event
// vocabulary, so the product is recognized by its prefix rather than by an
// allow-list that silently drops the next client.
match signal {
  "log" => {
    _service = resource["service.name"]? else ""
    where _service.starts_with("codex")
    openai::codex::normalize_logs include_content=$include_content
  }
  "trace" => {
    _service = resource["service.name"]? else ""
    where _service.starts_with("codex")
    openai::codex::normalize_traces include_content=$include_content
    // Decision and result logs report every tool call. Codex also exports a
    // span named after the tool (`exec_command`, `write_stdin`, `apply_patch`,
    // the `code_mode.broker.invoke_tool` wrapper) later in a separate batch;
    // mapping it would repeat the lifecycle the logs already carry. The Code
    // Mode `exec` span is the exception: no decision log exists for it, so
    // the span is its provisional Launch. Applied here so the native and the
    // legacy envelope path agree.
    where not (tool_name? != null and tool_name != "exec")
    if event_name in [
      "plugins_for_config",
      "recommended_plugins_mode_for_config",
      "built_tools",
    ] {
      deduplicate event_name,
                  plugins_enabled,
                  remote_plugin_enabled,
                  apps_enabled,
                  model,
                  create_timeout=1h
    }
  }
  "/v1/metrics" => {
    openai::codex::normalize_metrics
    _service = resource.service_name? else ""
    where _service.starts_with("codex")
  }
  _ => {
    discard
  }
}
