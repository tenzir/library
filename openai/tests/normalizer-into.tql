from_file f"{env("TENZIR_INPUTS")}/../native-log.input" {
  read_json
}
@name = "otel.log"
original = this
result = {sibling: "preserved"}
openai::codex::ocsf::normalize into=result.ocsf
select input_preserved=attributes.print_json() == original.attributes.print_json(),
  sibling_preserved=result.sibling == "preserved",
  mapped=result.ocsf.class_uid != null,
  raw_preserved=result.ocsf.raw_data.parse_json().attributes.print_json() == original.attributes.print_json(),
  staging_removed=result.ocsf.codex? == null and result.ocsf.ocsf? == null
