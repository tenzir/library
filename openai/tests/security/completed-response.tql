// Native-record fixture converted from the former OTLP/JSON test envelope.
from_file env("TENZIR_INPUT") {
  read_json
}
@name = "otel.log"
openai::codex::ocsf::normalize include_content=true
ocsf_derive
ocsf_cast
where metadata.event_code == "codex.sse_event"
select time, metadata.event_code, class_name, activity_name, api.operation,
       ai_agent, message_context, unmapped.reasoning_effort,
       unmapped.cached_input_tokens, unmapped.reasoning_output_tokens
