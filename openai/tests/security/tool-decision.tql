// Native-record fixture converted from the former OTLP/JSON test envelope.
from_file env("TENZIR_INPUT") {
  read_json
}
@name = "otel.log"
openai::codex::ocsf::normalize include_content=true
this = ocsf_cast(this)
select time, metadata.event_code, metadata.profiles, class_uid,
       activity_id, api?.operation?, target_uid=process?.uid? else script?.uid?, action_id, disposition_id,
       policy?, authorizations, status_id, severity_id
sort time
