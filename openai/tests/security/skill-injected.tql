from_file env("TENZIR_INPUT") {
  read_ndjson
}
@name = "otel.metric.sum"
openai::codex::ocsf::normalize
this = ocsf_derive(this)
this = ocsf_cast(this)
select time, start_time, end_time, duration?, metadata.event_code,
       metadata.profiles, class_name, activity_name, status, application, ai_agent,
       unmapped.invocation_type, unmapped.metric_value
