// Native-record fixture converted from the former OTLP/JSON test envelope.
from_file env("TENZIR_INPUT") {
  read_json
}
@name = "otel.span"
openai::codex::ocsf::normalize include_content=true
this = ocsf_derive(this)
this = ocsf_cast(this)
where metadata.event_code == "config/batchWrite"
select time, metadata.event_code, class_name, activity_name, api,
       message_context.application, trace, unmapped.rpc_system,
       unmapped.rpc_transport
