from_file env("TENZIR_INPUT") {
  read_ndjson
}
@name = "otel.metric.sum"
openai::codex::ocsf::normalize
this = ocsf_cast(this)
select time, start_time, end_time, duration?, metadata.event_code,
       class_uid, activity_name, severity_id, status_id, api?.operation?, ai_agent?,
       message_context?, unmapped.metric_value, unmapped.sandbox,
       unmapped.sandbox_policy
