from_file env("TENZIR_INPUT") {
  read_json
}
openai::codex::ocsf_legacy_envelope include_content=true
ocsf_derive
ocsf_cast
where metadata.event_code == "session_task.turn"
select time, metadata.event_code, class_name, activity_name, api.operation,
       ai_agent, message_context, duration?, trace, unmapped.reasoning_effort,
       unmapped.cached_input_tokens, unmapped.reasoning_output_tokens
