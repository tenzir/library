// Native-record fixture converted from the former OTLP/JSON test envelope.
from_file env("TENZIR_INPUT") {
  read_json
}
@name = "otel.log"
openai::codex::ocsf::normalize include_content=true
this = ocsf_cast(this)
where metadata.event_code == "codex.websocket_connect"
select time, metadata.event_code, class_uid, activity_id, api.operation,
       status_id, duration?, ai_agent, unmapped.endpoint
