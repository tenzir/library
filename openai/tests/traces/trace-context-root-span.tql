// Captured MCP hook span, with optional parent and status message omitted.
from_file f"{env("TENZIR_INPUTS")}/../traces/mcp-hook.input" {
  read_ndjson
}
drop parent_span_id?, status.message?
@name = "otel.span"
openai::codex::ocsf
ocsf_derive
ocsf_cast
assert trace.span.uid != null
assert trace.span.start_time != null
assert trace.span.end_time != null
assert trace.span.parent_uid? == null
assert unmapped.span_id? == null
select class_uid, trace
