// Captured raw log-lab event. Dotted OTEL keys restored from ClickHouse.
// Personal identifiers omitted; operational IDs and timestamps retained.
from_file f"{env("TENZIR_INPUTS")}/../traces/mcp-hook.input" {
  read_ndjson
}
@name = "otel.span"
openai::codex::ocsf::normalize
this = ocsf_cast(this)
select time, class_uid, activity_name, status_id, api, trace,
       timeout_sec=unmapped.hook_timeout_sec?
