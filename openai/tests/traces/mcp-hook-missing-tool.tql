// Synthetic variation of the captured MCP hook: incomplete identity stays Base.
from_file f"{env("TENZIR_INPUTS")}/../traces/mcp-hook.input" {
  read_ndjson
}
drop attributes["hook.tool"]
@name = "otel.span"
openai::codex::ocsf::normalize
this = ocsf_derive(this)
this = ocsf_cast(this)
select time, class_name, activity_name, status, api?
