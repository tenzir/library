// Native-record fixture converted from the former OTLP/JSON test envelope.
from_file f"{env("TENZIR_INPUTS")}/traces.json" {
  read_json
}
@name = "otel.span"
openai::codex::ocsf::normalize include_content=true
this = ocsf_derive(this)
this = ocsf_cast(this)
select time, metadata.event_code, class_name, activity_name, status,
       process?.cmd_line?, script?, api?.operation?, http_request?,
       http_response?, src_endpoint?, dst_endpoint?, trace?
sort time
