// Without `include_content`, an `exec` call has no script text. It stays a
// Base Event like other local tool calls and keeps the script hash.
from {
  time: 2026-10-02T09:05:00Z,
  observed_time: 2026-10-02T09:05:00Z,
  severity_number: 9,
  severity_text: "INFO",
  flags: 1,
  resource: {attributes: {"service.name": "codex-app-server", "service.version": "0.153.4", "host.name": "dev-box"}},
  scope: {name: "codex_otel.log_only"},
  receiver: {transport: "grpc"},
  body: null,
  attributes: {
    "event.name": "codex.tool_result",
    "conversation.id": "c6",
    "user.account_id": "acct-6",
    tool_name: "exec",
    tool_namespace: "functions",
    call_id: "call-script-2",
    arguments: "text(await tools.exec_command({cmd:\"df -h\"}));\n",
    success: true,
    duration_ms: "80",
  },
}
@name = "otel.log"
openai::codex::ocsf::normalize
this = ocsf_cast(this)
select class_uid, activity_id, message, script?, unmapped
