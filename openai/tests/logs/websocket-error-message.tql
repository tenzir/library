// A failed websocket request reports its reason in `error.message`.
from {
  time: 2026-10-02T09:05:00Z,
  observed_time: 2026-10-02T09:05:00Z,
  trace_id: "44444444444444444444444444444444",
  span_id: "4444444444444441",
  severity_number: 9,
  severity_text: "INFO",
  flags: 1,
  resource: {attributes: {"service.name": "codex-app-server", "service.version": "0.153.4"}},
  scope: {name: "codex_otel.log_only"},
  receiver: {transport: "grpc"},
  body: null,
  attributes: {
    "event.name": "codex.websocket_request",
    "conversation.id": "c3",
    model: "gpt-5",
    success: false,
    duration_ms: "2",
    "error.message": "failed to send websocket request: connection reset",
  },
}
@name = "otel.log"
openai::codex::ocsf::normalize
this = ocsf_cast(this)
select time, class_uid, activity_id, status_id, status_detail, message
