// Real Codex OTLP records captured from log-lab on 2026-09-04. User identity
// fields are omitted; tool values are unchanged.
from_file f"{env("TENZIR_INPUTS")}/../logs/mcp-harness-result.input" {
  read_ndjson
}
severity_number = 9
severity_text = "INFO"
flags = 1
@name = "otel.log"
openai::codex::ocsf include_content=true
ocsf_derive
ocsf_cast
select time, metadata.event_code, class_name, activity_name, action?, status,
       api?.operation?, api_service=api?.service?.name?,
       dst_service=dst_endpoint?.svc_name?, request_uid=api?.request?.uid?,
       request_data=api?.request?.data?, resources?,
       duration_ms=unmapped.duration_ms?,
       arguments_length=unmapped.arguments_length?,
       output_length=unmapped.output_length?,
       output_line_count=unmapped.output_line_count?,
       output_truncated=unmapped.output_truncated?,
       tool_origin=unmapped.tool_origin?,
       tool_result_seq=unmapped.tool_result_seq?,
       mcp_server_origin=unmapped.mcp_server_origin?
