// A shell tool decision carries no arguments, so the process has no
// `cmd_line` instead of an empty placeholder.
from {
  time: 2026-10-02T09:15:00Z,
  observed_time: 2026-10-02T09:15:00Z,
  severity_number: 9,
  severity_text: "INFO",
  flags: 1,
  resource: {attributes: {"service.name": "codex-app-server", "service.version": "0.153.4"}},
  scope: {name: "codex_otel.log_only"},
  receiver: {transport: "grpc"},
  body: null,
  attributes: {
    "event.name": "codex.tool_decision",
    "conversation.id": "c6",
    tool_name: "exec_command",
    call_id: "call-make",
    decision: "approved",
    source: "user",
  },
}
@name = "otel.log"
openai::codex::ocsf::normalize
this = ocsf_cast(this)
select class_uid, activity_id, process, tool_name=unmapped.tool_name
