// One `apply_patch` call that adds, renames, deletes and edits four files. Each
// header becomes its own File System Activity event; the `*** Move to:` header
// pairs with the `*** Update File:` before it as one rename.
from_file f"{env("TENZIR_INPUTS")}/../logs/apply-patch-multi-file.input" {
  read_ndjson
}
@name = "otel.log"
openai::codex::ocsf::normalize
this = ocsf_derive(this)
strict {
  this = ocsf_cast(this)
}
// Inspect retained mapping facts separately from the validated event.
details = {
  ...this,
  ...ocsf_derive(unmapped.incomplete_activity?),
  ...unmapped.ocsf_residue?,
}
select time, class_name, activity_name, status, details.file?.path?, details.file?.name?,
       details.file_result?.path?, call_id=unmapped.tool_use_id
