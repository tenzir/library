// A failed model request carries the server's request ID, which identifies
// the API request.
from {
  time: 2026-10-02T09:20:00Z,
  observed_time: 2026-10-02T09:20:00Z,
  severity_number: 9,
  severity_text: "INFO",
  flags: 1,
  resource: {attributes: {"service.name": "codex-app-server", "service.version": "0.153.4", "host.name": "dev-box"}},
  scope: {name: "codex_otel.log_only"},
  receiver: {transport: "grpc"},
  body: null,
  attributes: {
    "event.name": "codex.api_request",
    "conversation.id": "c7",
    "user.account_id": "acct-7",
    endpoint: "/responses",
    attempt: 0,
    duration_ms: "210",
    "http.response.status_code": 401,
    "error.message": "unexpected status 401 Unauthorized",
    "auth.request_id": "req-server-7",
  },
}
@name = "otel.log"
openai::codex::ocsf::normalize
this = ocsf_cast(this)
select class_uid, activity_id, api, status_id, unmapped
