// Synthetic regression test for outcome-aware file messages.
from {
  time: 2026-09-10T12:00:00Z,
  observed_time: 2026-09-10T12:00:00Z,
  trace_id: null,
  span_id: null,
  severity_number: 0,
  severity_text: null,
  flags: 1,
  resource: {attributes: {"service.name": "codex_cli_rs"}},
  scope: {name: "codex_otel.log_only"},
  receiver: {transport: "grpc"},
  body: null,
  attributes: {
    "event.name": "codex.tool_result",
    tool_name: "Read",
    call_id: "synthetic-file-failure",
    arguments: "{\"file_path\":\"/tmp/example.txt\"}",
    success: "false",
  },
}
@name = "otel.log"
openai::codex::ocsf::normalize
ocsf_derive
ocsf_cast
select class_name, activity_name, status, message
