// Synthetic regression: only successful deletion establishes is_deleted.
from {
  time: 2026-09-10T12:00:00Z,
  observed_time: 2026-09-10T12:00:00Z,
  trace_id: null,
  span_id: null,
  severity_number: 0,
  severity_text: null,
  flags: 1,
  resource: {attributes: {"service.name": "codex_cli_rs"}},
  scope: {name: "codex_otel.log_only"},
  receiver: {transport: "grpc"},
  body: null,
  attributes: {
    "event.name": "codex.tool_result",
    tool_name: "Delete",
    call_id: "synthetic-delete-success",
    arguments: "{\"file_path\":\"/tmp/example.txt\"}",
    success: "true",
  },
}
@name = "otel.log"
openai::codex::ocsf::normalize
this = ocsf_derive(this)
strict {
  this = ocsf_cast(this)
  assert class_uid == 0
  assert unmapped.incomplete_activity.class_uid == 1001
  assert unmapped.incomplete_activity.file.is_deleted == true
}
// Inspect retained mapping facts separately from the validated event.
details = {
  ...this,
  ...ocsf_derive(unmapped.incomplete_activity?),
  ...unmapped.ocsf_residue?,
}
select class_name, activity_name, status, message, details.file?.path?, details.file?.is_deleted?
