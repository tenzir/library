// Synthetic log without the optional attributes object.
from {
  observed_time: 2026-09-10T15:30:00Z,
  body: {kind: "string", string_value: "diagnostic"},
  resource: {attributes: {"service.name": "codex_cli_rs"}},
  scope: {name: "regression"},
  receiver: {transport: "grpc"},
}
@name = "otel.log"
openai::codex::ocsf::normalize
ocsf_derive
ocsf_cast
assert class_uid == 0
select class_uid, metadata.event_code
