// Real Codex `exec_command` completion captured from native OTLP.
from_file f"{env("TENZIR_INPUTS")}/../native-logs-sample.input" {
  read_ndjson
}
where attributes["event.name"] == "codex.tool_result"
where attributes.tool_name == "exec_command"
@name = "otel.log"
openai::codex::ocsf::normalize
this = ocsf_cast(this)
select metadata.event_code, class_uid, activity_id, status_id,
       status_code?, exit_code?, duration?, tool_duration_ms=unmapped.duration_ms?,
       process.uid, process.pid?, process.cmd_line, tool_name=unmapped.tool_name,
       process.created_time?, process.terminated_time?
