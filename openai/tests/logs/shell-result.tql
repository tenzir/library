// Real Codex `exec_command` completion captured from native OTLP.
from_file f"{env("TENZIR_INPUTS")}/../native-logs-sample.input" {
  read_ndjson
}
where attributes["event.name"] == "codex.tool_result"
where attributes.tool_name == "exec_command"
@name = "otel.log"
openai::codex::ocsf
ocsf_derive
ocsf_cast
select metadata.event_code, class_uid, class_name, activity_name, status,
       status_code?, exit_code?, duration?, tool_duration_ms=unmapped.duration?,
       process.uid, process.pid?, process.name, process.cmd_line,
       process.created_time?, process.terminated_time?
