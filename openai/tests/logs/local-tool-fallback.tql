// A `write_stdin` result has no OCSF class and falls back to Base Event, which
// must still name the tool, the call and the session.
from {
  time: 2026-09-04T13:00:00Z,
  observed_time: 2026-09-04T13:00:00Z,
  trace_id: "22222222222222222222222222222222",
  span_id: "2222222222222221",
  severity_number: 9,
  severity_text: "INFO",
  flags: 1,
  resource: {attributes: {"service.name": "codex_cli_rs", "service.version": "0.151.0"}},
  scope: {name: "codex_otel.log_only"},
  receiver: {transport: "grpc"},
  body: null,
  attributes: {
    "event.name": "codex.tool_result",
    "conversation.id": "c1",
    tool_name: "write_stdin",
    call_id: "call-stdin",
    arguments: "{\"session_id\":7,\"chars\":\"y\\n\"}",
    success: "true",
    duration_ms: "4",
  },
}
@name = "otel.log"
openai::codex::ocsf
ocsf_derive
ocsf_cast
select time, class_name, activity_name, message, status,
       tool_name=unmapped.tool_name, call_id=unmapped.tool_use_id,
       session_id=unmapped.session_id,
       terminal_session_id=unmapped.terminal_session_id
