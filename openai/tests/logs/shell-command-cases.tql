// Native Codex `exec_command` results captured from the raw `otlp.events`
// archive in log-lab on 2026-09-03. The fixture retains only fields consumed
// by this mapping test; values are unchanged from the archived `event` JSON.
from_file f"{env("TENZIR_INPUTS")}/../logs/shell-command-cases.input" {
  read_ndjson
}
@name = "otel.log"
openai::codex::ocsf
ocsf_derive
ocsf_cast
select process?.uid?, class_name, activity_name, status, status_code?, exit_code?,
       tool_duration_ms=unmapped.duration?, command=process?.cmd_line?,
       request_command=api?.request?.data?.command?,
       terminal_session_id=unmapped.terminal_session_id?
