// Codex names the shell tool, not the program it launches, so the process
// stays unnamed and the tool name stays in `unmapped`.
from {
  time: 2026-10-02T09:10:00Z,
  observed_time: 2026-10-02T09:10:00Z,
  severity_number: 9,
  severity_text: "INFO",
  flags: 1,
  resource: {attributes: {"service.name": "codex-app-server", "service.version": "0.153.4"}},
  scope: {name: "codex_otel.log_only"},
  receiver: {transport: "grpc"},
  body: null,
  attributes: {
    "event.name": "codex.tool_result",
    "conversation.id": "c5",
    tool_name: "exec_command",
    call_id: "call-ls",
    arguments: "{\"cmd\":\"ls -la docs\"}",
    success: true,
    output: "Chunk ID: 1\nWall time: 0.0 seconds\nProcess exited with code 0\nOutput:\nREADME.md",
  },
}
@name = "otel.log"
openai::codex::ocsf::normalize
this = ocsf_cast(this)
select class_uid, activity_id, exit_code, process, tool_name=unmapped.tool_name
