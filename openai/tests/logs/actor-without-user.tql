// Model list requests run outside a signed-in session and name no user, so
// the actor has no user.
from {
  time: 2026-10-02T09:25:00Z,
  observed_time: 2026-10-02T09:25:00Z,
  severity_number: 9,
  severity_text: "INFO",
  flags: 1,
  resource: {attributes: {"service.name": "codex-app-server", "service.version": "0.153.4", "host.name": "dev-box"}},
  scope: {name: "codex_otel.log_only"},
  receiver: {transport: "grpc"},
  body: null,
  attributes: {
    "event.name": "codex.api_request",
    endpoint: "/models",
    attempt: 0,
    duration_ms: "95",
    success: true,
    "http.response.status_code": 200,
    "auth.mode": "Chatgpt",
  },
}
@name = "otel.log"
openai::codex::ocsf::normalize
this = ocsf_cast(this)
select class_uid, activity_id, actor
