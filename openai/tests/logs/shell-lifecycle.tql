// A real Codex decision/result pair from native OTLP. The two source records
// must remain two process lifecycle events with one producer-assigned UID.
from_file f"{env("TENZIR_INPUTS")}/../native-logs-sample.input" {
  read_ndjson
}
where attributes.call_id? == "exec-c76f89ec-8428-4174-95f0-c0a09c841fbd"
@name = "otel.log"
openai::codex::ocsf
ocsf_derive
ocsf_cast
select time, class_name, activity_name, status, action?, disposition?,
       process.uid, process.pid?, process.name, process.cmd_line,
       process.created_time?, process.terminated_time?, exit_code?
