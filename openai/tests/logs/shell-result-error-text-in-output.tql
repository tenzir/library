// Synthetic guard: error text printed by a command is not a validation failure.
from {
  time: 2026-09-10T12:00:00Z,
  observed_time: 2026-09-10T12:00:00Z,
  trace_id: null,
  span_id: null,
  severity_number: 9,
  severity_text: "INFO",
  flags: 1,
  resource: {attributes: {"service.name": "codex_cli_rs"}},
  scope: {name: "codex_otel.log_only"},
  receiver: {transport: "grpc"},
  body: null,
  attributes: {
    "event.name": "codex.tool_result",
    tool_name: "exec_command",
    call_id: "synthetic-error-text-in-output",
    success: "true",
    output: "Process exited with code 0\nOutput:\nfailed to parse function arguments: example text",
  },
}
@name = "otel.log"
openai::codex::ocsf
ocsf_derive
ocsf_cast
select class_name, activity_name, status, message,
       exit_code?, process.uid, process.terminated_time?,
       tool_success=unmapped.tool_success
