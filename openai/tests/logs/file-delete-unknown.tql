// Synthetic regression: only successful deletion establishes is_deleted.
from {
  time: 2026-09-10T12:00:00Z,
  observed_time: 2026-09-10T12:00:00Z,
  trace_id: null,
  span_id: null,
  severity_number: 0,
  severity_text: null,
  flags: 1,
  resource: {attributes: {"service.name": "codex_cli_rs"}},
  scope: {name: "codex_otel.log_only"},
  receiver: {transport: "grpc"},
  body: null,
  attributes: {
    "event.name": "codex.tool_decision",
    tool_name: "Delete",
    call_id: "synthetic-delete-unknown",
    arguments: "{\"file_path\":\"/tmp/example.txt\"}",
    decision: "accept",
    source: "config",
  },
}
@name = "otel.log"
openai::codex::ocsf
ocsf_derive
ocsf_cast
select class_name, activity_name, status, message, file.path, file.is_deleted?
