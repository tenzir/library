from_file f"{env("TENZIR_INPUTS")}/logs.json" {
  read_json
}
openai::codex::ocsf_legacy_envelope include_content=true
ocsf_derive
ocsf_cast
select time, metadata.event_code, class_name, activity_name, status,
       process?.cmd_line?, file?.path?, file?.is_deleted?, api?.operation?,
       unmapped.tool_parameters?
sort time
