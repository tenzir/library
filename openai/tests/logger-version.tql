// Keep the instrumentation version distinct from the application version.
from_file f"{env("TENZIR_INPUTS")}/../native-log.input" {
  read_ndjson
}
@name = "otel.log"
openai::codex::canonicalize
// Missing scope attributes should yield nulls, not suppress logger metadata.
scope = [
  {
    name: "example.instrumentation",
    version: "1.2.3",
  },
  {
    name: null,
    version: "1.2.3",
  },
  {
    name: "example.instrumentation",
    version: null,
  },
  null,
]
unroll scope
source = this
openai::codex::ocsf::map source, ocsf
this = ocsf
ocsf_cast
select metadata.loggers, scope_residue=unmapped.scope?
