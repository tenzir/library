---
description: |
  Adapts a Sysmon event collected by NXLog to the `System` and `EventData`
  structure used by the OCSF mapper. Configure NXLog with `AddPrefix TRUE` and
  read its JSON with `unflatten_separator="."` to preserve provider fields that
  collide with NXLog metadata, such as `EventType`.
args:
  positional:
    - name: event
      type: field
      description: The NXLog event to adapt in place.
---

$event = {nxlog: move $event}
$event.canonical = {
  System: {
    Provider: {
      Name: move $event.nxlog.SourceName?,
      Guid: move $event.nxlog.ProviderGuid?,
    },
    EventID: move $event.nxlog.EventID,
    Version: move $event.nxlog.Version?,
    Level: move $event.nxlog.LevelValue?,
    Task: (
      move $event.nxlog.Task?
    ) else (
      move $event.nxlog.TaskValue?
    ),
    Opcode: move $event.nxlog.OpcodeValue?,
    Keywords: move $event.nxlog.Keywords?,
    TimeCreated: {
      SystemTime: move $event.nxlog.EventTime?,
    },
    EventRecordID: move $event.nxlog.RecordNumber?,
    Execution: {
      ProcessID: (
        move $event.nxlog.ProcessID?
      ) else (
        move $event.nxlog.ExecutionProcessID?
      ),
      ThreadID: (
        move $event.nxlog.ThreadID?
      ) else (
        move $event.nxlog.ExecutionThreadID?
      ),
    },
    Channel: move $event.nxlog.Channel?,
    Computer: move $event.nxlog.Hostname?,
    Security: {
      UserID: move $event.nxlog.UserID?,
    },
  },
  NXLog: {
    event_received_time: move $event.nxlog.EventReceivedTime?,
    message: move $event.nxlog.Message?,
    module_name: move $event.nxlog.SourceModuleName?,
    module_type: move $event.nxlog.SourceModuleType?,
    severity: move $event.nxlog.Severity?,
    severity_value: move $event.nxlog.SeverityValue?,
    level: move $event.nxlog.Level?,
    category: move $event.nxlog.Category?,
    opcode: move $event.nxlog.Opcode?,
    activity_uid: move $event.nxlog.ActivityID?,
    related_activity_uid: move $event.nxlog.RelatedActivityID?,
    raw_event: move $event.nxlog.raw_event?,
    event_xml: move $event.nxlog.EventXML?,
  },
}

if (
  $event.nxlog.AccountName? != null
  or $event.nxlog.Domain? != null
  or $event.nxlog.AccountType? != null
) {
  $event.canonical.NXLog.account = {
    name: move $event.nxlog.AccountName?,
    domain: move $event.nxlog.Domain?,
    type: move $event.nxlog.AccountType?,
  }
}

// With AddPrefix disabled, NXLog and Sysmon may both emit `EventType` into the
// same flat field. Preserve a non-severity value as Sysmon EventData, but treat
// every documented NXLog severity caption as collector metadata.
if $event.nxlog.EventData? != null or $event.nxlog.EventType? in [
  "AUDIT_FAILURE",
  "AUDIT_SUCCESS",
  "CRITICAL",
  "ERROR",
  "INFO",
  "VERBOSE",
  "WARNING",
] {
  $event.canonical.NXLog.event_type = move $event.nxlog.EventType?
}

if $event.nxlog.EventData? != null {
  $event.canonical.EventData = move $event.nxlog.EventData
  $event.canonical.NXLog = {
    ...$event.canonical.NXLog,
    ...move $event.nxlog,
  }
} else {
  $event.canonical.EventData = move $event.nxlog
}
$event.canonical.NXLog = drop_null_fields($event.canonical.NXLog)
$event = move $event.canonical
