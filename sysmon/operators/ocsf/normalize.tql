---
description: Normalizes a structured Microsoft Sysmon event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      default: this
      description: A parsed Windows Event Log or NXLog JSON event.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the OCSF event.
    - name: log_format
      type: string
      default: null
      description: The source format. The operator infers XML and NXLog JSON inputs by default.
---

$into = {source: $event, ocsf: {}}
sysmon::ocsf::map $into.source, $into.ocsf, log_format=$log_format
$into = move $into.ocsf
