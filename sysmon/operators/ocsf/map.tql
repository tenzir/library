---
description: Maps a structured Microsoft Sysmon event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The structured Sysmon event to map.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the OCSF event.
---


$into = {sysmon: $event, ocsf: {}}

$into.ocsf.metadata = {
  event_code: (move $into.sysmon.System.EventID).string(),
  extensions: [{name: "win"}],
  log_format: "xml",
  log_name: move $into.sysmon.System.Channel,
  log_level: (move $into.sysmon.System.Level).string(),
  log_version: (move $into.sysmon.System.Version).string(),
  logged_time: move $into.sysmon.System.TimeCreated.SystemTime,
  original_event_uid: (move $into.sysmon.System.EventRecordID).string(),
  processed_time: now(),
  product: {
    name: move $into.sysmon.System.Provider.Name,
    uid: move $into.sysmon.System.Provider.Guid,
    vendor_name: "Microsoft",
  },
  profiles: ["host"],
  version: "1.9.0",
}

$into.ocsf.severity_id = 1

$into.ocsf.time = move $into.sysmon.EventData.UtcTime

$into.ocsf.device = {
  hostname: move $into.sysmon.System.Computer,
}

// ProcessID and ThreadID identify the Sysmon service itself, not the target event.
drop $into.sysmon.System.Execution
drop $into.sysmon.System.Provider
drop $into.sysmon.System.TimeCreated

// Security.UserID is the Sysmon service account SID (typically S-1-5-18 / SYSTEM),
// not the device owner — leave it in unmapped.
drop $into.sysmon.System.Security

// Correlation is always empty for Sysmon (it does not use ETW ActivityIDs),
// and OCSF's metadata.correlation_uid is for linking OCSF events — a different
// concept — so there is no valid mapping target.
drop $into.sysmon.System.Correlation

// RuleName is a Sysmon filter-rule tag present on most EIDs. It is not a
// property of any observed object, so it is dropped centrally here rather
// than in every individual mapping operator.
drop $into.sysmon.EventData.RuleName?

if $into.ocsf.metadata.event_code == "1" {
  sysmon::ocsf::events::process_create event=$into
} else if $into.ocsf.metadata.event_code == "2" {
  sysmon::ocsf::events::file_create_time event=$into
} else if $into.ocsf.metadata.event_code == "3" {
  sysmon::ocsf::events::network_connect event=$into
} else if $into.ocsf.metadata.event_code == "4" {
  sysmon::ocsf::events::service_state_change event=$into
} else if $into.ocsf.metadata.event_code == "5" {
  sysmon::ocsf::events::process_terminate event=$into
} else if $into.ocsf.metadata.event_code == "6" {
  sysmon::ocsf::events::driver_load event=$into
} else if $into.ocsf.metadata.event_code == "7" {
  sysmon::ocsf::events::image_load event=$into
} else if $into.ocsf.metadata.event_code == "8" {
  sysmon::ocsf::events::create_remote_thread event=$into
} else if $into.ocsf.metadata.event_code == "9" {
  sysmon::ocsf::events::raw_access_read event=$into
} else if $into.ocsf.metadata.event_code == "10" {
  sysmon::ocsf::events::process_access event=$into
} else if $into.ocsf.metadata.event_code == "11" {
  sysmon::ocsf::events::file_create event=$into
} else if $into.ocsf.metadata.event_code == "12" {
  sysmon::ocsf::events::registry_create_delete event=$into
} else if $into.ocsf.metadata.event_code == "13" {
  sysmon::ocsf::events::registry_value_set event=$into
} else if $into.ocsf.metadata.event_code == "14" {
  sysmon::ocsf::events::registry_rename event=$into
} else if $into.ocsf.metadata.event_code == "15" {
  sysmon::ocsf::events::file_create_stream_hash event=$into
} else if $into.ocsf.metadata.event_code == "16" {
  sysmon::ocsf::events::sysmon_config_change event=$into
} else if $into.ocsf.metadata.event_code == "17" {
  sysmon::ocsf::events::pipe_created event=$into
} else if $into.ocsf.metadata.event_code == "18" {
  sysmon::ocsf::events::pipe_connected event=$into
} else if $into.ocsf.metadata.event_code in ["19", "20", "21"] {
  sysmon::ocsf::events::wmi_events event=$into
} else if $into.ocsf.metadata.event_code == "22" {
  sysmon::ocsf::events::dns_query event=$into
} else if $into.ocsf.metadata.event_code == "23" {
  sysmon::ocsf::events::file_delete event=$into
} else if $into.ocsf.metadata.event_code == "24" {
  sysmon::ocsf::events::clipboard_change event=$into
} else if $into.ocsf.metadata.event_code == "25" {
  sysmon::ocsf::events::process_tampering event=$into
} else if $into.ocsf.metadata.event_code == "26" {
  sysmon::ocsf::events::file_delete event=$into
} else if $into.ocsf.metadata.event_code in ["27","28"] {
  sysmon::ocsf::events::file_block event=$into
} else if $into.ocsf.metadata.event_code == "29" {
  sysmon::ocsf::events::file_executable_detected event=$into
} else if $into.ocsf.metadata.event_code == "255" {
  sysmon::ocsf::events::sysmon_error event=$into
} else {
  // Base Event — unknown/future Sysmon EID
  $into.ocsf.category_uid = 0
  $into.ocsf.class_uid = 0
  $into.ocsf.activity_id = 0
  $into.ocsf.type_uid = 0
}



$into = {...$into.ocsf, unmapped: $into.sysmon}
