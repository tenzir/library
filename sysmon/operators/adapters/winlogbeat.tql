---
description: |
  Adapts a structured Sysmon event collected by Winlogbeat to the canonical
  Windows Event Log structure. The adapter preserves the remaining ECS and
  Winlogbeat fields as collector metadata.
args:
  positional:
    - name: input
      type: field
      description: The structured Winlogbeat event to adapt.
    - name: sysmon
      type: field
      description: The field that receives the canonical Windows Event Log record.
---

$sysmon = {winlogbeat: $input}
$sysmon.canonical = {
  System: {
    Provider: {
      Name: move $sysmon.winlogbeat.winlog.provider_name,
      Guid: move $sysmon.winlogbeat.winlog.provider_guid?,
    },
    EventID: move $sysmon.winlogbeat.winlog.event_id,
    Version: move $sysmon.winlogbeat.winlog.version?,
    Level: move $sysmon.winlogbeat.log.level?,
    Task: move $sysmon.winlogbeat.winlog.task?,
    Opcode: move $sysmon.winlogbeat.winlog.opcode?,
    Keywords: move $sysmon.winlogbeat.winlog.keywords?,
    TimeCreated: {
      SystemTime: move $sysmon.winlogbeat["@timestamp"],
    },
    EventRecordID: move $sysmon.winlogbeat.winlog.record_id,
    Correlation: {
      ActivityID: move $sysmon.winlogbeat.winlog.activity_id?,
      RelatedActivityID: move $sysmon.winlogbeat.winlog.related_activity_id?,
    },
    Execution: {
      ProcessID: move $sysmon.winlogbeat.winlog.process.pid?,
      ThreadID: move $sysmon.winlogbeat.winlog.process.thread.id?,
    },
    Channel: move $sysmon.winlogbeat.winlog.channel,
    Computer: move $sysmon.winlogbeat.winlog.computer_name,
    Security: {
      UserID: move $sysmon.winlogbeat.winlog.user.identifier?,
    },
  },
  EventData: move $sysmon.winlogbeat.winlog.event_data?,
  UserData: move $sysmon.winlogbeat.winlog.user_data?,
  RenderingInfo: {
    Message: move $sysmon.winlogbeat.message?,
  },
}
$sysmon.canonical.Winlogbeat = move $sysmon.winlogbeat
$sysmon = move $sysmon.canonical
