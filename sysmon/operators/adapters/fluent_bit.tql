---
description: |
  Adapts a structured Sysmon event collected by Fluent Bit's `winevtlog` input
  to the canonical Windows Event Log structure. Configure Fluent Bit with
  `event_data_as_map true` so provider fields have names. Records produced with
  `render_event_as_xml true` are also supported.
args:
  positional:
    - name: input
      type: field
      description: The structured Fluent Bit event to adapt.
    - name: sysmon
      type: field
      description: The field that receives the canonical Windows Event Log record.
---

$sysmon = {fluent_bit: $input}
if type_of($sysmon.fluent_bit.System?).kind == "string" {
  $sysmon.canonical = (move $sysmon.fluent_bit.System).parse_winlog()
} else {
  $sysmon.canonical = {
    System: {
      Provider: {
        Name: move $sysmon.fluent_bit.ProviderName,
        Guid: move $sysmon.fluent_bit.ProviderGuid?,
      },
      EventID: move $sysmon.fluent_bit.EventID,
      Version: move $sysmon.fluent_bit.Version?,
      Level: move $sysmon.fluent_bit.Level?,
      Task: move $sysmon.fluent_bit.Task?,
      Opcode: move $sysmon.fluent_bit.Opcode?,
      Keywords: move $sysmon.fluent_bit.Keywords?,
      TimeCreated: {
        SystemTime: (move $sysmon.fluent_bit.TimeCreated).parse_time("%Y-%m-%d %H:%M:%S %z"),
      },
      EventRecordID: move $sysmon.fluent_bit.EventRecordID?,
      Correlation: {
        ActivityID: move $sysmon.fluent_bit.ActivityID?,
        RelatedActivityID: move $sysmon.fluent_bit.RelatedActivityID?,
      },
      Execution: {
        ProcessID: move $sysmon.fluent_bit.ProcessID?,
        ThreadID: move $sysmon.fluent_bit.ThreadID?,
      },
      Channel: move $sysmon.fluent_bit.Channel?,
      Computer: move $sysmon.fluent_bit.Computer?,
      Security: {
        UserID: move $sysmon.fluent_bit.UserID?,
      },
    },
    EventData: move $sysmon.fluent_bit.EventData?,
  }
}
$sysmon.canonical.RenderingInfo.Message = move $sysmon.fluent_bit.Message?
$sysmon.canonical.FluentBit = move $sysmon.fluent_bit
$sysmon = move $sysmon.canonical
