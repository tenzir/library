---
description: |
  Adapts a structured Sysmon event collected by NXLog to the canonical Windows
  Event Log structure. Configure NXLog with `AddPrefix TRUE` and read its JSON
  with `unflatten_separator="."` to preserve provider fields that collide with
  NXLog metadata, such as `EventType`.
args:
  positional:
    - name: input
      type: field
      description: The structured NXLog event to adapt.
    - name: sysmon
      type: field
      description: The field that receives the canonical Windows Event Log record.
---

$sysmon = {nxlog: $input}
$sysmon.canonical = {
  System: {
    Provider: {
      Name: move $sysmon.nxlog.SourceName?,
      Guid: move $sysmon.nxlog.ProviderGuid?,
    },
    EventID: move $sysmon.nxlog.EventID,
    Version: move $sysmon.nxlog.Version?,
    Level: move $sysmon.nxlog.LevelValue?,
    Task: (
      move $sysmon.nxlog.Task?
    ) else (
      move $sysmon.nxlog.TaskValue?
    ),
    Opcode: move $sysmon.nxlog.OpcodeValue?,
    Keywords: move $sysmon.nxlog.Keywords?,
    TimeCreated: {
      SystemTime: move $sysmon.nxlog.EventTime?,
    },
    EventRecordID: move $sysmon.nxlog.RecordNumber?,
    Execution: {
      ProcessID: (
        move $sysmon.nxlog.ProcessID?
      ) else (
        move $sysmon.nxlog.ExecutionProcessID?
      ),
      ThreadID: (
        move $sysmon.nxlog.ThreadID?
      ) else (
        move $sysmon.nxlog.ExecutionThreadID?
      ),
    },
    Channel: move $sysmon.nxlog.Channel?,
    Computer: move $sysmon.nxlog.Hostname?,
    Security: {
      UserID: move $sysmon.nxlog.UserID?,
    },
  },
  NXLog: {
    event_received_time: move $sysmon.nxlog.EventReceivedTime?,
    message: move $sysmon.nxlog.Message?,
    module_name: move $sysmon.nxlog.SourceModuleName?,
    module_type: move $sysmon.nxlog.SourceModuleType?,
    severity: move $sysmon.nxlog.Severity?,
    severity_value: move $sysmon.nxlog.SeverityValue?,
    level: move $sysmon.nxlog.Level?,
    category: move $sysmon.nxlog.Category?,
    opcode: move $sysmon.nxlog.Opcode?,
    activity_uid: move $sysmon.nxlog.ActivityID?,
    related_activity_uid: move $sysmon.nxlog.RelatedActivityID?,
    raw_event: move $sysmon.nxlog.raw_event?,
    event_xml: move $sysmon.nxlog.EventXML?,
  },
}

if (
  $sysmon.nxlog.AccountName? != null
  or $sysmon.nxlog.Domain? != null
  or $sysmon.nxlog.AccountType? != null
) {
  $sysmon.canonical.NXLog.account = {
    name: move $sysmon.nxlog.AccountName?,
    domain: move $sysmon.nxlog.Domain?,
    type: move $sysmon.nxlog.AccountType?,
  }
}

// With AddPrefix disabled, NXLog and Sysmon may both emit `EventType` into the
// same flat field. Preserve a non-severity value as Sysmon EventData, but treat
// every documented NXLog severity caption as collector metadata.
if (
  $sysmon.nxlog.EventData? != null
  or $sysmon.nxlog.EventType? in sysmon::$nxlog_event_types
) {
  $sysmon.canonical.NXLog.event_type = move $sysmon.nxlog.EventType?
}

if $sysmon.nxlog.EventData? != null {
  $sysmon.canonical.EventData = move $sysmon.nxlog.EventData
  $sysmon.canonical.NXLog = {
    ...$sysmon.canonical.NXLog,
    ...move $sysmon.nxlog,
  }
} else {
  $sysmon.canonical.EventData = move $sysmon.nxlog
}
$sysmon.canonical.NXLog = drop_null_fields($sysmon.canonical.NXLog)
$sysmon = move $sysmon.canonical
