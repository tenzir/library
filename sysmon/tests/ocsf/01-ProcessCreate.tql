from_file f"{env("TENZIR_INPUTS")}/01-ProcessCreate.xml" {
  read_all
}
win = data.parse_winlog()
sysmon::canonicalize win, sysmon
sysmon::ocsf::map sysmon, ocsf
ocsf.metadata.log_format = "xml"
ocsf.raw_data = move data
ocsf.raw_data_size = ocsf.raw_data.length_bytes()
this = ocsf
ocsf_cast

// Ensure determinstic tests.
drop metadata.processed_time
