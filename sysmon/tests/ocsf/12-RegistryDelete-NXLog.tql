---
pre-compare: sort
---

from_file f"{env("TENZIR_INPUTS")}/12-RegistryDelete.nxlog.json" {
  read_ndjson unflatten_separator="."
}
sysmon::canonicalize this, sysmon
sysmon::ocsf::map sysmon, ocsf
ocsf.metadata.log_format = "json"
this = move ocsf
ocsf_cast

// Ensure deterministic tests.
drop metadata.processed_time
