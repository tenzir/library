---
name: Sysmon NXLog JSON → OCSF
description: |
  Read Sysmon events serialized as JSON by NXLog and normalize them to OCSF.
  Configure NXLog with `AddPrefix TRUE` to preserve provider fields.
---

from_file "sysmon-nxlog.ndjson" {
  read_ndjson unflatten_separator="."
}
sysmon::ocsf::normalize
metadata.log_format = "json"
ocsf_derive
ocsf_cast
