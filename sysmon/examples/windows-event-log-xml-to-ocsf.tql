---
name: Sysmon Windows Event Log XML → OCSF
description: Parse a Sysmon Windows Event Log XML record and normalize it to OCSF.
---

from_file "sysmon.xml" {
  read_all
}
event = data.parse_winlog()
sysmon::ocsf::normalize event, into=ocsf
ocsf.raw_data = move data
ocsf.raw_data_size = ocsf.raw_data.length_bytes()
this = ocsf
ocsf_derive
ocsf_cast
