---
description: Maps a MISP Event to OCSF 1.9 OSINT Inventory Info.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The structured MISP Event to map.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the OCSF event.
---


let $threat_level = {
  "1": 4,  // High → High
  "2": 3,  // Medium → Medium
  "3": 2,  // Low → Low
  "4": 1,  // Undefined → Informational
}
let $analysis_status = {
  "0": 0,   // Initial → Unknown
  "1": 99,  // Ongoing → Other
  "2": 1,   // Completed → Success
}
let $type_ids = {
  "ip-dst": 1,
  "ip-src": 1,
  domain: 2,
  hostname: 3,
  url: 5,
  "email-src": 9,
  "email-dst": 9,
  AS: 99,
  filename: 11,
  md5: 4,
  sha1: 4,
  sha256: 4,
  "size-in-bytes": 11,
  "file-type": 11,
  "mime-type": 11,
  mutex: 99,
  "process-name": 99,
  pid: 99,
  port: 99,
  "user-agent": 6,
  comment: 0,
  text: 0,
  vulnerability: 10,
  link: 5,
}
$into = {misp: $event, ocsf: {}}
// ------ OCSF Inventory Info --------
// Classification
$into.ocsf.activity_id = 2
$into.ocsf.category_uid = 5
$into.ocsf.class_uid = 5021
$into.ocsf.severity_id = 1
$into.ocsf.type_uid = $into.ocsf.class_uid * 100 + $into.ocsf.activity_id
$into.ocsf.severity_id = $threat_level[move $into.misp.threat_level_id]? else 1
// Context
$into.ocsf.actor = {
  app_name: "Tenzir",
  process: {
    name: "MISP",
  },
  user: {
    // Creator org of the MISP event.
    org: {
      name: move $into.misp.Orgc.name?,
      uid: move $into.misp.Orgc.uuid?,
    }
  }
}
if $into.misp.Org? != null {
  // Org currently owning the MISP event.
  $into.ocsf.actor.process.user = {
    org: {
      name: move $into.misp.Org.name?,
      uid: move $into.misp.Org.uuid?,
    },
  }
}
$into.ocsf.metadata = {
  product: {
    name: "MISP",
    vendor_name: "CIRCL",
  },
  uid: move $into.misp.uuid,
  version: "1.9.0",
}
$into.ocsf.time = from_epoch(int(move $into.misp.timestamp) * 1s)
drop $into.misp.date // implied in the timestamp
// Primary
$into.ocsf.message = move $into.misp.info
$into.ocsf.osint = $into.misp.Attribute.map(x => {
  category: x.category,
  created_time: from_epoch(int(x.timestamp) * 1s),
  creator: {
    org: $into.ocsf.actor.user.org, // Orgc
  },
  desc: x.comment,
  external_uid: x.uuid,
  severity_id: $into.ocsf.severity_id,
  // TODO: Figure out how to assign `null` if no tlp tag in the source.
  tlp: $into.misp.Tag?.where(x => x.name.starts_with("tlp:"))[0]?.name?.slice(begin=4).to_upper(),
  type_id: $type_ids[x.type]? else 99,
  type: x.type if $type_ids[x.type]? == null,
  value: x.value,
})
$into.ocsf.status_id = $analysis_status[move $into.misp.analysis]? else 0
drop $into.misp.Attribute?
// TODO: consider mapping the Galaxy in the future. For now, we drop
// it because it is incredibly bulky.
drop $into.misp.Galaxy?
// ------ Finalize --------

@name = "ocsf.osint_inventory_info"

$into = {...$into.ocsf, unmapped: $into.misp}
