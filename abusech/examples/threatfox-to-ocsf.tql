---
name: ThreatFox → OCSF
description: |
  Fetches recent ThreatFox indicators and maps them to OCSF OSINT Inventory
  Info events.
---

abusech::threatfox::fetch auth_key=secret("THREATFOX_AUTH_KEY"), days=7
this = {source: this, ocsf: {}}
abusech::threatfox::ocsf::map source, ocsf
this = ocsf
ocsf_derive
ocsf_cast
