---
name: Publish Feodo Tracker OSINT
description: |
  Periodically fetches Feodo Tracker indicators and publishes them as OCSF
  OSINT Inventory Info events.
---

every 1h {
  abusech::feodo::fetch
}
this = {source: this, ocsf: {}}
abusech::feodo::ocsf::map source, ocsf
this = ocsf
ocsf_derive
publish "ocsf"
