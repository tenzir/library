---
name: Publish URLhaus OSINT
description: |
  Periodically fetches URLhaus URL indicators and publishes them as OCSF OSINT
  Inventory Info events.
---

every 1h {
  abusech::urlhaus::fetch
}
this = {source: this, ocsf: {}}
abusech::urlhaus::ocsf::map source, ocsf
this = ocsf
ocsf_derive
publish "ocsf"
