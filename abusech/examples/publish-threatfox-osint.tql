---
name: Publish ThreatFox OSINT
description: |
  Periodically fetches ThreatFox indicators and publishes them as OCSF OSINT
  Inventory Info events.
---

every 1h {
  abusech::threatfox::fetch auth_key=secret("THREATFOX_AUTH_KEY")
}
this = {source: this, ocsf: {}}
abusech::threatfox::ocsf::map source, ocsf
this = ocsf
ocsf_derive
publish "ocsf"
