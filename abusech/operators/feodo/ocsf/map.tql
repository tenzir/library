---
description: Maps feodo rows to OCSF 1.9 OSINT Inventory Info.
args:
  positional:
    - name: event
      type: field
      description: The structured source row to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

$ocsf = {
  activity_id: 2,
  actor: {app_name: "Tenzir"},
  category_uid: 5,
  class_uid: 5021,
  metadata: {
    product: {
      name: "Feodo Tracker",
      vendor_name: "abuse.ch",
    },
    version: "1.9.0",
  },
  osint: [{
    category: "botnet c2",
    confidence_id: 3,
    created_time: time($event.first_seen_utc),
    malware: [{
      classification_ids: [0],
      name: move $event.malware,
      provider: "Feodo Tracker",
    }],
    severity_id: 4,
    src_url: "https://feodotracker.abuse.ch/downloads/ipblocklist_aggressive.csv",
    type_id: 1,
    value: string(move $event.dst_ip),
    vendor_name: "abuse.ch",
  }],
  severity_id: 1,
  time: time(move $event.first_seen_utc),
  type_uid: 502102,
}

@name = "ocsf.osint_inventory_info"

$ocsf.unmapped = move $event
