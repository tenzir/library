---
description: Maps feodo rows to OCSF 1.9 OSINT Inventory Info.
args:
  positional:
    - name: event
      type: field
      description: The structured source row to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---


$ocsf = {}

$event._osint = {}
$event._osint.category = "botnet c2"
$event._osint.confidence_id = 3
$event._osint.created_time = time($event.first_seen_utc)
drop $event.first_seen_utc
$event._osint.malware = [{
  classification_ids: [0],
  name: move $event.malware,
  provider: "Feodo Tracker",
}]
$event._osint.severity_id = 4
$event._osint.src_url = "https://feodotracker.abuse.ch/downloads/ipblocklist_aggressive.csv"
$event._osint.type_id = 1
$event._osint.value = string(move $event.dst_ip)
$event._osint.vendor_name = "abuse.ch"

$ocsf = {}
$ocsf.activity_id = 2
$ocsf.actor = {
  app_name: "Tenzir",
}
$ocsf.category_uid = 5
$ocsf.class_uid = 5021
$ocsf.metadata = {
  product: {
    name: "Feodo Tracker",
    vendor_name: "abuse.ch",
  },
  version: "1.9.0",
}
$ocsf = {...$ocsf, osint: [move $event._osint]}
$ocsf.severity_id = 1
$ocsf.time = $ocsf.osint[0].created_time
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id


@name = "ocsf.osint_inventory_info"

$ocsf.unmapped = move $event
