---
description: Maps urlhaus rows to OCSF 1.9 OSINT Inventory Info.
args:
  positional:
    - name: event
      type: field
      description: The structured source row to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---


$ocsf = {}

$event._osint = {}
$event._osint.category = move $event.threat?
$event._osint.confidence_id = 3
$event._osint.created_time = time($event.dateadded)
drop $event.dateadded
$event._osint.external_uid = string(move $event.id)
if $event.last_online? != null {
  $event._osint.modified_time = time($event.last_online)
  drop $event.last_online
}
if $event.reporter? != null {
  $event._osint.creator = {
    name: move $event.reporter,
  }
}
if $event.tags? != null {
  $event._osint.labels = (move $event.tags).split(",")
}
if $event.urlhaus_link? != null {
  $event._osint.references = [$event.urlhaus_link]
  $event._osint.src_url = move $event.urlhaus_link
} else {
  $event._osint.src_url = "https://urlhaus.abuse.ch/"
}
$event._osint.severity_id = 4
$event._osint.type_id = 5
$event._osint.value = move $event.url
$event._osint.vendor_name = "abuse.ch"

$ocsf = {}
$ocsf.activity_id = 2
$ocsf.actor = {
  app_name: "Tenzir",
}
$ocsf.category_uid = 5
$ocsf.class_uid = 5021
$ocsf.metadata = {
  product: {
    name: "URLhaus",
    vendor_name: "abuse.ch",
  },
  version: "1.9.0",
}
$ocsf = {...$ocsf, osint: [move $event._osint]}
$ocsf.severity_id = 1
$ocsf.time = $ocsf.osint[0].created_time
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id


@name = "ocsf.osint_inventory_info"

$ocsf.unmapped = move $event
