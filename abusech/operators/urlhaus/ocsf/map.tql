---
description: Maps urlhaus rows to OCSF 1.9 OSINT Inventory Info.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The structured source row to map.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the OCSF event.
---


$into = {urlhaus: $event, ocsf: {}}

$into.osint = {}
$into.osint.category = move $into.urlhaus.threat?
$into.osint.confidence_id = 3
$into.osint.created_time = time($into.urlhaus.dateadded)
drop $into.urlhaus.dateadded
$into.osint.external_uid = string(move $into.urlhaus.id)
if $into.urlhaus.last_online? != null {
  $into.osint.modified_time = time($into.urlhaus.last_online)
  drop $into.urlhaus.last_online
}
if $into.urlhaus.reporter? != null {
  $into.osint.creator = {
    name: move $into.urlhaus.reporter,
  }
}
if $into.urlhaus.tags? != null {
  $into.osint.labels = (move $into.urlhaus.tags).split(",")
}
if $into.urlhaus.urlhaus_link? != null {
  $into.osint.references = [$into.urlhaus.urlhaus_link]
  $into.osint.src_url = move $into.urlhaus.urlhaus_link
} else {
  $into.osint.src_url = "https://urlhaus.abuse.ch/"
}
$into.osint.severity_id = 4
$into.osint.type_id = 5
$into.osint.value = move $into.urlhaus.url
$into.osint.vendor_name = "abuse.ch"

$into.ocsf = {}
$into.ocsf.activity_id = 2
$into.ocsf.actor = {
  app_name: "Tenzir",
}
$into.ocsf.category_uid = 5
$into.ocsf.class_uid = 5021
$into.ocsf.metadata = {
  product: {
    name: "URLhaus",
    vendor_name: "abuse.ch",
  },
  version: "1.9.0",
}
$into.ocsf.osint = [move $into.osint]
$into.ocsf.severity_id = 1
$into.ocsf.time = $into.ocsf.osint[0].created_time
$into.ocsf.type_uid = $into.ocsf.class_uid * 100 + $into.ocsf.activity_id


@name = "ocsf.osint_inventory_info"

$into = {...$into.ocsf, unmapped: $into.urlhaus}
