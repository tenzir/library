---
description: Maps urlhaus rows to OCSF 1.9 OSINT Inventory Info.
args:
  positional:
    - name: event
      type: field
      description: The structured source row to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

$ocsf = {
  activity_id: 2,
  actor: {app_name: "Tenzir"},
  category_uid: 5,
  class_uid: 5021,
  metadata: {
    product: {
      name: "URLhaus",
      vendor_name: "abuse.ch",
    },
    version: "1.9.0",
  },
  osint: [{
    category: move $event.threat?,
    confidence_id: 3,
    created_time: time($event.dateadded),
    creator: {name: move $event.reporter},
    external_uid: string(move $event.id),
    labels: (move $event.tags).split(","),
    modified_time: time($event.last_online),
    references: [$event.urlhaus_link] if $event.urlhaus_link? != null,
    severity_id: 4,
    src_url: move $event.urlhaus_link if $event.urlhaus_link? != null else "https://urlhaus.abuse.ch/",
    type_id: 5,
    value: move $event.url,
    vendor_name: "abuse.ch",
  }],
  severity_id: 1,
  time: time(move $event.dateadded),
  type_uid: 502102,
}
drop $event.last_online?

@name = "ocsf.osint_inventory_info"

$ocsf.unmapped = move $event
