---
description: Maps threatfox rows to OCSF 1.9 OSINT Inventory Info.
args:
  positional:
    - name: event
      type: field
      description: The structured source row to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

let $type_ids = {
  domain: 2,
  hostname: 3,
  ip: 1,
  "ip:port": 99,
  md5_hash: 4,
  sha1_hash: 4,
  sha256_hash: 4,
  url: 5,
}

$ocsf = {
  activity_id: 2,
  actor: {app_name: "Tenzir"},
  category_uid: 5,
  class_uid: 5021,
  metadata: {
    product: {
      name: "ThreatFox",
      vendor_name: "abuse.ch",
    },
    version: "1.9.0",
  },
  osint: {
    category: move $event.threat_type?,
    created_time: $event.first_seen?,
    desc: move $event.threat_type_desc?,
    labels: move $event.tags?,
    modified_time: time(move $event.last_seen),
    risk_score: $event.confidence_level?,
    src_url: "https://threatfox.abuse.ch/ioc/" + encode_url($event.ioc),
    type_id: $type_ids[$event.ioc_type]? else 99,
    value: move $event.ioc,
    vendor_name: "abuse.ch",
  },
  severity_id: 1,
  time: $event.first_seen? else now(),
  type_uid: 502102,
}

match $event.confidence_level? {
  null => {}
  -1..30 => {
    $ocsf.osint.confidence_id = 1
  }
  29..70 => {
    $ocsf.osint.confidence_id = 2
  }
  _ => {
    $ocsf.osint.confidence_id = 3
  }
}
drop $event.confidence_level?

if $event.malware_printable? != null or $event.malware? != null {
  $ocsf.osint.malware = [{
    classification_ids: [0],
    name: move $event.malware_printable? else move $event.malware?,
    provider: "ThreatFox",
  }]
}

if $event.reference? != null {
  $ocsf.osint.references = [move $event.reference]
}

if $ocsf.osint.type_id == 99 {
  $ocsf.osint.type = move $event.ioc_type
} else {
  drop $event.ioc_type
}

$ocsf.osint = [$ocsf.osint]
drop $event.first_seen?

@name = "ocsf.osint_inventory_info"

$ocsf.unmapped = move $event
