---
description: Maps threatfox rows to OCSF 1.9 OSINT Inventory Info.
args:
  positional:
    - name: event
      type: field
      description: The structured source row to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

let $type_ids = {
  domain: 2,
  hostname: 3,
  ip: 1,
  "ip:port": 99,
  md5_hash: 4,
  sha1_hash: 4,
  sha256_hash: 4,
  url: 5,
}

$ocsf = {
  activity_id: 2,
  actor: {app_name: "Tenzir"},
  category_uid: 5,
  class_uid: 5021,
  metadata: {
    product: {
      name: "ThreatFox",
      vendor_name: "abuse.ch",
    },
    version: "1.9.0",
  },
  osint: [{
    category: move $event.threat_type?,
    confidence_id: 1 if $event.confidence_level? <= 30 else 2 if $event.confidence_level? <= 70 else 3 if $event.confidence_level? != null,
    created_time: $event.first_seen?,
    desc: move $event.threat_type_desc?,
    labels: move $event.tags?,
    malware: [{
      classification_ids: [0],
      name: move $event.malware_printable? else move $event.malware?,
      provider: "ThreatFox",
    }] if $event.malware_printable? != null or $event.malware? != null,
    ...({modified_time: time(move $event.last_seen)} if $event.last_seen? != null else {}),
    ...({references: [move $event.reference]} if $event.reference? != null else {}),
    risk_score: move $event.confidence_level?,
    src_url: "https://threatfox.abuse.ch/ioc/" + encode_url($event.ioc),
    type_id: $type_ids[$event.ioc_type]? else 99,
    ...({type: move $event.ioc_type} if $type_ids[$event.ioc_type]? == null or $type_ids[$event.ioc_type] == 99 else {}),
    value: move $event.ioc,
    vendor_name: "abuse.ch",
  }],
  severity_id: 1,
  time: $event.first_seen? else now(),
  type_uid: 502102,
}
drop $event.first_seen?, $event.ioc_type?

@name = "ocsf.osint_inventory_info"

$ocsf.unmapped = move $event
