---
description: Maps sslbl rows to OCSF 1.9 OSINT Inventory Info.
args:
  positional:
    - name: event
      type: field
      description: The structured source row to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

$ocsf = {
  activity_id: 2,
  actor: {app_name: "Tenzir"},
  category_uid: 5,
  class_uid: 5021,
  metadata: {
    product: {
      name: "SSLBL",
      vendor_name: "abuse.ch",
    },
    version: "1.9.0",
  },
  osint: [{
    category: move $event.reason,
    confidence_id: 3,
    created_time: time($event.timestamp),
    severity_id: 4,
    src_url: "https://sslbl.abuse.ch/blacklist/sslblacklist.csv",
    type_id: 7,
    value: move $event.SHA1,
    vendor_name: "abuse.ch",
  }],
  severity_id: 1,
  time: time(move $event.timestamp),
  type_uid: 502102,
}

@name = "ocsf.osint_inventory_info"

$ocsf.unmapped = move $event
