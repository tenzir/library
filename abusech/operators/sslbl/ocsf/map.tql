---
description: Maps sslbl rows to OCSF 1.9 OSINT Inventory Info.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The structured source row to map.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the OCSF event.
---


$into = {sslbl: $event, ocsf: {}}

$into.osint = {}
$into.osint.category = move $into.sslbl.reason
$into.osint.confidence_id = 3
$into.osint.created_time = time($into.sslbl.timestamp)
drop $into.sslbl.timestamp
$into.osint.severity_id = 4
$into.osint.src_url = "https://sslbl.abuse.ch/blacklist/sslblacklist.csv"
$into.osint.type_id = 7
$into.osint.value = move $into.sslbl.SHA1
$into.osint.vendor_name = "abuse.ch"

$into.ocsf = {}
$into.ocsf.activity_id = 2
$into.ocsf.actor = {
  app_name: "Tenzir",
}
$into.ocsf.category_uid = 5
$into.ocsf.class_uid = 5021
$into.ocsf.metadata = {
  product: {
    name: "SSLBL",
    vendor_name: "abuse.ch",
  },
  version: "1.9.0",
}
$into.ocsf.osint = [move $into.osint]
$into.ocsf.severity_id = 1
$into.ocsf.time = $into.ocsf.osint[0].created_time
$into.ocsf.type_uid = $into.ocsf.class_uid * 100 + $into.ocsf.activity_id


@name = "ocsf.osint_inventory_info"

$into = {...$into.ocsf, unmapped: $into.sslbl}
