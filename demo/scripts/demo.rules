# Suricata rules for the traffic from make_traffic.py.
alert http any any -> any any (msg:"DEMO Beacon user agent"; flow:established,to_server; http.user_agent; content:"demo-beacon"; startswith; classtype:trojan-activity; sid:9000001; rev:1;)
alert http any any -> any any (msg:"DEMO Path traversal in HTTP request"; flow:established,to_server; http.uri.raw; content:"../.."; classtype:web-application-attack; sid:9000002; rev:1;)
alert http any any -> any any (msg:"DEMO Windows executable download"; flow:established,to_client; file.data; content:"MZ"; startswith; classtype:policy-violation; sid:9000003; rev:1;)
alert dns any any -> any any (msg:"DEMO Lookup of a suspicious domain"; dns.query; content:"badsite.example"; endswith; classtype:bad-unknown; sid:9000004; rev:1;)
