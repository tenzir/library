// The organization has 100 divisions with 20 users each. Every user owns one
// workstation, and every division runs its own copy of the eight services.
let $ocsf_division_count = 100
let $ocsf_division_size = 20
// Every 20 divisions share a block of 20 first names and rotate through the
// last names, so all 2,000 names are unique.
