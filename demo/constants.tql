// Constants for the OCSF workload generator in demo::ocsf; the prefix keeps
// them apart from other constants of the package. All identities are invented:
// names and hosts live under acme.example, and addresses are private or
// reserved for documentation.

// The share of mapped events that carry the optional nested objects.
let $ocsf_object_probability = 0.05

// Unique artifacts: the share of URLs and file names that contain a fresh UUID.
let $ocsf_uri_probability = 0.3
let $ocsf_file_probability = 0.25

// The supported classes: Base Event and 45 OCSF 1.9 classes.
let $ocsf_class_uids = [
  0, 1001, 1005, 1006, 1007, 1008, 1009, 2002, 2003, 2004,
  2005, 2006, 3002, 3003, 3004, 3006, 3007, 3008, 4001, 4002,
  4003, 4004, 4005, 4006, 4007, 4008, 4009, 4013, 4014, 5001,
  5003, 5004, 5019, 5020, 5023, 6001, 6002, 6003, 6005, 6006,
  6007, 6008, 7001, 7002, 7003, 7004,
]

// The default class mix. A class appears once per unit of weight, so network,
// DNS, and HTTP traffic dominate, and the long tail stays rare.
