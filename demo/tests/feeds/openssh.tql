from {raw: "<38>1 2026-08-23T09:35:46.100000+00:00 web-01 sshd 33 - - Connection from 192.0.2.10 port 40000 on 192.0.2.1 port 22 rdomain \"\""},
     {raw: "<38>1 2026-08-23T09:35:46.500000+00:00 web-01 sshd-session 33 - - Accepted password for alice from 192.0.2.10 port 40000 ssh2"},
     {raw: "<86>1 2026-08-23T09:35:46.600000+00:00 web-01 sshd-session 33 - - User child is on pid 34"},
     {raw: "<86>1 2026-08-23T11:35:48+00:00 web-01 sshd-session 33 - - pam_unix(sshd:session): session closed for user alice"}
demo::openssh::replay start=2026-11-25T12:00:00Z, cycles=2, pace=false
child = int(message.replace_regex("^User child is on pid (\\d+)$", "\\1")) if message.starts_with("User child") else null
select timestamp, header=raw.split(" ")[1].time() == timestamp, hostname, child_follows=child - process_id.int() if child != null else null, renewed=process_id != "33"
