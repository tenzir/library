// Alerts and flows share the renewed flow ID and the Zeek community ID.
demo::suricata start=2026-11-25T12:00:00Z, cycles=2, pace=false
summarize flow_id, types=distinct(event_type), stamps=count_distinct(timestamp)
summarize flows=count(), alerts_with_flow=sum(1 if "alert" in types and "flow" in types else 0)
