// The records of a flow carry the same renewed flow ID, in every cycle another.
from_file f"{env("TENZIR_INPUTS")}/suricata.json" {
  read_suricata
}
demo::suricata::replay start=2026-06-01T12:00:00Z, cycles=2
summarize flow_id, types=distinct(event_type)
summarize flows=count(), alerts_with_flow=sum(1 if "alert" in types and "flow" in types else 0)
