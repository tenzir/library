from {
  time: 2026-09-01T00:00:00Z,
  observed_time: 2026-09-01T00:00:00.1Z,
  resource: {attributes: {"service.name": "claude-code", "service.version": "2.1.260"}},
  receiver: {transport: "http", peer_ip: 192.0.2.10},
  body: {kind: "string", string_value: "claude_code.api_request"},
  scope: {name: "com.anthropic.claude_code.events"},
  attributes: {
    "event.name": "api_request",
    "event.timestamp": "2026-09-01T00:00:00Z",
    "session.id": "12345678-1234-4234-8234-123456789abc",
    "user.id": "demo-user",
    "user.email": "user@example.invalid",
    model: "demo-model",
    request_id: "req_0123456789abcdef01234567",
    duration_ms: "1200",
    input_tokens: "10",
    output_tokens: "20",
  },
}
@name = "otel.log"
demo::agents::replay start=2026-11-25T12:00:00Z, cycles=1, pace=false
anthropic::claude_code::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
select class_name, time
