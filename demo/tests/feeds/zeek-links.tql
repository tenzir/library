// Every log record of a connection carries the same renewed UID.
demo::zeek start=2026-11-25T12:00:00Z, cycles=2, pace=false
uid = uid?
where uid != null
summarize uid, logs=distinct(@name), minute=min(ts)
summarize connections=count(), with_protocol_log=sum(1 if logs.length() > 1 else 0), distinct=count_distinct(uid)
