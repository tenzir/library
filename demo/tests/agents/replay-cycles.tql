from {time: 2026-09-01T00:00:00Z, attributes: {call_id: "call_0123456789abcdef"}},
     {time: 2026-09-01T00:00:01Z, attributes: {call_id: "call_0123456789abcdef"}}
@name = "otel.log"
demo::agents::replay start=2026-09-02T00:00:00Z, cycles=3, pace=false
summarize id=attributes.call_id, records=count()
summarize cycles=count(), records=collect(records)
