from_file f"{env("TENZIR_INPUTS")}/otel.ndjson" {
  read_lines
}
demo::agents::parse line
schema = @name
this = {schema: schema, kinds: entries(this).map(e => f"{e.key}: {type_kind(e.value)}"), receiver: type_kind(receiver.peer_ip), resource: type_kind(resource.dropped_attributes_count), event: type_kind(attributes["event.timestamp"]?)}
sort schema
