// Records keep their order and distances; `event.timestamp` stays a string.
from_file f"{env("TENZIR_INPUTS")}/otel.ndjson" {
  read_lines
}
raw = move line
demo::agents::replay start=2026-06-01T12:00:00Z, cycles=2
select schema=@name, time=time?, observed_time=observed_time?, start_time=start_time?, end_time=end_time?, event=events?[0]?.time?, stamp=attributes["event.timestamp"]?
