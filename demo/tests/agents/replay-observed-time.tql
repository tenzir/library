// Codex log records can omit producer time and carry only observed_time.
from {
  observed_time: "2026-09-01T12:00:00.125Z",
  attributes: {"event.name": "codex.tool_result", duration_ms: 500},
}
@name = "otel.log"
demo::agents::replay start=2026-09-02T00:00:00Z
select time?, observed_time, attributes.duration_ms
