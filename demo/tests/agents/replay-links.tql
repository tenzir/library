// Spans and logs of a trace stay linked within a cycle; all-zero IDs stay.
from_file f"{env("TENZIR_INPUTS")}/otel.ndjson" {
  read_lines
}
raw = move line
demo::agents::replay start=2026-06-01T12:00:00Z, cycles=2
parent = parent_span_id? else span_id
where trace_id != "00000000000000000000000000000000"
summarize trace_id, records=count(), parents=count_distinct(parent)
summarize traces=count(), records=collect(records), parents=collect(parents)
