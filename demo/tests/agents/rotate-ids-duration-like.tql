from {
  time: 2026-01-01T00:00:00Z,
  span_id: "00000000000080ce",
  parent_span_id: "00000000000080ce",
  attributes: {"event.timestamp": "2026-01-01T00:00:00Z"},
}
@name = "otel.log"
demo::agents::rotate_ids seed="fixed"
// This hash resembles a compound duration and must remain a string.
assert span_id == "0e33d025d3d6870d"
assert parent_span_id == span_id
assert type_kind(span_id) == "string"
demo::agents::replay start=2026-01-02T00:00:00Z
assert type_kind(time) == "time"
assert attributes["event.timestamp"] == time
select span_id, parent_span_id, time
