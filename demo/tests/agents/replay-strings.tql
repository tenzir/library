// Renewed identifiers stay strings, also when they look like a number or duration.
from_file f"{env("TENZIR_INPUTS")}/otel.ndjson" {
  read_lines
}
head 1
raw = move line
demo::agents::replay start=2026-06-01T12:00:00Z, cycles=200
summarize kinds=value_counts(type_kind(span_id)), ids=count_distinct(span_id)
