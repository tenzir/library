// A renewed identifier that looks like a duration must remain a string.
strict {
  from {time: 2026-01-01T00:00:00Z, span_id: "00000000000080ce", attributes: {}}
  @name = "otel.log"
  demo::agents::replay start=2026-01-02T00:00:00Z, cycles=50, pace=false
}
summarize kinds=value_counts(type_kind(span_id)), times=value_counts(type_kind(time))
