from {
  attributes: {
    output: "{\"agent_id\":\"12345678-1234-4234-8234-123456789abc\"}",
    arguments: "{\"target\":\"12345678-1234-4234-8234-123456789abc\"}",
  },
  trace_id: "00000000000000000000000000000000",
  parent_span_id: "0000000000000000",
  resource: {attributes: {"host.id": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"}},
}
@name = "otel.span"
demo::agents::rotate_ids seed="cycle-one"
select schema=@name, changed=attributes.output.parse_json().agent_id != "12345678-1234-4234-8234-123456789abc", references_match=attributes.output.parse_json().agent_id == attributes.arguments.parse_json().target, trace_id, parent_span_id, host_unchanged=resource.attributes["host.id"] == "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
