// The timestamps cover the given time, up to 10 seconds before now.
demo::ocsf::generate count=2000, class_uid=3002, raw="none", time_span=1d
summarize first=min(time), last=max(time), events=count()
_span = last - first
this = {events: events, span: _span > 23h and _span < 25h, recent: now() - last < 5min}
