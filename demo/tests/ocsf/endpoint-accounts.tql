// Windows, Sysmon, and endpoint agents log account names without mail
// addresses, so their events carry none.
demo::ocsf::generate count=1024, class_uid=1007, raw="none"
assert metadata.product.name in ["Endpoint agent", "Sysmon", "Windows Security"]
assert actor.user.email_addr? == null and process.user.email_addr? == null
assert actor.process?.user?.email_addr? == null
assert process.user.name == actor.user.name
summarize events=count()
