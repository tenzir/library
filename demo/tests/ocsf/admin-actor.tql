// An administrator manages other people's accounts: the actor differs from the
// affected user and works from the admin host, not the user's workstation.
demo::ocsf::generate count=256, class_uid=3007, raw="none"
assert actor.user.uid == "user-idm-admin" and actor.user.type_id == 2
assert user.uid != actor.user.uid
assert src_endpoint.hostname? == null or src_endpoint.hostname == "admin-01.acme.example"
assert src_endpoint.ip == 10.20.0.30
summarize events=count()
