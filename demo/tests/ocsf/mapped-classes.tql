// A zero share excludes base events while keeping every mapped class. Their
// messages describe the activity in words and never quote an OCSF enum ID.
demo::ocsf::generate count=2048, base_event_share=0.0, raw="none"
assert class_uid != 0
assert not message.match_regex("(activity|result|state|access) [0-9]+( |$)")
summarize events=count(), classes=count_distinct(class_uid)
