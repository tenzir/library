// A source without a native renderer gets no raw record by default, and then
// no log format either. An explicit generic format still renders one.
demo::ocsf::generate count=256, class_uid=3007
merge { demo::ocsf::generate count=256, class_uid=3007, raw="json" }
_raw = this.has("raw_data")
assert _raw == metadata.has("log_format")
assert not this.has("raw_data_size") and not this.has("raw_data_hash")
if _raw {
  _source = raw_data.parse_json(raw=true)
  assert metadata.log_format == "json" and _source.event_id == metadata.uid
  // The generic record carries no OCSF IDs.
  assert not _source.has("activity") and not _source.has("status") and not _source.has("profiles")
}
summarize raw_record=_raw, events=count()
sort raw_record
