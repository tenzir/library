// Module events name Linux libraries and processes, so they come from the
// Linux workstations: every fifth seat, except the macOS one in each division.
demo::ocsf::generate count=256, class_uid=1005, raw="none"
_index = int(device.uid.replace("workstation-", "")) - 1
_seat = _index - int(_index / 20) * 20
assert _seat in [4, 9, 14]
assert module.file.path.starts_with("/usr/lib/") and actor.process.file.path.starts_with("/usr/bin/")
summarize events=count()
