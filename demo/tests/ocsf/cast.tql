// Every event of the default workload casts to its class without a warning,
// with and without a raw record. The rarest classes have a share of 0.63%, so
// 4,096 events miss one of them about once in ten billion runs.
demo::ocsf::generate count=4096
this = ocsf_derive(ocsf_cast(this))
assert this != null
summarize events=count(), classes=count_distinct(class_uid)
