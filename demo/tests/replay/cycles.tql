// Cycles follow each other without overlap, renew identifiers, and keep links.
from {time: 2026-01-01T10:00:00Z, raw: "id=1234567890abcdef"},
     {time: 2026-01-01T10:00:02Z, raw: "id=1234567890abcdef"},
     {time: 2026-01-01T10:00:04Z, raw: "id=fedcba0987654321"}
demo::replay::renew_ids raw, "(id=)([0-9a-f]+)", kind="hex"
demo::replay::run start=2026-11-25T00:00:00Z, cycles=3, pace=false
enumerate n
summarize cycle, times=collect(time), ids=collect(raw)
sort cycle
select cycle, times, linked=ids[0] == ids[1] and ids[1] != ids[2], ids
