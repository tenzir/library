// Pipelines on the shared clock start in the middle of a cycle and emit equal
// records, also after a restart. Another seed renews all identifiers.
from {pipeline: "first", seed: ""}, {pipeline: "second", seed: ""}, {pipeline: "other", seed: "other"}
each {
  let $pipeline = $this.pipeline
  let $seed = $this.seed
  from {i: 0}, {i: 1}, {i: 2}, {i: 3}
  time = 2026-01-01T10:00:00Z + i * 1h
  raw = f"id=1234567890abcde{i}"
  demo::replay::renew_ids raw, "(id=)([0-9a-f]+)", kind="hex"
  demo::replay::run seed=$seed, cycles=100, pace=false, max_gap=1d
  pipeline = $pipeline
  future = time >= now() - 5min
}
seeded = pipeline == "other"
summarize cycle, i, seeded, raws=distinct(raw), future=all(future)
summarize seeded, equal=all(raws.length() == 1), future=all(future), records=count(), ids=collect(raws[0])
summarize seeded=collect(seeded), equal=all(equal), future=all(future), middle=all(records > 390), ids=collect(ids)
select equal, future, middle, renewed=ids.map(x => x.distinct().length() == x.length()).all(), disjoint=ids[0].where(x => x in ids[1]).length() == 0
