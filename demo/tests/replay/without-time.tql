// A record without a time has no place on the timeline and must not affect the
// length of a cycle.
from {time: null, raw: "a"},
     {time: 2026-01-01T00:00:01Z, raw: "b 2026-01-01T00:00:01Z"},
     {time: 2026-01-01T00:00:04Z, raw: "c 2026-01-01T00:00:04Z"}
demo::replay::run cycles=2, start=2026-06-01T10:00:00Z
select time, raw, cycle=replay.cycle
