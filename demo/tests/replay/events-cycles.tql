// Schemas survive, references stay within a cycle, and cycles differ.
from {i: 0}, {i: 1}, {i: 2}, {i: 3}
time = 2026-01-01T10:00:00Z + i * 1s
uid = "CHhAvVGS1DHFjwGM9" if i < 2 else "C4J4Th3PJpwUYZZ6gc"
@name = "zeek.conn" if i < 3 else "zeek.dns"
demo::replay::events ids=["uid"], start=2026-06-01T12:00:00Z, cycles=2
name = @name
summarize uid, records=count(), names=distinct(name)
summarize ids=count(), records=collect(records), shape=all(uid.match_regex("^C[0-9A-Za-z]{17}$"))
