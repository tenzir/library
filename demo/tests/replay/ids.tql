// Every identifier kind keeps its layout; equal values stay equal.
from {
  time: 2026-01-01T10:00:00Z,
  raw: "a=12345678-1234-4234-8234-123456789abc b=12345678-1234-4234-8234-123456789ABC z=00000000-0000-0000-0000-000000000000 h=1234567890abcdef s=1f3a9c20 n=42 p=77 q=78",
}
demo::replay::renew_ids raw, "([abz]=)([0-9A-Fa-f-]{36})", kind="uuid"
demo::replay::renew_ids raw, "([hs]=)([0-9a-f]+)", kind="hex"
demo::replay::renew_ids raw, "(n=)(\\d+)", kind="number"
demo::replay::renew_ids raw, "([pq]=)(\\d+)", kind="pid"
demo::replay::run start=2026-06-01T12:30:00Z, cycles=1
select raw
