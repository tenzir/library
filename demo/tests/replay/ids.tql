// Every identifier kind keeps its layout; equal values stay equal.
from {
  time: 2026-01-01T10:00:00Z,
  raw: "a=12345678-1234-4234-8234-123456789abc b=12345678-1234-4234-8234-123456789ABC z=00000000-0000-0000-0000-000000000000 h=1234567890abcdef n=42 p=77 q=78",
}
demo::replay::mark raw, "([abz]=)([0-9A-Fa-f-]{36})", "uuid"
demo::replay::mark raw, "(h=)([0-9a-f]+)", "hex"
demo::replay::mark raw, "(n=)(\\d+)", "number"
demo::replay::mark raw, "([pq]=)(\\d+)", "pid"
demo::replay::run start=2026-11-25T12:30:00Z, cycles=1, pace=false, seed="test"
select raw
