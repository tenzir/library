// Endless replay runs inside a source subpipeline so the source reports
// replayed events as ingress.
from_file f"{env("TENZIR_INPUTS")}/large.json" {
  read_suricata
  time = timestamp
  demo::replay::events ids=["flow_id"], start=2026-06-01T12:00:00Z, speed=1000.0
}
head 6
select timestamp, event_type, flow_id
