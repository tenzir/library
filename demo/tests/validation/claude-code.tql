from_file f"{env("TENZIR_DEMO_CAPTURE_DIR")}/claude-code.zst" {
  decompress_zstd
  demo::agents::read
}
anthropic::claude_code::ocsf::normalize include_content=true
ocsf = this
ocsf = ocsf_cast(ocsf_derive(ocsf))
assert ocsf != null
summarize class_uid=ocsf.class_uid, events=count()
sort class_uid
