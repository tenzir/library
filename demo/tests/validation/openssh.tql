from_file f"{env("TENZIR_DEMO_CAPTURE_DIR")}/openssh.zst" {
  decompress_zstd
  read_syslog raw_message=raw
}
where 2026-08-23T09:35:45Z <= timestamp and timestamp <= 2026-08-23T14:26:14Z
where app_name in openssh::$app_names
sort timestamp
openssh::ocsf::normalize
ocsf = this
ocsf = ocsf_cast(ocsf_derive(ocsf))
assert ocsf != null
summarize class_uid=ocsf.class_uid, events=count()
sort class_uid
