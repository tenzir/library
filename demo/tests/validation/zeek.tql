from_file f"{env("TENZIR_DEMO_CAPTURE_DIR")}/zeek.zst" {
  decompress_zstd
  read_zeek_tsv
}
where 2021-11-18T10:00:00Z <= ts and ts <= 2021-11-19T01:00:00Z
source = this
zeek::ocsf::map source, ocsf
ocsf = ocsf_cast(ocsf_derive(ocsf))
assert ocsf != null
summarize class_uid=ocsf.class_uid, events=count()
sort class_uid
