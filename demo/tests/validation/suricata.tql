from_file f"{env("TENZIR_DEMO_CAPTURE_DIR")}/suricata.zst" {
  decompress_zstd
  read_suricata
  head 30k
}
where 2021-11-18T08:10:00Z <= timestamp and timestamp <= 2021-11-18T08:38:00Z
source = this
suricata::ocsf::map source, ocsf
ocsf = ocsf_cast(ocsf_derive(ocsf))
assert ocsf != null
summarize class_uid=ocsf.class_uid, events=count()
sort class_uid
