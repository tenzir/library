---
description: >-
  Generates a continuous stream of Zeek events from 20 minutes of
  invented office traffic.
args:
  named:
    - name: speed
      type: float
      default: 1.0
      description: Multiplier on the replay rate.
    - name: cycles
      type: int
      default: null
      description: Number of cycles to replay. Endless by default.
---

from_http "https://datasets.tenzir.tools/demo/v1/zeek/office.log.zst" {
  decompress_zstd
  read_zeek_tsv
  demo::zeek::replay speed=$speed, cycles=$cycles
}
