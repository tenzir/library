---
description: >-
  Generates a continuous stream of Zeek events from a small sample of invented
  office traffic that ships with the package.
args:
  named:
    - name: speed
      type: float
      default: 1.0
      description: Multiplier on the replay rate.
    - name: start
      type: time
      default: null
      description: Start of the first cycle, such as `now()`. By default, all pipelines share one clock.
    - name: seed
      type: string
      default: ""
      description: Changes the renewed identifiers, for example per deployment.
    - name: cycles
      type: int
      default: 1000000000
      description: Number of cycles to replay.
    - name: pace
      type: bool
      default: true
      description: Emit every record at its replayed time instead of immediately.
---

demo::zeek::sample
time = raw.parse_json()._write_ts.time()
demo::replay::renew_ids raw, "(\"[CF])([0-9a-f]{17})\\b", kind="hex"
demo::replay::run speed=$speed, start=$start, seed=$seed, cycles=$cycles, pace=$pace
select raw
write_lines
read_zeek_json
