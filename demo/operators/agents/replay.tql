---
description: Replays native Claude Code or Codex telemetry as a live feed.
args:
  named:
    - name: max_gap
      type: duration
      default: 5s
      description: Longer pauses in the recording are cut to this length.
    - name: speed
      type: float
      default: 1.0
      description: Multiplier on the replay rate.
    - name: start
      type: time
      default: null
      description: Start of the first cycle, such as `now()`. By default, all pipelines share one clock.
    - name: seed
      type: string
      default: ""
      description: Changes the renewed identifiers, for example per deployment.
    - name: cycles
      type: int
      default: 1000000000
      description: Number of cycles to replay.
    - name: pace
      type: bool
      default: true
      description: Emit every record at its replayed time instead of immediately.
---

this = {
  time: time?.time() else attributes?["event.timestamp"]?.time() else observed_time?.time() else start_time?.time(),
  raw: {schema: @name, event: this}.print_json(),
}
// Correlation identifiers also appear inside tool arguments and outputs. User,
// account, organization, and host identifiers stay stable.
demo::replay::mark raw, "(\\b)([0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})", "uuid"
raw = raw.replace_regex("(\"(?:host|user|organization)[.](?:id|account_id|account_uuid)\":\\s*\")\u001f\u001euuid[|]([0-9a-f-]+)\u001f", "\\1\\2")
demo::replay::mark raw, "(\\b(?:toolu|call|req)_)([0-9A-Za-z]{10,})", "hex"
demo::replay::mark raw, "(\"(?:trace_id|span_id|parent_span_id|(?:conversation|session|thread)[._]id|(?:sender|receiver)_thread_id)\":\\s*\")([0-9a-f]{16,})", "hex"
// Dates inside prompts, commands, and outputs stay as they are.
demo::replay::run max_gap=$max_gap, context="\"(?:time|observed_time|event\\.timestamp|start_time|end_time)\":\\s*\"", speed=$speed, start=$start, seed=$seed, cycles=$cycles, pace=$pace
this = raw.parse_json(raw=true)
@name = schema
this = move event
demo::agents::types
