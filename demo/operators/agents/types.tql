---
description: Restores the timestamps of native agent telemetry parsed from JSON.
---

match @name {
  "otel.log" => {
    time = time?.time()
    observed_time = observed_time?.time()
    attributes["event.timestamp"] = attributes["event.timestamp"]?.time()
  }
  "otel.span" => {
    start_time = start_time.time()
    end_time = end_time.time()
    events = events?.map(e => {...e, time: e.time.time()})
  }
  _ => {}
}
