---
description: >-
  Generates a continuous stream of OpenSSH Syslog events captured from six
  Linux distributions.
args:
  named:
    - name: speed
      type: float
      default: 1.0
      description: Multiplier on the replay rate.
    - name: cycles
      type: int
      default: null
      description: Number of cycles to replay. Endless by default.
---

from_http "https://datasets.tenzir.tools/demo/v1/openssh/syslog.log.zst" {
  decompress_zstd
  read_lines skip_empty=true
}
raw = move line
demo::openssh::replay speed=$speed, cycles=$cycles
