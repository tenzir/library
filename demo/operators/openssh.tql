---
description: >-
  Generates a continuous stream of OpenSSH Syslog events captured from six
  Linux distributions.
args:
  named:
    - name: speed
      type: float
      default: 1.0
      description: Multiplier on the replay rate.
    - name: start
      type: time
      default: null
      description: Start of the first cycle, such as `now()`. By default, all pipelines share one clock.
    - name: seed
      type: string
      default: ""
      description: Changes the renewed identifiers, for example per deployment.
    - name: cycles
      type: int
      default: 1000000000
      description: Number of cycles to replay.
    - name: pace
      type: bool
      default: true
      description: Emit every record at its replayed time instead of immediately.
---

from_http "https://datasets.tenzir.tools/openssh/syslog.log.zst" {
  decompress_zstd
  read_lines skip_empty=true
}
raw = move line
demo::openssh::replay speed=$speed, start=$start, seed=$seed, cycles=$cycles, pace=$pace
