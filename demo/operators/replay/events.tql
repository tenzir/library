---
description: >-
  Replays a short recording of parsed events as an endless live feed. Every cycle
  moves all time fields to the current timeline and renews identifiers. Expects
  the recording time in `time` and removes it.
args:
  named:
    - name: ids
      type: "[string]"
      default: []
      description: >-
        Top-level fields with identifiers: strings, lists of strings, or numbers.
    - name: max_events
      type: int
      default: 20000
      description: Fail for longer recordings, which would take too much memory.
    - name: speed
      type: float
      default: 1.0
      description: Multiplier on the replay rate.
    - name: start
      type: time
      default: null
      description: Start of the first cycle in the past, by default now. Records before now come at once.
    - name: cycles
      type: int
      default: null
      description: Number of cycles to replay. Endless by default.
---

this = {time: time, event: {...this}, name: @name}
drop event.time
demo::replay::internal::timeline max_events=$max_events, speed=$speed, start=$start, cycles=$cycles
demo::replay::internal::render_fields event, shift=replay.shift, salt=replay.salt, ids=$ids
@name = name
this = move event
