---
description: Marks identifiers in a raw record so that every replay cycle renews them.
args:
  positional:
    - name: raw
      type: field
      description: The raw record to mark.
    - name: pattern
      type: string
      description: Regular expression with two groups, the context to keep and the identifier to renew.
    - name: kind
      type: string
      description: Layout of the identifier, one of uuid, hex, alnum, number, or pid.
---

// A marked token is "\u001e<kind>|<value>" between two "\u001f".
$raw = $raw.replace_regex($pattern, "\\1\u001f\u001e" + $kind + "|\\2\u001f")
