---
description: Selects the ISO timestamps that every cycle moves.
args:
  positional:
    - name: raw
      type: field
      description: The raw record.
  named:
    - name: context
      type: string
      default: ""
      description: Regular expression for the text before a timestamp.
---

// Sentinels such as 1601 or 9999 stay as they are.
$raw = $raw.replace_regex("(" + $context + ")\\b((?:199|20[0-8])\\d-[01]\\d-[0-3]\\d[T ])(\\d\\d:\\d\\d:\\d\\d)(\\.\\d+)?( ?[+-]\\d\\d:?\\d\\d|Z)?", "\\1%%REPLAY%%renew:time|\\2|\\3|\\4|\\5%%REPLAY%%")
