---
description: >-
  Generates a continuous stream of Suricata events from 20 minutes of
  invented office traffic.
args:
  named:
    - name: speed
      type: float
      default: 1.0
      description: Multiplier on the replay rate.
    - name: cycles
      type: int
      default: null
      description: Number of cycles to replay. Endless by default.
---

from_http "https://datasets.tenzir.tools/demo/v1/suricata/office.json.zst" {
  decompress_zstd
  read_suricata
}
demo::suricata::replay speed=$speed, cycles=$cycles
