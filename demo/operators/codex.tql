---
description: >-
  Continuously replays a Codex telemetry recording with invented content,
  about one event per second on average.
args:
  named:
    - name: speed
      type: float
      default: 1.0
      description: Multiplier on the replay rate.
    - name: cycles
      type: int
      default: null
      description: Number of cycles to replay. Endless by default.
---

from_http "https://datasets.tenzir.tools/demo/v1/codex/otel.ndjson.zst" {
  decompress_zstd
  read_lines
}
raw = move line
demo::agents::replay speed=$speed, cycles=$cycles
