---
description: >-
  Generates a continuous stream of raw Windows events captured in a Windows
  test lab. Select `winlogbeat`, `fluent-bit`, or `xml` as the collector
  representation. By default, the operator emits about 1.5 events per second.
args:
  positional:
    - name: format
      type: string
      description: Collector representation, one of winlogbeat, fluent-bit, or xml.
  named:
    - name: speed
      type: float
      default: 1.0
      description: Multiplier on the replay rate.
    - name: start
      type: time
      default: null
      description: Start of the first cycle, such as `now()`. By default, all pipelines share one clock.
    - name: seed
      type: string
      default: ""
      description: Changes the renewed identifiers, for example per deployment.
    - name: cycles
      type: int
      default: 1000000000
      description: Number of cycles to replay.
    - name: pace
      type: bool
      default: true
      description: Emit every record at its replayed time instead of immediately.
---

from_http "https://datasets.tenzir.tools/windows/events.ndjson.zst" {
  decompress_zstd
  read_ndjson
}
where format == $format
select time, format, raw
demo::windows::replay speed=$speed, start=$start, seed=$seed, cycles=$cycles, pace=$pace
