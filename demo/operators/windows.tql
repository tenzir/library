---
description: >-
  Generates a continuous stream of Windows events captured in a Windows test lab,
  as `winlogbeat`, `fluent-bit`, or `xml` deliver them. By default, the operator
  emits about 1.5 events per second.
args:
  positional:
    - name: format
      type: string
      description: Collector representation, one of winlogbeat, fluent-bit, or xml.
  named:
    - name: speed
      type: float
      default: 1.0
      description: Multiplier on the replay rate.
    - name: cycles
      type: int
      default: null
      description: Number of cycles to replay. Endless by default.
---

let $file = "events.xml.zst" if $format == "xml" else f"{$format}.ndjson.zst"

from_http f"https://datasets.tenzir.tools/demo/v1/windows/{$file}" {
  decompress_zstd
  read_lines
}
raw = move line
demo::windows::replay $format, speed=$speed, cycles=$cycles
