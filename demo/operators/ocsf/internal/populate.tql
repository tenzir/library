---
description: Select reusable entities, build class-specific events, and attach raw logs.
args:
  named:
    - name: count
      type: int
    - name: time_eps
      type: int
    - name: end_time
      type: time
    - name: historical_start
      type: time
      default: null
    - name: eps_office_hours
      type: int
      default: 1000
    - name: eps_off
      type: int
      default: 100
    - name: class_uid
      type: int
    - name: base_event_share
      type: float
    - name: raw
      type: string
    - name: needle_ip_count
      type: int
      default: 0
    - name: needle_dns_count
      type: int
      default: 0
    - name: needle_command_count
      type: int
      default: 0
    - name: irregular
      type: float
      default: 0.0
---

let $class_mix = demo::$ocsf_class_mix
let $object_probability = demo::$ocsf_object_probability
let $user_count = demo::$ocsf_division_count * demo::$ocsf_division_size
let $service_count = demo::$ocsf_division_count * demo::$ocsf_services.length()
let $needle_total = $needle_ip_count + $needle_dns_count + $needle_command_count
// Gaps have stride or stride+1 slots. This spreads exact counts without large
// index*count products or a seeded random-number generator.
let $needle_stride = int($count / $needle_total) if $needle_total > 0 and $count >= $needle_total else 1
let $needle_wide = $count - $needle_stride * $needle_total if $needle_total > 0 else 0
let $needle_wide_span = $needle_wide * ($needle_stride + 1)

if $historical_start != null {
  demo::ocsf::internal::historical_time start=$historical_start, end=$end_time,
    eps_office_hours=$eps_office_hours, eps_off=$eps_off
} else if $time_eps != null {
  _event_time = ($end_time - ($count - _event_index) * 1s / $time_eps
    + random() * 10ms - 5ms).floor(1ms)
} else {
  _event_time = (now() - 10s - random() * 2min).floor(1ms)
}
_needle_rank = -1
if $needle_total > 0 {
  _needle_rank = (int(_event_index / ($needle_stride + 1)) if _event_index < $needle_wide_span
    else $needle_wide + int((_event_index - $needle_wide_span) / $needle_stride))
  if _event_index != _needle_rank * $needle_stride + (_needle_rank if _needle_rank < $needle_wide else $needle_wide) {
    _needle_rank = -1
  }
}
_ctx = {
  event_index: _event_index,
  needle_rank: _needle_rank,
  user_index: int(random() * $user_count),
  service_index: int(random() * $service_count),
  variant: int(random() * 100),
  detail: random(),
  // Base events (class 0) stand for sources without a specific class mapping.
  class_uid: (4001 if _needle_rank >= 0 and _needle_rank < $needle_ip_count
    else 4003 if _needle_rank >= 0 and _needle_rank < $needle_ip_count + $needle_dns_count
    else 1007 if _needle_rank >= 0 and _needle_rank < $needle_total
    else $class_uid else (0 if random() < $base_event_share
      else $class_mix[int(random() * $class_mix.length())])),
}
// Module, job, journal, file remediation, and inventory events describe Linux
// hosts, so they come from the Linux workstations.
if _ctx.class_uid in [1005, 1006, 1008, 5001, 5004, 5019, 5020, 7002] {
  _ctx.user_index = (int(_ctx.user_index / 20) * 20
    + [4, 9, 14][_ctx.user_index - int(_ctx.user_index / 3) * 3])
}
// Assigned workstations: 80% Windows, 15% Linux, and 5% macOS.
_ctx.windows = _ctx.user_index - int(_ctx.user_index / 5) * 5 < 4
_ctx.macos = _ctx.user_index - int(_ctx.user_index / 20) * 20 == 19
demo::ocsf::internal::identities
this = {
  _ctx: _ctx,
  metadata: {
    version: "1.9.0",
    source: "Synthetic workload",
    loggers: [{
      name: "ocsf-gen",
      product: {name: "OCSF workload generator", vendor_name: "Tenzir"},
    }],
    uid: uuid(),
  },
  time: _event_time,
  severity_id: 1,
  status_id: 1,
  actor: {user: _ctx.user},
  src_endpoint: {
    ip: ip(_ctx.host.ip),
    hostname: _ctx.host.hostname,
    port: 49152 + int(random() * 16384),
  },
  dst_endpoint: {
    ip: ip(_ctx.service.ip),
    hostname: _ctx.service.hostname,
    port: _ctx.service.port,
  },
}

_ctx.scenario = 0 if _ctx.variant < 70 else 1 if _ctx.variant < 80 else 2 if _ctx.variant < 95 else 3
match _ctx.class_uid {
  0 => { demo::ocsf::internal::classes::base_event }
  1001 => { demo::ocsf::internal::classes::file_activity }
  1007 => { demo::ocsf::internal::classes::process_activity }
  2004 => { demo::ocsf::internal::classes::detection_finding }
  3002 => { demo::ocsf::internal::classes::authentication }
  4001 => { demo::ocsf::internal::classes::network_activity }
  4002 => { demo::ocsf::internal::classes::http_activity }
  4003 => { demo::ocsf::internal::classes::dns_activity }
  4009 => { demo::ocsf::internal::classes::email_activity }
  6003 => { demo::ocsf::internal::classes::api_activity }
  1005 => { demo::ocsf::internal::classes::module_activity }
  1006 => { demo::ocsf::internal::classes::scheduled_job_activity }
  1008 => { demo::ocsf::internal::classes::event_log_activity }
  1009 => { demo::ocsf::internal::classes::script_activity }
  2002 => { demo::ocsf::internal::classes::vulnerability_finding }
  2003 => { demo::ocsf::internal::classes::compliance_finding }
  2005 => { demo::ocsf::internal::classes::incident_finding }
  2006 => { demo::ocsf::internal::classes::data_security_finding }
  3003 => { demo::ocsf::internal::classes::authorize_session }
  3004 => { demo::ocsf::internal::classes::entity_management }
  3006 => { demo::ocsf::internal::classes::group_management }
  3007 => { demo::ocsf::internal::classes::user_management }
  3008 => { demo::ocsf::internal::classes::role_management }
  4004 => { demo::ocsf::internal::classes::dhcp_activity }
  4005 => { demo::ocsf::internal::classes::rdp_activity }
  4006 => { demo::ocsf::internal::classes::smb_activity }
  4007 => { demo::ocsf::internal::classes::ssh_activity }
  4008 => { demo::ocsf::internal::classes::ftp_activity }
  4013 => { demo::ocsf::internal::classes::ntp_activity }
  4014 => { demo::ocsf::internal::classes::tunnel_activity }
  5001 => { demo::ocsf::internal::classes::device_inventory_info }
  5003 => { demo::ocsf::internal::classes::user_inventory_info }
  5004 => { demo::ocsf::internal::classes::os_patch_state }
  5019 => { demo::ocsf::internal::classes::device_config_state_change }
  5020 => { demo::ocsf::internal::classes::software_inventory_info }
  5023 => { demo::ocsf::internal::classes::cloud_resources_inventory_info }
  6001 => { demo::ocsf::internal::classes::web_resources_activity }
  6002 => { demo::ocsf::internal::classes::application_lifecycle }
  6005 => { demo::ocsf::internal::classes::datastore_activity }
  6006 => { demo::ocsf::internal::classes::file_hosting_activity }
  6007 => { demo::ocsf::internal::classes::scan_activity }
  6008 => { demo::ocsf::internal::classes::application_error }
  7001 => { demo::ocsf::internal::classes::remediation_activity }
  7002 => { demo::ocsf::internal::classes::file_remediation_activity }
  7003 => { demo::ocsf::internal::classes::process_remediation_activity }
  7004 => { demo::ocsf::internal::classes::network_remediation_activity }
  _ => { discard }
}
if $needle_ip_count + $needle_dns_count + $needle_command_count > 0 {
  demo::ocsf::internal::needles ip_count=$needle_ip_count, dns_count=$needle_dns_count,
    command_count=$needle_command_count
}
type_uid = class_uid * 100 + activity_id
batch 8192, timeout=100ms
demo::ocsf::internal::profiles
batch 8192, timeout=100ms
// Unmapped sources have no related objects to populate.
_ctx.rich = _ctx.class_uid != 0 and random() < $object_probability
if _ctx.rich {
  demo::ocsf::internal::objects
}
batch 8192, timeout=100ms

// Vary field presence, while keeping the required identity and class fields.
if _ctx.detail < 0.30 {
  drop actor.user.email_addr?
}
// Operating systems, endpoint sensors, and SSH daemons log account names, not
// mail addresses; identity providers and applications know both.
if _ctx.native? in ["winsec", "sysmon", "powershell", "endpoint", "sshd"] {
  drop actor.user.email_addr?, actor.process.user.email_addr?, user.email_addr?,
    process.user.email_addr?
}
if _ctx.detail < 0.20 {
  drop src_endpoint.hostname?, dst_endpoint.hostname?
}
if _ctx.detail > 0.80 {
  metadata.labels = ["synthetic", "branch-zurich"]
}

// Source-specific fields deliberately vary in presence and native type. Base
// events add their source profiles last, so the shared steps above see few schemas.
if _ctx.class_uid == 0 {
  demo::ocsf::internal::base_sources
} else {
  unmapped.observed_host = ip(_ctx.host.ip) if random() < 0.5 else _ctx.host.hostname
  if _ctx.detail > 0.20 {
    unmapped.collector_zone = ["zurich", "frankfurt", "london"][int(random() * 3)]
    unmapped.retry_count = int(random() * 4)
    if random() < 0.5 {
      unmapped.retry_count = string(unmapped.retry_count)
    }
  }
  if _ctx.detail > 0.50 {
    unmapped.cache_hit = random() < 0.8
    unmapped.source_tags = ["production", "branch-office"]
  }
  if _ctx.detail > 0.80 {
    unmapped.policy = {name: "workstation-default", revision: 3, enabled: true}
  }
}

demo::ocsf::internal::coverage_profiles

// Optional source details preserve compact events for half the observations.
if _ctx.detail > 0.50 {
  if category_uid in [1, 5] {
    demo::ocsf::internal::fields_endpoint
  } else if category_uid == 2 {
    demo::ocsf::internal::fields_finding
  } else if category_uid == 4 {
    demo::ocsf::internal::fields_network
  }
}

if _ctx.rich {
  demo::ocsf::internal::objects_nested
}

demo::ocsf::internal::observables

if $raw != "none" {
  _raw = {user: _ctx.user.name, host: _ctx.host.hostname, context: _ctx.source?,
    native: _ctx.native?, user_index: _ctx.user_index, windows: _ctx.windows,
    host_uid: _ctx.host.uid, host_ip: _ctx.host.ip}
  // Unmapped sources name their own reporting device and not always a user.
  if _ctx.class_uid == 0 {
    _raw.host = _ctx.base.host
    _raw.user = _ctx.base.user?
  }
}
drop _ctx
if $raw != "none" {
  demo::ocsf::internal::raw raw=$raw
  drop _raw
}

if "record_integrity" in (metadata.profiles? else []) {
  demo::ocsf::internal::attest
}

// Corrupt normalized fields only after native renderers have read valid values.
if $irregular > 0.0 {
  demo::ocsf::internal::drift irregular=$irregular
}
