drop dst_endpoint
// An identity administrator manages other people's accounts from the admin
// host. Session authorization happens on behalf of the user who logs in.
if class_uid != 3003 {
  actor.user = {uid: "user-idm-admin", name: "idm.admin", email_addr: "idm.admin@acme.example", domain: "acme.example", type_id: 2}
  src_endpoint = {ip: 10.20.0.30, hostname: "admin-01.acme.example", port: src_endpoint.port}
}
metadata.product = {name: "Identity provider"}
metadata.log_name = "identity-admin-audit"
if _ctx.scenario == 3 {
  status_id = 2
  status_detail = "Insufficient administrator privileges"
}
