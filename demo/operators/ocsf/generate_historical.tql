---
description: Generate a finite historical workload with daily office and off-hours rates.
args:
  named:
    - name: eps_office_hours
      description: Events per second from 08:00 to 17:00 UTC.
      type: int
      default: 1000
    - name: eps_off
      description: Events per second outside of office hours.
      type: int
      default: 100
    - name: start
      description: Start of the interval, by default `days` before now.
      type: time
      default: null
    - name: days
      description: Length of the interval in days.
      type: int
      default: 30
    - name: class_uid
      description: Generate only this class, `0` for base events. Mixed classes by default.
      type: int
      default: null
    - name: base_event_share
      description: Fraction of mixed events that are base events, between 0.0 and 1.0.
      type: float
      default: 0.35
    - name: raw
      description: >-
        The source record in raw_data: "native" adds one only for sources with
        a native log format; "json", "kv", "syslog", or "mixed" add a generic
        record to every event; "none" omits it.
      type: string
      default: native
    - name: needle_ip_count
      description: Exact number of Network Activity events to `198.18.0.1`.
      type: int
      default: 0
    - name: needle_dns_count
      description: Exact number of DNS queries for `dns-needle.ocsf-gen.invalid`.
      type: int
      default: 0
    - name: needle_command_count
      description: Exact number of processes with the command `ocsf-gen-needle --ioc`.
      type: int
      default: 0
    - name: irregular
      description: >-
        Fraction of events with one schema irregularity: a severity_id of the
        wrong type, an unknown field, or a vendor field.
      type: float
      default: 0.0
---

// Each UTC day contains nine office hours and fifteen off hours. Whole-day
// intervals have the same count even when start is not midnight.
let $begin = $start else now() - $days * 1d
let $end = $begin + $days * 1d
let $count = $days * (32400 * $eps_office_hours + 54000 * $eps_off)
let $valid = ($days >= 0 and $eps_office_hours >= 0 and $eps_off >= 0
  and ($eps_office_hours > 0 or $eps_off > 0))
// Keep invalid requests nonempty until assert can report the bad arguments.
let $safe_count = $count if $valid else 1
demo::ocsf::internal::seed raw=$raw, class_uid=$class_uid, base_event_share=$base_event_share,
  needle_ip_count=$needle_ip_count,
  needle_dns_count=$needle_dns_count,
  needle_command_count=$needle_command_count,
  irregular=$irregular
assert $days >= 0, message="days must be nonnegative"
assert $eps_office_hours >= 0 and $eps_off >= 0,
  message="historical rates must be nonnegative"
assert $eps_office_hours > 0 or $eps_off > 0,
  message="at least one historical rate must be positive"
assert ($needle_ip_count <= $safe_count and $needle_dns_count <= $safe_count - $needle_ip_count
  and $needle_command_count <= $safe_count - $needle_ip_count - $needle_dns_count),
  message="combined needle counts must not exceed the event count"
repeat int(($safe_count + 32767) / 32768)
head $safe_count
enumerate _event_index
demo::ocsf::internal::populate count=$safe_count, time_eps=null, end_time=$end,
  historical_start=$begin, eps_office_hours=$eps_office_hours, eps_off=$eps_off,
  class_uid=$class_uid, base_event_share=$base_event_share, raw=$raw,
  needle_ip_count=$needle_ip_count,
  needle_dns_count=$needle_dns_count,
  needle_command_count=$needle_command_count,
  irregular=$irregular
