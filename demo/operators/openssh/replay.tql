---
description: Replays raw OpenSSH Syslog records as a live feed.
args:
  named:
    - name: speed
      type: float
      default: 1.0
      description: Multiplier on the replay rate.
    - name: start
      type: time
      default: null
      description: Start of the first cycle, such as `now()`. By default, all pipelines share one clock.
    - name: seed
      type: string
      default: ""
      description: Changes the renewed identifiers, for example per deployment.
    - name: cycles
      type: int
      default: 1000000000
      description: Number of cycles to replay.
    - name: pace
      type: bool
      default: true
      description: Emit every record at its replayed time instead of immediately.
---

time = raw.split(" ")[1].time()
// Renewed process IDs keep sessions of different cycles apart.
demo::replay::renew_ids raw, "((?:^<\\d+>1 \\S+ \\S+ \\S+|\\bon pid|\\bpid =) )(\\d+)", kind="pid"
demo::replay::run max_gap=10s, speed=$speed, start=$start, seed=$seed, cycles=$cycles, pace=$pace
select raw
write_lines
read_syslog raw_message=raw
