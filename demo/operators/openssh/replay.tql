---
description: Replays raw OpenSSH Syslog records as a live feed.
args:
  named:
    - name: speed
      type: float
      default: 1.0
      description: Multiplier on the replay rate.
    - name: start
      type: time
      default: null
      description: Start of the first cycle in the past, by default now. Records before now come at once.
    - name: cycles
      type: int
      default: null
      description: Number of cycles to replay. Endless by default.
---

time = raw.split(" ")[1].time()
// Renewed process IDs keep sessions of different cycles apart.
demo::replay::renew_ids raw, "((?:^<\\d+>1 \\S+ \\S+ \\S+|\\bon pid|\\bpid =) )(\\d+)", kind="pid"
demo::replay::run speed=$speed, start=$start, cycles=$cycles
select raw
write_lines
read_syslog raw_message=raw
