---
description: Replays parsed Zeek events as a live feed.
args:
  named:
    - name: speed
      type: float
      default: 1.0
      description: Multiplier on the replay rate.
    - name: start
      type: time
      default: null
      description: Start of the first cycle in the past, by default now. Records before now come at once.
    - name: cycles
      type: int
      default: null
      description: Number of cycles to replay. Endless by default.
---

// Zeek writes a record when its activity ends.
time = ts + (duration? else 0s)
demo::replay::events ids=["uid", "uids", "conn_uids", "fuid", "fuids", "orig_fuids", "resp_fuids", "parent_fuid", "cert_chain_fuids", "client_cert_chain_fuids", "client_cert_fuid", "server_cert_fuid", "tunnel_parents", "id"], speed=$speed, start=$start, cycles=$cycles
