---
description: Replays parsed Suricata events as a live feed.
args:
  named:
    - name: speed
      type: float
      default: 1.0
      description: Multiplier on the replay rate.
    - name: start
      type: time
      default: null
      description: Start of the first cycle in the past, by default now. Records before now come at once.
    - name: cycles
      type: int
      default: null
      description: Number of cycles to replay. Endless by default.
---

time = timestamp
demo::replay::events ids=["flow_id", "parent_id"], speed=$speed, start=$start, cycles=$cycles
