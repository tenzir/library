---
description: Replays raw Windows collector records as a live feed.
args:
  named:
    - name: speed
      type: float
      default: 1.0
      description: Multiplier on the replay rate.
    - name: start
      type: time
      default: null
      description: Start of the first cycle, such as `now()`. By default, all pipelines share one clock.
    - name: seed
      type: string
      default: ""
      description: Changes the renewed identifiers, for example per deployment.
    - name: cycles
      type: int
      default: 1000000000
      description: Number of cycles to replay.
    - name: pace
      type: bool
      default: true
      description: Emit every record at its replayed time instead of immediately.
---

// Identifiers appear in event data, JSON fields, and rendered messages. Provider
// and object GUIDs and well-known logon sessions, such as 0x3e7, stay as they are.
demo::replay::renew_ids raw, "((?i:process ?guid|logon ?guid|entity_id|activity_?id|instance(?:id)?|started|finished|scriptblock ?id|host ?id|runspace ?id)(?:\\\\[nrt]|&#\\d+;|[\\\\'\">:=\\s{])*)([0-9A-Fa-f]{8}(?:-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12})", kind="uuid"
demo::replay::renew_ids raw, "((?i:logon ?id)(?:\\\\[nrt]|&#\\d+;|[\\\\'\">:=\\s])*0[xX])([0-9A-Fa-f]{5,})", kind="hex"
demo::replay::renew_ids raw, "(<EventRecordID>|\"(?:record_id|EventRecordID|RecordNumber)\":\"?)(\\d+)", kind="number"
demo::replay::run speed=$speed, start=$start, seed=$seed, cycles=$cycles, pace=$pace
// Rotate the host per cycle: records of one cycle belong together.
raw = raw.replace("DEMO-WIN-01", f"DEMO-WIN-0{1 + cycle - 3 * int(floor(cycle / 3))}")
drop cycle
