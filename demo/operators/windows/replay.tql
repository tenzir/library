---
description: Replays the lines of a Windows event collector, one event per `line`, as a live feed.
args:
  positional:
    - name: format
      type: string
      description: Collector representation, one of winlogbeat, fluent-bit, or xml.
  named:
    - name: speed
      type: float
      default: 1.0
      description: Multiplier on the replay rate.
    - name: start
      type: time
      default: null
      description: Start of the first cycle in the past, by default now. Records before now come at once.
    - name: cycles
      type: int
      default: null
      description: Number of cycles to replay. Endless by default.
---

raw = move line
time = raw.parse_winlog().System.TimeCreated.SystemTime.time() if $format == "xml" else (
  raw.parse_json(raw=true)["@timestamp"].time() if $format == "winlogbeat" else
  raw.parse_json(raw=true).TimeCreated.parse_time("%Y-%m-%d %H:%M:%S %z")
)
// Identifiers appear in event data, JSON fields, and rendered messages. Provider
// and object GUIDs and well-known logon sessions, such as 0x3e7, stay as they are.
demo::replay::renew_ids raw, "((?i:process ?guid|logon ?guid|entity_id|activity_?id|instance(?:id)?|started|finished|scriptblock ?id|host ?id|runspace ?id)(?:\\\\[nrt]|&#\\d+;|[\\\\'\">:=\\s{])*)([0-9A-Fa-f]{8}(?:-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12})", kind="uuid"
demo::replay::renew_ids raw, "((?i:logon ?id)(?:\\\\[nrt]|&#\\d+;|[\\\\'\">:=\\s])*0[xX])([0-9A-Fa-f]{5,})", kind="hex"
demo::replay::renew_ids raw, "(<EventRecordID>|\"(?:record_id|EventRecordID|RecordNumber)\":\"?)(\\d+)", kind="number"
demo::replay::run speed=$speed, start=$start, cycles=$cycles
select line=raw
