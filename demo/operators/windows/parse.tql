---
description: Parses a Windows event as the collector delivers it to a pipeline.
args:
  positional:
    - name: format
      type: string
      description: Collector representation, one of winlogbeat, fluent-bit, or xml.
    - name: raw
      type: field
      description: The collected record.
---

if $format == "xml" {
  select raw=$raw
  write_lines
  read_delimited "</Event>\n", include_separator=true
} else {
  this = $raw.parse_json()
}
