---
name: Windows Fluent Bit OCSF Demo Data
description: |
  Publishes a live Fluent Bit demo feed normalized to OCSF.
---

demo::windows "fluent-bit"
event = raw.parse_json()
microsoft::windows::ocsf::normalize event, into=ocsf
ocsf.metadata.log_format = "json"
ocsf.raw_data = move raw
ocsf.raw_data_size = ocsf.raw_data.length_bytes()
this = ocsf_cast(ocsf_derive(ocsf))
publish "ocsf"
