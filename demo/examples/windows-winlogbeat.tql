---
name: Windows Winlogbeat OCSF Demo Data
description: |
  Publishes a live Winlogbeat demo feed normalized to OCSF.
---

demo::windows "winlogbeat"
event = raw.parse_json()
microsoft::windows::ocsf::normalize event, into=ocsf
ocsf.metadata.log_format = "json"
ocsf.raw_data = move raw
ocsf.raw_data_size = ocsf.raw_data.length_bytes()
this = move ocsf
this = ocsf_derive(this)
this = ocsf_cast(this)
publish "ocsf"
