---
name: Mixed OCSF Versions
description: |
  Writes synthetic OCSF 1.9 events with 10% OCSF 1.6 events to an NDJSON file.
---

// Exactly 10% OCSF 1.6.0, alongside the full OCSF 1.9.0 workload.
demo::ocsf::generate count=90000
merge {
  demo::ocsf::generate_legacy count=10000
}
to_file "ocsf-mixed-versions.ndjson" {
  write_ndjson
}
