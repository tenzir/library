---
name: Windows Event Log XML OCSF Demo Data
description: |
  Generates a live Windows Event Log XML demo feed normalized to OCSF.
  Requires the `microsoft` package.
---

demo::windows "xml"
microsoft::windows::ocsf::normalize line, into=ocsf
ocsf.metadata.log_format = "xml"
ocsf.raw_data = move line
ocsf.raw_data_size = ocsf.raw_data.length_bytes()
this = ocsf_cast(ocsf_derive(ocsf))
