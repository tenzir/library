---
name: Windows Event Log XML OCSF Demo Data
description: |
  Publishes a live Windows Event Log XML demo feed normalized to OCSF.
---

demo::windows "xml"
microsoft::windows::ocsf::normalize raw, into=ocsf
ocsf.metadata.log_format = "xml"
ocsf.raw_data = move raw
ocsf.raw_data_size = ocsf.raw_data.length_bytes()
this = move ocsf
this = ocsf_derive(this)
this = ocsf_cast(this)
publish "ocsf"
