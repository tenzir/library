// Verifies that the parser and mapper only write their selected output fields,
// preserve unrelated siblings, and accept nested field paths.
from {
  marker: "parsed",
  dhcpd: {
    time: 2026-01-01T00:00:00Z,
    message: "DHCPACK on 192.0.2.10 to aa:bb:cc:dd:ee:ff (host-1) via eth0",
    keep: "inner-parsed",
  },
}, {
  marker: "parser-error",
  dhcpd: {
    time: 2026-01-01T00:00:00Z,
    keep: "inner-error",
  },
}

dhcpd::parse dhcpd.message?, dhcpd.event
dhcpd.event.time = dhcpd.time
dhcpd::ocsf::map dhcpd.event, dhcpd.ocsf
dhcpd.ocsf.raw_data = dhcpd.message?
dhcpd.ocsf.raw_data_size = dhcpd.message?.length_bytes()
dhcpd.ocsf.unmapped.source_keep = move dhcpd.keep
dhcpd.ocsf.unmapped.has_message = dhcpd.message? != null
dhcpd.ocsf.unmapped.outer_marker = move marker
this = move dhcpd.ocsf
ocsf::cast

drop_null_fields
sort time, unmapped.outer_marker
