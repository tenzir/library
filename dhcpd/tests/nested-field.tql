// Verifies that the normalizer only writes its selected output field, preserves
// unrelated siblings, and accepts nested input and output paths.
from {
  marker: "parsed",
  dhcpd: {
    time: 2026-01-01T00:00:00Z,
    message: "DHCPACK on 192.0.2.10 to aa:bb:cc:dd:ee:ff (host-1) via eth0",
    keep: "inner-parsed",
  },
}, {
  marker: "parser-error",
  dhcpd: {
    time: 2026-01-01T00:00:00Z,
    keep: "inner-error",
  },
}

dhcpd::ocsf::normalize dhcpd, into=normalized
normalized.unmapped.source_keep = move dhcpd.keep
normalized.unmapped.has_message = dhcpd.message? != null
normalized.unmapped.outer_marker = move marker
this = move normalized
ocsf::cast

drop_null_fields
sort time, unmapped.outer_marker
