---
description: Mark an ISC DHCPD parser branch as failed.
args:
  positional:
    - name: scope
      description: The active parsing scope.
      type: field
---

@name = "dhcpd.parser_error"
$scope.event = {
  category: "parser",
  template: "parse_grok_failed",
  parser: {
    warning: "failed to parse DHCPD message",
    reason: "recognized message template did not match detailed grok parser",
  },
}
