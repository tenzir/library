---
description: Parse ISC DHCPD BOOTP message bodies.
args:
  positional:
    - name: scope
      description: The active parsing scope.
      type: field
---

let $bootp_grok_pattern = "^(?:DHCP4o6 )?(?:%{BOOTP_REPLY_ON}|%{BOOTP_REQUEST}|%{BOOTP_REPLY_FOR}|%{GREEDYDATA:other})$"
let $bootp_reply_on_grok = r"%{WORD:message_type} on %{IP:lease_ip} to (?:(?<client_id>%{MAC:client_mac})|%{DATA:client_id})(?: \(%{DATA:client_hostname}\))? via %{DATA:via}"
let $bootp_request_grok = "%{WORD:message_type} from (?:(?<client_hardware>%{MAC:client_mac})|%{DATA:client_hardware}) via %{DATA:via}(?:: %{GREEDYDATA:reason})?"
let $bootp_reply_for_grok = r"%{WORD:message_type} for %{IP:lease_ip} to %{DATA:host_name} \((?:(?<client_hardware>%{MAC:client_mac})|%{DATA:client_hardware})\) via %{DATA:via}"
let $bootp_pattern_definitions = {
  BOOTP_REPLY_ON: $bootp_reply_on_grok,
  BOOTP_REQUEST: $bootp_request_grok,
  BOOTP_REPLY_FOR: $bootp_reply_for_grok,
}

if $scope.source.starts_with("BOOT") or $scope.source.starts_with("DHCP4o6 BOOT") {
  $scope.event = $scope.source.parse_grok(
    $bootp_grok_pattern,
    pattern_definitions=$bootp_pattern_definitions,
  )
  if $scope.event == null or $scope.event.other? != null {
    dhcpd::parsers::parse_error $scope
  } else {
    @name = "dhcpd.transaction"
    $scope.event.family = "bootp"
    $scope.event.category = "transaction"
    $scope.event.template = $scope.event.message_type.to_lower()
    $scope.event.via = $scope.event.via.string()
    $scope.event.via_ip = $scope.event.via.ip()
    $scope.event.via_interface = $scope.event.via if $scope.event.via_ip == null
    $scope.event.dhcp4o6 = $scope.source.starts_with("DHCP4o6 ")
    if $scope.event.lease_ip? != null {
      $scope.event.client_ip = move $scope.event.lease_ip
    }
    if $scope.event.host_name? != null {
      $scope.event.client_hostname = move $scope.event.host_name
    }
    if $scope.event.client_mac? != null {
      $scope.event.client.uid = $scope.event.client_mac
      $scope.event.client.mac = move $scope.event.client_mac
    }
    if $scope.event.client_hostname? != null {
      $scope.event.client.hostname = move $scope.event.client_hostname
    }
    if $scope.event.client_ip? != null {
      $scope.event.client.ip = move $scope.event.client_ip
    }
    if $scope.event.client_id? != null {
      $scope.event.client.uid = move $scope.event.client_id
    }
    if $scope.event.client_hardware? != null {
      $scope.event.client.uid = move $scope.event.client_hardware
    }
  }
}
