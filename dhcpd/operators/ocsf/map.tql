---
description: |
  Maps a structured ISC DHCPD event to OCSF.

  The first field holds the event produced by `dhcpd::parse`, and the second
  receives OCSF DHCP Activity (class 4004) or an OCSF Base Event:

  ```tql
  dhcpd::ocsf::map dhcpd, ocsf
  ```

  The mapper consumes the structured source event. Translated fields become
  OCSF attributes, and the remaining source fields become `unmapped`.
  Provenance remains the caller's decision.
args:
  positional:
    - name: dhcpd
      description: The structured DHCPD event to read.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

match $dhcpd.category? {
  "transaction" => {
    match $dhcpd.family? {
      "dhcpv4" => {
        dhcpd::ocsf::events::dhcpv4 $dhcpd, $ocsf
      }
      "bootp" => {
        dhcpd::ocsf::events::bootp $dhcpd, $ocsf
      }
      "dhcpv6" => {
        dhcpd::ocsf::events::dhcpv6 $dhcpd, $ocsf
      }
      _ => {
        dhcpd::ocsf::base $dhcpd, $ocsf
      }
    }
  }
  _ => {
    dhcpd::ocsf::base $dhcpd, $ocsf
  }
}

// The parser category and family only dispatch the mapper and are not source
// residue.
drop $dhcpd.category?, $dhcpd.family?
$ocsf.unmapped = move $dhcpd
