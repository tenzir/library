---
description: |
  Maps a structured ISC DHCPD event to OCSF.

  The optional positional field holds the event produced by `dhcpd::parse`.
  The named output receives OCSF DHCP Activity (class 4004) or an OCSF Base
  Event. Both default to `this` for in-place mapping:

  ```tql
  dhcpd::ocsf::map event, into=ocsf
  ```

  The mapper consumes the structured source event: translated fields become
  OCSF attributes, and the remaining source fields become `unmapped`.
  Provenance remains the caller's decision.
args:
  positional:
    - name: event
      description: The structured DHCPD event to map.
      type: field
      default: this
  named:
    - name: into
      description: The field that receives the OCSF event.
      type: field
      default: this
---

// Snapshot the source before writing so in-place and separate-field calls use
// the same mapping path.
$into = {
  dhcpd: $event,
  ocsf: {},
}

match $into.dhcpd.category? {
  "transaction" => {
    match $into.dhcpd.family? {
      "dhcpv4" => {
        dhcpd::ocsf::events::dhcpv4 $into
      }
      "bootp" => {
        dhcpd::ocsf::events::bootp $into
      }
      "dhcpv6" => {
        dhcpd::ocsf::events::dhcpv6 $into
      }
      _ => {
        dhcpd::ocsf::base $into
      }
    }
  }
  _ => {
    dhcpd::ocsf::base $into
  }
}

$into = {
  ...$into.ocsf,
  unmapped: $into.dhcpd,
}
