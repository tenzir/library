---
description: |
  Maps a structured ISC DHCPD event to OCSF.

  The first positional field holds the event produced by `dhcpd::parse`.
  The second receives OCSF DHCP Activity (class 4004) or an OCSF Base Event:

  ```tql
  dhcpd::ocsf::map event, ocsf
  ```

  The mapper consumes the structured source event: translated fields become
  OCSF attributes, and the remaining source fields become `unmapped`.
  Provenance remains the caller's decision.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

$ocsf = {}

match $event.category? {
  "transaction" => {
    match $event.family? {
      "dhcpv4" => {
        dhcpd::ocsf::events::dhcpv4 $event, $ocsf
      }
      "bootp" => {
        dhcpd::ocsf::events::bootp $event, $ocsf
      }
      "dhcpv6" => {
        dhcpd::ocsf::events::dhcpv6 $event, $ocsf
      }
      _ => {
        dhcpd::ocsf::base $event, $ocsf
      }
    }
  }
  _ => {
    dhcpd::ocsf::base $event, $ocsf
  }
}

$ocsf.unmapped = move $event
