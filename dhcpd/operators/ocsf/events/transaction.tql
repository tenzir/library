---
description: ISC DHCPD parsed transaction -> OCSF DHCP Activity.
args:
  positional:
    - name: event
      description: The active mapping scope.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

let $activity_ids = {
  dhcpdiscover: 1,
  discover: 1,
  solicit: 1,
  dhcpoffer: 2,
  offer: 2,
  advertise: 2,
  dhcprequest: 3,
  request: 3,
  renew: 3,
  rebind: 3,
  confirm: 3,
  dhcpdecline: 4,
  decline: 4,
  declines: 4,
  dhcpack: 5,
  ack: 5,
  reply: 5,
  dhcpnak: 6,
  nak: 6,
  dhcprelease: 7,
  release: 7,
  releases: 7,
  dhcpinform: 8,
  inform: 8,
  "information-request": 8,
  expire: 9,
  expired: 9,
}

@name = "ocsf.dhcp_activity"

$ocsf = {
  time: move $event.time,
  category_uid: 4,
  class_uid: 4004,
  activity_id: $activity_ids.get($event.message_type.to_lower(), 99),
  severity_id: 1,
  metadata: {
    version: "1.9.0",
    log_name: "dhcpd",
    log_provider: "ISC DHCPD",
    log_source: "dhcpd",
    product: {
      name: "ISC DHCPD",
      vendor_name: "ISC",
    },
  },
  connection_info: {
    direction_id: 0,
    protocol_name: "udp",
    protocol_num: 17,
  },
  src_endpoint: {
    uid: move $event.client?.uid?,
    hostname: move $event.client?.hostname?,
    mac: move $event.client?.mac?,
    ip: move $event.client?.ip?,
  },
  dst_endpoint: {
    ip: move $event.server?.ip?,
    svc_name: "dhcp",
  },
}

if $event.message_type.to_lower() in ["renew", "rebind"] {
  $ocsf.is_renewal = true
}

if $event.client_action? != null {
  $ocsf.activity_id = $activity_ids.get($event.client_action.to_lower(), 99)
}

match $ocsf.activity_id {
  2 | 5 => {
    $ocsf.status_id = 1
  }
  4 | 6 => {
    $ocsf.status_id = 2
  }
  _ => {
    $ocsf.status_id = 0
  }
}

if $event.reason? != null {
  $ocsf.status_detail = move $event.reason
}
if $ocsf.status_detail? == null and $event.status_text? != null {
  $ocsf.status_detail = move $event.status_text
}
if $event.identity_association?.valid_for_seconds? != null {
  $ocsf.lease_dur = move $event.identity_association.valid_for_seconds
}
if $event.transaction_id? != null {
  $ocsf.transaction_uid = move $event.transaction_id
}
if $ocsf.activity_id == 99 {
  $ocsf.activity_name = $event.client_event? else $event.client_action? else $event.message_type
}
if $event.via_ip? != null or $event.via_interface? != null {
  if $event.via_ip? != null {
    $ocsf.relay.ip = move $event.via_ip
  }
  if $event.via_interface? != null {
    $ocsf.relay.name = move $event.via_interface
  }
}
$ocsf.type_uid = 400400 + $ocsf.activity_id
