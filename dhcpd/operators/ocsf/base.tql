---
description: ISC DHCPD parsed record -> OCSF Base Event.
args:
  positional:
    - name: dhcpd
      description: The structured DHCPD event to read.
      type: field
    - name: ocsf
      description: The OCSF event to build.
      type: field
---

@name = "ocsf.base_event"

$ocsf = {
  time: move $dhcpd.time,
  category_uid: 0,
  class_uid: 0,
  activity_id: 0,
  severity_id: 1,
  type_uid: 0,
  status_id: 0,
  metadata: {
    version: "1.9.0",
    log_name: "dhcpd",
    log_provider: "ISC DHCPD",
    log_source: "dhcpd",
    product: {
      name: "ISC DHCPD",
      vendor_name: "ISC",
    },
  },
}
