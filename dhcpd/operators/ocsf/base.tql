---
description: ISC DHCPD parsed record -> OCSF Base Event.
args:
  positional:
    - name: event
      description: The active mapping scope.
      type: field
---

@name = "ocsf.base_event"

$event.ocsf = {
  time: move $event.dhcpd.time,
  category_uid: 0,
  class_uid: 0,
  activity_id: 0,
  severity_id: 1,
  type_uid: 0,
  status_id: 0,
  metadata: {
    version: "1.9.0",
    log_name: "dhcpd",
    log_provider: "ISC DHCPD",
    log_source: "dhcpd",
    product: {
      name: "ISC DHCPD",
      vendor_name: "ISC",
    },
  },
}
