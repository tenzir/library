---
description: |
  Parses an ISC DHCPD message body.

  The first positional field holds the raw message body, not the full Syslog
  envelope. The second receives the structured DHCPD event:

  ```tql
  dhcpd::parse message, event
  ```

  The parser leaves the input field unchanged. It does not add a timestamp or
  provenance because those belong to the carrier around the message.
args:
  positional:
    - name: log
      type: field
      description: The source field to parse.
    - name: dhcpd
      type: field
      description: The field that receives the parsed event.
---

if $log == null {
  @name = "dhcpd.parser_error"
  $dhcpd = {
    category: "parser",
    template: "missing_message",
    parser: {
      warning: "missing required input field",
      field: "message",
    },
  }
} else {
  // Snapshot the input once. Each parser writes directly to `event` on a match.
  $dhcpd = {
    source: $log,
    event: null,
  }
  // BOOTP must run first because DHCP4o6 can prefix BOOTP messages.
  dhcpd::parsers::bootp $dhcpd
  if $dhcpd.event.category? == null {
    dhcpd::parsers::dhcpv4 $dhcpd
  }
  if $dhcpd.event.category? == null {
    dhcpd::parsers::dhcpv6 $dhcpd
  }
  if $dhcpd.event.category? == null {
    dhcpd::parsers::fallback $dhcpd
  }
  $dhcpd = move $dhcpd.event
}
