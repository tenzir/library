---
description: |
  Parses an ISC DHCPD message body.

  The first field holds the raw message body, not the full Syslog envelope, and
  the second receives the structured DHCPD event:

  ```tql
  dhcpd::parse message, dhcpd
  ```

  The parser leaves the input field unchanged. It does not add a timestamp or
  provenance because those belong to the carrier around the message.
args:
  positional:
    - name: log
      description: The field holding the raw DHCPD message body.
      type: field
    - name: dhcpd
      description: The field that receives the structured DHCPD event.
      type: field
---

// The parser helpers use `raw_data` as scratch state. The public parser removes
// it before returning because only the caller can choose event provenance.
$dhcpd = {raw_data: $log.string()}
if $dhcpd.raw_data == null {
  @name = "dhcpd.parser_error"
  $dhcpd = {
    category: "parser",
    template: "missing_message",
    parser: {
      warning: "missing required input field",
      field: "message",
    },
  }
} else {
  // Parsers are probes: each leaves $dhcpd unchanged on no match.
  // BOOTP must run first because DHCP4o6 can prefix BOOTP messages.
  dhcpd::parsers::bootp event=$dhcpd
  if $dhcpd.category? == null {
    dhcpd::parsers::dhcpv4 event=$dhcpd
  }
  if $dhcpd.category? == null {
    dhcpd::parsers::dhcpv6 event=$dhcpd
  }
  if $dhcpd.category? == null {
    dhcpd::parsers::fallback event=$dhcpd
  }
  drop $dhcpd.raw_data
}
