---
description: |
  Parses an ISC DHCPD message body.

  The positional field holds the raw message body, not the full Syslog
  envelope. The named output receives the structured DHCPD event:

  ```tql
  dhcpd::parse message, into=event
  ```

  The parser leaves the input field unchanged. It does not add a timestamp or
  provenance because those belong to the carrier around the message.
args:
  positional:
    - name: log
      description: The field holding the raw DHCPD message body.
      type: field
  named:
    - name: into
      description: The field that receives the structured DHCPD event.
      type: field
      default: this
---

if $log == null {
  @name = "dhcpd.parser_error"
  $into = {
    category: "parser",
    template: "missing_message",
    parser: {
      warning: "missing required input field",
      field: "message",
    },
  }
} else {
  // Snapshot the input once. Each parser writes directly to `event` on a match.
  $into = {
    source: $log,
    event: null,
  }
  // BOOTP must run first because DHCP4o6 can prefix BOOTP messages.
  dhcpd::parsers::bootp $into
  if $into.event.category? == null {
    dhcpd::parsers::dhcpv4 $into
  }
  if $into.event.category? == null {
    dhcpd::parsers::dhcpv6 $into
  }
  if $into.event.category? == null {
    dhcpd::parsers::fallback $into
  }
  $into = move $into.event
}
