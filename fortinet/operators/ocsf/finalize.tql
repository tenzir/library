---
description: Completes OCSF enums and retains unidentifiable optional objects.
args:
  positional:
    - name: ocsf
      type: field
      description: The OCSF record to finalize.
---

if $ocsf.device? != null {
  $ocsf.device.type_id = $ocsf.device?.type_id? else 0
}
if $ocsf.src_endpoint?.os? != null {
  $ocsf.src_endpoint.os.type_id = $ocsf.src_endpoint?.os?.type_id? else 0
}
if $ocsf.file? != null {
  $ocsf.file.type_id = $ocsf.file?.type_id? else 0
}
if (
  $ocsf.device? != null
  and $ocsf.device?.ip? == null
  and $ocsf.device?.uid? == null
  and $ocsf.device?.name? == null
  and $ocsf.device?.hostname? == null
  and $ocsf.device?.instance_uid? == null
  and $ocsf.device?.interface_uid? == null
  and $ocsf.device?.interface_name? == null
) {
  $ocsf.unmapped.ocsf_residue.device = move $ocsf.device
}
if (
  $ocsf.src_endpoint?.location? != null
  and $ocsf.src_endpoint?.location?.city? == null
  and $ocsf.src_endpoint?.location?.country? == null
  and $ocsf.src_endpoint?.location?.postal_code? == null
  and $ocsf.src_endpoint?.location?.region? == null
) {
  $ocsf.unmapped.ocsf_residue.src_endpoint_location = move $ocsf.src_endpoint.location
}
if (
  $ocsf.dst_endpoint?.location? != null
  and $ocsf.dst_endpoint?.location?.city? == null
  and $ocsf.dst_endpoint?.location?.country? == null
  and $ocsf.dst_endpoint?.location?.postal_code? == null
  and $ocsf.dst_endpoint?.location?.region? == null
) {
  $ocsf.unmapped.ocsf_residue.dst_endpoint_location = move $ocsf.dst_endpoint.location
}
if (
  $ocsf.finding_info?.analytic? != null
  and $ocsf.finding_info?.analytic?.name? == null
  and $ocsf.finding_info?.analytic?.uid? == null
) {
  $ocsf.unmapped.ocsf_residue.finding_info_analytic = move $ocsf.finding_info.analytic
}
if $ocsf.evidences? != null {
  if (
    $ocsf.evidences.where(e => (e.src_endpoint?.location? != null
    and e.src_endpoint?.location?.city? == null
    and e.src_endpoint?.location?.country? == null
    and e.src_endpoint?.location?.postal_code? == null
    and e.src_endpoint?.location?.region? == null)
    or (e.dst_endpoint?.location? != null
    and e.dst_endpoint?.location?.city? == null
    and e.dst_endpoint?.location?.country? == null
    and e.dst_endpoint?.location?.postal_code? == null
    and e.dst_endpoint?.location?.region? == null)).length() > 0
  ) {
    $ocsf.unmapped.ocsf_residue.evidences = $ocsf.evidences.where(e => (e.src_endpoint?.location? != null
      and e.src_endpoint?.location?.city? == null
      and e.src_endpoint?.location?.country? == null
      and e.src_endpoint?.location?.postal_code? == null
      and e.src_endpoint?.location?.region? == null)
      or (e.dst_endpoint?.location? != null
      and e.dst_endpoint?.location?.city? == null
      and e.dst_endpoint?.location?.country? == null
      and e.dst_endpoint?.location?.postal_code? == null
      and e.dst_endpoint?.location?.region? == null))
  }
  $ocsf.evidences = $ocsf.evidences.map(e => {
    ...e,
    src_endpoint: {
      ...e.src_endpoint?,
      location: e.src_endpoint?.location? if not (e.src_endpoint?.location? != null
        and e.src_endpoint?.location?.city? == null
        and e.src_endpoint?.location?.country? == null
        and e.src_endpoint?.location?.postal_code? == null
        and e.src_endpoint?.location?.region? == null) else null
    } if e.src_endpoint? != null else null,
    dst_endpoint: {
      ...e.dst_endpoint?,
      location: e.dst_endpoint?.location? if not (e.dst_endpoint?.location? != null
        and e.dst_endpoint?.location?.city? == null
        and e.dst_endpoint?.location?.country? == null
        and e.dst_endpoint?.location?.postal_code? == null
        and e.dst_endpoint?.location?.region? == null) else null
    } if e.dst_endpoint? != null else null
  })
}
