---
description: Maps FortiGate endpoint country names without treating them as ISO codes.
args:
  named:
    - name: event
      type: field
      description: The working FortiGate and OCSF event.
---

// FortiGate reports country names; OCSF location.country requires an ISO code.
// Preserve the human-readable name as the location description. "Reserved"
// describes an address class rather than a geographic location.
if $event.fortinet.srccountry? != "Reserved" {
  $event.ocsf.src_endpoint.location.desc = move $event.fortinet.srccountry?
}
if $event.fortinet.dstcountry? != "Reserved" {
  $event.ocsf.dst_endpoint.location.desc = move $event.fortinet.dstcountry?
}
