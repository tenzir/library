---
description: Maps FortiGate endpoint country names without treating them as ISO codes.
args:
  named:
    - name: event
      type: field
      description: The working FortiGate and OCSF event.
---

// Country names remain in the source fields; only ISO codes form locations.
if $event.fortinet.srccountry?.length_chars() == 2 {
  $event.ocsf.src_endpoint.location.country = (move $event.fortinet.srccountry).to_upper()
}
if $event.fortinet.dstcountry?.length_chars() == 2 {
  $event.ocsf.dst_endpoint.location.country = (move $event.fortinet.dstcountry).to_upper()
}
