---
description: Normalizes a structured FortiGate event to OCSF 1.9.
args:
  positional:
    - name: event
      description: The structured FortiGate event.
      type: field
      default: this
  named:
    - name: into
      description: The field that receives the OCSF event.
      type: field
      default: this
---

$into = {source: $event, ocsf: {}}
fortinet::fortigate::ocsf::map $into.source, $into.ocsf
$into = move $into.ocsf
