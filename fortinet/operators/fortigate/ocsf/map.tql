---
description: Maps a structured FortiGate event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The structured FortiGate event to map.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the OCSF event.
---


$into = {fortinet: $event, ocsf: {}}

// Normalize FortiGate sentinel strings to null.
replace $into.fortinet, what="N/A", with=null
replace $into.fortinet, what="none", with=null
replace $into.fortinet, what="undefined", with=null

$into.ocsf.metadata = {
  log_format: "kv",
  log_level: move $into.fortinet.level,
  log_name: move $into.fortinet.subtype,
  original_time: f"{(move $into.fortinet.date).format_time("%Y-%m-%d")} {move $into.fortinet.time}",
  original_event_uid: (move $into.fortinet.logid).string(),
  processed_time: now(),
  product: {
    name: "FortiGate",
    vendor_name: "Fortinet",
  },
  profiles: ["host"],
  type: move $into.fortinet.type?,
  version: "1.9.0",
}

if $into.fortinet.msg? != null {
  $into.ocsf.message = move $into.fortinet.msg
}

if $into.fortinet.eventtime? != null {
  $into.ocsf.time = move $into.fortinet.eventtime
  // FortiGate eventtime is seconds (10-digit) or nanoseconds (19-digit).
  // Values below 1e13 are seconds; above are nanoseconds.
  $into.ocsf.time = $into.ocsf.time.seconds() if $into.ocsf.time < 10T else $into.ocsf.time.nanoseconds()
  $into.ocsf.time = $into.ocsf.time.from_epoch()
} else {
  $into.ocsf.time = $into.ocsf.metadata.original_time.parse_time("%Y-%m-%d %H:%M:%S")
}

if $into.fortinet.logdesc? != null  {
  $into.ocsf.status_detail = move $into.fortinet.logdesc
}

// `severity` is present on some UTM logs; `level` appears on all logs and is
// already captured in metadata.log_level. Use severity first, fall back to
// level so events without an explicit severity are not silently downgraded to
// Informational.
if $into.fortinet.severity? != null {
  let $severities = {
    low: 2,
    medium: 3,
    high: 4,
    critical: 5,
  }
  $into.ocsf.severity_id = $severities[move $into.fortinet.severity]
} else if $into.ocsf.metadata.log_level? != null {
  let $levels = {
    debug: 1,
    information: 1,
    notice: 1,
    warning: 3,
    error: 4,
    alert: 5,
    critical: 5,
    emergency: 6,
  }
  $into.ocsf.severity_id = $levels[$into.ocsf.metadata.log_level]? else 1
} else {
  $into.ocsf.severity_id = 1
}

// Host profile
if $into.fortinet.vd? != null {
  $into.ocsf.device.zone = move $into.fortinet.vd
}

// Specific event type mappings
if $into.ocsf.metadata.type == "utm" {
  if $into.ocsf.metadata.log_name == "dns" {
    fortinet::fortigate::ocsf::logs::dns event=$into
  } else if $into.ocsf.metadata.log_name == "ips" {
    fortinet::fortigate::ocsf::logs::ips event=$into
  } else if $into.ocsf.metadata.log_name == "webfilter" {
    fortinet::fortigate::ocsf::logs::webfilter event=$into
  } else if $into.ocsf.metadata.log_name == "anomaly" {
    fortinet::fortigate::ocsf::logs::anomaly event=$into
  } else if $into.ocsf.metadata.log_name == "virus" {
    fortinet::fortigate::ocsf::logs::virus event=$into
  } else if $into.ocsf.metadata.log_name == "ssh" {
    fortinet::fortigate::ocsf::logs::ssh event=$into
  } else if $into.ocsf.metadata.log_name == "ssl" {
    fortinet::fortigate::ocsf::logs::ssl event=$into
  } else if $into.ocsf.metadata.log_name == "emailfilter" {
    fortinet::fortigate::ocsf::logs::emailfilter event=$into
  } else if $into.ocsf.metadata.log_name == "app-ctrl" {
    fortinet::fortigate::ocsf::logs::app_ctrl event=$into
  } else if $into.ocsf.metadata.log_name == "dlp" {
    fortinet::fortigate::ocsf::logs::dlp event=$into
  } else if $into.ocsf.metadata.log_name == "cifs" {
    fortinet::fortigate::ocsf::logs::cifs event=$into
  } else {
    // Unknown UTM subtype: emit as Base Event so ocsf::derive does not drop
    // the record for a missing class_uid.
    fortinet::fortigate::ocsf::base event=$into
  }
} else if $into.ocsf.metadata.type == "traffic" {
  fortinet::fortigate::ocsf::logs::traffic event=$into
} else if $into.ocsf.metadata.type == "event" {
  if $into.ocsf.metadata.log_name == "user" {
    fortinet::fortigate::ocsf::logs::authentication event=$into
  } else if $into.ocsf.metadata.log_name == "system" {
    // Only admin login/logout events map to Authentication; subtype="system"
    // also covers startup, config changes, and performance stats which should
    // fall through to Base Event.
    if $into.fortinet.action? == "login" or $into.fortinet.action? == "logout" {
      fortinet::fortigate::ocsf::logs::authentication event=$into
    } else {
      fortinet::fortigate::ocsf::base event=$into
    }
  } else if $into.ocsf.metadata.log_name == "vpn" {
    fortinet::fortigate::ocsf::logs::vpn event=$into
  } else if $into.ocsf.metadata.log_name == "endpoint" {
    fortinet::fortigate::ocsf::logs::endpoint event=$into
  } else if $into.ocsf.metadata.log_name == "wad" {
    fortinet::fortigate::ocsf::logs::wad event=$into
  } else if $into.ocsf.metadata.log_name == "wireless" {
    fortinet::fortigate::ocsf::logs::wireless event=$into
  } else {
    fortinet::fortigate::ocsf::base event=$into
  }
} else {
  fortinet::fortigate::ocsf::base event=$into
}



$into = {...$into.ocsf, unmapped: $into.fortinet}
