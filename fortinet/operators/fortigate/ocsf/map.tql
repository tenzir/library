---
description: Maps a structured FortiGate event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---


$event = {fortinet: $event, ocsf: {}}

// Normalize FortiGate sentinel strings to null.
replace $event.fortinet, what="N/A", with=null
replace $event.fortinet, what="none", with=null
replace $event.fortinet, what="undefined", with=null

$event.ocsf.metadata = {
  log_format: "kv",
  log_level: move $event.fortinet.level,
  log_name: move $event.fortinet.subtype,
  original_time: f"{(move $event.fortinet.date).format_time("%Y-%m-%d")} {move $event.fortinet.time}",
  original_event_uid: (move $event.fortinet.logid).string(),
  processed_time: now(),
  product: {
    name: "FortiGate",
    vendor_name: "Fortinet",
  },
  profiles: ["host"],
  type: move $event.fortinet.type?,
  version: "1.9.0",
}

$event.ocsf.message = move $event.fortinet.msg?

if $event.fortinet.eventtime? != null {
  $event.ocsf.time = move $event.fortinet.eventtime
  // FortiGate eventtime is seconds (10-digit) or nanoseconds (19-digit).
  // Values below 1e13 are seconds; above are nanoseconds.
  $event.ocsf.time = $event.ocsf.time.seconds() if $event.ocsf.time < 10T else $event.ocsf.time.nanoseconds()
  $event.ocsf.time = $event.ocsf.time.from_epoch()
} else {
  $event.ocsf.time = $event.ocsf.metadata.original_time.parse_time("%Y-%m-%d %H:%M:%S")
}

$event.ocsf.status_detail = move $event.fortinet.logdesc?

// `severity` is present on some UTM logs; `level` appears on all logs and is
// already captured in metadata.log_level. Use severity first, fall back to
// level so events without an explicit severity are not silently downgraded to
// Informational.
if $event.fortinet.severity? != null {
  let $severities = {
    low: 2,
    medium: 3,
    high: 4,
    critical: 5,
  }
  $event.ocsf.severity_id = $severities[move $event.fortinet.severity]
} else if $event.ocsf.metadata.log_level? != null {
  let $levels = {
    debug: 1,
    information: 1,
    notice: 1,
    warning: 3,
    error: 4,
    alert: 5,
    critical: 5,
    emergency: 6,
  }
  $event.ocsf.severity_id = $levels[$event.ocsf.metadata.log_level]? else 1
} else {
  $event.ocsf.severity_id = 1
}

// Host profile
$event.ocsf.device.zone = move $event.fortinet.vd?

// Specific event type mappings
match $event.ocsf.metadata.type {
  "utm" => {
    match $event.ocsf.metadata.log_name {
      "dns" => { fortinet::fortigate::ocsf::logs::dns event=$event }
      "ips" => { fortinet::fortigate::ocsf::logs::ips event=$event }
      "webfilter" => { fortinet::fortigate::ocsf::logs::webfilter event=$event }
      "anomaly" => { fortinet::fortigate::ocsf::logs::anomaly event=$event }
      "virus" => { fortinet::fortigate::ocsf::logs::virus event=$event }
      "ssh" => { fortinet::fortigate::ocsf::logs::ssh event=$event }
      "ssl" => { fortinet::fortigate::ocsf::logs::ssl event=$event }
      "emailfilter" => { fortinet::fortigate::ocsf::logs::emailfilter event=$event }
      "app-ctrl" => { fortinet::fortigate::ocsf::logs::app_ctrl event=$event }
      "dlp" => { fortinet::fortigate::ocsf::logs::dlp event=$event }
      "cifs" => { fortinet::fortigate::ocsf::logs::cifs event=$event }
      _ => { fortinet::fortigate::ocsf::base event=$event }
    }
  }
  "traffic" => { fortinet::fortigate::ocsf::logs::traffic event=$event }
  "event" => {
    match $event.ocsf.metadata.log_name {
      "user" => { fortinet::fortigate::ocsf::logs::authentication event=$event }
      "system" if $event.fortinet.action? in ["login", "logout"] => {
        fortinet::fortigate::ocsf::logs::authentication event=$event
      }
      "vpn" => { fortinet::fortigate::ocsf::logs::vpn event=$event }
      "endpoint" => { fortinet::fortigate::ocsf::logs::endpoint event=$event }
      "wad" => { fortinet::fortigate::ocsf::logs::wad event=$event }
      "wireless" => { fortinet::fortigate::ocsf::logs::wireless event=$event }
      _ => { fortinet::fortigate::ocsf::base event=$event }
    }
  }
  _ => { fortinet::fortigate::ocsf::base event=$event }
}



$ocsf = {...$event.ocsf, unmapped: $event.fortinet}
