// Synthetic FortiGate UTM log (app-ctrl, logid 1059028704); every value is
// invented. The field layout follows the FortiOS Log Message Reference.
from_file env("TENZIR_INPUT") {
  read_lines
}
fortinet = line.parse_kv()
fortinet::fortigate::ocsf::map fortinet, ocsf
ocsf.raw_data = move line
ocsf.raw_data_size = ocsf.raw_data.length_bytes()
this = ocsf_cast(ocsf)
drop metadata.processed_time
