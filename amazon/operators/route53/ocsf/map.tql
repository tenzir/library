---
description: Maps an Amazon Route 53 Resolver Query Log event to OCSF 1.9 DNS Activity.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

$ocsf = {}
if $event != null {


  // --- Constants --------------------------------
  // Define lookup tables upfront for record-based mappings.

  let $rcode_id = {
    NOERROR: 0,
    FORMERR: 1,
    SERVFAIL: 2,
    NXDOMAIN: 3,
    NOTIMP: 4,
    REFUSED: 5,
    YXDOMAIN: 6,
    YXRRSET: 7,
    NXRRSET: 8,
    NOTAUTH: 9,
    NOTZONE: 10,
    DSOTYPENI: 11,
    BADSIG_VERS: 99,
    BADKEY: 17,
    BADTIME: 18,
    BADMODE: 19,
    BADNAME: 20,
    BADALG: 21,
    BADTRUNC: 22,
    BADCOOKIE: 23,
  }

  let $proto_nums = {
    UDP: 17,
    TCP: 6,
  }

  // DNS Firewall action mappings per OCSF security_control profile.
  let $firewall_actions = {
    BLOCK: {
      action_id: 2,
      disposition_id: 2,
    },
    ALLOW: {
      action_id: 1,
      disposition_id: 1,
    },
    ALERT: {
      action_id: 3,
      disposition_id: 19,
      is_alert: true,
    },
  }

  // --- Preamble ---------------------------------


  // --- OCSF: classification attributes ----------

  $ocsf.category_uid = 4
  $ocsf.class_uid = 4003
  $ocsf.severity_id = 1
  $ocsf.activity_id = 1
  $ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

  // --- OCSF: context attributes -----------------

  $ocsf.cloud = {
    account: {
      uid: move $event.account_id?,
    },
    region: move $event.region?,
    provider: "AWS",
  }

  $ocsf.metadata = {
    product: {
      name: "Amazon Route 53",
      vendor_name: "AWS",
      version: $event.version?.string(),
      feature: {
        name: "Resolver Query Logs",
      },
    },
    version: "1.9.0",
    profiles: ["cloud"],
  }
  drop $event.version?

  // --- OCSF: occurrence attributes --------------

  $ocsf.time = move $event.query_timestamp?
  $ocsf.query_time = $ocsf.time
  $ocsf.opcode_id = 0

  // --- OCSF: primary attributes -----------------

  $ocsf.query = {
    hostname: move $event.query_name?,
    type: move $event.query_type?,
    class: move $event.query_class?,
  }

  if $event.has("answers") and $event.answers.length() > 0 {
    $ocsf.activity_id = 2
    $ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
    $ocsf.answers = (move $event.answers).map(a => {
      rdata: string(a.Rdata),
      type: a.Type,
      class: a.Class,
    })
    $ocsf.response_time = $ocsf.time
  } else {
    drop $event.answers?
  }

  // Map DNS response codes to OCSF rcode_id values.
  if $event.has("rcode") {
    $ocsf.rcode_id = $rcode_id[$event.rcode]? else 99
    if $ocsf.rcode_id == 99 {
      $ocsf.rcode = move $event.rcode
    } else {
      drop $event.rcode
    }
    $ocsf.status_id = 1 if $ocsf.rcode_id == 0 else 2
  } else {
    $ocsf.status_id = 0
  }

  // --- OCSF: network attributes -----------------

  if $event.has("srcaddr") {
    $ocsf.src_endpoint.ip = ip(move $event.srcaddr)
    $ocsf.connection_info.protocol_ver_id = 6 if $ocsf.src_endpoint.ip.is_v6() else 4
  }
  if $event.has("srcport") {
    $ocsf.src_endpoint.port = int(move $event.srcport)
  }
  if $event.has("vpc_id") {
    $ocsf.src_endpoint.vpc_uid = move $event.vpc_id
  }
  if $event.srcids?.instance? != null {
    $ocsf.src_endpoint.instance_uid = move $event.srcids.instance
  }

  // Resolver endpoint info goes to dst_endpoint since it's the DNS server.
  if $event.srcids?.resolver_endpoint? != null {
    $ocsf.dst_endpoint.uid = move $event.srcids.resolver_endpoint
  }
  if $event.srcids?.resolver_network_interface? != null {
    $ocsf.dst_endpoint.interface_uid = move $event.srcids.resolver_network_interface
  }
  drop $event.srcids?

  if $event.has("transport") {
    $ocsf.connection_info.protocol_name = $event.transport.to_lower()
    $ocsf.connection_info.protocol_num = $proto_nums[$event.transport]? else 0
    drop $event.transport
  }

  // --- DNS Firewall (security_control profile) --

  if $event.has("firewall_rule_action") {
    $ocsf.metadata.profiles = ["cloud", "security_control"]
    if $firewall_actions[$event.firewall_rule_action]? != null {
      $ocsf.action_id = $firewall_actions[$event.firewall_rule_action].action_id
      $ocsf.disposition_id = $firewall_actions[$event.firewall_rule_action].disposition_id
      if $firewall_actions[$event.firewall_rule_action].is_alert? != null {
        $ocsf.is_alert = $firewall_actions[$event.firewall_rule_action].is_alert
      }
    } else {
      $ocsf.action_id = 99
      $ocsf.action = $event.firewall_rule_action
      $ocsf.disposition_id = 99
      $ocsf.disposition = $event.firewall_rule_action
    }
    drop $event.firewall_rule_action
    $ocsf.firewall_rule = {
      uid: move $event.firewall_rule_group_id?,
      match_details: [move $event.firewall_domain_list_id] if $event.firewall_domain_list_id? != null,
    }
  }

  // --- Finalize ---------------------------------

  @name = "ocsf.dns_activity"

} else {
  @name = "ocsf.base_event"
  $ocsf = {
    category_uid: 0,
    class_uid: 0,
    activity_id: 0,
    severity_id: 1,
    type_uid: 0,
    status_id: 0,
    metadata: {
      version: "1.9.0",
      product: {name: "Amazon Route 53", vendor_name: "AWS"},
    },
  }
}
$ocsf.unmapped = move $event
