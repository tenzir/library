---
description: |
  Maps a structured AWS VPC Flow Log event to OCSF 1.9 Network Activity.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

$ocsf = {}
if $event != null and $event.log_status? not in ["NODATA", "SKIPDATA"] {



  // --- OCSF: classification attributes ----------

  $ocsf.category_uid = 4
  $ocsf.class_uid = 4001
  $ocsf.severity_id = 1

  // --- OCSF: context attributes -----------------

  $ocsf.cloud = {
    account: {
      uid: (move $event.account_id?).string(),
    },
    region: move $event.region?,
    zone: move $event.az_id?,
    provider: "AWS",
  }

  $ocsf.metadata = {
    version: "1.9.0",
    product: {
      name: "Amazon VPC",
      vendor_name: "AWS",
      version: $event.version?.string(),
      feature: {
        name: "Flow Logs",
      },
    },
    profiles: ["cloud", "security_control"],
  }
  drop $event.version?

  // --- OCSF: occurrence attributes --------------

  $ocsf.time = $event.start?

  // --- OCSF: primary attributes -----------------

  $ocsf.traffic = {
    bytes: move $event.bytes?,
    packets: move $event.packets?,
    start_time: move $event.start?,
    end_time: move $event.end?,
  }

  $ocsf.connection_info = {
    direction_id: 0,
    protocol_num: move $event.protocol?,
    tcp_flags: move $event.tcp_flags?,
  }

  $ocsf.status_code = move $event.log_status?

  // --- Security control: action/disposition -----

  match $event.action? {
    "REJECT" => {
      $ocsf.activity_id = 5
      $ocsf.action_id = 2
      $ocsf.disposition_id = 2
    }
    "ACCEPT" => {
      $ocsf.activity_id = 6
      $ocsf.action_id = 1
      $ocsf.disposition_id = 1
    }
    _ => {
      // NODATA and SKIPDATA windows contain no firewall decision.
      $ocsf.activity_id = 6
    }
  }
  $ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
  drop $event.action?

  if $event.reject_reason? != null {
    $ocsf.status_detail = move $event.reject_reason
  }

  // --- Traffic path (v5+) -----------------------

  $ocsf.connection_info.boundary_id = move $event.traffic_path?
  // AWS traffic path values 1 and 2 are not the same as OCSF boundary IDs.
  if $ocsf.connection_info.boundary_id >= 1 and $ocsf.connection_info.boundary_id <= 8 {
    $ocsf.connection_info.boundary_id = $ocsf.connection_info.boundary_id + 3
  }

  // Map endpoint attributes only when this source identifies the endpoint.
  match $event.flow_direction? {
    "ingress" => { $ocsf.connection_info.direction_id = 1 }
    "egress" => { $ocsf.connection_info.direction_id = 2 }
    _ => {}
  }

  if $event.srcaddr? != null or $event.pkt_srcaddr? != null or
     $event.pkt_src_aws_service? != null or
     ($event.flow_direction? == "egress" and
      ($event.interface_id? != null or $event.instance_id? != null)) {
    $ocsf.src_endpoint = {
      port: move $event.srcport?,
      svc_name: move $event.pkt_src_aws_service?,
    }
    if $event.flow_direction? == "egress" {
      $ocsf.src_endpoint.interface_uid = move $event.interface_id?
      $ocsf.src_endpoint.vpc_uid = move $event.vpc_id?
      $ocsf.src_endpoint.instance_uid = move $event.instance_id?
      $ocsf.src_endpoint.subnet_uid = move $event.subnet_id?
    }
    // Packet addresses precede addresses observed after NAT.
    if $event.pkt_srcaddr? != $event.srcaddr? and $event.pkt_srcaddr? != null {
      $ocsf.src_endpoint.ip = move $event.pkt_srcaddr
      $ocsf.src_endpoint.intermediate_ips = [move $event.srcaddr?]
    } else {
      $ocsf.src_endpoint.ip = move $event.srcaddr?
      drop $event.pkt_srcaddr?
    }
  }

  if $event.dstaddr? != null or $event.pkt_dstaddr? != null or
     $event.pkt_dst_aws_service? != null or
     ($event.flow_direction? == "ingress" and
      ($event.interface_id? != null or $event.instance_id? != null)) {
    $ocsf.dst_endpoint = {
      port: move $event.dstport?,
      svc_name: move $event.pkt_dst_aws_service?,
    }
    if $event.flow_direction? == "ingress" {
      $ocsf.dst_endpoint.interface_uid = move $event.interface_id?
      $ocsf.dst_endpoint.vpc_uid = move $event.vpc_id?
      $ocsf.dst_endpoint.instance_uid = move $event.instance_id?
      $ocsf.dst_endpoint.subnet_uid = move $event.subnet_id?
    }
    // Packet addresses precede addresses observed after NAT.
    if $event.pkt_dstaddr? != $event.dstaddr? and $event.pkt_dstaddr? != null {
      $ocsf.dst_endpoint.ip = move $event.pkt_dstaddr
      $ocsf.dst_endpoint.intermediate_ips = [move $event.dstaddr?]
    } else {
      $ocsf.dst_endpoint.ip = move $event.dstaddr?
      drop $event.pkt_dstaddr?
    }
  }
  if $event.flow_direction? in ["ingress", "egress"] {
    drop $event.flow_direction
  }

  if ($ocsf.src_endpoint?.ip? != null and $ocsf.src_endpoint.ip.is_v6()) or
     ($ocsf.dst_endpoint?.ip? != null and $ocsf.dst_endpoint.ip.is_v6()) {
    $ocsf.connection_info.protocol_ver_id = 6
  } else if $ocsf.src_endpoint?.ip? != null or $ocsf.dst_endpoint?.ip? != null {
    $ocsf.connection_info.protocol_ver_id = 4
  }

  drop $event.type?

  // --- Additional fields ------------------------

  if $event.sublocation_type? != null {
    $ocsf.cloud.sublocation = {
      type: move $event.sublocation_type,
      uid: move $event.sublocation_id?,
    }
  }

  // --- Finalize ---------------------------------

  @name = "ocsf.network_activity"

} else if $event != null {
  // NODATA/SKIPDATA describe log collection, not a network connection.
  // https://docs.aws.amazon.com/vpc/latest/userguide/flow-log-records.html
  @name = "ocsf.base_event"
  $ocsf = {
    time: $event.start? else $event.end?,
    category_uid: 0, class_uid: 0, activity_id: 99, type_uid: 99,
    severity_id: 1,
    status_id: 0,
    status_code: move $event.log_status,
    metadata: {
      version: "1.9.0",
      profiles: ["cloud"],
      product: {name: "Amazon VPC", vendor_name: "AWS", version: (move $event.version?).string()},
    },
    cloud: {
      account: {uid: (move $event.account_id?).string()},
      provider: "AWS",
      region: move $event.region?,
      zone: move $event.az_id?,
    },
  }
  $ocsf.activity_name = $ocsf.status_code
  drop $event.start?
} else {
  @name = "ocsf.base_event"
  $ocsf = {
    // No source clock is available; use observation time.
    time: now(),
    category_uid: 0,
    class_uid: 0,
    activity_id: 0,
    severity_id: 1,
    type_uid: 0,
    status_id: 0,
    metadata: {
      version: "1.9.0",
      product: {name: "Amazon VPC", vendor_name: "AWS"},
    },
  }
}
$ocsf.unmapped = move $event
