---
description: |
  Maps a structured AWS VPC Flow Log event to OCSF 1.9 Network Activity.
args:
  positional:
    - name: event
      description: The structured VPC Flow Log event to map.
      type: field
      default: this
  named:
    - name: into
      description: The field that receives the OCSF event.
      type: field
      default: this
---

$into = {vpc_flow: $event, ocsf: {}}
if $into.vpc_flow != null {



  // --- OCSF: classification attributes ----------

  $into.ocsf.category_uid = 4
  $into.ocsf.class_uid = 4001
  $into.ocsf.severity_id = 1

  // --- OCSF: context attributes -----------------

  $into.ocsf.cloud = {
    account: {
      uid: (move $into.vpc_flow.account_id?).string(),
    },
    region: move $into.vpc_flow.region?,
    zone: move $into.vpc_flow.az_id?,
    provider: "AWS",
  }

  $into.ocsf.metadata = {
    version: "1.9.0",
    product: {
      name: "Amazon VPC",
      vendor_name: "AWS",
      version: $into.vpc_flow.version?.string(),
      feature: {
        name: "Flow Logs",
      },
    },
    profiles: ["cloud", "security_control"],
  }
  drop $into.vpc_flow.version?

  // --- OCSF: occurrence attributes --------------

  $into.ocsf.time = $into.vpc_flow.start?

  // --- OCSF: primary attributes -----------------

  $into.ocsf.traffic = {
    bytes: move $into.vpc_flow.bytes?,
    packets: move $into.vpc_flow.packets?,
    start_time: move $into.vpc_flow.start?,
    end_time: move $into.vpc_flow.end?,
  }

  $into.ocsf.connection_info = {
    protocol_num: move $into.vpc_flow.protocol?,
    tcp_flags: move $into.vpc_flow.tcp_flags?,
  }

  $into.ocsf.status_code = move $into.vpc_flow.log_status?

  $into.ocsf.src_endpoint = {
    port: move $into.vpc_flow.srcport?,
    svc_name: move $into.vpc_flow.pkt_src_aws_service?,
  }

  $into.ocsf.dst_endpoint = {
    port: move $into.vpc_flow.dstport?,
    svc_name: move $into.vpc_flow.pkt_dst_aws_service?,
  }

  // --- Security control: action/disposition -----

  if $into.vpc_flow.action? == "REJECT" {
    $into.ocsf.activity_id = 5
    $into.ocsf.action_id = 2
    $into.ocsf.disposition_id = 2
  } else if $into.vpc_flow.action? == "ACCEPT" {
    $into.ocsf.activity_id = 6
    $into.ocsf.action_id = 1
    $into.ocsf.disposition_id = 1
  } else {
    // NODATA and SKIPDATA windows contain no firewall decision.
    $into.ocsf.activity_id = 6
  }
  $into.ocsf.type_uid = $into.ocsf.class_uid * 100 + $into.ocsf.activity_id
  drop $into.vpc_flow.action?

  if $into.vpc_flow.reject_reason? != null {
    $into.ocsf.status_detail = move $into.vpc_flow.reject_reason
  }

  // --- Traffic path (v5+) -----------------------

  $into.ocsf.connection_info.boundary_id = move $into.vpc_flow.traffic_path?
  // AWS traffic path values 1 and 2 are not the same as OCSF boundary IDs.
  if $into.ocsf.connection_info.boundary_id >= 1 and $into.ocsf.connection_info.boundary_id <= 8 {
    $into.ocsf.connection_info.boundary_id = $into.ocsf.connection_info.boundary_id + 3
  }

  // --- Flow direction and endpoint assignment ---

  if $into.vpc_flow.flow_direction? == "ingress" {
    $into.ocsf.connection_info.direction_id = 1
    $into.ocsf.dst_endpoint.interface_uid = move $into.vpc_flow.interface_id?
    $into.ocsf.dst_endpoint.vpc_uid = move $into.vpc_flow.vpc_id?
    $into.ocsf.dst_endpoint.instance_uid = move $into.vpc_flow.instance_id?
    $into.ocsf.dst_endpoint.subnet_uid = move $into.vpc_flow.subnet_id?
  } else if $into.vpc_flow.flow_direction? == "egress" {
    $into.ocsf.connection_info.direction_id = 2
    $into.ocsf.src_endpoint.interface_uid = move $into.vpc_flow.interface_id?
    $into.ocsf.src_endpoint.vpc_uid = move $into.vpc_flow.vpc_id?
    $into.ocsf.src_endpoint.instance_uid = move $into.vpc_flow.instance_id?
    $into.ocsf.src_endpoint.subnet_uid = move $into.vpc_flow.subnet_id?
  }
  drop $into.vpc_flow.flow_direction?

  // --- IP address handling ----------------------
  // pkt_srcaddr/pkt_dstaddr are the original addresses; srcaddr/dstaddr may
  // differ when NAT or intermediate devices are involved.

  if $into.vpc_flow.pkt_srcaddr? != $into.vpc_flow.srcaddr? and $into.vpc_flow.pkt_srcaddr? != null {
    $into.ocsf.src_endpoint.ip = move $into.vpc_flow.pkt_srcaddr
    $into.ocsf.src_endpoint.intermediate_ips = [move $into.vpc_flow.srcaddr?]
  } else {
    $into.ocsf.src_endpoint.ip = move $into.vpc_flow.srcaddr?
    drop $into.vpc_flow.pkt_srcaddr?
  }

  if $into.vpc_flow.pkt_dstaddr? != $into.vpc_flow.dstaddr? and $into.vpc_flow.pkt_dstaddr? != null {
    $into.ocsf.dst_endpoint.ip = move $into.vpc_flow.pkt_dstaddr
    $into.ocsf.dst_endpoint.intermediate_ips = [move $into.vpc_flow.dstaddr?]
  } else {
    $into.ocsf.dst_endpoint.ip = move $into.vpc_flow.dstaddr?
    drop $into.vpc_flow.pkt_dstaddr?
  }

  if ($into.ocsf.src_endpoint.ip? != null and $into.ocsf.src_endpoint.ip.is_v6()) or
     ($into.ocsf.dst_endpoint.ip? != null and $into.ocsf.dst_endpoint.ip.is_v6()) {
    $into.ocsf.connection_info.protocol_ver_id = 6
  } else if $into.ocsf.src_endpoint.ip? != null or $into.ocsf.dst_endpoint.ip? != null {
    $into.ocsf.connection_info.protocol_ver_id = 4
  }

  drop $into.vpc_flow.type?

  // --- ECS metadata (v7+) -----------------------

  if $into.vpc_flow.ecs_cluster_arn? != null {
    $into.vpc_flow.ecs = {
      cluster_arn: move $into.vpc_flow.ecs_cluster_arn?,
      cluster_name: move $into.vpc_flow.ecs_cluster_name?,
      container_instance_arn: move $into.vpc_flow.ecs_container_instance_arn?,
      container_instance_id: move $into.vpc_flow.ecs_container_instance_id?,
      container_id: move $into.vpc_flow.ecs_container_id?,
      second_container_id: move $into.vpc_flow.ecs_second_container_id?,
      service_name: move $into.vpc_flow.ecs_service_name?,
      task_definition_arn: move $into.vpc_flow.ecs_task_definition_arn?,
      task_arn: move $into.vpc_flow.ecs_task_arn?,
      task_id: move $into.vpc_flow.ecs_task_id?,
    }
  }

  // --- Additional fields ------------------------

  if $into.vpc_flow.sublocation_type? != null {
    $into.ocsf.cloud.sublocation = {
      type: move $into.vpc_flow.sublocation_type,
      uid: move $into.vpc_flow.sublocation_id?,
    }
  }

  // --- Finalize ---------------------------------

  @name = "ocsf.network_activity"

} else {
  @name = "ocsf.base_event"
  $into.ocsf = {
    category_uid: 0,
    class_uid: 0,
    activity_id: 0,
    severity_id: 1,
    type_uid: 0,
    status_id: 0,
    metadata: {
      version: "1.9.0",
      product: {name: "Amazon VPC", vendor_name: "AWS"},
    },
  }
}
$into = {...$into.ocsf, unmapped: $into.vpc_flow}
