---
description: Parses AWS VPC Flow Logs in v7 format with ECS fields.
args:
  positional:
    - name: input
      type: field
      description: The field holding the VPC Flow Log line.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the parsed record.
---

$into = $input.parse_ssv(
  header=amazon::$vpc_flow_v7_ecs_header,
  null_value="-",
)
$into.account_id = $into.account_id?.string().pad_start(12, "0")
$into.start = $into.start?.seconds().from_epoch()
$into.end = $into.end?.seconds().from_epoch()
