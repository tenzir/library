---
description: |
  Classifies and parses supported AWS VPC Flow Log layouts. Unsupported layouts
  produce `null`.
args:
  positional:
    - name: input
      type: field
      description: The field holding the VPC Flow Log line.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the parsed record.
---

match $input.split(" ").length() {
  14 => {
    amazon::vpc_flow::parse_v2 $input, into=$into
  }
  24 => {
    amazon::vpc_flow::parse_v7_ecs $input, into=$into
  }
  _ => {
    $into = null
  }
}
