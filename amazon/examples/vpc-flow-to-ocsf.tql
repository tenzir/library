---
name: VPC Flow Logs → OCSF
description: |
  Subscribes to parsed VPC Flow Log events and transforms them to OCSF
  Network Activity events, publishing to the 'ocsf' topic.
---

subscribe "amazon"
where @name == "amazon.vpc_flow"
this = {source: this, ocsf: {}}
amazon::vpc_flow::ocsf::map source, ocsf
this = ocsf
this = ocsf_derive(this)
publish "ocsf"
