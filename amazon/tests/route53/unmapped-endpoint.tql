// Unidentifiable resolver metadata stays under its original source keys.
from {
  version: "1.100000",
  account_id: "123456789012",
  query_timestamp: 2026-09-10T12:00:00Z,
  query_name: "example.test",
  query_type: "A",
  query_class: "IN",
  rcode: "NOERROR",
  transport: "UDP",
  srcaddr: "192.0.2.1",
  srcport: 53,
  srcids: {resolver_endpoint: null, resolver_network_interface: null, custom: "original"},
}
this = {source: this, ocsf: {}}
amazon::route53::ocsf::map source, ocsf
ocsf = ocsf_cast(ocsf_derive(ocsf))
assert ocsf.class_uid == 4003
assert ocsf.dst_endpoint? == null
assert ocsf.unmapped.srcids.custom == "original"
assert ocsf.unmapped.dst_endpoint? == null
select ocsf.class_uid, ocsf.unmapped.srcids
