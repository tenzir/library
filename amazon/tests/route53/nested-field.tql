from {
  carrier: "keep",
  route53: {
    version: "1.1",
    account_id: "001234567890",
    region: "us-east-1",
    query_timestamp: 2026-01-01T00:00:00Z,
    query_name: "example.com.",
    query_type: "A",
    query_class: "IN",
    srcaddr: 10.0.0.1,
    srcport: 53000,
    transport: "UDP",
    extra: "residue",
  },
}
amazon::route53::ocsf::map route53, into=ocsf
drop_null_fields
