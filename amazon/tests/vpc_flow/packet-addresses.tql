// Custom Flow Logs can carry packet-level addresses without intermediate ones.
from {
  version: 5,
  account_id: "123456789012",
  start: 2026-01-01T00:00:00Z,
  end: 2026-01-01T00:01:00Z,
  pkt_srcaddr: 192.0.2.10,
  pkt_dstaddr: 198.51.100.20,
  srcport: 50000,
  dstport: 443,
  protocol: 6,
  action: "ACCEPT",
  log_status: "OK",
}
source = this
amazon::vpc_flow::ocsf::map source, ocsf
this = ocsf_cast(ocsf_derive(ocsf))
select class_uid, src_endpoint, dst_endpoint
drop_null_fields
