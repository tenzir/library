// Synthetic structured PAN-OS Traffic records; every value is invented.
// PAN-OS names the IP protocol, but a forwarder can write its IANA number. A
// name and a number both yield `protocol_name` and `protocol_num` when IANA
// assigns the protocol; an unassigned number keeps only `protocol_num`.
from {type: "TRAFFIC", threat_content_type: "end", generated_time: 2026-05-29T15:00:00Z, serial_number: "000700000042", source_address: 192.0.2.110, destination_address: 198.51.100.110, sequence_number: 7501, protocol: "50"},
  {type: "TRAFFIC", threat_content_type: "end", generated_time: 2026-05-29T15:00:00Z, serial_number: "000700000042", source_address: 192.0.2.110, destination_address: 198.51.100.110, sequence_number: 7502, protocol: "253"},
  {type: "TRAFFIC", threat_content_type: "end", generated_time: 2026-05-29T15:00:00Z, serial_number: "000700000042", source_address: 192.0.2.110, destination_address: 198.51.100.110, sequence_number: 7503, protocol: "TCP"},
  {type: "THREAT", threat_content_type: "spyware", generated_time: 2026-05-29T15:00:00Z, serial_number: "000700000042", source_address: 192.0.2.110, destination_address: 198.51.100.110, sequence_number: 7504, ip_protocol: "17"}
this = {source: this}
paloalto::ocsf::map source, ocsf
this = ocsf_cast(ocsf_derive(ocsf))
select metadata.sequence, connection_info?, evidences?
drop_null_fields
