// Synthetic PAN-OS records; every value is invented. The column order follows
// the PAN-OS 11.1 System log fields.
// https://docs.paloaltonetworks.com/ngfw/administration/monitoring/use-syslog-for-monitoring/syslog-field-descriptions/system-log-fields
// The event time is the generated time. The receive time becomes
// `metadata.logged_time`, and the Syslog timestamp stays in `unmapped`. An
// RFC 3164 timestamp without year or zone never becomes the event time.
from {timestamp: 2026-05-29T10:20:05Z, content: "1,2026/05/29 10:20:01,000700000042,SYSTEM,general,,2026/05/29 10:20:00,,general,,,,general,informational,Example system message,7101,0x0,,,,,,fw-example-1,,,2026-05-29T10:20:00.500+00:00"},
  {timestamp: "May 29 10:21:05", content: "1,2026/05/29 10:21:01,000700000042,SYSTEM,general,,,,general,,,,general,informational,Example system message without generated time,7102,0x0,,,,,,fw-example-1,,,"},
  {timestamp: "May 29 10:22:05", content: "foo,bar,baz,UNKNOWN,qux"}
paloalto::ocsf::normalize
select time, metadata.logged_time, unmapped.timestamp, unmapped.high_resolution_timestamp?, raw_data
