// Synthetic PAN-OS System record; every value is invented. The column order
// follows the PAN-OS 11.1 System log fields.
// https://docs.paloaltonetworks.com/ngfw/administration/monitoring/use-syslog-for-monitoring/syslog-field-descriptions/system-log-fields
// `paloalto::ocsf::normalize` passes its `timezone` argument to the parser.
from {timestamp: "Jan 15 10:00:05", content: "1,2026/01/15 10:00:01,000700000042,SYSTEM,general,,2026/01/15 10:00:00,,general,,,,general,informational,Example message,8403,0x0,,,,,,fw-example-1,,,"}
paloalto::ocsf::normalize timezone="America/New_York"
select time, metadata.logged_time
