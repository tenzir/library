// Synthetic structured PAN-OS Audit records; every value is invented. PAN-OS
// writes the Audit type in upper or lower case, and both use the Audit mapping.
from {threat_content_type: "AUDIT", generate_time: 2026-05-29T18:00:00Z, serial_number: "000700000042", event_id: "cli", object: "admin-example", cli_command: "show system info", severity: "success"},
  {threat_content_type: "audit", generate_time: 2026-05-29T18:01:00Z, serial_number: "000700000042", event_id: "gui-op", object: "admin-example", cli_command: "<show><system><info/></system></show>", severity: "failed"}
this = {source: this}
paloalto::ocsf::map source, ocsf
this = ocsf_cast(ocsf_derive(ocsf))
select time, activity_name, status_id, message, unmapped
