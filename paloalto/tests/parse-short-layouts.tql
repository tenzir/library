// Synthetic PAN-OS records; every value is invented. The column order follows
// the Traffic and System log fields of PAN-OS 9.1 (75 and 23 columns) and
// 10.0 (105 Traffic columns), which are prefixes of the later layouts.
// https://docs.paloaltonetworks.com/pan-os/9-1/pan-os-admin/monitoring/use-syslog-for-monitoring/syslog-field-descriptions/traffic-log-fields
// https://docs.paloaltonetworks.com/pan-os/10-0/pan-os-admin/monitoring/use-syslog-for-monitoring/syslog-field-descriptions/traffic-log-fields
// https://docs.paloaltonetworks.com/pan-os/9-1/pan-os-admin/monitoring/use-syslog-for-monitoring/syslog-field-descriptions/system-log-fields
// These documented shorter layouts parse without a warning. The 60-column
// Traffic record matches no documented layout and keeps the warning.
from {content: "1,2026/05/29 15:30:01,000700000042,TRAFFIC,end,,2026/05/29 15:30:00,192.0.2.190,198.51.100.190,,,allow-legacy,,,ssl,,,,,,,,,,50800,443,,,,tcp,allow,,,,,,,,,8301,,,,,,,,,,,,,fw-example-1,,,,,,,,,,,,,,,,,,,,,,"},
  {content: "1,2026/05/29 15:30:01,000700000042,TRAFFIC,end,,2026/05/29 15:30:00,192.0.2.190,198.51.100.190,,,allow-legacy,,,ssl,,,,,,,,,,50800,443,,,,tcp,allow,,,,,,,,,8302,,,,,,,,,,,,,fw-example-1,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,"},
  {content: "1,2026/05/29 15:30:01,000700000042,TRAFFIC,end,,2026/05/29 15:30:00,192.0.2.190,198.51.100.190,,,allow-legacy,,,ssl,,,,,,,,,,50800,443,,,,tcp,allow,,,,,,,,,8303,,,,,,,,,,,,,fw-example-1,,,,,,,"},
  {content: "1,2026/05/29 15:31:01,000700000042,SYSTEM,general,,2026/05/29 15:31:00,,general,,,,general,informational,Example message from PAN-OS 9.1,8304,,,,,,,fw-example-1"}
paloalto::parse content, parsed
this = {
  type: parsed.type,
  sequence_number: parsed.sequence_number,
  device_name: parsed.device_name,
  description: parsed.description?,
}
