paloalto::parse content, parsed
this = {
  parser: @name,
  type: parsed.type,
  sequence_number: parsed.sequence_number?,
  user: parsed.user? else parsed.source_user?,
  source: parsed.source_ip? else parsed.source_address?,
  virtual_system: parsed.virtual_system?,
  severity: parsed.severity?,
  device_name: parsed.device_name?,
  object_name: parsed.object_name?,
  evidence: parsed.evidence?,
  result: parsed.result?,
  before_change_detail: parsed.before_change_detail?,
  after_change_detail: parsed.after_change_detail?,
  link_switches: parsed.link_switches?,
  application_category: parsed.application_category?,
  excess_values: parsed.excess_values?,
  http_status_code: parsed.http_status_code?,
  url_category_list: parsed.url_category_list?,
}
