  {content: r"1,2026/05/29 11:00:01,000700000042,CORRELATION,,,2026/05/29 11:00:00,192.0.2.50,example\bob,vsys1,compromised-host,high,,,,,,fw-example-1,,Example Beacon Detection,6100,Host contacted an example command-and-control domain 12 times."},
  {content: r#"1,2026/05/29 11:00:01,000700000042,CONFIG,0,,2026/05/29 11:00:00,192.0.2.60,vsys1,edit,admin-example,Web,Succeeded, vsys vsys1 address example-host,example-host { ip-netmask 192.0.2.61; },"example-host { description ""edge, primary""; ip-netmask 192.0.2.62; }",7003,0x0,,,,,,fw-example-1,,,,"#},
