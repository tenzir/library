  {content: "1,2026/05/29 11:00:01,000700000042,TRAFFIC,end,,2026/05/29 11:00:00,192.0.2.70,198.51.100.70,,,allow-sdwan,,,web-browsing,,,,,,,,,,50000,443,,,,tcp,allow,900,,,,,,,,7006,,,,,,,tcp-fin,,,,,,fw-example-1,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,general-internet,,,,,,,,,,,,,,,,,,,,,,,,future-a,future-b"},
