from {
  carrier: "keep",
  payload: ",2026/05/29 10:11:12,007200001234,TRAFFIC,end,,2026/05/29 10:11:11,192.0.2.10,198.51.100.20,,,allow-web,alice,,ssl,,trust,untrust,,,,,42,,54321,443,,,,tcp,allow,1000,,,,,,,,,,US,DE,,,,aged-out,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,adv-src,adv-dst",
}
paloalto::parse payload, into=payload
this = {
  carrier: carrier,
  type: payload.type,
  subtype: payload.threat_content_type,
  time: payload.generated_time,
  serial_number: payload.serial_number,
  source_address: payload.source_address,
  destination_address: payload.destination_address,
}
