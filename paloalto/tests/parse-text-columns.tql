// Synthetic PAN-OS records. The column order follows the Traffic and Threat
// syslog field descriptions for PAN-OS 11.1; every value is invented.
// https://docs.paloaltonetworks.com/ngfw/administration/monitoring/use-syslog-for-monitoring/syslog-field-descriptions/traffic-log-fields
// https://docs.paloaltonetworks.com/ngfw/administration/monitoring/use-syslog-for-monitoring/syslog-field-descriptions/threat-log-fields
// Text columns keep their exact text: rule names and users with leading zeros,
// a numeric-looking filename, and a user agent with `;`. Times with and without
// an offset become times, and the Unix epoch placeholder becomes null.
from {content: "1,2026/05/29 10:11:12,000700000042,TRAFFIC,end,,2026/05/29 10:11:11,192.0.2.10,198.51.100.20,,,00123,0815,,ssl,,,,,,,,,,54321,443,,,,tcp,allow,1000,,,,,,,,42,,,,,,,,,,,,,02,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,2026-05-29T10:11:11.123+02:00,,,,,,,,,,,,,,,,,,,,,,,,,,,"},
  {content: "1,2026/05/29 10:12:12,000700000042,THREAT,file,,2026/05/29 10:12:11,192.0.2.11,203.0.113.20,,,0042,,,web-browsing,,,,,,,,,,,,,,,tcp,alert,20260529,Example Test File(52000),any,low,,,,,,,,,,,,Mozilla/5.0 (X11; Linux x86_64; rv:120.0),,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,1969-12-31T16:00:00.000-08:00,,,,,,,,,,,,,,,"}
paloalto::parse content, parsed
this = {
  serial_number: parsed.serial_number,
  generated_time: parsed.generated_time,
  high_resolution_timestamp: parsed.high_resolution_timestamp,
  source_address: parsed.source_address,
  source_port: parsed.source_port,
  rule_name: parsed.rule_name,
  source_user: parsed.source_user?,
  device_name: parsed.device_name?,
  bytes: parsed.bytes?,
  sequence_number: parsed.sequence_number,
  url_filename: parsed.url_filename?,
  threat_id: parsed.threat_id?,
  user_agent: parsed.user_agent?,
}
