// Synthetic PAN-OS Config records; every value is invented. The column order
// follows the PAN-OS 11.1 Config log fields, with and without the change
// details as in the Strata Logging Service Config syslog example.
// https://docs.paloaltonetworks.com/ngfw/administration/monitoring/use-syslog-for-monitoring/syslog-field-descriptions/config-log-fields
// https://docs.paloaltonetworks.com/strata-logging-service/log-reference/common-logs/common-config-log/common-config-syslog-fields
// Commands on a configuration path become Entity Management activities with
// the configuration before and after the change. A submitted commit has no
// entity, so its required entity stays missing, and its outcome is unknown.
from {content: r#"1,2026/05/29 11:00:01,000700000042,CONFIG,0,,2026/05/29 11:00:00,192.0.2.60,vsys1,edit,admin-example,Web,Succeeded, vsys vsys1 address example-host,example-host { ip-netmask 192.0.2.61; },"example-host { description ""edge, primary""; ip-netmask 192.0.2.62; }",7003,0x0,,,,,,fw-example-1,,,,"#},
  {content: "1,2026/05/29 11:00:01,000700000042,CONFIG,0,,2026/05/29 11:00:00,192.0.2.60,vsys1,commit,admin-example,Web,Submitted,,7004,0x0,,,,,,fw-example-1,,,,"},
  {content: "1,2026/05/29 21:00:01,000700000042,CONFIG,0,,2026/05/29 21:00:00,192.0.2.160,vsys1,delete,admin-example,Web,Failed, vsys vsys1 rulebase security rules example-allow-web,example-allow-web { action allow; },,8001,0x0,,,,,,fw-example-1,,,,"},
  {content: "1,2026/05/29 21:00:01,000700000042,CONFIG,0,,2026/05/29 21:00:00,admin-ws.example.test,vsys1,set,admin-example,CLI,Succeeded, mgt-config users example-operator,8002,0x0,,,,,,fw-example-1,,Ticket EXAMPLE-42,,"}
paloalto::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
this = {
  class_uid: class_uid,
  activity_id: activity_id,
  activity_name: activity_name,
  status_id: status_id,
  status_detail: status_detail?,
  entity: entity?,
  entity_result: entity_result?,
  actor: actor?,
  src_endpoint: src_endpoint?,
  comment: comment?,
  unmapped: unmapped,
}
drop_null_fields
