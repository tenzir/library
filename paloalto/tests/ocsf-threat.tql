// Synthetic PAN-OS Threat records; every value is invented. The column order
// follows the PAN-OS 11.1 Threat log fields.
// https://docs.paloaltonetworks.com/ngfw/administration/monitoring/use-syslog-for-monitoring/syslog-field-descriptions/threat-log-fields
// The URL/Filename column is a file for file-based subtypes and a URL
// otherwise. The Threat/Content Name splits into the signature name and ID.
from {content: "1,2026/05/29 16:00:01,000700000042,THREAT,virus,,2026/05/29 16:00:00,192.0.2.120,198.51.100.120,,,threat-policy,,,web-browsing,,,,,,,,,,50400,80,,,,tcp,reset-both,20260529.exe,Example Virus Signature(400001),any,medium,server-to-client,7601,,,,,,,,,,,pe,,,,,,,,,,,,fw-example-1,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,"},
  {content: "1,2026/05/29 16:00:01,000700000042,THREAT,wildfire,,2026/05/29 16:00:00,192.0.2.120,198.51.100.120,,,threat-policy,,,web-browsing,,,,,,,,,,50400,80,,,,tcp,allow,invoice-example.pdf,Example Wildfire File(52020),malicious,high,server-to-client,7602,,,,,,,0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef,wildfire.example.test,,,pdf,,,,,,7602000,,,,,,fw-example-1,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,"},
  {content: "1,2026/05/29 16:00:01,000700000042,THREAT,vulnerability,,2026/05/29 16:00:00,192.0.2.120,198.51.100.120,,,threat-policy,,,web-browsing,,,,,,,,,,50400,80,,,,tcp,alert,www.example.test/cgi-bin/example.cgi,Example Remote Code Execution Vulnerability(91000),code-execution,critical,client-to-server,7603,,,,,,,,,,,,,,,,,,,,,,,fw-example-1,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,"}
paloalto::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
this = {sequence: metadata.sequence, severity_id: severity_id, is_alert: is_alert, finding_info: finding_info, file: evidences[0].file?, url: evidences[0].url?, threat_id: unmapped.threat_id}
drop_null_fields
