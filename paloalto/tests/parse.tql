---
pre-compare: sort
---

// Synthetic PAN-OS CSV payloads; every value is invented. The column order
// follows the PAN-OS 11.1 Traffic, URL Filtering, Threat, GlobalProtect, and
// Audit log fields; the last payload has an unsupported layout.
// https://docs.paloaltonetworks.com/ngfw/administration/monitoring/use-syslog-for-monitoring/syslog-field-descriptions
from_file env("TENZIR_INPUT") {
  read_lines
}
content = move line
paloalto::parse content, parsed
if parsed != null {
  drop content
}
this = {...parsed, content: content?}
sort content?, type?, threat_content_type?, event_id?
this = {
  type: type?,
  subtype: threat_content_type?,
  src: source_address?,
  dst: destination_address?,
  app: application?,
  action: action?,
  url: url_filename?,
  threat_id: threat_id?,
  source_country: source_country?,
  source_location: source_location?,
  event_id: event_id?,
  stage: stage?,
  auth_method: authentication_method?,
  description: description?,
  status: status?,
  cli_command: cli_command?,
  severity: severity?,
  content: content?,
}
