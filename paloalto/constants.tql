// Package-wide OCSF constants shared across PAN-OS event mappers.

let $status_ids = {
  success: 1,
  succeeded: 1,
  failure: 2,
  failed: 2,
  error: 2,
}

let $severity_ids = {
  informational: 1,
  info: 1,
  low: 2,
  medium: 3,
  high: 4,
  critical: 5,
}

// PAN-OS actions across the Traffic, Threat, and URL Filtering logs. Traffic
// logs spell some actions with a space, such as `reset both`.
// Source: https://docs.paloaltonetworks.com/ngfw/administration/monitoring/use-syslog-for-monitoring/syslog-field-descriptions/traffic-log-fields
// Source: https://docs.paloaltonetworks.com/ngfw/administration/monitoring/use-syslog-for-monitoring/syslog-field-descriptions/threat-log-fields
// Source: https://docs.paloaltonetworks.com/ngfw/administration/monitoring/use-syslog-for-monitoring/syslog-field-descriptions/url-filtering-log-fields
let $action_ids = {
  allow: 1,
  continue: 1,
  override: 1,
  alert: 3,
  block: 2,
  deny: 2,
  "block-ip": 2,
  "block-url": 2,
  "block-continue": 2,
  "block-override": 2,
  "override-lockout": 2,
  drop: 2,
  "drop-packet": 2,
  "drop-all-packets": 2,
  "drop ICMP": 2,
  "drop-icmp": 2,
  "random-drop": 2,
  "reset-client": 2,
  "reset-server": 2,
  "reset-both": 2,
  "reset client": 2,
  "reset server": 2,
  "reset both": 2,
}

let $disposition_ids = {
  allow: 1,
  continue: 1,
  override: 1,
  alert: 19,
  block: 2,
  deny: 2,
  "block-ip": 2,
  "block-url": 2,
  // The firewall shows a response page, which the user can confirm or unlock
  // with a password.
  "block-continue": 23,
  "block-override": 23,
  "override-lockout": 2,
  drop: 6,
  "drop-packet": 6,
  "drop-all-packets": 6,
  "drop ICMP": 6,
  "drop-icmp": 6,
  "random-drop": 6,
  "reset-client": 21,
  "reset-server": 21,
  "reset-both": 21,
  "reset client": 21,
  "reset server": 21,
  "reset both": 21,
}
