// PAN-OS writes every column as text. Parse with `raw=true`, so that values
// such as the rule name `00123` or a numeric-looking filename stay text instead
// of a guessed integer or time. Only `"` quotes a value, and quoted values
// double embedded quotes. A `;` inside a value, such as in a user agent or a
// configuration detail, is text and not a list separator. The conversions
// below type the columns that are genuinely numbers, addresses, or times.
let $integer_fields = [
  "app_flap_count",
  "bytes",
  "bytes_received",
  "bytes_sent",
  "certificate_size",
  "common_name_length",
  "destination_port",
  "elapsed_time",
  "factor_number",
  "issuer_common_name_length",
  "login_duration",
  "maximum_encapsulation",
  "nat_destination_port",
  "nat_source_port",
  "packets",
  "packets_received",
  "packets_sent",
  "repeat_count",
  "response_time",
  "root_common_name_length",
  "sctp_chunks",
  "sctp_chunks_received",
  "sctp_chunks_sent",
  "sequence_number",
  "sessions_closed",
  "sessions_created",
  "sni_length",
  "source_port",
  "tcp_retransit_cnt_c2s",
  "tcp_retransit_cnt_s2c",
  "tcp_rtt_c2s",
  "tcp_rtt_s2c",
  "tcp_zero_window_cnt_c2s",
  "tcp_zero_window_cnt_s2c",
  "time_out_threshold",
  "timeout",
  "total_n_ooseq_c2s",
  "total_n_ooseq_s2c",
]
let $ip_fields = [
  "destination_address",
  "end_user_ip_address",
  "ipv6_source_address",
  "nat_destination_ip",
  "nat_source_ip",
  "private_ip",
  "private_ipv6",
  "public_ip",
  "public_ipv6",
  "remote_user_ip",
  "source_address",
  "source_ip",
]
let $time_fields = [
  "certificate_end_date",
  "certificate_start_date",
  "generate_time",
  "generated_time",
  "high_res_timestamp",
  "high_resolution_timestamp",
  "parent_start_time",
  "receive_time",
  "start_time",
  "time_logged",
]

let $typed_fields = [...$integer_fields, ...$ip_fields, ...$time_fields]

// A `timezone` argument is either a UTC offset, such as `+01:00` or `-0500`,
// or an IANA time zone name.
let $timezone_offset = $timezone.replace_regex(r"^([+-][0-9]{2}):?([0-9]{2})$", r"\1\2") if $timezone.match_regex(r"^[+-][0-9]{2}:?[0-9]{2}$") else null
let $timezone_name = null if $timezone.match_regex(r"^[+-][0-9]{2}:?[0-9]{2}$") else $timezone

// Keep the payload and its number of columns, which tells documented older
// layouts apart, before writing the result: the input and output can be the
// same field. Quoted values and the SD-WAN brace list count as one column.
$paloalto = {
  input: $input,
  columns: $input.replace_regex(r#",\{[^{}"]*\}(,|$)"#, r#",x\1"#).replace_regex(r#""([^"]|"")*""#, "x").split(",").length(),
}
// Older PAN-OS versions write fewer columns than later versions, and their
// columns are a prefix of the later ones. For most log types, records with
// exactly the documented numbers of columns fill the missing columns with null
// without a warning; all other short records keep the warning. Traffic
// records gained columns in many releases, such as 115 before PAN-OS 11.1
// added the flow type, so every Traffic record with at least the 65 columns
// of PAN-OS 8.1 counts as an older layout.
// Source: https://docs.paloaltonetworks.com/pan-os/8-1/pan-os-admin/monitoring/use-syslog-for-monitoring/syslog-field-descriptions
// (archived, for example at https://web.archive.org/web/2019/https://docs.paloaltonetworks.com/pan-os/8-1/pan-os-admin/monitoring/use-syslog-for-monitoring/syslog-field-descriptions/traffic-log-fields)
// Source: https://docs.paloaltonetworks.com/pan-os/9-1/pan-os-admin/monitoring/use-syslog-for-monitoring/syslog-field-descriptions
// Source: https://docs.paloaltonetworks.com/pan-os/10-0/pan-os-admin/monitoring/use-syslog-for-monitoring/syslog-field-descriptions
match $paloalto.input.split(",", max=5)[3]? {
  "TRAFFIC" => {
    // SD-WAN link details are a brace-enclosed list that PAN-OS writes
    // without quotes, although it contains commas. Quote a brace group that
    // spans whole columns, so that it stays one column and the tail keeps its
    // positions. Other values with braces stay as they are.
    $paloalto.input = $paloalto.input.replace_regex(r#",(\{[^{}"]*\})(,|$)"#, r#","\1"\2"#)
    if $paloalto.columns >= 65 {
      $paloalto = $paloalto.input.parse_csv(header=$traffic_fields, raw=true, list_separator="", quotes="\"", auto_expand=true, auto_fill=true)
    } else {
      $paloalto = $paloalto.input.parse_csv(header=$traffic_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
    }
    @name = "paloalto.traffic"
  }
  "GLOBALPROTECT" => {
    if $paloalto.columns in [42] {
      $paloalto = $paloalto.input.parse_csv(header=$globalprotect_fields, raw=true, list_separator="", quotes="\"", auto_expand=true, auto_fill=true)
    } else {
      $paloalto = $paloalto.input.parse_csv(header=$globalprotect_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
    }
    @name = "paloalto.globalprotect"
  }
  "URL-FILTERING" => {
    if $paloalto.columns >= 125 {
      $paloalto = $paloalto.input.parse_csv(header=$url_filtering_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
    } else {
      if $paloalto.columns in [75, 79, 111] {
        $paloalto = $paloalto.input.parse_csv(header=$url_filtering_fields_without_response, raw=true, list_separator="", quotes="\"", auto_expand=true, auto_fill=true)
      } else {
        $paloalto = $paloalto.input.parse_csv(header=$url_filtering_fields_without_response, raw=true, list_separator="", quotes="\"", auto_expand=true)
      }
    }
    @name = "paloalto.url-filtering"
  }
  "DATA-FILTERING" => {
    if $paloalto.columns in [75, 79, 111] {
      $paloalto = $paloalto.input.parse_csv(header=$data_filtering_fields, raw=true, list_separator="", quotes="\"", auto_expand=true, auto_fill=true)
    } else {
      $paloalto = $paloalto.input.parse_csv(header=$data_filtering_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
    }
    @name = "paloalto.data-filtering"
  }
  "THREAT" => {
    match $paloalto.input.split(",", max=5)[4]? {
      "url" => {
        if $paloalto.columns >= 125 {
          $paloalto = $paloalto.input.parse_csv(header=$url_filtering_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
        } else {
          if $paloalto.columns in [75, 79, 111] {
            $paloalto = $paloalto.input.parse_csv(header=$url_filtering_fields_without_response, raw=true, list_separator="", quotes="\"", auto_expand=true, auto_fill=true)
          } else {
            $paloalto = $paloalto.input.parse_csv(header=$url_filtering_fields_without_response, raw=true, list_separator="", quotes="\"", auto_expand=true)
          }
        }
        @name = "paloalto.url-filtering"
      }
      "data" | "dlp" | "dlp-non-file" => {
        if $paloalto.columns in [75, 79, 111] {
          $paloalto = $paloalto.input.parse_csv(header=$data_filtering_fields, raw=true, list_separator="", quotes="\"", auto_expand=true, auto_fill=true)
        } else {
          $paloalto = $paloalto.input.parse_csv(header=$data_filtering_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
        }
        @name = "paloalto.data-filtering"
      }
      _ => {
        if $paloalto.columns in [75, 79, 111] {
          $paloalto = $paloalto.input.parse_csv(header=$threat_fields, raw=true, list_separator="", quotes="\"", auto_expand=true, auto_fill=true)
        } else {
          $paloalto = $paloalto.input.parse_csv(header=$threat_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
        }
        @name = "paloalto.threat"
      }
    }
  }
  // PAN-OS 11 writes `HIPMATCH`; the hyphenated spelling is the documented
  // log name.
  "HIP-MATCH" | "HIPMATCH" => {
    if $paloalto.columns in [29, 31] {
      $paloalto = $paloalto.input.parse_csv(header=$hip_match_fields, raw=true, list_separator="", quotes="\"", auto_expand=true, auto_fill=true)
    } else {
      $paloalto = $paloalto.input.parse_csv(header=$hip_match_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
    }
    @name = "paloalto.hip-match"
  }
  "IPTAG" | "IP-TAGS" => {
    $paloalto = $paloalto.input.parse_csv(header=$ip_tag_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
    @name = "paloalto.ip-tags"
  }
  "USERID" | "USER-ID" => {
    $paloalto = $paloalto.input.parse_csv(header=$user_id_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
    @name = "paloalto.user-id"
  }
  "DECRYPTION" => {
    if $paloalto.columns in [91] {
      $paloalto = $paloalto.input.parse_csv(header=$decryption_fields, raw=true, list_separator="", quotes="\"", auto_expand=true, auto_fill=true)
    } else {
      $paloalto = $paloalto.input.parse_csv(header=$decryption_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
    }
    @name = "paloalto.decryption"
  }
  // Tunnel Inspection records carry their lifecycle stage, `START` or `END`,
  // in the type column.
  "TUNNEL" | "TUNNEL-INSPECTION" | "START" | "END" => {
    if $paloalto.columns in [69, 75] {
      $paloalto = $paloalto.input.parse_csv(header=$tunnel_inspection_fields, raw=true, list_separator="", quotes="\"", auto_expand=true, auto_fill=true)
    } else {
      $paloalto = $paloalto.input.parse_csv(header=$tunnel_inspection_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
    }
    @name = "paloalto.tunnel-inspection"
  }
  "SCTP" => {
    if $paloalto.columns in [64] {
      $paloalto = $paloalto.input.parse_csv(header=$sctp_fields, raw=true, list_separator="", quotes="\"", auto_expand=true, auto_fill=true)
    } else {
      $paloalto = $paloalto.input.parse_csv(header=$sctp_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
    }
    @name = "paloalto.sctp"
  }
  "CONFIG" => {
    // Without change details, the hexadecimal action flags follow the
    // sequence number directly after the configuration path.
    $paloalto.parsed = $paloalto.input.parse_csv(header=$config_fields_without_details, raw=true, list_separator="", quotes="\"", auto_expand=true)
    if not (($paloalto.parsed.sequence_number?.match_regex("^[0-9]+$") else false) and ($paloalto.parsed.action_flags?.match_regex("^0x[0-9A-Fa-f]+$") else false)) {
      if $paloalto.columns in [26] {
        $paloalto = $paloalto.input.parse_csv(header=$config_fields, raw=true, list_separator="", quotes="\"", auto_expand=true, auto_fill=true)
      } else {
        $paloalto = $paloalto.input.parse_csv(header=$config_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
      }
    } else {
      $paloalto = $paloalto.parsed
    }
    @name = "paloalto.config"
  }
  // Older PAN-OS versions write `AUTH` instead of `AUTHENTICATION`.
  "AUTHENTICATION" | "AUTH" => {
    if $paloalto.columns in [33, 46] {
      $paloalto = $paloalto.input.parse_csv(header=$authentication_fields, raw=true, list_separator="", quotes="\"", auto_expand=true, auto_fill=true)
    } else {
      $paloalto = $paloalto.input.parse_csv(header=$authentication_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
    }
    @name = "paloalto.authentication"
  }
  "SYSTEM" => {
    if $paloalto.columns in [23] {
      $paloalto = $paloalto.input.parse_csv(header=$system_fields, raw=true, list_separator="", quotes="\"", auto_expand=true, auto_fill=true)
    } else {
      $paloalto = $paloalto.input.parse_csv(header=$system_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
    }
    @name = "paloalto.system"
  }
  "CORRELATION" => {
    $paloalto = $paloalto.input.parse_csv(header=$correlated_events_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
    @name = "paloalto.correlation"
  }
  "GTP" => {
    if $paloalto.columns in [83, 84] {
      $paloalto = $paloalto.input.parse_csv(header=$gtp_fields, raw=true, list_separator="", quotes="\"", auto_expand=true, auto_fill=true)
    } else {
      $paloalto = $paloalto.input.parse_csv(header=$gtp_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
    }
    @name = "paloalto.gtp"
  }
  "AUDIT" => {
    $paloalto = $paloalto.input.parse_csv(header=$audit_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
    @name = "paloalto.audit"
  }
  // Audit records start with the serial number and carry their type in the
  // third column, in upper or lower case.
  _ if $paloalto.input.split(",", max=5)[2]? in ["AUDIT", "audit"] => {
    $paloalto = $paloalto.input.parse_csv(header=$audit_fields, raw=true, list_separator="", quotes="\"", auto_expand=true)
    @name = "paloalto.audit"
  }
  // Keep the payload of an unsupported layout instead of guessing its columns.
  _ => {
    $paloalto = null
    @name = "paloalto.unknown"
  }
}

if $paloalto != null {
  $paloalto = $paloalto.drop_matching("^future_use")
  // Nonempty values beyond the documented columns, such as from a newer
  // PAN-OS version, stay in order in `excess_values`.
  if $paloalto.has("unnamed1") {
    $paloalto.excess_values = $paloalto.entries().where(field => field.key.match_regex("^unnamed[0-9]+$") and field.value != null).map(field => field.value)
    $paloalto = $paloalto.drop_matching("^unnamed[0-9]+$")
    if $paloalto.excess_values.length() == 0 {
      drop $paloalto.excess_values
    }
  }
  // A quoted empty column, `""`, is as absent as an empty one. Some layouts
  // pad empty numeric columns with spaces.
  $paloalto = collect_record($paloalto.entries().map(field => [
    field.key,
    (null if field.value.trim() == "" else field.value.trim()) if field.key in $typed_fields else (null if field.value == "" else field.value),
  ]))
  // PAN-OS writes times as `2026/05/29 10:11:11` without a zone, or with an
  // offset as in `2026-05-29T10:11:11.123+02:00`. A time without a zone is in
  // the `timezone` argument, else in the offset of the high-resolution
  // timestamp, else in UTC. The Unix epoch placeholder of a missing
  // high-resolution timestamp has no meaningful offset. Rounding to
  // microseconds undoes the nanosecond error with which `time` parses
  // milliseconds, such as `.120` as `.119999999`, in Tenzir 6.23 and
  // 7.0.0-rc.6. Remove the rounding once every supported version parses
  // times exactly (Linear TNZ-2181).
  $paloalto._offset = $timezone_offset
  if $timezone == null and not ($paloalto.high_resolution_timestamp? else $paloalto.high_res_timestamp?).match_regex("^19(69|70)-") {
    $paloalto._offset = ($paloalto.high_resolution_timestamp? else $paloalto.high_res_timestamp?).replace_regex(r"^.*([+-][0-9]{2}):?([0-9]{2})$", r"\1\2") if ($paloalto.high_resolution_timestamp? else $paloalto.high_res_timestamp?).match_regex(r"[+-][0-9]{2}:?[0-9]{2}$") else ("+0000" if ($paloalto.high_resolution_timestamp? else $paloalto.high_res_timestamp?).match_regex("Z$") else null)
  }
  $paloalto = collect_record($paloalto.entries().map(field => [
    field.key,
    field.value.int() if field.key in $integer_fields else (
      field.value.ip() if field.key in $ip_fields else (
        (
          (
            (field.value + " " + $paloalto._offset).parse_time("%Y/%m/%d %H:%M:%S %z") if $paloalto._offset != null else field.value.parse_time("%Y/%m/%d %H:%M:%S", timezone=$timezone_name)
          ) if field.value.match_regex("^[0-9]{4}/") else field.value.time().round(1us)
        ) if field.key in $time_fields else field.value
      )
    ),
  ]))
  drop $paloalto._offset
  // Managed devices that lack a high-resolution time write the Unix epoch,
  // such as `1969-12-31T16:00:00.000-08:00`, which means absent.
  $paloalto = collect_record($paloalto.entries().map(field => [
    field.key,
    null if field.key in $time_fields and field.value <= 1970-01-01T00:00:00Z else field.value,
  ]))
}
