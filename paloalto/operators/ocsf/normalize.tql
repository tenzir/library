---
description: |
  Normalizes a Syslog event carrying a Palo Alto Networks PAN-OS CSV payload to
  OCSF 1.9.

  The input is the record produced by `read_syslog` or `parse_syslog`. The
  operator parses its `content` field, maps the PAN-OS record, and preserves the
  CSV payload as provenance. Unsupported input becomes an OCSF Base Event.
args:
  positional:
    - name: syslog
      description: The Syslog event carrying the PAN-OS CSV payload.
      type: field
      default: this
  named:
    - name: into
      description: The field that receives the OCSF event.
      type: field
      default: this
    - name: timezone
      description: |
        The time zone of PAN-OS times without a zone, as an IANA name such as
        `Europe/Berlin` or as a UTC offset such as `+01:00`. Without it, the
        offset of the record's high-resolution timestamp applies, else UTC.
      type: string
      default: null
---

// Snapshot the carrier before writing so in-place and separate-field calls use
// the same normalization path.
$into = {source: $syslog}
paloalto::parse $into.source.content, $into.paloalto, timezone=$timezone
if $into.paloalto == null {
  $into.paloalto = {}
}
// The Syslog timestamp is when the carrier sent the message. Use it only as a
// last resort for the event time, and only when it is a complete time: an
// RFC 3164 timestamp has neither a year nor a zone. It also stays in
// `unmapped.timestamp`, distinct from the PAN-OS generated and receive times.
if type_kind($into.source.timestamp?) == "time" {
  $into.paloalto.time = $into.source.timestamp
}
paloalto::ocsf::map $into.paloalto, $into.ocsf

$into.ocsf.raw_data = $into.source.content
$into.ocsf.raw_data_size = $into.source.content?.length_bytes()
drop $into.source.content?
$into.ocsf.unmapped = {
  ...$into.source,
  ...$into.ocsf.unmapped,
}
$into = move $into.ocsf
