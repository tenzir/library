---
description: Palo Alto Networks PAN-OS URL Filtering record -> OCSF HTTP Activity.
args:
  positional:
    - name: event
      description: The structured source event.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

paloalto::ocsf::base $event, $ocsf
@name = "ocsf.http_activity"

let $activities = {
  CONNECT: 1,
  DELETE: 2,
  GET: 3,
  HEAD: 4,
  OPTIONS: 5,
  POST: 6,
  PUT: 7,
  TRACE: 8,
  PATCH: 9,
}

$ocsf.category_uid = 4
$ocsf.class_uid = 4002
drop $ocsf.activity_name?
// PAN-OS writes the HTTP method in lowercase. An extension method that has no
// OCSF activity becomes `Other`; a record without method stays `Unknown`.
$ocsf.activity_id = $activities[$event.http_method?.to_upper()]? else (0 if $event.http_method? == null else 99)
if $ocsf.activity_id == 99 {
  $ocsf.activity_name = $event.http_method.to_upper()
}
$ocsf.type_uid = 400200 + $ocsf.activity_id
$ocsf.metadata.profiles = ["security_control"]
$ocsf.app_name = move $event.application?
paloalto::ocsf::endpoints $event, $ocsf
paloalto::ocsf::connection_info $event, $ocsf
$ocsf.http_request = {
  http_method: (move $event.http_method?).to_upper(),
  user_agent: move $event.user_agent?,
  referrer: move $event.referer?,
}
// The X-Forwarded-For value can be a comma-separated chain of addresses. Keep
// the addresses; when the chain also holds other tokens, such as `unknown`,
// the original text stays in `unmapped`.
$ocsf._xff = ($event.x_forwarded_for? else $event.xff_address?).split(",").map(token => token.trim()).where(token => token != "")
if $ocsf._xff.length() > 0 {
  $ocsf.http_request.x_forwarded_for = $ocsf._xff.where(token => token.match_regex("^[0-9A-Fa-f:.]+$")).map(token => token.ip()).where(address => address != null)
  if $ocsf.http_request.x_forwarded_for.length() == $ocsf._xff.length() {
    if $event.x_forwarded_for? != null {
      drop $event.x_forwarded_for
    } else {
      drop $event.xff_address
    }
  }
  if $ocsf.http_request.x_forwarded_for.length() == 0 {
    drop $ocsf.http_request.x_forwarded_for
  }
}
drop $ocsf._xff
if $event.url_filename? != null {
  $ocsf.http_request.url = {url_string: move $event.url_filename}
  // PAN-OS writes the PAN-DB category and, in newer versions, the full list of
  // categories including a risk rating. Translate the categories that have an
  // OCSF equivalent; other categories become `Other` with their PAN-DB label.
  // The PAN-DB labels also stay in `unmapped`.
  $ocsf._categories = ($event.url_category_list? else $event.category?).split(",").map(label => label.trim()).where(label => label != "" and label not in paloalto::$url_risk_ratings).map(label => {
    id: paloalto::$url_category_ids[label]? else 99,
    caption: null if paloalto::$url_category_ids.has(label) else label,
  }).distinct()
  if $ocsf._categories.length() > 0 {
    $ocsf.http_request.url.category_ids = $ocsf._categories.map(category => category.id)
    // `ocsf_derive` fills in the captions of the translated categories.
    if $ocsf._categories.where(category => category.caption != null).length() > 0 {
      $ocsf.http_request.url.categories = $ocsf._categories.map(category => category.caption)
    }
  }
  drop $ocsf._categories
}
if ($event.rule_name? else $event.rule_uuid?) != null {
  $ocsf.firewall_rule = {
    name: move $event.rule_name?,
    uid: move $event.rule_uuid?,
  }
}
paloalto::ocsf::action $event, $ocsf
// A blocked request failed. PAN-OS does not record the HTTP response, so an
// allowed request has an unknown outcome.
$ocsf.status_id = 2 if $ocsf.action_id? == 2 else 0
if $ocsf.action_id? != null {
  $ocsf.is_alert = $ocsf.action_id == 3
}

