---
description: Palo Alto Networks PAN-OS Traffic record -> OCSF Network Activity.
args:
  positional:
    - name: event
      description: The structured source event.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

paloalto::ocsf::base $event, $ocsf
@name = "ocsf.network_activity"

let $activities = {
  start: 1,
  end: 2,
  drop: 4,
  deny: 5,
}
let $action_ids = {
  allow: 1,
  deny: 2,
  drop: 2,
  block: 2,
  "reset-client": 2,
  "reset-server": 2,
  "reset-both": 2,
}
let $disposition_ids = {
  allow: 1,
  deny: 2,
  block: 2,
  drop: 6,
  "reset-client": 21,
  "reset-server": 21,
  "reset-both": 21,
}

$ocsf.category_uid = 4
$ocsf.class_uid = 4001
$ocsf.activity_id = $activities[$event.threat_content_type?]? else 6
$ocsf.type_uid = 400100 + ($activities[$event.threat_content_type?]? else 6)
drop $ocsf.activity_name?
$ocsf.status_id = 1
$ocsf.metadata.profiles = ["security_control"]
$ocsf.initiator_id = 1
$ocsf.app_name = move $event.application?
$ocsf.src_endpoint = {
  ip: move $event.source_address?,
  port: move $event.source_port?,
  zone: move $event.source_zone?,
  interface_name: move $event.inbound_interface?,
  hostname: move $event.source_hostname?,
  mac: move $event.source_mac_address?,
  proxy_endpoint: {
    ip: move $event.nat_source_ip?,
    port: move $event.nat_source_port?,
  },
}
$ocsf.dst_endpoint = {
  ip: move $event.destination_address?,
  port: move $event.destination_port?,
  zone: move $event.destination_zone?,
  interface_name: move $event.outbound_interface?,
  hostname: move $event.destination_hostname?,
  mac: move $event.destination_mac_address?,
  proxy_endpoint: {
    ip: move $event.nat_destination_ip?,
    port: move $event.nat_destination_port?,
  },
}
$ocsf.connection_info = {
  direction_id: 0,
  protocol_name: move $event.protocol?,
  uid: (move $event.session_id?).string(),
}
if $ocsf.src_endpoint.proxy_endpoint.ip? == null and $ocsf.src_endpoint.proxy_endpoint.port? == null {
  drop $ocsf.src_endpoint.proxy_endpoint
}
if $ocsf.dst_endpoint.proxy_endpoint.ip? == null and $ocsf.dst_endpoint.proxy_endpoint.port? == null {
  drop $ocsf.dst_endpoint.proxy_endpoint
}
if $event.bytes? != null or $event.bytes_sent? != null or $event.bytes_received? != null or $event.packets? != null or $event.packets_sent? != null or $event.packets_received? != null {
  $ocsf.cumulative_traffic = {
    bytes: move $event.bytes?,
    bytes_out: move $event.bytes_sent?,
    bytes_in: move $event.bytes_received?,
    packets: move $event.packets?,
    packets_out: move $event.packets_sent?,
    packets_in: move $event.packets_received?,
    start_time: move $event.start_time?,
    end_time: $ocsf.time,
  }
}
if $event.rule_name? != null or $event.rule_uuid? != null {
  $ocsf.firewall_rule = {
    name: move $event.rule_name?,
    uid: move $event.rule_uuid?,
  }
}
if $action_ids[$event.action?]? != null {
  $ocsf.action_id = $action_ids[$event.action?]?
  $ocsf.disposition_id = $disposition_ids[$event.action?]?
  drop $event.action
}

drop $event.type?
drop $event.threat_content_type?
