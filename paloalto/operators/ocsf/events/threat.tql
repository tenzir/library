---
description: Palo Alto Networks PAN-OS Threat record -> OCSF Detection Finding.
args:
  positional:
    - name: event
      description: The structured source event.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

paloalto::ocsf::base $event, $ocsf
@name = "ocsf.detection_finding"


$ocsf.category_uid = 2
$ocsf.class_uid = 2004
$ocsf.activity_id = 1
$ocsf.type_uid = 200401
drop $ocsf.activity_name?
$ocsf.metadata.profiles = ["security_control"]
$ocsf.is_alert = true
$ocsf.finding_info = {
  uid: ($event.sequence_number? else $event.threat_id?).string(),
  title: $event.url_filename? else $event.threat_content_type? else "PAN-OS threat",
  analytic: {
    type_id: 1,
    uid: $event.threat_id?.string(),
    name: $event.threat_content_type?,
  },
}
$ocsf.evidences = [drop_null_fields({
  src_endpoint: {
    ip: move $event.source_address?,
    port: move $event.source_port?,
    zone: move $event.source_zone?,
    interface_name: move $event.inbound_interface?,
    hostname: move $event.source_hostname?,
    mac: move $event.source_mac_address?,
  },
  dst_endpoint: {
    ip: move $event.destination_address?,
    port: move $event.destination_port?,
    zone: move $event.destination_zone?,
    interface_name: move $event.outbound_interface?,
    hostname: move $event.destination_hostname?,
    mac: move $event.destination_mac_address?,
  },
  connection_info: {
    direction_id: 0,
    protocol_name: move $event.ip_protocol?,
    uid: (move $event.session_id?).string(),
  },
  url: {
    url_string: move $event.url_filename?,
  },
  actor: {
    user: {
      name: move $event.source_user?,
    },
  },
})]
$ocsf.policy = {
  name: move $event.rule_name?,
  uid: move $event.rule_uuid?,
}
if paloalto::$action_ids[$event.action?]? != null {
  $ocsf.action_id = paloalto::$action_ids[$event.action?]?
  $ocsf.disposition_id = paloalto::$disposition_ids[$event.action?]?
  drop $event.action
}

drop $event.type?
drop $event.threat_content_type?
drop $event.threat_id?
drop $event.sequence_number?
