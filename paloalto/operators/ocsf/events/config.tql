---
description: Palo Alto Networks PAN-OS Config record -> OCSF Entity Management.
args:
  positional:
    - name: event
      description: The structured source event.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// The firewall writes a Config record when an administrator changes the
// configuration or commits it. The configuration path identifies the changed
// object, and the change details hold its configuration before and after.
// Source: https://docs.paloaltonetworks.com/ngfw/administration/monitoring/use-syslog-for-monitoring/syslog-field-descriptions/config-log-fields
paloalto::ocsf::base $event, $ocsf
@name = "ocsf.entity_management"

let $activities = {
  add: 1,
  clone: 1,
  create: 1,
  "multi-clone": 1,
  edit: 3,
  override: 3,
  rename: 3,
  set: 3,
  delete: 4,
  "move": 5,
}

// A submitted commit only queues the commit job; its outcome follows later.
let $status_ids = {
  succeeded: 1,
  failed: 2,
  unauthorized: 2,
  submitted: 0,
}

$ocsf.category_uid = 3
$ocsf.class_uid = 3004
drop $ocsf.activity_name?
$ocsf.activity_id = $activities[$event.command?]? else (0 if $event.command? == null else 99)
if $ocsf.activity_id == 99 {
  $ocsf.activity_name = $event.command
}
$ocsf.type_uid = 300400 + $ocsf.activity_id
if $activities[$event.command?]? != null {
  drop $event.command
}
// PAN-OS writes the configuration path with a leading space. A commit has no
// path and thus no entity.
if ($event.configuration_path?.trim() else "") != "" {
  $ocsf.entity = {
    name: $event.configuration_path.trim(),
    data: move $event.before_change_detail?,
  }
  if $event.after_change_detail? != null {
    $ocsf.entity_result = {
      name: $event.configuration_path.trim(),
      data: move $event.after_change_detail,
    }
  }
  drop $event.configuration_path
}
if $event.admin? != null {
  $ocsf.actor = {
    user: {name: move $event.admin},
    app_name: move $event.client?,
  }
}
// The host is the address or name of the administrator's client.
if $event.host?.match_regex("^[0-9A-Fa-f:.]+$") {
  $ocsf.src_endpoint = {ip: (move $event.host).ip()}
} else if $event.host? != null {
  $ocsf.src_endpoint = {hostname: move $event.host}
}
$ocsf.comment = move $event.audit_comment?
if $status_ids[$event.result?.to_lower()]? != null {
  $ocsf.status_id = $status_ids[$event.result.to_lower()]
  $ocsf.status_detail = move $event.result
}
