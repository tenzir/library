---
description: Palo Alto Networks GlobalProtect authentication -> OCSF Authentication.
args:
  positional:
    - name: event
      description: The active mapping scope.
      type: field
---

paloalto::ocsf::base $event
@name = "ocsf.authentication"

let $protocol_ids = {
  ntlm: 1,
  kerberos: 2,
  digest: 3,
  openid: 4,
  saml: 5,
  oauth: 6,
  pap: 7,
  chap: 8,
  eap: 9,
  radius: 10,
  basic: 11,
  ldap: 12,
}
let $status_ids = {
  success: 1,
  succeeded: 1,
  failure: 2,
  failed: 2,
  error: 2,
}

$event.ocsf.category_uid = 3
$event.ocsf.class_uid = 3002
$event.ocsf.activity_id = 1
$event.ocsf.type_uid = 300201
drop $event.ocsf.activity_name?
$event.ocsf.metadata.profiles = ["security_control"]
$event.ocsf.user = {
  name: move $event.paloalto.source_user?,
}
$event.ocsf.src_endpoint = {
  ip: move $event.paloalto.public_ip?,
  hostname: move $event.paloalto.machine_name?,
}
if ($event.paloalto.gateway? else $event.paloalto.portal?) != null {
  $event.ocsf.dst_endpoint = {
    hostname: $event.paloalto.gateway? else $event.paloalto.portal?,
  }
  drop $event.paloalto.gateway?
  drop $event.paloalto.portal?
}
$event.ocsf.service = {
  name: "GlobalProtect",
}
$event.ocsf.is_remote = true
$event.ocsf.status_detail = move $event.paloalto.reason? else move $event.paloalto.error? else $event.ocsf.message?
if $protocol_ids[$event.paloalto.authentication_method?]? != null {
  $event.ocsf.auth_protocol_id = $protocol_ids[$event.paloalto.authentication_method?]?
  drop $event.paloalto.authentication_method
} else if $event.paloalto.authentication_method? != null {
  $event.ocsf.auth_protocol_id = 99
  $event.ocsf.auth_protocol = move $event.paloalto.authentication_method
}
if $status_ids[$event.paloalto.status?]? != null {
  $event.ocsf.status_id = $status_ids[$event.paloalto.status?]?
  drop $event.paloalto.status
}

drop $event.paloalto.type?
drop $event.paloalto.threat_content_type?
drop $event.paloalto.event_id?
drop $event.paloalto.stage?
