---
description: Palo Alto Networks PAN-OS Audit record -> OCSF Base Event.
args:
  positional:
    - name: event
      description: The active mapping scope.
      type: field
---

paloalto::ocsf::base $event

let $status_ids = {
  success: 1,
  succeeded: 1,
  failure: 2,
  failed: 2,
  error: 2,
}

$event.ocsf.activity_id = 99
$event.ocsf.activity_name = move $event.paloalto.event_id? else "Audit"
$event.ocsf.type_uid = 99
$event.ocsf.message = move $event.paloalto.cli_command?
if $status_ids[$event.paloalto.severity?]? != null {
  $event.ocsf.status_id = $status_ids[$event.paloalto.severity?]?
  drop $event.paloalto.severity
}

drop $event.paloalto.threat_content_type?
