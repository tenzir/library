---
description: Maps PAN-OS endpoint locations, distinguishing codes from country names.
args:
  positional:
    - name: event
      type: field
      description: The structured source event.
    - name: ocsf
      type: field
      description: The OCSF output field.
---

if $event.source_country?.length_chars() == 2 {
  $ocsf.src_endpoint.location.country = (move $event.source_country).to_upper()
} else if $event.source_location?.length_chars() == 2 {
  $ocsf.src_endpoint.location.country = (move $event.source_location).to_upper()
}
if $event.destination_country?.length_chars() == 2 {
  $ocsf.dst_endpoint.location.country = (move $event.destination_country).to_upper()
} else if $event.destination_location?.length_chars() == 2 {
  $ocsf.dst_endpoint.location.country = (move $event.destination_location).to_upper()
}
