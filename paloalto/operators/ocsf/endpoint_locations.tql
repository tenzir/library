---
description: |
  Maps PAN-OS endpoint locations that are ISO country codes to OCSF.

  PAN-OS writes either a two-letter country code, a country name, or the
  address range of an internal region. Only a country code identifies an OCSF
  location; other values stay in `unmapped`.
args:
  positional:
    - name: event
      type: field
      description: The structured source event.
    - name: ocsf
      type: field
      description: The OCSF output field.
---

$ocsf._source_location = $event.source_country? else $event.source_location?
$ocsf._destination_location = $event.destination_country? else $event.destination_location?
if $ocsf._source_location.match_regex("^[A-Za-z]{2}$") {
  $ocsf.src_endpoint.location = {country: $ocsf._source_location.to_upper()}
  // Structured inputs can carry both aliases. Consume only equal aliases.
  drop $event.source_country?
  if $event.source_location? == $ocsf._source_location {
    drop $event.source_location?
  }
}
if $ocsf._destination_location.match_regex("^[A-Za-z]{2}$") {
  $ocsf.dst_endpoint.location = {country: $ocsf._destination_location.to_upper()}
  drop $event.destination_country?
  if $event.destination_location? == $ocsf._destination_location {
    drop $event.destination_location?
  }
}
drop $ocsf._source_location, $ocsf._destination_location
