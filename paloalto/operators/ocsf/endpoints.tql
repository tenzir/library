---
description: |
  Maps the PAN-OS source and destination of a session to OCSF network
  endpoints.

  A translated address becomes the endpoint's `proxy_endpoint` only when
  PAN-OS names one. PAN-OS writes `0.0.0.0` or `::` and port `0` when a session
  has no NAT; the mapper consumes these placeholders without creating an
  endpoint. Users and locations become objects only when PAN-OS names them.
args:
  positional:
    - name: event
      type: field
      description: The structured source event.
    - name: ocsf
      type: field
      description: The OCSF output field.
---

$ocsf.src_endpoint = {
  ip: move $event.source_address?,
  port: move $event.source_port?,
  zone: move $event.source_zone?,
  interface_name: move $event.inbound_interface?,
  hostname: move $event.source_hostname?,
  mac: move $event.source_mac_address?,
}
$ocsf.dst_endpoint = {
  ip: move $event.destination_address?,
  port: move $event.destination_port?,
  zone: move $event.destination_zone?,
  interface_name: move $event.outbound_interface?,
  hostname: move $event.destination_hostname?,
  mac: move $event.destination_mac_address?,
}
// User-ID names users as `domain\user`, which OCSF splits into domain and
// name. A user principal name, such as `user@example.test`, stays the name.
if $event.source_user? != null {
  $ocsf.src_endpoint.owner = {
    name: $event.source_user.split("\\", max=1)[1]? else $event.source_user,
    domain: $event.source_user.split("\\", max=1)[0] if $event.source_user.split("\\", max=1).length() == 2 else null,
  }
  drop $event.source_user
}
if $event.destination_user? != null {
  $ocsf.dst_endpoint.owner = {
    name: $event.destination_user.split("\\", max=1)[1]? else $event.destination_user,
    domain: $event.destination_user.split("\\", max=1)[0] if $event.destination_user.split("\\", max=1).length() == 2 else null,
  }
  drop $event.destination_user
}
if $event.nat_source_ip? != null and $event.nat_source_ip not in [0.0.0.0, ::] {
  $ocsf.src_endpoint.proxy_endpoint = {
    ip: move $event.nat_source_ip,
    port: move $event.nat_source_port?,
  }
} else if ($event.nat_source_port? else 0) == 0 {
  drop $event.nat_source_ip?, $event.nat_source_port?
}
if $event.nat_destination_ip? != null and $event.nat_destination_ip not in [0.0.0.0, ::] {
  $ocsf.dst_endpoint.proxy_endpoint = {
    ip: move $event.nat_destination_ip,
    port: move $event.nat_destination_port?,
  }
} else if ($event.nat_destination_port? else 0) == 0 {
  drop $event.nat_destination_ip?, $event.nat_destination_port?
}
paloalto::ocsf::endpoint_locations $event, $ocsf
// Device-ID identifies the operating system of an endpoint, and VM monitoring
// the virtual machine.
if $event.source_device_os_family? != null {
  $ocsf.src_endpoint.os = {
    name: $event.source_device_os_family,
    version: move $event.source_device_os_version?,
    type_id: paloalto::$os_type_ids[$event.source_device_os_family.to_lower()]? else 0,
  }
  drop $event.source_device_os_family
}
if $event.destination_device_os_family? != null {
  $ocsf.dst_endpoint.os = {
    name: $event.destination_device_os_family,
    version: move $event.destination_device_os_version?,
    type_id: paloalto::$os_type_ids[$event.destination_device_os_family.to_lower()]? else 0,
  }
  drop $event.destination_device_os_family
}
if paloalto::$endpoint_type_ids[$event.source_device_category?.to_lower()]? != null {
  $ocsf.src_endpoint.type_id = paloalto::$endpoint_type_ids[$event.source_device_category.to_lower()]
  drop $event.source_device_category
}
if paloalto::$endpoint_type_ids[$event.destination_device_category?.to_lower()]? != null {
  $ocsf.dst_endpoint.type_id = paloalto::$endpoint_type_ids[$event.destination_device_category.to_lower()]
  drop $event.destination_device_category
}
if $event.source_vm_uuid? != null {
  $ocsf.src_endpoint.instance_uid = move $event.source_vm_uuid
}
if $event.destination_vm_uuid? != null {
  $ocsf.dst_endpoint.instance_uid = move $event.destination_vm_uuid
}
