---
description: Palo Alto Networks PAN-OS parsed record -> OCSF Base Event.
args:
  positional:
    - name: event
      description: The structured source event.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.base_event"


$ocsf = {
  time: $event.generated_time? else $event.generate_time? else $event.receive_time? else $event.time?,
  category_uid: 0,
  class_uid: 0,
  activity_id: 0,
  severity_id: paloalto::$severity_ids[$event.severity?]? else 1,
  type_uid: 0,
  status_id: 0,
  message: move $event.description?,
  metadata: {
    version: "1.9.0",
    log_name: "PAN-OS",
    log_provider: "Palo Alto Networks",
    log_source: "PAN-OS Syslog",
    // The high-resolution timestamp is when the management plane received
    // the record, like the receive time, but with milliseconds and offset.
    logged_time: $event.high_resolution_timestamp? else $event.high_res_timestamp? else $event.receive_time?,
    sequence: int(move $event.sequence_number?),
    product: {
      name: "PAN-OS",
      vendor_name: "Palo Alto Networks",
      uid: ($event.serial_number? else $event.serial?).string(),
    },
  },
}

// PAN-OS numbers the records of each log type per device, so the serial
// number, log type, and sequence number identify a record.
$ocsf._log_type = $event.type? else $event.threat_content_type?
if $ocsf.metadata.product.uid != null and $ocsf._log_type != null and $ocsf.metadata.sequence != null {
  $ocsf.metadata.uid = f"{$ocsf.metadata.product.uid}:{$ocsf._log_type}:{$ocsf.metadata.sequence}"
}
drop $ocsf._log_type
// The device name is the hostname of the firewall that logged the record.
if ($event.device_name? else $ocsf.metadata.product.uid) != null {
  $ocsf.metadata.reporter = {
    hostname: move $event.device_name?,
    uid: $ocsf.metadata.product.uid,
  }
}

if ($event.type? else $event.threat_content_type?) != null {
  $ocsf.activity_id = 99
  $ocsf.activity_name = $event.type? else $event.threat_content_type?
  $ocsf.type_uid = 99
}
if paloalto::$severity_ids[$event.severity?]? != null {
  drop $event.severity
}

drop $event.generated_time?
drop $event.generate_time?
drop $event.time?
drop $event.receive_time?
drop $event.high_resolution_timestamp?, $event.high_res_timestamp?
drop $event.serial_number?
drop $event.serial?
