---
description: |
  Maps a structured Palo Alto Networks PAN-OS event to OCSF 1.9.

  Traffic records become Network Activity, URL Filtering records become HTTP
  Activity, threat records become Detection Finding, and supported
  GlobalProtect login records become Authentication. Other parsed families
  become OCSF Base Event records.

  The mapper consumes translated fields and puts the remaining PAN-OS record in
  `unmapped`. It does not choose provenance.
args:
  positional:
    - name: event
      description: The structured PAN-OS event to map.
      type: field
      default: this
  named:
    - name: into
      description: The field that receives the OCSF event.
      type: field
      default: this
---

// Snapshot the source before writing so in-place and separate-field calls use
// the same mapping path.
$into = {
  paloalto: $event,
  ocsf: {},
}

match $into.paloalto.type? {
  "TRAFFIC" => {
    paloalto::ocsf::events::traffic $into
  }
  "URL-FILTERING" => {
    paloalto::ocsf::events::url_filtering $into
  }
  "THREAT" => {
    match $into.paloalto.threat_content_type? {
      "url" => {
        paloalto::ocsf::events::url_filtering $into
      }
      "data" | "dlp" | "dlp-non-file" => {
        paloalto::ocsf::base $into
      }
      _ => {
        paloalto::ocsf::events::threat $into
      }
    }
  }
  "GLOBALPROTECT" => {
    if $into.paloalto.event_id? == "gateway-auth" or $into.paloalto.stage? == "login" {
      paloalto::ocsf::events::globalprotect_authentication $into
    } else {
      paloalto::ocsf::base $into
    }
  }
  _ if $into.paloalto.threat_content_type? == "AUDIT" => {
    paloalto::ocsf::events::audit $into
  }
  _ => {
    paloalto::ocsf::base $into
  }
}

$into = {
  ...$into.ocsf,
  unmapped: $into.paloalto,
}
