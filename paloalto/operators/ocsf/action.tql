---
description: |
  Maps a PAN-OS action to the OCSF security control action and disposition.

  Several PAN-OS actions map to the same action and disposition, such as
  `reset-client` and `reset-both`, so the PAN-OS spelling of every action stays
  in `unmapped.action`. An unknown action becomes `Other` with its PAN-OS
  spelling in `action` and `disposition`.
args:
  positional:
    - name: event
      description: The structured source event.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

if paloalto::$action_ids[$event.action?]? != null {
  $ocsf.action_id = paloalto::$action_ids[$event.action]
  $ocsf.disposition_id = paloalto::$disposition_ids[$event.action]
} else if $event.action? != null {
  $ocsf.action_id = 99
  $ocsf.action = $event.action
  $ocsf.disposition_id = 99
  $ocsf.disposition = $event.action
}
