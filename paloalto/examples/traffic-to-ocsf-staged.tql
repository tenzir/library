---
name: Map PAN-OS Traffic CSV to OCSF in stages
description: |
  Parses one PAN-OS Traffic record, maps it to OCSF Network Activity, and adds
  the original CSV payload as provenance. The source user `example\alice`
  becomes the actor with domain `example` and name `alice`.
---

from {
  message: r"1,2026/05/29 10:11:12,000700000042,TRAFFIC,end,,2026/05/29 10:11:11,192.0.2.10,198.51.100.20,,,allow-web,example\alice,,ssl,,trust,untrust,,,,,4242,,54321,443,,,,tcp,allow,1000,400,600,12,,5,,,7001,,US,DE,,,,tcp-fin,,,,,,fw-example-1,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,",
}
// The firewall writes its local time without a zone. Set `timezone` only when
// that time isn't UTC and the records lack `high_resolution_timestamp`, whose
// offset the parser uses otherwise.
paloalto::parse message, event, timezone="Europe/Zurich"
paloalto::ocsf::map event, ocsf
this = {
  ...ocsf,
  raw_data: message,
  raw_data_size: message.length_bytes(),
}
this = ocsf_derive(this)
