---
name: Map PAN-OS Traffic CSV to OCSF in stages
description: |
  Parses one PAN-OS Traffic record, maps it to OCSF Network Activity, and adds
  the original CSV payload as provenance.
---

from {
  message: ",2026/05/29 10:11:12,007200001234,TRAFFIC,end,,2026/05/29 10:11:11,192.0.2.10,198.51.100.20,,,allow-web,alice,,ssl,,trust,untrust,,,,,42,,54321,443,,,,tcp,allow,1000,,,,,,,,,,US,DE,,,,aged-out,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,adv-src,adv-dst",
}
paloalto::parse message, event
paloalto::ocsf::map event, ocsf
this = {
  ...ocsf,
  raw_data: message,
  raw_data_size: message.length_bytes(),
}
ocsf_derive
