---
description: |
  Reduces the volume of HarfangLab OCSF events for a SIEM. The operator
  summarizes Network Activity and HTTP Activity, and deduplicates process
  launches and Module Activity, with `harfanglab::ocsf::summarize_network`,
  `harfanglab::ocsf::summarize_http`,
  `harfanglab::ocsf::deduplicate_processes`, and
  `harfanglab::ocsf::deduplicate_modules`. Set `network`, `http`,
  `processes`, or `modules` to `false` to pass that class through unchanged.
  Events of all other classes, such as findings, API activity, DNS activity,
  and authentications, pass through unchanged.
args:
  named:
    - name: network_window
      type: duration
      default: 5min
      description: Width of the Network Activity summary windows.
    - name: http_window
      type: duration
      default: 5min
      description: Width of the HTTP Activity summary windows.
    - name: process_window
      type: duration
      default: 1h
      description: Width of the process launch deduplication windows.
    - name: module_window
      type: duration
      default: 1h
      description: Width of the Module Activity deduplication windows.
    - name: network
      type: bool
      default: true
      description: Summarize Network Activity.
    - name: http
      type: bool
      default: true
      description: Summarize HTTP Activity.
    - name: processes
      type: bool
      default: true
      description: Deduplicate process launches.
    - name: modules
      type: bool
      default: true
      description: Deduplicate Module Activity.
---

if $network and class_uid == 4001 {
  harfanglab::ocsf::summarize_network window=$network_window
} else if $http and class_uid == 4002 {
  harfanglab::ocsf::summarize_http window=$http_window
} else if $processes and class_uid == 1007 {
  harfanglab::ocsf::deduplicate_processes window=$process_window
} else if $modules and class_uid == 1005 {
  harfanglab::ocsf::deduplicate_modules window=$module_window
}
