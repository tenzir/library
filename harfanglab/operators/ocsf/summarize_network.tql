---
description: |
  Summarizes HarfangLab Network Activity (`class_uid` 4001) into one event per
  window, host, remote IP address, service port, protocol, and direction.
  Listen events (`activity_id` 7) get summaries per bind address and port.
  Events of other classes pass through unchanged.

  Each summary is a Network Activity event with the OCSF aggregation
  attributes: `count` holds the number of connections, `start_time` and
  `end_time` the times of the first and last one, `duration` the time between
  them, and `time` equals `start_time`. All times are epoch milliseconds, like
  HarfangLab's.

  HarfangLab describes every connection from the endpoint's point of view:
  `src_endpoint` is the local end and `dst_endpoint` the remote end. The
  service port is therefore `src_endpoint.port` for inbound connections and
  `dst_endpoint.port` otherwise, and the summary keeps it there. The client
  port and the local IP address appear only if all connections of the summary
  had the same one, so the summary of a single connection keeps both.

  Windows close on the wall clock every `window`, and every summary covers at
  most one `window` of event time. The package description explains the
  windowing and how a SIEM counts summaries.
args:
  named:
    - name: window
      type: duration
      default: 5min
      description: Width of the summary windows, in processing and event time.
---

if class_uid == 4001 {
  _host = device?.agent_list?[0]?.uid? else device?.hostname?
  _bucket = from_epoch(time? * 1ms).floor($window)
  _inbound = connection_info?.direction_id? == 1
  _service_port = src_endpoint?.port? if _inbound else dst_endpoint?.port?
  _client_port = dst_endpoint?.port? if _inbound else src_endpoint?.port?
  window size=$window {
    // All keys are scalars. The device, metadata, and agent records belong to
    // the host and come from the first event of a summary.
    summarize _host, _bucket, activity_id?, activity_name?, type_uid?,
      severity_id?, severity?, status_id?, status?,
      connection_info?.direction_id?, connection_info?.direction?,
      connection_info?.protocol_name?, connection_info?.protocol_num?,
      connection_info?.protocol_ver_id?,
      src_endpoint?.name?, src_endpoint?.uid?, src_endpoint?.hostname?,
      dst_endpoint?.name?, dst_endpoint?.uid?, dst_endpoint?.hostname?,
      dst_endpoint?.ip?, _inbound, _service_port,
      count=count(), start_time=min(time?), end_time=max(time?),
      _device=first(device?), _metadata=first(metadata?),
      _src_agents=first(src_endpoint?.agent_list?),
      _dst_agents=first(dst_endpoint?.agent_list?),
      _local_ips=distinct(src_endpoint?.ip?),
      _local_ip_count=count(src_endpoint?.ip?),
      _client_port_min=min(_client_port), _client_port_max=max(_client_port),
      _client_port_count=count(_client_port)
    _client_port = (_client_port_min
      if _client_port_min == _client_port_max
        and _client_port_count == count else null)
    _local_ip = (_local_ips[0]
      if _local_ips.length() == 1 and _local_ip_count == count else null)
    this = {
      activity_id: activity_id,
      activity_name: activity_name,
      category_uid: 4,
      class_uid: 4001,
      metadata: _metadata,
      severity: severity,
      severity_id: severity_id,
      status: status,
      status_id: status_id,
      time: start_time,
      start_time: start_time,
      end_time: end_time,
      duration: end_time - start_time,
      count: count,
      type_uid: type_uid,
      device: _device,
      connection_info: connection_info,
      src_endpoint: {
        ...src_endpoint,
        agent_list: _src_agents,
        ip: _local_ip,
        port: _service_port if _inbound else _client_port,
      },
      dst_endpoint: {
        ...dst_endpoint,
        agent_list: _dst_agents,
        port: _client_port if _inbound else _service_port,
      },
    }
    drop_null_fields
  }
}
