---
description: |
  Deduplicates HarfangLab process launches (`class_uid` 1007, `activity_id` 1)
  per window, host, executable, command line, user, and parent executable.
  Other Process Activity, such as raw socket creation (`activity_id` 99), and
  events of other classes pass through unchanged.

  The first launch of every key in a window passes through immediately and
  unchanged, with all its identifiers. Further launches of the key in the same
  window are repeats: when the window closes, one summary event stands for
  them, and a key without repeats gets no summary. A summary is a Process
  Activity event with the OCSF aggregation attributes: `count` holds the
  number of repeats, which excludes the first launch, `start_time` and
  `end_time` the times of the first and last repeat, `duration` the time
  between them, and `time` equals `start_time`. All times are epoch
  milliseconds, like HarfangLab's. Only summaries have `count`.

  The key covers the executable's path, name, size, type, hashes, and
  signature, the user, the integrity level, and the parent's executable and
  integrity level. Attributes that differ between repeats don't appear in a
  summary: the UID and lineage, and the parent's UID, command line, and
  parent. The process ID, creation time, and parent process ID appear only if
  all repeats had the same one. A summary without a process ID therefore
  lacks all of `pid`, `uid`, and `cpid`, which OCSF requires at least one of.

  Windows close on the wall clock every `window`, and every summary covers at
  most one `window` of event time. The package description explains the
  windowing and how a SIEM counts summaries.
args:
  named:
    - name: window
      type: duration
      default: 1h
      description: Width of the deduplication windows, in processing and event
        time.
---

if class_uid == 1007 and activity_id == 1 {
  _host = device?.agent_list?[0]?.uid? else device?.hostname?
  _bucket = from_epoch(time? * 1ms).floor($window)
  _hashes = process?.file?.hashes?
  _md5 = _hashes.where(h => h.algorithm_id == 1).first().value?
  _sha1 = _hashes.where(h => h.algorithm_id == 2).first().value?
  _sha256 = _hashes.where(h => h.algorithm_id == 3).first().value?
  window size=$window {
    // A digest of the keys keeps the state of the first-occurrence check
    // small. The summary below groups by the same keys.
    _key = hash_md5([_host, _bucket, process?.name?, process?.cmd_line?,
      process?.user?.name?, process?.user?.uid?,
      process?.integrity_id?, process?.file?.path?, process?.file?.size?,
      _sha256, _sha1, _md5, process?.file?.signature?.state_id?,
      process?.file?.signature?.certificate?.serial_number?,
      process?.parent_process?.file?.path?, process?.parent_process?.name?,
      process?.parent_process?.integrity_id?])
    summarize _key, _seen=count(), options={mode: "cumulative"}
    if _seen == 1 {
      drop _key, _host, _bucket, _hashes, _md5, _sha1, _sha256, _seen
    } else {
      // All keys are scalars. The records come from the first repeat: the
      // device and metadata belong to the host, the user and signature to
      // the keyed user name, UID, hashes, and certificate.
      summarize _host, _bucket, activity_id?, activity_name?, type_uid?,
        severity_id?, severity?,
        process?.name?, process?.cmd_line?,
        process?.user?.name?, process?.user?.uid?,
        process?.integrity?, process?.integrity_id?,
        process?.file?.path?, process?.file?.name?, process?.file?.size?,
        process?.file?.type?, process?.file?.type_id?, _md5, _sha1, _sha256,
        process?.file?.signature?.state_id?,
        process?.file?.signature?.certificate?.serial_number?,
        process?.parent_process?.name?, process?.parent_process?.file?.path?,
        process?.parent_process?.file?.name?,
        process?.parent_process?.file?.type?,
        process?.parent_process?.file?.type_id?,
        process?.parent_process?.integrity?,
        process?.parent_process?.integrity_id?,
        count=count(), start_time=min(time?), end_time=max(time?),
        _device=first(device?), _metadata=first(metadata?),
        _user=first(process?.user?),
        _signature=first(process?.file?.signature?),
        _pid_min=min(process?.pid?), _pid_max=max(process?.pid?),
        _pid_count=count(process?.pid?),
        _created_min=min(process?.created_time?),
        _created_max=max(process?.created_time?),
        _created_count=count(process?.created_time?),
        _ppid_min=min(process?.parent_process?.pid?),
        _ppid_max=max(process?.parent_process?.pid?),
        _ppid_count=count(process?.parent_process?.pid?)
      _hashes = [
        {algorithm_id: 2, value: _sha1, algorithm: "SHA-1"}
          if _sha1 != null else null,
        {algorithm_id: 3, value: _sha256, algorithm: "SHA-256"}
          if _sha256 != null else null,
        {algorithm_id: 1, value: _md5, algorithm: "MD5"}
          if _md5 != null else null,
      ].where(h => h != null)
      this = {
        activity_id: activity_id,
        activity_name: activity_name,
        category_uid: 1,
        class_uid: 1007,
        metadata: _metadata,
        severity: severity,
        severity_id: severity_id,
        time: start_time,
        start_time: start_time,
        end_time: end_time,
        duration: end_time - start_time,
        count: count,
        type_uid: type_uid,
        device: _device,
        process: {
          ...process,
          pid: _pid_min
            if _pid_min == _pid_max and _pid_count == count else null,
          created_time: _created_min
            if _created_min == _created_max and _created_count == count
            else null,
          user: _user,
          file: {
            ...process.file,
            signature: _signature,
            hashes: _hashes if _hashes.length() > 0 else null,
          },
          parent_process: {
            ...process.parent_process,
            pid: _ppid_min
              if _ppid_min == _ppid_max and _ppid_count == count else null,
          },
        },
      }
      drop_null_fields
    }
  }
}
