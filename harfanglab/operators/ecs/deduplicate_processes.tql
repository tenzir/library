---
description: |
  Deduplicates HarfangLab process start documents (`event.category`
  `process` with `event.type` `start` or `creation`) per window, host,
  executable, command line, users and groups, and parent executable. Other
  documents, including process access documents, pass through unchanged.

  The first start of every key in a window passes through immediately and
  unchanged, with all its identifiers. Further starts of the key in the same
  window are repeats: when the window closes, one summary document stands for
  them, and a key without repeats gets no summary. A summary stays an ECS
  process document. `event.start` and `event.end` hold the times of the
  first and last repeat, `event.duration` the time between them in
  nanoseconds, and `@timestamp` equals `event.start`. ECS has no field for
  the number of events that a document stands for, so `tenzir.count` holds
  the number of repeats, which excludes the first start. Only summaries have
  `tenzir.count`.

  The key covers the executable's path, name, hashes, and code signature, the
  effective, real, and saved user and group, and the parent's executable.
  Attributes that differ between repeats don't appear in a summary: the
  entity ID, and the parent's entity ID, command line, and parent. The
  process ID, the parent's process ID, and the working directory appear only
  if all repeats had the same one.

  Windows close on the wall clock every `window`, and every summary covers at
  most one `window` of event time. The package description explains the
  windowing and how a SIEM counts summaries.
args:
  named:
    - name: window
      type: duration
      default: 1h
      description: Width of the deduplication windows, in processing and event
        time.
---

if event.category?.first() == "process" and (
    "start" in event.type or "creation" in event.type) {
  _host = host?.id? else agent?.id? else host?.hostname?
  _time = time(this["@timestamp"]?)
  _bucket = _time.floor($window)
  window size=$window {
    // A digest of the keys keeps the state of the first-occurrence check
    // small. The summary below groups by the same keys.
    _key = hash_md5([_host, _bucket, process?.executable?, process?.name?,
      process?.command_line?, process?.user?.id?, process?.user?.name?,
      process?.real_user?.id?, process?.saved_user?.id?,
      process?.group?.id?, process?.real_group?.id?, process?.saved_group?.id?,
      process?.hash?.sha256?, process?.hash?.sha1?, process?.hash?.md5?,
      process?.code_signature?.valid?, process?.code_signature?.subject_name?,
      process?.parent?.executable?])
    summarize _key, _seen=count(), options={mode: "cumulative"}
    if _seen == 1 {
      drop _key, _host, _time, _bucket, _seen
    } else {
      // All keys are scalars. The records come from the first repeat: the
      // host, agent, and organization belong to the host, the users and
      // groups to their keyed IDs, and the hash, code signature, and PE
      // header to the keyed hashes.
      summarize _host, _bucket, event?.kind?, event?.type?,
        process?.executable?, process?.name?, process?.command_line?,
        process?.user?.id?, process?.user?.name?,
        process?.real_user?.id?, process?.saved_user?.id?,
        process?.group?.id?, process?.real_group?.id?,
        process?.saved_group?.id?,
        process?.hash?.sha256?, process?.hash?.sha1?, process?.hash?.md5?,
        process?.code_signature?.valid?,
        process?.code_signature?.subject_name?,
        process?.parent?.executable?,
        count=count(), start=min(_time), end=max(_time),
        _host_record=first(host?), _agent=first(agent?),
        _organization=first(organization?), _ecs=first(ecs?),
        _user=first(process?.user?), _real_user=first(process?.real_user?),
        _saved_user=first(process?.saved_user?),
        _group=first(process?.group?), _real_group=first(process?.real_group?),
        _saved_group=first(process?.saved_group?),
        _hash=first(process?.hash?),
        _code_signature=first(process?.code_signature?),
        _pe=first(process?.pe?),
        _pid_min=min(process?.pid?), _pid_max=max(process?.pid?),
        _pid_count=count(process?.pid?),
        _ppid_min=min(process?.parent?.pid?),
        _ppid_max=max(process?.parent?.pid?),
        _ppid_count=count(process?.parent?.pid?),
        _directories=distinct(process?.working_directory?),
        _directory_count=count(process?.working_directory?)
      this = {
        "@timestamp": start,
        agent: _agent,
        ecs: _ecs,
        event: {
          category: ["process"],
          kind: event.kind,
          type: event.type,
          start: start,
          end: end,
          duration: int((end - start) / 1ns),
        },
        host: _host_record,
        organization: _organization,
        process: {
          ...process,
          pid: _pid_min
            if _pid_min == _pid_max and _pid_count == count else null,
          user: _user,
          real_user: _real_user,
          saved_user: _saved_user,
          group: _group,
          real_group: _real_group,
          saved_group: _saved_group,
          hash: _hash,
          code_signature: _code_signature,
          pe: _pe,
          working_directory: _directories[0]
            if _directories.length() == 1 and _directory_count == count
            else null,
          parent: {
            ...process.parent,
            pid: _ppid_min
              if _ppid_min == _ppid_max and _ppid_count == count else null,
          },
        },
        tenzir: {count: count},
      }
      drop_null_fields
    }
  }
}
