---
description: |
  Summarizes HarfangLab URL request documents (`event.category` `url`) into
  one document per window, host, URL domain, and HTTP method. Other documents
  pass through unchanged.

  Each summary stays an ECS URL document. `event.start` and `event.end` hold
  the times of the first and last request, `event.duration` the time between
  them in nanoseconds, and `@timestamp` equals `event.start`. ECS has no
  field for the number of events that a document stands for, so
  `tenzir.count` holds the number of requests.

  The URL path, query, and full URL, the user agent, and the requesting
  process appear only if all requests of the summary had the same value, so
  the summary of a single request keeps them. `tenzir.distinct_url_paths`
  holds the number of distinct paths and `tenzir.url_paths` up to 10 of them.

  Windows close on the wall clock every `window`, and every summary covers at
  most one `window` of event time. The package description explains the
  windowing and how a SIEM counts summaries.
args:
  named:
    - name: window
      type: duration
      default: 5min
      description: Width of the summary windows, in processing and event time.
---

if event.category?.first() == "url" {
  _host = host?.id? else agent?.id? else host?.hostname?
  _time = time(this["@timestamp"]?)
  _bucket = _time.floor($window)
  window size=$window {
    // All keys are scalars. The host, agent, and organization records belong
    // to the host and come from the first document of a summary.
    summarize _host, _bucket, event?.kind?, event?.type?, url?.domain?,
      http?.request?.method?, url?.scheme?, url?.port?,
      count=count(), start=min(_time), end=max(_time),
      _host_record=first(host?), _agent=first(agent?),
      _organization=first(organization?), _ecs=first(ecs?),
      // The full URL follows from the keys, the path, and the query, so it
      // needs no set of its own.
      _paths=distinct(url?.path?), _path_count=count(url?.path?),
      _queries=distinct(url?.query?), _query_count=count(url?.query?),
      _url=first(url?.full?), _url_count=count(url?.full?),
      _agents=distinct(user_agent?.original?),
      _agent_count=count(user_agent?.original?),
      _executables=distinct(process?.executable?),
      _executable_count=count(process?.executable?)
    _same_path = _path_count == 0 or (
      _paths.length() == 1 and _path_count == count)
    _same_query = _query_count == 0 or (
      _queries.length() == 1 and _query_count == count)
    _user_agent = (_agents[0]
      if _agents.length() == 1 and _agent_count == count else null)
    _executable = (_executables[0]
      if _executables.length() == 1 and _executable_count == count else null)
    this = {
      "@timestamp": start,
      agent: _agent,
      ecs: _ecs,
      event: {
        category: ["url"],
        kind: event.kind,
        type: event.type,
        start: start,
        end: end,
        duration: int((end - start) / 1ns),
      },
      host: _host_record,
      http: http,
      organization: _organization,
      process: {executable: _executable} if _executable != null else null,
      url: {
        domain: url.domain,
        full: (_url
          if _same_path and _same_query and _url_count == count else null),
        path: _paths[0]? if _same_path else null,
        port: url.port,
        query: _queries[0]? if _same_query else null,
        scheme: url.scheme,
      },
      user_agent: {original: _user_agent} if _user_agent != null else null,
      tenzir: {
        count: count,
        distinct_url_paths: _paths.length(),
        url_paths: _paths.slice(end=10),
      },
    }
    drop_null_fields
  }
}
