---
description: |
  Summarizes HarfangLab network connection documents (`event.category`
  `network`) into one document per window, host, process executable, remote
  IP address, service port, transport, and direction. Other documents,
  including `network_listen` documents, pass through unchanged.

  Each summary stays an ECS network document. `event.start` and `event.end`
  hold the times of the first and last connection, `event.duration` the time
  between them in nanoseconds, and `@timestamp` equals `event.start`. ECS has
  no field for the number of events that a document stands for, so
  `tenzir.count` holds the number of connections.

  HarfangLab's ECS documents name the connecting side in `source` and the
  accepting side in `destination`, so the service port is
  `destination.port` in both directions. The remote end is `source` for
  inbound connections (`network.direction` `in`) and `destination`
  otherwise. The client port, the local IP address, the destination domain,
  and the process user appear only if all connections of the summary had the
  same one, so the summary of a single connection keeps them.

  Windows close on the wall clock every `window`, and every summary covers at
  most one `window` of event time. The package description explains the
  windowing and how a SIEM counts summaries.
args:
  named:
    - name: window
      type: duration
      default: 5min
      description: Width of the summary windows, in processing and event time.
---

if event.category?.first() == "network" {
  _host = host?.id? else agent?.id? else host?.hostname?
  _time = time(this["@timestamp"]?)
  _bucket = _time.floor($window)
  _inbound = network?.direction? == "in"
  _remote_ip = source?.ip? if _inbound else destination?.ip?
  _local_ip = destination?.ip? if _inbound else source?.ip?
  window size=$window {
    // All keys are scalars. The host, agent, and organization records belong
    // to the host and the geo record to the remote IP address, so they come
    // from the first document of a summary.
    summarize _host, _bucket, event?.kind?, event?.type?, process?.executable?,
      network?.direction?, network?.transport?, network?.type?,
      network?.iana_number?, _inbound, _remote_ip, destination?.port?,
      count=count(), start=min(_time), end=max(_time),
      _host_record=first(host?), _agent=first(agent?),
      _organization=first(organization?), _ecs=first(ecs?),
      _remote_geo=first(source?.geo? if _inbound else destination?.geo?),
      _local_ips=distinct(_local_ip), _local_ip_count=count(_local_ip),
      _client_port_min=min(source?.port?), _client_port_max=max(source?.port?),
      _client_port_count=count(source?.port?),
      _domains=distinct(destination?.domain?),
      _domain_count=count(destination?.domain?),
      _users=distinct(process?.user?.name?),
      _user_count=count(process?.user?.name?)
    _local_ip = (_local_ips[0]
      if _local_ips.length() == 1 and _local_ip_count == count else null)
    _client_port = (_client_port_min
      if _client_port_min == _client_port_max
        and _client_port_count == count else null)
    _user = _users[0] if _users.length() == 1 and _user_count == count else null
    this = {
      "@timestamp": start,
      agent: _agent,
      destination: {
        ip: _local_ip if _inbound else _remote_ip,
        geo: null if _inbound else _remote_geo,
        domain: _domains[0]
          if _domains.length() == 1 and _domain_count == count else null,
        port: destination.port,
      },
      ecs: _ecs,
      event: {
        category: ["network"],
        kind: event.kind,
        type: event.type,
        start: start,
        end: end,
        duration: int((end - start) / 1ns),
      },
      host: _host_record,
      network: network,
      organization: _organization,
      process: {
        executable: process.executable,
        user: {name: _user} if _user != null else null,
      },
      source: {
        ip: _remote_ip if _inbound else _local_ip,
        geo: _remote_geo if _inbound else null,
        port: _client_port,
      },
      tenzir: {count: count},
    }
    drop_null_fields
  }
}
