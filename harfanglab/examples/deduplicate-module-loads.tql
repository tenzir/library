---
name: Deduplicate HarfangLab module loads
description: |
  Reports each module that loads on a host once per day, with the number of
  loads and of distinct loading processes.
---

every 1min {
  harfanglab::fetch "https://example.hurukai.io:8443",
    token=secret("harfanglab-api-token")
}
where class_uid == 1005
// The export identifies the loading process by its PID in `actor.process`.
window size=1d {
  summarize device.hostname, module.file.path,
    loads=count(), processes=count_distinct(actor.process.pid),
    first_seen=min(time), last_seen=max(time)
  window_start = $window.start
}
