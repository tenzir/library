---
name: Summarize HarfangLab network activity
description: |
  Condenses HarfangLab Network Activity into one event per host, remote
  endpoint, service port, protocol, and direction every five minutes, for
  destinations that need the traffic picture rather than every connection.
---

every 1min {
  harfanglab::fetch "https://example.hurukai.io:8443",
    token=secret("harfanglab-api-token")
}
where class_uid == 4001
// HarfangLab describes every connection from the endpoint's point of view:
// `src_endpoint` is the local end and `dst_endpoint` the remote end. The
// service port is thus the local port of an inbound connection and the remote
// port of an outbound one.
service_port = src_endpoint.port if connection_info.direction_id == 1 else dst_endpoint.port
window size=5min {
  summarize device.hostname, dst_endpoint.ip, service_port,
    connection_info.protocol_name, connection_info.direction,
    connections=count(), first_seen=min(time), last_seen=max(time)
  window_start = $window.start
}
