---
name: Read HarfangLab events from the S3 export
description: |
  Watches the bucket of the HarfangLab S3 export for new objects and returns
  the OCSF events in them.
---

// The S3 export writes a new gzip-compressed NDJSON object about every minute,
// named after its creation time in milliseconds, for example
// `harfanglab/1767225600000.json.gz`. Objects never change after the upload,
// and reading them doesn't remove events from the Manager. The export also
// writes an empty `test-connection` object, which the glob skips.
from_s3 "s3://example-bucket/harfanglab/*.json.gz", watch=1min {
  decompress_gzip
  read_ndjson
}
