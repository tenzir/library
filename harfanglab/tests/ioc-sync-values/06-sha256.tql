// SHA-256 hashes with prune=true in the same source leave the MD5 hashes
// alone, although both have the HarfangLab type `hash`.
from {sha256: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}
harfanglab::ioc::sync env("HARFANGLAB_URL"), token=env("HARFANGLAB_TOKEN"),
  source="tenzir-test-values", type="sha256", value=sha256, prune=true
sort value
