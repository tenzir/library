// The MD5 run again changes nothing and leaves the SHA-256 hash alone.
from {md5: "d41d8cd98f00b204e9800998ecf8427e"},
  {md5: "098f6bcd4621d373cade4e832627b4f6"}
harfanglab::ioc::sync env("HARFANGLAB_URL"), token=env("HARFANGLAB_TOKEN"),
  source="tenzir-test-values", type="md5", value=md5, prune=true
sort value
