// URLs keep their case. Two spellings of one URL become one IOC, with the
// first spelling in sort order.
from {url: "http://example.net/Tenzir/Path?q=1"},
  {url: "HTTP://EXAMPLE.NET/TENZIR/PATH?Q=1"},
  {url: "https://example.org/tenzir"}
harfanglab::ioc::sync env("HARFANGLAB_URL"), token=env("HARFANGLAB_TOKEN"),
  source="tenzir-test-values", type="url", value=url
sort value
