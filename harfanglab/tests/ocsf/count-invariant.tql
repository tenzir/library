// Every input event is either forwarded or counted in a summary, so
// `represented` equals the number of input events per class: 22 for 4001, 11
// for 4002, 12 for 1007, 9 for 1005, and 1 for each other class.
from_file f"{env("TENZIR_INPUTS")}/ocsf/*.ndjson" {
  read_ndjson
}
harfanglab::ocsf::reduce
summarize class_uid, events=count(), summaries=count(count?),
  represented=sum(count? else 1)
sort class_uid
