// A module load by an unusual process passes through as a first occurrence,
// and so does a process launch from an unusual parent command line. The
// summary of a single repeat keeps its UID, lineage, and parent UID.
from_file f"{env("TENZIR_INPUTS")}/ocsf/repeats.ndjson" {
  read_ndjson
}
harfanglab::ocsf::reduce
select time, class_uid, count?, loader=actor?.process?.file?.path?,
  module=module?.file?.name?, cmd_line=process?.cmd_line?,
  pid=process?.pid?, uid=process?.uid?, lineage=process?.lineage?,
  parent_cmd_line=process?.parent_process?.cmd_line?,
  parent_uid=process?.parent_process?.uid?
sort time
