// Events without `time`, `device`, or `connection_info` still count, without
// warnings. The two events without a time share a summary without times.
from_file f"{env("TENZIR_INPUTS")}/ocsf/edge.ndjson" {
  read_ndjson
}
where class_uid == 4001 and src_endpoint.port? in [51001, 51002, 51003, 51004]
harfanglab::ocsf::summarize_network
select count, time?, device?.hostname?, connection_info?.direction?,
  dst_endpoint, src_endpoint.port?
sort src_endpoint.port?
