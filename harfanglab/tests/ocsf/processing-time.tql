// Processing-time windows keep events that event-time windows would drop as
// late. A one-day window holds this test's input unless it runs exactly at
// midnight UTC.
from_file f"{env("TENZIR_INPUTS")}/ocsf/network.ndjson" {
  read_ndjson
}
harfanglab::ocsf::summarize_network window=1d
select device.hostname, connection_info.direction, dst_endpoint.ip, count,
  start_time, end_time
sort device.hostname, start_time
