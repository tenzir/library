// A connection from three weeks ago gets its own summary instead of being
// dropped or moving the current summary into the past.
from_file f"{env("TENZIR_INPUTS")}/ocsf/edge.ndjson" {
  read_ndjson
}
where class_uid == 4001 and dst_endpoint.ip == 203.0.113.20
harfanglab::ocsf::summarize_network
select time, count, start_time, end_time, duration, src_endpoint.port?
sort time
