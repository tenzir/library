// The raw socket creation (`activity_id` 99) passes through unchanged. The
// first launch of an executable without hashes passes through unchanged, and
// its repeat becomes a summary that keeps the process ID of the only repeat.
from_file f"{env("TENZIR_INPUTS")}/ocsf/edge.ndjson" {
  read_ndjson
}
where class_uid == 1007
harfanglab::ocsf::deduplicate_processes
sort time
