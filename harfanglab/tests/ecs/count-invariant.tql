// Every input document is either forwarded or counted in a summary, so
// `represented` equals the number of input documents per category: 19 for
// network, 11 for url, 14 for process, 11 for library, and 1 for each other
// category.
from_file f"{env("TENZIR_INPUTS")}/ecs/*.ndjson" {
  read_ndjson
}
harfanglab::ecs::reduce
_category = event.category.first()
summarize _category, documents=count(), summaries=count(tenzir?.count?),
  represented=sum(tenzir?.count? else 1)
sort _category
