// A connection from three weeks ago gets its own summary instead of being
// dropped or moving the current summary into the past.
from_file f"{env("TENZIR_INPUTS")}/ecs/edge.ndjson" {
  read_ndjson
}
where event.category.first() == "network" and destination.ip == 203.0.113.20
harfanglab::ecs::summarize_network
select this["@timestamp"], tenzir, event.start, event.end, source.port?
sort this["@timestamp"]
