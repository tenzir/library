// Starts that differ only in the real user stay apart, and libraries without
// hashes deduplicate by path. First occurrences pass through unchanged.
from_file f"{env("TENZIR_INPUTS")}/ecs/edge.ndjson" {
  read_ndjson
}
where event.category.first() in ["process", "library"]
harfanglab::ecs::reduce
sort this["@timestamp"], event.category.first(), tenzir?.count?
