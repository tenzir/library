// Values that aren't valid for the type yield failed results without a
// request and don't stop the run. IP addresses are sent in their canonical
// form.
from {ip: 192.0.2.1},
  {ip: "2001:0DB8:0:0:0:0:0:1"},
  {ip: "not-an-ip"},
  {ip: "10.0.0.0/8"},
  {ip: " "},
  {ip: null}
harfanglab::ioc::sync env("HARFANGLAB_URL"), token=env("HARFANGLAB_TOKEN"),
  source="tenzir-test-ips", type="ip", value=ip
sort value
