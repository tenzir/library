// With on_revoke="delete", a revoked indicator is deleted.
from {domain: "phish.example.com", info: "Phishing landing page", gone: false},
  {domain: "c2.example.net", info: "Command and control, confirmed", gone: true},
  {domain: "drop.example.org", info: null, gone: false}
harfanglab::ioc::sync env("HARFANGLAB_URL"), token=env("HARFANGLAB_TOKEN"),
  source="tenzir-test-iocs", type="domain", value=domain, description=info,
  revoked=gone, on_revoke="delete"
sort value
