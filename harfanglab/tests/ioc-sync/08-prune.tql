// Pruning disables the domains that the input no longer contains, and leaves
// the hashes alone.
from {domain: "drop.example.org", info: null}
harfanglab::ioc::sync env("HARFANGLAB_URL"), token=env("HARFANGLAB_TOKEN"),
  source="tenzir-test-iocs", type="domain", value=domain, description=info,
  prune=true
sort value
