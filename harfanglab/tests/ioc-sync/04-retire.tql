// A revoked and an expired indicator are disabled.
from {domain: "phish.example.com", info: "Phishing landing page", until: 2000-01-01T00:00:00Z, gone: null},
  {domain: "c2.example.net", info: "Command and control, confirmed", until: null, gone: true},
  {domain: "drop.example.org", info: null, until: 2099-01-01T00:00:00Z, gone: false}
harfanglab::ioc::sync env("HARFANGLAB_URL"), token=env("HARFANGLAB_TOKEN"),
  source="tenzir-test-iocs", type="domain", value=domain, description=info,
  expires=until, revoked=gone
sort value
