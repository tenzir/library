// The IOCs in the Manager after the previous tests.
from_http f"{env("HARFANGLAB_URL")}/api/data/threat_intelligence/IOCRule/?limit=100",
  headers={Authorization: f"Token {env("HARFANGLAB_TOKEN")}"} {
  read_json raw=true
}
unroll results
this = results
select type, value, description, comment, global_state, enabled,
  rule_confidence, rule_level_override, rule_effective_level
sort type, value
