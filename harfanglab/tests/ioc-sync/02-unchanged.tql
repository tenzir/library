// The same input again changes nothing. The case of a value doesn't matter.
from {domain: "phish.example.com", info: "Phishing landing page"},
  {domain: "C2.EXAMPLE.NET", info: "Command and control"},
  {domain: "drop.example.org", info: null}
harfanglab::ioc::sync env("HARFANGLAB_URL"), token=env("HARFANGLAB_TOKEN"),
  source="tenzir-test-iocs", type="domain", value=domain, description=info
sort value
