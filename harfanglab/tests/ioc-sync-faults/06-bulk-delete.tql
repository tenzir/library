// A failing bulk deletion yields failed results.
from {domain: "ioc-0.example.net", gone: true}, {domain: "ioc-1.example.net", gone: false}
harfanglab::ioc::sync env("HARFANGLAB_URL"), token=env("HARFANGLAB_TOKEN"),
  source="tenzir-fault-bulk", type="domain", value=domain, revoked=gone,
  on_revoke="delete", label="Tenzir fault test"
sort value
