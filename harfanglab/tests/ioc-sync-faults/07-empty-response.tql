// A bulk state change that succeeds without a response body still yields one
// result per IOC.
from {domain: "ioc-0.example.net", gone: true}, {domain: "ioc-1.example.net", gone: true}
harfanglab::ioc::sync env("HARFANGLAB_URL"), token=env("HARFANGLAB_TOKEN"),
  source="tenzir-fault-empty", type="domain", value=domain, revoked=gone
sort value
