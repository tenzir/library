// The sync enables the disabled IOC, because the feed lists it.
from {domain: "a.example.com"}, {domain: "b.example.com"}, {domain: "d.example.com"}
harfanglab::ioc::sync env("HARFANGLAB_URL"), token=env("HARFANGLAB_TOKEN"),
  source="tenzir-test-demote", type="domain", value=domain, prune=true
sort value
