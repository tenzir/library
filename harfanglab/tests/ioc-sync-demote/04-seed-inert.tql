// An alerting IOC that is disabled, for example by hand in the console.
from_http f"{env("HARFANGLAB_URL")}/mock/seed", body={
  source: "tenzir-test-demote",
  global_state: "alert",
  enabled: false,
  rule_confidence: "strong",
  comment: "tenzir-test-demote: d.example.com",
  rules: [{type: "domain_name", value: "d.example.com"}],
} {
  read_json
}
