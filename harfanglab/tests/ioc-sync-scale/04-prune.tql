// Dropping 1% of the feed with prune=true disables them in one bulk request.
from {}
repeat 10000
enumerate n
where n != floor(n / 100) * 100 + 1
this = {domain: f"ioc-{n}.example.net", info: "Synthetic feed entry, updated" if n == floor(n / 100) * 100 else "Synthetic feed entry"}
harfanglab::ioc::sync env("HARFANGLAB_URL"), token=env("HARFANGLAB_TOKEN"),
  source="tenzir-scale", type="domain", value=domain, description=info, prune=true
summarize action, indicators=count()
sort action
summarize actions=collect({action: action, indicators: indicators})
each {
  from_http f"{env("HARFANGLAB_URL")}/mock/requests" {
    read_json
  }
  this = {actions: $this.actions, requests: this}
}
