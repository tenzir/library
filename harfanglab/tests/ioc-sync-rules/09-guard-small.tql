// Pruning up to max_prune IOCs is always allowed: 10 of 40 here.
from {}
repeat 30
enumerate n
this = {domain: f"guard-{n}.example.net"}
harfanglab::ioc::sync env("HARFANGLAB_URL"), token=env("HARFANGLAB_TOKEN"),
  source="tenzir-test-guard", type="domain", value=domain, prune=true
summarize action, indicators=count()
sort action
