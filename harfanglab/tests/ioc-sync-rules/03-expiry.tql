// Expiry times are times or ISO 8601 strings, and `revoked` is a boolean or
// the string "true" or "false". Other values fail without a request. Fields
// that some events lack don't cause warnings with `?`.
from {domain: "c.example.com", until: "2099-01-01T00:00:00"},
  {domain: "d.example.com", until: "2099-01-01 12:00:00+02:00"},
  {domain: "e.example.com", until: 2099-01-01T00:00:00Z, gone: "False"},
  {domain: "f.example.com", until: "2020-01-01"},
  {domain: "g.example.com", gone: "true"},
  {domain: "h.example.com", until: "01/02/2099"},
  {domain: "i.example.com", until: "never"},
  {domain: "j.example.com", until: 4070908800},
  {domain: "k.example.com", gone: "yes"},
  {domain: "l.example.com", gone: 1}
harfanglab::ioc::sync env("HARFANGLAB_URL"), token=env("HARFANGLAB_TOKEN"),
  source="tenzir-test-rules", type="domain", value=domain,
  expires=until?, revoked=gone?
sort value
