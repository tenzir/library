// A value that the input holds more than once becomes one IOC. An active row
// wins over a revoked one, and the first description in sort order wins.
from {domain: "A.example.com", info: "Listed by feed B", gone: true},
  {domain: "a.example.com", info: "Listed by feed C", gone: false},
  {domain: "a.example.com", info: "Listed by feed A", gone: false},
  {domain: "b.example.com", info: "Revoked by feed A", gone: true},
  {domain: "b.example.com", info: "Revoked by feed B", gone: true}
harfanglab::ioc::sync env("HARFANGLAB_URL"), token=env("HARFANGLAB_TOKEN"),
  source="tenzir-test-rules", type="domain", value=domain, description=info,
  revoked=gone
sort value
