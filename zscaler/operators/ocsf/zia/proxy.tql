---
description: "ZIA NSS: Proxy → OCSF HTTP Activity"
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.http_activity"

// --- OCSF: classification attributes ----------

let $activity_map = {
  CONNECT: 1,
  DELETE: 2,
  GET: 3,
  HEAD: 4,
  OPTIONS: 5,
  POST: 6,
  PUT: 7,
  TRACE: 8,
  PATCH: 9,
}
$ocsf.activity_id = $activity_map[$event.requestmethod]? else 0

$ocsf.category_uid = 4
$ocsf.class_uid = 4002
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

let $severities = {
  None: 0,
  low: 2,
  medium: 3,
  high: 4,
  critical: 5,
}
$ocsf.severity_id = $severities[move $event.threatseverity]? else 0

// --- OCSF: context attributes -----------------

$ocsf.app_name = move $event.appname

$ocsf.metadata.profiles = ["host", "network_proxy", "security_control"]

$ocsf.time = parse_time(move $event.datetime, "%a %b %d %H:%M:%S %Y")

// --- OCSF: primary attributes -----------------

if $event.status != null {
  // Only when raw=true
  $event.status = $event.status.int()
  if $event.status >= 200 and $event.status < 400 {
    $ocsf.status_id = 1
  } else if $event.status >= 400 {
    $ocsf.status_id = 2
  } else {
    $ocsf.status_id = 0
  }
  $ocsf.status_code = $event.status.string()
}

$ocsf.status_detail = move $event.reason

// Source Endpoint (The client machine)
$ocsf.src_endpoint = {
  ip: ip(move $event.ClientIP)
}

// Destination Endpoint (The web server)
$ocsf.dst_endpoint = {
  ip: ip(move $event.serverip),
  domain: move $event.hostname,
}

$ocsf.traffic = {
  bytes_in: int(move $event.responsesize),
  bytes_out: int(move $event.requestsize),
  bytes: int(move $event.transactionsize)
}

$ocsf.http_request = {
  http_method: move $event.requestmethod,
  referrer: move $event.refererURL,
  user_agent: move $event.useragent,
  url: {
    url_string: move $event.url,
    scheme: to_lower(move $event.protocol),
    category_ids: [99, 99, 99, 99],
    categories: [move $event.urlcategory, move $event.urlsupercategory, move $event.appclass, move $event.urlclass]
  }
}

$ocsf.http_response = {
  code: move $event.status,
  content_type: move $event.contenttype
}

// --- OCSF: Host profile -----------

$ocsf.actor = {
  user: {
    name: move $event.user,
    org: {
      // ou: org unit
      ou_name: move $event.department?,
    },
  },
}

$ocsf.device = {
  hostname: move $event.devicehostname?,
  owner: {
    name: move $event.deviceowner?,
  },
}

// --- OCSF: Network Proxy profile -----------

// The ZIA node
$ocsf.proxy_endpoint = {
  ip: ip(move $event.clientpublicIP),
  name: move $event.location
}

// --- OCSF: Security Control profile -----------

let $actions = {
  "Allowed": 1,
  "Blocked": 2,
  "Quarantined": 3,
  "Isolated": 5
}
$ocsf.action_id = $actions[$event.action]? else 0
drop $event.action

if $event.threatname != null {
  $ocsf.malware = [{
    classification_ids: [0],
    name: move $event.threatname,
  }]
}

// TODO:
// - zia.threatclass
// - zia.threatcategory

$ocsf.risk_score = int(move $event.pagerisk)

// --- Finalize ---------------------------------
