---
description: Completes OCSF enums and retains unidentifiable optional objects.
args:
  positional:
    - name: ocsf
      type: field
      description: The OCSF record to finalize.
---

if $ocsf.device? != null {
  $ocsf.device.type_id = $ocsf.device?.type_id? else 0
}
if (
  $ocsf.actor?.user?.org? != null
  and $ocsf.actor?.user?.org?.name? == null
  and $ocsf.actor?.user?.org?.uid? == null
) {
  $ocsf.unmapped.ocsf_residue.actor_user_org = move $ocsf.actor.user.org
}
if (
  $ocsf.device?.owner? != null
  and $ocsf.device?.owner?.account? == null
  and $ocsf.device?.owner?.name? == null
  and $ocsf.device?.owner?.uid? == null
) {
  $ocsf.unmapped.ocsf_residue.device_owner = move $ocsf.device.owner
}
if (
  $ocsf.device? != null
  and $ocsf.device?.ip? == null
  and $ocsf.device?.uid? == null
  and $ocsf.device?.name? == null
  and $ocsf.device?.hostname? == null
  and $ocsf.device?.instance_uid? == null
  and $ocsf.device?.interface_uid? == null
  and $ocsf.device?.interface_name? == null
) {
  $ocsf.unmapped.ocsf_residue.device = move $ocsf.device
}
