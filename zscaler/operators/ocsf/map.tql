---
description: Maps a structured Zscaler event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The structured Zscaler event to map.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the OCSF event.
---


$into = {zia: $event, ocsf: {}}

// Clean up the original data.
replace $into.zia.bwthrottle, what="NO", with=false
replace $into.zia.bwthrottle, what="YES", with=true
replace $into.zia, what="None", with=null
replace $into.zia, what="N/A", with=null
replace $into.zia, what="NA", with=null
if $into.zia.refererURL? != null {
  $into.zia.refererURL = $into.zia.refererURL.trim("\"")
}
if $into.zia.filetype? != null {
  $into.zia.filetype = $into.zia.filetype.trim("\"")
}

$into.ocsf.metadata = {
  log_name: "NSS",
  product: {
    name: "Unknown",
    vendor_name: "Zscaler",
  },
  version: "1.9.0",
}
if $into.zia.product? != null {
  $into.ocsf.metadata.product.name = move $into.zia.product
}
if $into.zia.vendor? != null {
  $into.ocsf.metadata.product.vendor_name = move $into.zia.vendor
}
if $into.zia.event_id? != null {
  $into.ocsf.metadata.original_event_uid = string(move $into.zia.event_id)
}

$into.ocsf.severity_id = 0
$into.ocsf.time = now()

// Poor man's proxy log detection.
if $into.zia.has("requestmethod") {
  zscaler::ocsf::zia::proxy event=$into
} else {
  zscaler::ocsf::base event=$into
}



$into = {...$into.ocsf, unmapped: $into.zia}
