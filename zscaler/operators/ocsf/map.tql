---
description: Maps a structured Zscaler event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---


$ocsf = {}

// Clean up the original data.
replace $event.bwthrottle, what="NO", with=false
replace $event.bwthrottle, what="YES", with=true
replace $event, what="None", with=null
replace $event, what="N/A", with=null
replace $event, what="NA", with=null
if $event.refererURL? != null {
  $event.refererURL = $event.refererURL.trim("\"")
}
if $event.filetype? != null {
  $event.filetype = $event.filetype.trim("\"")
}

$ocsf.metadata = {
  log_name: "NSS",
  product: {
    name: "Unknown",
    vendor_name: "Zscaler",
  },
  version: "1.9.0",
}
if $event.product? != null {
  $ocsf.metadata.product.name = move $event.product
}
if $event.vendor? != null {
  $ocsf.metadata.product.vendor_name = move $event.vendor
}
if $event.event_id? != null {
  $ocsf.metadata.original_event_uid = string(move $event.event_id)
}

$ocsf.severity_id = 0
$ocsf.time = now()

// Poor man's proxy log detection.
if $event.has("requestmethod") {
  zscaler::ocsf::zia::proxy $event, $ocsf
} else {
  zscaler::ocsf::base $event, $ocsf
}



$ocsf.unmapped = move $event
