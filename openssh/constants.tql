// Application names that OpenSSH daemons use in the Syslog envelope across
// Linux distributions. OpenSSH 9.8 moved session handling into the separately
// named `sshd-session` binary, and Alpine's PAM-enabled build appends `.pam`.
let $app_names = ["sshd", "sshd-session", "sshd-auth", "sshd.pam", "sshd-session.pam", "sshd-auth.pam"]
