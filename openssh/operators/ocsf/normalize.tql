---
description: |
  Normalizes a Syslog event carrying an OpenSSH `sshd` message to OCSF.

  ```tql
  where app_name in openssh::$app_names
  openssh::ocsf::normalize
  ```

  The operator parses the message, combines related records from the same
  host, process, and event phase, maps the result to OCSF, and preserves the
  original Syslog records as provenance.
args:
  positional:
    - name: syslog
      description: The Syslog event carrying the `sshd` message.
      type: field
      default: this
  named:
    - name: into
      description: The field that receives the OCSF event.
      type: field
      default: this
---

$into.syslog = $syslog
// RFC 3164 events from `read_syslog` carry the message in `content` and the
// timestamp as a string, usually without a year, such as `Nov  6 09:13:01`.
$into.syslog.message = $into.syslog.message? else move $into.syslog.content?
if $into.syslog.timestamp.type_kind() == "string" {
  $into.syslog.timestamp = (
    time($into.syslog.timestamp) if $into.syslog.timestamp.match_regex("^\\d")
    else $into.syslog.timestamp.parse_time("%b %e %H:%M:%S", reference=now())
  )
}
openssh::parse $into.syslog.message, $into.openssh, wide=true
$into.openssh.syslog = $into.syslog
openssh::aggregate $into.syslog.message, $into.openssh
openssh::ocsf::map $into.openssh, $into.ocsf
$into = $into.ocsf
