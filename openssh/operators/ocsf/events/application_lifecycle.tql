---
description: Structured OpenSSH daemon lifecycle event → OCSF Application Lifecycle (6002).
args:
  positional:
    - name: openssh
      type: field
    - name: ocsf
      type: field
---

let $activity_ids = {
  start: 3,
  stop: 4,
}
@name = "ocsf.application_lifecycle"
$ocsf.category_uid = 6
$ocsf.class_uid = 6002
$ocsf.activity_id = $activity_ids[$openssh.activity]
$ocsf.application = {
  name: "sshd",
  product: {
    name: "OpenSSH",
    vendor_name: "OpenBSD",
  },
}

drop $openssh.template, $openssh.activity, $openssh.outcome?, $openssh.user?, $openssh.source?, $openssh.preauth?
