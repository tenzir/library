---
description: Structured OpenSSH event → OCSF Authentication (class 3002).
args:
  positional:
    - name: scope
      description: The active mapping scope.
      type: field
---

let $activity_ids = {
  logon: 1,
  logoff: 2,
}
let $status_details = {
  failed: "INVALID_CREDENTIALS",
  invalid_user: "USER_DOES_NOT_EXIST",
  max_auth_attempts: "MAX_ATTEMPTS_EXCEEDED",
}

@name = "ocsf.authentication"

$scope.ocsf.status_detail = $status_details[$scope.event.template]?
// A login against an account that does not exist fails for that reason, unless
// OpenSSH already gave a more specific one.
if $scope.event.user.is_invalid and $scope.event.template != "max_auth_attempts" {
  $scope.ocsf.status_detail = "USER_DOES_NOT_EXIST"
}

$scope.ocsf = {
  ...$scope.ocsf,
  category_uid: 3,
  class_uid: 3002,
  activity_id: $activity_ids[move $scope.event.activity],
  user: {
    name: move $scope.event.user.name,
  },
  src_endpoint: {
    ip: move $scope.event.source.ip,
    port: move $scope.event.source.port,
  },
  dst_endpoint: {
    hostname: move $scope.event.hostname?,
  },
  service: {
    name: "sshd",
  },
  auth_protocol_id: 99,
  auth_protocol: "SSH",
  logon_type_id: 10,
  is_remote: true,
  // SSH encrypts the transport regardless of the credential method.
  is_cleartext: false,
}

drop $scope.event.template, $scope.event.user, $scope.event.source
