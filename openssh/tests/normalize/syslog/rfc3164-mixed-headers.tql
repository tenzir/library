// RFC 3164 input needs no preprocessing: the normalizer reads `content` and
// parses year-less and ISO timestamp strings.
from_file env("TENZIR_INPUT") {
  read_syslog
}
openssh::ocsf::normalize
select time_is_set=time != null, user=user.name, host=device.hostname, factors=auth_factors.map(f => f.factor_type), message
sort user
