from_file env("TENZIR_INPUT") {
  read_syslog raw_message=raw
}
openssh::ocsf::normalize
this = ocsf_cast(this)
select time, class_uid, activity_id, status_id, src_endpoint?, dst_endpoint,
       status_detail, raw_data
// Include the optional endpoint in the snapshot so an empty object is visible.
drop_null_fields
sort time
