from_file env("TENZIR_INPUT") {
  read_syslog raw_message=raw
}
syslog = this
openssh::parse syslog.message, openssh, wide=true
openssh.syslog = syslog
openssh::aggregate syslog.message, openssh
raw_data = move openssh.raw_data
raw_data_size = move openssh.raw_data_size
openssh::ocsf::map openssh, ocsf
this = {
  ...ocsf,
  raw_data: raw_data,
  raw_data_size: raw_data_size,
}
ocsf_cast
drop_null_fields
sort time
