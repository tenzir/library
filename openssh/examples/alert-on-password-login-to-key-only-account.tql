---
name: Alert on password logins to key-only accounts
description: |
  Flags a successful password login to an account that has no password, such
  as a key-only user. Such a login should be impossible, so it points to an
  authentication bypass like CVE-2026-123158 or a misconfiguration. Fill the
  `openssh-passwordless-accounts` lookup table with the host and user pairs
  whose password field in `/etc/shadow` is `*`.
---

subscribe "ocsf"
where metadata.product.name == "OpenSSH" and class_uid == 3002
where status_id == 1 and "Password" in auth_factors.map(f => f.factor_type)
context_enrich "openssh-passwordless-accounts",
  key={host: device.hostname, user: user.name},
  into=passwordless
where passwordless != null
publish "alerts"
