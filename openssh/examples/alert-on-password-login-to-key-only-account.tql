---
name: Alert on password logins to key-only accounts
description: |
  Flags a successful password login to an account that only accepts keys. Such
  a login should be impossible, so it points to an authentication bypass like
  CVE-2026-123158 or a misconfiguration. The example reads your account
  inventory: a lookup table named `accounts` that holds OCSF User objects keyed
  by `{host: <hostname>, user: <user name>}`, with the label `key-only` in
  `account.labels` for accounts whose password field in `/etc/shadow` is `*`.
---

subscribe "ocsf"
where metadata.product.name == "OpenSSH" and class_uid == 3002
where status_id == 1 and "Password" in auth_factors.map(f => f.factor_type)
context_enrich "accounts",
  key={host: device.hostname, user: user.name},
  into=account
user = {...account, ...user}
drop account
where "key-only" in user.account?.labels?
publish "alerts"
