from_file f"{env("TENZIR_INPUTS")}/../native-log.input" {
  read_ndjson
}
@name = "otel.log"
anthropic::claude_code::ocsf::normalize
this = ocsf_derive(this)
strict {
  this = ocsf_cast(this)
}
// Inspect retained mapping facts separately from the validated event.
details = {
  ...this,
  ...ocsf_derive(unmapped.incomplete_activity?),
  ...unmapped.ocsf_residue?,
}
select metadata.version, metadata.event_code, metadata.profiles, class_name,
       activity_name, details.ai_agent?, details.api?.operation?, status, details.status_detail?
