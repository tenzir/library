from_file f"{env("TENZIR_INPUTS")}/../native-log.input" {
  read_ndjson
}
@name = "otel.log"
anthropic::claude_code::ocsf::normalize
this = ocsf_cast(this)
select metadata.version, metadata.event_code, metadata.profiles, class_uid,
       activity_id, ai_agent, api?.operation?, status_id, status_detail
