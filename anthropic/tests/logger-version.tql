// Keep the instrumentation version distinct from the application version.
from_file f"{env("TENZIR_INPUTS")}/../native-log.input" { read_ndjson }
@name = "otel.log"
anthropic::claude_code::canonicalize
scope = {name: "example.instrumentation", version: "1.2.3"}
source = this
anthropic::claude_code::ocsf::map source, ocsf
this = ocsf
ocsf_cast
select metadata.loggers, scope_residue=unmapped.scope?
