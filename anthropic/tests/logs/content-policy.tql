from_file f"{env("TENZIR_INPUTS")}/logs.json" {
  read_json
}
anthropic::claude_code::normalize
where event_name in ["tool_result", "assistant_response", "api_error"]
select event_name, tool_name?, command?, command_hash?, content?, content_hash?,
       tool_parameters?, tool_parameters_hash?
sort event_name, tool_name
