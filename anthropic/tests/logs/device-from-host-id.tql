// With `OTEL_RESOURCE_INCLUDE_HOST=1`, Claude Code reports the machine ID as
// `host.id`, which identifies the device even without a host name.
from {
  time: 2026-10-03T15:10:00Z,
  resource: {attributes: {"service.name": "claude-code", "service.version": "2.1.330", "host.id": "machine-id-1"}},
  scope: {name: "com.anthropic.claude_code.events"},
  receiver: {transport: "grpc"},
  body: {string_value: "claude_code.tool_result"},
  attributes: {
    "event.name": "tool_result",
    "session.id": "s-host-1",
    "user.id": "u-host-1",
    tool_name: "Bash",
    tool_use_id: "toolu_host",
    success: "true",
    duration_ms: "12",
    tool_parameters: "{\"bash_command\":\"uname\",\"full_command\":\"uname -a\"}",
  },
}
@name = "otel.log"
anthropic::claude_code::ocsf::normalize
this = ocsf_cast(this)
select class_uid, activity_id, device
