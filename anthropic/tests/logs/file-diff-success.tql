// Synthetic regression: only applied edits populate file_diff.
from {
  time: 2026-09-10T12:00:00Z,
  observed_time: 2026-09-10T12:00:00Z,
  trace_id: null,
  span_id: null,
  severity_number: 0,
  severity_text: null,
  flags: 1,
  resource: {attributes: {"service.name": "claude-code"}},
  scope: {name: "com.anthropic.claude_code.events"},
  receiver: {transport: "grpc"},
  body: null,
  attributes: {
    "event.name": "tool_result",
    tool_name: "Edit",
    tool_use_id: "synthetic-edit-success",
    tool_input: "{\"file_path\":\"/tmp/example.txt\",\"old_string\":\"old value\",\"new_string\":\"new value\"}",
    success: "true",
  },
}
@name = "otel.log"
anthropic::claude_code::ocsf include_content=true
ocsf_derive
ocsf_cast
select class_name, activity_name, status, file_diff?,
       proposed_edit=unmapped.tool_input?, unmapped_diff=unmapped.file_diff?
