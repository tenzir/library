// A prompt is a request to the agent. Its transcript message UUID identifies
// the request.
from {
  time: 2026-10-03T15:00:00Z,
  resource: {attributes: {"service.name": "claude-code", "service.version": "2.1.280"}},
  scope: {name: "com.anthropic.claude_code.events"},
  receiver: {transport: "grpc"},
  body: {string_value: "claude_code.user_prompt"},
  attributes: {
    "event.name": "user_prompt",
    "session.id": "s-prompt-1",
    "prompt.id": "p-prompt-1",
    "user.id": "u-prompt-1",
    prompt_length: "24",
    prompt: "<REDACTED>",
    "message.uuid": "m-prompt-1",
  },
}
@name = "otel.log"
anthropic::claude_code::ocsf::normalize
this = ocsf_cast(this)
select class_uid, activity_id, activity_name, api, correlation=metadata.correlation_uid
