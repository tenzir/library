// Real Claude Code denials captured from log-lab on 2026-09-08: one shell
// command blocked by a PreToolUse hook and one by a `permissions.deny` rule.
// A denied call has no result, so the decision is the only record of the
// attempt: a Process Activity Launch with Denied and Blocked, the deciding
// control in `policy.type`, and no Terminate ever following.
from_file f"{env("TENZIR_INPUTS")}/../logs/denied-by-hook-and-config.input" {
  read_ndjson
}
@name = "otel.log"
anthropic::claude_code::ocsf::normalize
this = ocsf_derive(this)
strict {
  this = ocsf_cast(this)
}
// Inspect retained mapping facts separately from the validated event.
details = {
  ...this,
  ...ocsf_derive(unmapped.incomplete_activity?),
  ...unmapped.ocsf_residue?,
}
select time, class_name, activity_name, message, status, severity, details.action?,
       details.disposition?, details.policy?, details.authorizations?, details.process?.uid?, details.process?.cmd_line?
sort time
