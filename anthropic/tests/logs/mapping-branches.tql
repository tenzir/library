from_file f"{env("TENZIR_INPUTS")}/logs.json" {
  read_json
}
anthropic::claude_code::ocsf_legacy_envelope include_content=true
ocsf_derive
ocsf_cast
select time, metadata.event_code, class_name, activity_name, status,
       process?.cmd_line?, file?.path?, file?.is_deleted?, api?.operation?,
       ai_agent?, message_context?.prompt_text?,
       message_context?.response_text?
sort time
