// Captured raw log-lab event. Dotted OTEL keys restored from ClickHouse.
// Personal identifiers omitted; operational IDs and timestamps retained.
from_file f"{env("TENZIR_INPUTS")}/../logs/api-retries-exhausted.input" {
  read_ndjson
}
severity_text = severity_text?
@name = "otel.log"
anthropic::claude_code::ocsf
ocsf_derive
ocsf_cast
select time, class_name, activity_name, status, status_code, message,
       attempts=unmapped.total_attempts, retry_duration_ms=unmapped.total_retry_duration_ms,
       ai_agent.ai_model.name, actor.session.uid, trace_id=unmapped.trace_id?
