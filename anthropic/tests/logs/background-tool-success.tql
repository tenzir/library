// Synthetic regression case, not a captured OTLP record.
from {
  time: 2026-09-10T12:00:00Z,
  observed_time: 2026-09-10T12:00:00Z,
  trace_id: null,
  span_id: null,
  severity_number: 0,
  severity_text: null,
  flags: 1,
  resource: {attributes: {"service.name": "claude-code"}},
  scope: {name: "com.anthropic.claude_code.events"},
  receiver: {transport: "grpc"},
  body: null,
  attributes: {
    "event.name": "tool_result",
    tool_name: "Bash",
    tool_use_id: "synthetic-background-success",
    success: "true",
    tool_input: "{\"command\":\"sleep 30\",\"run_in_background\":true}",
  },
}
@name = "otel.log"
anthropic::claude_code::ocsf
ocsf_derive
ocsf_cast
select class_name, activity_name, status, message,
       process.uid, process.terminated_time?,
       background_requested=unmapped.background_requested,
       tool_success=unmapped.tool_success
