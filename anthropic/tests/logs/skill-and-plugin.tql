// Real Claude Code plugin loads and a skill activation captured from log-lab
// on 2026-09-07 and 2026-09-08. Identity fields are omitted; plugin and
// skill values are unchanged.
from_file f"{env("TENZIR_INPUTS")}/../logs/skill-and-plugin.input" {
  read_ndjson
}
@name = "otel.log"
anthropic::claude_code::ocsf::normalize
ocsf_derive
ocsf_cast
select time, metadata.event_code, class_name, activity_name, message, status,
       application, charter=ai_agent.charter?, session=actor.session.uid,
       plugin_scope=unmapped.plugin_scope?, enabled_via=unmapped.plugin_enabled_via?,
       has_hooks=unmapped.plugin_has_hooks?, has_mcp=unmapped.plugin_has_mcp?,
       skills=unmapped.plugin_skill_count?, commands=unmapped.plugin_command_count?,
       skill_source=unmapped.skill_source?, trigger=unmapped.skill_invocation_trigger?
sort time
