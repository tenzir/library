// Real Claude Code file-tool results captured from log-lab on 2026-09-07: a
// read, a read of a missing file, a write, an edit and a notebook cell edit.
// Identity fields are omitted and the fixture paths shortened.
from_file f"{env("TENZIR_INPUTS")}/../logs/file-tools.input" {
  read_ndjson
}
@name = "otel.log"
anthropic::claude_code::ocsf::normalize include_content=true
this = ocsf_derive(this)
this = ocsf_cast(this)
// Inspect retained mapping facts separately from the validated event.
details = {
  ...this,
  ...ocsf_derive(unmapped.incomplete_activity?),
  ...unmapped?,
}
select time, class_name, activity_name, message, status, details.status_detail?,
       severity, details.action?, details.disposition?, details.file?.path?, details.file?.name?, details.file?.type?,
       details.file_diff?, tool_use_id=unmapped.tool_use_id,
       tool_name=unmapped.tool_name?
sort time
