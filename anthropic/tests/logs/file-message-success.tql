// Synthetic regression test for outcome-aware file messages.
from {
  time: 2026-09-10T12:00:00Z,
  observed_time: 2026-09-10T12:00:00Z,
  trace_id: null,
  span_id: null,
  severity_number: 0,
  severity_text: null,
  flags: 1,
  resource: {attributes: {"service.name": "claude-code"}},
  scope: {name: "com.anthropic.claude_code.events"},
  receiver: {transport: "grpc"},
  body: null,
  attributes: {
    "event.name": "tool_result",
    tool_name: "Read",
    tool_use_id: "synthetic-file-success",
    tool_input: "{\"file_path\":\"/tmp/example.txt\"}",
    success: "true",
  },
}
@name = "otel.log"
anthropic::claude_code::ocsf
ocsf_derive
ocsf_cast
select class_name, activity_name, status, message
