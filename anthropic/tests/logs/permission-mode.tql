// Real Claude Code permission-mode changes: the harness demoting a child
// session from `auto` to `default` after its automatic gate denied a call
// (captured 2026-09-07), and a person cycling `acceptEdits` to `plan` to
// `auto` with Shift+Tab (anonymized 2026-08-20 sample set).
from_file f"{env("TENZIR_INPUTS")}/../logs/permission-mode.input" {
  read_ndjson
}
@name = "otel.log"
anthropic::claude_code::ocsf::normalize
this = ocsf_derive(this)
this = ocsf_cast(this)
// Inspect retained mapping facts separately from the validated event.
details = {
  ...this,
  ...unmapped?,
}
select time, class_name, activity_name, message, status, severity, details.privileges?,
       details.session?.uid?, from_mode=unmapped.permission_from?,
       trigger=unmapped.permission_trigger?
sort time
