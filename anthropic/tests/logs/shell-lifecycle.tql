// Two real Claude Code Bash lifecycles from native OTLP. One completed in
// 2.132 seconds and the other in 213.145 seconds. Duration must not change the
// Launch/Terminate classification.
from_file f"{env("TENZIR_INPUTS")}/../native-logs-sample.input" {
  read_ndjson
}
where attributes.tool_name? == "Bash"
@name = "otel.log"
anthropic::claude_code::ocsf::normalize
this = ocsf_cast(this)
select time, class_uid, activity_id, status_id, action_id?, disposition_id?,
       process.uid, process.pid?, process.name, process.cmd_line,
       process.created_time?, process.terminated_time?
