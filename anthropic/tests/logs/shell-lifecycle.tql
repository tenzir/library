// Two real Claude Code Bash lifecycles from native OTLP. One completed in
// 2.132 seconds and the other in 213.145 seconds. Duration must not change the
// Launch/Terminate classification.
from_file f"{env("TENZIR_INPUTS")}/../native-logs-sample.input" {
  read_ndjson
}
where attributes.tool_name? == "Bash"
@name = "otel.log"
anthropic::claude_code::ocsf::normalize
this = ocsf_derive(this)
this = ocsf_cast(this)
// Inspect retained mapping facts separately from the validated event.
details = {
  ...this,
  ...unmapped?,
}
select time, class_name, activity_name, status, details.action_id?, details.disposition_id?,
       details.process?.uid?, details.process?.pid?, details.process?.name?, details.process?.cmd_line?,
       details.process?.created_time?, details.process?.terminated_time?
