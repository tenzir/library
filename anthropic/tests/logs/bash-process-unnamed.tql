// The Bash tool names neither the shell nor the program it launches, so the
// process stays unnamed and the tool name stays in `unmapped`. A tool that
// Claude Code does not ship, such as `exec`, is not a shell tool.
from {
  time: 2026-10-03T14:00:00Z,
  resource: {attributes: {"service.name": "claude-code", "service.version": "2.1.280"}},
  scope: {name: "com.anthropic.claude_code.events"},
  receiver: {transport: "grpc"},
  body: {string_value: "claude_code.tool_result"},
  attributes: {
    "event.name": "tool_result",
    "session.id": "s-bash-1",
    tool_name: "Bash",
    tool_use_id: "toolu_du",
    success: "true",
    duration_ms: "35",
    tool_parameters: "{\"bash_command\":\"du\",\"full_command\":\"du -sh build\"}",
  },
}, {
  time: 2026-10-03T14:00:01Z,
  resource: {attributes: {"service.name": "claude-code", "service.version": "2.1.280"}},
  scope: {name: "com.anthropic.claude_code.events"},
  receiver: {transport: "grpc"},
  body: {string_value: "claude_code.tool_result"},
  attributes: {
    "event.name": "tool_result",
    "session.id": "s-bash-1",
    tool_name: "exec",
    tool_use_id: "toolu_exec",
    success: "true",
    duration_ms: "4",
  },
}
@name = "otel.log"
anthropic::claude_code::ocsf::normalize
this = ocsf_cast(this)
select class_uid, activity_id, process?, tool_name=unmapped.tool_name
