// Decisions on local tools without an OCSF class: a person approving an
// `Edit` whose decision carries no path, and a person rejecting a `Skill`
// call. Both fall back to Base Event, which must still carry the decision,
// the tool name and the session.
from {
  time: 2026-09-04T13:00:00Z,
  observed_time: 2026-09-04T13:00:00Z,
  trace_id: "11111111111111111111111111111111",
  span_id: "1111111111111111",
  severity_number: 0,
  severity_text: null,
  flags: 1,
  resource: {attributes: {"service.name": "claude-code", "service.version": "2.1.257"}},
  scope: {name: "com.anthropic.claude_code.events"},
  receiver: {transport: "grpc"},
  body: {string_value: "claude_code.tool_decision"},
  attributes: {
    "event.name": "tool_decision",
    "session.id": "s1",
    tool_name: "Edit",
    tool_use_id: "toolu_edit1",
    tool_source: "builtin",
    decision: "accept",
    source: "user_temporary",
  },
}, {
  time: 2026-09-04T13:00:01Z,
  observed_time: 2026-09-04T13:00:01Z,
  trace_id: "11111111111111111111111111111111",
  span_id: "1111111111111112",
  severity_number: 0,
  severity_text: null,
  flags: 1,
  resource: {attributes: {"service.name": "claude-code", "service.version": "2.1.257"}},
  scope: {name: "com.anthropic.claude_code.events"},
  receiver: {transport: "grpc"},
  body: {string_value: "claude_code.tool_decision"},
  attributes: {
    "event.name": "tool_decision",
    "session.id": "s1",
    tool_name: "Skill",
    tool_use_id: "toolu_skill1",
    tool_parameters: "{\"skill_name\":\"tenzir\"}",
    tool_source: "builtin",
    decision: "reject",
    source: "user_reject",
  },
}
@name = "otel.log"
anthropic::claude_code::ocsf
ocsf_derive
ocsf_cast
select time, class_name, activity_name, message, action, disposition, status,
       severity, metadata.profiles, authorizations,
       tool_name=unmapped.tool_name, tool_use_id=unmapped.tool_use_id,
       session=actor.session.uid
