// OTel host.name or host.id supplies the device identity for File Activity.
from {
  time: 2026-09-10T12:00:00Z,
  observed_time: 2026-09-10T12:00:00Z,
  trace_id: null,
  span_id: null,
  severity_number: 0,
  severity_text: null,
  flags: 1,
  resource: {attributes: {"service.name": "claude-code"}},
  scope: {name: "com.anthropic.claude_code.events"},
  receiver: {transport: "grpc"},
  body: null,
  attributes: {
    "event.name": "tool_result",
    tool_name: "Delete",
    tool_use_id: "synthetic-delete-success",
    tool_input: "{\"file_path\":\"/tmp/example.txt\"}",
    success: "true",
  },
}
hosts = [{name: null, uid: null}, {name: "test-host", uid: null},
         {name: null, uid: "test-host-id"}, {name: "test-host", uid: "test-host-id"}]
unroll hosts
resource.attributes = {...resource.attributes, "host.name": hosts.name, "host.id": hosts.uid}
@name = "otel.log"
anthropic::claude_code::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
if device? == null {
  assert class_uid == 0
  assert not unmapped.has("incomplete_activity")
  assert not unmapped.has("class_uid")
  assert not unmapped.has("metadata")
  assert unmapped.file.is_deleted == true
} else {
  assert class_uid == 1001
  assert device.hostname? == "test-host" or device.uid? == "test-host-id"
  assert file.is_deleted == true
}
this = {
  class_uid: class_uid,
  hostname: device?.hostname?,
  host_uid: device?.uid?,
  deleted: file?.is_deleted? else unmapped?.file.is_deleted?,
}
sort class_uid, hostname, host_uid
