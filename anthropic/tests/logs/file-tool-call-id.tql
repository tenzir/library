// File System Activity has no typed home for the tool-call id, so it must
// stay in `unmapped` as the join key to the call's decision.
from {
  time: 2026-09-04T13:00:00Z,
  observed_time: 2026-09-04T13:00:00Z,
  trace_id: "11111111111111111111111111111111",
  span_id: "1111111111111111",
  severity_number: 0,
  severity_text: null,
  flags: 1,
  resource: {attributes: {"service.name": "claude-code", "service.version": "2.1.257"}},
  scope: {name: "com.anthropic.claude_code.events"},
  receiver: {transport: "grpc"},
  body: {string_value: "claude_code.tool_result"},
  attributes: {
    "event.name": "tool_result",
    "session.id": "s1",
    tool_name: "Edit",
    tool_use_id: "toolu_edit1",
    tool_input: "{\"file_path\":\"/w/example.tql\"}",
    decision_type: "accept",
    decision_source: "config",
    success: "true",
    duration_ms: "12",
  },
}
@name = "otel.log"
anthropic::claude_code::ocsf::normalize
ocsf_derive
ocsf_cast
select class_name, activity_name, action, disposition, file.path,
       tool_use_id=unmapped.tool_use_id
