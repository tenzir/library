// Real Claude Code OTLP records captured from log-lab on 2026-09-03 and
// 2026-09-04. User identity fields are omitted; tool values are unchanged.
from_file f"{env("TENZIR_INPUTS")}/../logs/mcp-linear-result.input" {
  read_ndjson
}
body = {string_value: body}
severity_number = 0
severity_text = null
flags = 1
@name = "otel.log"
anthropic::claude_code::ocsf include_content=true
ocsf_derive
ocsf_cast
select time, metadata.event_code, class_name, activity_name, action?, status,
       api?.operation?, api_service=api?.service?.name?,
       dst_service=dst_endpoint?.svc_name?, request_uid=api?.request?.uid?,
       request_data=api?.request?.data?, resources?,
       duration_ms=unmapped.duration_ms?,
       tool_input_size_bytes=unmapped.tool_input_size_bytes?,
       tool_result_size_bytes=unmapped.tool_result_size_bytes?,
       mcp_server_scope=unmapped.mcp_server_scope?
