// Synthetic variation of the captured login: test the dispatch/outcome guard.
from_file f"{env("TENZIR_INPUTS")}/../logs/auth-login.input" {
  read_ndjson
}
attributes.success = "false"
severity_text = severity_text?
@name = "otel.log"
anthropic::claude_code::ocsf
ocsf_derive
ocsf_cast
select time, class_name, activity_name, status, auth_protocol_id?, auth_protocol?,
       user?, service?, session?, actor.session.uid,
       trace_id=unmapped.trace_id?, span_id=unmapped.span_id?
