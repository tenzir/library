// Hook records name the hook but report no command line, so the process
// carries no `cmd_line` instead of an empty placeholder.
from {
  time: 2026-10-03T14:05:00Z,
  resource: {attributes: {"service.name": "claude-code", "service.version": "2.1.280"}},
  scope: {name: "com.anthropic.claude_code.events"},
  receiver: {transport: "grpc"},
  body: {string_value: "claude_code.hook_execution_start"},
  attributes: {
    "event.name": "hook_execution_start",
    "session.id": "s-hook-1",
    hook_event: "PostToolUse",
    hook_name: "PostToolUse:Write",
    num_hooks: "1",
    hook_source: "userSettings",
  },
}
@name = "otel.log"
anthropic::claude_code::ocsf::normalize
this = ocsf_cast(this)
select class_uid, activity_id, process
