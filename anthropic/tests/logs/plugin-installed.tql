// Captured raw log-lab event. Dotted OTEL keys restored from ClickHouse.
// Personal identifiers omitted; operational IDs and timestamps retained.
from_file f"{env("TENZIR_INPUTS")}/../logs/plugin-installed.input" {
  read_ndjson
}
severity_text = severity_text?
@name = "otel.log"
anthropic::claude_code::ocsf::normalize
ocsf_derive
ocsf_cast
select time, class_name, activity_name, status, application, actor.session.uid,
       marketplace=unmapped.plugin_marketplace?, trigger=unmapped.install_trigger?,
       trace_id=unmapped.trace_id?, span_id=unmapped.span_id?
