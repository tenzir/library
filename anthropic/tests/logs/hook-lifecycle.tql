// Real Claude Code hook records captured from log-lab on 2026-09-07: a
// registration, an execution start and an execution completion. Identity
// fields are omitted; hook values are unchanged.
from_file f"{env("TENZIR_INPUTS")}/../logs/hook-lifecycle.input" {
  read_ndjson
}
@name = "otel.log"
anthropic::claude_code::ocsf
ocsf_derive
ocsf_cast
select time, metadata.event_code, class_name, activity_name, message, status,
       application?.name?, process?.name?, duration_ms=unmapped.duration_ms?,
       hook_event=unmapped.hook_event?, hook_source=unmapped.hook_source?,
       hook_type=unmapped.hook_type?, hook_matcher=unmapped.hook_matcher?,
       hook_count=unmapped.hook_count?,
       hook_success_count=unmapped.hook_success_count?,
       hook_blocking_count=unmapped.hook_blocking_count?,
       hook_error_count=unmapped.hook_error_count?
