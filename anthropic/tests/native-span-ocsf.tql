from_file f"{env("TENZIR_INPUTS")}/../native-span.input" {
  read_ndjson
}
@name = "otel.span"
anthropic::claude_code::ocsf::normalize
this = ocsf_derive(this)
strict {
  this = ocsf_cast(this)
}
select metadata.version, metadata.event_code, metadata.profiles?, class_name,
       activity_name, ai_agent?, api?.operation?, trace?, status
