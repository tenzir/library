from_file f"{env("TENZIR_INPUTS")}/traces.json" {
  read_json
}
anthropic::claude_code::ocsf_legacy_envelope include_content=true
ocsf_derive
ocsf_cast
select time, metadata.event_code, class_name, status, status_detail?,
       action?, disposition?, process?.cmd_line?, script?, api?.operation?,
       ai_agent?, message_context?, trace?
sort time
