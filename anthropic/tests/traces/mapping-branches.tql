// Native-record fixture converted from the former OTLP/JSON test envelope.
from_file f"{env("TENZIR_INPUTS")}/traces.json" {
  read_json
}
@name = "otel.span"
anthropic::claude_code::ocsf::normalize include_content=true
ocsf_derive
ocsf_cast
select time, metadata.event_code, class_name, activity_name, status, status_detail?,
       action?, disposition?, process?.cmd_line?, script?, api?.operation?,
       ai_agent?, message_context?, trace?
sort time
