// Real Claude Code WebFetch span captured from log-lab on 2026-09-04.
from_file f"{env("TENZIR_INPUTS")}/../traces/remote-web-span.input" {
  read_ndjson
}
@name = "otel.span"
anthropic::claude_code::ocsf
ocsf_derive
ocsf_cast
select class_name, activity_name, api?.operation?, request_uid=api?.request?.uid?,
       trace?, unmapped_duration=unmapped.duration?
