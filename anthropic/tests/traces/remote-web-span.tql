// Real Claude Code WebFetch span captured from log-lab on 2026-09-04. The
// decision and result logs already report this call, so the span produces no
// event: mapping it would count the call twice.
from_file f"{env("TENZIR_INPUTS")}/../traces/remote-web-span.input" {
  read_ndjson
}
@name = "otel.span"
anthropic::claude_code::ocsf::normalize
summarize mapped_spans=count()
