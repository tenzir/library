// Native-record fixture converted from the former OTLP/JSON test envelope.
from_file env("TENZIR_INPUT") {
  read_json
}
@name = "otel.log"
anthropic::claude_code::ocsf::normalize include_content=true
this = ocsf_derive(this)
strict {
  this = ocsf_cast(this)
}
where metadata.event_code == "hook_registered"
select time, metadata.event_code, class_name, activity_name, application,
       ai_agent?, unmapped.hook_event
