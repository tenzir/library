from_file env("TENZIR_INPUT") {
  read_json
}
anthropic::claude_code::ocsf_legacy_envelope include_content=true
ocsf_derive
ocsf_cast
select time, metadata.event_code, metadata.profiles, class_name,
       activity_name, api?.operation?, script?.uid?, action, disposition,
       policy?, authorizations, status, severity
sort time
