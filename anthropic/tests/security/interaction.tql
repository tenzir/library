// Native-record fixture converted from the former OTLP/JSON test envelope.
from_file env("TENZIR_INPUT") {
  read_json
}
@name = "otel.span"
anthropic::claude_code::ocsf::normalize include_content=true
// The interaction span repeats the `user_prompt` and `assistant_response`
// logs and adds only the turn's duration and sequence, so it is suppressed.
where metadata.event_code == "claude_code.interaction"
summarize interaction_spans_mapped=count()
