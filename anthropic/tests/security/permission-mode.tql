// Native-record fixture converted from the former OTLP/JSON test envelope.
from_file env("TENZIR_INPUT") {
  read_json
}
@name = "otel.log"
anthropic::claude_code::ocsf::normalize include_content=true
this = ocsf_derive(this)
strict {
  this = ocsf_cast(this)
}
// Inspect retained mapping facts separately from the validated event.
details = {
  ...this,
  ...ocsf_derive(unmapped.incomplete_activity?),
  ...unmapped.ocsf_residue?,
}
where metadata.event_code == "permission_mode_changed"
select time, metadata.event_code, metadata.profiles, class_name,
       activity_name, severity, details.privileges?, details.user?, details.session?, details.ai_agent?.name?,
       unmapped.permission_from, unmapped.permission_trigger
