from_file env("TENZIR_INPUT") {
  read_json
}
anthropic::claude_code::ocsf_legacy_envelope include_content=true
ocsf_derive
ocsf_cast
where metadata.event_code == "user_prompt"
select time, metadata.event_code, class_name, activity_name, api.operation,
       ai_agent, message_context, unmapped.content_hash
