// Native-record fixture converted from the former OTLP/JSON test envelope.
from_file env("TENZIR_INPUT") {
  read_json
}
@name = "otel.log"
anthropic::claude_code::ocsf::normalize include_content=true
this = ocsf_derive(this)
strict {
  this = ocsf_cast(this)
}
where metadata.event_code == "mcp_server_connection"
select time, metadata.event_code, class_name, activity_name, status,
       dst_endpoint, src_endpoint, api, duration?, unmapped.transport_type,
       unmapped.server_scope
