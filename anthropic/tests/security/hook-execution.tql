// Native-record fixture converted from the former OTLP/JSON test envelope.
from_file env("TENZIR_INPUT") {
  read_json
}
@name = "otel.log"
anthropic::claude_code::ocsf::normalize include_content=true
this = ocsf_cast(this)
where metadata.event_code == "hook_execution_complete"
select time, metadata.event_code, class_uid, activity_id, process.name,
       process.cmd_line, status_id, duration?, unmapped.hook_event
