---
name: Normalize Live Claude Code OTLP
description: >
  Prints the first 100 retained Claude Code log and span events as OCSF,
  including Base Event fallbacks. Metrics are excluded.
---

subscribe "otlp"
where @name in ["otel.log", "otel.span"]
anthropic::claude_code::ocsf
ocsf_derive
ocsf_cast
head 100
to_stdout {
  write_ndjson
}
