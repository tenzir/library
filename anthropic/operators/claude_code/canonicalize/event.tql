---
description: Canonicalizes claude_code event records in the selected field.
args:
  named:
    - name: event
      type: field
      default: this
      description: The record to canonicalize.
    - name: include_content
      type: bool
      default: false
      description: Retain conversation text and tool input. Shell commands are always retained.
---

match $event.signal {
  "log" => {
    where $event.resource["service.name"] == "claude-code"
    anthropic::claude_code::canonicalize::logs event=$event, include_content=$include_content
  }
  "trace" => {
    where $event.resource["service.name"] == "claude-code"
    anthropic::claude_code::canonicalize::traces event=$event, include_content=$include_content
    // These spans duplicate logs, which also carry outcomes and prompt IDs.
    where not ($event.tool_name? != null or ($event.span_type? else "") in [
      "tool",
      "tool.execution",
      "tool.blocked_on_user",
      "llm_request",
      "interaction",
    ])
  }
  _ => {
    discard
  }
}
