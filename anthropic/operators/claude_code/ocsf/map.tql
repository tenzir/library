---
description: Maps normalized Claude Code events to OCSF 1.9.0.
args:
  named:
    - name: event
      type: field
      default: this
      description: The field that holds the normalized event.
---

$event = {...$event, otel: $event, ocsf: {}}

$event.ocsf.metadata = {
  event_code: $event.otel.event_name,
  log_format: "OTLP/gRPC" if $event.otel.transport? == "grpc" else
              "OTLP/HTTP" if $event.otel.transport? == "http" else
              "OTLP/JSON" if $event.otel.transport? == "json" else
              "OTLP",
  log_provider: "OpenTelemetry",
  log_source: $event.otel.scope.name?,
  log_level: $event.otel.severity_text?,
  logged_time: $event.otel.observed_time?,
  // The identifier the source assigned to this record, which is what makes the
  // event traceable back to the raw entry. Only spans carry one: `span_id`
  // identifies the span itself. A tool-call id names the call, not the record,
  // and the span, the decision and the result all share it, so it cannot
  // identify a single source event; it stays on `process.uid`
  // and `api.request.uid`. Log and metric records carry no native identifier,
  // so the field is left empty rather than filled with something else.
  original_event_uid: $event.otel.span_id? if $event.otel.signal? == "trace" else null,
  // `correlation_uid` always identifies the trace, so grouping by it never
  // mixes scopes. The session is available as `ai_agent.instance_uid`.
  correlation_uid: $event.otel.trace_id? if ($event.otel.trace_id? else "") != "" else null,
  sequence: $event.otel.event_sequence?,
  tenant_uid: $event.otel.organization_id?,
  product: {
    name: "Claude Code",
    vendor_name: "Anthropic",
    version: $event.otel.resource.service_version? else $event.otel.app_version?,
  },
  version: "1.9.0",
}

$event.ocsf.time = $event.otel.time? else $event.otel.start_time? else $event.otel.observed_time?
// `start_time`, `end_time` and `duration` describe an aggregation window and
// the schema says not to populate them for discrete events. A metric point is
// an aggregate, so it carries the window and the count it summarizes;
// everything else is a point in time and carries `time` alone. Span timing
// stays on the Trace profile, and a tool's own `duration_ms` remains in
// `unmapped`.
if $event.otel.signal? == "metric" {
  $event.ocsf.start_time = $event.otel.start_time?
  $event.ocsf.end_time = $event.otel.end_time?
  $event.ocsf.duration = $event.otel.duration?
  // `count` is the number of occurrences the event summarizes. Only the
  // metrics that count occurrences fill it; a token, cost or time total is a
  // quantity and stays in `unmapped.metric_value` with its unit.
  $event.ocsf.count = int($event.otel.metric_value) if $event.otel.metric_value? != null and $event.otel.metric_name? in [
                        "claude_code.session.count",
                        "claude_code.code_edit_tool.decision",
                      ] else null
}
// `message` is a human-readable summary for display; the raw event name stays
// in `metadata.event_code`. Branches override this fallback with a sentence.
$event.ocsf.message = $event.otel.event_name
$event.ocsf.raw_data = move $event.otel.raw_data?
$event.ocsf.raw_data_size = move $event.otel.raw_data_size?
// The agents report tool approvals as free text (`accept`/`approved`,
// `deny`/`rejected`) and name the authorizing party in `decision_source`
// (a policy such as `config`, or `User` for an interactive prompt).
_decision = ($event.otel.decision? else "").to_lower()
_decision_status_id = 1 if _decision in ["accept", "approved", "approved_for_session", "allow", "allowed"] else
                      2 if _decision in ["deny", "denied", "reject", "rejected", "abort", "aborted"] else
                      null
// Who decided, resolved once and reused: an interactive source means a person,
// anything else named means a rule fired. An unnamed decider is neither.
_decision_source = ($event.otel.decision_source? else "").to_lower()
_human_decision = _decision_source.starts_with("user")
_policy_decision = not _human_decision and _decision_source not in ["", "unknown"]
// The decision appears twice by design: normalized into `action_id` and
// `disposition_id`, and verbatim on the Security Control profile. `policy` is
// attached only when a rule decided, because a person is not a policy.
_authorizations = [{
  decision: $event.otel.decision?,
  // The source names the kind of control that decided, not a named rule, so
  // it lands in `policy.type` here exactly as it does in the top-level
  // `policy` block.
  policy: {type: $event.otel.decision_source} if _policy_decision else null,
}] if $event.otel.decision? != null else null

// A denied tool call is a governance signal worth surfacing above the
// informational baseline. OCSF `Low` reads as "the user decides if action is
// needed", which fits a single denial; repeated denials are what warrant
// attention, and that is a detection concern rather than a per-event severity.
$event.ocsf.severity_id = 3 if $event.otel.success? == false or ($event.otel.http_status? != null and $event.otel.http_status >= 400) or $event.otel.status_code? == 2 else
                          2 if _decision_status_id == 2 else 1
// Claim an outcome only where the source states one: the `success` flag, an
// HTTP response code, or an OTLP span status. A decision to allow is not an
// outcome, because the call it permits can still fail and the result record is
// what reports that; a denial is, because the activity never ran.
$event.ocsf.status_id = 1 if $event.otel.success? == true or
                             ($event.otel.http_status? != null and $event.otel.http_status < 400) or
                             $event.otel.status_code? == 1 else
                        2 if $event.otel.success? == false or
                             ($event.otel.http_status? != null and $event.otel.http_status >= 400) or
                             $event.otel.status_code? == 2 or
                             _decision_status_id == 2 else
                        0
// The source's own code. The OTLP span status is not one: it already has a
// home on `trace.span.status_code`, and mixing the two code spaces in one
// field makes neither readable.
$event.ocsf.status_code = $event.otel.source_status_code.string() if $event.otel.source_status_code? != null else
                          $event.otel.http_status.string() if $event.otel.http_status? != null else null
// Why the outcome happened. The decision is not a reason: it is already
// carried by `action_id`, `disposition_id` and `authorizations`.
$event.ocsf.status_detail = $event.otel.error? else
                            $event.otel.error_type? else
                            $event.otel.status_message? else
                            $event.otel.startup_status? else
                            $event.otel.source_status?

_actor = {
  // `app_name` is deprecated in OCSF 1.9.0 in favour of `application.name`.
  application: {name: $event.otel.resource.service_name},
  session: {
    uid: $event.otel.session_id?,
    terminal: $event.otel.terminal_type?,
  },
  user: {
    uid: $event.otel.user_id?,
    uid_alt: $event.otel.user_uid_alt?,
    email_addr: $event.otel.user_email?,
  },
}
// A device is an addressable host. When the resource reports none, say so
// rather than substituting the agent's service name, which would join these
// events to an asset that does not exist.
// `device` constrains itself to at least one of `ip`, `uid`, `name`,
// `hostname`, `instance_uid`, `interface_uid` or `interface_name`, so it is
// attached only when the resource names the host. A device object that
// identifies nothing cannot be joined to an asset, and claiming one that the
// source never reported would be worse than leaving the required field empty.
// `device` constrains itself to at least one identifying attribute, and the
// host name the agent reports is the only one this telemetry carries. The
// address the export arrived from is not a substitute: a collector reached
// through a container or a sidecar rewrites it, so every agent reports the
// same value and it would satisfy the constraint while identifying nothing.
// Agents that report no host name can set one with OTEL_RESOURCE_ATTRIBUTES.
_device = {
  hostname: $event.otel.resource.host_name?,
  name: $event.otel.resource.host_name?,
  // The OS the agent runs on, which both products report even when they
  // report no host name.
  os: {
    name: $event.otel.resource.os_type?,
    version: $event.otel.resource.os_version?,
  } if $event.otel.resource.os_type? != null else null,
  // `type_id` is required. Agent telemetry never says whether the host is a
  // laptop, a server or a VM, so `0` (Unknown) is the honest answer.
  type_id: 0,
} if $event.otel.resource.host_name? != null else null
_message_context = {
  // `uid` is the context the messages belong to, the session. `name` is the
  // turn within it when the source reports one; it never repeats `uid`.
  uid: $event.otel.session_id?,
  name: $event.otel.prompt_id?,
  ai_role_id: 1 if $event.otel.event_name in ["user_prompt", "claude_code.interaction"] else
              2 if $event.otel.event_name == "assistant_response" else
              3 if $event.otel.tool_name? != null else
              4,
  application: {
    name: $event.otel.app_entrypoint? else $event.otel.resource.service_name,
    version: $event.otel.app_version?,
  },
  // `message_context.service` names the system that handles the request, such
  // as the model API. The local CLI is the client and is already on
  // `application`, so this stays empty rather than repeating it.
}
_ai_agent = {
  // The agent's name is the runtime the telemetry reports, which also
  // distinguishes co-existing runtimes of one product. `uid` is reserved for a
  // stable identity issued by an authoritative source; neither product issues
  // one, so it stays empty rather than repeating the name. The product's
  // display name is on `metadata.product.name`.
  name: $event.otel.resource.service_name? else "Claude Code",
  instance_uid: $event.otel.session_id?,
  version: $event.otel.resource.service_version? else $event.otel.app_version?,
  type_id: 1,
  ai_model: {
    name: $event.otel.model,
    ai_provider: $event.otel.provider? else "Anthropic",
  } if ($event.otel.model? else "") != "" else null,
}

if $event.otel.event_name == "permission_mode_changed" {
  // A mode switch grants the agent session a different privilege set. Device
  // Config State Change cannot carry the AI Operation profile, so it cannot
  // name the agent on the one event where that is the question; Authorize
  // Session models the grant directly.
  _permission_to = move $event.otel.permission_to?
  $event.ocsf.category_uid = 3
  $event.ocsf.class_uid = 3003
  $event.ocsf.activity_id = 1
  $event.ocsf.type_uid = 300301
  $event.ocsf.actor = _actor
  $event.ocsf.user = _actor.user
  $event.ocsf.session = _actor.session
  // Qualified like Codex's approval policy: a permission mode governs whether
  // the agent must ask, so the two products answer the same question in the
  // same vocabulary.
  $event.ocsf.privileges = [f"approval:{_permission_to}" if _permission_to != null else "approval:unknown"]
  $event.ocsf.severity_id = 3 if _permission_to == "bypassPermissions" else 1
  $event.ocsf.message = f"Agent session permission mode set to {_permission_to else "unknown"}"
  $event.ocsf.metadata.profiles = ["ai_operation"]
  $event.ocsf.ai_agent = _ai_agent
} else if $event.otel.event_name == "skill_activated" {
  // A skill entering the context is a capability change on the agent, and the
  // skill document is the agent's charter for that capability. The telemetry
  // reports no content hash of the loaded skill, so charter integrity cannot
  // be attested.
  _skill_name = move $event.otel.skill_name? else "Unknown"
  $event.ocsf.category_uid = 6
  $event.ocsf.class_uid = 6002
  $event.ocsf.activity_id = 6
  $event.ocsf.type_uid = 600206
  $event.ocsf.application = {name: _skill_name}
  $event.ocsf.message = f"Skill {_skill_name} activated for the agent"
  $event.ocsf.metadata.profiles = ["ai_operation"]
  $event.ocsf.ai_agent = {..._ai_agent, charter: {name: _skill_name, type_id: 1}}
} else if $event.otel.event_name == "hook_registered" {
  // A hook registered on the agent is a command wired into the agent's
  // lifecycle for the session, the same capability change as a plugin or a
  // skill being enabled. The registration names the lifecycle event and the
  // tool matcher but not the command it will run.
  _hook_matcher = $event.otel.hook_matcher?
  _hook_event = $event.otel.hook_event? else "Unknown"
  _hook_label = f"{_hook_event}:{_hook_matcher}" if _hook_matcher != null else _hook_event
  $event.ocsf.category_uid = 6
  $event.ocsf.class_uid = 6002
  $event.ocsf.activity_id = 6
  $event.ocsf.type_uid = 600206
  $event.ocsf.application = {name: _hook_label}
  $event.ocsf.message = f"Hook {_hook_label} registered on the agent"
  $event.ocsf.metadata.profiles = ["ai_operation"]
  $event.ocsf.ai_agent = _ai_agent
} else if $event.otel.event_name in ["hook_execution_start", "hook_execution_complete"] {
  // A hook run is the harness executing one or more local commands, so it is
  // Process Activity: the start is the Launch and the completion the
  // Terminate. The source reports the hook group's name but no command line,
  // PID or execution id, so `process.cmd_line` is the empty string OCSF
  // requires when it is unavailable, `process.uid` stays empty, and the two
  // events cannot be paired beyond session, hook name and time. A group can
  // run several hooks; the counts are in `unmapped`.
  _hook_completed = $event.otel.event_name == "hook_execution_complete"
  _hook_name = move $event.otel.hook_name? else $event.otel.hook_event? else "Unknown"
  $event.ocsf.category_uid = 1
  $event.ocsf.class_uid = 1007
  $event.ocsf.activity_id = 2 if _hook_completed else 1
  $event.ocsf.type_uid = 100702 if _hook_completed else 100701
  $event.ocsf.launch_type_id = 0 if not _hook_completed else null
  $event.ocsf.process = {
    name: _hook_name,
    cmd_line: "",
    created_time: $event.otel.time if not _hook_completed else null,
    terminated_time: $event.otel.time if _hook_completed else null,
  }
  $event.ocsf.message = f"Agent hook {_hook_name} " + (
    ("completed" if $event.otel.success? != false else "failed") if _hook_completed else "started")
  $event.ocsf.actor = _actor
  $event.ocsf.device = _device
  $event.ocsf.message_context = {..._message_context, ai_role_id: 4}
  $event.ocsf.metadata.profiles = ["ai_operation"]
  $event.ocsf.ai_agent = _ai_agent
} else if $event.otel.event_name == "plugin_loaded" {
  // Loading a plugin enables a capability on the agent for the session, the
  // same lifecycle verb as a skill activation. No content hash is reported,
  // so plugin integrity is not attestable.
  $event.ocsf.category_uid = 6
  $event.ocsf.class_uid = 6002
  $event.ocsf.activity_id = 6
  $event.ocsf.type_uid = 600206
  _plugin_name = move $event.otel.plugin_name? else "Unknown"
  $event.ocsf.application = {
    name: _plugin_name,
    // `application` has no `vendor_name`; the marketplace the plugin came from
    // is the product identity behind it. `product` constrains itself to at
    // least one of `name` or `uid`, so the product carries the plugin name and
    // the marketplace as its vendor.
    product: {name: _plugin_name, vendor_name: move $event.otel.plugin_marketplace?},
  }
  $event.ocsf.message = f"Plugin {_plugin_name} enabled for the agent"
  $event.ocsf.metadata.profiles = ["ai_operation"]
  $event.ocsf.ai_agent = _ai_agent
} else if $event.otel.event_name == "tool_decision" and
          $event.otel.process_name? == null and
          $event.otel.remote_tool? == true {
  // Local shell decisions fall through to Process Activity below. A remote
  // decision stays API Activity with the capability name as the API
  // operation, but its action is the authorization, not the invocation: the
  // result record reports the invocation as `Invoke`. Two distinct labels keep
  // one call from counting as two invocations while both records remain
  // independently emitted, however far apart they arrive.
  _decision_operation = $event.otel.api_operation? else $event.otel.tool_name? else $event.otel.event_name
  $event.ocsf.category_uid = 6
  $event.ocsf.class_uid = 6003
  $event.ocsf.activity_id = 99
  $event.ocsf.activity_name = "Authorize"
  $event.ocsf.type_uid = 600399
  // `tool_source` does not belong in `api.service.name`: that field identifies
  // the serving system. The provisioning source has no normalized OCSF 1.9
  // destination and stays in `unmapped`.
  $event.ocsf.api = {
    operation: _decision_operation,
    request: {
      uid: move $event.otel.tool_use_id?,
    },
  }
  if $event.otel.request_data? != null {
    $event.ocsf.api.request.data = move $event.otel.request_data
    drop $event.otel.tool_input?,
         $event.otel.tool_parameters?,
         $event.otel.arguments?
  }
  _decision_parts = _decision_operation.split("__") if _decision_operation.starts_with("mcp__") else []
  _decision_server = $event.otel.api_service? else
                     _decision_parts[1]? if _decision_parts.length() >= 3 else
                     null
  if _decision_server != null {
    $event.ocsf.api.service = {name: _decision_server}
    $event.ocsf.dst_endpoint = {svc_name: _decision_server}
  }
  $event.ocsf.actor = _actor
  // API Activity requires `src_endpoint`; the agent host is the source of the
  // call the decision governs.
  $event.ocsf.src_endpoint = {
    hostname: $event.otel.resource.host_name?,
    svc_name: $event.otel.resource.service_name,
  }
  $event.ocsf.message = f"Tool call {_decision_operation} " + (
    "allowed" if _decision_status_id == 1 else
    "denied" if _decision_status_id == 2 else "decided")
  $event.ocsf.message_context = {..._message_context, ai_role_id: 3}
  $event.ocsf.metadata.profiles = ["ai_operation"]
  $event.ocsf.ai_agent = _ai_agent
} else if $event.otel.file_operation? != null and $event.otel.file_path? != null {
  let $activity_ids = {create: 1, read: 2, update: 3, delete: 4, rename: 5}
  $event.ocsf.category_uid = 1
  $event.ocsf.class_uid = 1001
  $event.ocsf.activity_id = $activity_ids[$event.otel.file_operation]
  $event.ocsf.type_uid = 100100 + $event.ocsf.activity_id
  $event.ocsf.actor = _actor
  $event.ocsf.device = _device
  $event.ocsf.file = {
    name: move $event.otel.file_name,
    path: move $event.otel.file_path,
    type_id: move $event.otel.file_type_id? else 1,
    is_deleted: true if $event.otel.file_operation == "delete" else null,
  }
  $event.ocsf.file_diff = move $event.otel.file_diff?
  if $event.otel.file_new_path? != null {
    // A rename names the file before in `file` and the file after in
    // `file_result`.
    $event.ocsf.file_result = {
      name: $event.otel.file_new_path.split("/")[-1],
      path: move $event.otel.file_new_path,
      type_id: 1,
    }
  }
  let $file_verbs = {create: "created", read: "read", update: "updated", delete: "deleted", rename: "renamed"}
  $event.ocsf.message = f"Agent searched files under {$event.ocsf.file.path}" if $event.otel.search_pattern? != null else
                        f"Agent {$file_verbs[$event.otel.file_operation]} file {$event.ocsf.file.name}"
  $event.ocsf.metadata.profiles = ["ai_operation"]
  $event.ocsf.ai_agent = _ai_agent
} else if $event.otel.process_name? != null {
  // Claude Code's Bash tool describes one top-level shell invocation. Keep
  // that invocation in Process Activity for request, completion and the
  // background status observation, so the whole lifecycle shares one class
  // and one `process.uid`. A background result says the launched process is
  // still running: it is neither a second Launch nor a Terminate, so it is
  // `Other` with `Observe` as the label. Keeping it here rather than in API
  // Activity also avoids presenting a local tool name as an API operation.
  _process_result = $event.otel.event_name == "tool_result"
  _process_running = _process_result and $event.otel.background? == true
  _process_completed = _process_result and not _process_running
  $event.ocsf.category_uid = 1
  $event.ocsf.class_uid = 1007
  $event.ocsf.activity_id = 2 if _process_completed else 99 if _process_running else 1
  $event.ocsf.activity_name = "Observe" if _process_running else null
  $event.ocsf.type_uid = 100702 if _process_completed else 100799 if _process_running else 100701
  // Claude Code does not report the operating-system creation primitive.
  $event.ocsf.launch_type_id = 0 if not _process_result else null
  if _process_running {
    // `success=true` describes delivery of the status observation, not the
    // outcome of the process, which is still unknown.
    $event.ocsf.status_id = 0
  }
  _process_uid = f"anthropic:claude-code:{$event.otel.tool_use_id}" if ($event.otel.tool_use_id? else "") != "" else null
  // The id is now on `process.uid`; keeping it in `unmapped` too would
  // duplicate a mapped value.
  drop $event.otel.tool_use_id?
  $event.ocsf.process = {
    name: move $event.otel.process_name,
    cmd_line: move $event.otel.command? else "",
    uid: _process_uid,
    created_time: $event.otel.start_time? else
                  $event.otel.time - $event.otel.duration * 1ms if _process_completed and $event.otel.duration? != null else
                  null,
    terminated_time: $event.otel.time? if _process_completed else null,
    // `process.pid` is intentionally absent. `tool_use_id` is the producer's
    // correlation identifier, not an operating-system PID.
  }
  $event.ocsf.message = "Agent shell process terminated" if _process_completed else
                        "Agent observed that the shell process is still running" if _process_running else
                        "Agent shell process launch denied" if _decision_status_id == 2 else
                        "Agent requested a shell process"
  $event.ocsf.actor = _actor
  $event.ocsf.device = _device
  $event.ocsf.message_context = {..._message_context, ai_role_id: 3}
  $event.ocsf.metadata.profiles = ["ai_operation"]
  $event.ocsf.ai_agent = _ai_agent
} else if $event.otel.event_name in [
  "api_request",
  "api_error",
  "api_request_body",
  "api_response_body",
  "claude_code.llm_request",
  "claude_code.interaction",
  "user_prompt",
  "assistant_response",
  "mcp_server_connection",
] or $event.otel.remote_tool? == true or
  ($event.otel.http_method? else "") != "" or
  $event.otel.span_type? == "llm_request" {
  _api_operation = $event.otel.http_method? else
                   $event.otel.api_operation? else
                   $event.otel.tool_name? else
                   $event.otel.event_name
  // Only an explicit statement of the operation names the activity: an HTTP
  // verb, or a record that is the model call itself or connection setup
  // (`Create`, including the failed model call `api_error` and the request
  // and response body records of one call), so that counting `Create` counts
  // model calls. A conversation turn is not an API call: the user's input is
  // `Other` with `Prompt` and the model's reply `Other` with `Respond`, which
  // is also what `message_context.ai_role` says about them. Everything else
  // is `Other` with a fixed verb as the label and the name of the thing in
  // `api.operation`: `activity_name` is the action, never a tool or event
  // name. Guessing read/write intent from the shape of a name misclassifies:
  // a tool called `cleanup_stale_records` would read as `Read` and then drop
  // a table.
  _http_verb = ($event.otel.http_method? else "").to_lower()
  _api_activity_id = 2 if _http_verb in ["get", "head"] else
                     3 if _http_verb in ["put", "patch"] else
                     4 if _http_verb == "delete" else
                     1 if _http_verb == "post" or $event.otel.event_name in [
                            "mcp_server_connection",
                            "api_request",
                            "api_error",
                            "api_request_body",
                            "api_response_body",
                            "claude_code.llm_request",
                          ] or $event.otel.span_type? == "llm_request" else
                     99
  $event.ocsf.category_uid = 6
  $event.ocsf.class_uid = 6003
  $event.ocsf.activity_id = _api_activity_id
  // A `tool.blocked_on_user` span is the wait for a person to decide, which
  // no log record reports with a duration. It is neither the decision (the
  // `tool_decision` log, `Authorize`) nor the call (the result, `Invoke`).
  $event.ocsf.activity_name = "Invoke" if _api_activity_id == 99 and ($event.otel.tool_name? else "") != "" else
                              "Prompt" if $event.otel.event_name in ["user_prompt", "claude_code.interaction"] else
                              "Respond" if $event.otel.event_name == "assistant_response" else
                              _api_operation if _api_activity_id == 99 else null
  $event.ocsf.type_uid = 600300 + _api_activity_id
  // Interim: for MCP and remote tool calls `api.operation` carries the
  // capability name (`take_screenshot`), not the protocol operation
  // (`tools/call`, `resources/read`). That collapses different MCP primitives
  // on the same server into one string. The target home is `ai_tool.name` /
  // `ai_tool.service.name` from ocsf/ocsf-schema#1729; move the capability
  // there once it lands and keep `api.service.name` as the server identity.
  // See ocsf/ocsf-schema#1736 for the discussion.
  $event.ocsf.api = {
    operation: _api_operation,
    request: {
      uid: move $event.otel.request_id? else move $event.otel.tool_use_id?,
    },
  }
  if $event.otel.request_data? != null {
    $event.ocsf.api.request.data = move $event.otel.request_data
    drop $event.otel.tool_input?,
         $event.otel.tool_parameters?,
         $event.otel.arguments?
  }
  $event.ocsf.message = "User prompted the agent" if $event.otel.event_name in ["user_prompt", "claude_code.interaction"] else
                        "Agent responded to the user" if $event.otel.event_name == "assistant_response" else
                        "Agent called the model" if $event.otel.event_name == "claude_code.llm_request" else
                        "Agent called the vendor API" if $event.otel.event_name in ["api_request", "api_request_body", "api_response_body"] else
                        "Agent vendor API call failed" if $event.otel.event_name == "api_error" else
                        f"Agent connected to MCP server {$event.otel.server_name? else "unknown"}" if $event.otel.event_name == "mcp_server_connection" else
                        f"Agent sent an HTTP {_api_operation} request" if ($event.otel.http_method? else "") != "" else
                        f"Agent called tool {_api_operation}"
  $event.ocsf.actor = _actor
  $event.ocsf.src_endpoint = {
    hostname: $event.otel.resource.host_name?,
    svc_name: $event.otel.resource.service_name,
  }
  if $event.otel.event_name == "mcp_server_connection" {
    $event.ocsf.dst_endpoint = {
      svc_name: $event.otel.server_name?,
    }
    $event.ocsf.status_id = 1 if $event.otel.source_status == "connected" else
                            2 if $event.otel.source_status in ["failed", "error"] else
                            0
  }
  if $event.otel.server_address? != null or $event.otel.server_port? != null {
    $event.ocsf.dst_endpoint = {
      hostname: $event.otel.server_address.string() if $event.otel.server_address? != null else null,
      port: $event.otel.server_port?,
    }
  }
  // The serving MCP server goes into `api.service.name` and
  // `dst_endpoint.svc_name` on every MCP event, matching the connection events.
  // `mcp__<server>__<tool>`. A malformed name yields no server, and the tool
  // name is already on `api.operation` (interim, see above), so publishing it
  // as a service name would only put the wrong kind of value in `dst_endpoint`.
  _mcp_parts = $event.otel.tool_name.split("__") if ($event.otel.tool_name? else "").starts_with("mcp__") else []
  _mcp_server = $event.otel.api_service? else
                $event.otel.server_name? else
                (_mcp_parts[1]? if _mcp_parts.length() >= 3 else null)
  if _mcp_server != null {
    $event.ocsf.api.service = {name: _mcp_server}
    $event.ocsf.dst_endpoint = {
      ...($event.ocsf.dst_endpoint? else {}),
      svc_name: _mcp_server,
    }
  }
  if $event.otel.target_resource_uris? != null {
    $event.ocsf.resources = (move $event.otel.target_resource_uris).map(uri => {
      uid: uri,
      type: $event.otel.target_resource_type?,
      role_id: 1,
    })
  }
  _total_tokens = $event.otel.input_tokens + $event.otel.output_tokens if
                  $event.otel.input_tokens? != null and
                  $event.otel.output_tokens? != null else
                  null
  $event.ocsf.message_context = {
    ..._message_context,
    prompt_tokens: move $event.otel.input_tokens?,
    completion_tokens: move $event.otel.output_tokens?,
    total_tokens: _total_tokens,
  }
  // #1674 gave conversation text a schema home in 1.9; the hash stays in
  // `unmapped.content_hash` as the integrity handle, which has none yet.
  if $event.otel.event_name in ["user_prompt", "claude_code.interaction"] {
    $event.ocsf.message_context.prompt_text = move $event.otel.content?
  } else if $event.otel.event_name == "assistant_response" {
    $event.ocsf.message_context.response_text = move $event.otel.content?
  }
  $event.ocsf.metadata.profiles = ["ai_operation"]
  $event.ocsf.ai_agent = _ai_agent
  if ($event.otel.trace_id? else "") != "" {
    $event.ocsf.trace = {
      uid: move $event.otel.trace_id,
      service: {
        name: $event.otel.resource.service_name,
        version: $event.otel.resource.service_version?,
      },
      // `span.start_time` and `span.end_time` are required, and only a span
      // record has them. A log emitted inside a span knows the context but not
      // the span's lifetime, so it carries the trace alone and its `span_id`
      // stays in `unmapped`.
      span: {
        uid: move $event.otel.span_id,
        parent_uid: move $event.otel.parent_span_id?,
        operation: $event.otel.event_name,
        start_time: $event.otel.start_time,
        end_time: $event.otel.end_time,
        duration: $event.otel.duration?,
        status_code: $event.otel.status_code.string() if $event.otel.status_code? != null else null,
      } if $event.otel.signal? == "trace" and $event.otel.start_time? != null and $event.otel.end_time? != null else null,
    }
    $event.ocsf.metadata.profiles = ["ai_operation", "trace"]
  }
} else {
  // A local tool the schema has no class for (`Skill`, `Agent`, `CronCreate`,
  // or a file tool whose decision carries no path), or a finished subagent,
  // which is a local agent run rather than an API call. Base Event cannot
  // carry the AI Operation profile, so the agent identity is lost here, but
  // the governance outcome below and the tool name survive: a person
  // rejecting a `Skill` call is the same supervised-versus-autonomous signal
  // as on any other class. Hooks and subagents are the agent-layer set that
  // ocsf-schema#1704 is expected to give a class of its own.
  _fallback_tool = $event.otel.tool_name?
  $event.ocsf.category_uid = 0
  $event.ocsf.class_uid = 0
  $event.ocsf.activity_id = 99
  $event.ocsf.activity_name = $event.otel.event_name
  $event.ocsf.type_uid = 99
  $event.ocsf.message = f"Tool call {_fallback_tool} " + (
                          "allowed" if _decision_status_id == 1 else
                          "denied" if _decision_status_id == 2 else "decided") if $event.otel.event_name == "tool_decision" and _fallback_tool != null else
                        f"Tool call {_fallback_tool} " + (
                          "succeeded" if $event.otel.success? == true else
                          "failed" if $event.otel.success? == false else "completed") if $event.otel.event_name == "tool_result" and _fallback_tool != null else
                        f"Subagent {$event.otel.agent_type? else "unknown"} " + (
                          "completed" if $event.otel.success? != false else "failed") if $event.otel.event_name == "subagent_completed" else
                        f"Code edit tool {_fallback_tool} " + (
                          "allowed" if _decision_status_id == 1 else
                          "denied" if _decision_status_id == 2 else "decided") if $event.otel.metric_name? == "claude_code.code_edit_tool.decision" else
                        f"Metric {$event.otel.metric_name} ({$event.otel.metric_type}): {$event.otel.metric_value}" if $event.otel.signal? == "metric" and $event.otel.metric_type? != null else
                        f"Metric {$event.otel.metric_name}: {$event.otel.metric_value}" if $event.otel.signal? == "metric" else
                        $event.otel.event_name
}

// The Security Control profile carries the governance outcome on the event
// the decision governed. `disposition_id` is what separates an autonomous
// action from a supervised one: an interactive source (`user_*`, `User`) means
// a person decided (Approved/Rejected), anything else means a rule fired
// (Allowed/Blocked) and is named in `policy`. Base Event carries the profile
// too: a decision on a tool without a class is still a decision.
if _decision_status_id != null {
  // A decision without a named decider must not imply that a rule fired, so
  // its disposition stays `Unknown` and no `policy` is attached.
  $event.ocsf.action_id = _decision_status_id
  $event.ocsf.authorizations = _authorizations
  $event.ocsf.disposition_id = (8 if _human_decision else 1 if _policy_decision else 0) if _decision_status_id == 1 else
                               (25 if _human_decision else 2 if _policy_decision else 0)
  if _policy_decision {
    // Neither product names the rule that fired, so `name` stays empty rather
    // than repeating the decider. `type` is where the kind of decider belongs.
    $event.ocsf.policy = {
      type: $event.otel.decision_source,
      is_applied: true,
    }
  }
  $event.ocsf.metadata.profiles = [...($event.ocsf.metadata.profiles? else []), "security_control"]
}

// Base Event has neither the AI Operation profile nor an actor, so the session
// and the tool name would otherwise survive only in `raw_data`. They are
// restored into `unmapped` after the drop below.
_base_session_id = $event.otel.session_id? if $event.ocsf.class_uid == 0 else null
_base_tool_name = $event.otel.tool_name? if $event.ocsf.class_uid == 0 else null
_base_model = $event.otel.model? if $event.ocsf.class_uid == 0 else null
_base_agent_type = $event.otel.agent_type? if $event.ocsf.class_uid == 0 else null
_scope_version = move $event.otel.scope.version?
_host_arch = move $event.otel.resource.host_arch?
_os_type = move $event.otel.resource.os_type?
_os_version = move $event.otel.resource.os_version?
if $event.otel.signal? == "metric" or $event.ocsf.trace?.span? != null {
  // Metric duration already populated the OCSF aggregation window. A mapped
  // trace duration is on `trace.span.duration` with real span boundaries.
  drop $event.otel.duration?
} else if $event.otel.duration? != null {
  // Logs do not carry the span boundaries needed by the Trace profile.
  // Preserve the provider's explicit unit without using aggregate duration.
  $event.otel.duration_ms = move $event.otel.duration
}

// Values that feed multiple OCSF fields cannot be moved into a single target.
// Remove them after all target fields have been populated. The full unrolled
// OTLP event, including its original attributes, remains in `raw_data`.
drop $event.otel.event_name?,
     $event.otel.time?,
     $event.otel.observed_time?,
     $event.otel.start_time?,
     $event.otel.end_time?,
     $event.otel.event_sequence?,
     $event.otel.session_id?,
     $event.otel.prompt_id?,
     $event.otel.user_id?,
     $event.otel.user_uid_alt?,
     $event.otel.user_email?,
     $event.otel.organization_id?,
     $event.otel.app_version?,
     $event.otel.app_entrypoint?,
     $event.otel.terminal_type?,
     $event.otel.model?,
     $event.otel.provider?,
     $event.otel.permission_to?,
     $event.otel.server_name?,
     $event.otel.source_status?,
     $event.otel.plugin_name?,
     $event.otel.plugin_marketplace?,
     $event.otel.hook_name?,
     $event.otel.skill_name?,
     $event.otel.agent_type?,
     $event.otel.tool_name?,
     $event.otel.api_operation?,
     $event.otel.api_service?,
     $event.otel.remote_tool?,
     // `tool_use_id` is not dropped here: the API and process branches move it
     // into `api.request.uid` and `process.uid`, and on every other class it
     // stays in `unmapped` as the only join key to the call's decision.
     $event.otel.request_data?,
     $event.otel.target_resource_uris?,
     $event.otel.target_resource_type?,
     $event.otel.file_path?,
     $event.otel.file_name?,
     $event.otel.file_operation?,
     $event.otel.process_name?,
     $event.otel.command?,
     $event.otel.background?,
     $event.otel.decision?,
     $event.otel.success?,
     $event.otel.request_id?,
     $event.otel.http_method?,
     $event.otel.http_status?,
     $event.otel.server_address?,
     $event.otel.server_port?,
     $event.otel.startup_status?,
     $event.otel.input_tokens?,
     $event.otel.output_tokens?,
     $event.otel.trace_id?,
     $event.otel.status_code?,
     $event.otel.status_message?,
     $event.otel.error?,
     $event.otel.error_type?,
     $event.otel.source_status_code?,
     $event.otel.severity_text?,
     $event.otel.scope?,
     $event.otel.resource?,
     $event.otel.attributes?,
     // Normalization artifacts rather than source attributes: `signal` drives
     // the log/trace dispatch and `transport` feeds `metadata.log_format`.
     // `decision_source` already lands in `authorizations[].policy.type`.
     $event.otel.signal?,
     $event.otel.transport?,
     $event.otel.decision_source?

if _base_session_id != null {
  $event.otel.session_id = _base_session_id
}
if _base_tool_name != null {
  $event.otel.tool_name = _base_tool_name
}
if _base_model != null {
  $event.otel.model = _base_model
}
if _base_agent_type != null {
  $event.otel.agent_type = _base_agent_type
}
if (_scope_version? else "") != "" {
  $event.otel.scope = {version: _scope_version}
}
if _host_arch? != null or _os_type? != null or _os_version? != null {
  $event.otel.resource = {
    host_arch: _host_arch,
    os_type: _os_type,
    os_version: _os_version,
  }
}

$event = {...$event.ocsf, unmapped: drop_null_fields($event.otel)}
