---
description: Maps api authorization fields.
args:
  positional:
    - name: claude_code
      type: field
      description: The canonical claude_code event to consume.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

// Separate Authorize from Invoke so a decision and result do not count as two calls.
$ocsf._mapping.decision_operation = $claude_code.api_operation? else $claude_code.tool_name? else $claude_code.event_name
$ocsf.category_uid = 6
$ocsf.class_uid = 6003
$ocsf.activity_id = 99
$ocsf.activity_name = "Authorize"
// tool_source describes provisioning, not the serving API.
$ocsf.api = {
  operation: $ocsf._mapping.decision_operation,
  request: {
    uid: move $claude_code.tool_use_id?,
  },
}
if $claude_code.request_data? != null {
  $ocsf.api.request.data = move $claude_code.request_data
  drop $claude_code.tool_input?,
       $claude_code.tool_parameters?,
       $claude_code.arguments?
}
$ocsf._mapping.decision_parts = $ocsf._mapping.decision_operation.split("__") if $ocsf._mapping.decision_operation.starts_with("mcp__") else []
$ocsf._mapping.decision_server = $claude_code.api_service? else
                   $ocsf._mapping.decision_parts[1]? if $ocsf._mapping.decision_parts.length() >= 3 else
                   null
if $ocsf._mapping.decision_server != null {
  $ocsf.api.service = {name: $ocsf._mapping.decision_server}
  $ocsf.dst_endpoint = {svc_name: $ocsf._mapping.decision_server}
}
$ocsf.actor = $ocsf._mapping.actor
$ocsf.src_endpoint = {
  hostname: $claude_code.resource.host_name?,
  svc_name: $claude_code.resource.service_name,
}
$ocsf.message = f"Tool call {$ocsf._mapping.decision_operation} " + (
  "allowed" if $ocsf._mapping.decision_status_id == 1 else
  "denied" if $ocsf._mapping.decision_status_id == 2 else "decided")
$ocsf.message_context = {...$ocsf._mapping.message_context, ai_role_id: 3}
$ocsf.metadata.profiles = ["ai_operation"]
$ocsf.ai_agent = $ocsf._mapping.ai_agent
