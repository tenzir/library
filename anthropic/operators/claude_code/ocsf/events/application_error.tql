---
description: Maps application error fields.
args:
  positional:
    - name: claude_code
      type: field
      description: The canonical claude_code event to consume.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

$ocsf.category_uid = 6
$ocsf.class_uid = 6008
@name = "ocsf.application_error"
$ocsf.activity_id = 1
$ocsf.status_id = 2
$ocsf.severity_id = 3
$ocsf.message = $claude_code.error? else "API retries exhausted"
$ocsf.metadata.profiles = ["ai_operation", "host"]
$ocsf.actor = $ocsf._mapping.actor
anthropic::claude_code::ocsf::device $claude_code, $ocsf
anthropic::claude_code::ocsf::ai_agent $claude_code, $ocsf
