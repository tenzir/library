---
description: Maps plugin install fields.
args:
  positional:
    - name: claude_code
      type: field
      description: The canonical claude_code event to consume.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

$ocsf.category_uid = 6
$ocsf.class_uid = 6002
$ocsf.activity_id = 1
$ocsf.application = {
  name: move $claude_code.plugin_name? else "Unknown",
  uid: move $claude_code.plugin_uid?,
  version: move $claude_code.plugin_version?,
}
// The marketplace is provenance, not necessarily the plugin's vendor.
$ocsf.message = f"Plugin installation reported: {$ocsf.application.name}"
$ocsf.metadata.profiles = ["ai_operation", "host"]
$ocsf.actor = $ocsf._mapping.actor
$ocsf.device = $ocsf._mapping.device
$ocsf.ai_agent = $ocsf._mapping.ai_agent
