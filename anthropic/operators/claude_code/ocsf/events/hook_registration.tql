---
description: Maps hook registration fields.
args:
  positional:
    - name: claude_code
      type: field
      description: The canonical claude_code event to consume.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

// Registration enables a hook; it does not establish command execution.
$ocsf._mapping.hook_matcher = $claude_code.hook_matcher?
$ocsf._mapping.hook_event = $claude_code.hook_event? else "Unknown"
$ocsf._mapping.hook_label = f"{$ocsf._mapping.hook_event}:{$ocsf._mapping.hook_matcher}" if $ocsf._mapping.hook_matcher != null else $ocsf._mapping.hook_event
$ocsf.category_uid = 6
$ocsf.class_uid = 6002
$ocsf.activity_id = 6
$ocsf.application = {name: $ocsf._mapping.hook_label}
$ocsf.status_id = 1
$ocsf.message = f"Hook {$ocsf._mapping.hook_label} registered on the agent"
$ocsf.metadata.profiles = ["ai_operation", "host"]
$ocsf.actor = $ocsf._mapping.actor
$ocsf.device = $ocsf._mapping.device
$ocsf.ai_agent = $ocsf._mapping.ai_agent
