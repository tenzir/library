---
description: Normalizes native claude_code OTLP records to OCSF 1.9.0.
args:
  named:
    - name: include_content
      type: bool
      default: false
      description: Retain conversation text and tool input. Shell commands are always retained.
---

anthropic::claude_code::canonicalize include_content=$include_content
this = {claude_code: this}
raw_data = move claude_code.raw_data?
raw_data_size = move claude_code.raw_data_size?
anthropic::claude_code::ocsf::map claude_code, ocsf
this = {...ocsf, raw_data: raw_data, raw_data_size: raw_data_size}
