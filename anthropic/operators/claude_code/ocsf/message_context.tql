---
description: Maps shared claude_code context when used by an event.
args:
  positional:
    - name: claude_code
      type: field
      description: The canonical source event.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

$ocsf.message_context = $ocsf._mapping.message_context
drop $claude_code.app_entrypoint?, $claude_code.app_version?
