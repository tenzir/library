---
description: Builds shared OCSF context and decision state.
args:
  positional:
    - name: claude_code
      type: field
      description: The canonical claude_code event to consume.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

$ocsf.metadata = {
  event_code: $claude_code.event_name,
  log_format: "OTLP/gRPC" if $claude_code.transport? == "grpc" else
              "OTLP/HTTP" if $claude_code.transport? == "http" else
              "OTLP",
  log_provider: "OpenTelemetry",
  log_source: $claude_code.scope.name?,
  log_level: $claude_code.severity_text?,
  logged_time: $claude_code.observed_time?,
  // Only span_id identifies a source record; tool-call IDs identify shared invocations.
  original_event_uid: $claude_code.span_id? if $claude_code.signal? == "trace" else null,
  // Correlate by prompt/turn; keep session, invocation, and trace IDs separate.
  correlation_uid: $claude_code.prompt_id? if ($claude_code.prompt_id? else "") != "" else null,
  sequence: $claude_code.event_sequence?,
  tenant_uid: $claude_code.organization_id?,
  product: {
    name: "Claude Code",
    vendor_name: "Anthropic",
    version: $claude_code.resource.service_version? else $claude_code.app_version?,
  },
  version: "1.9.0",
}

$ocsf.time = $claude_code.time? else $claude_code.start_time? else $claude_code.observed_time?
// Top-level timing describes aggregates; discrete events use time and trace timing.
if $claude_code.signal? == "metric" {
  $ocsf.start_time = $claude_code.start_time?
  $ocsf.end_time = $claude_code.end_time?
  $ocsf.duration = $claude_code.duration?
  // Count occurrences, not token, cost, or duration totals.
  $ocsf.count = int($claude_code.metric_value) if $claude_code.metric_value? != null and $claude_code.metric_name? in [
                        "claude_code.session.count",
                        "claude_code.code_edit_tool.decision",
                      ] else null
}
$ocsf.message = $claude_code.event_name
$ocsf._mapping.decision = ($claude_code.decision? else "").to_lower()
$ocsf._mapping.decision_status_id = 1 if $ocsf._mapping.decision in ["accept", "approved", "approved_for_session", "allow", "allowed"] else
                      2 if $ocsf._mapping.decision in ["deny", "denied", "reject", "rejected", "abort", "aborted"] else
                      null
// An unnamed decider must not imply either a person or a policy.
$ocsf._mapping.decision_source = ($claude_code.decision_source? else "").to_lower()
$ocsf._mapping.human_decision = $ocsf._mapping.decision_source.starts_with("user")
$ocsf._mapping.policy_decision = not $ocsf._mapping.human_decision and $ocsf._mapping.decision_source not in ["", "unknown"]
// Retain the source decision alongside its normalized outcome.
$ocsf._mapping.authorizations = [{
  decision: $claude_code.decision?,
  // The source identifies a control type, not a named rule.
  policy: {type: $claude_code.decision_source} if $ocsf._mapping.policy_decision else null,
}] if $claude_code.decision? != null else null

// Denials merit Low severity; a missing-file probe remains Informational.
$ocsf._mapping.missing_file_read = $claude_code.file_operation? == "read" and
                     ($claude_code.error? else "").starts_with("File does not exist")
$ocsf.severity_id = 1 if $ocsf._mapping.missing_file_read else
                          3 if $claude_code.success? == false or ($claude_code.http_status? != null and $claude_code.http_status >= 400) or $claude_code.status_code? == 2 else
                          2 if $ocsf._mapping.decision_status_id == 2 else 1
// Approval is not execution success; use result evidence for the outcome.
$ocsf.status_id = 1 if $claude_code.success? == true or
                             ($claude_code.http_status? != null and $claude_code.http_status < 400) or
                             $claude_code.status_code? == 1 else
                        2 if $claude_code.success? == false or
                             ($claude_code.http_status? != null and $claude_code.http_status >= 400) or
                             $claude_code.status_code? == 2 or
                             $ocsf._mapping.decision_status_id == 2 else
                        0
// Keep OTLP span status separate from the producer's error-code namespace.
$ocsf.status_code = $claude_code.source_status_code.string() if $claude_code.source_status_code? != null else
                          $claude_code.http_status.string() if $claude_code.http_status? != null else null
$ocsf.status_detail = $claude_code.error? else
                            $claude_code.error_type? else
                            $claude_code.status_message? else
                            $claude_code.startup_status? else
                            $claude_code.source_status?

$ocsf._mapping.actor = {
  application: {name: $claude_code.resource.service_name},
  session: {
    uid: $claude_code.session_id?,
    terminal: $claude_code.terminal_type?,
  },
  user: {
    uid: $claude_code.user_id?,
    uid_alt: $claude_code.user_uid_alt?,
    email_addr: $claude_code.user_email?,
  },
}
// Device requires host identity. Service names and collector peer IPs are not hosts.
$ocsf._mapping.device = {
  hostname: $claude_code.resource.host_name?,
  name: $claude_code.resource.host_name?,
  os: {
    name: $claude_code.resource.os_type?,
    version: $claude_code.resource.os_version?,
  } if $claude_code.resource.os_type? != null else null,
  // Host type is required but not reported.
  type_id: 0,
} if $claude_code.resource.host_name? != null else null
$ocsf._mapping.message_context = {
  uid: $claude_code.session_id?,
  name: $claude_code.prompt_id?,
  ai_role_id: 1 if $claude_code.event_name in ["user_prompt", "claude_code.interaction"] else
              2 if $claude_code.event_name == "assistant_response" else
              3 if $claude_code.tool_name? != null else
              4,
  application: {
    name: $claude_code.app_entrypoint? else $claude_code.resource.service_name,
    version: $claude_code.app_version?,
  },
  // The CLI is the client, not the service handling the request.
}
$ocsf._mapping.ai_agent = {
  // No authoritative agent UID is reported; do not substitute the runtime name.
  name: $claude_code.resource.service_name? else "Claude Code",
  instance_uid: $claude_code.session_id?,
  version: $claude_code.resource.service_version? else $claude_code.app_version?,
  type_id: 1,
  ai_model: {
    name: $claude_code.model,
    ai_provider: $claude_code.provider? else "Anthropic",
  } if ($claude_code.model? else "") != "" else null,
}
