---
description: Preserves governance and unmapped source fields.
args:
  positional:
    - name: claude_code
      type: field
      description: The canonical claude_code event to consume.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

// Distinguish human approval from policy decisions on the governed event.
if $ocsf._mapping.decision_status_id != null {
  // A decision without a named decider must not imply that a rule fired, so
  // its disposition stays `Unknown` and no `policy` is attached.
  $ocsf.action_id = $ocsf._mapping.decision_status_id
  $ocsf.authorizations = $ocsf._mapping.authorizations
  $ocsf.disposition_id = (8 if $ocsf._mapping.human_decision else 1 if $ocsf._mapping.policy_decision else 0) if $ocsf._mapping.decision_status_id == 1 else
                               (25 if $ocsf._mapping.human_decision else 2 if $ocsf._mapping.policy_decision else 0)
  if $ocsf._mapping.policy_decision {
    // Only the control type is reported, not the rule name.
    $ocsf.policy = {
      type: $claude_code.decision_source,
      is_applied: true,
    }
  }
  $ocsf.metadata.profiles = [...($ocsf.metadata.profiles? else []), "security_control"]
}

// Preserve agent details in unmapped where the AI Operation profile is unavailable.
$claude_code.tool_name = $claude_code.tool_name? if $ocsf.class_uid == 0 or $claude_code.tool_name? in ["Glob", "Grep"] else null
$claude_code.model = $claude_code.model? if $ocsf.class_uid == 0 else null
$claude_code.agent_type = $claude_code.agent_type? if $ocsf.class_uid == 0 else null
drop $claude_code.scope?
$claude_code.resource = {
  host_arch: $claude_code.resource.host_arch?,
  os_type: $claude_code.resource.os_type?,
  os_version: $claude_code.resource.os_version?,
} if $claude_code.resource.host_arch? != null or $claude_code.resource.os_type? != null or $claude_code.resource.os_version? != null else null
if $claude_code.signal? == "metric" or $ocsf.trace?.span? != null {
  // Drop duration only when aggregation or trace timing already carries it.
  drop $claude_code.duration?
} else if $claude_code.duration? != null {
  // Keep log duration_ms unmapped; logs lack the span boundaries required by Trace.
  $claude_code.duration_ms = move $claude_code.duration
}

// Drop shared inputs after all consumers; raw_data retains the source.
drop $claude_code.event_name?,
     $claude_code.time?,
     $claude_code.observed_time?,
     $claude_code.start_time?,
     $claude_code.end_time?,
     $claude_code.event_sequence?,
     $claude_code.session_id?,
     $claude_code.prompt_id?,
     $claude_code.user_id?,
     $claude_code.user_uid_alt?,
     $claude_code.user_email?,
     $claude_code.organization_id?,
     $claude_code.app_version?,
     $claude_code.app_entrypoint?,
     $claude_code.terminal_type?,
     $claude_code.provider?,
     $claude_code.permission_to?,
     $claude_code.server_name?,
     $claude_code.source_status?,
     $claude_code.plugin_name?,
     $claude_code.hook_name?,
     $claude_code.skill_name?,
     $claude_code.api_operation?,
     $claude_code.api_service?,
     $claude_code.remote_tool?,
     // Keep tool_use_id for correlation unless the API or process branch already moved it.
     $claude_code.request_data?,
     $claude_code.target_resource_uris?,
     $claude_code.target_resource_type?,
     $claude_code.file_path?,
     $claude_code.file_name?,
     $claude_code.file_operation?,
     $claude_code.process_name?,
     $claude_code.command?,
     $claude_code.background?,
     $claude_code.decision?,
     $claude_code.success?,
     $claude_code.request_id?,
     $claude_code.http_method?,
     $claude_code.http_status?,
     $claude_code.server_address?,
     $claude_code.server_port?,
     $claude_code.startup_status?,
     $claude_code.input_tokens?,
     $claude_code.output_tokens?,
     // Keep trace_id unless the API branch already moved it.
     $claude_code.status_code?,
     $claude_code.status_message?,
     $claude_code.error?,
     $claude_code.error_type?,
     $claude_code.source_status_code?,
     $claude_code.severity_text?,
     $claude_code.attributes?,
     $claude_code.signal?,
     $claude_code.transport?,
     $claude_code.decision_source?

// Keep request data under its input key when no request ID was reported.
if $ocsf.api?.request? != null and $ocsf.api.request.uid? == null {
  if $ocsf.api.request.data? != null {
    $claude_code.request_data = move $ocsf.api.request.data
  }
  drop $ocsf.api.request
}

$ocsf.unmapped = drop_null_fields(move $claude_code)
drop $ocsf._mapping

if $ocsf.metadata.loggers?.where(l => l.name? == null and l.uid? == null).length() > 0 {
  if $ocsf.metadata.loggers[0].version? != null {
    $ocsf.unmapped.scope.version = $ocsf.metadata.loggers[0].version
  }
  $ocsf.metadata.loggers = $ocsf.metadata.loggers.where(l => l.name? != null or l.uid? != null)
}

// Warn without dropping the event from the main pipeline.
fork {
  where $ocsf.category_uid == 1 and $ocsf.device? == null
  head 1
  assert false, message="Missing host identity for file/process activity: add host.name or host.id to the OpenTelemetry resource attributes (OTEL_RESOURCE_ATTRIBUTES). Emitting a Base Event."
  discard
}

// A system activity needs device identity. Preserve fields under their own
// keys when the producer omits the identity required by the mapped class.
if ($ocsf.category_uid == 1 and $ocsf.device? == null) or ($ocsf.class_uid in [3002, 3003] and $ocsf.user? == null) {
  $ocsf = {
    ...drop_null_fields({
      time: $ocsf.time,
      metadata: {...$ocsf.metadata, profiles: []},
      message: $ocsf.message?,
      raw_data: $ocsf.raw_data?,
      raw_data_size: $ocsf.raw_data_size?,
      severity_id: $ocsf.severity_id,
      status_id: $ocsf.status_id?,
      status_code: $ocsf.status_code?,
      status_detail: $ocsf.status_detail?,
      start_time: $ocsf.start_time?,
      end_time: $ocsf.end_time?,
      duration: $ocsf.duration?,
      count: $ocsf.count?,
    }),
    category_uid: 0, class_uid: 0, activity_id: 99, type_uid: 99,
    activity_name: $ocsf.metadata.event_code,
    unmapped: {
      ...$ocsf.unmapped?,
      ...$ocsf.entries().where(entry => entry.value != null and entry.key not in [
        "time", "metadata", "message", "raw_data",
        "raw_data_size", "severity_id", "status_id", "status_code",
        "status_detail", "start_time", "end_time", "duration",
        "count", "category_uid", "category_name", "class_uid",
        "class_name", "activity_id", "activity_name", "type_uid",
        "type_name", "severity", "unmapped",
      ]).map(entry => {
        key: entry.key,
        value: {...entry.value, ...($ocsf.unmapped? else {}).get(entry.key, null)}
          if type_kind(entry.value) == "record" and type_kind(($ocsf.unmapped? else {}).get(entry.key, null)) == "record"
          else ($ocsf.unmapped? else {}).get(entry.key, entry.value),
      }).collect_record().drop_null_fields(),
    },
  }
  @name = "ocsf.base_event"
}
