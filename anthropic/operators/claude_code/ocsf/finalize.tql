---
description: Preserves governance and unmapped source fields.
args:
  positional:
    - name: claude_code
      type: field
      description: The canonical claude_code event to consume.
    - name: ocsf
      type: field
      description: The destination OCSF event.
---

// Distinguish human approval from policy decisions on the governed event.
if $ocsf._mapping.decision_status_id != null {
  // A decision without a named decider must not imply that a rule fired, so
  // its disposition stays `Unknown` and no `policy` is attached.
  $ocsf.action_id = $ocsf._mapping.decision_status_id
  $ocsf.authorizations = $ocsf._mapping.authorizations
  $ocsf.disposition_id = (8 if $ocsf._mapping.human_decision else 1 if $ocsf._mapping.policy_decision else 0) if $ocsf._mapping.decision_status_id == 1 else
                               (25 if $ocsf._mapping.human_decision else 2 if $ocsf._mapping.policy_decision else 0)
  if $ocsf._mapping.policy_decision {
    // Only the control type is reported, not the rule name.
    $ocsf.policy = {
      type: $claude_code.decision_source,
      is_applied: true,
    }
  }
  $ocsf.metadata.profiles = [...($ocsf.metadata.profiles? else []), "security_control"]
  drop $claude_code.decision?
}

// Consume shared context only when it was emitted by this event builder.
drop $claude_code.event_name?, $claude_code.time?, $claude_code.observed_time?, $claude_code.transport?
// Attributes duplicate canonical inputs; signal is an internal discriminator.
drop $claude_code.attributes?, $claude_code.resource.service_name?, $claude_code.resource.service_version?
// Preserve unselected error details even when their values happen to match.
if $claude_code.error? != null {
  if $ocsf.status_detail? == $claude_code.error {
    drop $claude_code.error
  }
} else if $claude_code.error_type? != null {
  if $ocsf.status_detail? == $claude_code.error_type {
    drop $claude_code.error_type
  }
} else if $claude_code.status_message? != null {
  if $ocsf.status_detail? == $claude_code.status_message {
    drop $claude_code.status_message
  }
} else if $claude_code.startup_status? != null {
  if $ocsf.status_detail? == $claude_code.startup_status {
    drop $claude_code.startup_status
  }
} else if $claude_code.source_status? != null {
  if $ocsf.status_detail? == $claude_code.source_status {
    drop $claude_code.source_status
  }
}
if $claude_code.source_status_code? != null and $ocsf.status_code? == $claude_code.source_status_code.string() {
  drop $claude_code.source_status_code
}
if $claude_code.http_status? != null and $ocsf.status_code? == $claude_code.http_status.string() {
  drop $claude_code.http_status
}
if $ocsf.policy?.type? == $claude_code.decision_source? {
  drop $claude_code.decision_source?
}
if $claude_code.success? != null {
  // Status, or tool_success on background requests, carries this outcome.
  drop $claude_code.success
}
if $claude_code.signal? == "metric" or $ocsf.trace?.span? != null {
  drop $claude_code.duration?, $claude_code.start_time?, $claude_code.end_time?
} else if $claude_code.duration? != null {
  $claude_code.duration_ms = move $claude_code.duration
}
drop $claude_code.signal?
if $claude_code.resource? != null and drop_null_fields($claude_code.resource).is_empty() {
  drop $claude_code.resource
}
if $claude_code.scope? != null and drop_null_fields($claude_code.scope).is_empty() {
  drop $claude_code.scope
}
$ocsf.unmapped = drop_null_fields(move $claude_code)
drop $ocsf._mapping

// Warn once while preserving the known activity and all events.
fork {
  where $ocsf.category_uid == 1 and $ocsf.device? == null
  head 1
  assert false, message="Missing host identity for file/process activity: add host.name or host.id to the OpenTelemetry resource attributes (OTEL_RESOURCE_ATTRIBUTES). Host enrichment is required for complete OCSF file/process activity."
  discard
}
