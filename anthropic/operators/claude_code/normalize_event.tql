---
description: Normalizes a decoded Claude Code OTLP log or span.
args:
  named:
    - name: include_content
      type: bool
      default: false
      description: Retain prompts, responses, and copied tool parameters. Shell commands are always retained.
---

match signal {
  "log" => {
    where resource["service.name"] == "claude-code"
    anthropic::claude_code::normalize_logs include_content=$include_content
  }
  "trace" => {
    where resource["service.name"] == "claude-code"
    anthropic::claude_code::normalize_traces include_content=$include_content
    // Every Claude Code span repeats a log record. The decision and result
    // logs report each tool call with its outcome and duration, and the
    // `api_request`, `api_error`, `user_prompt` and `assistant_response`
    // logs report each model call and turn, with the prompt id and the cost
    // that the spans lack. What only a span carries (time to first token,
    // attempt number, stop reason, the approval wait) is not security
    // relevant, and the execution and wait spans name no tool at all in
    // current versions. Mapping the spans would only add one to three
    // duplicate events per call, so they are dropped here, on both the
    // native and the legacy envelope path.
    where not (tool_name? != null or (span_type? else "") in [
      "tool",
      "tool.execution",
      "tool.blocked_on_user",
      "llm_request",
      "interaction",
    ])
  }
  _ => {
    discard
  }
}
