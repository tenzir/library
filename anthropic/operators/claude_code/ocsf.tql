---
description: Converts native Claude Code OTLP record events to OCSF 1.9.0.
args:
  named:
    - name: include_content
      type: bool
      default: false
      description: Retain prompts, responses, and copied tool parameters. Shell commands are always retained.
---

anthropic::claude_code::normalize include_content=$include_content
// Decision and result logs form the lifecycle. A matching execution span is
// redundant and would create a third Process Activity event.
where not (signal? == "trace" and process_name? != null)
anthropic::claude_code::ocsf::map
