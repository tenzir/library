---
description: Builds a canonical claude_code record from native OTLP input.
args:
  named:
    - name: event
      type: field
      default: this
      description: The native record to canonicalize.
    - name: include_content
      type: bool
      default: false
      description: Retain conversation text and tool input. Shell commands are always retained.
---

if @name == "otel.log" {
  $event._raw_data = $event.print_json()
  $event._transport = $event.receiver.transport?
  $event._resource_attributes = $event.resource.attributes
  $event._body = $event.body.string_value? else $event.body.json_value?
  $event.signal = "log"
  $event.transport = $event._transport
  $event.raw_data = $event._raw_data
  $event.raw_data_size = $event._raw_data.length_bytes()
  $event.body = $event._body
  $event.resource = $event._resource_attributes
  anthropic::claude_code::canonicalize::event event=$event, include_content=$include_content
} else if @name == "otel.span" {
  $event._raw_data = $event.print_json()
  $event._transport = $event.receiver.transport?
  $event._resource_attributes = $event.resource.attributes
  $event.signal = "trace"
  $event.transport = $event._transport
  $event.raw_data = $event._raw_data
  $event.raw_data_size = $event._raw_data.length_bytes()
  $event.event_name = $event.name
  $event.time = $event.start_time
  $event.span_kind = $event.kind_id
  $event.status_code = $event.status.code_id
  $event.status_message = $event.status.message?
  $event.resource = $event._resource_attributes
  anthropic::claude_code::canonicalize::event event=$event, include_content=$include_content
} else if @name.starts_with("otel.metric.") {
  anthropic::claude_code::canonicalize::metrics event=$event
} else {
  discard
}
