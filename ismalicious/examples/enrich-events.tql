// Replace this source with your own events. Each event costs one lookup, so
// deduplicate indicators before enriching larger volumes.
from {indicator: "192.0.2.1", event_id: "synthetic-example"}
each {
  ismalicious::check query=$this.indicator,
    api_credential=secret("ISMALICIOUS_API_CREDENTIAL")
  this = {...$this, ismalicious: this}
}
