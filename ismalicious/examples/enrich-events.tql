// Replace this synthetic event source with your security telemetry.
// Each IOC consumes one lookup; deduplicate before using this at larger volume.
from {indicator: "192.0.2.1", event_id: "synthetic-example"}
each parallel=1 {
  let $event = $this
  ismalicious::check query=$event.indicator,
    api_credential=secret("ISMALICIOUS_API_CREDENTIAL")
  this = {event: $event, ismalicious: this}
}
