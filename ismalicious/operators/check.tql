---
description: Looks up the reputation of an IP address, domain, URL, or file hash.
args:
  named:
    - name: query
      type: string
      description: The indicator to look up. The API detects its type.
    - name: api_credential
      type: secret
      description: Base64 of the isMalicious `apiKey:apiSecret` pair.
    - name: base_url
      type: string
      default: "https://api.ismalicious.com"
      description: The API base URL.
---

from_http f"{$base_url}/check?query={$query.encode_url()}&enrichment=standard",
  headers={"X-API-KEY": $api_credential} {
  read_json
}
