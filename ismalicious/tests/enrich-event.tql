---
fixtures: [ismalicious_api]
assertions:
  fixtures:
    ismalicious_api:
      query: "192.0.2.1"
---

from {indicator: "192.0.2.1", event_id: "synthetic-example"}
each {
  ismalicious::check query=$this.indicator, api_credential="synthetic-test-credential",
    base_url=env("ISMALICIOUS_TEST_URL")
  this = {...$this, ismalicious: this}
}
select indicator, event_id, ismalicious.evidence.verdict
