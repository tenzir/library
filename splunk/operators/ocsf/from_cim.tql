---
description: Translates a Splunk CIM record to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The CIM record to translate.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the OCSF event.
---

$into = $event
splunk::ocsf::cim::map event=$into
