---
description: OCSF Group Management (3006) → Splunk CIM Change Account Management
args:
  named:
    - name: event
      description: The field that holds the event to map.
      type: field
---

assert $event.ocsf.class_uid == 3006

$event.cim = {}

// --- CIM: data model attributes ---------------

$event.cim.tag = ["change", "account"]

// --- CIM: occurrence and action attributes ----

$event.cim._time = $event.ocsf.time
$event.cim.action = $event.ocsf.activity_name?.to_lower().replace(" ", "_") else "unknown"
$event.cim.change_type = "AAA"
$event.cim.status = $event.ocsf.status?.to_lower()
match $event.ocsf.status_id? {
  1 => {
    $event.cim.status = "success"
  }
  2 => {
    $event.cim.status = "failure"
  }
  _ => {}
}
$event.cim.result = $event.ocsf.status_detail? else $event.ocsf.status?
$event.cim.result_id = $event.ocsf.status_code? else $event.ocsf.status_id?.string()

// --- CIM: object attributes -------------------

$event.cim.object = $event.ocsf.subgroup?.name? else $event.ocsf.group?.name? else $event.ocsf.users?[0]?.name? else $event.ocsf.user?.name? else $event.ocsf.group?.uid?
$event.cim.object_id = $event.ocsf.subgroup?.uid? else $event.ocsf.group?.uid? else $event.ocsf.users?[0]?.uid? else $event.ocsf.user?.uid?
$event.cim.object_category = "group"
$event.cim.object_attrs = $event.ocsf.privileges?

// --- CIM: endpoint and user attributes --------

$event.cim.src = $event.ocsf.actor?.process?.device?.hostname? else $event.ocsf.actor?.process?.device?.ip? else $event.ocsf.actor?.process?.device?.name?
$event.cim.dest = $event.ocsf.device?.hostname? else $event.ocsf.device?.ip? else $event.ocsf.device?.name?
$event.cim.dvc = $event.ocsf.device?.hostname? else $event.ocsf.device?.ip? else $event.ocsf.device?.name?
// The members are the changed accounts. OCSF 1.9 lists them in `users`, which
// supersedes `user`. A legacy `user` counts too unless `users` lists the same
// account: the same `uid`, or the same `name` when either lacks a `uid`. The
// entry in `users` then stands for it. Like other multivalue CIM fields of
// this package, the member fields are lists: `user` names every member by
// name, or by ID without a name, while `user_name` and `user_type` list only
// the names and types that exist.
$event.members = [
  ...$event.ocsf.users?,
  ...([$event.ocsf.user] if $event.ocsf.user? != null and [...$event.ocsf.users?].where(member =>
      (member.uid? != null and $event.ocsf.user.uid? != null and member.uid? == $event.ocsf.user.uid?)
      or ((member.uid? == null or $event.ocsf.user.uid? == null) and member.name? != null and member.name? == $event.ocsf.user.name?)
    ).length() == 0 else []),
]
$event.cim.user = $event.members.map(member => member.name? else member.uid?).where(x => x != null)
$event.cim.user_name = $event.members.map(member => member.name?).where(x => x != null)
$event.cim.user_type = $event.members.map(member => member.type?).where(x => x != null)
drop $event.members
// Events without members, such as a created group, name no user.
$event.cim.user = $event.cim.user if $event.cim.user.length() > 0 else null
$event.cim.user_name = $event.cim.user_name if $event.cim.user_name.length() > 0 else null
$event.cim.user_type = $event.cim.user_type if $event.cim.user_type.length() > 0 else null
$event.cim.src_user = $event.ocsf.actor?.user?.name? else $event.ocsf.actor?.user?.uid?
$event.cim.src_user_name = $event.ocsf.actor?.user?.name?
$event.cim.src_user_type = $event.ocsf.actor?.user?.type?
$event.cim.user_agent = $event.ocsf.http_request?.user_agent?
$event.cim.vendor_account = $event.ocsf.cloud?.account?.uid?
$event.cim.vendor_region = $event.ocsf.cloud?.region?
splunk::cim::ocsf::helpers::product event=$event

// Windows Security events report the domain of the group as the target
// domain, and the domain of the subject for an event without group. The source domain is the domain
// of the subject. Both can hold an authority, such as `NT AUTHORITY`, or a
// computer name.
if $event.ocsf.metadata.product?.name? == "Microsoft-Windows-Security-Auditing" {
  $event.cim.dest_nt_domain = (
    $event.ocsf.group?.domain? if $event.ocsf.group? != null else $event.ocsf.actor?.user?.domain?
  )
  $event.cim.src_nt_domain = $event.ocsf.actor?.user?.domain?
}

// --- Finalize ---------------------------------

$event = $event.cim
