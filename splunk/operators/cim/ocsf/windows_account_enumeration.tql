---
description: OCSF Live Evidence Info (5040) of a Windows account or group enumeration (4797/4798/4799) → Splunk CIM Change Account Management
args:
  named:
    - name: event
      description: The field that holds the event to map.
      type: field
---

assert $event.ocsf.class_uid == 5040

$event.cim = {}

// --- CIM: data model attributes ---------------

$event.cim.tag = ["change", "account"]

// --- CIM: occurrence and action attributes ----

$event.cim._time = $event.ocsf.time
$event.cim.action = "read"
$event.cim.status = "success" if $event.ocsf.unmapped?.System?.Keywords? == "0x8020000000000000" else null

// --- CIM: object attributes -------------------

// 4797 and 4798 enumerate an account, 4799 the members of a group. CIM
// Account Management names the account that the event concerns as the user
// and the account that acts as the source user.
if $event.ocsf.query_evidence?.group? != null {
  $event.cim.object = $event.ocsf.query_evidence.group.name?
  $event.cim.object_id = $event.ocsf.query_evidence.group.uid?
  $event.cim.object_category = "group"
  $event.cim.dest_nt_domain = $event.ocsf.query_evidence.group.domain?
} else {
  $event.cim.object = $event.ocsf.query_evidence?.user?.name?
  $event.cim.object_id = $event.ocsf.query_evidence?.user?.uid?
  $event.cim.object_category = "user"
  $event.cim.dest_nt_domain = $event.ocsf.query_evidence?.user?.domain?
}
$event.cim.user = $event.cim.object else $event.cim.object_id
$event.cim.user_name = $event.cim.object

// --- CIM: endpoint and source user attributes -

// CIM Change has no process fields, so the caller process is the command.
$event.cim.dest = $event.ocsf.device?.hostname? else $event.ocsf.device?.ip? else $event.ocsf.device?.name?
$event.cim.dvc = $event.cim.dest
$event.cim.src_user = $event.ocsf.actor?.user?.name? else $event.ocsf.actor?.user?.uid?
$event.cim.src_user_name = $event.ocsf.actor?.user?.name?
$event.cim.src_user_type = $event.ocsf.actor?.user?.type?
$event.cim.src_nt_domain = $event.ocsf.actor?.user?.domain?
$event.cim.command = $event.ocsf.actor?.process?.path?
splunk::cim::ocsf::helpers::product event=$event

// --- Finalize ---------------------------------

$event = $event.cim
