---
description: OCSF status → Splunk CIM Change status
args:
  named:
    - name: event
      description: The field that holds the event to map.
      type: field
---

// CIM Change knows whether a change succeeded or failed. An unknown or other
// outcome reports no status.
match $event.ocsf.status_id? {
  1 => {
    $event.cim.status = "success"
  }
  2 => {
    $event.cim.status = "failure"
  }
  _ => {}
}
