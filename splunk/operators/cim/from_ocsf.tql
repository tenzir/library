---
description: Translates an OCSF 1.9 event to Splunk CIM.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The OCSF event to translate.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the CIM record.
---

$into = $event
splunk::cim::ocsf::map event=$into
