// A 4779 disconnect from a Remote Desktop session is RDP Activity, which has no
// CIM dataset, and passes through as OCSF.
from_file env("TENZIR_INPUT") {
  read_all
}
microsoft::windows::ocsf::normalize data
this = ocsf_cast(this)
splunk::cim::from_ocsf
select class_uid, activity_id, mapped = tag? != null
