from {
  tag: ["endpoint", "filesystem"],
  _time: 2026-01-01,
  action: "read",
  dest: "test-host",
  user: "alice",
}
paths = ["/tmp/readme", null]
unroll paths
file_path = paths
splunk::ocsf::from_cim
strict {
  this = ocsf_cast(ocsf_derive(this))
  assert class_uid == (1001 if file? != null else 0)
  if class_uid == 0 {
    assert unmapped.incomplete_activity.class_uid == 1001
    assert unmapped.ocsf_residue.file.type_id == 0
  } else {
    assert file.name == "readme"
  }
}
this = {class_uid: class_uid, file_name: file?.name?, candidate_class_uid: unmapped.incomplete_activity?.class_uid?}
sort class_uid
