// An OCSF Group Management (3006) Add User event mapped to the CIM Change
// dataset and back to OCSF. CIM reports the member as the changed object and
// the action as modified, so the event maps back as an Account Change of the
// member with the group in unmapped.
from_file env("TENZIR_INPUT") {
  read_json
}
this = ocsf_cast(this)
splunk::cim::from_ocsf
splunk::ocsf::from_cim
this = ocsf_cast(this)
