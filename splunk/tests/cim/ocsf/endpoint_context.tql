// Windows events as `microsoft::windows::ocsf::normalize` produces them,
// without captions. The shapes follow the documented events; all values are
// invented.
// - Sysmon 3: a connection that the process and user of the actor opened,
// - 1102: a cleared Security log, which names only the logging device.
from {
  activity_id: 1,
  actor: {
    process: {
      file: {name: "update.exe", path: "C:\\Users\\Public\\update.exe", type_id: 1},
      name: "update.exe",
      pid: 4300,
      uid: "{aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee}",
    },
    user: {domain: "EXAMPLE", name: "jdoe"},
  },
  category_uid: 4,
  class_uid: 4001,
  connection_info: {direction_id: 2, protocol_name: "tcp"},
  device: {hostname: "WKS01.example.test", type_id: 0},
  dst_endpoint: {ip: 198.51.100.20, port: 443},
  metadata: {
    event_code: "3",
    log_name: "Microsoft-Windows-Sysmon/Operational",
    product: {name: "Microsoft-Windows-Sysmon", vendor_name: "Microsoft"},
    version: "1.9.0",
  },
  severity_id: 1,
  src_endpoint: {ip: 192.0.2.10, port: 50300},
  time: 2025-06-02T10:00:00Z,
  type_uid: 400101,
}, {
  activity_id: 1,
  actor: {
    user: {domain: "EXAMPLE", name: "jdoe", uid: "S-1-5-21-1004336348-1177238915-682003330-1105"},
  },
  category_uid: 1,
  class_uid: 1008,
  device: {hostname: "DC01.example.test", type_id: 0},
  log_name: "Security",
  log_provider: "Microsoft-Windows-Eventlog",
  metadata: {
    event_code: "1102",
    log_name: "Security",
    product: {name: "Microsoft-Windows-Eventlog", vendor_name: "Microsoft"},
    version: "1.9.0",
  },
  severity_id: 1,
  status_id: 1,
  time: 2025-06-02T10:00:01Z,
  type_uid: 100801,
}
splunk::cim::from_ocsf
select tag, action, src, dest, dvc, user, process_id=process_id?,
  process_guid=process_guid?
