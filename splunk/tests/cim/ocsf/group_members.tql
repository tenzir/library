// Group Management members in CIM and back. `user` names every member by
// name or else by ID, `user_name` and `user_type` list the names and types
// that exist, and the reverse mapping restores names, IDs, and types.
// - a named and an ID-only member,
// - a legacy `user` that `users` already lists, with a `uid` in both, or
//   with a `name` in both and a `uid` in one,
// - a legacy `user` that `users` does not list.
from {
  users: [{uid: "S-1-5-21-1004336348-1177238915-682003330-1301", type: "User"}, {name: "bob", uid: "U-200", type: "System"}],
}, {
  user: {name: "bob", uid: "U-200"},
  users: [{name: "bob", type: "User", uid: "U-200"}],
}, {
  user: {name: "bob", uid: "U-200"},
  users: [{name: "bob", type: "User"}],
}, {
  user: {name: "carol", uid: "U-300"},
  users: [{name: "bob", uid: "U-200"}],
}
this = {
  activity_id: 1,
  category_uid: 3,
  class_uid: 3006,
  group: {name: "Finance", uid: "G-1"},
  metadata: {product: {name: "Directory", vendor_name: "Example"}, version: "1.9.0"},
  severity_id: 1,
  time: 2025-06-02T12:00:00Z,
  type_uid: 300601,
  ...this,
}
splunk::cim::from_ocsf this, into=cim
splunk::ocsf::from_cim cim, into=back
select user=cim.user, user_name=cim.user_name, user_type=cim.user_type,
  users=back.users?
