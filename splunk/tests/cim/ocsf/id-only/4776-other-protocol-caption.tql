// A 4776 credential validation whose producer named the Other protocol
// `Negotiate`; that caption stays.
from_file env("TENZIR_INPUT") {
  read_json
}
this = {ocsf: this, derived_ocsf: ocsf_derive(this)}
splunk::cim::from_ocsf ocsf, into=direct
splunk::cim::from_ocsf derived_ocsf, into=derived
select signature_id=direct.signature_id, signature=direct.signature,
  action=direct.action, authentication_method=direct.authentication_method,
  same_as_derived=direct == derived
