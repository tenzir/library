// A cleared Security log (1102), as `microsoft::windows::ocsf::normalize`
// produces it without captions, which names only the logging device. Values are
// invented.
from_file env("TENZIR_INPUT") {
  read_json
}
splunk::cim::from_ocsf
select tag, action, src, dest, dvc, user, process_id=process_id?,
  process_guid=process_guid?
