// A 4672 special privileges assignment, as
// `microsoft::windows::ocsf::normalize` produces it without captions, whose
// target domain is the computer. Values are invented.
from_file env("TENZIR_INPUT") {
  read_json
}
splunk::cim::from_ocsf
select signature_id=signature_id?, class_uid=class_uid?, dest_nt_domain=dest_nt_domain?,
  src_nt_domain=src_nt_domain?
