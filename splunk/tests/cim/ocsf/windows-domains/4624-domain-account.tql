// The target and source domains of a 4624 logon of a domain account, as
// `microsoft::windows::ocsf::normalize` produces it without captions. Values
// are invented.
from_file env("TENZIR_INPUT") {
  read_json
}
splunk::cim::from_ocsf
select signature_id=signature_id?, class_uid=class_uid?, dest_nt_domain=dest_nt_domain?,
  src_nt_domain=src_nt_domain?
