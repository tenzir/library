// A started task (TaskScheduler 100), as `microsoft::windows::ocsf::normalize`
// produces it without captions, changes nothing and stays OCSF. Values are
// invented.
from_file env("TENZIR_INPUT") {
  read_json
}
splunk::cim::from_ocsf
select tag=tag?, action=action?, object=object?, object_category=object_category?,
  command=command?, dest=dest?, user=user?, class_uid=class_uid?
