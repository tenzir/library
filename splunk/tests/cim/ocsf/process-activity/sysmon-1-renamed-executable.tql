// A Sysmon 1 launch with its own user and the original file name of a renamed
// executable, as `microsoft::windows::ocsf::normalize` produces it without
// captions. Values are invented.
from_file env("TENZIR_INPUT") {
  read_json
}
splunk::cim::from_ocsf
select tag, action, user, user_id, parent_user,
  process_name, original_file_name
