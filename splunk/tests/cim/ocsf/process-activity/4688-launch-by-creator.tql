// A 4688 launch, as `microsoft::windows::ocsf::normalize` produces it without
// captions, that names only the creator, whose account runs the process. Values
// are invented.
from_file env("TENZIR_INPUT") {
  read_json
}
splunk::cim::from_ocsf
select tag, action, user, user_id, parent_user,
  process_name, original_file_name
