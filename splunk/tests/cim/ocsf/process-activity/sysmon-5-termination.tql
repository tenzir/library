// A Sysmon 5 termination, as `microsoft::windows::ocsf::normalize` produces it
// without captions, which CIM cannot represent as an action. Values are
// invented.
from_file env("TENZIR_INPUT") {
  read_json
}
splunk::cim::from_ocsf
select tag, action, user, user_id, parent_user,
  process_name, original_file_name
