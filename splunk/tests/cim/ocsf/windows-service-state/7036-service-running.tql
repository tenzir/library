// A 7036 service that entered the running state, as
// `microsoft::windows::ocsf::normalize` produces it without captions. Values
// are invented.
from_file env("TENZIR_INPUT") {
  read_json
}
splunk::cim::from_ocsf
select tag=tag?, status=status?, service_name=service_name?, dest=dest?,
  class_uid=class_uid?
