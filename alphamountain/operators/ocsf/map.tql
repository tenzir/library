---
description: Maps alphaMountain rows to OCSF 1.9 OSINT Inventory Info.
args:
  positional:
    - name: event
      type: field
      description: The structured alphaMountain row to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---


$ocsf = {}
$event._state = {}

$event.osint = {
  src_url: "https://www.alphamountain.ai/api/",
  vendor_name: "alphaMountain",
}

if $event.uri? != null {
  $event.osint.value = move $event.uri
  $event.osint.type_id = 5
} else if $event.hostname? != null {
  $event.osint.value = move $event.hostname
  $event.osint.type_id = 2
} else if $event.domain? != null {
  $event.osint.value = move $event.domain
  $event.osint.type_id = 2
} else if $event.sections?.whois?.domain? != null {
  $event.osint.value = $event.sections.whois.domain
  $event.osint.type_id = 2
} else if $event.url? != null {
  $event.osint.value = move $event.url
  $event.osint.type_id = 5
} else {
  $event.osint.type_id = 0
}
if $event.osint.value? != null {
  $event._state.ip = ip($event.osint.value)
  if $event._state.ip? != null {
    $event.osint.value = $event._state.ip.string()
    $event.osint.type_id = 1
  }
  drop $event._state.ip
}

if $event.score? != null {
  $event._state.score = move $event.score
} else if $event.threat?.score? != null {
  $event._state.score = move $event.threat.score
} else if $event.sections?.threat?.score? != null {
  $event._state.score = move $event.sections.threat.score
}

if $event._state.score? != null {
  $event.osint.reputation = {
    base_score: $event._state.score,
    provider: "alphaMountain",
  }

  $event._state.score_floor = $event._state.score.int()
  match $event._state.score_floor {
    9 | 10 => {
      $event.osint.reputation.score_id = 10
    }
    8 => {
      $event.osint.reputation.score_id = 9
    }
    7 => {
      $event.osint.reputation.score_id = 8
    }
    6 => {
      $event.osint.reputation.score_id = 7
    }
    5 => {
      $event.osint.reputation.score_id = 6
    }
    4 => {
      $event.osint.reputation.score_id = 5
    }
    3 => {
      $event.osint.reputation.score_id = 4
    }
    2 => {
      $event.osint.reputation.score_id = 3
    }
    0 | 1 if $event._state.score > 0 => {
      $event.osint.reputation.score_id = 2
    }
    _ => {
      $event.osint.reputation.score_id = 1
    }
  }

  $event.osint.risk_score = $event._state.score.round().int()
  match $event._state.score_floor {
    8 | 9 | 10 => {
      $event.osint.severity_id = 4
    }
    6 | 7 => {
      $event.osint.severity_id = 3
    }
    3 | 4 | 5 => {
      $event.osint.severity_id = 2
    }
    _ => {
      $event.osint.severity_id = 1
    }
  }
  drop $event._state.score_floor
  drop $event._state.score
}

if $event.confidence? != null {
  $event._state.confidence = move $event.confidence
} else if $event.category?.confidence? != null {
  $event._state.confidence = move $event.category.confidence
} else if $event.sections?.category?.confidence? != null {
  $event._state.confidence = move $event.sections.category.confidence
}

if $event._state.confidence? != null {
  $event._state.confidence_decile = ($event._state.confidence * 10).int()
  match $event._state.confidence_decile {
    8 | 9 | 10 => {
      $event.osint.confidence_id = 3
    }
    5 | 6 | 7 => {
      $event.osint.confidence_id = 2
    }
    _ => {
      $event.osint.confidence_id = 1
    }
  }
  drop $event._state.confidence_decile
  drop $event._state.confidence
}

if $event.category_ids? != null {
  $event._state.category_ids = move $event.category_ids
  $event.osint.labels = move $event.category_labels?
} else if $event.categories? != null {
  $event._state.category_ids = move $event.categories
} else if $event.category?.categories? != null {
  $event._state.category_ids = move $event.category.categories
} else if $event.sections?.category?.categories? != null {
  $event._state.category_ids = move $event.sections.category.categories
}

if $event._state.category_ids? != null {
  $event.osint.category = $event._state.category_ids.map(id => id.string()).join(",")
  $event.osint.labels = $event.osint.labels? else $event._state.category_ids.map(id => f"alphaMountain category {id}")
  drop $event._state.category_ids
}

$event.osint.answers = [
  ...$event.sections?.dns?.ipv4?.map(ip => {
    class: "IN",
    type: "A",
    rdata: ip.string(),
  }),
  ...$event.sections?.dns?.ipv6?.map(ip => {
    class: "IN",
    type: "AAAA",
    rdata: ip.string(),
  }),
  ...$event.sections?.pdns?.where(x => x.ip? != null).map(x => {
    class: "IN",
    type: "A",
    rdata: x.ip.string(),
  }),
]
if $event.osint.answers.length() == 0 {
  drop $event.osint.answers
}

if $event.sections?.geo?.ipv4?.length() > 0 {
  $event._state.geo = $event.sections.geo.ipv4[0]
  $event.osint.location = {
    country: $event._state.geo.isoCode,
    lat: $event._state.geo.latLng[0],
    long: $event._state.geo.latLng[1],
    provider: "alphaMountain",
  }
  if $event._state.geo.asn? != null {
    $event.osint.autonomous_system = {
      number: $event._state.geo.asn.number,
      name: $event._state.geo.asn.organization,
    }
  }
  drop $event._state.geo
}

if $event.sections?.whois? != null {
  $event.osint.whois = {
    domain: move $event.sections.whois.domain?,
    registrar: move $event.sections.whois.registrar?,
    created_time: time(move $event.sections.whois.created?),
    last_seen_time: time(move $event.sections.whois.updated?),
  }
  $event.osint.expiration_time = time(move $event.sections.whois.expires?)
}

$event.osint.severity_id = $event.osint.severity_id? else 1
$event.osint.confidence_id = $event.osint.confidence_id? else 0

$ocsf = {}
$ocsf.activity_id = 2
$ocsf.actor = {
  app_name: "Tenzir",
}
$ocsf.category_uid = 5
$ocsf.class_uid = 5021
$ocsf.metadata = {
  product: {
    name: "alphaMountain API",
    vendor_name: "alphaMountain",
  },
  version: "1.9.0",
}
$ocsf.osint = [move $event.osint]
$ocsf.severity_id = 1
if $event.status? != null and type_of($event.status).kind == "string" {
  $ocsf.status = move $event.status
  match $ocsf.status {
    "Success" => {
      $ocsf.status_id = 1
    }
    _ => {
      $ocsf.status_id = 2
    }
  }
}
if $event.error? != null {
  $ocsf.status_id = 2
  $ocsf.status_detail = move $event.error
}
if ($event.has("score") and $event.score == null) or
   ($event.has("categories") and $event.categories == null) {
  $ocsf.status_id = 99
  $ocsf.status = "Removed"
  $ocsf.status_detail = "alphaMountain feed removal"
}
$ocsf.time = now()
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id


@name = "ocsf.osint_inventory_info"

drop $event._state
$ocsf.unmapped = move $event
