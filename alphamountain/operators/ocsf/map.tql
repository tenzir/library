---
description: Maps alphaMountain rows to OCSF 1.9 OSINT Inventory Info.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The structured alphaMountain row to map.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the OCSF event.
---


$into = {am: $into, ocsf: {}, state: {}}

$into.osint = {
  src_url: "https://www.alphamountain.ai/api/",
  vendor_name: "alphaMountain",
}

if $into.am.uri? != null {
  $into.osint.value = move $into.am.uri
  $into.osint.type_id = 5
} else if $into.am.hostname? != null {
  $into.osint.value = move $into.am.hostname
  $into.osint.type_id = 2
} else if $into.am.domain? != null {
  $into.osint.value = move $into.am.domain
  $into.osint.type_id = 2
} else if $into.am.sections?.whois?.domain? != null {
  $into.osint.value = $into.am.sections.whois.domain
  $into.osint.type_id = 2
} else if $into.am.url? != null {
  $into.osint.value = move $into.am.url
  $into.osint.type_id = 5
} else {
  $into.osint.type_id = 0
}
if $into.osint.value? != null {
  $into.state.ip = ip($into.osint.value)
  if $into.state.ip? != null {
    $into.osint.value = $into.state.ip.string()
    $into.osint.type_id = 1
  }
  drop $into.state.ip
}

if $into.am.score? != null {
  $into.state.score = move $into.am.score
} else if $into.am.threat?.score? != null {
  $into.state.score = move $into.am.threat.score
} else if $into.am.sections?.threat?.score? != null {
  $into.state.score = move $into.am.sections.threat.score
}

if $into.state.score? != null {
  $into.osint.reputation = {
    base_score: $into.state.score,
    provider: "alphaMountain",
  }

  $into.state.score_floor = $into.state.score.int()
  match $into.state.score_floor {
    9 | 10 => {
      $into.osint.reputation.score_id = 10
    }
    8 => {
      $into.osint.reputation.score_id = 9
    }
    7 => {
      $into.osint.reputation.score_id = 8
    }
    6 => {
      $into.osint.reputation.score_id = 7
    }
    5 => {
      $into.osint.reputation.score_id = 6
    }
    4 => {
      $into.osint.reputation.score_id = 5
    }
    3 => {
      $into.osint.reputation.score_id = 4
    }
    2 => {
      $into.osint.reputation.score_id = 3
    }
    0 | 1 if $into.state.score > 0 => {
      $into.osint.reputation.score_id = 2
    }
    _ => {
      $into.osint.reputation.score_id = 1
    }
  }

  $into.osint.risk_score = $into.state.score.round().int()
  match $into.state.score_floor {
    8 | 9 | 10 => {
      $into.osint.severity_id = 4
    }
    6 | 7 => {
      $into.osint.severity_id = 3
    }
    3 | 4 | 5 => {
      $into.osint.severity_id = 2
    }
    _ => {
      $into.osint.severity_id = 1
    }
  }
  drop $into.state.score_floor
  drop $into.state.score
}

if $into.am.confidence? != null {
  $into.state.confidence = move $into.am.confidence
} else if $into.am.category?.confidence? != null {
  $into.state.confidence = move $into.am.category.confidence
} else if $into.am.sections?.category?.confidence? != null {
  $into.state.confidence = move $into.am.sections.category.confidence
}

if $into.state.confidence? != null {
  $into.state.confidence_decile = ($into.state.confidence * 10).int()
  match $into.state.confidence_decile {
    8 | 9 | 10 => {
      $into.osint.confidence_id = 3
    }
    5 | 6 | 7 => {
      $into.osint.confidence_id = 2
    }
    _ => {
      $into.osint.confidence_id = 1
    }
  }
  drop $into.state.confidence_decile
  drop $into.state.confidence
}

if $into.am.category_ids? != null {
  $into.state.category_ids = move $into.am.category_ids
  $into.osint.labels = move $into.am.category_labels?
} else if $into.am.categories? != null {
  $into.state.category_ids = move $into.am.categories
} else if $into.am.category?.categories? != null {
  $into.state.category_ids = move $into.am.category.categories
} else if $into.am.sections?.category?.categories? != null {
  $into.state.category_ids = move $into.am.sections.category.categories
}

if $into.state.category_ids? != null {
  $into.osint.category = $into.state.category_ids.map(id => id.string()).join(",")
  $into.osint.labels = $into.osint.labels? else $into.state.category_ids.map(id => f"alphaMountain category {id}")
  drop $into.state.category_ids
}

$into.osint.answers = [
  ...$into.am.sections?.dns?.ipv4?.map(ip => {
    class: "IN",
    type: "A",
    rdata: ip.string(),
  }),
  ...$into.am.sections?.dns?.ipv6?.map(ip => {
    class: "IN",
    type: "AAAA",
    rdata: ip.string(),
  }),
  ...$into.am.sections?.pdns?.where(x => x.ip? != null).map(x => {
    class: "IN",
    type: "A",
    rdata: x.ip.string(),
  }),
]
if $into.osint.answers.length() == 0 {
  drop $into.osint.answers
}

if $into.am.sections?.geo?.ipv4?.length() > 0 {
  $into.state.geo = $into.am.sections.geo.ipv4[0]
  $into.osint.location = {
    country: $into.state.geo.isoCode,
    lat: $into.state.geo.latLng[0],
    long: $into.state.geo.latLng[1],
    provider: "alphaMountain",
  }
  if $into.state.geo.asn? != null {
    $into.osint.autonomous_system = {
      number: $into.state.geo.asn.number,
      name: $into.state.geo.asn.organization,
    }
  }
  drop $into.state.geo
}

if $into.am.sections?.whois? != null {
  $into.osint.whois = {
    domain: move $into.am.sections.whois.domain?,
    registrar: move $into.am.sections.whois.registrar?,
    created_time: time(move $into.am.sections.whois.created?),
    last_seen_time: time(move $into.am.sections.whois.updated?),
  }
  $into.osint.expiration_time = time(move $into.am.sections.whois.expires?)
}

$into.osint.severity_id = $into.osint.severity_id? else 1
$into.osint.confidence_id = $into.osint.confidence_id? else 0

$into.ocsf = {}
$into.ocsf.activity_id = 2
$into.ocsf.actor = {
  app_name: "Tenzir",
}
$into.ocsf.category_uid = 5
$into.ocsf.class_uid = 5021
$into.ocsf.metadata = {
  product: {
    name: "alphaMountain API",
    vendor_name: "alphaMountain",
  },
  version: "1.9.0",
}
$into.ocsf.osint = [move $into.osint]
$into.ocsf.severity_id = 1
if $into.am.status? != null and type_of($into.am.status).kind == "string" {
  $into.ocsf.status = move $into.am.status
  match $into.ocsf.status {
    "Success" => {
      $into.ocsf.status_id = 1
    }
    _ => {
      $into.ocsf.status_id = 2
    }
  }
}
if $into.am.error? != null {
  $into.ocsf.status_id = 2
  $into.ocsf.status_detail = move $into.am.error
}
if ($into.am.has("score") and $into.am.score == null) or
   ($into.am.has("categories") and $into.am.categories == null) {
  $into.ocsf.status_id = 99
  $into.ocsf.status = "Removed"
  $into.ocsf.status_detail = "alphaMountain feed removal"
}
$into.ocsf.time = now()
$into.ocsf.type_uid = $into.ocsf.class_uid * 100 + $into.ocsf.activity_id


@name = "ocsf.osint_inventory_info"

$into = {...$into.ocsf, unmapped: $into.am}
