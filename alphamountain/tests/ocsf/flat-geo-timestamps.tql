from {hostname: "example.test",
  sections: {first_seen: "2025-01-01T00:00:00Z", last_seen: "2025-01-02T00:00:00Z",
    geo: {isoCode: "US", latLng: [37.0, -97.0],
      asn: {number: 64500, organization: "EXAMPLE-NET"}}}}
source = this
alphamountain::ocsf::map source, ocsf
this = ocsf
ocsf_cast
select osint, unmapped
