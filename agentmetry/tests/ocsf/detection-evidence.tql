  actor: {type: "user", role: "operator"},
  agent: {name: "claude"},
},
{
  event_id: "system-actor",
  actor: {type: "system", id: "recorder"},
  agent: {name: "claude"},
},
{
  event_id: "unnamed-agent",
  actor: {type: "user", id: "alice"},
  agent: {name: null, custom: "keep"},
},
{
  event_id: "no-evidence",
}
timestamp_utc = 2026-11-02T18:13:18Z
correlation_id = "session-1"
