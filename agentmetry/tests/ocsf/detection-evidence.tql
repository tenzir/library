// An identified actor makes AI-agent evidence valid in OCSF 1.9. Retain
// attributes that cannot be mapped instead of inventing an identity.
from {
  event_id: "actor-and-agent",
  actor: {type: "user", id: "alice"},
  agent: {name: "claude", custom: "keep"},
},
{
  event_id: "actor-only",
  actor: {type: "user", id: "alice"},
},
{
  event_id: "agent-only",
  agent: {name: "claude", custom: "keep"},
},
{
