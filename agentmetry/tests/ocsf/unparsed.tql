// A record that nothing parsed, or that is not an Agentmetry event, becomes a
// Base Event, so no event disappears. A record keeps its fields under
// `unmapped`.
from {agentmetry: null},
     {agentmetry: {message: "not an Agentmetry event", level: 3}},
     {agentmetry: {timestamp_utc: "2026-11-02T18:13:18Z", message: "no action"}}
this = {...this, ocsf: {}}
agentmetry::ocsf::map agentmetry, ocsf
// Only timestamp-less test inputs get a dummy time; source time takes priority.
ocsf.time = ocsf.time else 1970-01-01T00:00:00Z
this = ocsf_cast(ocsf)
drop_null_fields
