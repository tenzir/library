from_file env("TENZIR_INPUT") {
  read_ndjson
}
this = {source: this, ocsf: {}}
agentmetry::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
this = {
  event_code: metadata.event_code,
  class_uid: class_uid,
  status_id: status_id,
  correlation_uid: metadata.correlation_uid,
  log_provider: metadata.log_provider,
  status_code: status_code?,
  status_detail: status_detail?,
  duration: duration?,
  invocation: unmapped.tool?.invocation?,
  result: unmapped.tool?.result?,
}
