// Missing and null optional fields need no defensive branches. Preserve
// unknown agent attributes rather than dropping the entire agent record.
from {
  action: {type: "detection", outcome: "unknown"},
  detection: {},
},
{
  action: {type: "detection", outcome: "unknown"},
  detection: {severity: null, first_seen_utc: null, last_seen_utc: null},
},
{
  action: {type: "tool_called", outcome: "success"},
  agent: {name: "claude", custom: "keep"},
},
{
  action: {type: "approval_response", outcome: "denied"},
  agent: {name: "claude"},
  tool: {name: "Read"},
},
{
  action: {type: "tool_called", outcome: "error", reason: null},
  agent: {name: "claude"},
  tool: {name: "list_files", server: "workspace"},
}
timestamp_utc = 2026-11-02T18:13:18Z
event_id = "optional-fields-event"
host_id = "dev-laptop"
actor = {type: "user", id: "alice"}
agentmetry::ocsf::normalize
this = ocsf_cast(this)
select class_uid, status_id, severity_id, disposition_id?, status_detail?,
       message, first_seen= finding_info?.first_seen_time?,
       last_seen= finding_info?.last_seen_time?,
       agent_extra=unmapped.agent?.custom?
