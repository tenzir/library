// Every event in the fixtures must satisfy the OCSF schema: `ocsf_cast` warns
// about each attribute that the schema does not know and each constraint that
// an event violates, and the snapshot records those warnings.
from_file f"{env("TENZIR_INPUTS")}/events.ndjson" {
  read_ndjson
}
agentmetry::ocsf::normalize
this = ocsf_cast(this)
summarize class_uid, activity_id, events=count()
sort class_uid, activity_id
