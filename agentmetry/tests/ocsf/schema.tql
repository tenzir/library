// Validate fixture events with OCSF functions. Required-field and constraint
// warnings stay visible in the expected output alongside the class counts.
from_file f"{env("TENZIR_INPUTS")}/events.ndjson" {
  read_ndjson
}
agentmetry::ocsf::normalize
this = ocsf_cast(this)
summarize class_uid, activity_id, events=count()
sort class_uid, activity_id
