// Cited tool calls add evidence without inventing execution or an actor. Keep
// the full snapshot, including outcomes and source sessions.
from_file env("TENZIR_INPUT") {
  read_ndjson
}
this = {source: this, original: detection.artifacts?}
agentmetry::ocsf::map source, ocsf
ocsf = ocsf_cast(ocsf)
artifact_evidence = (ocsf.evidences? else []).where(e => e.uid? != null)
select uid=ocsf.metadata.uid,
       source_retained=original == ocsf.unmapped.detection.artifacts?,
       evidence_count=artifact_evidence.length(),
       examples=artifact_evidence.slice(begin=0, end=2).map(e => {
         uid: e.uid, api: e.api?, file: e.file?, url: e.url?,
         actor: e.actor?, process: e.process?,
       })
sort uid
