// Model providers are client claims, not cloud infrastructure. Cover older
// values, the Agentmetry 0.11 app-name fallback, and optional account claims.
from {harness: "codex", model: {id: "codex", provider: "openai"}},
     {harness: "codex", model: {id: "gpt-5", provider: "codex"}, account: {
       domain: "example.com",
       source: "codex_auth",
       account_id: "workspace-1",
       user_id: "user-1",
     }},
     {harness: "codex", model: {id: "gpt-5", provider: "openai"}},
     {harness: "claude", model: {id: "claude", provider: "claude"}},
     {harness: "cursor", model: {id: "cursor", provider: "cursor"}, account: {
       domain: "example.com",
       source: "hook_payload",
       organization_id: "org-1",
     }},
     {harness: "codex"},
     {harness: "codex", model: null, account: null},
     {harness: "codex", model: {id: "", provider: ""}}
timestamp_utc = 2026-11-08T18:00:00Z
schema_version = "1.2.0"
host_id = "dev-laptop"
action = {type: "tool_called", outcome: "success"}
agent = {name: move harness}
actor = {type: "user", id: "operator-1"}
tool = {name: "list_files", server: "workspace"}
agentmetry::ocsf::normalize
this = ocsf_cast(this)
select cloud=cloud?, model=unmapped.model?, account=unmapped.account?,
       user=actor.user.uid
