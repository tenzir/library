---
description: |
  Maps an Agentmetry tool call, approval request, or approval response to OCSF.

  The tool decides the class. A shell tool starts a process, so it becomes
  Process Activity. A file tool becomes File System Activity when the event
  names the file. Agentmetry keeps only a hash of the tool arguments unless the
  operator turns on full capture, so a file tool without a path, an MCP tool,
  and every other tool become API Activity, with the tool as the operation.

  The outcome decides the rest:

  - A tool call that ran gets status Success, and one that failed gets status
    Failure with the reason.
  - A tool call that a policy denied is a Security Control that blocked it. The
    rule that matched becomes the policy.
  - An approval request is pending, so its status is Unknown.
  - An approval response is a person's decision: Approved or Rejected. A
    response that Agentmetry inferred, because the session ended with the
    request still open, was denied without a decision, so its disposition is
    Unknown.
args:
  positional:
    - name: agentmetry
      type: field
      description: The Agentmetry event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

let $shell_tools = [
  "bash", "shell", "powershell", "run_shell_command", "run_terminal_cmd",
  "exec_command", "shell_command", "execute_command", "local_shell",
]
let $file_activities = {
  read: 2,
  read_file: 2,
  view: 2,
  notebookread: 2,
  write: 1,
  write_file: 1,
  create_file: 1,
  write_to_file: 1,
  edit: 3,
  multiedit: 3,
  edit_file: 3,
  str_replace: 3,
  str_replace_editor: 3,
  notebookedit: 3,
}

// An approval that Agentmetry inferred at the end of a session names the gated
// tool in `gated_action` and carries no tool section.
if $agentmetry.tool? == null and $agentmetry.gated_action? != null {
  $agentmetry.tool = {
    name: move $agentmetry.gated_action.tool?,
    server: move $agentmetry.gated_action.server?,
    input_hash: move $agentmetry.gated_action.input_hash?,
  }
}
$ocsf._tool = $agentmetry.tool?.name?.to_lower()
$ocsf._path = $agentmetry.tool?.arguments?.file_path? else
              $agentmetry.tool?.arguments?.path? else
              $agentmetry.tool?.arguments?.target_file?
$ocsf._file_activity = $file_activities[$ocsf._tool]?
$ocsf._outcome = move $agentmetry.action.outcome
$ocsf._reason = move $agentmetry.action.reason?

match $ocsf.metadata.event_code {
  "approval_request" => {
    // Nobody has decided yet, and nothing has run.
    $ocsf.status_id = 0
    $ocsf._result = "requested"
  }
  "approval_response" => {
    // A decision is not an execution, so the status stays Unknown when the
    // person approves.
    if $ocsf._outcome == "success" {
      $ocsf.status_id = 0
      $ocsf.action_id = 1
      $ocsf.disposition_id = 8
      $ocsf._result = "approved"
    } else {
      $ocsf.status_id = 2
      $ocsf.action_id = 2
      $ocsf.disposition_id = 0 if $ocsf._reason.starts_with("inferred:") else 25
      $ocsf.status_detail = $ocsf._reason if $ocsf.disposition_id == 0 else null
      $ocsf._result = "inferred" if $ocsf.disposition_id == 0 else "rejected"
    }
  }
  _ => {
    match $ocsf._outcome {
      "success" => {
        $ocsf.status_id = 1
        $ocsf._result = "success"
      }
      "denied" => {
        $ocsf.status_id = 2
        $ocsf.status_detail = $ocsf._reason
        $ocsf.severity_id = 2
        $ocsf.action_id = 2
        $ocsf.disposition_id = 2
        $ocsf._result = "denied"
        if $agentmetry.tool_policy? != null {
          $ocsf.policy = {
            uid: move $agentmetry.tool_policy.rule_id?,
            is_applied: true,
          }
        } else if $ocsf._reason.starts_with("policy:") {
          $ocsf.policy = {
            name: $ocsf._reason.split(":")[1],
            is_applied: true,
          }
        }
      }
      _ => {
        $ocsf.status_id = 2
        $ocsf.status_detail = $ocsf._reason
        $ocsf.severity_id = 3
        $ocsf._result = "failed"
      }
    }
  }
}

if $ocsf._tool in $shell_tools {
  agentmetry::ocsf::events::process_activity $agentmetry, $ocsf
} else if $ocsf._path != null and $ocsf._file_activity != null {
  agentmetry::ocsf::events::file_activity $agentmetry, $ocsf
} else {
  agentmetry::ocsf::events::api_activity $agentmetry, $ocsf
}
drop $ocsf._tool, $ocsf._path, $ocsf._file_activity, $ocsf._outcome, $ocsf._reason, $ocsf._result
