---
description: |
  Agentmetry `mcp_schema` with outcome `changed` → OCSF Detection Finding
  (2004, Create).

  Agentmetry's MCP proxy fingerprints the `tools/list` of each server it sees.
  When the listing of a known server changes while its configuration may not
  have, the recorder emits this event: the shape of an MCP rug pull, where an
  approved tool changes under the same name. The fingerprint is the analytic,
  and the server is the resource. The recorder assigns no severity, so the
  finding has none either.
args:
  positional:
    - name: agentmetry
      type: field
      description: The Agentmetry event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

@name = "ocsf.detection_finding"
$ocsf.category_uid = 2
$ocsf.class_uid = 2004
$ocsf.activity_id = 1
$ocsf.status_id = 1
$ocsf.is_alert = true
$ocsf.action_id = 3
$ocsf.disposition_id = 15
$ocsf.severity_id = 0
drop $agentmetry.action.outcome, $agentmetry.mcp_schema.status?
$ocsf.finding_info = {
  uid: $ocsf.metadata.uid,
  title: "MCP tool listing changed",
  desc: move $agentmetry.action.reason?,
  analytic: {
    name: "MCP tools/list fingerprint",
    type_id: 5,
  },
}
$ocsf.resources = [{
  uid: move $agentmetry.mcp_schema.server_id?,
  type: "MCP server",
  version: move $agentmetry.mcp_schema.server_version?,
}]
$ocsf.message = $ocsf.finding_info.desc
