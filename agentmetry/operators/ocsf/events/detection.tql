---
description: |
  Agentmetry `detection` → OCSF Detection Finding (2004, Create).

  Agentmetry correlates tool calls within a session or across sessions on one
  host and emits a detection
  when a sequence rule matches, such as a credential read followed by network
  egress. The rule becomes the analytic, the calls it matched become the
  related events, and the ATT&CK tactics and techniques become `attacks`.
  MITRE ATLAS identifiers have no OCSF attribute and stay in the source event.
args:
  positional:
    - name: agentmetry
      type: field
      description: The Agentmetry event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

let $severities = {
  info: 1,
  informational: 1,
  low: 2,
  medium: 3,
  high: 4,
  critical: 5,
}

@name = "ocsf.detection_finding"
$ocsf.category_uid = 2
$ocsf.class_uid = 2004
$ocsf.activity_id = 1
$ocsf.status_id = 1
$ocsf.is_alert = true
$ocsf.action_id = 3
$ocsf.disposition_id = 15
$ocsf.severity_id = $severities[$agentmetry.detection.severity?.to_lower()]? else 0
// The outcome of a detection repeats its severity.
if $agentmetry.action.outcome? == $agentmetry.detection.severity? {
  drop $agentmetry.action.outcome
}
drop $agentmetry.detection.severity?
$ocsf.attacks = [
  ...(move $agentmetry.detection.technique_ids? else []).map(id => {
    technique: {uid: id.split(".")[0]},
    sub_technique: {uid: id} if id.split(".").length() > 1 else null,
  }),
  ...(move $agentmetry.detection.tactic_ids? else []).map(id => {
    tactic: {uid: id},
  }),
]
$ocsf.finding_info = {
  uid: $ocsf.metadata.uid,
  title: move $agentmetry.detection.title?,
  desc: move $agentmetry.detection.summary?,
  analytic: {
    uid: $agentmetry.detection.rule_id?,
    name: move $agentmetry.detection.rule_id?,
    type_id: 1,
  } if $agentmetry.detection.rule_id? != null,
  first_seen_time: time(move $agentmetry.detection.first_seen_utc?),
  last_seen_time: time(move $agentmetry.detection.last_seen_utc?),
  related_events: (move $agentmetry.detection.event_ids? else []).map(id => {uid: id}),
  // OCSF asks to duplicate the ATT&CK references of a security control into
  // the finding.
  attacks: $ocsf.attacks,
}
$ocsf.message = $ocsf.finding_info.desc
agentmetry::ocsf::actor $agentmetry, $ocsf
// OCSF 1.9 requires more than an AI agent to identify evidence. Without an
// identified actor, keep the agent under `unmapped` instead.
if $ocsf.actor? != null {
  $ocsf.evidences = [{
    actor: $ocsf.actor,
    ai_agent: {
      name: move $agentmetry.agent?.name?,
      instance_uid: $agentmetry.correlation_id?,
      type_id: 1,
    } if $agentmetry.agent?.name? != null,
  }]
}
// Version 1 snapshots describe reported tool-boundary observations, including
// denied calls. Retain them verbatim under unmapped so outcomes, inference
// markers, source sessions and omission counters stay attached to their IDs.
// Never assign the triggering actor to every cited event across sessions.
if $agentmetry.detection.artifacts?.version? == 1 and
   type_kind($agentmetry.detection.artifacts?.items?) == "list" {
  $ocsf._artifacts = $agentmetry.detection.artifacts.items.where(item => type_kind(item) == "record")
  $ocsf._artifacts = $ocsf._artifacts.where(item => item.action?.type? == "tool_called" and
                   type_kind(item.event_id?) == "string" and
                   type_kind(item.tool?) == "record")
  $ocsf._artifacts = $ocsf._artifacts.where(item => (type_kind(item.tool.name?) == "string" and item.tool.name != "") or
                   (type_kind(item.tool.qualified?) == "string" and item.tool.qualified != ""))
  $ocsf._artifacts = $ocsf._artifacts.map(item => {
    uid: item.event_id,
    operation: item.tool.name if type_kind(item.tool.name?) == "string" and item.tool.name != ""
               else item.tool.qualified,
    server: item.tool.server if type_kind(item.tool.server?) == "string" and
                               item.tool.server != item.source?.app? else null,
    path: item.tool.arguments?.file_path? else item.tool.arguments?.path? else
          item.tool.arguments?.target_file?,
    url: item.tool.arguments?.url?,
  })
  $ocsf._artifacts = $ocsf._artifacts.map(item => {
    uid: item.uid,
    api: {
      operation: item.operation,
      service: {name: item.server} if item.server != null,
    },
    file: {
      name: file_name(item.path.replace("\\", "/")),
      path: item.path,
      type_id: 0,
    } if type_kind(item.path) == "string" and item.path != "" and
         item.operation.to_lower() in [
           "read", "read_file", "view", "notebookread", "write", "write_file",
           "create_file", "write_to_file", "edit", "multiedit", "edit_file",
           "str_replace", "str_replace_editor", "notebookedit",
         ],
    url: {url_string: item.url} if type_kind(item.url) == "string" and item.url != "",
  })
  if $ocsf._artifacts.length() > 0 {
    $ocsf.evidences = [...$ocsf.evidences?, ...$ocsf._artifacts]
  }
  drop $ocsf._artifacts
}
// The summary is also the reason of the action, and the detection repeats the
// session that the event already names.
if $agentmetry.action.reason? == $ocsf.finding_info.desc {
  drop $agentmetry.action.reason
}
if $agentmetry.detection.correlation_id? == $agentmetry.correlation_id? {
  drop $agentmetry.detection.correlation_id
}
