---
description: |
  Agentmetry `detection` → OCSF Detection Finding (2004, Create).

  Agentmetry correlates the tool calls of one session and emits a detection
  when a sequence rule matches, such as a credential read followed by network
  egress. The rule becomes the analytic, the calls it matched become the
  related events, and the ATT&CK tactics and techniques become `attacks`.
  MITRE ATLAS identifiers have no OCSF attribute and stay in the source event.
args:
  positional:
    - name: agentmetry
      type: field
      description: The Agentmetry event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

let $severities = {
  info: 1,
  informational: 1,
  low: 2,
  medium: 3,
  high: 4,
  critical: 5,
}

@name = "ocsf.detection_finding"
$ocsf.category_uid = 2
$ocsf.class_uid = 2004
$ocsf.activity_id = 1
// A new finding that requires a closer look.
$ocsf.status_id = 1
// The recorder observed the sequence and detected it without intervening.
$ocsf.is_alert = true
$ocsf.action_id = 3
$ocsf.disposition_id = 15
$ocsf.severity_id = $severities[($agentmetry.detection.severity? else "").to_lower()]? else 0
// The outcome of a detection repeats its severity.
if $agentmetry.action.outcome? == $agentmetry.detection.severity? {
  drop $agentmetry.action.outcome
}
drop $agentmetry.detection.severity?
// Rules reference sub-techniques (`T1552.004`) and techniques (`T1071`) in one
// list and tactics (`TA0006`) in another.
$ocsf.attacks = [
  ...(move $agentmetry.detection.technique_ids? else []).map(id => {
    technique: {uid: id.split(".")[0]},
    sub_technique: {uid: id} if id.split(".").length() > 1 else null,
  }),
  ...(move $agentmetry.detection.tactic_ids? else []).map(id => {
    tactic: {uid: id},
  }),
]
$ocsf.finding_info = {
  uid: $ocsf.metadata.uid,
  title: move $agentmetry.detection.title?,
  desc: move $agentmetry.detection.summary?,
  analytic: {
    uid: $agentmetry.detection.rule_id?,
    name: move $agentmetry.detection.rule_id?,
    type_id: 1,
  },
  first_seen_time: time(move $agentmetry.detection.first_seen_utc) if $agentmetry.detection.first_seen_utc? != null else null,
  last_seen_time: time(move $agentmetry.detection.last_seen_utc) if $agentmetry.detection.last_seen_utc? != null else null,
  related_events: (move $agentmetry.detection.event_ids? else []).map(id => {uid: id}),
  // OCSF asks to duplicate the ATT&CK references of a security control into
  // the finding.
  attacks: $ocsf.attacks,
}
$ocsf.message = $ocsf.finding_info.desc
// The agent whose calls matched is the evidence, and the person it acted for
// is the actor.
if $agentmetry.actor?.type? == "user" {
  $ocsf.actor.user = {
    uid: move $agentmetry.actor.id,
  }
  drop $agentmetry.actor.type
  if $agentmetry.initiator?.operator_id? == $ocsf.actor.user.uid {
    drop $agentmetry.initiator.operator_id
  }
}
if $agentmetry.agent?.name? != null {
  $ocsf.evidences = [{
    ai_agent: {
      name: move $agentmetry.agent.name,
      instance_uid: $agentmetry.correlation_id?,
      type_id: 1,
    },
  }]
  if $agentmetry.agent.skill_id? == null {
    drop $agentmetry.agent
  }
}
// The summary is also the reason of the action, and the detection repeats the
// session that the event already names.
if $agentmetry.action.reason? == $ocsf.finding_info.desc {
  drop $agentmetry.action.reason
}
if $agentmetry.detection.correlation_id? == $agentmetry.correlation_id? {
  drop $agentmetry.detection.correlation_id
}
// Agentmetry adds the analyst's triage verdict once someone has triaged the
// detection.
if $agentmetry.detection.disposition? == null {
  drop $agentmetry.detection.disposition?
}
if $agentmetry.detection.is_empty() {
  drop $agentmetry.detection
}
