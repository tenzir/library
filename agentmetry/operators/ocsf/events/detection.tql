---
description: |
  Agentmetry `detection` → OCSF Detection Finding (2004, Create).

  Agentmetry correlates tool calls within a session or across sessions on one
  host and emits a detection when a sequence rule matches, such as a credential
  read followed by network egress. The rule becomes the analytic, the calls it
  matched become the related events, and the ATT&CK tactics and techniques
  become `attacks`.
  MITRE ATLAS identifiers have no OCSF attribute and stay in the source event.
args:
  positional:
    - name: agentmetry
      type: field
      description: The Agentmetry event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

let $severities = {
  info: 1,
  informational: 1,
  low: 2,
  medium: 3,
  high: 4,
  critical: 5,
}

@name = "ocsf.detection_finding"
$ocsf.category_uid = 2
$ocsf.class_uid = 2004
$ocsf.activity_id = 1
$ocsf.status_id = 1
$ocsf.is_alert = true
$ocsf.action_id = 3
$ocsf.disposition_id = 15
$ocsf.severity_id = $severities[$agentmetry.detection.severity?.to_lower()]? else 0
// The outcome of a detection repeats its severity.
if $agentmetry.action.outcome? == $agentmetry.detection.severity? {
  drop $agentmetry.action.outcome
}
drop $agentmetry.detection.severity?
$ocsf.attacks = [
  ...(move $agentmetry.detection.technique_ids? else []).map(id => {
    technique: {uid: id.split(".")[0]},
    sub_technique: {uid: id} if id.split(".").length() > 1 else null,
  }),
  ...(move $agentmetry.detection.tactic_ids? else []).map(id => {
    tactic: {uid: id},
  }),
]
$ocsf.finding_info = {
  uid: $ocsf.metadata.uid,
  title: move $agentmetry.detection.title?,
  desc: move $agentmetry.detection.summary?,
  analytic: {
    uid: $agentmetry.detection.rule_id?,
    name: move $agentmetry.detection.rule_id?,
    type_id: 1,
  } if $agentmetry.detection.rule_id? != null,
  first_seen_time: time(move $agentmetry.detection.first_seen_utc?),
  last_seen_time: time(move $agentmetry.detection.last_seen_utc?),
  related_events: (move $agentmetry.detection.event_ids? else []).map(id => {uid: id}),
  // OCSF asks to duplicate the ATT&CK references of a security control into
  // the finding.
  attacks: $ocsf.attacks,
}
$ocsf.message = $ocsf.finding_info.desc
agentmetry::ocsf::actor $agentmetry, $ocsf
// OCSF 1.9 requires more than an AI agent to identify evidence. Without an
// identified actor, keep the agent under `unmapped` instead.
if $ocsf.actor? != null {
  $ocsf.evidences = [{
    actor: $ocsf.actor,
    ai_agent: {
      name: move $agentmetry.agent?.name?,
      instance_uid: $agentmetry.correlation_id?,
      type_id: 1,
    } if $agentmetry.agent?.name? != null,
  }]
}
// Cited calls can stem from other sessions, so they don't inherit the actor.
if $agentmetry.detection.artifacts?.version? == 1 {
  $ocsf.evidences = [
    ...$ocsf.evidences?,
    ...$agentmetry.detection.artifacts.items?
      .where(item => item.action?.type? == "tool_called")
      .map(item => {
        uid: item.event_id?,
        operation: item.tool?.name? else item.tool?.qualified?,
        server: item.tool?.server?,
        app: item.source?.app?,
        path: item.tool?.arguments?.file_path? else
              item.tool?.arguments?.path? else
              item.tool?.arguments?.target_file?,
        url: item.tool?.arguments?.url?,
      })
      .where(call => call.uid != null and call.operation != null)
      .map(call => {
        uid: call.uid,
        api: {
          operation: call.operation,
          // Built-in tools name their harness as server.
          service: {name: call.server} if call.server not in [null, call.app],
        },
        file: {
          name: file_name(call.path),
          path: call.path,
          type_id: 0,
        } if call.path != null and
             call.operation.to_lower() in agentmetry::$file_activities.keys(),
        url: {url_string: call.url} if call.url != null,
      }),
  ]
}
// The summary is also the reason of the action, and the detection repeats the
// session that the event already names.
if $agentmetry.action.reason? == $ocsf.finding_info.desc {
  drop $agentmetry.action.reason
}
if $agentmetry.detection.correlation_id? == $agentmetry.correlation_id? {
  drop $agentmetry.detection.correlation_id
}
