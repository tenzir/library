---
description: Agentmetry shell tool call → OCSF Process Activity (1007, Launch).
args:
  positional:
    - name: agentmetry
      type: field
      description: The Agentmetry event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

@name = "ocsf.process_activity"
$ocsf.category_uid = 1
$ocsf.class_uid = 1007
$ocsf.activity_id = 1
// The agent asks its harness to run a command. The harness does not report
// how the operating system creates the process.
$ocsf.launch_type_id = 0

// The command is the process command line. A tool name only names the
// process when it is the shell itself.
$ocsf.process = {
  name: $ocsf._tool if $ocsf._tool in ["bash", "powershell"] else null,
  cmd_line: move $agentmetry.tool.command?,
}
agentmetry::ocsf::ai_agent $agentmetry, $ocsf
$ocsf.message = {
  requested: "Agent asked for approval to run a shell command",
  approved: "Agent shell command approved",
  rejected: "Agent shell command rejected",
  inferred: "Agent shell command was still awaiting approval when the session ended",
  denied: "Agent shell command denied",
  failed: "Agent shell command failed",
  success: "Agent ran a shell command",
}[$ocsf._result]
