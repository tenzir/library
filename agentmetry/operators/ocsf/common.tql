---
description: |
  Builds the OCSF attributes that every Agentmetry event shares.

  This covers the event time and identifiers, the host that the recorder runs
  on, and the hash-chain position of a trail line. The caller sets the product
  identity.

  Agentmetry groups the events of one agent session under `correlation_id`,
  which becomes the OCSF correlation UID. The trail position becomes the
  sequence number, while the chain hashes stay under `unmapped`: they cover the
  Agentmetry event, not the OCSF event, so an OCSF attestation would not
  verify against them.
args:
  positional:
    - name: agentmetry
      type: field
      description: The Agentmetry event to read.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

$ocsf.metadata.event_code = move $agentmetry.action.type
$ocsf.metadata.uid = move $agentmetry.event_id?
$ocsf.metadata.correlation_uid = $agentmetry.correlation_id?
$ocsf.metadata.tenant_uid = move $agentmetry.fleet_id?
$ocsf.metadata.log_version = move $agentmetry.schema_version?
$ocsf.metadata.log_provider = move $agentmetry.source?.adapter?
$ocsf.metadata.sequence = move $agentmetry.trail?.seq?
// A JSON reader infers the timestamp, a record literal does not.
$ocsf.time = time(move $agentmetry.timestamp_utc)
if $agentmetry.host_id? != null {
  $ocsf.device = {
    hostname: move $agentmetry.host_id,
    type_id: 0,
  }
}
