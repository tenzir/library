---
fixtures: [taxii_date_added_server]
assertions:
  fixtures:
    taxii_date_added_server:
      limit: 2
      match_type: "identity,indicator & +/=?#ü"
---

// Preserve numeric values and reserved/Unicode characters in both the first
// query and every date-added pagination query, without requiring `entries`.
stix::taxii::fetch f"{env("TAXII_DATE_ADDED_URL")}indicators/objects/",
  params={limit: 2, "match[type]": "identity,indicator & +/=?#ü"}
select type, id
