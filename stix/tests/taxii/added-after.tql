---
pre-compare: sort
fixtures: [taxii_server]
assertions:
  fixtures:
    taxii_server:
      added_after: "2026-09-01T00:00:00Z"
---

stix::taxii::fetch env("TAXII_TEST_URL"),
  headers={Authorization: "Basic c3ludGhldGljOnRlc3Q="},
  params={added_after: "2026-09-01T00:00:00Z"}
where type == "indicator"
stix::ocsf::normalize
this = {
  class_uid: class_uid,
  value: osint?[0]?.value?,
  pattern: unmapped.incomplete_activity?.osint?[0]?.detection_pattern?,
  status: status?,
}
