---
fixtures: [taxii_date_added_server]
assertions:
  fixtures:
    taxii_date_added_server:
      match_type: "indicator"
---

// The server omits `next`, so the operator pages by date added and keeps the
// original query parameters.
stix::taxii::fetch env("TAXII_DATE_ADDED_URL"),
  params={"match[type]": "indicator"}
select type, id
