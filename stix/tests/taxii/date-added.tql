---
fixtures: [taxii_date_added_server]
assertions:
  fixtures:
    taxii_date_added_server:
      added_after: "2026-09-01T10:00:00.000001Z"
      limit: 2
      match_type: "identity,indicator"
---

// The server omits `next`, so the operator replaces the initial `added_after`
// with the date added of each page and keeps the other parameters.
stix::taxii::fetch f"{env("TAXII_DATE_ADDED_URL")}indicators/objects/",
  params={
    added_after: "2026-09-01T10:00:00.000001Z",
    limit: 2,
    "match[type]": "identity,indicator",
  }
select type, id
