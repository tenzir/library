---
description: |
  Fetches the objects of a TAXII 2.1 collection and emits one event per STIX
  object.

  The operator follows the `next` token until the server reports no more pages.
  Servers without `next` tokens page by date added: the operator then requests
  the objects added after the `X-TAXII-Date-Added-Last` response header.

  ```tql
  stix::taxii::fetch "https://taxii.example.com/api-root/collections/indicators/objects/",
    params={added_after: "2026-10-01T00:00:00Z", "match[type]": "indicator"}
  ```
args:
  positional:
    - name: url
      type: string
      description: The objects endpoint of the collection, such as `https://taxii.example.com/api-root/collections/<id>/objects/`.
  named:
    - name: headers
      default: {}
      description: Additional request headers, such as `Authorization`.
    - name: params
      default: {}
      description: |
        Query parameters for every page, such as `added_after`, `limit`, or
        `match[type]`. Values must be strings or numbers.
    - name: paginate_delay
      type: duration
      default: 0s
      description: The time to wait between pages, for servers with rate limits.
---

let $taxii_headers = {
  Accept: "application/taxii+json;version=2.1",
  ...$headers,
}
// URL-encode the parameters: TAXII filters such as `match[type]` take
// comma-separated values, and timestamps can contain `+`.
from {params: $params}
pairs = params.entries().map(param => {
  key: param.key,
  pair: f"{param.key.encode_url()}={string(param.value).encode_url()}",
})
this = {
  query: pairs.map(param => param.pair).join("&"),
  filters: pairs.where(param => param.key != "added_after").map(param => param.pair),
}
each {
  from_http f"{$url}?{$this.query}",
    headers=$taxii_headers,
    paginate_delay=$paginate_delay,
    paginate=(page => page.next_url?) {
    // Parse the complete page: `read_json` rejects multi-byte characters that
    // span two network chunks.
    read_all
    this = data.parse_json()
    let $response_headers = $response.headers.map_keys(name => name.to_lower())
    let $date_added_last = $response_headers["x-taxii-date-added-last"]?
    if more? == true {
      if next? != null {
        next_url = f"{$url}?{$this.query}&next={next.encode_url()}"
      } else if $date_added_last != null and objects?.length() > 0 {
        // Without a `next` token, TAXII 2.1 pages by date added.
        next_query = [
          ...$this.filters,
          f"added_after={$date_added_last.encode_url()}",
        ].join("&")
        next_url = f"{$url}?{next_query}"
      }
    }
  }
  unroll objects?
  this = objects
}
