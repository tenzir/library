---
description: Translates an OCSF 1.9 event to Microsoft Sentinel ASIM.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The OCSF event to translate.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the ASIM record.
---

$into = $event
microsoft::asim::ocsf::map event=$into
