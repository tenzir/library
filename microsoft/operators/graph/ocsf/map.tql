---
description: Maps a structured Microsoft Graph event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The structured source event to map.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the OCSF event.
---


$into = {graph: $event, ocsf: {}}

$into.ocsf.cloud = {
  provider: "Azure",
}

$into.ocsf.metadata = {
  product: {
    vendor_name: "Microsoft",
    feature: {
      name: "Microsoft Graph",
    },
  },
  profiles: ["cloud"],
  version: "1.9.0",
}
if $into.graph.tenantId? != null {
  $into.ocsf.metadata.tenant_uid = move $into.graph.tenantId
}
if $into.graph.correlationId? != null {
  $into.ocsf.metadata.correlation_uid = move $into.graph.correlationId
}
if $into.graph.id? != null {
  $into.ocsf.metadata.original_event_uid = move $into.graph.id
}

$into.ocsf.severity_id = 1

match @name {
  "microsoft.graph.sign_in" => {
    microsoft::graph::ocsf::events::sign_in event=$into
  }
  "microsoft.graph.directory_audit" => {
    microsoft::graph::ocsf::events::directory_audit event=$into
  }
  "microsoft.graph.defender.alert" => {
    microsoft::graph::ocsf::events::defender_alert event=$into
  }
  "microsoft.graph.defender.incident" => {
    microsoft::graph::ocsf::events::defender_incident event=$into
  }
  "microsoft.graph.identity_protection.risk_detection" => {
    microsoft::graph::ocsf::events::risk_detection event=$into
  }
  "microsoft.graph.identity_protection.risky_user" => {
    microsoft::graph::ocsf::events::risky_user event=$into
  }
  "microsoft.graph.intune.managed_device" => {
    microsoft::graph::ocsf::events::managed_device event=$into
  }
  "microsoft.graph.intune.detected_app" => {
    microsoft::graph::ocsf::events::detected_app event=$into
  }
  "microsoft.graph.intune.compliance_policy_setting_state_summary" => {
    microsoft::graph::ocsf::events::compliance_policy_setting_state_summary event=$into
  }
  _ => {
    microsoft::graph::ocsf::base event=$into
  }
}



$into = {...$into.ocsf, unmapped: $into.graph}
