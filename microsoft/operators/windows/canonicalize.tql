---
description: |
  Canonicalizes Microsoft Windows Event Log events in any supported
  representation. Parses XML, passes through canonical records, and adapts
  Fluent Bit, NXLog, or Winlogbeat records.
args:
  positional:
    - name: input
      type: field
      description: The Windows Event Log event to canonicalize.
    - name: windows
      type: field
      description: The field that receives the canonical Windows Event Log record.
---

// Windows writes every event data value as text. Parse it with `raw=true`, so
// that each value stays a string instead of a guessed type, such as an integer
// for a hex value without letters or an IP address for a file version. The
// mappings convert the values that an OCSF field needs explicitly.
if type_kind($input) == "string" {
  $windows = $input.parse_winlog(raw=true)
  microsoft::windows::adapters::windows_event_log $windows
} else if type_kind($input.System?) == "string" {
  microsoft::windows::adapters::fluent_bit $input, $windows
} else if $input.System? != null {
  $windows = $input
  microsoft::windows::adapters::windows_event_log $windows
} else if $input.SourceModuleType? == "im_msvistalog" {
  microsoft::windows::adapters::nxlog $input, $windows
} else if $input.winlog?.event_id? != null and $input.winlog?.provider_name? != null {
  microsoft::windows::adapters::winlogbeat $input, $windows
} else if $input.ProviderName? != null and $input.EventID? != null and $input.EventData? != null {
  microsoft::windows::adapters::fluent_bit $input, $windows
} else {
  $windows = null
}
// Windows records times in 100-nanosecond units. Some Tenzir versions parse
// fractional seconds with a one-nanosecond error, such as `.491909` as
// `.491908999` (Tenzir 6.23 and 7.0.0-rc.6), so round to the precision that
// Windows writes. Remove the rounding once every supported version parses
// times exactly (Linear TNZ-2181).
if type_kind($windows.System?.TimeCreated?.SystemTime?) == "time" {
  $windows.System.TimeCreated.SystemTime = $windows.System.TimeCreated.SystemTime.round(100ns)
}
if type_kind($windows.Logger?.logged_time?) == "time" {
  $windows.Logger.logged_time = $windows.Logger.logged_time.round(100ns)
}
// Collectors and JSON readers may deliver typed values, such as numbers from
// NXLog or times inferred by `read_ndjson`. Convert them to strings, so that
// the mappings see the same canonical event for every collector.
if type_kind($input) != "string" {
  if type_kind($windows.EventData?) == "record" {
    $windows.EventData = collect_record($windows.EventData.entries().map(field => [
      field.key,
      field.value.string() if type_kind(field.value) not in ["string", "null", "record", "list"] else field.value,
    ]))
  }
  if type_kind($windows.UserData?) == "record" {
    $windows.UserData = collect_record($windows.UserData.entries().map(section => [
      section.key,
      collect_record(section.value.entries().map(field => [
        field.key,
        field.value.string() if type_kind(field.value) not in ["string", "null", "record", "list"] else field.value,
      ])) if type_kind(section.value) == "record" else section.value,
    ]))
  }
}
// Legacy providers such as Application Error or Windows Error Reporting write
// `Data` elements without a name, which Windows Event XML renders as `_0`,
// `_1`, …. Name them `param1`, `param2`, … like Winlogbeat does, so that the
// numbers match the `%1`, `%2`, … inserts of the provider's message. Like
// Winlogbeat, rename only unnamed fields, keep named ones, such as `Binary`,
// and never overwrite an existing field. Note that `parse_winlog` counts only
// the unnamed elements, whereas Winlogbeat counts all positions, so the
// numbers differ when an event mixes named and unnamed elements.
if type_kind($windows.EventData?) == "record" and $windows.EventData.has("_0") {
  $windows.EventData = collect_record($windows.EventData.entries().map(field => {
    field: field,
    name: "param" + (field.key.slice(begin=1).int() + 1).string()
      if field.key.match_regex(r"^_[0-9]+$") else null,
  }).map(x => [
    x.name if x.name != null and not $windows.EventData.has(x.name) else x.field.key,
    x.field.value,
  ]))
}
// Security-Auditing events carry many settings as message-table tokens, such as
// `%%1843` for "No". Windows Event XML and Fluent Bit keep the token, whereas
// Winlogbeat renders the text. Replace every known token in the fields that
// hold tokens like Windows does, so that every collector yields the same
// canonical event. Splitting a value at `%%` leaves each token's digits at the
// start of a part. Separators, GUIDs, SDDL strings, unknown tokens, and all
// other fields, such as command lines, stay unchanged. Values without `%%`
// skip the table lookups, which dominate the cost.
if $windows.System?.Provider?.Name? == "Microsoft-Windows-Security-Auditing" and type_kind($windows.EventData?) == "record" {
  $windows.EventData = {
    ...$windows.EventData,
    ...collect_record($windows.EventData.entries()
      .where(field => type_kind(field.value) == "string" and "%%" in field.value)
      .map(field => {
        key: field.key,
        value: field.value,
        kind: microsoft::$windows_security_message_fields[field.key]?,
      })
      .where(field => field.kind == "tokens"
        or (field.kind == "placeholder" and field.value.match_regex(r"^\s*%%[0-9]+\s*$")))
      .map(field => {key: field.key, parts: field.value.split("%%")})
      .map(field => {
        key: field.key,
        value: field.parts[0] + field.parts.slice(begin=1).map(part =>
          (microsoft::$windows_security_messages["%%" + part.replace_regex(r"[^0-9][\s\S]*$", "")]?
            + part.replace_regex(r"^[0-9]+", ""))
          else "%%" + part
        ).join(""),
      })),
  }
}
