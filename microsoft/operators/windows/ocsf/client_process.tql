---
description: |
  Maps the `ClientProcessId` of a Windows event, such as a cleared event log
  or a scheduled task change, to the process of the OCSF actor.
args:
  positional:
    - name: windows
      type: field
      description: The canonical Windows event, with the ClientProcessId in EventData.
    - name: ocsf
      type: field
      description: The OCSF event that receives the actor process.
---

// Windows writes ClientProcessId as a decimal number; read a hexadecimal
// rendering by its 0x prefix.
if $windows.EventData.ClientProcessId? != null {
  $ocsf.actor.process = {
    pid: (
      int($windows.EventData.ClientProcessId, base=16)
        if $windows.EventData.ClientProcessId.starts_with("0x")
        else int($windows.EventData.ClientProcessId)
    ),
  }
  drop $windows.EventData.ClientProcessId
}
