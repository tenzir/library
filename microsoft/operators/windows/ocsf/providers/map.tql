---
description: Maps a structured Windows Event Log event to OCSF 1.9.
args:
  positional:
    - name: windows
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---


$ocsf = {}

$ocsf.metadata = {
  event_code: $windows.System.EventID.string(),
  extensions: [{name: "win"}],
  log_name: $windows.System.Channel,
  log_level: (move $windows.System.Level).string(),
  log_version: (move $windows.System.Version).string(),
  logged_time: $windows.Logger.logged_time?,
  loggers: [move $windows.Logger],
  original_event_uid: $windows.System.EventRecordID.string(),
  processed_time: now(),
  product: {
    name: $windows.System.Provider.Name,
    uid: move $windows.System.Provider.Guid?,
    vendor_name: "Microsoft",
  },
  profiles: ["host"],
  version: "1.9.0",
}
$windows.System.EventID = $windows.System.EventID.int()

$ocsf.severity_id = 1
$ocsf.time = move $windows.System.TimeCreated.SystemTime
drop $windows.System.TimeCreated

$ocsf.device = {
  hostname: move $windows.System.Computer,
}

// "-" is the universal Windows sentinel for "not applicable/empty".
replace $windows, what="-", with=null

match $windows.System.Provider.Name {
  "Microsoft-Windows-TaskScheduler" => {
    match $windows.System.EventID {
      100 | 129 | 200 => {
        microsoft::windows::ocsf::events::task_run $windows, $ocsf, activity_id=6
      }
      101 => {
        microsoft::windows::ocsf::events::task_run $windows, $ocsf, activity_id=6
        microsoft::windows::ocsf::events::task_run_failed $windows, $ocsf
      }
      102 | 201 => {
        microsoft::windows::ocsf::events::task_run $windows, $ocsf, activity_id=99
      }
      106 => {
        microsoft::windows::ocsf::events::task_lifecycle $windows, $ocsf, activity_id=1
      }
      140 => {
        microsoft::windows::ocsf::events::task_lifecycle $windows, $ocsf, activity_id=2
      }
      141 => {
        microsoft::windows::ocsf::events::task_lifecycle $windows, $ocsf, activity_id=3
      }
      _ => { microsoft::windows::ocsf::base $windows, $ocsf }
    }
  }
  "Application Error" => {
    match $windows.System.EventID {
      1000 => { microsoft::windows::ocsf::events::application_error $windows, $ocsf }
      _ => { microsoft::windows::ocsf::base $windows, $ocsf }
    }
  }
  "Windows Error Reporting" => {
    match $windows.System.EventID {
      1001 => { microsoft::windows::ocsf::events::application_crash_report $windows, $ocsf }
      _ => { microsoft::windows::ocsf::base $windows, $ocsf }
    }
  }
  "Application Hang" => {
    match $windows.System.EventID {
      1002 => { microsoft::windows::ocsf::events::application_hang $windows, $ocsf }
      _ => { microsoft::windows::ocsf::base $windows, $ocsf }
    }
  }
  "Microsoft-Windows-Windows Defender" => {
    match $windows.System.EventID {
      1005..1008 => { microsoft::windows::ocsf::events::defender_threat $windows, $ocsf }
      1115..1118 => { microsoft::windows::ocsf::events::defender_detection $windows, $ocsf }
      1121 => { microsoft::windows::ocsf::events::defender_asr $windows, $ocsf }
      2000 => { microsoft::windows::ocsf::events::defender_signature_update $windows, $ocsf }
      5001 => {
        microsoft::windows::ocsf::events::defender_tamper $windows, $ocsf, title="Windows Defender Real-Time Protection Disabled"
      }
      5007 => {
        microsoft::windows::ocsf::events::defender_tamper $windows, $ocsf, title="Windows Defender Configuration Changed"
      }
      _ => { microsoft::windows::ocsf::base $windows, $ocsf }
    }
  }
  "Microsoft-Windows-Eventlog" => {
    match $windows.System.EventID {
      1102 => { microsoft::windows::ocsf::events::eventlog_clear $windows, $ocsf }
      _ => { microsoft::windows::ocsf::base $windows, $ocsf }
    }
  }
  "Microsoft-Windows-PowerShell" => {
    match $windows.System.EventID {
      4100 => { microsoft::windows::ocsf::events::powershell_error $windows, $ocsf }
      4103 => { microsoft::windows::ocsf::events::powershell_module_logging $windows, $ocsf }
      4104 => { microsoft::windows::ocsf::events::powershell_script_block $windows, $ocsf }
      4105 | 4106 => { microsoft::windows::ocsf::events::powershell_script_block_invocation $windows, $ocsf }
      _ => { microsoft::windows::ocsf::base $windows, $ocsf }
    }
  }
  "Microsoft-Windows-Security-Auditing" => {
    match $windows.System.EventID {
      4624 => { microsoft::windows::ocsf::events::logon $windows, $ocsf }
      4625 => { microsoft::windows::ocsf::events::logon_failed $windows, $ocsf }
      4648 => { microsoft::windows::ocsf::events::explicit_credential_logon $windows, $ocsf }
      4657 => { microsoft::windows::ocsf::events::registry_value_modify $windows, $ocsf }
      4663 => { microsoft::windows::ocsf::events::object_access $windows, $ocsf }
      4672 => { microsoft::windows::ocsf::events::authorize_session $windows, $ocsf }
      4688 => { microsoft::windows::ocsf::events::process_create $windows, $ocsf }
      4697 => { microsoft::windows::ocsf::events::service_install $windows, $ocsf }
      4698 => { microsoft::windows::ocsf::events::scheduled_task_create $windows, $ocsf, activity_id=1 }
      4699 => { microsoft::windows::ocsf::events::scheduled_task_create $windows, $ocsf, activity_id=3 }
      4700 => { microsoft::windows::ocsf::events::scheduled_task_create $windows, $ocsf, activity_id=4 }
      4701 => { microsoft::windows::ocsf::events::scheduled_task_create $windows, $ocsf, activity_id=5 }
      4702 => { microsoft::windows::ocsf::events::scheduled_task_create $windows, $ocsf, activity_id=2 }
      4719 => { microsoft::windows::ocsf::events::audit_policy_change $windows, $ocsf }
      4720 => { microsoft::windows::ocsf::events::account_change $windows, $ocsf, activity_id=1 }
      4722 => { microsoft::windows::ocsf::events::account_change $windows, $ocsf, activity_id=2 }
      4723 => { microsoft::windows::ocsf::events::account_change $windows, $ocsf, activity_id=3 }
      4724 => { microsoft::windows::ocsf::events::account_change $windows, $ocsf, activity_id=4 }
      4725 => { microsoft::windows::ocsf::events::account_change $windows, $ocsf, activity_id=5 }
      4726 => { microsoft::windows::ocsf::events::account_change $windows, $ocsf, activity_id=6 }
      4727 | 4731 | 4754 => { microsoft::windows::ocsf::events::group_management $windows, $ocsf, activity_id=6 }
      4728 | 4732 | 4756 => { microsoft::windows::ocsf::events::group_management $windows, $ocsf, activity_id=3 }
      4729 | 4733 | 4757 => { microsoft::windows::ocsf::events::group_management $windows, $ocsf, activity_id=4 }
      4730 | 4734 | 4758 => { microsoft::windows::ocsf::events::group_management $windows, $ocsf, activity_id=5 }
      4735 | 4737 | 4755 => { microsoft::windows::ocsf::events::group_management $windows, $ocsf, activity_id=9 }
      4739 => { microsoft::windows::ocsf::events::domain_policy_change $windows, $ocsf }
      4740 => { microsoft::windows::ocsf::events::account_change $windows, $ocsf, activity_id=9 }
      4767 => { microsoft::windows::ocsf::events::account_change $windows, $ocsf, activity_id=12 }
      4769 => { microsoft::windows::ocsf::events::kerberos_service_ticket $windows, $ocsf }
      4771 => { microsoft::windows::ocsf::events::kerberos_preauth_failed $windows, $ocsf }
      4776 => { microsoft::windows::ocsf::events::ntlm_auth $windows, $ocsf }
      4799 => { microsoft::windows::ocsf::events::group_membership_query $windows, $ocsf }
      4825 => { microsoft::windows::ocsf::events::remote_desktop_denied $windows, $ocsf }
      4946 => { microsoft::windows::ocsf::events::firewall_change $windows, $ocsf, activity_id=1 }
      4948 => { microsoft::windows::ocsf::events::firewall_change $windows, $ocsf, activity_id=4 }
      4956 => { microsoft::windows::ocsf::events::firewall_profile_change $windows, $ocsf }
      5024 => {
        microsoft::windows::ocsf::events::firewall_start $windows, $ocsf, name="Windows Firewall Service", type="Windows Service"
      }
      5033 => {
        microsoft::windows::ocsf::events::firewall_start $windows, $ocsf, name="Windows Firewall Authorization Driver", type="Windows Driver"
      }
      _ => { microsoft::windows::ocsf::base $windows, $ocsf }
    }
  }
  "Microsoft-Windows-AppLocker" => {
    match $windows.System.EventID {
      8001 => {
        microsoft::windows::ocsf::events::applocker_policy_apply $windows, $ocsf
      }
      8002 | 8005 => {
        microsoft::windows::ocsf::events::applocker $windows, $ocsf
        microsoft::windows::ocsf::events::applocker_allowed $windows, $ocsf
      }
      8003 | 8006 => {
        microsoft::windows::ocsf::events::applocker $windows, $ocsf
        microsoft::windows::ocsf::events::applocker_audit $windows, $ocsf
      }
      8004 | 8007 => {
        microsoft::windows::ocsf::events::applocker $windows, $ocsf
        microsoft::windows::ocsf::events::applocker_blocked $windows, $ocsf
      }
      _ => { microsoft::windows::ocsf::base $windows, $ocsf }
    }
  }
  "VSSAudit" => {
    match $windows.System.EventID {
      8222 => { microsoft::windows::ocsf::events::shadow_copy_create $windows, $ocsf }
      _ => { microsoft::windows::ocsf::base $windows, $ocsf }
    }
  }
  "EventLog" => {
    match $windows.System.EventID {
      6005 => { microsoft::windows::ocsf::events::eventlog_start $windows, $ocsf }
      6006 => { microsoft::windows::ocsf::events::eventlog_stop $windows, $ocsf }
      _ => { microsoft::windows::ocsf::base $windows, $ocsf }
    }
  }
  "Service Control Manager" => {
    match $windows.System.EventID {
      7034 => { microsoft::windows::ocsf::events::service_crashed $windows, $ocsf }
      7045 => { microsoft::windows::ocsf::events::service_install_scm $windows, $ocsf }
      _ => { microsoft::windows::ocsf::base $windows, $ocsf }
    }
  }
  _ => { microsoft::windows::ocsf::base $windows, $ocsf }
}

drop $windows.System.Channel
drop $windows.System.EventID
drop $windows.System.EventRecordID
drop $windows.System.Provider


$ocsf = {...$ocsf, unmapped: $windows}
