---
description: Sysmon RegistryRename (EID 14) → OCSF Registry Key Activity (201001, Rename)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.registry_key_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 201001
$ocsf.activity_id = 5  // Rename
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id


// reg_key holds the key at its new (post-rename) path.
// prev_reg_key holds the original path before the rename.
$ocsf.reg_key      = { path: move $windows.EventData.NewName     }
$ocsf.prev_reg_key = { path: move $windows.EventData.TargetObject }

// EventType "RenameKey" is redundant with activity_id — drop it.
drop $windows.EventData.EventType

$ocsf._user = (move $windows.EventData.User).split("\\")
$ocsf.actor = {
  process: {
    uid: move $windows.EventData.ProcessGuid,
    pid: (move $windows.EventData.ProcessId).int(),
    path: move $windows.EventData.Image,
    file: {
      type_id: 8,
    },
  },
  user: {
    name: $ocsf._user[-1],
    domain: $ocsf._user[0] if $ocsf._user.length() > 1,
  },
}
drop $ocsf._user

$ocsf.actor.process.name = $ocsf.actor.process.path.split("\\")[-1]
$ocsf.actor.process.file.name = $ocsf.actor.process.name
$ocsf.actor.process.file.path = $ocsf.actor.process.path


