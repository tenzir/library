---
description: Sysmon DnsQuery (EID 22) → OCSF DNS Activity (4003, Query)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.dns_activity"

$ocsf.category_uid = 4
$ocsf.class_uid = 4003
$ocsf.activity_id = 1  // Query
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// Sysmon always knows the DNS client process; the query is outbound.
// Note: is_src_dst_assignment_known is not part of DNS Activity (4003) — only
// Network Activity (4001) defines it.
$ocsf.connection_info = { direction_id: 2 }  // Outbound
$ocsf.src_endpoint = {
  // Sysmon identifies the client host, but not its IP address or the DNS
  // server. Reuse the originating device hostname as the source endpoint.
  hostname: $ocsf.device.hostname,
}

$ocsf.opcode_id = 0  // Standard query
$ocsf.query = {
  hostname: move $windows.EventData.QueryName,
}

// QueryStatus 0 = success (RCODE NOERROR); anything else is an error.
// Read first for status_id, then move for status_code.
$ocsf.status_id = 1 if $windows.EventData.QueryStatus.int() == 0 else 2
$ocsf.status_code = (move $windows.EventData.QueryStatus).string()

// Sysmon bundles CNAME chains + IPs into QueryResults as a semicolon-separated
// string (e.g. "type:  5 cdn.example.com;::ffff:1.2.3.4;"). There is no clean
// way to split CNAME targets from A/AAAA records without a regex engine, so the
// raw field is left in unmapped.EventData for consumers that need it.

// The process and user that issued the query — mapped via the Host profile actor.
$ocsf.user_parts = (move $windows.EventData.User).split("\\")
$ocsf.actor = {
  process: {
    uid:  move $windows.EventData.ProcessGuid,
    pid:  (move $windows.EventData.ProcessId).int(),
    path: move $windows.EventData.Image,
    file: { type_id: 8 },
  },
  user: {
    name:   $ocsf.user_parts[-1],
    domain: $ocsf.user_parts[0] if $ocsf.user_parts.length() > 1,
  },
}
drop $ocsf.user_parts

$ocsf.actor.process.name = $ocsf.actor.process.path.split("\\")[-1]
$ocsf.actor.process.file.name = $ocsf.actor.process.name
$ocsf.actor.process.file.path = $ocsf.actor.process.path

drop $windows.EventData.Initiated?  // always "true" for Sysmon DNS events
