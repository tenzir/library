---
description: Sysmon RawAccessRead (EID 9) → OCSF File System Activity (1001, Read)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.file_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1001
$ocsf.activity_id = 2  // Read
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// RawAccessRead targets a raw disk device, not a regular file.
// type_id 4 (Block Device) is the closest OCSF match.
$ocsf.file = {
  path: move $windows.EventData.Device,
  type_id: 4,  // Block Device
}
$ocsf.file.name = $ocsf.file.path.split("\\")[-1]

microsoft::windows::ocsf::providers::sysmon::actor $windows, $ocsf.actor
