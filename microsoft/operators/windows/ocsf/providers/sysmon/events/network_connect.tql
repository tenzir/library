---
description: Sysmon NetworkConnect (EID 3) → OCSF Network Activity (4001, Open)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.network_activity"

$ocsf.category_uid = 4
$ocsf.class_uid = 4001
$ocsf.activity_id = 1  // Open
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// Sysmon always knows which side initiated the connection.
$ocsf.is_src_dst_assignment_known = true

replace $windows.EventData.SourceHostname,      what="-", with=null
replace $windows.EventData.SourcePortName,      what="-", with=null
replace $windows.EventData.DestinationHostname, what="-", with=null
replace $windows.EventData.DestinationPortName, what="-", with=null

$ocsf.connection_info = {
  direction_id:    2 if (move $windows.EventData.Initiated) else 1,
  protocol_name:   move $windows.EventData.Protocol,
  protocol_ver_id: 6 if (move $windows.EventData.SourceIsIpv6) else 4,
}
drop $windows.EventData.DestinationIsIpv6 // redundant to SourceIsIpv6

let $protos = { tcp: 6, udp: 17 }
$ocsf.connection_info.protocol_num = $protos[$ocsf.connection_info.protocol_name]? else 255

$ocsf.src_endpoint = {
  ip:       move $windows.EventData.SourceIp,
  port:     (move $windows.EventData.SourcePort).int(),
  hostname: move $windows.EventData.SourceHostname,
  svc_name: move $windows.EventData.SourcePortName,
}

$ocsf.dst_endpoint = {
  ip:       move $windows.EventData.DestinationIp,
  port:     (move $windows.EventData.DestinationPort).int(),
  hostname: move $windows.EventData.DestinationHostname,
  svc_name: move $windows.EventData.DestinationPortName,
}

// The Host profile (applied globally in map.tql) adds actor to Network Activity.
// Map the process that opened the connection accordingly.
$ocsf._user = (move $windows.EventData.User).split("\\")
$ocsf.actor = {
  process: {
    uid:  move $windows.EventData.ProcessGuid,
    pid:  (move $windows.EventData.ProcessId).int(),
    path: move $windows.EventData.Image,
    file: { type_id: 8 },
  },
  user: {
    name:   $ocsf._user[-1],
    domain: $ocsf._user[0] if $ocsf._user.length() > 1,
  },
}
drop $ocsf._user

$ocsf.actor.process.name = $ocsf.actor.process.path.split("\\")[-1]
$ocsf.actor.process.file.name = $ocsf.actor.process.name
$ocsf.actor.process.file.path = $ocsf.actor.process.path
