---
description: Sysmon FileCreate (EID 11) → OCSF File System Activity (1001, Create)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.file_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1001
$ocsf.activity_id = 1  // Create
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.file = {
  path: move $windows.EventData.TargetFilename,
  created_time: move $windows.EventData.CreationUtcTime,
  type_id: 1,  // Regular File
}
$ocsf.file.name = $ocsf.file.path.split("\\")[-1]

microsoft::windows::ocsf::providers::sysmon::actor $windows, $ocsf.actor

