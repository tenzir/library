---
description: Sysmon CreateRemoteThread (EID 8) → OCSF Process Activity (1007, Inject)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.process_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1007
$ocsf.activity_id = 4  // Inject
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.injection_type_id = 1  // Remote Thread

// The process that injected the thread is the actor.
$ocsf.actor = {
  process: {
    uid: move $windows.EventData.SourceProcessGuid,
    pid: (move $windows.EventData.SourceProcessId).int(),
    path: $windows.EventData.SourceImage,
    file: {
      type_id: 8,
      name: $windows.EventData.SourceImage.split("\\")[-1],
      path: $windows.EventData.SourceImage,
    },
    name: $windows.EventData.SourceImage.split("\\")[-1],
  },
}
microsoft::windows::ocsf::account $windows.EventData.SourceUser, $ocsf.actor.user

// The target process that received the injected thread.
$ocsf.process = {
  uid: move $windows.EventData.TargetProcessGuid,
  pid: (move $windows.EventData.TargetProcessId).int(),
  path: $windows.EventData.TargetImage,
  file: {
    type_id: 8,
    name: $windows.EventData.TargetImage.split("\\")[-1],
    path: $windows.EventData.TargetImage,
  },
}
microsoft::windows::ocsf::account $windows.EventData.TargetUser, $ocsf.process.user
$ocsf.process.name = $ocsf.process.path.split("\\")[-1]
drop $windows.EventData.SourceImage, $windows.EventData.TargetImage

// The injected module carries the thread's start address and optional
// module or function. The sysmon map replaces "-" sentinels with null.
$ocsf.module = {
  base_address: move $windows.EventData.StartAddress,
  function_name: move $windows.EventData.StartFunction,
}
// StartModule is the path of the image that contains the start address. The
// file object requires a type, so it exists only for a known module.
if $windows.EventData.StartModule != null {
  $ocsf.module.file = {
    name: $windows.EventData.StartModule.split("\\")[-1],
    path: $windows.EventData.StartModule,
    type_id: 8,  // Executable File (modules are PE images)
  }
}
drop $windows.EventData.StartModule

// Map the new thread's ID to process.ptid (the canonical OCSF thread identifier).
$ocsf.process.ptid = (move $windows.EventData.NewThreadId).int()
