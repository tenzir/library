---
description: Sysmon FileExecutableDetected (EID 29) → OCSF File System Activity (1001, Create)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

// FileExecutableDetected fires when a new PE file is written to disk (detection-only,
// no block). Maps identically to FileCreate but explicitly marks type_id as Executable File.

@name = "ocsf.file_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1001
$ocsf.activity_id = 1  // Create
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.file = {
  path: move $windows.EventData.TargetFilename,
  type_id: 8,  // Executable File — EID 29 is PE-specific by definition
}
$ocsf.file.name = $ocsf.file.path.split("\\")[-1]

$ocsf.file.hashes = ((move $windows.EventData.Hashes)
  .split(",")
  .map(h => h.split("=", max=1))
  .map(kv => {
    algorithm_id: microsoft::$sysmon_algorithms[kv[0]?]? else 99,
    value: kv[1]?,
  }))

microsoft::windows::ocsf::providers::sysmon::actor $windows, $ocsf.actor

