---
description: Sysmon ProcessTerminate (EID 5) → OCSF Process Activity (1007, Terminate)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.process_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1007
$ocsf.activity_id = 2  // Terminate
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// EID 5 has no parent-process or actor context. Sysmon reports only the
// terminating process, so the actor mirrors it: for a self-exit, the most
// common case, the terminating process and the actor are the same process.
microsoft::windows::ocsf::providers::sysmon::actor $windows, $ocsf.actor
$ocsf.process = {
  uid: $ocsf.actor.process.uid,
  pid: $ocsf.actor.process.pid,
  path: $ocsf.actor.process.path,
  file: $ocsf.actor.process.file,
  user: $ocsf.actor.user,
  name: $ocsf.actor.process.name,
}
