---
description: >
  Sysmon FileDelete (EID 23, archived) and FileDeleteDetected (EID 26) →
  OCSF File System Activity (1001, Delete).
  Both events report a file deletion; EID 23 additionally archives the file
  to the Sysmon ArchiveDirectory (reflected in is_deleted and unmapped).
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.file_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1001
$ocsf.activity_id = 4  // Delete
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.file = {
  path: move $windows.EventData.TargetFilename,
  type_id: 8 if (move $windows.EventData.IsExecutable) else 1,
  is_deleted: true,
}
$ocsf.file.name = $ocsf.file.path.split("\\")[-1]

$ocsf.file.hashes = ((move $windows.EventData.Hashes)
  .split(",")
  .map(h => h.split("=", max=1))
  .map(kv => {
    algorithm_id: microsoft::$sysmon_algorithms[kv[0]?]? else 99,
    value: kv[1]?,
  }))

microsoft::windows::ocsf::providers::sysmon::actor $windows, $ocsf.actor

// Archived (EID 23 only) — no OCSF field; left in unmapped.
