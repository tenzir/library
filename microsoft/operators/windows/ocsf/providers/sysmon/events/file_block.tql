---
description: >
  Sysmon FileBlockExecutable (EID 27) and FileBlockShredding (EID 28) →
  OCSF File System Activity (1001).
  EID 27 blocks PE creation (activity Create, status Failure).
  EID 28 blocks secure-delete/shredding (activity Delete, status Failure).
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
  named:
    - name: activity_id
      description: The OCSF file activity identifier.
      type: int
---

@name = "ocsf.file_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1001

$ocsf.activity_id = $activity_id
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// Both events are blocking events — the operation was prevented.
$ocsf.status_id = 2  // Failure

// IsExecutable is present on EID 28; absent on EID 27 (implicitly true).
// If explicitly false, downgrade type_id to Regular File.
$ocsf.file = {
  path: move $windows.EventData.TargetFilename,
  type_id: 1 if $windows.EventData.IsExecutable? == false else 8,
}
$ocsf.file.name = $ocsf.file.path.split("\\")[-1]
drop $windows.EventData.IsExecutable?  // may be absent on EID 27

$ocsf.file.hashes = ((move $windows.EventData.Hashes)
  .split(",")
  .map(h => h.split("=", max=1))
  .map(kv => {
    algorithm_id: microsoft::$sysmon_algorithms[kv[0]?]? else 99,
    algorithm: kv[0]? if microsoft::$sysmon_algorithms[kv[0]?]? == null,
    value: kv[1]?,
  }))

$ocsf._user = (move $windows.EventData.User).split("\\")
$ocsf.actor = {
  process: {
    uid: move $windows.EventData.ProcessGuid,
    pid: (move $windows.EventData.ProcessId).int(),
    path: move $windows.EventData.Image,
    file: { type_id: 8 },
  },
  user: {
    name: $ocsf._user[-1],
    domain: $ocsf._user[0] if $ocsf._user.length() > 1,
  },
}
drop $ocsf._user

$ocsf.actor.process.name = $ocsf.actor.process.path.split("\\")[-1]
$ocsf.actor.process.file.name = $ocsf.actor.process.name
$ocsf.actor.process.file.path = $ocsf.actor.process.path

