---
description: >
  Sysmon WMI subscription events (EIDs 19/20/21)
  → OCSF Entity Management (3004).
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.entity_management"

$ocsf.category_uid = 3
$ocsf.class_uid = 3004

let $activity_ids = {Created: 1, Modified: 3, Deleted: 4}
$ocsf.activity_id = $activity_ids[$windows.EventData.Operation?]? else (
  99 if $windows.EventData.Operation? != null else 0
)
// Other carries the Sysmon operation as its caption.
$ocsf.activity_name = $windows.EventData.Operation? if $ocsf.activity_id == 99 else null
drop $windows.EventData.Operation?
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

match $ocsf.metadata.event_code {
  "19" => {
    $ocsf.entity = {
      type_id: 99,
      type: "WMI Event Filter",
      name: move $windows.EventData.Name?,
      data: {
        namespace: move $windows.EventData.EventNamespace?,
        query: move $windows.EventData.Query?,
      },
    }
  }
  "20" => {
    $ocsf.entity = {
      type_id: 99,
      type: "WMI Event Consumer",
      name: move $windows.EventData.Name?,
      data: {
        consumer_type: move $windows.EventData.Type?,
        destination: move $windows.EventData.Destination?,
      },
    }
  }
  "21" => {
    // The filter and consumer references identify the binding together.
    $ocsf.entity = {
      type_id: 99,
      type: "WMI Filter-to-Consumer Binding",
      name: $windows.EventData.Filter? + " -> " + $windows.EventData.Consumer?,
      data: {
        consumer: move $windows.EventData.Consumer?,
        filter: move $windows.EventData.Filter?,
      },
    }
  }
  // The sysmon map dispatches only EIDs 19–21 here.
  _ => {}
}

// The user object needs a name, so the actor exists only for a known user.
if $windows.EventData.User? != null {
  microsoft::windows::ocsf::account $windows.EventData.User, $ocsf.actor.user
}

drop $windows.EventData.EventType?
