---
description: Sysmon ProcessTampering (EID 25) → OCSF Process Activity (1007, Inject)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

// Process tampering (hollowing, herpaderping) is a form of process injection
// where the process image is replaced or locked after creation.
// OCSF Process Activity Inject (4) is the closest semantic match.

@name = "ocsf.process_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1007
$ocsf.activity_id = 4  // Inject
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// injection_type_id 99 (Other) because hollowing/herpaderping are not
// Remote Thread, Load Library, or Queue APC. The sibling of Other carries the
// Sysmon tampering type, such as "Image is replaced".
$ocsf.injection_type_id = 99
$ocsf.injection_type = move $windows.EventData.Type

// The tampered process is both the actor and the target (Sysmon only reports it).
microsoft::windows::ocsf::providers::sysmon::actor $windows, $ocsf.actor
$ocsf.process = {
  uid: $ocsf.actor.process.uid,
  pid: $ocsf.actor.process.pid,
  path: $ocsf.actor.process.path,
  file: $ocsf.actor.process.file,
  user: $ocsf.actor.user,
  name: $ocsf.actor.process.name,
}
