---
description: Sysmon ImageLoad (EID 7) → OCSF Module Activity (1005, Load)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.module_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1005
$ocsf.activity_id = 1  // Load
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// Replace "-" sentinels so optional file-metadata fields can be moved unconditionally.
replace $windows.EventData.FileVersion, what="-", with=null
replace $windows.EventData.Description, what="-", with=null
replace $windows.EventData.Product, what="-", with=null
replace $windows.EventData.Company, what="-", with=null
replace $windows.EventData.OriginalFileName, what="-", with=null
replace $windows.EventData.Signature, what="-", with=null
replace $windows.EventData.SignatureStatus, what="-", with=null

$ocsf.module = {
  file: {
    path: move $windows.EventData.ImageLoaded,
    type_id: 8,  // Executable File (DLLs are PE images)
    version: (move $windows.EventData.FileVersion).string(),
    desc: move $windows.EventData.Description,
    company_name: move $windows.EventData.Company,
    internal_name: move $windows.EventData.OriginalFileName,
    hashes: ((move $windows.EventData.Hashes)
               .split(",")
               .map(h => h.split("=", max=1))
               .map(kv => {
                 algorithm_id: microsoft::$sysmon_algorithms[kv[0]?]? else 99,
                 value: kv[1]?,
               })),
  },
}
$ocsf.module.file.name = $ocsf.module.file.path.split("\\")[-1]

// product.name is a required field — only add the object when the source has a value.
if $windows.EventData.Product != null {
  $ocsf.module.file.product = { name: move $windows.EventData.Product }
}
drop $windows.EventData.Product

// Attach digital-signature details when the module is signed.
if $windows.EventData.Signed {
  $ocsf.module.file.signature = {
    algorithm_id: 0,  // Unknown — Sysmon does not report the algorithm
    state_id: microsoft::$sysmon_signature_states[$windows.EventData.SignatureStatus]?,
  }
  if $windows.EventData.Signature != null {
    $ocsf.module.file.signature.certificate = {
      issuer: move $windows.EventData.Signature,
    }
  }
}
drop $windows.EventData.Signed
drop $windows.EventData.Signature
drop $windows.EventData.SignatureStatus

// The process that loaded the module.
$ocsf._user = (move $windows.EventData.User).split("\\")
$ocsf.actor = {
  process: {
    uid: move $windows.EventData.ProcessGuid,
    pid: (move $windows.EventData.ProcessId).int(),
    path: move $windows.EventData.Image,
    file: { type_id: 8 },
  },
  user: {
    name: $ocsf._user[-1],
    domain: $ocsf._user[0] if $ocsf._user.length() > 1,
  },
}
drop $ocsf._user
$ocsf.actor.process.name = $ocsf.actor.process.path.split("\\")[-1]
$ocsf.actor.process.file.name = $ocsf.actor.process.name
$ocsf.actor.process.file.path = $ocsf.actor.process.path
