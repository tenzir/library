---
description: Sysmon RegistryValueSet (EID 13) → OCSF Registry Value Activity (201002, Set)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.registry_value_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 201002
$ocsf.activity_id = 2  // Set
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf._parts = (move $windows.EventData.TargetObject).split("\\")
$ocsf.reg_value = {
  path:            $ocsf._parts.slice(end=-1).join("\\"),
  name:            $ocsf._parts[-1],
  reg_string_data: move $windows.EventData.Details,
}
drop $ocsf._parts

// EventType "SetValue" is redundant with activity_id — drop it.
drop $windows.EventData.EventType

$ocsf._user = (move $windows.EventData.User).split("\\")
$ocsf.actor = {
  process: {
    uid: move $windows.EventData.ProcessGuid,
    pid: (move $windows.EventData.ProcessId).int(),
    path: move $windows.EventData.Image,
    file: { type_id: 8 },
  },
  user: {
    name: $ocsf._user[-1],
    domain: $ocsf._user[0] if $ocsf._user.length() > 1,
  },
}
drop $ocsf._user
$ocsf.actor.process.name = $ocsf.actor.process.path.split("\\")[-1]
$ocsf.actor.process.file.name = $ocsf.actor.process.name
$ocsf.actor.process.file.path = $ocsf.actor.process.path
