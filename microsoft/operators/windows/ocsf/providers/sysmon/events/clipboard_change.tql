---
description: >
  Sysmon ClipboardChange (EID 24) → OCSF Base Event (0).
  No OCSF 1.7.0 class covers clipboard monitoring events;
  all fields are preserved in unmapped for downstream use.
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

// Base Event — no specific OCSF class for clipboard activity.
$ocsf.category_uid = 0
$ocsf.class_uid = 0
$ocsf.activity_id = 0
$ocsf.type_uid = 0
