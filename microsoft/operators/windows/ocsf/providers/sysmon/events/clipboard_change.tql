---
description: >
  Sysmon ClipboardChange (EID 24) → OCSF Base Event (0).
  Clipboard-specific fields are preserved in unmapped for downstream use.
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

// Preserve clipboard-specific context on the generic Base Event.
$ocsf.category_uid = 0
$ocsf.class_uid = 0
$ocsf.activity_id = 0
$ocsf.type_uid = 0
