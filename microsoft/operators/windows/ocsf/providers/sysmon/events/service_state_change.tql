---
description: Sysmon ServiceStateChange (EID 4) → OCSF Application Lifecycle (6002, Start/Stop)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

// Sysmon reports that it started or stopped, with its version. The event
// names neither the Sysmon service's configuration nor a process or account
// that changed its state, which Windows Service Activity requires, so it maps
// to the start and stop of the Sysmon application.
@name = "ocsf.application_lifecycle"

$ocsf.category_uid = 6
$ocsf.class_uid = 6002
let $activities = {
  Started: {id: 3, name: "Start"},
  Stopped: {id: 4, name: "Stop"},
}
$ocsf.activity_name = move $windows.EventData.State
$ocsf.activity_id = $activities[$ocsf.activity_name]?.id else 99
$ocsf.activity_name = $activities[$ocsf.activity_name]?.name else $ocsf.activity_name
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// The provider identifies the Sysmon service; the event reports its version.
// OCSF 1.9 deprecates `app` in favor of `application`, which the Service
// Control Manager and Windows Firewall lifecycle events also use.
$ocsf.application = {
  name: "Sysmon",
  type: "Windows Service",
  version: move $windows.EventData.Version,
}

// SchemaVersion describes the Sysmon config schema, not the OCSF schema — left in
// unmapped intentionally so analysts can correlate config changes via EID 16.
