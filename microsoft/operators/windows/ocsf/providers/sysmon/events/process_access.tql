---
description: Sysmon ProcessAccess (EID 10) → OCSF Process Activity (1007, Open)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.process_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1007
$ocsf.activity_id = 3  // Open
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// The process that opened the handle to the target.
$ocsf.actor = {
  process: {
    uid: move $windows.EventData.SourceProcessGuid,
    pid: (move $windows.EventData.SourceProcessId).int(),
    ptid: (move $windows.EventData.SourceThreadId?).int(),
    path: $windows.EventData.SourceImage,
    file: {
      type_id: 8,
      name: $windows.EventData.SourceImage.split("\\")[-1],
      path: $windows.EventData.SourceImage,
    },
    name: $windows.EventData.SourceImage.split("\\")[-1],
  },
}
microsoft::windows::ocsf::account $windows.EventData.SourceUser, $ocsf.actor.user

// The process whose handle was obtained.
$ocsf.process = {
  uid: move $windows.EventData.TargetProcessGuid,
  pid: (move $windows.EventData.TargetProcessId).int(),
  path: $windows.EventData.TargetImage,
  file: {
    type_id: 8,
    name: $windows.EventData.TargetImage.split("\\")[-1],
    path: $windows.EventData.TargetImage,
  },
}
microsoft::windows::ocsf::account $windows.EventData.TargetUser, $ocsf.process.user
// GrantedAccess renders the requested access mask in hexadecimal.
$ocsf.requested_permissions = int(move $windows.EventData.GrantedAccess?, base=16)
$ocsf.process.name = $ocsf.process.path.split("\\")[-1]
drop $windows.EventData.SourceImage, $windows.EventData.TargetImage

// CallTrace has no OCSF home and remains in unmapped.
