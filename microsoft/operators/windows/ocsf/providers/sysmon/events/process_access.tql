---
description: Sysmon ProcessAccess (EID 10) → OCSF Process Activity (1007, Open)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.process_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1007
$ocsf.activity_id = 3  // Open
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// The process that opened the handle to the target.
$ocsf._src_user = (move $windows.EventData.SourceUser).split("\\")
$ocsf.actor = {
  process: {
    uid: move $windows.EventData.SourceProcessGuid,
    pid: (move $windows.EventData.SourceProcessId).int(),
    path: move $windows.EventData.SourceImage,
    file: { type_id: 8 },
  },
  user: {
    name: $ocsf._src_user[-1],
    domain: $ocsf._src_user[0] if $ocsf._src_user.length() > 1,
  },
}
drop $ocsf._src_user
$ocsf.actor.process.name = $ocsf.actor.process.path.split("\\")[-1]
$ocsf.actor.process.file.name = $ocsf.actor.process.name
$ocsf.actor.process.file.path = $ocsf.actor.process.path

// The process whose handle was obtained.
$ocsf._tgt_user = (move $windows.EventData.TargetUser).split("\\")
$ocsf.process = {
  uid: move $windows.EventData.TargetProcessGuid,
  pid: (move $windows.EventData.TargetProcessId).int(),
  path: move $windows.EventData.TargetImage,
  file: { type_id: 8 },
  user: {
    name: $ocsf._tgt_user[-1],
    domain: $ocsf._tgt_user[0] if $ocsf._tgt_user.length() > 1,
  },
}
drop $ocsf._tgt_user
// GrantedAccess renders the requested access mask in hexadecimal.
if $windows.EventData.GrantedAccess? != null {
  $ocsf.requested_permissions = int(move $windows.EventData.GrantedAccess, base=16)
}
$ocsf.process.name = $ocsf.process.path.split("\\")[-1]
$ocsf.process.file.name = $ocsf.process.name
$ocsf.process.file.path = $ocsf.process.path

// GrantedAccess is a hex string (e.g. "0x1010"); OCSF actual_permissions is
// integer_t. Leave it in unmapped to avoid a cast type mismatch.
// SourceThreadId and CallTrace also have no OCSF home — left in unmapped.
