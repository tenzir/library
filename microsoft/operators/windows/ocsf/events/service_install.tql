---
description: Service Installed via Security Audit (EID 4697) → OCSF Windows Service Activity (201004, Create)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.windows_service_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 201004
$ocsf.activity_id = 1  // Create
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.actor = {
  user: {
    uid: move $windows.EventData.SubjectUserSid,
    name: move $windows.EventData.SubjectUserName,
    domain: move $windows.EventData.SubjectDomainName,
  },
  session: {
    uid_alt: move $windows.EventData.SubjectLogonId,
  },
}

$ocsf.win_service = {
  name: move $windows.EventData.ServiceName,
  service_file: {
    path: move $windows.EventData.ServiceFileName,
    type_id: 8,
  },
}
// Strip quotes and arguments: "C:\path\svc.exe" --args → svc.exe
$ocsf.win_service.service_file.name = $ocsf.win_service.service_file.path.split("\\")[-1].split(" ")[0].replace("\"", "")
$ocsf.win_service.service_start_name = move $windows.EventData.ServiceAccount

// Windows start types are 0–4, whereas OCSF uses 1–5.
let $start_types = {
  "0": 1,
  "1": 2,
  "2": 3,
  "3": 4,
  "4": 5,
}
let $service_types = {
  "1": 1,
  "2": 2,
  "16": 3,
  "32": 4,
}
$ocsf.win_service.service_start_type_id = (
  $start_types[int($windows.EventData.ServiceStartType?).string()]? else 99
) if $windows.EventData.ServiceStartType? != null
$ocsf.win_service.service_start_type = (move $windows.EventData.ServiceStartType?).string() if $ocsf.win_service.service_start_type_id == 99
$ocsf.win_service.service_type_id = (
  $service_types[int($windows.EventData.ServiceType?, base=16).string()]? else 99
) if $windows.EventData.ServiceType? != null
// Preserve interactive/combined service-type flags losslessly as Other.
$ocsf.win_service.service_type = (move $windows.EventData.ServiceType?).string() if $ocsf.win_service.service_type_id == 99
drop $windows.EventData.ServiceStartType?, $windows.EventData.ServiceType?
