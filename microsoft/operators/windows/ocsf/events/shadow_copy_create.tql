---
description: Volume Shadow Copy Created (EID 8222) → OCSF File System Activity (1001, Create)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.file_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1001
$ocsf.activity_id = 1  // Create
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.status_id = 1  // Success

$ocsf.actor = {
  user: {
    uid: move $windows.EventData._0,
    name: move $windows.EventData._1,
  },
  process: {
    pid: int(move $windows.EventData._2, base=16),
    path: move $windows.EventData._3,
    file: {type_id: 8},
  },
}
$ocsf.actor.process.name = $ocsf.actor.process.path.split("\\")[-1]
$ocsf.actor.process.file = {
  name: $ocsf.actor.process.name,
  path: $ocsf.actor.process.path,
  type_id: 8,
}

$ocsf.file = {
  uid: move $windows.EventData._4,
  path: move $windows.EventData._9,
  type_id: 4,  // Block Device
  volume: move $windows.EventData._8,
}
$ocsf.file.name = $ocsf.file.path.split("\\")[-1]

// The VSSAudit manifest uses positional fields. Preserve shadow-set, provider,
// and source-computer identifiers in unmapped for source-level analysis.
