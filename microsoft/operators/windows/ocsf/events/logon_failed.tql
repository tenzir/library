---
description: Failed Logon (EID 4625) → OCSF Authentication (3002, Logon/Failure)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.authentication"

$ocsf.category_uid = 3
$ocsf.class_uid = 3002
$ocsf.activity_id = 1  // Logon
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.status_id = 2  // Failure
$ocsf.severity_id = 2  // Low — single failed logon; brute-force detection is a higher layer
$ocsf.status_code = move $windows.EventData.Status  // hex NTSTATUS (e.g. 0xC000006D = wrong credentials)
$ocsf.status_detail = move $windows.EventData.FailureReason

// Windows logon types share the OCSF numbering, except that OCSF numbers the
// System logon type 1 instead of 0.
$ocsf.logon_type_id = (move $windows.EventData.LogonType).int()
$ocsf.logon_type_id = 1 if $ocsf.logon_type_id == 0 else $ocsf.logon_type_id

// Some failures, such as a clock skew before the account is known, report
// neither a name nor a SID for the target account.
if $windows.EventData.TargetUserSid? != null or $windows.EventData.TargetUserName? != null {
  $ocsf.user = {
    uid: move $windows.EventData.TargetUserSid?,
    name: move $windows.EventData.TargetUserName?,
    domain: move $windows.EventData.TargetDomainName?,
  }
}

// Network logons have no subject: Windows writes the NULL SID and `-`.
if $windows.EventData.SubjectUserSid? != null or $windows.EventData.SubjectUserName? != null {
  $ocsf.actor = {
    user: {
      uid: move $windows.EventData.SubjectUserSid?,
      name: move $windows.EventData.SubjectUserName?,
      domain: move $windows.EventData.SubjectDomainName?,
    },
    session: {
      uid_alt: move $windows.EventData.SubjectLogonId?,
    },
  }
}

$ocsf.dst_endpoint = {hostname: $ocsf.device.hostname}

// Local logons report neither an address nor a workstation.
if $windows.EventData.IpAddress? != null or $windows.EventData.WorkstationName? != null {
  $ocsf.src_endpoint = {
    ip: $windows.EventData.IpAddress.ip(),
    port: (move $windows.EventData.IpPort).int(),
    hostname: move $windows.EventData.WorkstationName,
  }
  // Keep an address that is not an IP address, such as a host name, in unmapped.
  if $ocsf.src_endpoint.ip != null or $windows.EventData.IpAddress? == null {
    drop $windows.EventData.IpAddress?
  }
}

$ocsf.auth_protocol = move $windows.EventData.AuthenticationPackageName?
$ocsf.auth_protocol_id = microsoft::$windows_auth_protocol_ids[$ocsf.auth_protocol]? else (
  99 if $ocsf.auth_protocol != null else null
)

// Windows reports the process that attempted the logon. Logons without a
// local process, such as network logons, report `0x0` and `-` instead.
if $windows.EventData.ProcessName? not in [null, "", "-"] {
  $ocsf.actor.process = {
    pid: int(move $windows.EventData.ProcessId?, base=16),
    path: $windows.EventData.ProcessName,
    file: {
      type_id: 8,
      name: $windows.EventData.ProcessName.split("\\")[-1],
      path: $windows.EventData.ProcessName,
    },
    name: $windows.EventData.ProcessName.split("\\")[-1],
  }
  drop $windows.EventData.ProcessName
}

// The logon process is the name under which the calling process registered
// with the LSA, which verifies that the caller is a logon application. The
// process that attempted the logon is therefore the logon process, and
// Windows pads its registered name with spaces. Logons without a local
// process, such as network logons, name the security package instead, such as
// `Kerberos` or `NtLmSsp`. A process needs an identifier, so that name stays
// under its original key; the package is the authentication protocol.
if $windows.EventData.LogonProcessName? != null and $ocsf.actor?.process? != null {
  $ocsf.logon_process = {
    ...$ocsf.actor?.process?,
    name: (move $windows.EventData.LogonProcessName).trim(),
  }
}
