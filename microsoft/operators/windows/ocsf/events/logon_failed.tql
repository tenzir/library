---
description: Failed Logon (EID 4625) → OCSF Authentication (3002, Logon/Failure)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.authentication"

$ocsf.category_uid = 3
$ocsf.class_uid = 3002
$ocsf.activity_id = 1  // Logon
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.status_id = 2  // Failure
$ocsf.severity_id = 2  // Low — single failed logon; brute-force detection is a higher layer
$ocsf.status_code = move $windows.EventData.Status  // hex NTSTATUS (e.g. 0xC000006D = wrong credentials)

// Windows LogonType integers map directly to OCSF logon_type_id values.
$ocsf.logon_type_id = (move $windows.EventData.LogonType).int()

$ocsf.user = {
  uid: move $windows.EventData.TargetUserSid,
  name: move $windows.EventData.TargetUserName,
  domain: move $windows.EventData.TargetDomainName,
}

$ocsf.actor = {
  user: {
    uid: move $windows.EventData.SubjectUserSid,
    name: move $windows.EventData.SubjectUserName,
    domain: move $windows.EventData.SubjectDomainName,
  },
  session: {
    uid_alt: move $windows.EventData.SubjectLogonId,
  },
}

$ocsf.src_endpoint = {
  ip: (move $windows.EventData.IpAddress).ip(),
  port: (move $windows.EventData.IpPort).int(),
  hostname: move $windows.EventData.WorkstationName,
}

$ocsf.auth_protocol = move $windows.EventData.AuthenticationPackageName?
if $windows.EventData.LogonProcessName? != null {
  $ocsf.logon_process = {name: move $windows.EventData.LogonProcessName}
}
if $windows.EventData.ProcessName? != null {
  $ocsf.actor.process = {
    pid: int(move $windows.EventData.ProcessId?, base=16),
    path: move $windows.EventData.ProcessName,
    file: {type_id: 8},
  }
  $ocsf.actor.process.name = $ocsf.actor.process.path.split("\\")[-1]
  $ocsf.actor.process.file.name = $ocsf.actor.process.name
  $ocsf.actor.process.file.path = $ocsf.actor.process.path
}
match $ocsf.auth_protocol {
  "NTLM" => { $ocsf.auth_protocol_id = 1 }
  "Kerberos" => { $ocsf.auth_protocol_id = 2 }
  null => {}
  _ => { $ocsf.auth_protocol_id = 99 }
}
