---
description: >
  AppXDeployment-Server package deployments (EIDs 400 succeeded, 401/404
  failed, 412/441/442/453/454 blocked by policy, 603 started, 854 queued)
  → OCSF Application Lifecycle (6002, Install)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
  named:
    - name: status_id
      description: The OCSF status (1 success, 2 failure); null while the deployment is still in progress.
      type: int
      default: null
---

@name = "ocsf.application_lifecycle"
$ocsf.category_uid = 6
$ocsf.class_uid = 6002
$ocsf.activity_id = 1  // Install
$ocsf.type_uid = 600201
$ocsf.status_id = $status_id
$ocsf.status_code = move $windows.EventData?.ErrorCode?
// Payload-free events, such as the policy block 441, and failures before the
// package was opened (404 with an empty PackageFullName) identify no package
// and therefore have no application. Application Lifecycle requires one, so
// ocsf_cast warns about these events.
if (
  $windows.EventData?.PackageFullName? != null
    or $windows.EventData?.PackageDisplayName? != null
    or $windows.EventData?.Path? != null
) {
  $ocsf.application = {
    uid: $windows.EventData.PackageFullName?,
    // Queued deployments (EID 854) only list the package URIs in Path, separated
    // by whitespace. The file name of the first URI or path names the package.
    name: move $windows.EventData.PackageDisplayName?
      else $windows.EventData.PackageFullName?
      else $windows.EventData.Path?.trim().split_regex(r"\s+")[0]?.split("/")[-1]?.split("\\")[-1]?,
    // OCSF requires a URL string in a url object, so events without a source URI
    // have no url.
    url: {url_string: move $windows.EventData.PackageSourceUri} if $windows.EventData.PackageSourceUri? != null else null,
    data: {
      package_full_name: move $windows.EventData.PackageFullName?,
      path: move $windows.EventData.Path?,
      file_path: move $windows.EventData.FilePath?,
      deployment_operation: move $windows.EventData.DeploymentOperation?,
      has_full_trust: $windows.EventData.HasFullTrust? == "true" if $windows.EventData.HasFullTrust? != null else null,
      flags: (move $windows.EventData.Flags?).int(),
    },
  }
  drop $windows.EventData.HasFullTrust?
}
// CallingProcess names the image of the requesting process, followed by the
// services it hosts, such as `svchost.exe,AppReadiness`. The event logs no
// process ID for it, and OCSF requires a process to have a PID or UID, so it
// names the requesting application or service instead: the one hosted
// service, or the image of a process that hosts none. A process that hosts
// several services does not tell which one requested the deployment. The raw
// value stays in unmapped.
$windows._calling = ($windows.EventData?.CallingProcess? else "").split(",").where(x => x != "")
if $windows._calling.length() in [1, 2] {
  $ocsf.actor.application.name = $windows._calling[-1]
}
drop $windows._calling
// Failed deployments (404) render the error.
if $windows.EventData?.SummaryError? != null {
  $ocsf.status_detail = move $windows.EventData.SummaryError
}
