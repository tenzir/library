---
description: Windows Eventlog 104 (log file cleared) → OCSF Event Log Activity (1008, Clear)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.event_log_activity"
$ocsf.category_uid = 1
$ocsf.class_uid = 1008
$ocsf.activity_id = 1  // Clear
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.severity_id = 3  // Medium
// Windows writes the event data under UserData/LogFileCleared; collectors
// that flatten that section put it into EventData.
$windows.EventData = move $windows.UserData?.LogFileCleared? else $windows.EventData?
if $windows.UserData?.is_empty() == true {
  drop $windows.UserData
}
microsoft::windows::ocsf::events::eventlog_clear_actor $windows, $ocsf
// The class attribute names the log that was cleared; metadata.log_name keeps
// the channel that recorded the clearing.
$ocsf.log_name = move $windows.EventData.Channel?
if $windows.EventData.BackupPath? != null and $windows.EventData.BackupPath != "" {
  $ocsf.file = {
    path: move $windows.EventData.BackupPath,
    type_id: 1,
  }
  $ocsf.file.name = $ocsf.file.path.split("\\")[-1]
}
drop $windows.EventData.BackupPath?
// ClientProcessStartKey has no OCSF home and remains in unmapped.
