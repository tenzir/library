---
description: >
  Task Scheduler Lifecycle (EID 106 Register, 140 Update, 141 Delete)
  → OCSF Scheduled Job Activity (1006)
args:
  named:
    - name: event
      description: The working event to map.
      type: field
    - name: activity_id
      description: The OCSF scheduled job activity identifier.
      type: int
---

@name = "ocsf.scheduled_job_activity"

$event.ocsf.category_uid = 1
$event.ocsf.class_uid = 1006

$event.ocsf.activity_id = $activity_id
$event.ocsf.type_uid = $event.ocsf.class_uid * 100 + $event.ocsf.activity_id

$event.ocsf.job = {
  name: move $event.windows.EventData.TaskName,
}

// UserContext is "DOMAIN\username" format.
_user = (move $event.windows.EventData.UserContext).split("\\")
$event.ocsf.actor = {
  user: {
    domain: _user[0],
    name: _user[1],
  },
}
drop _user
