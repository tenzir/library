---
description: Maps Windows remote desktop session lifecycle events to OCSF RDP Activity.
args:
  positional:
    - name: windows
      type: field
      description: The Windows event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
  named:
    - name: activity_id
      type: int
      description: The OCSF RDP activity identifier.
---

@name = "ocsf.rdp_activity"
$ocsf.category_uid = 4
$ocsf.class_uid = 4005
$ocsf.activity_id = $activity_id
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
// Success; Windows logs session reconnects (4778) and disconnects (4779) only
// as success events.
$ocsf.status_id = 1
$ocsf.user = {
  name: move $windows.EventData.AccountName?,
  domain: move $windows.EventData.AccountDomain?,
}
$ocsf.src_endpoint = {
  ip: null,  // An IP address; see below.
  hostname: move $windows.EventData.ClientName?,
}
microsoft::windows::ocsf::endpoint_ip $windows.EventData.ClientAddress?, $ocsf.src_endpoint
$ocsf.dst_endpoint = {
  hostname: $ocsf.device.hostname,
}
// The client connects to this device.
$ocsf.connection_info = {
  direction_id: 1,  // Inbound
  uid: move $windows.EventData.SessionName?,
  session: {
    uid: move $windows.EventData.LogonID?,
  },
}
// Keep the connection name distinct from the authenticated Windows session.
