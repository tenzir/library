---
description: Maps Windows account mapping events to OCSF Authentication.
args:
  positional:
    - name: windows
      type: field
      description: The Windows event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

@name = "ocsf.authentication"
$ocsf.category_uid = 3
$ocsf.class_uid = 3002
$ocsf.activity_id = 7  // Account Switch
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.status_id = 1
$ocsf.account_switch_type_id = 99  // Other
$ocsf.account_switch_type = move $windows.EventData.MappingBy
$ocsf.actor = {
  user: {name: move $windows.EventData.ClientUserName},
}
$ocsf.user = {name: move $windows.EventData.MappedName}
$ocsf.dst_endpoint = {hostname: $ocsf.device.hostname}
