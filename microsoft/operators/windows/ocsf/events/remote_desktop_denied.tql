---
description: Remote Desktop Access Denied (EID 4825) → OCSF RDP Activity (4005, Connect Response/Failure)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.rdp_activity"

$ocsf.category_uid = 4
$ocsf.class_uid = 4005
$ocsf.activity_id = 4  // Connect Response
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.status_id = 2  // Failure
$ocsf.severity_id = 2  // Low
$ocsf.status_detail = "Remote Desktop access denied"

$ocsf.user = {
  name: move $windows.EventData.AccountName,
  domain: move $windows.EventData.AccountDomain,
}
$ocsf.src_endpoint = {
  ip: move $windows.EventData.ClientAddress,
}
$ocsf.dst_endpoint = {
  hostname: $ocsf.device.hostname,
}

// OCSF RDP Activity has no session field. Keep LogonID in unmapped for
// correlation with the authenticated Windows session.
