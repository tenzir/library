---
description: Domain Policy Change (EID 4739) → OCSF Entity Management (3004, Update)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.entity_management"

$ocsf.category_uid = 3
$ocsf.class_uid = 3004
$ocsf.activity_id = 3  // Update
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.actor = {
  user: {
    uid: move $windows.EventData.SubjectUserSid,
    name: move $windows.EventData.SubjectUserName,
    domain: move $windows.EventData.SubjectDomainName,
  },
  session: {
    uid_alt: move $windows.EventData.SubjectLogonId,
  },
}

$ocsf.entity = {
  uid: $windows.EventData.DomainSid,
  name: $windows.EventData.DomainName,
  type_id: 5, // Policy
  policy: {
    uid: $windows.EventData.DomainSid,
    name: $windows.EventData.DomainName,
    type: "Windows Domain Policy",
  },
}
drop $windows.EventData.DomainSid
drop $windows.EventData.DomainName
