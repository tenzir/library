---
description: Marks an AppLocker execution event as allowed in audit mode.
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

$ocsf.status_id = 1  // Success; audit mode did not enforce the block.
$ocsf.severity_id = 2  // Low
$ocsf.status_detail = "Allowed in audit mode; AppLocker policy would block"
