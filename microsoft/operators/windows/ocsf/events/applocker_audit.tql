---
description: Marks an AppLocker execution event as allowed in audit mode.
args:
  named:
    - name: event
      description: The working event to map.
      type: field
---

$event.ocsf.status_id = 1  // Success; audit mode did not enforce the block.
$event.ocsf.severity_id = 2  // Low
$event.ocsf.status_detail = "Allowed in audit mode; AppLocker policy would block"
