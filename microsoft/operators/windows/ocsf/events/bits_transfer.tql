---
description: BITS-Client 16403 (transfer job parameters) → OCSF HTTP Activity (4002)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.http_activity"
$ocsf.category_uid = 4
$ocsf.class_uid = 4002
$ocsf.activity_id = 99  // The job direction is not part of the event.
$ocsf.activity_name = "Transfer"
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
microsoft::windows::ocsf::url $windows.EventData.RemoteName, $ocsf.http_request.url
$ocsf.file = {
  path: move $windows.EventData.LocalName,
  type_id: 1,
}
$ocsf.file.name = $ocsf.file.path.split("\\")[-1]
$ocsf.actor = {
  process: {
    pid: (move $windows.EventData.processId?).int(),
    path: move $windows.EventData.processPath?,
  },
}
// The transfer job parameters do not always name the process image.
if $ocsf.actor.process.path? != null {
  $ocsf.actor.process.file = {
    type_id: 8,
    name: $ocsf.actor.process.path.split("\\")[-1],
    path: $ocsf.actor.process.path,
  }
  $ocsf.actor.process.name = $ocsf.actor.process.file.name
}
$ocsf.connection_info = {direction_id: 2}  // Outbound
