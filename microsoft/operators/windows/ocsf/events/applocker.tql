---
description: AppLocker Execution Event (EID 8002–8007) → OCSF Application Lifecycle (6002, Start)
args:
  named:
    - name: event
      description: The working event to map.
      type: field
---

@name = "ocsf.application_lifecycle"

$event.ocsf.category_uid = 6
$event.ocsf.class_uid = 6002
$event.ocsf.activity_id = 3  // Start
$event.ocsf.type_uid = 600203

$event.windows.EventData = (
  move $event.windows.UserData?.RuleAndFileData?
  else $event.windows.EventData?
)
drop $event.windows.UserData

$event.ocsf.application = {
  uid: move $event.windows.EventData.Fqbn?,
  data: {
    file_path: (
      move $event.windows.EventData.FullFilePath?
      else move $event.windows.EventData.FullFilePathBuffer?
    ),
    normalized_file_path: (
      move $event.windows.EventData.FilePath?
      else move $event.windows.EventData.FilePathBuffer?
    ),
    policy_name: (
      move $event.windows.EventData.PolicyName?
      else move $event.windows.EventData.PolicyNameBuffer?
    ),
    rule_uid: move $event.windows.EventData.RuleId?,
    rule_name: (
      move $event.windows.EventData.RuleName?
      else move $event.windows.EventData.RuleNameBuffer?
    ),
    rule_sddl: (
      move $event.windows.EventData.RuleSddl?
      else move $event.windows.EventData.RuleSddlBuffer?
    ),
    target_user: move $event.windows.EventData.TargetUser?,
    target_process_id: move $event.windows.EventData.TargetProcessId?,
    target_logon_uid: move $event.windows.EventData.TargetLogonId?,
    file_hash: move $event.windows.EventData.FileHash?,
  },
}
$event.ocsf.application.data.file_path = (
  $event.ocsf.application.data.file_path
  else $event.ocsf.application.data.normalized_file_path
)
$event.ocsf.application.name = $event.ocsf.application.data.file_path.split("\\")[-1]
$event.ocsf.application.type = $event.ocsf.application.data.policy_name
