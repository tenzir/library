---
description: Windows Firewall Component Started (EID 5024/5033) → OCSF Application Lifecycle (6002, Start)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
  named:
    - name: name
      description: The Windows Firewall component name.
      type: string
    - name: type
      description: The Windows Firewall component type.
      type: string
---

@name = "ocsf.application_lifecycle"

$ocsf.category_uid = 6
$ocsf.class_uid = 6002
$ocsf.activity_id = 3  // Start
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.status_id = 1  // Success

$ocsf.application = {
  name: $name,
  type: $type,
  product: {
    name: "Windows Firewall",
    vendor_name: "Microsoft",
  },
}
