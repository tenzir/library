---
description: Windows Firewall Component Started (EID 5024/5033) → OCSF Application Lifecycle (6002, Start)
args:
  named:
    - name: event
      description: The working event to map.
      type: field
    - name: name
      description: The Windows Firewall component name.
      type: string
    - name: type
      description: The Windows Firewall component type.
      type: string
---

@name = "ocsf.application_lifecycle"

$event.ocsf.category_uid = 6
$event.ocsf.class_uid = 6002
$event.ocsf.activity_id = 3  // Start
$event.ocsf.type_uid = $event.ocsf.class_uid * 100 + $event.ocsf.activity_id
$event.ocsf.status_id = 1  // Success

$event.ocsf.application = {
  name: $name,
  type: $type,
  product: {
    name: "Windows Firewall",
    vendor_name: "Microsoft",
  },
}
