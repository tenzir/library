---
description: Windows Firewall and IPsec component start, stop, or failed start (EID 5024/5025/5030/5033/5034/5035/5478) → OCSF Application Lifecycle (6002)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
  named:
    - name: name
      description: The Windows Firewall component name.
      type: string
    - name: type
      description: The Windows Firewall component type.
      type: string
    - name: activity_id
      description: The OCSF Application Lifecycle activity identifier.
      type: int
      default: 3
    - name: status_id
      description: The OCSF status identifier.
      type: int
      default: 1
    - name: product
      description: The product of the component, or empty for none.
      type: string
      default: "Windows Firewall"
---

@name = "ocsf.application_lifecycle"

$ocsf.category_uid = 6
$ocsf.class_uid = 6002
$ocsf.activity_id = $activity_id
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.status_id = $status_id

$ocsf.application = {
  name: $name,
  type: $type,
}
if $product != "" {
  $ocsf.application.product = {
    name: $product,
    vendor_name: "Microsoft",
  }
}
