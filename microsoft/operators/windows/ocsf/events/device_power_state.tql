---
description: Maps Windows startup events to OCSF Device Power State Activity.
args:
  positional:
    - name: windows
      type: field
      description: The Windows event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

@name = "ocsf.device_power_state_activity"
$ocsf.category_uid = 1
$ocsf.class_uid = 1011
$ocsf.activity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.status_id = 1
$ocsf.device.os = {
  name: "Windows",
  version: move $windows.EventData.OSVersion?,
  build: (move $windows.EventData.BuildVersion?).string(),
}
