---
description: AppLocker Policy Applied (EID 8001) → OCSF Device Config State Change (5019)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.device_config_state_change"

$ocsf.category_uid = 5
$ocsf.class_uid = 5019
$ocsf.activity_id = 0
$ocsf.type_uid = 501900
$ocsf.state_id = 2  // Enabled
$ocsf.status_id = 1  // Success
