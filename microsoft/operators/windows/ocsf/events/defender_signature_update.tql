---
description: >
  Windows Defender Signature Update (EID 2000)
  → Base Event (0, 0)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.base_event"

$ocsf.category_uid = 0
$ocsf.class_uid = 0
$ocsf.activity_id = 0
$ocsf.type_uid = 0

// Signature version details stay in unmapped for downstream consumers.
// "Product Name" is redundant with metadata.product.name.
drop $windows.EventData["Product Name"]?
