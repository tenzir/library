---
description: PowerShell Engine Error (EID 4100) → OCSF Script Activity (1009, Execute/Failure)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.script_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1009
$ocsf.activity_id = 1  // Execute
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.status_id = 2  // Failure — this event fires on PS engine errors
$ocsf.severity_id = 2  // Low — Windows Level 3 (Warning)
// Payload renders the error, such as "Error Message = System error.".
$ocsf.status_detail = (move $windows.EventData.Payload?).trim()

$ocsf.script = {
  type_id: 2,  // PowerShell
}
$ocsf.actor = {
  process: {
    pid: move $windows.System.Execution.ProcessID?,
    ptid: move $windows.System.Execution.ThreadID?,
  },
}
drop $windows.System.Execution?
// The event reports the failing command in ContextInfo, but not the script
// text, which the script object requires.
microsoft::windows::ocsf::events::powershell_context $windows, $ocsf
