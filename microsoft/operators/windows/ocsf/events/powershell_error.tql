---
description: PowerShell Engine Error (EID 4100) → OCSF Script Activity (1009, Execute/Failure)
args:
  named:
    - name: event
      description: The working event to map.
      type: field
---

@name = "ocsf.script_activity"

$event.ocsf.category_uid = 1
$event.ocsf.class_uid = 1009
$event.ocsf.activity_id = 1  // Execute
$event.ocsf.type_uid = $event.ocsf.class_uid * 100 + $event.ocsf.activity_id

$event.ocsf.status_id = 2  // Failure — this event fires on PS engine errors
$event.ocsf.severity_id = 2  // Low — Windows Level 3 (Warning)
$event.ocsf.status_code = (move $event.windows.EventData.ErrorCode?).string()
$event.ocsf.status_detail = move $event.windows.EventData.Message?

// HostApplication is the full command line (exe + args), not just the path.
$event.ocsf.actor = {
  process: {
    pid: move $event.windows.System.Execution.ProcessID?,
    cmd_line: move $event.windows.EventData.HostApplication?,
  },
}

// User is in "DOMAIN\username" format.
if $event.windows.EventData.User? != null {
  _user = (move $event.windows.EventData.User).split("\\")
  $event.ocsf.actor.user = {
    domain: _user[0]? if _user.length() > 1,
    name: _user[-1]?,
  }
  drop _user
}

$event.ocsf.script = {
  type_id: 2,  // PowerShell
}
if $event.windows.EventData.CommandLine? != null {
  $event.ocsf.script.script_content.value = move $event.windows.EventData.CommandLine
} else if $event.windows.EventData.ContextInfo? != null {
  // Native EID 4100 events commonly carry the attempted invocation as the
  // Host Application line in ContextInfo rather than as CommandLine.
  $event.ocsf.script.script_content.value = move $event.windows.EventData.ContextInfo
} else if $event.windows.EventData.CommandInvocation? != null {
  $event.ocsf.script.script_content.value = move $event.windows.EventData.CommandInvocation
} else if $event.windows.EventData.Payload? != null {
  $event.ocsf.script.script_content.value = move $event.windows.EventData.Payload
}

// HostVersion, EngineVersion, RunspaceId, PipelineId, ScriptName, and ShellId
// stay in unmapped.
drop $event.windows.EventData.HostName?
drop $event.windows.EventData.ConnectedUser?
