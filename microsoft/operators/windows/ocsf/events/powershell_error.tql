---
description: PowerShell Engine Error (EID 4100) → OCSF Script Activity (1009, Execute/Failure)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.script_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1009
$ocsf.activity_id = 1  // Execute
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.status_id = 2  // Failure — this event fires on PS engine errors
$ocsf.severity_id = 2  // Low — Windows Level 3 (Warning)
$ocsf.status_code = (move $windows.EventData.ErrorCode?).string()
$ocsf.status_detail = move $windows.EventData.Message?

// HostApplication is the full command line (exe + args), not just the path.
$ocsf.actor = {
  process: {
    pid: move $windows.System.Execution.ProcessID?,
    cmd_line: move $windows.EventData.HostApplication?,
  },
}

// User is in "DOMAIN\username" format.
if $windows.EventData.User? != null {
  _user = (move $windows.EventData.User).split("\\")
  $ocsf.actor.user = {
    domain: _user[0]? if _user.length() > 1,
    name: _user[-1]?,
  }
  drop _user
}

$ocsf.script = {
  type_id: 2,  // PowerShell
}
if $windows.EventData.CommandLine? != null {
  $ocsf.script.script_content.value = move $windows.EventData.CommandLine
} else if $windows.EventData.ContextInfo? != null {
  $ocsf.script.script_content.value = move $windows.EventData.ContextInfo
} else if $windows.EventData.CommandInvocation? != null {
  $ocsf.script.script_content.value = move $windows.EventData.CommandInvocation
} else if $windows.EventData.Payload? != null {
  $ocsf.script.script_content.value = move $windows.EventData.Payload
}

// CommandLine (the full command attempted), HostVersion, EngineVersion,
// RunspaceId, PipelineId, ScriptName, ShellId — left in unmapped.
drop $windows.EventData.HostName?
drop $windows.EventData.ConnectedUser?
