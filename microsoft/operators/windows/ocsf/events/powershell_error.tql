---
description: PowerShell Engine Error (EID 4100) → OCSF Application Error (6008, General Error)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.application_error"

// The engine reports an error message, not a script execution, so the event
// carries no script text.
$ocsf.category_uid = 6
$ocsf.class_uid = 6008
$ocsf.activity_id = 1  // General Error
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.status_id = 2  // Failure
$ocsf.severity_id = 2  // Low — Windows Level 3 (Warning)
// Payload renders the error, such as "Error Message = System error.".
$ocsf.message = (move $windows.EventData.Payload?).trim()

$ocsf.actor = {
  process: {
    pid: move $windows.System.Execution.ProcessID?,
    ptid: move $windows.System.Execution.ThreadID?,
  },
}
drop $windows.System.Execution?
microsoft::windows::ocsf::events::powershell_context $windows, $ocsf
// Application Error has no script object. The command and script names stay
// in the ContextInfo block under unmapped.
drop $ocsf.script?
