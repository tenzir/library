---
description: Application Hang (EID 1002) → OCSF Process Activity (1007, Terminate)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.process_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1007
$ocsf.activity_id = 2  // Terminate
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.status_id = 2  // Failure
$ocsf.severity_id = 3  // Medium — Windows Event Log Level 2 (Error)

// param4 = faulting process ID (hex string, e.g. "0x1a4c")
// param9 = full path to the hanging application
// param2 = hanging application version
$ocsf._path = move $windows.EventData.param9?
$ocsf._name = move $windows.EventData.param1?
$ocsf._version = $windows.EventData.param2?
$ocsf.process = {pid: int(move $windows.EventData.param4?, base=16), path: $ocsf._path}
if $ocsf._path != null {
  $ocsf.process.name = $ocsf._path.split("\\")[-1]?
} else if $ocsf._name != null {
  $ocsf.process.name = $ocsf._name
}
if $ocsf.process.name? != null {
  $ocsf.process.file = {
    name: $ocsf.process.name,
    path: $ocsf._path,
    type_id: 8,
    version: $ocsf._version.string(),
  }
  drop $windows.EventData.param2?
}

// param1 = application name (redundant with process.name — dropped)
// param3 = application timestamp              \
// param5 = process start time                  | left in unmapped; no OCSF target
// param6 = hang duration (ms)                  |
// param7 = hang flags                          |
// param8 = WER report ID                      /
drop $ocsf._path, $ocsf._name, $ocsf._version
