---
description: >
  Windows Defender Attack Surface Reduction events (EID 1121 Block, 1122 Audit)
  → OCSF Detection Finding (2004).
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
  named:
    - name: title
      description: The finding title.
      type: string
    - name: action_id
      description: The OCSF action identifier of the rule mode.
      type: int
    - name: disposition_id
      description: The OCSF disposition identifier of the rule mode.
      type: int
    - name: severity_id
      description: The OCSF severity identifier.
      type: int
---

@name = "ocsf.detection_finding"

$ocsf.category_uid = 2
$ocsf.class_uid = 2004
$ocsf.activity_id = 1  // Create
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.metadata.profiles = ["host", "security_control"]

$ocsf.severity_id = $severity_id
$ocsf.action_id = $action_id
$ocsf.disposition_id = $disposition_id

// The event reports the rule that fired, not a finding identifier, so the
// rule becomes the analytic and the record identifies the finding.
$ocsf.finding_info = {
  title: $title,
  uid: $ocsf.metadata.original_event_uid,
  analytic: {
    type_id: 1,  // Rule
    name: microsoft::$defender_asr_rules[$windows.EventData.ID.to_lower()]?,
    uid: move $windows.EventData.ID,
  },
}

// Defender names the process that attempted the operation only by its image
// path and logs no process ID. An OCSF process needs a PID or UID, so
// "Process Name" stays in unmapped.
// Defender renders an account that it cannot resolve as "(unknown user)".
if $windows.EventData.User? != "(unknown user)" {
  microsoft::windows::ocsf::account $windows.EventData.User, $ocsf.actor.user
}

// Path names the file or resource that the operation targeted.
if $windows.EventData.Path? != null {
  $ocsf.evidences = [{
    file: {
      name: $windows.EventData.Path.split("\\")[-1],
      path: $windows.EventData.Path,
      type_id: 1,  // Regular File
    },
  }]
  drop $windows.EventData.Path
}

drop $windows.EventData.Unused?
