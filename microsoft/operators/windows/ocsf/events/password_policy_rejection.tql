---
description: Maps Microsoft Entra Password Protection rejections to OCSF User Management.
args:
  positional:
    - name: windows
      type: field
      description: The Windows event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

@name = "ocsf.user_management"
$ocsf.category_uid = 3
$ocsf.class_uid = 3007
$ocsf.activity_id = 8
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.status_id = 2
$ocsf.status_detail = "Rejected by the Microsoft banned password policy"
$ocsf.user = {
  name: move $windows.EventData.Data_1?,
  full_name: move $windows.EventData.Data_2?,
}
