---
description: >
  Windows Defender Malware Detection/Remediation (EID 1116 Detected,
  1117 Action Taken) → OCSF Detection Finding (2004)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.detection_finding"

$ocsf.category_uid = 2
$ocsf.class_uid = 2004
$ocsf.activity_id = 1  // Create
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.metadata.profiles = ["host", "security_control"]

$ocsf.severity_id = move $windows.EventData["Severity ID"]

// Defender Action IDs → OCSF disposition_id (present on EID 1117).
let $dispositions = {
  "1": 11,  // Clean → Corrected
  "2": 3,   // Quarantine → Quarantined
  "3": 5,   // Remove → Deleted
  "6": 1,   // Allow → Allowed
  "9": 16,  // No Action → No Action
  "10": 2,  // Block → Blocked
}
// Collectors that fill every template field report an absent action as null.
$ocsf.disposition_id = $dispositions[$windows.EventData["Action ID"]?.string()]? else (
  99 if $windows.EventData["Action ID"]? != null else null
)
// Other carries the Defender action as its caption.
$ocsf.disposition = $windows.EventData["Action Name"]? if $ocsf.disposition_id == 99 else null
drop $windows.EventData["Action ID"]?

// Threat name is copied into finding_info.title then moved into malware.name.
$ocsf.finding_info = {
  title: $windows.EventData["Threat Name"],
  uid: move $windows.EventData["Detection ID"],
  types: [move $windows.EventData["Category Name"]],
}
// OCSF requires a classification; Defender reports the threat category.
$ocsf.malware = [{
  name: move $windows.EventData["Threat Name"],
  classification_ids: [
    microsoft::$defender_malware_classes[$ocsf.finding_info.types[0]?]?
      else (99 if $ocsf.finding_info.types[0]? != null else 0),
  ],
  // The category is the caption, which also names an Other classification.
  classifications: [$ocsf.finding_info.types[0]?] if $ocsf.finding_info.types[0]? != null else null,
}]

// Path lists the affected resources as `type:_value`, separated by `; `, such
// as `file:_C:\x.exe`, `containerfile:_C:\x.zip`, or
// `webfile:_C:\x.exe|https://example.test/x.exe|pid:1,ProcessStart:2`. The
// files on disk become evidence: a webfile up to its first `|`, and an archive
// member, such as `file:_C:\x.zip->(Zip:y.exe)`, as its container, because
// OCSF has no field for the member. Other resources, such as registry keys,
// are no evidence. The complete list stays in unmapped.
$ocsf.evidences = (
  $windows.EventData.Path?.split("; ")
    .where(x => x.match_regex(r"^(file|containerfile|webfile):_"))
    .map(x => x.replace_regex(r"^[a-z]+:_", "").split("|")[0].split("->")[0])
    .distinct()
    .map(path => {file: {path: path, name: path.split("\\")[-1], type_id: 1}})
)
$ocsf.evidences = $ocsf.evidences if $ocsf.evidences.length() > 0 else null

// Defender names the process only by its image path and logs no process ID.
// An OCSF process needs a PID or UID, so "Process Name" stays in unmapped.

// Detection User is "DOMAIN\username" format.
_user = (move $windows.EventData["Detection User"]).split("\\")
$ocsf.actor.user = {
  domain: _user[0],
  name: _user[1],
}
drop _user

// Drop sentinel/redundant fields.
drop $windows.EventData.Unused?
drop $windows.EventData.Unused2?
drop $windows.EventData.Unused3?
drop $windows.EventData["Severity Name"]
drop $windows.EventData["Action Name"]
drop $windows.EventData["Type Name"]
drop $windows.EventData["Origin Name"]
drop $windows.EventData["Execution Name"]
drop $windows.EventData["Status Description"]?
drop $windows.EventData["Remediation User"]?
