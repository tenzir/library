---
description: Event Log Service Started/Stopped (EID 6005/6006) → OCSF Event Log Activity (1008, Start/Stop)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
  named:
    - name: activity_id
      type: int
      description: The OCSF event log activity identifier.
---

@name = "ocsf.event_log_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1008
$ocsf.activity_id = $activity_id
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.status_id = 1  // Success

// The Event Log service reports its own start and stop. The events name no
// log, only the logging service, which is also the event provider.
$ocsf.log_provider = $ocsf.metadata.product.name
$ocsf.log_type_id = 1  // OS
// The binary data stays in unmapped. NXLog Community Edition drops it.
