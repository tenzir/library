---
description: NTLM Authentication (EID 4776) → OCSF Authentication (3002, Logon)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.authentication"

$ocsf.category_uid = 3
$ocsf.class_uid = 3002
$ocsf.activity_id = 1  // Logon
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// Status 0x0 = success; non-zero = failure (e.g. 0xC000006A = wrong password).
// Without a status, the audit keywords decide.
if $windows.EventData.Status? == "0x0" {
  $ocsf.status_id = 1
} else if $windows.EventData.Status? != null {
  $ocsf.status_id = 2
} else {
  microsoft::windows::ocsf::audit_status $windows, $ocsf
}
$ocsf.status_code = move $windows.EventData.Status?

$ocsf.user = {
  name: move $windows.EventData.TargetUserName,
}

// PackageName identifies the NTLM variant; map to auth_protocol_id so that
// ocsf_derive can populate the sibling auth_protocol string.
let $protocols = {
  "MICROSOFT_AUTHENTICATION_PACKAGE_V1_0": 1,  // NTLM v1
  "NTLM": 1,
}
$ocsf.auth_protocol_id = $protocols[$windows.EventData.PackageName]? else 99
// Other carries the package name as its caption.
$ocsf.auth_protocol = $windows.EventData.PackageName if $ocsf.auth_protocol_id == 99 else null
drop $windows.EventData.PackageName

$ocsf.src_endpoint = {
  hostname: move $windows.EventData.Workstation,
}
// The event reports the validation on this domain controller.
$ocsf.dst_endpoint = {hostname: $ocsf.device.hostname}
