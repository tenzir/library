---
description: Actor of a cleared event log (Security 1102, Eventlog 104)
args:
  positional:
    - name: windows
      description: The Windows event, with the LogFileCleared data in EventData.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

// The user that cleared the log. Security 1102 names the user by SID, while
// Eventlog 104 names it only by account name.
if $windows.EventData.SubjectUserSid? != null {
  $ocsf.actor.user = {
    uid: move $windows.EventData.SubjectUserSid,
    name: move $windows.EventData.SubjectUserName?,
    domain: move $windows.EventData.SubjectDomainName?,
  }
} else if $windows.EventData.SubjectUserName? != null {
  $ocsf.actor.user = {
    name: move $windows.EventData.SubjectUserName,
    domain: move $windows.EventData.SubjectDomainName?,
  }
}
if $windows.EventData.SubjectLogonId? != null {
  $ocsf.actor.session = {uid_alt: move $windows.EventData.SubjectLogonId}
}
microsoft::windows::ocsf::client_process $windows, $ocsf
