---
description: Windows Firewall Profile Change (EID 4956) → OCSF Entity Management (3004, Update)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.entity_management"

$ocsf.category_uid = 3
$ocsf.class_uid = 3004
$ocsf.activity_id = 3  // Update
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.entity = {
  name: "Windows Firewall Profile",
  type_id: 5, // Policy
  policy: {
    name: "Windows Firewall Profile",
    type: "Firewall Policy",
    data: {
      active_profile: move $windows.EventData.ActiveProfile,
    },
  },
}
