---
description: >
  CodeIntegrity events (App Control blocked or audited a file, or Windows
  loaded an unsigned, revoked, or non-WHQL image) → OCSF Application
  Lifecycle (6002, Start)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
  named:
    - name: status_id
      description: The OCSF status (1 when the image loaded, 2 when it was blocked).
      type: int
    - name: status_detail
      description: |
        Describes the outcome. Defaults to the App Control policy decision:
        audited for status 1 and blocked for status 2.
      type: string
      default: null
    - name: severity_id
      description: The OCSF severity. Defaults to 2 (Low) for status 1 and 3 (Medium) for status 2.
      type: int
      default: null
---

@name = "ocsf.application_lifecycle"
$ocsf.category_uid = 6
$ocsf.class_uid = 6002
$ocsf.activity_id = 3  // Start
$ocsf.type_uid = 600203
$ocsf.status_id = $status_id
$ocsf.metadata.profiles = ["host", "security_control"]
let $outcomes = {
  "1": {
    severity_id: 2,  // Low
    status_detail: "Audited by App Control policy",
  },
  "2": {
    severity_id: 3,  // Medium
    status_detail: "Blocked by App Control policy",
  },
}
let $outcome = $outcomes[$status_id.string()]
$ocsf.severity_id = $severity_id else $outcome.severity_id
$ocsf.status_detail = $status_detail else $outcome.status_detail
// Code Integrity reports file names as device paths. App Control decisions
// (3076/3077) name their fields with spaces, such as `File Name`, while other
// events use names such as `FileNameBuffer`.
$ocsf.application = {
  desc: move $windows.EventData.FileDescription?,
  version: (move $windows.EventData.FileVersion?).string(),
  // OCSF requires a name in a product object.
  product: {name: move $windows.EventData.ProductName} if $windows.EventData.ProductName? != null else null,
  data: {
    file_path: move $windows.EventData.FileNameBuffer? else move $windows.EventData["File Name"]?,
    requested_policy: move $windows.EventData.RequestedPolicy?,
    validated_policy: move $windows.EventData.ValidatedPolicy?,
    requested_signing_level: move $windows.EventData.RequestedSigningLevel?
      else move $windows.EventData["Requested Signing Level"]?,
    validated_signing_level: move $windows.EventData.ValidatedSigningLevel?
      else move $windows.EventData["Validated Signing Level"]?,
  },
}
// Events without an App Control policy decision, such as unsigned image loads
// (3001/3037), name no policy, and an empty policy object would violate OCSF.
// This stays a statement: a `move` in an untaken inline `if … else` branch
// still consumes its field, which would drop a lone PolicyHash from unmapped.
if ($windows.EventData.PolicyName? else $windows.EventData.PolicyGUID?) != null {
  $ocsf.policy = {
    name: move $windows.EventData.PolicyName?,
    uid: move $windows.EventData.PolicyGUID?,
    data: {hash: move $windows.EventData.PolicyHash?},
  }
}
$ocsf.status_code = (move $windows.EventData.Status?).string()
$ocsf.application.name = $ocsf.application.data.file_path?.split("\\")[-1]?
$ocsf.application.type = "Code Integrity"
// Code Integrity writes the event in the context of the loading process, so
// the header carries that process's PID and thread: on records with a process
// name, Sysmon shows the header PID running that image. Without a header PID,
// the name stays in unmapped: OCSF requires a process to have a PID or UID.
if (
  ($windows.EventData.ProcessNameBuffer? else $windows.EventData["Process Name"]?) != null
    and $windows.System.Execution?.ProcessID? != null
) {
  $ocsf.actor = {
    process: {
      pid: move $windows.System.Execution.ProcessID,
      ptid: move $windows.System.Execution.ThreadID?,
      path: move $windows.EventData.ProcessNameBuffer? else move $windows.EventData["Process Name"]?,
      file: {type_id: 8},
    },
  }
  $ocsf.actor.process.name = $ocsf.actor.process.path.split("\\")[-1]
  $ocsf.actor.process.file.name = $ocsf.actor.process.name
  $ocsf.actor.process.file.path = $ocsf.actor.process.path
  drop $windows.System.Execution?
}
drop $windows.EventData.FileNameLength?,
  $windows.EventData.ProcessNameLength?,
  $windows.EventData.RequestedPolicyLength?,
  $windows.EventData.ValidatedPolicyLength?,
  $windows.EventData.PolicyID?
