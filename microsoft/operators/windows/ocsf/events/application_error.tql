---
description: Application Error (EID 1000) → OCSF Process Activity (1007, Terminate)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.process_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1007
$ocsf.activity_id = 2  // Terminate
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.status_id = 2  // Failure
$ocsf.severity_id = 3  // Medium — Windows Event Log Level 2 (Error)
// Windows 10 and later name the event data; earlier versions write the same
// values positionally (`param1` … `param13`).
$ocsf.status_code = (move $windows.EventData.ExceptionCode? else move $windows.EventData.param7?).string()

$ocsf.process = {
  // The parser reads hexadecimal values without letters as decimal integers.
  pid: int((move $windows.EventData.ProcessId? else move $windows.EventData.param9?).string(), base=16),
  path: move $windows.EventData.AppPath? else move $windows.EventData.param11?,
}
$ocsf.process.name = $ocsf.process.path?.split("\\")[-1]? else move $windows.EventData.AppName? else move $windows.EventData.param1?
if $ocsf.process.name? != null {
  $ocsf.process.file = {
    name: $ocsf.process.name,
    path: $ocsf.process.path,
    type_id: 8,
    version: (move $windows.EventData.AppVersion? else move $windows.EventData.param2?).string(),
  }
}
// Hexadecimal FILETIME: 100 ns ticks since 1601-01-01.
$ocsf.process.created_time = from_epoch(
  (int((move $windows.EventData.ProcessCreationTime? else move $windows.EventData.param10?).string(), base=16) - 116444736000000000) * 100ns,
)
// An unhandled exception in its own code terminated the process, so the
// faulting process is also the actor.
$ocsf.actor = {process: $ocsf.process}

// Process Activity has a module object for the faulting module. The event
// does not say how the module was loaded.
$ocsf.module = {
  file: {
    name: move $windows.EventData.ModuleName? else move $windows.EventData.param4?,
    path: move $windows.EventData.ModulePath? else move $windows.EventData.param12?,
    version: (move $windows.EventData.ModuleVersion? else move $windows.EventData.param5?).string(),
    type_id: 8,
  },
  load_type_id: 0,  // Unknown
}
// AppTimeStamp/ModuleTimeStamp (param3/param6) are PE link timestamps, not
// process or module load times. FaultingOffset/IntegratorReportId
// (param8/param13) are the fault offset and the WER report ID.
