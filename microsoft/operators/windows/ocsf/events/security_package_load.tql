---
description: Maps Windows security package loading to OCSF Module Activity.
args:
  positional:
    - name: windows
      type: field
      description: The Windows event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
  named:
    - name: module_type
      type: string
      description: The source security package type.
---

@name = "ocsf.module_activity"
$ocsf.category_uid = 1
$ocsf.class_uid = 1005
$ocsf.activity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
// Success; Windows logs package loads and logon process registrations (4610,
// 4611, 4614, 4622) only as success events.
$ocsf.status_id = 1
// Each event names the package or logon process in exactly one field.
$ocsf.module = {
  file: {
    name: move $windows.EventData.PackageName?
      else move $windows.EventData.AuthenticationPackageName?
      else move $windows.EventData.NotificationPackageName?
      else move $windows.EventData.SecurityPackageName?
      else move $windows.EventData.LogonProcessName?,
    path: move $windows.EventData.PackageFileName?,
    type_id: 8,
  },
  // Windows doesn't say how the Local Security Authority loaded the package.
  load_type_id: 0,
  type: $module_type,
}

// The Local Security Authority writes the Security log and loads the
// packages, so the event's process is the acting LSA process.
$ocsf.actor = {
  process: {
    pid: move $windows.System.Execution.ProcessID,
    name: "Local Security Authority",
  },
}
// Only trusted logon process registrations (4611) name a subject.
if $windows.EventData.SubjectUserSid? != null {
  $ocsf.actor.user = {
    uid: move $windows.EventData.SubjectUserSid,
    name: move $windows.EventData.SubjectUserName?,
    domain: move $windows.EventData.SubjectDomainName?,
  }
  $ocsf.actor.session = {uid_alt: move $windows.EventData.SubjectLogonId?}
}
