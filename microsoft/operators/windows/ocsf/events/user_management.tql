---
description: Maps Windows user lifecycle and privilege changes to OCSF User Management.
args:
  positional:
    - name: windows
      type: field
      description: The Windows event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
  named:
    - name: activity_id
      type: int
      description: The OCSF user management activity identifier.
    - name: map_privileges
      type: bool
      default: true
      description: Whether to map source privilege lists.
---

@name = "ocsf.user_management"
$ocsf.category_uid = 3
$ocsf.class_uid = 3007
$ocsf.activity_id = $activity_id
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.user = {
  uid: move $windows.EventData.TargetSid?,
  name: move $windows.EventData.TargetUserName?,
  domain: move $windows.EventData.TargetDomainName?,
}
// Windows message-resource tokens and "-" do not identify account values.
if $windows.EventData.DisplayName? != null and
   $windows.EventData.DisplayName != "-" and
   not $windows.EventData.DisplayName.starts_with("%%") {
  $ocsf.user.display_name = move $windows.EventData.DisplayName
}
if $windows.EventData.UserPrincipalName? != null and
   $windows.EventData.UserPrincipalName != "-" and
   not $windows.EventData.UserPrincipalName.starts_with("%%") {
  $ocsf.user.uid_alt = move $windows.EventData.UserPrincipalName
}
$ocsf.actor = {
  user: null,
  session: {uid_alt: move $windows.EventData.SubjectLogonId?},
}
if $windows.EventData.SubjectUserSid? != null or $windows.EventData.SubjectUserName? != null {
  $ocsf.actor.user = {
    uid: move $windows.EventData.SubjectUserSid?,
    name: move $windows.EventData.SubjectUserName?,
    domain: move $windows.EventData.SubjectDomainName?,
  }
}
if $map_privileges and $windows.EventData.PrivilegeList? != null {
  $ocsf.privileges = (move $windows.EventData.PrivilegeList).split_regex(r"\s+")
}
if $map_privileges and $windows.EventData.AccessList? != null {
  $ocsf.privileges = (move $windows.EventData.AccessList).split_regex(r"\s+")
}
