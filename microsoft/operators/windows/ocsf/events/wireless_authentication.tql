---
description: Maps Windows wireless 802.1X authentication to OCSF Authentication.
args:
  positional:
    - name: windows
      type: field
      description: The Windows event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

microsoft::windows::ocsf::events::authentication $windows, $ocsf, activity_id=1, status_id=1, auth_protocol_id=9

$ocsf.user = {name: move $windows.EventData.Identity}
$ocsf.service = {name: move $windows.EventData.SSID?}
$ocsf.status_code = (move $windows.EventData.ErrorCode?).string()
$ocsf.status_detail = move $windows.EventData.ReasonText?
