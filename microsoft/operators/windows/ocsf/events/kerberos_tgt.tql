---
description: Maps a Kerberos ticket-granting ticket request to OCSF Authentication.
args:
  positional:
    - name: windows
      type: field
      description: The Windows event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

@name = "ocsf.authentication"
$ocsf.category_uid = 3
$ocsf.class_uid = 3002
$ocsf.activity_id = 3
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.auth_protocol_id = 2
$ocsf.user = {
  uid: move $windows.EventData.TargetSid?,
  name: move $windows.EventData.TargetUserName?,
  domain: move $windows.EventData.TargetDomainName?,
}
$ocsf.service = {
  name: move $windows.EventData.ServiceName?,
}
$ocsf.src_endpoint = {
  ip: null,  // An IP address; see below.
  port: int(move $windows.EventData.IpPort?),
}
microsoft::windows::ocsf::endpoint_ip $windows.EventData.IpAddress?, $ocsf.src_endpoint
$ocsf.dst_endpoint = {
  hostname: $ocsf.device.hostname,
}
// The result code decides the outcome, where 0x0 means the KDC issued the
// ticket. Without a result code, the audit keywords decide.
$ocsf.status_code = move $windows.EventData.Status?
if $ocsf.status_code == "0x0" {
  $ocsf.status_id = 1
} else if $ocsf.status_code != null {
  $ocsf.status_id = 2
} else {
  microsoft::windows::ocsf::audit_status $windows, $ocsf
}
$ocsf.authentication_token = {
  type_id: 1,
  kerberos_flags: move $windows.EventData.TicketOptions?,
}
microsoft::windows::ocsf::kerberos_certificate $windows, $ocsf
// Windows encryption type codes remain in unmapped until they can be translated
// to the OCSF encryption_details algorithm enum without loss.
