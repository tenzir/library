---
description: PowerShell Module / Pipeline Logging (EID 4103) → OCSF Script Activity (1009, Execute)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.script_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1009
$ocsf.activity_id = 1  // Execute
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// Windows Level 4 (Information).
$ocsf.severity_id = 1  // Informational

$ocsf.script = {
  type_id: 2,  // PowerShell
  script_content: {
    value: move $windows.EventData.Payload,
  },
}
// ContextInfo is a rendered "Key = Value" block describing the host. Line
// breaks do not survive every collector, so runs of whitespace separate the
// entries.
if $windows.EventData.ContextInfo? != null {
  _context = ($windows.EventData.ContextInfo
    .split_regex(r"\s{2,}|\n")
    .map(line => line.split(" = ", max=1))
    .where(kv => kv.length() == 2)
    .map(kv => {key: kv[0].trim(), value: kv[1].trim()}))
  _lookup = _context.where(kv => kv.key == "Script Name")[0]?.value?
  if _lookup != null and _lookup != "" {
    $ocsf.script.file = {path: _lookup, type_id: 1}
    $ocsf.script.file.name = _lookup.split("\\")[-1]
    $ocsf.script.name = $ocsf.script.file.name
  } else {
    _lookup = _context.where(kv => kv.key == "Command Name")[0]?.value?
    if _lookup != null and _lookup != "" {
      $ocsf.script.name = _lookup
    }
  }
  _lookup = _context.where(kv => kv.key == "Host Application")[0]?.value?
  if _lookup != null and _lookup != "" {
    $ocsf.actor = {process: {cmd_line: _lookup}}
  }
  _lookup = _context.where(kv => kv.key == "User")[0]?.value?
  if _lookup != null and _lookup != "" {
    _user = _lookup.split("\\")
    $ocsf.actor.user = {
      name: _user[-1],
      domain: _user[0] if _user.length() > 1,
    }
    drop _user
  }
  drop _context, _lookup
}

// Keep the complete ContextInfo block in unmapped because it contains additional
// host, engine, runspace, pipeline, and shell details.
