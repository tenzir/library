---
description: Maps Windows network share access to OCSF SMB Activity.
args:
  positional:
    - name: windows
      type: field
      description: The Windows event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

@name = "ocsf.smb_activity"
$ocsf.category_uid = 4
$ocsf.class_uid = 4006
$ocsf.activity_id = 99
$ocsf.activity_name = "Share Access"
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
// Both events log failures when the share denies access. A failed detailed
// file share access (5145) names the reason for each requested access right.
microsoft::windows::ocsf::audit_status $windows, $ocsf
if $ocsf.status_id == 2 {
  $ocsf.status_detail = move $windows.EventData.AccessReason?
}
$ocsf.share = move $windows.EventData.ShareName
$ocsf.share_type_id = 1
// Share access (5140) names no file, while detailed file share access (5145)
// names the file relative to the share. Its type is not known, which OCSF
// represents as a regular file.
if $windows.EventData.RelativeTargetName? != null {
  $ocsf.file = {
    path: $windows.EventData.RelativeTargetName,
    name: $windows.EventData.RelativeTargetName.split("\\")[-1],
    type_id: 1,  // Regular File
  }
  drop $windows.EventData.RelativeTargetName
}
$ocsf.src_endpoint = {
  ip: $windows.EventData.IpAddress?.ip(),
  port: int(move $windows.EventData.IpPort?),
}
// Keep an address that is not an IP address, such as a host name, in unmapped.
if $ocsf.src_endpoint.ip != null or $windows.EventData.IpAddress? == null {
  drop $windows.EventData.IpAddress?
}
$ocsf.dst_endpoint = {hostname: $ocsf.device.hostname}
$ocsf.actor = {
  user: {
    uid: move $windows.EventData.SubjectUserSid?,
    name: move $windows.EventData.SubjectUserName?,
    domain: move $windows.EventData.SubjectDomainName?,
  },
  session: {uid_alt: move $windows.EventData.SubjectLogonId?},
}
