---
description: >
  Windows Defender Threat Found/Action (EID 1006 Found, 1007 Action)
  → OCSF Detection Finding (2004)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.detection_finding"

$ocsf.category_uid = 2
$ocsf.class_uid = 2004
$ocsf.activity_id = 1  // Create
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.metadata.profiles = ["host", "security_control"]

// Map string severity name to OCSF severity_id.
let $severities = {
  "Low": 2,
  "Moderate": 3,
  "High": 4,
  "Severe": 5,
}
$ocsf.severity_id = $severities[move $windows.EventData.Severity]? else 0

// Action string → OCSF disposition_id (EID 1007 only).
let $dispositions = {
  "Clean": 11,       // Corrected
  "Quarantine": 3,   // Quarantined
  "Remove": 5,       // Deleted
  "Allow": 1,        // Allowed
  "Block": 2,        // Blocked
}
// Collectors that fill every template field report an absent action as null.
$ocsf.disposition_id = $dispositions[$windows.EventData.Action?]? else (
  99 if $windows.EventData.Action? != null else null
)
// Other carries the Defender action as its caption.
$ocsf.disposition = $windows.EventData.Action? if $ocsf.disposition_id == 99 else null
drop $windows.EventData.Action?

// Threat name is copied into finding_info.title then moved into malware.name.
$ocsf.finding_info = {
  title: $windows.EventData["Threat Name"],
  uid: (move $windows.EventData.ID).string(),
  types: [move $windows.EventData.Category],
}
// OCSF requires a classification; Defender reports the threat category.
$ocsf.malware = [{
  name: move $windows.EventData["Threat Name"],
  classification_ids: [
    microsoft::$defender_malware_classes[$ocsf.finding_info.types[0]?]?
      else (99 if $ocsf.finding_info.types[0]? != null else 0),
  ],
  // The category is the caption, which also names an Other classification.
  classifications: [$ocsf.finding_info.types[0]?] if $ocsf.finding_info.types[0]? != null else null,
}]

// Detected file; wrap in evidences as required by Detection Finding (EID 1006 only).
if $windows.EventData.Path? != null {
  $ocsf.file = {
    path: move $windows.EventData.Path,
    type_id: 1,  // Regular file
  }
  $ocsf.file.name = $ocsf.file.path.split("\\")[-1]
  $ocsf.evidences = [{ file: move $ocsf.file }]
}

// Defender names the process that triggered the detection (1006) only by its
// image path and logs no process ID. An OCSF process needs a PID or UID, so
// "Process Name" stays in unmapped.

// User is "DOMAIN\username" format.
_user = (move $windows.EventData.User).split("\\")
$ocsf.actor.user = {
  domain: _user[0],
  name: _user[1],
}
drop _user
