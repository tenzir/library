---
description: Marks an AppLocker execution event as allowed.
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

$ocsf.status_id = 1  // Success
$ocsf.status_detail = "Allowed by AppLocker policy"
