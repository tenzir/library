---
description: Process Creation (EID 4688) → OCSF Process Activity (1007, Launch)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.process_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1007
$ocsf.activity_id = 1  // Launch
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.launch_type_id = 1  // Spawn

$ocsf.actor = {
  user: {
    uid: move $windows.EventData.SubjectUserSid,
    name: move $windows.EventData.SubjectUserName,
    domain: move $windows.EventData.SubjectDomainName,
  },
  session: {
    uid_alt: move $windows.EventData.SubjectLogonId,
  },
}

// The creator process is the parent of the new process.
$ocsf.process = {
  pid: int(move $windows.EventData.NewProcessId, base=16),
  path: $windows.EventData.NewProcessName,
  cmd_line: move $windows.EventData.CommandLine,
  file: {
    type_id: 8,
    name: $windows.EventData.NewProcessName.split("\\")[-1],
    path: $windows.EventData.NewProcessName,
  },
  parent_process: {
    pid: int(move $windows.EventData.ProcessId, base=16),
    path: $windows.EventData.ParentProcessName?,
    name: $windows.EventData.ParentProcessName?.split("\\")[-1]?,
  },
  name: $windows.EventData.NewProcessName.split("\\")[-1],
}
drop $windows.EventData.NewProcessName
// Version 1 of the event omits the creator's image, and a file needs a path.
if $windows.EventData.ParentProcessName? != null {
  $ocsf.process.parent_process.file = {
    name: $ocsf.process.parent_process.name,
    path: move $windows.EventData.ParentProcessName,
    type_id: 8,
  }
}
// The creator is the acting process.
$ocsf.actor.process = $ocsf.process.parent_process

// The mandatory label SID encodes the integrity level of the new process.
let $integrity_ids = {
  "S-1-16-0": 1,
  "S-1-16-4096": 2,
  "S-1-16-8192": 3,
  "S-1-16-12288": 4,
  "S-1-16-16384": 5,
  "S-1-16-20480": 6,
}
$ocsf.process.integrity_id = $integrity_ids[$windows.EventData.MandatoryLabel?]? else (
  99 if $windows.EventData.MandatoryLabel? != null else null
)
$ocsf.process.integrity = $windows.EventData.MandatoryLabel? if $ocsf.process.integrity_id == 99 else null
drop $windows.EventData.MandatoryLabel?

// Version 2 of the event names the account the new process runs as. Without
// a name, the target fields hold the NULL SID.
if $windows.EventData.TargetUserName? != null {
  $ocsf.process.user = {
    uid: move $windows.EventData.TargetUserSid?,
    name: move $windows.EventData.TargetUserName,
    domain: move $windows.EventData.TargetDomainName?,
  }
  $ocsf.process.session = {uid_alt: move $windows.EventData.TargetLogonId?}
}

// Success; Windows logs process creation (4688) only as a success event.
$ocsf.status_id = 1

// TokenElevationType has no OCSF home and remains in unmapped.
