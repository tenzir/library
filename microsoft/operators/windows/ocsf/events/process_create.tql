---
description: Process Creation (EID 4688) → OCSF Process Activity (1007, Launch)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.process_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1007
$ocsf.activity_id = 1  // Launch
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.launch_type_id = 1  // Spawn

$ocsf.actor = {
  user: {
    uid: move $windows.EventData.SubjectUserSid,
    name: move $windows.EventData.SubjectUserName,
    domain: move $windows.EventData.SubjectDomainName,
  },
  session: {
    uid_alt: move $windows.EventData.SubjectLogonId,
  },
}

$ocsf.process = {
  pid: int(move $windows.EventData.NewProcessId, base=16),
  path: move $windows.EventData.NewProcessName,
  cmd_line: move $windows.EventData.CommandLine,
  file: { type_id: 8 },
  parent_process: {
    pid: int(move $windows.EventData.ProcessId, base=16),
    path: move $windows.EventData.ParentProcessName?,
  },
}
// The mandatory label SID encodes the integrity level of the new process.
let $integrity_ids = {
  "S-1-16-0": 1,
  "S-1-16-4096": 2,
  "S-1-16-8192": 3,
  "S-1-16-12288": 4,
  "S-1-16-16384": 5,
  "S-1-16-20480": 6,
}
if $windows.EventData.MandatoryLabel? != null {
  $ocsf.process.integrity_id = $integrity_ids[$windows.EventData.MandatoryLabel]? else 99
  if $ocsf.process.integrity_id == 99 {
    $ocsf.process.integrity = $windows.EventData.MandatoryLabel
  }
  drop $windows.EventData.MandatoryLabel
}
// Version 2 of the event names the account the new process runs as.
if $windows.EventData.TargetUserName? != null {
  $ocsf.process.user = {
    uid: move $windows.EventData.TargetUserSid?,
    name: move $windows.EventData.TargetUserName,
    domain: move $windows.EventData.TargetDomainName?,
  }
  $ocsf.process.session = {uid_alt: move $windows.EventData.TargetLogonId?}
}
$ocsf.process.name = $ocsf.process.path.split("\\")[-1]
$ocsf.process.file.name = $ocsf.process.name
$ocsf.process.file.path = $ocsf.process.path
if $ocsf.process.parent_process.path? != null {
  $ocsf.process.parent_process.name = $ocsf.process.parent_process.path.split("\\")[-1]?
  $ocsf.process.parent_process.file = {
    name: $ocsf.process.parent_process.name,
    path: $ocsf.process.parent_process.path,
    type_id: 8,
  }
}

// EID 4688 only fires on success.
$ocsf.status_id = 1

// TargetUserSid/Name/Domain are the impersonation target (usually null after
// sentinel replacement). TokenElevationType and MandatoryLabel have no OCSF home.
