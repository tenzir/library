---
description: Service Control Manager 7036 (service entered a state) → OCSF Application Lifecycle (6002, Start/Stop)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

// The service control manager reports that a service entered a state. The
// event names neither the service configuration nor a process or account that
// requested the change, which Windows Service Activity requires, so it maps to
// the start and stop of the service application, like Windows Firewall 5024.
@name = "ocsf.application_lifecycle"
$ocsf.category_uid = 6
$ocsf.class_uid = 6002
// param1 is the service display name and param2 the new state in the
// language of the system, such as `running` or `Ausgeführt` on German
// Windows, also when the message renders in another language. Binary holds
// the service key name and the state code as UTF-16 hex, such as `Spooler/4`,
// where the code does not depend on the language: 1 is stopped and 4 running.
// Without Binary, the English or German state text decides. Application
// Lifecycle has no activity for other states, such as paused, which map to
// Other with the source state as the activity name.
let $codes = {
  "1": {id: 4, name: "Stop"},
  "4": {id: 3, name: "Start"},
}
let $states = {
  running: {id: 3, name: "Start"},
  stopped: {id: 4, name: "Stop"},
  "ausgeführt": {id: 3, name: "Start"},
  beendet: {id: 4, name: "Stop"},
}
_code = $windows.EventData.Binary?.to_upper().replace_regex(r"^(?:[0-9A-F]{4})*2F003([0-9])000000$", r"\1")
_activity = $codes[_code]? if _code?.length_bytes() == 1 else null
_activity = _activity else $states[$windows.EventData.param2?.to_lower()]?
$ocsf.activity_name = move $windows.EventData.param2
$ocsf.activity_id = _activity.id? else 99
$ocsf.activity_name = _activity.name? else $ocsf.activity_name
drop _code, _activity
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.status_id = 1  // Success
$ocsf.application = {
  name: move $windows.EventData.param1,
  type: "Windows Service",
}
// The service control manager performs the state transitions and writes the
// event, so the header's process is services.exe. The event names no caller.
$ocsf.actor = {
  process: {
    pid: move $windows.System.Execution.ProcessID?,
    ptid: move $windows.System.Execution.ThreadID?,
  },
}
drop $windows.System.Execution?
// Binary stays in unmapped. NXLog Community Edition drops it.
