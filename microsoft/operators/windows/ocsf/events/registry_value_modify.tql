---
description: Registry Value Changed (EID 4657) → OCSF Registry Value Activity (201002)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.registry_value_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 201002
// Canonicalization renders the operation token, such as `%%1904`, as the
// message text that Winlogbeat also reports.
match $windows.EventData.OperationType {
  "New registry value created" => { $ocsf.activity_id = 2 } // Set
  "Existing registry value modified" => { $ocsf.activity_id = 3 } // Modify
  "Registry value deleted" => { $ocsf.activity_id = 4 } // Delete
  _ => { $ocsf.activity_id = 0 } // Unknown
}
drop $windows.EventData.OperationType
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.actor = {
  user: {
    uid: move $windows.EventData.SubjectUserSid,
    name: move $windows.EventData.SubjectUserName,
    domain: move $windows.EventData.SubjectDomainName,
  },
  session: {
    uid_alt: move $windows.EventData.SubjectLogonId,
  },
  process: {
    pid: int(move $windows.EventData.ProcessId, base=16),
    path: move $windows.EventData.ProcessName,
    file: {type_id: 8},
  },
}
$ocsf.actor.process.name = $ocsf.actor.process.path.split("\\")[-1]
$ocsf.actor.process.file = {
  name: $ocsf.actor.process.name,
  path: $ocsf.actor.process.path,
  type_id: 8,
}

// Canonicalization renders known value-type tokens, such as `%%1874`, as the
// message text, such as `REG_EXPAND_SZ`. The text of `REG_MULTI_SZ` carries a
// note on the data encoding after the type name. A known type name maps to
// the OCSF type, and unknown tokens stay in unmapped.
$ocsf.reg_value = {
  path: move $windows.EventData.ObjectName,
  name: move $windows.EventData.ObjectValueName,
  type_id: microsoft::$windows_registry_value_types[$windows.EventData.NewValueType?.split(" ")[0]]?,
  data: move $windows.EventData.NewValue,
}
$ocsf.reg_value.type = $windows.EventData.NewValueType?.split(" ")[0] if $ocsf.reg_value.type_id != null else null
if $ocsf.reg_value.type_id != null {
  drop $windows.EventData.NewValueType
}
$ocsf.prev_reg_value = {
  path: $ocsf.reg_value.path,
  name: $ocsf.reg_value.name,
  type_id: microsoft::$windows_registry_value_types[$windows.EventData.OldValueType?.split(" ")[0]]?,
  data: move $windows.EventData.OldValue,
}
$ocsf.prev_reg_value.type = $windows.EventData.OldValueType?.split(" ")[0] if $ocsf.prev_reg_value.type_id != null else null
if $ocsf.prev_reg_value.type_id != null {
  drop $windows.EventData.OldValueType
}

// HandleId remains in unmapped for source-level correlation.
