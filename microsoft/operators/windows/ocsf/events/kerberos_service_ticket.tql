---
description: Kerberos Service Ticket Requested (EID 4769) → OCSF Authentication (3002, Service Ticket)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.authentication"

$ocsf.category_uid = 3
$ocsf.class_uid = 3002
$ocsf.activity_id = 4  // Service Ticket
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// Status 0x0 = success; anything else = failure (e.g. 0x1F = no TGT).
// Without a status, the audit keywords decide.
if $windows.EventData.Status? == "0x0" {
  $ocsf.status_id = 1
} else if $windows.EventData.Status? != null {
  $ocsf.status_id = 2
} else {
  microsoft::windows::ocsf::audit_status $windows, $ocsf
}
$ocsf.status_code = move $windows.EventData.Status?

// TargetUserName usually includes @REALM (e.g. "jdoe@CORP.LOCAL"); split off
// the realm into domain. Fall back to TargetDomainName when no @ is present.
_parts = (move $windows.EventData.TargetUserName).split("@")
$ocsf.user = {
  name: _parts[0],
  domain: _parts[1]? else move $windows.EventData.TargetDomainName,
}
drop _parts

// The domain controller that logs the event is the KDC that issues the ticket.
$ocsf.dst_endpoint = {
  hostname: $ocsf.device.hostname,
  svc_name: move $windows.EventData.ServiceName,
}

$ocsf.src_endpoint = {
  ip: $windows.EventData.IpAddress.ip(),
  port: (move $windows.EventData.IpPort).int(),
}
// Keep an address that is not an IP address, such as a host name, in unmapped.
if $ocsf.src_endpoint.ip != null or $windows.EventData.IpAddress? == null {
  drop $windows.EventData.IpAddress?
}

// The logon GUID links this TGS request back to the original TGT logon event.
$ocsf.session = {
  uid: move $windows.EventData.LogonGuid,
}

$ocsf.auth_protocol_id = 2
$ocsf.service = {
  name: $ocsf.dst_endpoint.svc_name,
  uid: move $windows.EventData.ServiceSid?,
}
$ocsf.authentication_token = {
  type_id: 2,
  kerberos_flags: move $windows.EventData.TicketOptions?,
}
// TicketEncryptionType and TransmittedServices remain source-specific.
