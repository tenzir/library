---
description: Local Group Membership Query (EID 4799) → OCSF Live Evidence Info (5040)
args:
  named:
    - name: event
      description: The working event to map.
      type: field
---

@name = "ocsf.evidence_info"

$event.ocsf.category_uid = 5
$event.ocsf.class_uid = 5040
$event.ocsf.activity_id = 1  // Query
$event.ocsf.type_uid = $event.ocsf.class_uid * 100 + $event.ocsf.activity_id
$event.ocsf.query_result_id = 1  // Exists

$event.ocsf.query_evidence = {
  query_type_id: 4, // Admin Group
  group: {
    uid: move $event.windows.EventData.TargetSid,
    name: move $event.windows.EventData.TargetUserName,
    domain: move $event.windows.EventData.TargetDomainName,
  },
}

// The class has no actor attribute. Preserve the subject and caller process in
// unmapped so downstream detections can identify who performed the discovery.
