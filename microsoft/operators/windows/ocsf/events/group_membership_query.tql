---
description: Local Group Membership Query (EID 4799) → OCSF Live Evidence Info (5040)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.evidence_info"

$ocsf.category_uid = 5
$ocsf.class_uid = 5040
$ocsf.activity_id = 1  // Query
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.query_result_id = 1  // Exists

$ocsf.query_evidence = {
  query_type_id: 4, // Admin Group
  group: {
    uid: move $windows.EventData.TargetSid,
    name: move $windows.EventData.TargetUserName,
    domain: move $windows.EventData.TargetDomainName,
  },
}

// The class has no actor attribute. Preserve the subject and caller process in
// unmapped so downstream detections can identify who performed the discovery.
