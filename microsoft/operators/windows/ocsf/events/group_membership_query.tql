---
description: Local Group Membership Query (EID 4799) → OCSF Live Evidence Info (5040)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.evidence_info"

$ocsf.category_uid = 5
$ocsf.class_uid = 5040
$ocsf.activity_id = 1  // Query
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
// The audit keywords tell whether the change succeeded.
microsoft::windows::ocsf::audit_status $windows, $ocsf
$ocsf.query_result_id = 1  // Exists

$ocsf.query_evidence = {
  query_type_id: 99, // Other
  query_type: "Local Group Membership",
  group: {
    uid: move $windows.EventData.TargetSid,
    name: move $windows.EventData.TargetUserName,
    domain: move $windows.EventData.TargetDomainName,
  },
}

// The subject performed the query with the caller process, if Windows names
// one. The host profile carries both.
if $windows.EventData.SubjectUserSid? != null or $windows.EventData.SubjectUserName? != null {
  $ocsf.actor = {
    user: {
      uid: move $windows.EventData.SubjectUserSid?,
      name: move $windows.EventData.SubjectUserName?,
      domain: move $windows.EventData.SubjectDomainName?,
    },
    session: {uid_alt: move $windows.EventData.SubjectLogonId?},
  }
}
// Without a caller process, Windows writes `0x0` and `-`.
if $windows.EventData.CallerProcessName? != null {
  $ocsf.actor.process = {
    pid: int(move $windows.EventData.CallerProcessId?, base=16),
    path: $windows.EventData.CallerProcessName,
    name: $windows.EventData.CallerProcessName.split("\\")[-1],
    file: {
      type_id: 8,
      name: $windows.EventData.CallerProcessName.split("\\")[-1],
      path: $windows.EventData.CallerProcessName,
    },
  }
  drop $windows.EventData.CallerProcessName
}
