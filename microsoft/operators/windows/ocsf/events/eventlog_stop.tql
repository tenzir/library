---
description: Event Log Service Stopped (EID 6006) → OCSF Windows Service Activity (201004, Stop)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.windows_service_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 201004
$ocsf.activity_id = 4  // Stop
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.win_service = {
  name: "Windows Event Log",
}

drop $windows.EventData
