---
description: >
  Account Change (EID 4720/4722–4726/4740/4767) → OCSF Account Change (3001)
  4720 Create, 4722 Enable, 4723 Password Change, 4724 Password Reset,
  4725 Disable, 4726 Delete, 4740 Lock, 4767 Unlock
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
  named:
    - name: activity_id
      description: The OCSF account change activity identifier.
      type: int
---

@name = "ocsf.account_change"

$ocsf.category_uid = 3
$ocsf.class_uid = 3001

$ocsf.activity_id = $activity_id
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.actor = {
  user: {
    uid: move $windows.EventData.SubjectUserSid,
    name: move $windows.EventData.SubjectUserName,
    domain: move $windows.EventData.SubjectDomainName,
  },
  session: {
    uid_alt: move $windows.EventData.SubjectLogonId,
  },
}

$ocsf.user = {
  uid: move $windows.EventData.TargetSid,
  name: move $windows.EventData.TargetUserName,
  domain: move $windows.EventData.TargetDomainName,
}

// Do not interpret Windows message-resource tokens as real account values.
if not $windows.EventData.DisplayName?.starts_with("%%") and
   $windows.EventData.DisplayName? != "-" {
  $ocsf.user.display_name = move $windows.EventData.DisplayName?
}
if not $windows.EventData.UserPrincipalName?.starts_with("%%") and
   $windows.EventData.UserPrincipalName? != "-" {
  $ocsf.user.uid_alt = move $windows.EventData.UserPrincipalName?
}

// EID 4720 carries many account-attribute fields (HomeDirectory,
// UserAccountControl flags, etc.) containing either real values or Windows
// sentinel strings ("%%1793" = not set, "%%1794" = never). These stay in
// unmapped; downstream enrichment can decode %%NNNN message IDs if needed.
