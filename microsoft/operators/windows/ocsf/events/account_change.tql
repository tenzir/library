---
description: >
  Account Change (EID 4720/4722–4726/4740/4741/4743/4767) → OCSF Account
  Change (3001): 4720 Create, 4722 Enable, 4723 Password Change, 4724 Password
  Reset, 4725 Disable, 4726 Delete, 4740 Lock, 4741 Computer Account Create,
  4743 Computer Account Delete, 4767 Unlock
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
  named:
    - name: activity_id
      description: The OCSF account change activity identifier.
      type: int
---

@name = "ocsf.account_change"

$ocsf.category_uid = 3
$ocsf.class_uid = 3001

$ocsf.activity_id = $activity_id
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.actor = {
  user: {
    uid: move $windows.EventData.SubjectUserSid,
    name: move $windows.EventData.SubjectUserName,
    domain: move $windows.EventData.SubjectDomainName,
  },
  session: {
    uid_alt: move $windows.EventData.SubjectLogonId,
  },
}

$ocsf.user = {
  uid: move $windows.EventData.TargetSid,
  name: move $windows.EventData.TargetUserName,
  domain: move $windows.EventData.TargetDomainName,
}

// A lockout (4740) names the computer the failed logons came from, the caller
// computer, in TargetDomainName.
if $windows.System.EventID == 4740 {
  $ocsf.src_endpoint = {hostname: move $ocsf.user.domain}
}

// Do not interpret placeholders such as "<value not set>", or message tokens
// that canonicalization does not know, as real account values.
if $windows.EventData.DisplayName? not in ["<value not set>", "<never>"] and not $windows.EventData.DisplayName?.starts_with("%%") {
  $ocsf.user.display_name = move $windows.EventData.DisplayName?
}
if $windows.EventData.UserPrincipalName? not in ["<value not set>", "<never>"] and not $windows.EventData.UserPrincipalName?.starts_with("%%") {
  $ocsf.user.uid_alt = move $windows.EventData.UserPrincipalName?
}

// EID 4720 carries many account-attribute fields (HomeDirectory,
// UserAccountControl flags, etc.) containing either real values or Windows
// placeholders such as "<value not set>" (`%%1793`) and "<never>" (`%%1794`).
// These stay in unmapped.
