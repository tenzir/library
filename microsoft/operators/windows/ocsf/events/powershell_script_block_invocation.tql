---
description: >
  PowerShell Script Block Invocation Start/Stop (EID 4105/4106)
  → OCSF Script Activity (1009, Execute)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.script_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1009
$ocsf.activity_id = 1  // Execute
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// Windows Level 5 (Verbose).
$ocsf.severity_id = 1  // Informational

// These events report only that the script block with ScriptBlockId started
// or stopped in a runspace. They do not include the script text, which only
// 4104 records, so the script lacks the required script_content and ocsf_cast
// warns. script.uid links them to the matching 4104 record.
$ocsf.script = {
  uid: move $windows.EventData.ScriptBlockId,
  type_id: 2,  // PowerShell
}

// PowerShell writes the event from its host process, as for 4104.
$ocsf.actor = {
  process: {
    pid: move $windows.System.Execution.ProcessID?,
    ptid: move $windows.System.Execution.ThreadID?,
  },
  session: {
    uid: move $windows.EventData.RunspaceId,
  },
}
drop $windows.System.Execution?
