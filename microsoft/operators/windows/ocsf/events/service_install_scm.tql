---
description: New Service Installed via SCM (EID 7045) → OCSF Windows Service Activity (201004, Create)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.windows_service_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 201004
$ocsf.activity_id = 1  // Create
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

_service_cmd_line = move $windows.EventData.ImagePath
$ocsf.win_service = {
  name: move $windows.EventData.ServiceName,
  cmd_line: _service_cmd_line,
  service_start_name: move $windows.EventData.AccountName,
}

if _service_cmd_line? != null {
  _service_file_path = _service_cmd_line.split("\"")[1]? if _service_cmd_line.starts_with("\"") else _service_cmd_line.split(" -")[0].split(" /")[0]
  if _service_file_path? != null {
    $ocsf.win_service.service_file = {
      path: _service_file_path,
      name: _service_file_path.split("\\")[-1]?,
      type_id: 8,
    }
  }
}

_service_type = move $windows.EventData.ServiceType?
match _service_type?.to_lower() {
  "kernel mode driver" => {
    $ocsf.win_service.service_category_id = 1
    $ocsf.win_service.service_type_id = 1
  }
  "file system driver" => {
    $ocsf.win_service.service_category_id = 1
    $ocsf.win_service.service_type_id = 2
  }
  "own process" => {
    $ocsf.win_service.service_category_id = 2
    $ocsf.win_service.service_type_id = 3
  }
  "share process" => {
    $ocsf.win_service.service_category_id = 2
    $ocsf.win_service.service_type_id = 4
  }
  "user mode service" => { $ocsf.win_service.service_category_id = 2 }
  _ => {
    if _service_type? != null {
      $ocsf.win_service.service_category_id = 99
      $ocsf.win_service.service_category = _service_type
    }
  }
}

_start_type = move $windows.EventData.StartType?
match _start_type?.to_lower() {
  "boot start" => { $ocsf.win_service.service_start_type_id = 1 }
  "system start" => { $ocsf.win_service.service_start_type_id = 2 }
  "auto start" => { $ocsf.win_service.service_start_type_id = 3 }
  "demand start" => { $ocsf.win_service.service_start_type_id = 4 }
  "disabled" => { $ocsf.win_service.service_start_type_id = 5 }
  _ => {
    if _start_type? != null {
      $ocsf.win_service.service_start_type_id = 99
      $ocsf.win_service.service_start_type = _start_type
    }
  }
}
drop _service_cmd_line, _service_file_path?, _service_type, _start_type
