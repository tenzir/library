---
description: Windows Firewall Rule Change (EID 4946/4948) → OCSF Entity Management (3004)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
  named:
    - name: activity_id
      description: The OCSF entity management activity identifier.
      type: int
---

@name = "ocsf.entity_management"

$ocsf.category_uid = 3
$ocsf.class_uid = 3004
$ocsf.activity_id = $activity_id
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.entity = {
  uid: move $windows.EventData.RuleId,
  name: move $windows.EventData.RuleName,
  type_id: 99,
  type: "Firewall Rule",
  data: {
    profiles: move $windows.EventData.ProfileChanged,
  },
}
