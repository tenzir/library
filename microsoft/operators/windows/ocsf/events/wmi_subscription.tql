---
description: >
  Windows WMI permanent subscription creation (EID 5861)
  → OCSF Entity Management (3004).
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.entity_management"

$ocsf.category_uid = 3
$ocsf.class_uid = 3004
$ocsf.activity_id = 1  // Create
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// The event registers a binding between an event filter (ESS) and a
// permanent consumer. Sysmon EID 21 reports the same binding.
$ocsf.entity = {
  type_id: 99,
  type: "WMI Filter-to-Consumer Binding",
  name: $windows.UserData.Operation_ESStoConsumerBinding.ESS? + " -> "
    + $windows.UserData.Operation_ESStoConsumerBinding.CONSUMER?,
  data: {
    namespace: move $windows.UserData.Operation_ESStoConsumerBinding.Namespace?,
    filter: move $windows.UserData.Operation_ESStoConsumerBinding.ESS?,
    consumer: move $windows.UserData.Operation_ESStoConsumerBinding.CONSUMER?,
    possible_cause: move $windows.UserData.Operation_ESStoConsumerBinding.PossibleCause?,
  },
}
