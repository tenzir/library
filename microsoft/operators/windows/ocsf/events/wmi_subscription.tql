---
description: >
  Windows WMI permanent subscription creation (EID 5861)
  → OCSF Entity Management (3004).
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.entity_management"

$ocsf.category_uid = 3
$ocsf.class_uid = 3004
$ocsf.activity_id = 1  // Create
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.entity = {
  type_id: 99,
  type: "WMI Permanent Subscription",
  name: move $windows.UserData.Operation_ESStoConsumerBinding.ESS?,
  data: {
    namespace: move $windows.UserData.Operation_ESStoConsumerBinding.Namespace?,
    consumer: move $windows.UserData.Operation_ESStoConsumerBinding.CONSUMER?,
    possible_cause: move $windows.UserData.Operation_ESStoConsumerBinding.PossibleCause?,
  },
}
