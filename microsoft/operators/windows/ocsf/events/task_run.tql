---
description: >
  Task Scheduler Execution (EID 100 Start, 101 Start Failure, 102 Complete,
  103 Execution Failure, 110 Triggered by User, 129 Process Launch,
  200 Action Start, 201 Action Complete, 202 Action Failure, 325 Queued)
  → OCSF Scheduled Job Activity (1006)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
  named:
    - name: activity_id
      description: The OCSF scheduled job activity identifier.
      type: int
    - name: activity_name
      description: The source activity label when the activity identifier is Other.
      type: string
      default: null
---

@name = "ocsf.scheduled_job_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1006

$ocsf.activity_id = $activity_id
$ocsf.activity_name = $activity_name
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// EIDs 101, 103, 201, 202, and 203 carry a ResultCode; non-zero means failure.
$ocsf.status_code = move $windows.EventData.ResultCode?
$ocsf.status_id = (1 if $ocsf.status_code == "0" else 2) if $ocsf.status_code != null else null

// ActionName is the executable path for EIDs 200–203, which OCSF represents as
// both a command line and a file. InstanceId/TaskInstanceId has no OCSF job
// field and stays in unmapped.
$ocsf.job = {
  name: move $windows.EventData.TaskName,
  job_actions: [{
    type_id: 2,
    cmd_line: $windows.EventData.ActionName,
    file: {
      path: $windows.EventData.ActionName,
      name: $windows.EventData.ActionName.split("\\")[-1]?,
      type_id: 1,
    },
  }] if $windows.EventData.ActionName? != null else null,
}
drop $windows.EventData.ActionName?

// The process ID of a launched task process (129, ProcessID) and the engine
// (200–202, EnginePID) belong to the job, not to the actor, and stay in
// unmapped.
microsoft::windows::ocsf::events::task_actor $windows, $ocsf
