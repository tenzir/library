---
description: >
  Task Scheduler Execution (EID 100 Start, 101 Start Failure, 102 Complete,
  103 Execution Failure, 129 Process Launch, 200 Action Start,
  201 Action Complete, 202 Action Failure)
  → OCSF Scheduled Job Activity (1006)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
  named:
    - name: activity_id
      description: The OCSF scheduled job activity identifier.
      type: int
---

@name = "ocsf.scheduled_job_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1006

$ocsf.activity_id = $activity_id
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// EIDs 102, 201, and 202 carry a ResultCode; non-zero means failure.
if $windows.EventData.has("ResultCode") {
  $ocsf.status_id = 1 if $windows.EventData.ResultCode.int() == 0 else 2
  $ocsf.status_code = (move $windows.EventData.ResultCode).string()
}

$ocsf.job = {
  name: move $windows.EventData.TaskName,
}
// InstanceId/TaskInstanceId has no OCSF job field; leave in unmapped.

// ActionName is the executable path for EIDs 200–202.
if $windows.EventData.ActionName? != null {
  // The action is represented as both a command line and a file in OCSF.
  $ocsf.job.job_actions = [{
    type_id: 2,
    cmd_line: $windows.EventData.ActionName,
    file: {
      path: $windows.EventData.ActionName,
      name: $windows.EventData.ActionName.split("\\")[-1]?,
      type_id: 1,
    },
  }]
  drop $windows.EventData.ActionName
}

// UserContext present on EID 100.
if $windows.EventData.UserContext? != null {
  _user = (move $windows.EventData.UserContext).split("\\")
  $ocsf.actor = {
    user: {
      domain: _user[0]? if _user.length() > 1,
      name: _user[-1]?,
    },
  }
  drop _user
}

// ProcessId (EID 129) or EnginePID (EIDs 200–202).
if $windows.EventData.ProcessId? != null {
  $ocsf.actor.process = { pid: int(move $windows.EventData.ProcessId) }
} else if $windows.EventData.EnginePID? != null {
  $ocsf.actor.process = { pid: int(move $windows.EventData.EnginePID) }
}
