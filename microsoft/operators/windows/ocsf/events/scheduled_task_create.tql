---
description: Scheduled Task Lifecycle (EID 4698–4702) → OCSF Scheduled Job Activity (1006)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
  named:
    - name: activity_id
      description: The OCSF scheduled job activity identifier.
      type: int
---

@name = "ocsf.scheduled_job_activity"

$ocsf.category_uid = 1
$ocsf.class_uid = 1006
$ocsf.activity_id = $activity_id
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
// The audit keywords tell whether the change succeeded.
microsoft::windows::ocsf::audit_status $windows, $ocsf

// The process that made the Task Scheduler RPC call.
$ocsf.actor = {
  user: {
    uid: move $windows.EventData.SubjectUserSid,
    name: move $windows.EventData.SubjectUserName,
    domain: move $windows.EventData.SubjectDomainName,
  },
  session: {
    uid_alt: move $windows.EventData.SubjectLogonId,
  },
}
microsoft::windows::ocsf::client_process $windows, $ocsf

$ocsf.job = {
  name: move $windows.EventData.TaskName,
}

// The task definition is an XML string with the triggers and actions of the
// task, which 4702 reports as TaskContentNew. Each Exec action is a job
// action, whose command line is its command with its arguments. Windows
// escapes the definition as XML, and a command with spaces needs quotes to
// stay one word of the command line. A bare command, such as `cmd.exe`, names
// the file but not its path. The definition stays in unmapped, as do
// ClientProcessStartKey, ParentProcessId, RpcCallClientLocality, and FQDN.
_task = $windows.EventData.TaskContent? else $windows.EventData.TaskContentNew?
if _task.match_regex(r"<Exec(\s[^>]*)?>[\s\S]*?<Command>") == true {
  _execs = (
    _task.split_regex(r"<Exec(?:\s[^>]*)?>")
      .slice(begin=1)
      .map(x => x.split("</Exec>")[0])
      .where(x => x.match_regex(r"<Command>"))
      .map(x => {
        command: x.replace_regex(r"^[\s\S]*?<Command>([\s\S]*?)</Command>[\s\S]*$", r"\1").trim(),
        arguments: x.replace_regex(r"^[\s\S]*?<Arguments>([\s\S]*?)</Arguments>[\s\S]*$", r"\1").trim() if x.match_regex(r"<Arguments>") else "",
        directory: x.replace_regex(r"^[\s\S]*?<WorkingDirectory>([\s\S]*?)</WorkingDirectory>[\s\S]*$", r"\1").trim() if x.match_regex(r"<WorkingDirectory>") else "",
      })
      .map(x => {
        command: x.command.replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"").replace("&apos;", "'").replace("&amp;", "&"),
        arguments: x.arguments.replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"").replace("&apos;", "'").replace("&amp;", "&"),
        directory: x.directory.replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"").replace("&apos;", "'").replace("&amp;", "&"),
      })
      .map(x => {...x, file: x.command.trim("\"")})
  )
  $ocsf.job.job_actions = _execs.map(x => {
    type_id: 2,  // Execute
    cmd_line: (f"\"{x.command}\"" if x.command.match_regex(r"\s") and not x.command.starts_with("\"") else x.command)
      + (" " + x.arguments if x.arguments != "" else ""),
    file: {
      ...({path: x.file} if x.file.match_regex(r"[\\/]") else {}),
      name: x.file.split("\\")[-1].split("/")[-1],
      type_id: 1,  // Regular File
    },
    ...({working_directory: x.directory} if x.directory != "" else {}),
  })
  drop _execs
}
drop _task
