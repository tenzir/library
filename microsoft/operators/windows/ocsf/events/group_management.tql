---
description: >
  Windows group lifecycle and membership changes → OCSF Group Management
  (3006)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
  named:
    - name: activity_id
      description: The OCSF group management activity identifier.
      type: int
---

@name = "ocsf.group_management"

$ocsf.category_uid = 3
$ocsf.class_uid = 3006

$ocsf.activity_id = $activity_id
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.actor = {
  user: {
    uid: move $windows.EventData.SubjectUserSid,
    name: move $windows.EventData.SubjectUserName,
    domain: move $windows.EventData.SubjectDomainName,
  },
  session: {
    uid_alt: move $windows.EventData.SubjectLogonId,
  },
}

// TargetUser* fields describe the group being acted on (not a user account).
$ocsf.group = {
  uid: move $windows.EventData.TargetSid,
  name: move $windows.EventData.TargetUserName,
  domain: move $windows.EventData.TargetDomainName,
}

// EID 4764 describes both sides of a group-type transition in one field.
if $windows.EventData.GroupTypeChange? != null {
  _group_types = (move $windows.EventData.GroupTypeChange).split(" Changed to ")
  $ocsf.updated_group = {...$ocsf.group, type: _group_types[1]}
  $ocsf.group.type = _group_types[0]
  drop _group_types
}

// Member fields are present on add/remove events.
if $windows.EventData.MemberSid? != null {
  $ocsf.user = {
    uid: move $windows.EventData.MemberSid,
    name: move $windows.EventData.MemberName,
  }
}

// PrivilegeList is always "-" on these events; drop to keep unmapped clean.
drop $windows.EventData.PrivilegeList
