---
description: >
  Security Group Lifecycle (EID 4727–4730/4737 global, 4731–4735 local,
  4754–4758 universal) → OCSF Group Management (3006)
args:
  named:
    - name: event
      description: The working event to map.
      type: field
    - name: activity_id
      description: The OCSF group management activity identifier.
      type: int
---

@name = "ocsf.group_management"

$event.ocsf.category_uid = 3
$event.ocsf.class_uid = 3006

$event.ocsf.activity_id = $activity_id
$event.ocsf.type_uid = $event.ocsf.class_uid * 100 + $event.ocsf.activity_id

$event.ocsf.actor = {
  user: {
    uid: move $event.windows.EventData.SubjectUserSid,
    name: move $event.windows.EventData.SubjectUserName,
    domain: move $event.windows.EventData.SubjectDomainName,
  },
  session: {
    uid_alt: move $event.windows.EventData.SubjectLogonId,
  },
}

// TargetUser* fields describe the group being acted on (not a user account).
$event.ocsf.group = {
  uid: move $event.windows.EventData.TargetSid,
  name: move $event.windows.EventData.TargetUserName,
  domain: move $event.windows.EventData.TargetDomainName,
}

// Member fields only present on add/remove events (4728/4729/4732/4733/4756/4757).
if $event.windows.EventData.MemberSid? != null {
  $event.ocsf.user = {
    uid: move $event.windows.EventData.MemberSid,
    name: move $event.windows.EventData.MemberName,
  }
}

// PrivilegeList is always "-" on these events; drop to keep unmapped clean.
drop $event.windows.EventData.PrivilegeList
