---
description: Windows Error Reporting (EID 1001) → OCSF Application Error (6008, General Error)
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

@name = "ocsf.application_error"

$ocsf.category_uid = 6
$ocsf.class_uid = 6008
$ocsf.activity_id = 1  // General Error
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// Windows Level 4 (Information).
$ocsf.severity_id = 1  // Informational

// The event reports a filed problem report, not the problem itself. Its event
// name (param3) says what was reported: application crashes (APPCRASH) also
// produce Application Error 1000, while most reports concern other problems,
// such as WindowsUpdateFailure3 or PnPDriverNotFound. The meaning of the
// problem signature (param6–param15) depends on the event name, so the
// positional values stay in unmapped.
