---
description: Marks a Task Scheduler execution event as failed.
args:
  positional:
    - name: windows
      description: The Windows event to map.
      type: field
    - name: ocsf
      description: The field that receives the OCSF event.
      type: field
---

$ocsf.status_id = 2  // Failure
$ocsf.severity_id = 3  // Medium
