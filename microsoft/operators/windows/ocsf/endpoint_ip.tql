---
description: |
  Maps a Windows client address to the IP address of an OCSF endpoint. An
  address that is not an IP address, such as a host name or `LOCAL`, stays
  where it is, so that it remains in unmapped.
args:
  positional:
    - name: address
      type: field
      description: The address, which the operator consumes when it is an IP address.
    - name: endpoint
      type: field
      description: The OCSF endpoint that receives the IP address.
---

$endpoint.ip = $address.ip()
if $endpoint.ip != null or $address == null {
  drop $address
}
