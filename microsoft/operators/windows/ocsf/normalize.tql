---
description: |
  Normalizes Microsoft Windows Event Log XML or a supported collector record to
  OCSF 1.9. Supports canonical records and events from Fluent Bit, NXLog, and
  Winlogbeat.
args:
  positional:
    - name: event
      description: Windows Event Log XML or a supported collector record.
      type: field
      default: this
  named:
    - name: into
      description: The field that receives the OCSF event.
      type: field
      default: this
---

$into = {source: $event}
microsoft::windows::canonicalize $into.source, $into.windows
microsoft::windows::ocsf::map $into.windows, $into.ocsf
$into = move $into.ocsf
