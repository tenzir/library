---
description: Normalizes a structured Windows Event Log record to OCSF 1.9.
args:
  positional:
    - name: event
      description: The structured Windows Event Log record.
      type: field
      default: this
  named:
    - name: into
      description: The field that receives the OCSF event.
      type: field
      default: this
---

$into = {source: $event, ocsf: {}}
microsoft::windows::ocsf::map $into.source, $into.ocsf
$into = move $into.ocsf
