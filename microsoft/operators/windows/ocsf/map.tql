---
description: Maps a canonical Microsoft Windows Event Log event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      description: The canonical Windows Event Log event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

match $event.System.Provider.Name {
  "Microsoft-Windows-Sysmon" => {
    microsoft::windows::ocsf::providers::sysmon::map $event, $ocsf
  }
  _ => {
    microsoft::windows::ocsf::providers::map $event, $ocsf
  }
}
