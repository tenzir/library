---
description: Maps a canonical Microsoft Windows Event Log event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      description: The event produced by `microsoft::windows::canonicalize`.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

// Rendered collector modes (e.g. Fluent Bit without `event_data_as_map`)
// carry no structured EventData. The Sysmon mappers depend on it, so route
// such events through the generic provider mapping instead, which falls back
// to the OCSF base event.
if $event.System.Provider.Name == "Microsoft-Windows-Sysmon" and $event.EventData? != null {
  microsoft::windows::ocsf::providers::sysmon::map $event, $ocsf
} else {
  microsoft::windows::ocsf::providers::map $event, $ocsf
}
