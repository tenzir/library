---
description: Maps a canonical Microsoft Windows Event Log event to OCSF 1.9.
args:
  positional:
    - name: windows
      type: field
      description: The event produced by `microsoft::windows::canonicalize`.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

match $windows.System.Provider.Name {
  "Microsoft-Windows-Sysmon" => {
    microsoft::windows::ocsf::providers::sysmon::map $windows, $ocsf
  }
  _ => {
    microsoft::windows::ocsf::providers::map $windows, $ocsf
  }
}
