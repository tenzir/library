---
description: Adds Windows Event Log logger metadata to a canonical event.
args:
  positional:
    - name: event
      type: field
      description: The canonical Windows Event Log event to enrich.
---

$event.Logger = {
  device: {
    hostname: $event.System.Computer,
  },
  event_uid: $event.System.EventRecordID.string(),
  log_name: $event.System.Channel,
  log_provider: $event.System.Provider.Name,
  logged_time: $event.System.TimeCreated.SystemTime,
  name: "Windows Event Log",
  product: {
    name: "Windows Event Log",
    vendor_name: "Microsoft",
  },
}
