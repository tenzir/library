---
description: Preserves incomplete optional objects as source residue.
args:
  positional:
    - name: ocsf
      type: field
      description: The OCSF record to finalize.
---

if (
  $ocsf.actor?.user? != null
  and $ocsf.actor?.user.account? == null
  and $ocsf.actor?.user.name? == null
  and $ocsf.actor?.user.uid? == null
) {
  $ocsf.unmapped.ocsf_residue.actor_user = move $ocsf.actor?.user
}
if (
  $ocsf.actor?.process? != null
  and $ocsf.actor?.process.pid? == null
  and $ocsf.actor?.process.uid? == null
  and $ocsf.actor?.process.cpid? == null
) {
  $ocsf.unmapped.ocsf_residue.actor_process = move $ocsf.actor?.process
}
if (
  $ocsf.logon_process? != null
  and $ocsf.logon_process.pid? == null
  and $ocsf.logon_process.uid? == null
  and $ocsf.logon_process.cpid? == null
) {
  $ocsf.unmapped.ocsf_residue.logon_process = move $ocsf.logon_process
}
if (
  $ocsf.src_endpoint? != null
  and $ocsf.src_endpoint.ip? == null
  and $ocsf.src_endpoint.uid? == null
  and $ocsf.src_endpoint.name? == null
  and $ocsf.src_endpoint.hostname? == null
  and $ocsf.src_endpoint.svc_name? == null
  and $ocsf.src_endpoint.instance_uid? == null
  and $ocsf.src_endpoint.interface_uid? == null
  and $ocsf.src_endpoint.interface_name? == null
  and $ocsf.src_endpoint.domain? == null
) {
  $ocsf.unmapped.ocsf_residue.src_endpoint = move $ocsf.src_endpoint
}
if (
  $ocsf.dst_endpoint? != null
  and $ocsf.dst_endpoint.ip? == null
  and $ocsf.dst_endpoint.uid? == null
  and $ocsf.dst_endpoint.name? == null
  and $ocsf.dst_endpoint.hostname? == null
  and $ocsf.dst_endpoint.svc_name? == null
  and $ocsf.dst_endpoint.instance_uid? == null
  and $ocsf.dst_endpoint.interface_uid? == null
  and $ocsf.dst_endpoint.interface_name? == null
  and $ocsf.dst_endpoint.domain? == null
) {
  $ocsf.unmapped.ocsf_residue.dst_endpoint = move $ocsf.dst_endpoint
}

if $ocsf.actor? != null and drop_null_fields($ocsf.actor).is_empty() {
  drop $ocsf.actor
}

if $ocsf.device?.os? != null {
  $ocsf.device.os.type_id = $ocsf.device.os.type_id? else 0
}
if $ocsf.src_endpoint?.os? != null {
  $ocsf.src_endpoint.os.type_id = $ocsf.src_endpoint.os.type_id? else 0
}
if $ocsf.module? != null {
  $ocsf.module.load_type_id = $ocsf.module.load_type_id? else 0
}
if $ocsf.malware? != null {
  $ocsf.malware = $ocsf.malware.map(m => {...m, classification_ids: m.classification_ids? else [0]})
}
if (
  $ocsf.application?.url? != null
  and $ocsf.application.url.url_string? == null
  and $ocsf.application.url.path? == null
) {
  $ocsf.unmapped.ocsf_residue.application_url = move $ocsf.application.url
}
if $ocsf.resources? != null {
  $ocsf.unmapped.ocsf_residue.resource_owners = $ocsf.resources.where(r => r.owner? != null
    and r.owner.account? == null
    and r.owner.name? == null
    and r.owner.uid? == null).map(r => {
    uid: r.uid?,
    owner: r.owner
  })
  $ocsf.resources = $ocsf.resources.map(r => {
    ...r,
    owner: r.owner? if r.owner?.account? != null or r.owner?.name? != null or r.owner?.uid? != null else null
  })
}
if (
  $ocsf.process? != null
  and $ocsf.process.pid? == null
  and $ocsf.process.uid? == null
  and $ocsf.process.cpid? == null
) {
  $ocsf.unmapped.ocsf_residue.process = move $ocsf.process
}
if (
  $ocsf.entity? != null
  and $ocsf.entity.name? == null
  and $ocsf.entity.uid? == null
  and $ocsf.entity.device? == null
  and $ocsf.entity.group? == null
  and $ocsf.entity.org? == null
  and $ocsf.entity.policy? == null
  and $ocsf.entity.user? == null
) {
  $ocsf.unmapped.ocsf_residue.entity = move $ocsf.entity
}
if $ocsf.connection_info? != null {
  $ocsf.connection_info.direction_id = $ocsf.connection_info.direction_id? else 0
}
if (
  $ocsf.class_uid == 3002
  and $ocsf.service? == null
  and $ocsf.dst_endpoint? == null
  and $ocsf.device?.hostname? != null
) {
  $ocsf.dst_endpoint = {hostname: $ocsf.device.hostname}
}
if $ocsf.file? != null and $ocsf.file.name? == null and $ocsf.file.path? != null {
  $ocsf.file.name = $ocsf.file.path.replace("\\", "/").split("/")[-1]
}
if $ocsf.file? != null and $ocsf.file.name? == null {
  $ocsf.unmapped.ocsf_residue.file = move $ocsf.file
}
// These System Activity classes require an actor, device, and their primary
// object. Incomplete observations retain their typed facts as Base Event data.
if (
  ($ocsf.category_uid == 1
  and ($ocsf.actor? == null
  or $ocsf.device? == null
  or ($ocsf.class_uid == 1001
  and $ocsf.file? == null)
  or ($ocsf.class_uid == 1007
  and $ocsf.process? == null)
  or ($ocsf.class_uid == 1009
  and $ocsf.script?.script_content? == null)
  or ($ocsf.class_uid == 1010
  and $ocsf.peripheral_device?.name? == null)))
  or ($ocsf.class_uid == 3004
  and $ocsf.entity? == null)
) {
  $ocsf = {
    time: $ocsf.time,
    metadata: {...$ocsf.metadata, profiles: []},
    category_uid: 0, class_uid: 0, activity_id: 0, type_uid: 0,
    severity_id: $ocsf.severity_id,
    message: $ocsf.message?,
    raw_data: $ocsf.raw_data?, raw_data_size: $ocsf.raw_data_size?,
    unmapped: {
      ...$ocsf.unmapped?,
      incomplete_activity: drop_null_fields({
        ...$ocsf,
        unmapped: null,
        raw_data: null,
        raw_data_size: null
      })
    },
  }
  @name = "ocsf.base_event"
}
