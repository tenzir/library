// Package-wide constants shared across Microsoft OCSF event mappers.

// Entra ID Protection `riskLevel` → OCSF `severity_id` / `risk_level_id`.
let $risk_levels = {none: 1, low: 2, medium: 3, high: 4}
let $risk_level_ids = {none: 0, low: 1, medium: 2, high: 3}

// Entra ID Protection `riskState` → OCSF `status_id`. Distinct from the Defender
// alert status vocabulary, which its mapper keeps locally.
let $statuses = {
  atRisk: 1,
  confirmedCompromised: 1,
  none: 4,
  confirmedSafe: 3,
  remediated: 4,
  dismissed: 3,
}

// Microsoft Graph security `severity` → OCSF `severity_id`, shared by the
// Defender alert and incident mappers.
let $severities = {informational: 1, low: 2, medium: 3, high: 4}

// Microsoft Graph security `classification` → OCSF `verdict_id`.
let $verdicts = {
  unknown: 0,
  falsePositive: 1,
  truePositive: 2,
  informationalExpectedActivity: 5,
}

// OCSF `fingerprint.algorithm_id` values for the hash algorithms Sysmon reports
// in its comma-separated `Hashes` field (e.g. "SHA1=...,MD5=...").
let $sysmon_algorithms = {MD5: 1, SHA1: 2, SHA256: 3, SHA512: 4, IMPHASH: 18}

// OCSF `digital_signature.state_id` values for Sysmon `SignatureStatus`.
let $sysmon_signature_states = {Valid: 1, Expired: 2, Revoked: 3, Untrusted: 6}

// OCSF `auth_protocol_id` values for the Windows `AuthenticationPackageName`.
// Other packages, such as Negotiate, map to Other with the package as caption.
let $windows_auth_protocol_ids = {NTLM: 1, Kerberos: 2}

// Microsoft Defender attack surface reduction rule GUIDs → rule names, from
// https://learn.microsoft.com/en-us/defender-endpoint/attack-surface-reduction-rules-reference
let $defender_asr_rules = {
  "56a863a9-875e-4185-98a7-b882c64b5ce5": "Block abuse of exploited vulnerable signed drivers",
  "9e6c4e1f-7d60-472f-ba1a-a39ef669e4b2": "Block credential stealing from the Windows local security authority subsystem",
  "e6db77e5-3df2-4cf1-b95a-636979351e5b": "Block persistence through WMI event subscription",
  "7674ba52-37eb-4a4f-a9a1-f0f9a1619a2c": "Block Adobe Reader from creating child processes",
  "d4f940ab-401b-4efc-aadc-ad5f3c50688a": "Block all Office applications from creating child processes",
  "be9ba2d9-53ea-4cdc-84e5-9b1eeee46550": "Block executable content from email client and webmail",
  "01443614-cd74-433a-b99e-2ecdc07bfc25": "Block executable files from running unless they meet a prevalence, age, or trusted list criterion",
  "5beb7efe-fd9a-4556-801d-275e5ffc04cc": "Block execution of potentially obfuscated scripts",
  "d3e037e1-3eb8-44c8-a917-57927947596d": "Block JavaScript or VBScript from launching downloaded executable content",
  "3b576869-a4ec-4529-8536-b80a7769e899": "Block Office applications from creating executable content",
  "75668c1f-73b5-4cf0-bb93-3ecf5cb7cc84": "Block Office applications from injecting code into other processes",
  "26190899-1602-49e8-8b27-eb1d0a1ce869": "Block Office communication application from creating child processes",
  "d1e49aac-8f56-4280-b9ba-993a6d77406c": "Block process creations originating from PSExec and WMI commands",
  "33ddedf1-c6e0-47cb-833e-de6133960387": "Block rebooting machine in Safe Mode",
  "b2b3f03d-6a65-4f7b-a9c7-1c7ef74a9ba4": "Block untrusted and unsigned processes that run from USB",
  "c0033c00-d16d-4114-a5a0-dc9b3a7d2ceb": "Block use of copied or impersonated system tools",
  "a8f5898e-1dc8-49a9-9878-85004b8a61e6": "Block Webshell creation for Servers",
  "92e97fa1-2edf-4476-bdd6-9dd0b4dddc7b": "Block Win32 API calls from Office macros",
  "c1db55ab-c21a-4637-bb3f-a12568109d35": "Use advanced protection against ransomware",
}

// OCSF `reg_value.type_id` values for registry value type names. The resource
// types have no OCSF value and map to Other with the name as caption.
let $windows_registry_value_types = {
  REG_BINARY: 1,
  REG_DWORD: 2,
  REG_DWORD_BIG_ENDIAN: 3,
  REG_EXPAND_SZ: 4,
  REG_LINK: 5,
  REG_MULTI_SZ: 6,
  REG_NONE: 7,
  REG_QWORD: 8,
  REG_QWORD_LITTLE_ENDIAN: 9,
  REG_SZ: 10,
  REG_RESOURCE_LIST: 99,
  REG_FULL_RESOURCE_DESCRIPTOR: 99,
  REG_RESOURCE_REQUIREMENTS_LIST: 99,
}

// Microsoft Defender threat categories → OCSF `malware.classification_ids`.
// Other categories, such as Tool, map to Other with the category as caption.
let $defender_malware_classes = {
  Adware: 1,
  Backdoor: 2,
  "Trojan Downloader": 6,
  "Trojan Dropper": 7,
  Ransom: 10,
  "Remote Access Trojan": 11,
  Rootkit: 15,
  Spyware: 17,
  Trojan: 18,
  Virus: 19,
  Worm: 22,
}

// NXLog severity captions emitted in the collector-level `EventType` field.
let $nxlog_event_types = [
  "AUDIT_FAILURE",
  "AUDIT_SUCCESS",
  "CRITICAL",
  "ERROR",
  "INFO",
  "VERBOSE",
  "WARNING",
]

// Windows Security message-table texts for the `%%NNNN` insertion strings that
// Security-Auditing events carry in the EventData fields that
// `$windows_security_message_fields` lists. Windows resolves
// these from msobjs.dll when it renders an event, so Winlogbeat reports the
// text, while Windows Event XML and Fluent Bit report the token. The texts are
// the en-US strings that Windows rendered for the same records in the lab
// corpus, or, for tokens without such a pair, the strings extracted from
// msobjs.dll of Windows 11 23H2 (build 22631). Unknown tokens stay unchanged.
let $windows_security_messages = {
  // Access rights in AccessList and AccessReason (4656, 4661, 4662, 4663,
  // 5145), in Properties (4661, 4662), and in AccessMask (4674).
  "%%1537": "DELETE",
  "%%1538": "READ_CONTROL",
  "%%1539": "WRITE_DAC",
  "%%1540": "WRITE_OWNER",
  "%%1541": "SYNCHRONIZE",
  "%%1542": "ACCESS_SYS_SEC",
  "%%1552": "Unknown specific access (bit 0)",
  "%%4416": "ReadData (or ListDirectory)",
  "%%4417": "WriteData (or AddFile)",
  "%%4418": "AppendData (or AddSubdirectory or CreatePipeInstance)",
  "%%4419": "ReadEA",
  "%%4420": "WriteEA",
  "%%4423": "ReadAttributes",
  "%%4421": "Execute/Traverse",
  "%%4422": "DeleteChild",
  "%%4424": "WriteAttributes",
  "%%4432": "Query key value",
  "%%4433": "Set key value",
  "%%4434": "Create sub-key",
  "%%4435": "Enumerate sub-keys",
  "%%4436": "Notify about changes to keys",
  "%%4437": "Create Link",
  "%%4448": "Query mutant state",
  "%%4484": "Read from process memory",
  "%%4490": "Query process information",
  "%%4528": "Query semaphore state",
  "%%4529": "Modify semaphore state",
  "%%4592": "AssignAsPrimary",
  "%%4593": "Duplicate",
  "%%4594": "Impersonate",
  "%%4595": "Query",
  "%%4596": "QuerySource",
  "%%4597": "AdjustPrivileges",
  "%%4598": "AdjustGroups",
  "%%4599": "AdjustDefaultDacl",
  "%%4600": "AdjustSessionID",
  "%%5649": "Query secret value",
  "%%7186": "Query status of service",
  "%%7188": "Start the service",
  "%%7680": "Create Child",
  "%%7682": "List Contents",
  "%%7684": "Read Property",
  "%%7685": "Write Property",
  "%%7686": "Delete Tree",
  "%%7688": "Control Access",
  // Reasons for granted access in AccessReason (4656, 5145).
  "%%1801": "Granted by",
  "%%1804": "Granted by Ownership",
  "%%1805": "Not granted",
  "%%1809": "Unknown or unchecked",
  // Account attributes and UserAccountControl flags (4720, 4738, 4741, 4742).
  "%%1793": "<value not set>",
  "%%1794": "<never>",
  "%%1797": "All",
  "%%2048": "Account Enabled",
  "%%2050": "'Password Not Required' - Disabled",
  "%%2080": "Account Disabled",
  "%%2082": "'Password Not Required' - Enabled",
  "%%2084": "'Normal Account' - Enabled",
  "%%2087": "'Workstation Trust Account' - Enabled",
  "%%2088": "'Server Trust Account' - Enabled",
  "%%2093": "'Trusted For Delegation' - Enabled",
  // Trust attributes (4706).
  "%%1796": "Disabled",
  // Logon settings (4624) and Boot Configuration Data settings (4826).
  "%%1832": "Identification",
  "%%1833": "Impersonation",
  "%%1840": "Delegation",
  "%%1842": "Yes",
  "%%1843": "No",
  "%%1846": "Default",
  "%%1848": "Off",
  "%%1849": "Auto",
  // Registry values, value types, and operations (4657).
  "%%1800": "<Value change auditing for this registry type is not supported>",
  "%%1872": "REG_NONE",
  "%%1873": "REG_SZ",
  "%%1874": "REG_EXPAND_SZ",
  "%%1875": "REG_BINARY",
  "%%1876": "REG_DWORD",
  "%%1877": "REG_DWORD_BIG_ENDIAN",
  "%%1878": "REG_LINK",
  "%%1879": "REG_MULTI_SZ (New lines are replaced with *. A * is replaced with **)",
  "%%1880": "REG_RESOURCE_LIST",
  "%%1881": "REG_FULL_RESOURCE_DESCRIPTOR",
  "%%1882": "REG_RESOURCE_REQUIREMENTS_LIST",
  "%%1883": "REG_QWORD",
  "%%1904": "New registry value created",
  "%%1905": "Existing registry value modified",
  "%%1906": "Registry value deleted",
  // Token elevation types (4688).
  "%%1936": "TokenElevationTypeDefault (1)",
  "%%1937": "TokenElevationTypeFull (2)",
  "%%1938": "TokenElevationTypeLimited (3)",
  // Logon failure reasons (4625).
  "%%2304": "An Error occured during Logon.",
  "%%2309": "The specified account's password has expired.",
  "%%2313": "Unknown user name or bad password.",
  // Cryptographic key operations (5058, 5059, 5061).
  "%%2458": "Read persisted key from file.",
  "%%2459": "Write persisted key to file.",
  "%%2464": "Export of persistent cryptographic key.",
  "%%2480": "Open Key.",
  "%%2481": "Create Key.",
  "%%2499": "Machine key.",
  "%%2500": "User key.",
  // Credential Manager read operations (5379).
  "%%8099": "Read Credential",
  "%%8100": "Enumerate Credentials",
  // Audit policy categories and subcategories (4719).
  "%%8272": "System",
  "%%8273": "Logon/Logoff",
  "%%8274": "Object Access",
  "%%8275": "Privilege Use",
  "%%8276": "Detailed Tracking",
  "%%8277": "Policy Change",
  "%%8278": "Account Management",
  "%%8279": "DS Access",
  "%%8280": "Account Logon",
  "%%8448": "Success removed",
  "%%8449": "Success Added",
  "%%8450": "Failure removed",
  "%%8451": "Failure added",
  "%%12288": "Security State Change",
  "%%12289": "Security System Extension",
  "%%12290": "System Integrity",
  "%%12292": "Other System Events",
  "%%12544": "Logon",
  "%%12545": "Logoff",
  "%%12548": "Special Logon",
  "%%12551": "Other Logon/Logoff Events",
  "%%12800": "File System",
  "%%12801": "Registry",
  "%%12804": "Other Object Access Events",
  "%%12807": "Handle Manipulation",
  "%%12808": "File Share",
  "%%12811": "Detailed File Share",
  "%%13056": "Sensitive Privilege Use",
  "%%13312": "Process Creation",
  "%%13313": "Process Termination",
  "%%13568": "Audit Policy Change",
  "%%13571": "MPSSVC Rule-Level Policy Change",
  "%%13824": "User Account Management",
  "%%13825": "Computer Account Management",
  "%%13826": "Security Group Management",
  "%%13827": "Distribution Group Management",
  "%%13829": "Other Account Management Events",
  "%%14080": "Directory Service Access",
  "%%14081": "Directory Service Changes",
  "%%14082": "Directory Service Replication",
  "%%14083": "Detailed Directory Service Replication",
  "%%14336": "Credential Validation",
  "%%14337": "Kerberos Service Ticket Operations",
  "%%14339": "Kerberos Authentication Service",
  // Directory service changes (4662, 5136, 5137, 5141).
  "%%14674": "Value Added",
  "%%14675": "Value Deleted",
  "%%14676": "Active Directory Domain Services",
  "%%14678": "Yes",
  "%%14679": "No",
}

// Security-Auditing EventData fields whose values Windows renders from
// `$windows_security_messages`. Fields marked `tokens` hold message tokens,
// alone or in lists, such as access rights with their reasons and GUIDs.
// Fields marked `placeholder` hold free text, such as a path or a display
// name, or a single token for a placeholder, such as "<value not set>". Only
// a value that is exactly one token renders there. All other fields, such as
// command lines, stay unchanged.
let $windows_security_message_fields = {
  // Object access and directory service events (4656, 4661, 4662, 4663,
  // 5136, 5137, 5141, 5145).
  AccessList: "tokens",
  AccessReason: "tokens",
  AccessMask: "tokens",
  Properties: "tokens",
  OperationType: "tokens",
  DSType: "tokens",
  TreeDelete: "tokens",
  // Logons (4624, 4625) and process creations (4688).
  ImpersonationLevel: "tokens",
  ElevatedToken: "tokens",
  VirtualAccount: "tokens",
  FailureReason: "tokens",
  TokenElevationType: "tokens",
  // Registry values (4657). The value data holds a placeholder for types
  // that Windows does not audit.
  OldValueType: "tokens",
  NewValueType: "tokens",
  OldValue: "placeholder",
  NewValue: "placeholder",
  // Trusts (4706) and audit policies (4719).
  SidFilteringEnabled: "tokens",
  CategoryId: "tokens",
  SubcategoryId: "tokens",
  AuditPolicyChanges: "tokens",
  // Accounts (4720, 4738, 4741, 4742).
  UserAccountControl: "tokens",
  AccountExpires: "tokens",
  PasswordLastSet: "tokens",
  LogonHours: "tokens",
  DisplayName: "placeholder",
  HomeDirectory: "placeholder",
  HomePath: "placeholder",
  ScriptPath: "placeholder",
  ProfilePath: "placeholder",
  UserWorkstations: "placeholder",
  UserParameters: "placeholder",
  // Boot Configuration Data (4826).
  AdvancedOptions: "tokens",
  ConfigAccessPolicy: "tokens",
  RemoteEventLogging: "tokens",
  KernelDebug: "tokens",
  VsmLaunchType: "tokens",
  TestSigning: "tokens",
  FlightSigning: "tokens",
  DisableIntegrityChecks: "tokens",
  HypervisorLaunchType: "tokens",
  HypervisorDebug: "tokens",
  // Cryptographic keys (5058, 5059, 5061) and credentials (5379).
  Operation: "tokens",
  KeyType: "tokens",
  ReadOperation: "tokens",
}
