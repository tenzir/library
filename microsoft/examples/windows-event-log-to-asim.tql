---
name: Windows Event Log XML → ASIM
description: Canonicalize Windows Event Log XML, map it through OCSF, and convert it to Microsoft Sentinel ASIM.
---

from_file "windows-event.xml" {
  read_all
}
microsoft::windows::ocsf::normalize data, into=ocsf
ocsf.metadata.log_format = "xml"
ocsf.raw_data = move data
ocsf.raw_data_size = ocsf.raw_data.length_bytes()
this = move ocsf
ocsf_derive
ocsf_cast
microsoft::asim::from_ocsf
