---
name: Windows Event Log XML → OCSF
description: Canonicalize Windows Event Log XML and map the event to OCSF.
---

from_file "windows-event.xml" {
  read_delimited "</Event>\n", include_separator=true
}
microsoft::windows::ocsf::normalize data, into=ocsf
ocsf.metadata.log_format = "xml"
ocsf.raw_data = move data
ocsf.raw_data_size = ocsf.raw_data.length_bytes()
this = move ocsf
ocsf_derive
ocsf_cast
