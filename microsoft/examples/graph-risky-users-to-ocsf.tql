---
name: Microsoft Graph Risky Users → OCSF
---

every 5m {
  microsoft::graph::identity_protection::risky_users \
    tenant_id="TENANT_ID",
    client_id="CLIENT_ID",
    client_secret=secret("CLIENT_SECRET")
}
microsoft::graph::ocsf::normalize
this = ocsf_derive(this)
this = ocsf_cast(this)
publish "ocsf"
