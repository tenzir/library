---
name: Microsoft Graph Directory Audits → OCSF
---

every 5m {
  microsoft::graph::directory_audits \
    tenant_id="TENANT_ID",
    client_id="CLIENT_ID",
    client_secret=secret("CLIENT_SECRET"),
    lookback=5m
}
microsoft::graph::ocsf::normalize
this = ocsf_derive(this)
this = ocsf_cast(this)
publish "ocsf"
