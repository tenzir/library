---
pre-compare: sort
---

from_file f"{env("TENZIR_INPUTS")}/graph/conditional-access.ndjson" {
  read_json
}
@name = "microsoft.graph.sign_in"
source = this
microsoft::graph::ocsf::map source, ocsf
this = {
  id: ocsf.metadata.original_event_uid,
  status_id: ocsf.status_id,
  status_code: ocsf.status_code,
  status_detail: ocsf.status_detail,
  conditional_access_decision: ocsf.authorizations[0].decision,
  conditional_access_policy_type: ocsf.authorizations[0].policy.type,
  action_id: ocsf.action_id?,
  disposition_id: ocsf.disposition_id?,
}
