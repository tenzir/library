// Stock-shaped appxdeployment-server rules must fire on the normalized fixtures that they
// describe, and on no other fixture. A skipped rule shows up as a warning.
// "AppX full trust package installed" no longer fires: AppX deployment events
// log the calling process without a process ID, so it maps to
// actor.application, which the catalog does not read (see the v0.3.0 changelog).
from_file f"{env("TENZIR_INPUTS")}/eid-*.xml" {
  read_all
}
microsoft::windows::ocsf::normalize data
sigma path=f"{env("TENZIR_INPUTS")}/sigma/appxdeployment-server.yml"
select rule=finding_info.title, event_code=evidences[0].data.metadata.event_code, record=evidences[0].data.metadata.original_event_uid
sort rule, record
