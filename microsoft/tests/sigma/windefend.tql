// Stock-shaped windefend rules must fire on the normalized fixtures that they
// describe, and on no other fixture. A skipped rule shows up as a warning.
// "Defender ASR block by process" no longer fires: Defender logs the process
// without a process ID, so "Process Name" stays in unmapped instead of an
// invalid actor.process (see the v0.3.0 changelog).
from_file f"{env("TENZIR_INPUTS")}/eid-*.xml" {
  read_all
}
microsoft::windows::ocsf::normalize data
sigma path=f"{env("TENZIR_INPUTS")}/sigma/windefend.yml"
select rule=finding_info.title, event_code=evidences[0].data.metadata.event_code, record=evidences[0].data.metadata.original_event_uid
sort rule, record
