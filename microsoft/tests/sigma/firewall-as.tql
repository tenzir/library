// Stock-shaped firewall-as rules must fire on the normalized fixtures that they
// describe, and on no other fixture. A skipped rule shows up as a warning.
// "Firewall rule added by WMI" no longer fires: Windows Firewall logs the
// modifying application without a process ID, so ModifyingApplication stays in
// unmapped instead of an invalid actor.process (see the v0.3.0 changelog).
from_file f"{env("TENZIR_INPUTS")}/eid-*.xml" {
  read_all
}
microsoft::windows::ocsf::normalize data
sigma path=f"{env("TENZIR_INPUTS")}/sigma/firewall-as.yml"
select rule=finding_info.title, event_code=evidences[0].data.metadata.event_code, record=evidences[0].data.metadata.original_event_uid
sort rule, record
