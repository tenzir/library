---
pre-compare: sort
---

from_file f"{env("TENZIR_INPUTS")}/windows-account-lifecycle-real.ndjson" {
  read_ndjson raw=true
}
microsoft::windows::ocsf::normalize
strict {
  this = ocsf_cast(ocsf_derive(this))
  assert class_uid == 3007
}
this = {
  event_code: metadata.event_code,
  class_uid: class_uid,
  activity_id: activity_id,
  user: user,
}
