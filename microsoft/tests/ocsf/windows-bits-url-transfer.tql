// BITS reports when the transfer of a job's URL starts (59), stops (60), and
// fails (61). The result is an HRESULT in decimal, where 0 means success.
from_file env("TENZIR_INPUT") {
  read_ndjson
}
microsoft::windows::ocsf::normalize data
this = ocsf_cast(this)
select event_code = metadata.event_code,
  class_uid,
  activity_id,
  activity_name,
  status_id = status_id?,
  status_code = status_code?,
  http_request,
  connection_info,
  unmapped = unmapped.EventData
