// PowerShell engine errors (4100) report an error message and the failing host,
// but no script text, so they map to Application Error rather than Script
// Activity. The record is synthetic.
from_file f"{env("TENZIR_INPUTS")}/eid-4100.xml" {
  read_all
}
microsoft::windows::ocsf::normalize data
this = ocsf_cast(ocsf_derive(this))
select class_uid, activity_id, status_id, message, actor
drop_null_fields
