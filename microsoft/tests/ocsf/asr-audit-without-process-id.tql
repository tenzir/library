// Defender attack surface reduction events name the process that attempted the
// operation by its image only, while the OCSF process object requires a PID, so
// the image stays in unmapped and no actor.process is built. The synthetic
// record has the shape that a Fluent Bit collector writes.
from_file env("TENZIR_INPUT") {
  read_ndjson
}
microsoft::windows::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
select class_uid, action_id, disposition_id, finding_info, actor?, evidences?, process_name=unmapped.EventData["Process Name"]
drop_null_fields
