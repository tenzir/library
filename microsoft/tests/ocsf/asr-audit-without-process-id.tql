// Defender attack surface reduction events name the process that attempted the
// operation by its image only, while the OCSF process object requires a PID.
// The record is from a real Fluent Bit collector.
from_file f"{env("TENZIR_INPUTS")}/windows-event-class-coverage-real.ndjson" {
  read_ndjson
}
where EventID? == 1122
microsoft::windows::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
select class_uid, action_id, disposition_id, finding_info, actor, evidences?
drop_null_fields
