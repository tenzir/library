from_file f"{env("TENZIR_INPUTS")}/eid-4739.xml" {
  read_all
}
win = data.parse_winlog()
microsoft::windows::canonicalize win, windows_event
microsoft::windows::ocsf::map windows_event, mapped
mapped.metadata.log_format = "xml"
mapped.raw_data = move data
mapped.raw_data_size = mapped.raw_data.length_bytes()
this = mapped
ocsf_cast

// Ensure deterministic tests.
drop metadata.processed_time
