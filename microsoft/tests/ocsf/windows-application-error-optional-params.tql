from_file f"{env("TENZIR_INPUTS")}/eid-1000.xml" {
  read_all
}
win = data.parse_winlog()
drop win.EventData.param1, win.EventData.param2, win.EventData.param7
drop win.EventData.param9, win.EventData.param11
microsoft::windows::ocsf::normalize win
this = ocsf_cast(this)
// Inspect retained mapping facts separately from the validated event.
details = {
  ...this,
  ...unmapped?,
}
this = {
  class_uid: class_uid,
  activity_id: activity_id,
  status_id: details.status_id?,
  process: details.process?,
}
