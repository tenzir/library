// Permission changes on token objects, which services.exe makes when it
// starts a service, name no object. They stay Entity Management with the actor
// of the change, and the entity has neither a name nor an ID, so ocsf_cast
// warns. The record is synthetic and follows the 4670 template.
from {
  data: r#"<Event xmlns="http://schemas.microsoft.com/win/2004/08/events/event"><System><Provider Name="Microsoft-Windows-Security-Auditing" Guid="{54849625-5478-4994-a5ba-3e3b0328c30d}"/><EventID>4670</EventID><Version>0</Version><Level>0</Level><Task>13570</Task><Opcode>0</Opcode><Keywords>0x8020000000000000</Keywords><TimeCreated SystemTime="2025-06-12T14:22:08.4127730Z"/><EventRecordID>482907</EventRecordID><Correlation/><Execution ProcessID="812" ThreadID="4416"/><Channel>Security</Channel><Computer>WS01.example.test</Computer><Security/></System><EventData><Data Name="SubjectUserSid">S-1-5-18</Data><Data Name="SubjectUserName">WS01$</Data><Data Name="SubjectDomainName">EXAMPLE</Data><Data Name="SubjectLogonId">0x3e7</Data><Data Name="ObjectServer">Security</Data><Data Name="ObjectType">Token</Data><Data Name="ObjectName">-</Data><Data Name="HandleId">0x1b8c</Data><Data Name="OldSd">D:(A;;GA;;;SY)(A;;GA;;;S-1-5-80-1111111111-2222222222-3333333333-4444444444-5555555555)</Data><Data Name="NewSd">D:(A;;GA;;;SY)(A;;GA;;;S-1-5-80-1111111111-2222222222-3333333333-4444444444-5555555555)(A;;GXGR;;;S-1-5-80-1111111111-2222222222-3333333333-4444444444-5555555555)</Data><Data Name="ProcessId">0x2e4</Data><Data Name="ProcessName">C:\Windows\System32\services.exe</Data></EventData></Event>"#,
}
microsoft::windows::ocsf::normalize data
this = ocsf_cast(this)
drop metadata.processed_time
