from_file f"{env("TENZIR_INPUTS")}/eid-4624.xml" {
  read_all
}
this = {
  System: data,
  Message: "An account was successfully logged on.",
}
microsoft::windows::canonicalize this, windows
this = {
  provider: windows.System.Provider.Name,
  event_id: windows.System.EventID,
  target_user: windows.EventData.TargetUserName,
  message: windows.RenderingInfo.Message,
  collector: windows.Logger.log_provider,
}
