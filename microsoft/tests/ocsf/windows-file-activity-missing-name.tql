from_file f"{env("TENZIR_INPUTS")}/eid-4663.xml" {
  read_all
}
windows = data.parse_winlog()
windows.EventData.ObjectName = null
microsoft::windows::ocsf::normalize windows, into=ocsf
ocsf = ocsf_cast(ocsf_derive(ocsf))
assert ocsf.class_uid == 0
assert ocsf.unmapped.incomplete_activity.class_uid == 1001
assert ocsf.unmapped.incomplete_activity.actor != null
assert ocsf.unmapped.file.type_id == 0
this = {
  class_uid: ocsf.class_uid,
  candidate_class_uid: ocsf.unmapped.incomplete_activity.class_uid,
  retained_file: ocsf.unmapped.file,
}
