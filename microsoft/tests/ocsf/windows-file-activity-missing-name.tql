from_file f"{env("TENZIR_INPUTS")}/eid-4663.xml" { read_all }
windows = data.parse_winlog()
windows.EventData.ObjectName = null
windows.EventData.ProcessId = null
microsoft::windows::ocsf::normalize windows, into=ocsf
ocsf = ocsf_cast(ocsf_derive(ocsf))
assert ocsf.class_uid == 1001
assert ocsf.file? == null
assert ocsf.actor.user.uid != null
assert ocsf.actor.session.uid_alt != null
assert ocsf.unmapped.EventData.ProcessName == windows.EventData.ProcessName
this = {class_uid: ocsf.class_uid, actor: ocsf.actor, original_process_name: ocsf.unmapped.EventData.ProcessName}
