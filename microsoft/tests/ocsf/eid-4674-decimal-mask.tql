// Some 4674 records log the access mask in decimal, here 16777216
// (ACCESS_SYSTEM_SECURITY) for SeSecurityPrivilege, which must not be read as
// hex. Input: synthetic Security 4674 record following the
// Microsoft-Windows-Security-Auditing 4674 template.
from_file f"{env("TENZIR_INPUTS")}/eid-4674-decimal-mask.xml" {
  read_all
}
microsoft::windows::ocsf::normalize data
this = ocsf_cast(this)
select class_uid, entity.name, access_mask
