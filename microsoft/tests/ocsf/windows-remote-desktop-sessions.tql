// Remote Desktop Services report the authentication of a client (1149), the
// session logon (21) and logoff (23), and session disconnects (24) and
// reconnects (25). A console session logs on from `LOCAL`.
from_file env("TENZIR_INPUT") {
  read_ndjson
}
microsoft::windows::ocsf::normalize data
this = ocsf_cast(this)
select event_code = metadata.event_code,
  class_uid,
  activity_id,
  status_id,
  message,
  user,
  is_remote = is_remote?,
  src_endpoint = src_endpoint?,
  dst_endpoint,
  connection_info = connection_info?,
  unmapped = unmapped.UserData?
