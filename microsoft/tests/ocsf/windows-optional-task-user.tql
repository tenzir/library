from_file f"{env("TENZIR_INPUTS")}/eid-0140.xml" {
  read_all
}
win = data.parse_winlog()
drop win.EventData.UserContext
microsoft::windows::ocsf::normalize win
this = ocsf_cast(this)
// Inspect retained mapping facts separately from the validated event.
details = {
  ...this,
  ...unmapped?,
}
this = {
  class_uid: class_uid,
  activity_id: activity_id,
  actor: actor?,
  job: details.job?,
}
