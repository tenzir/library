from_file f"{env("TENZIR_INPUTS")}/eid-4648.xml" {
  read_all
}
win = data.parse_winlog()
drop win.EventData.TargetDomainName
drop win.EventData.ProcessName
microsoft::windows::canonicalize win, windows_event
microsoft::windows::ocsf::map windows_event, this
this = {
  class_uid: class_uid,
  user: user,
}
