// BITS transfer job parameters (16403) without the process path have no
// process file, instead of a file without a name.
from_file f"{env("TENZIR_INPUTS")}/eid-16403.xml" {
  read_all
}
windows = data.parse_winlog()
drop windows.EventData.processPath
microsoft::windows::ocsf::normalize windows, into=ocsf
this = ocsf_cast(ocsf)
select actor
