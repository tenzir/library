from_file f"{env("TENZIR_INPUTS")}/eid-4100.xml" {
  read_all
}
win = data.parse_winlog()
drop win.EventData.ErrorCode, win.EventData.Message, win.EventData.HostApplication
drop win.EventData.User, win.EventData.CommandInvocation
drop win.EventData.HostName, win.EventData.ConnectedUser
microsoft::windows::ocsf::normalize win
this = {
  class_uid: class_uid,
  status_id: status_id,
  actor: actor?,
  script: script,
}
