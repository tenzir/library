from_file f"{env("TENZIR_INPUTS")}/eid-0102.xml" {
  read_all
}
win = data.parse_winlog()
win.EventData.ResultCode = "0"
microsoft::windows::ocsf::normalize win
this = ocsf_cast(this)
// Inspect retained mapping facts separately from the validated event.
details = {
  ...this,
  ...ocsf_derive(unmapped.incomplete_activity?),
  ...unmapped.ocsf_residue?,
}
this = {
  class_uid: class_uid,
  status_id: details.status_id?,
  status_code: details.status_code?,
}
