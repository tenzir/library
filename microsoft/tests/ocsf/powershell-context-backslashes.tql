// PowerShell writes Windows paths and accounts into ContextInfo without
// escaping, so `\t` and `\n` in `C:\temp\tools\new-report.ps1` and
// `EXAMPLE\nora` stay backslashes. The record is synthetic.
from_file env("TENZIR_INPUT") {
  read_all
}
microsoft::windows::ocsf::normalize data
this = ocsf_cast(this)
select actor.process.cmd_line, actor.user
