// Trusted logon process registrations (4611) name the process that LSA
// registered, but not how it was loaded, while the OCSF module object needs a
// load type or function name. The record is from the demo dataset.
from_file f"{env("TENZIR_INPUTS")}/demo-4611-trusted-logon-process.xml" {
  read_all
}
microsoft::windows::ocsf::normalize data
this = ocsf_cast(ocsf_derive(this))
select class_uid, module, actor
drop_null_fields
