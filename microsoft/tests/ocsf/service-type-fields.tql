// Combined Windows flags must not be mistaken for a basic OCSF service type.
from_file f"{env("TENZIR_INPUTS")}/eid-4697.xml" { read_all }
win = data.parse_winlog()
win.EventData.ServiceType = "0x110"
win.EventData.ServiceStartType = 4
microsoft::windows::ocsf::normalize win
ocsf_cast
select win_service.service_start_type_id, win_service.service_type_id,
  win_service.service_type, unmapped.EventData.ServiceType?
