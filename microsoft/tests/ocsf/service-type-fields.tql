// Combined Windows flags must not be mistaken for a basic OCSF service type.
from_file f"{env("TENZIR_INPUTS")}/eid-4697.xml" { read_all }
win = data.parse_winlog()
service_types = [
  {type: "0x110", start: 4},
  {type: "0x10", start: 2},
  {type: "0x10", start: 9},
  {type: null, start: null},
]
unroll service_types
win.EventData.ServiceType = move service_types.type
win.EventData.ServiceStartType = move service_types.start
drop service_types
microsoft::windows::ocsf::normalize win
ocsf_cast
select win_service.service_start_type_id, win_service.service_start_type,
  win_service.service_type_id, win_service.service_type,
  unmapped.EventData.ServiceStartType?, unmapped.EventData.ServiceType?
