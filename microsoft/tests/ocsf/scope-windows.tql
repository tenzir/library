from_file f"{env("TENZIR_INPUTS")}/eid-9999.xml" {
  read_all
}
payload = data.parse_winlog()
windows = "outer-windows"
ocsf = "outer-ocsf"
microsoft::windows::canonicalize payload, windows_event
microsoft::windows::ocsf::map windows_event, mapped
mapped.metadata.log_format = "xml"
assert windows == "outer-windows"
assert ocsf == "outer-ocsf"
this = move mapped
drop metadata.processed_time
