// Service Control Manager writes service states and types in the language of
// the system. German events map like English ones, and the state code in the
// binary data decides over the state text.
from_file env("TENZIR_INPUT") {
  read_ndjson
}
microsoft::windows::ocsf::normalize data, into=ocsf
this = {case: case, ocsf: ocsf_cast(ocsf)}
select case,
  activity = ocsf.activity_name?,
  start_type_id = ocsf.win_service?.service_start_type_id?,
  previous_start_type_id = ocsf.prev_win_service?.service_start_type_id?,
  service_category_id = ocsf.win_service?.service_category_id?
