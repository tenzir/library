from_file f"{env("TENZIR_INPUTS")}/eid-4625.xml" {
  read_all
}
win = data.parse_winlog()
win.EventData.AuthenticationPackageName = "Negotiate"
microsoft::windows::canonicalize win, windows_event
microsoft::windows::ocsf::map windows_event, this
ocsf_derive
ocsf_cast
this = {
  auth_protocol: auth_protocol?,
  auth_protocol_id: auth_protocol_id?,
}
