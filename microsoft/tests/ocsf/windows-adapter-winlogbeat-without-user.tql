from_file f"{env("TENZIR_INPUTS")}/sysmon/01-ProcessCreate.winlogbeat.json" {
  read_ndjson
}
drop winlog.user
drop winlog.process.thread
microsoft::windows::canonicalize this, windows
this = {
  provider: windows.System.Provider.Name,
  user_id: windows.System.Security.UserID?,
  collector: windows.Logger.log_provider,
}
