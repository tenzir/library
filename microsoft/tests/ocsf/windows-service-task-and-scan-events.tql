// A service that fails to start (7000), a task action that fails to launch
// (203), and Microsoft Defender Antivirus scans that start (1000), complete
// (1001), and get cancelled (1002).
from_file env("TENZIR_INPUT") {
  read_ndjson
}
microsoft::windows::ocsf::normalize data
this = ocsf_cast(this)
select event_code = metadata.event_code,
  class_uid,
  activity_id,
  status_id = status_id?,
  status_code = status_code?,
  status_detail = status_detail?,
  application = application?,
  job = job?,
  scan = scan?,
  actor = actor?,
  product_version = metadata.product.version?,
  unmapped = unmapped.EventData
