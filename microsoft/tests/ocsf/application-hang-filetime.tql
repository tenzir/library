// FILETIME is measured from 1601, not the Unix epoch.
from_file f"{env("TENZIR_INPUTS")}/eid-1002.xml" { read_all }
win = data.parse_winlog()
start_times = ["01db5be019ba4000", null]
unroll start_times
win.EventData.param5 = move start_times
microsoft::windows::ocsf::normalize win
ocsf_cast
select process.created_time, unmapped.EventData.param5?
