// Windows Filtering Platform connection decisions map to Network Activity: a
// permitted inbound connection (5156) and a blocked outbound one (5157).
// Windows names the local address as the source, also for inbound
// connections, so the remote peer becomes the source endpoint.
from_file env("TENZIR_INPUT") {
  read_ndjson
}
microsoft::windows::ocsf::normalize data
this = ocsf_cast(this)
drop metadata.processed_time
