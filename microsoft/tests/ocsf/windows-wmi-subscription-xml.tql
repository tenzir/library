from_file f"{env("TENZIR_INPUTS")}/windows-event-class-coverage-real.ndjson" {
  read_ndjson
}
where winlog?.provider_name? == "Microsoft-Windows-WMI-Activity" and winlog?.event_id?.int() == 5861
raw = event.original
microsoft::windows::ocsf::normalize raw
this = {
  class_uid: class_uid,
  activity_id: activity_id,
  entity_type: entity.type,
  entity_name: entity.name,
}
