// Without a name or path there is no file to attach the version to; it must
// remain in unmapped instead of being dropped.
from_file f"{env("TENZIR_INPUTS")}/eid-1000.xml" {
  read_all
}
win = data.parse_winlog()
drop win.EventData.param1, win.EventData.param11
microsoft::windows::ocsf::normalize win
this = {
  class_uid: class_uid,
  process: process,
  unmapped_version: unmapped.EventData.param2,
}
