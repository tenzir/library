// Input: synthetic Code Integrity 3076 record. Its fields follow the version 5
// template of the Microsoft-Windows-CodeIntegrity manifest (Windows 11 24H2);
// all values are invented.
from_file f"{env("TENZIR_INPUTS")}/eid-3076.xml" {
  read_all
}
microsoft::windows::ocsf::normalize data
metadata.log_format = "xml"
this = ocsf_cast(this)

// Ensure deterministic tests.
drop metadata.processed_time
