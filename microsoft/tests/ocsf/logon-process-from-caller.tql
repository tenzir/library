// Logons name the trusted logon process under which the calling process
// registered with the LSA, so the logon process carries the caller's PID and
// image. The record is from the demo dataset.
from_file f"{env("TENZIR_INPUTS")}/demo-4624-logon.xml" {
  read_all
}
microsoft::windows::ocsf::normalize data
this = ocsf_cast(ocsf_derive(this))
select logon_process, logon_type_id, auth_protocol_id, auth_protocol
