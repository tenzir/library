// PowerShell engine errors (4100) report the failing host and command, but not
// the script text, which the script object requires. The record is from the
// demo dataset.
from_file f"{env("TENZIR_INPUTS")}/eid-4100.xml" {
  read_all
}
microsoft::windows::ocsf::normalize data
this = ocsf_cast(ocsf_derive(this))
select class_uid, status_id, status_detail, script, actor
drop_null_fields
