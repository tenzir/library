from_file f"{env("TENZIR_INPUTS")}/windows-event-class-coverage-real.ndjson" {
  read_ndjson
}
where winlog?.provider_name? == "Microsoft-Windows-WMI-Activity" and winlog?.event_id?.int() == 5861
microsoft::windows::canonicalize this, windows
this = {
  user_data_name: windows.UserData?.Operation_ESStoConsumerBinding?.ESS?,
  user_data_namespace: windows.UserData?.Operation_ESStoConsumerBinding?.Namespace?,
}
