from_file f"{env("TENZIR_INPUTS")}/eid-1116.xml" {
  read_all
}
win = data.parse_winlog()
drop win.EventData.Unused, win.EventData.Unused2, win.EventData.Unused3
drop win.EventData["Status Description"], win.EventData["Remediation User"]
microsoft::windows::ocsf::normalize win
this = {
  class_uid: class_uid,
  activity_id: activity_id,
}
