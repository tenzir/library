// Input: synthetic Windows Error Reporting 1001 record for a hung service
// (ServiceHang), not an application crash, following the structure that
// Windows Server 2022 writes.
from_file f"{env("TENZIR_INPUTS")}/eid-1001-service-hang.xml" {
  read_all
}
microsoft::windows::ocsf::normalize data
metadata.log_format = "xml"
this = ocsf_cast(this)

// Ensure deterministic tests.
drop metadata.processed_time
