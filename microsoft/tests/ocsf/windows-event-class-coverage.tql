---
pre-compare: sort
---

from_file env("TENZIR_INPUT") {
  read_ndjson
}
microsoft::windows::ocsf::normalize
this = ocsf_cast(this)
assert class_uid == (
  1006 if metadata.product.name == "Microsoft-Windows-TaskScheduler" else 3004
)
this = {
  provider: metadata.product.name,
  event_code: metadata.event_code,
  class_uid: class_uid,
  activity_id: activity_id,
  activity_name: activity_name?,
  job_name: job?.name?,
  entity_type: entity?.type?,
  entity_name: entity?.name?,
}
drop_null_fields
