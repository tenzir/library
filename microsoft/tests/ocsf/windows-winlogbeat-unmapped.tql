from_file f"{env("TENZIR_INPUTS")}/sysmon/01-ProcessCreate.winlogbeat.json" {
  read_ndjson
}
message = "rendered message"
event.original = "<Event>original XML</Event>"
microsoft::windows::ocsf::normalize
this = {
  message: message?,
  raw_data_is_xml: raw_data?.starts_with("<Event"),
  duplicated_host: unmapped.Winlogbeat.host?.name?,
  duplicated_event: unmapped.Winlogbeat.event?,
  duplicated_metadata: unmapped.Winlogbeat["@metadata"]?,
  collector_details: unmapped.Winlogbeat?,
}
