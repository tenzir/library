// An AppX deployment that one hosted service requested names that service as
// the actor application. Input: synthetic AppXDeployment-Server 400 record
// following the Microsoft-Windows-AppXDeployment-Server event 400 template.
from_file f"{env("TENZIR_INPUTS")}/eid-0400-appx-service.xml" {
  read_all
}
microsoft::windows::ocsf::normalize data
this = ocsf_cast(this)
select class_uid, actor, application.name, unmapped.EventData.CallingProcess
