// When no script source field is present at all, script_content stays absent
// instead of materializing a null value.
from_file f"{env("TENZIR_INPUTS")}/eid-4100.xml" {
  read_all
}
win = data.parse_winlog()
drop win.EventData.CommandLine, win.EventData.CommandInvocation
drop win.EventData.ContextInfo?, win.EventData.Payload?
microsoft::windows::ocsf::normalize win
this = {
  class_uid: class_uid,
  script: script,
}
