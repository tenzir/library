// Input: synthetic Application Error 1000 record with named event data,
// following the Application Error 1000 template.
// Windows 10 and later name the event data of Application Error 1000.
from_file f"{env("TENZIR_INPUTS")}/eid-1000-named.xml" {
  read_all
}
microsoft::windows::ocsf::normalize data
this = ocsf_cast(this)
this = {
  status_code: status_code?,
  actor: actor,
  process: process,
  module: module,
}
