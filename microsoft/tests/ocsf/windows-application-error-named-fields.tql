from_file f"{env("TENZIR_INPUTS")}/eid-1000.xml" {
  read_all
}
win = data.parse_winlog()
win.EventData.AppName = move win.EventData.param1
win.EventData.AppVersion = move win.EventData.param2
win.EventData.ExceptionCode = move win.EventData.param7
win.EventData.ProcessId = move win.EventData.param9
win.EventData.AppPath = move win.EventData.param11
microsoft::windows::ocsf::normalize win
ocsf_cast
this = {
  status_code: status_code?,
  process: process,
}
