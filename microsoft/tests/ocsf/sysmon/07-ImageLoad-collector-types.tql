from_file f"{env("TENZIR_INPUTS")}/sysmon/07-ImageLoad.xml" {
  read_all
}
win = data.parse_winlog()
win.EventData.FileVersion = 5.1.1.0
microsoft::windows::canonicalize win, windows_event
microsoft::windows::ocsf::map windows_event, this
ocsf_cast
this = {
  class_uid: class_uid,
  version: module.file.version,
}
