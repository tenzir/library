from_file f"{env("TENZIR_INPUTS")}/sysmon/22-DnsQuery-real-collector.ndjson" {
  read_ndjson raw=true
}
microsoft::windows::ocsf::normalize
strict {
  this = ocsf_cast(ocsf_derive(this))
}
this = {
  event_code: metadata.event_code,
  class_uid: class_uid,
  activity_id: activity_id,
  query: query,
  src_endpoint: src_endpoint?,
  dst_endpoint: dst_endpoint?,
}
