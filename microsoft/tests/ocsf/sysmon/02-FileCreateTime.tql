from_file f"{env("TENZIR_INPUTS")}/sysmon/02-FileCreateTime.xml" {
  read_all
}
win = data.parse_winlog()
microsoft::windows::canonicalize win, windows_event
microsoft::windows::ocsf::map windows_event, ocsf
ocsf.metadata.log_format = "xml"
ocsf.raw_data = move data
ocsf.raw_data_size = ocsf.raw_data.length_bytes()
this = ocsf
ocsf_cast

// Ensure deterministic tests.
drop metadata.processed_time
