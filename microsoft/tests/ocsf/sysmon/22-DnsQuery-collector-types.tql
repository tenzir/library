from_file f"{env("TENZIR_INPUTS")}/sysmon/22-DnsQuery.xml" {
  read_all
}
win = data.parse_winlog()
win.EventData.QueryStatus = "0"
drop win.EventData.Initiated
microsoft::windows::canonicalize win, windows_event
microsoft::windows::ocsf::map windows_event, this
this = {
  status_id: status_id,
  status_code: status_code,
  query: query,
}
