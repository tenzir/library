from_file f"{env("TENZIR_INPUTS")}/sysmon/01-ProcessCreate.xml" {
  read_all
}
microsoft::windows::ocsf::normalize data, into=ocsf
ocsf.metadata.log_format = "xml"
ocsf.raw_data = move data
ocsf.raw_data_size = ocsf.raw_data.length_bytes()
this = move ocsf
ocsf_cast

// Ensure deterministic tests.
drop metadata.processed_time
