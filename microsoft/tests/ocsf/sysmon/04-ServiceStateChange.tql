// Input: synthetic Sysmon 4 record (service state Started), following the
// Microsoft-Windows-Sysmon event 4 template.
from_file f"{env("TENZIR_INPUTS")}/sysmon/04-ServiceStateChange.xml" {
  read_all
}
microsoft::windows::ocsf::normalize data
metadata.log_format = "xml"
this = ocsf_cast(this)

// Ensure deterministic tests.
drop metadata.processed_time
