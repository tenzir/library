// NXLog Community Edition writes Sysmon's event data next to its own fields and
// overwrites `ProcessId` with its `ProcessID`, the process ID of the Sysmon
// service. The adapter recovers the process ID from the message, decodes the
// XML escaping of the command line, and reads the integer `EventTime` that
// `Exec $EventTime = integer($EventTime);` writes. The synthetic record has the
// shape that NXLog CE 3.1 writes with `to_json()`; all values are invented.
from_file f"{env("TENZIR_INPUTS")}/sysmon/01-ProcessCreate.nxlog.json" {
  read_ndjson unflatten_separator="."
}
microsoft::windows::ocsf::normalize
metadata.log_format = "json"
this = ocsf_cast(this)

// Ensure deterministic tests.
drop metadata.processed_time
