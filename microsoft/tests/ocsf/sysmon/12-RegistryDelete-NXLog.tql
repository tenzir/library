---
pre-compare: sort
---

from_file f"{env("TENZIR_INPUTS")}/sysmon/12-RegistryDelete.nxlog.json" {
  read_ndjson unflatten_separator="."
}
microsoft::windows::canonicalize this, windows_event
microsoft::windows::ocsf::map windows_event, ocsf
ocsf.metadata.log_format = "json"
this = move ocsf
ocsf_cast

// Ensure deterministic tests.
drop metadata.processed_time
