from_file f"{env("TENZIR_INPUTS")}/eid-4720.xml" {
  read_all
}
windows = data.parse_winlog()
cases = [
  {name: "provided", display: "Alice Example", upn: "alice@example.test"},
  {name: "resource tokens", display: "%%1793", upn: "%%1794"},
  {name: "dash", display: "-", upn: "-"},
  {name: "absent", display: null, upn: null},
]
unroll cases
windows.EventData.DisplayName = cases.display
windows.EventData.UserPrincipalName = cases.upn
microsoft::windows::ocsf::normalize windows, into=ocsf
strict {
  ocsf = ocsf_cast(ocsf_derive(ocsf))
  assert ocsf.class_uid == 3007
  assert ocsf.user.display_name? == (cases.display if cases.name == "provided" else null)
  assert ocsf.user.uid_alt? == (cases.upn if cases.name == "provided" else null)
}
this = {case: cases.name, display_name: ocsf.user.display_name?, uid_alt: ocsf.user.uid_alt?}
sort case
