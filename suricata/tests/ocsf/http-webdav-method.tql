// WebDAV methods have their own HTTP activities.
from {
  timestamp: 2026-01-01,
  event_type: "http",
  src_ip: 192.0.2.1,
  src_port: 50000,
  dest_ip: 192.0.2.80,
  dest_port: 80,
  proto: "TCP",
  http: {hostname: "dav.example.test", url: "/share/?depth=1", http_method: "PROPFIND", protocol: "HTTP/1.1", status: 207, length: 512},
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select activity_id, type_uid, http_request, http_response, status_id
