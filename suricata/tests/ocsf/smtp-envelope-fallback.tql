// Without header addresses, `from` and `to` take the SMTP envelope, which
// `return_path` and `delivered_to_list` always hold. The empty mailbox fields
// tell that the addresses came from the envelope. The records are from a
// spam bot in the M57 capture, whose envelopes the servers rejected before
// any message data. Suricata logs no reply codes, so the status stays unset.
from_file env("TENZIR_INPUT") {
  read_suricata
}
suricata::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
select class_name, activity_name, email, command
