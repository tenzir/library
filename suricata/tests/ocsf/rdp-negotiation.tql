---
pre-compare: sort
---

// RDP negotiations put the client into the source endpoint, and failed
// negotiations report the reason.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select activity_id?, src_endpoint?, dst_endpoint?, identifier_cookie?, capabilities?, status_id?, status_code?, status_detail?, unmapped
