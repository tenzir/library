// X-Forwarded-For lists addresses in header order. Clients control the header,
// so entries can be no addresses; the others still map, and the request
// headers keep the raw header. Both headers extend a real Cloudflare request.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {events: [
  {...this, http: {...http, xff: "203.0.113.7, 2001:db8::7, 137.135.117.126"}},
  {...this, http: {...http, xff: "unknown, 137.135.117.126"}},
]}
unroll events
this = events
suricata::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
select src_endpoint, http_request.http_headers, unmapped
drop_null_fields
