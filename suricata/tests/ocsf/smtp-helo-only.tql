---
pre-compare: sort
---
// Data: M57-Patents (Digital Corpora, CC0). See tests/THIRD-PARTY.md.

from_file f"{env("TENZIR_INPUTS")}/smtp.json" {
  read_json
}
where (flow_id == 1511159445305794) or (flow_id == 1525325020429842 and pcap_cnt? == 163088)
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
