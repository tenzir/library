// FTP data connections describe the transfer of the command that opened them.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select class_uid?, activity_id?, command?, file?, unmapped
