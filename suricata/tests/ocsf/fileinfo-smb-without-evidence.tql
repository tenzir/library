// Constructed from the synthetic read record of `fileinfo-smb-read` without its command and with non-SMB ports: without evidence, the event names no endpoints and keeps the observed addresses.
from_file env("TENZIR_INPUT") {
  read_suricata
}
suricata::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
drop_null_fields
