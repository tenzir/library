// Suricata logs 0.0.0.0 as the assigned address of client requests.
from {
  timestamp: 2026-01-01,
  event_type: "dhcp",
  src_ip: 192.0.2.10,
  src_port: 68,
  dest_ip: 192.0.2.1,
  dest_port: 67,
  proto: "UDP",
  dhcp: {type: "request", id: 42, client_mac: "00:11:22:33:44:55", assigned_ip: 0.0.0.0, dhcp_type: "request", hostname: "laptop"},
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select activity_id, src_endpoint, dst_endpoint, status_id, unmapped.dhcp
