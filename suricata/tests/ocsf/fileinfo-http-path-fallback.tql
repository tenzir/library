// A 404 response from M57 without Content-Disposition: Suricata names the file after the URL path, so the event has no `file` and the size becomes the response body length.
from_file env("TENZIR_INPUT") {
  read_suricata
}
suricata::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
drop_null_fields
