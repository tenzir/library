---
pre-compare: sort
---
// Data: M57-Patents (Digital Corpora, CC0). See tests/THIRD-PARTY.md.

from_file f"{env("TENZIR_INPUTS")}/ftp.json" {
  read_json
}
where (flow_id == 529228958590706 and pcap_cnt? == 291955) or (flow_id == 609499111788045 and pcap_cnt? == 302422)
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
