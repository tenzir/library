// Data: M57-Patents (Digital Corpora, CC0). See tests/THIRD-PARTY.md.
// Constructed from the M57 SSLv3 record with the version SSLv2: an SSLv2 record with a certificate keeps its TLS object.
from_file env("TENZIR_INPUT") {
  read_suricata
}
suricata::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
drop_null_fields
