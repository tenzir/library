// EVE version 2 logs the question at the top level and no flags for queries.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select activity_id, query, answers?, authority?, rcode_id?, rcode?, status_id, flag_ids, unmapped.dns
drop_null_fields
