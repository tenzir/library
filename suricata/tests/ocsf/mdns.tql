---
pre-compare: sort
---

// mDNS messages are DNS Activity. Multicast responses keep the packet
// direction.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select activity_id?, src_endpoint?, dst_endpoint?, query?, answers?, flag_ids?, rcode_id?, status_id?, app_protocol_name?, unmapped
