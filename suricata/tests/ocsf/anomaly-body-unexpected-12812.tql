---
pre-compare: sort
---
// Data: M57-Patents (Digital Corpora, CC0). See tests/THIRD-PARTY.md.

from_file f"{env("TENZIR_INPUTS")}/anomaly.json" {
  read_json
}
where (flow_id == 1012391214701654 and pcap_cnt? == 12812)
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
