---
pre-compare: sort
---
// Data: M57-Patents (Digital Corpora, CC0). See tests/THIRD-PARTY.md.

from_file f"{env("TENZIR_INPUTS")}/dhcp.json" {
  read_json
}
where (flow_id == 1380462580961036 and pcap_cnt? == 92) or (flow_id == 659509370654476 and pcap_cnt? == 314)
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
