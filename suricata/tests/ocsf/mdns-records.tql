---
pre-compare: sort
---

// mDNS questions, answers, and authorities map like those of DNS. Further
// questions and records of other types keep their original keys.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select activity_id?, src_endpoint?, query?, answers?, authority?, unmapped
