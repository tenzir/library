---
pre-compare: sort
---
// Data: M57-Patents (Digital Corpora, CC0). See tests/THIRD-PARTY.md.

from_file f"{env("TENZIR_INPUTS")}/smb.json" {
  read_json
}
where (flow_id == 1115448875602208 and pcap_cnt? == 408261) or (flow_id == 2147090323359516 and pcap_cnt? == 432811)
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
