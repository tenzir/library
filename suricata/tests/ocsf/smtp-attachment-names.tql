// Attachment names in SMTP and file events. The records are synthetic: an
// encoded name `=?UTF-8?B?c2l0ZS1zdXJ2ZXktMDYxOS5wZGY=?=` that decodes to
// `site-survey-0619.pdf`, a plain name, a lowercase charset and encoding that
// decode as well, and a Q-encoded name, an ISO-8859-1 name, and a name of two
// encoded words that stay as logged.
from_file env("TENZIR_INPUT") {
  read_suricata
}
suricata::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
select metadata.log_name, class_uid, email.files, unmapped.email?, unmapped.fileinfo?
drop_null_fields
