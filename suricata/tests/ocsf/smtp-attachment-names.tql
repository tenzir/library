// Attachment names in SMTP and file events. The first four input records are M57
// records: an encoded name `=?UTF-8?B?NjY3ODcxOTY4NDQuemlw?=` that decodes to
// `66787196844.zip`, and a plain name. The last four are constructed from the
// first SMTP record with other names: a lowercase charset and encoding that
// decode as well, and a Q-encoded name, an ISO-8859-1 name, and a name of two
// encoded words that stay as logged.
from_file env("TENZIR_INPUT") {
  read_suricata
}
suricata::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
select metadata.log_name, class_uid, email.files, unmapped.email?, unmapped.fileinfo?
drop_null_fields
