// Keep the application transaction counter separate from the DNS header ID.
from {
  timestamp: 2025-01-01,
  event_type: "dns",
  src_ip: 192.0.2.1,
  dest_ip: 192.0.2.53,
  proto: "UDP",
  dns: {
    type: "response",
    version: 3,
    id: 42,
    tx_id: 9,
    opcode: 0,
    flags: "85b0",
    qr: true,
    rd: true,
    ra: true,
    queries: [{
      rrname: "example.test",
      rrtype: "A",
    }],
    answers: [{
      rrname: "example.test",
      rrtype: "A",
      ttl: 60,
      rdata: "192.0.2.10",
    }],
    authorities: [{
      rrname: "example.test",
      rrtype: "NS",
      ttl: 60,
      rdata: "ns.example.test",
    }],
    additionals: [{
      rrname: "ns.example.test",
      rrtype: "A",
      ttl: 60,
      rdata: "192.0.2.53",
    }],
    rcode: "NOERROR",
  },
}
source = this
suricata::ocsf::map source, ocsf
this = ocsf
ocsf_cast
select activity_id, transaction_id, flag_ids, answers, authority,
  response_additional, unmapped
