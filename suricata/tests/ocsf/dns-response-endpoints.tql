// Suricata logs a response in packet direction, from the server. DNS
// Activity puts the client into `src_endpoint`.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select activity_id, src_endpoint, dst_endpoint, rcode_id, status_id
