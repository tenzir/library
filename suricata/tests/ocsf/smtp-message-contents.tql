// Header mailboxes, attachments, and URLs; HEADER_READY messages lack header addresses and map to Network Activity.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select class_uid, activity_id, email?, status_id, unmapped.email?
drop_null_fields
