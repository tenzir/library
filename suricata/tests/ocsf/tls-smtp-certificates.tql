---
pre-compare: sort
---

from_file f"{env("TENZIR_INPUTS")}/tls.json" {
  read_json
}
where (flow_id == 1511159445305794 and pcap_cnt? == 12410) or (flow_id == 1871427006364475 and pcap_cnt? == 23568)
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf
this = ocsf_cast(this)
