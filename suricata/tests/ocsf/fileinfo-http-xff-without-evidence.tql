// Without endpoint evidence, the client side is unknown, so X-Forwarded-For
// maps no intermediate IPs. The header still joins the request headers. The
// header extends a synthetic file event.
from_file env("TENZIR_INPUT") {
  read_suricata
}
http.xff = "203.0.113.7"
xff = 203.0.113.7
suricata::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
select src_endpoint?, dst_endpoint?, http_request.http_headers, unmapped
drop_null_fields
