---
pre-compare: sort
---

// TCP flags and states tell how a connection went.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select src_endpoint.port?, activity_id?, status_detail?, flags_ts=unmapped.tcp?.tcp_flags_ts?, flags_tc=unmapped.tcp?.tcp_flags_tc?, tcp_state=unmapped.tcp?.state?
