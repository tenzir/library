// EVE version 3 logs the response code of the empty header bits in requests.
// A request has no response code.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select activity_id, rcode_id?, rcode?, status_id, unmapped.dns
