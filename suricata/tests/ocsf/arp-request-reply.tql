---
pre-compare: sort
---

// ARP requests do not know the hardware address of their target.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select activity_id?, initiator_id?, src_endpoint?, dst_endpoint?, unmapped
