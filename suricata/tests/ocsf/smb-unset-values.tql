// Suricata logs empty strings and zero IDs for values that a session, tree, or
// file does not have yet. Without a share, the path stays relative.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select command, connection_info.session?, tree_uid?, share?, file?, unmapped.smb?
drop_null_fields
