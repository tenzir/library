---
pre-compare: sort
---
// Data: M57-Patents (Digital Corpora, CC0). See tests/THIRD-PARTY.md.

from_file f"{env("TENZIR_INPUTS")}/dns.json" {
  read_json
}
where (flow_id == 100880175067878 and pcap_cnt? == 168)
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
