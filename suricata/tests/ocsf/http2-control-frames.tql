---
pre-compare: sort
---

// HTTP/2 control frames are network traffic. HPACK table size updates are no
// headers.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select class_uid?, activity_id?, app_protocol_name?, http_request?, http_response?, unmapped
