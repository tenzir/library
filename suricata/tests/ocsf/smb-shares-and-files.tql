// Shares, named pipes, files, folders, NTLMSSP accounts, and NT status outcomes.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select command, actor?, src_endpoint, dst_endpoint, share?, share_type_id?, open_type?, file?, status_code?, status_detail?, status_id, unmapped.smb
drop_null_fields
