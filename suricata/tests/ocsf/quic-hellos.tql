---
pre-compare: sort
---

// QUIC hellos identify the client or server that sent them.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select activity_id?, initiator_id?, app_protocol_name?, src_endpoint?, dst_endpoint?, ja4_fingerprint_list?, unmapped
