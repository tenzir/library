// Requests have no outcome yet; TCP transactions can arrive in reply direction.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select class_uid, activity_id, src_endpoint, dst_endpoint, user?, service?, status_code?, status_id, severity_id, unmapped.krb5
drop_null_fields
