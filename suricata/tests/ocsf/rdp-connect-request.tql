---
pre-compare: sort
---

// Connect requests describe the client and its display.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select activity_id?, src_endpoint?, protocol_ver?, device?, keyboard_info?, remote_display?, capabilities?, unmapped
