// A missing client principal leaves no user, so the request maps to Network Activity.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select class_uid, activity_id, user?, service?, unmapped.krb5?
drop_null_fields
