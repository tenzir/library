// Without the `xff` setting, the raw header still lists the forwarded address.
// The server sends the file, so the address belongs to the swapped client.
from_file env("TENZIR_INPUT") {
  read_suricata
}
suricata::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
select src_endpoint, dst_endpoint, unmapped
drop_null_fields
