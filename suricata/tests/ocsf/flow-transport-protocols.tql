// IANA protocol numbers, unknown protocols, and unidirectional NetFlow records.
from {event_type: "flow", proto: "IPv6-ICMP", src_ip: 2001:db8::1, dest_ip: 2001:db8::2, flow: {pkts_toserver: 1, pkts_toclient: 1, bytes_toserver: 64, bytes_toclient: 64, start: 2026-01-01, end: 2026-01-01, state: "established", reason: "timeout"}},
     {event_type: "flow", proto: "SCTP", src_ip: 192.0.2.1, dest_ip: 192.0.2.2, flow: {pkts_toserver: 1, pkts_toclient: 0, bytes_toserver: 60, bytes_toclient: 0, start: 2026-01-01, end: 2026-01-01, state: "new", reason: "timeout"}},
     {event_type: "flow", proto: "GRE", src_ip: 192.0.2.1, dest_ip: 192.0.2.2, flow: {pkts_toserver: 1, pkts_toclient: 0, bytes_toserver: 60, bytes_toclient: 0, start: 2026-01-01, end: 2026-01-01, state: "new", reason: "timeout"}},
     {event_type: "netflow", proto: "UDP", src_ip: 192.0.2.1, dest_ip: 192.0.2.53, netflow: {pkts: 2, bytes: 140, start: 2026-01-01, end: 2026-01-01, age: 0, min_ttl: 64, max_ttl: 64}}
source = {...this, timestamp: 2026-01-01}
ocsf = {}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select metadata.log_name, connection_info, traffic, status_id, unmapped
