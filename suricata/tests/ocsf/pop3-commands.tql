---
pre-compare: sort
---

// POP3 commands report whether the server accepted them.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select activity_id?, app_protocol_name?, status_id?, status_detail?, unmapped
