---
pre-compare: sort
---

from_file f"{env("TENZIR_INPUTS")}/alert.json" {
  read_json
}
where (flow_id? == 997781178181801 and pcap_cnt? == 6589) or (flow_id? == 997781178181801 and pcap_cnt? == 6593)
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf
this = ocsf_cast(this)
