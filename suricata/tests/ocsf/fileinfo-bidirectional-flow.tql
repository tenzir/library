from_file f"{env("TENZIR_INPUTS")}/fileinfo.json" {
  read_json
}
where (flow_id == 1378431998386919 and pcap_cnt? == 880) or (flow_id == 1378431998386919 and pcap_cnt? == 883)
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf
this = ocsf_cast(this)
