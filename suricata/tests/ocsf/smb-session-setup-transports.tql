---
pre-compare: sort
---

from_file f"{env("TENZIR_INPUTS")}/smb.json" {
  read_json
}
where (flow_id == 1115448875602208 and pcap_cnt? == 408264) or (flow_id == 2147090323359516 and pcap_cnt? == 432814)
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf
this = ocsf_cast(this)
