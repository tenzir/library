---
pre-compare: sort
---

from_file f"{env("TENZIR_INPUTS")}/ftp.json" {
  read_json
}
where (flow_id == 529228958590706 and pcap_cnt? == 291957) or (flow_id == 609499111788045 and pcap_cnt? == 302424)
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf
this = ocsf_cast(this)
