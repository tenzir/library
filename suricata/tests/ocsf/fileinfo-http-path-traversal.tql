// A synthetic path traversal probe: the POST body and the response body fall back to the normalized URL path `/bin/sh`, so neither event has a `file`. The sizes become the request and response body lengths.
from_file env("TENZIR_INPUT") {
  read_suricata
}
suricata::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
drop_null_fields
