// Files of FTP data connections describe the transfer, with the client as source.
from_file env("TENZIR_INPUT") {
  read_suricata
}
this = {source: this, ocsf: {}}
suricata::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select class_uid?, activity_id?, src_endpoint?, dst_endpoint?, app_protocol_name?, command?, file?, unmapped
