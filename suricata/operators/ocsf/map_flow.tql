---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
assert $event.has("flow")

$ocsf.traffic = {
  bytes_in: move $event.flow.bytes_toclient,
  bytes_out: move $event.flow.bytes_toserver,
  packets_in: move $event.flow.pkts_toclient,
  packets_out: move $event.flow.pkts_toserver,
}
$ocsf.traffic.bytes = $ocsf.traffic.bytes_in + $ocsf.traffic.bytes_out
$ocsf.traffic.packets = $ocsf.traffic.packets_in + $ocsf.traffic.packets_out