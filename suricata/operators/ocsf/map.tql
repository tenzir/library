---
description: Maps a structured Suricata EVE event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---


// Helpful information for mappers:
// - https://github.com/OISF/suricata/blob/main/etc/schema.json

$ocsf = {}

// --- OCSF: classification attributes ----------

$ocsf.category_uid = 4
$ocsf.severity_id = 1

// --- OCSF: occurrence attributes --------------

$ocsf.time = move $event.timestamp

// --- OCSF: context attributes -----------------

$ocsf.metadata = {
  log_format: "json",
  log_name: $event.event_type,
  product: {
    name: "Suricata",
    vendor_name: "Open Information Security Foundation",
    cpe_name: "cpe:2.3:a:oisf:suricata",
  },
  version: "1.9.0",
}
$ocsf.metadata.sequence = move $event.pcap_cnt?
$ocsf.metadata.original_event_uid = $event.flow_id?.string()
$ocsf.metadata.correlation_uid = $event.flow_id?.string()

// Prefer flow initiator/responder fields when Suricata provides them. Alert
// packets can point in the opposite direction of the flow that triggered them.
$ocsf.src_endpoint = {
  ip: move $event.flow?.src_ip? else move $event.src_ip?,
  port: move $event.flow?.src_port? else move $event.src_port?,
}
$ocsf.dst_endpoint = {
  ip: move $event.flow?.dest_ip? else move $event.dest_ip?,
  port: move $event.flow?.dest_port? else move $event.dest_port?,
}

if $event.event_type != "krb5" and $event.event_type != "smtp" {
  if $event.ip_v? != null {
    $ocsf.connection_info.protocol_ver_id = move $event.ip_v
  } else if $ocsf.src_endpoint?.ip? != null {
    $ocsf.connection_info.protocol_ver_id = 6 if $ocsf.src_endpoint.ip.is_v6() else 4
  } else if $ocsf.dst_endpoint?.ip? != null {
    $ocsf.connection_info.protocol_ver_id = 6 if $ocsf.dst_endpoint.ip.is_v6() else 4
  }

  if $event.flow_id? != null {
    $ocsf.connection_info.uid = $event.flow_id.string()
  }

  if $event.proto? != null {
    let $proto_nums = {
      TCP: 6,
      UDP: 17,
      ICMP: 1,
      ICMPV6: 58,
    }
    $ocsf.connection_info.protocol_name = $event.proto.to_lower()
    $ocsf.connection_info.protocol_num = $proto_nums[$event.proto]? else 0
    drop $event.proto
  }

  $ocsf.connection_info.community_uid = move $event.community_id?
}

let $event_types_without_app_proto = ["alert", "krb5", "smtp"]
if $event.app_proto? != null and $event.app_proto != "failed" and not ($event.event_type in $event_types_without_app_proto) {
  $ocsf.app_protocol_name = move $event.app_proto
}
drop $event.flow_id?

// --- Event-specific mapping -------------------

match $event.event_type {
  "alert" => {
    suricata::ocsf::logs::alert $event, $ocsf
  }
  "anomaly" => {
    suricata::ocsf::logs::anomaly $event, $ocsf
  }
  "dhcp" => {
    suricata::ocsf::logs::dhcp $event, $ocsf
  }
  "dns" => {
    suricata::ocsf::logs::dns $event, $ocsf
  }
  "fileinfo" => {
    suricata::ocsf::logs::fileinfo $event, $ocsf
  }
  "flow" | "netflow" => {
    suricata::ocsf::logs::flow $event, $ocsf
  }
  "ftp" => {
    suricata::ocsf::logs::ftp $event, $ocsf
  }
  "http" => {
    suricata::ocsf::logs::http $event, $ocsf
  }
  "krb5" => {
    suricata::ocsf::logs::krb5 $event, $ocsf
  }
  "mqtt" => {
    suricata::ocsf::logs::mqtt $event, $ocsf
  }
  "sip" => {
    suricata::ocsf::logs::sip $event, $ocsf
  }
  "smb" => {
    suricata::ocsf::logs::smb $event, $ocsf
  }
  "smtp" => {
    suricata::ocsf::logs::smtp $event, $ocsf
  }
  "snmp" => {
    suricata::ocsf::logs::snmp $event, $ocsf
  }
  "ssh" => {
    suricata::ocsf::logs::ssh $event, $ocsf
  }
  "tls" => {
    suricata::ocsf::logs::tls $event, $ocsf
  }
  _ => {
    suricata::ocsf::base $event, $ocsf
  }
}

// --- Epilogue ---------------------------------

drop $event.event_type

$ocsf.unmapped = move $event
