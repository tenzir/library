---
description: Maps a structured Suricata EVE event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---


// Helpful information for mappers:
// - https://github.com/OISF/suricata/blob/main/etc/schema.json

// Event types with a dedicated mapping below. Others become base events and
// retain their connection fields under the original keys.
let $mapped_types = [
  "alert", "anomaly", "arp", "dcerpc", "dhcp", "dns", "fileinfo", "flow", "netflow",
  "ftp", "ftp_data", "http", "krb5", "ldap", "mqtt", "pop3", "quic", "rdp", "rfb", "sip",
  "smb", "smtp", "snmp", "ssh", "tls", "websocket",
]
// These event types choose their class per record. Authentication and Email
// Activity have no `connection_info`, so their operators map the connection
// only when they pick a network class.
let $types_with_class_choice = ["fileinfo", "krb5", "smtp"]

$ocsf = {
  category_uid: 4,
  severity_id: 1,
  // EVE writes microseconds. Rounding to them undoes the one-nanosecond error
  // with which Tenzir 6.23 and 7.0.0-rc.6 read some fractions; remove it once
  // every supported version parses times exactly (Linear TNZ-2181).
  time: (move $event.timestamp).round(1us),
  metadata: {
    log_format: "json",
    log_name: $event.event_type,
    product: {
      name: "Suricata",
      vendor_name: "Open Information Security Foundation",
      cpe_name: "cpe:2.3:a:oisf:suricata",
    },
    version: "1.9.0",
    sequence: move $event.pcap_cnt?,
    correlation_uid: $event.flow_id?.string(),
  },
}

if $event.event_type in $mapped_types {
  // An endpoint needs an address. Alert packets can point in the opposite
  // direction of the flow that triggered them, so prefer the flow initiator
  // and responder when Suricata logs them.
  if $event.flow?.src_ip? != null {
    $ocsf.src_endpoint = {ip: move $event.flow.src_ip, port: move $event.flow.src_port?}
    $ocsf.dst_endpoint = {ip: move $event.flow.dest_ip?, port: move $event.flow.dest_port?}
    // Mappers move the fields that they map. `drop_null_fields` removes the
    // null fields that remain but keeps emptied records, so every mapper drops
    // the records that it can empty, innermost first.
    drop_null_fields $event.flow
    if $event.flow == {} {
      drop $event.flow
    }
  } else if $event.src_ip? != null {
    $ocsf.src_endpoint = {ip: move $event.src_ip, port: move $event.src_port?}
    $ocsf.dst_endpoint = {ip: move $event.dest_ip?, port: move $event.dest_port?}
  }
  if not ($event.event_type in $types_with_class_choice) {
    suricata::ocsf::map_connection_info $event, $ocsf
  }
  // Alerts describe the application protocol in their evidence.
  if $event.app_proto? != "failed" and not ($event.event_type in ["alert", ...$types_with_class_choice]) {
    $ocsf.app_protocol_name = move $event.app_proto?
  }
  drop $event.flow_id?
}

// --- Event-specific mapping -------------------

match $event.event_type {
  "alert" => {
    suricata::ocsf::logs::alert $event, $ocsf
  }
  "anomaly" => {
    suricata::ocsf::logs::anomaly $event, $ocsf
  }
  "arp" => {
    suricata::ocsf::logs::arp $event, $ocsf
  }
  "dcerpc" => {
    suricata::ocsf::logs::dcerpc $event, $ocsf
  }
  "dhcp" => {
    suricata::ocsf::logs::dhcp $event, $ocsf
  }
  "dns" => {
    suricata::ocsf::logs::dns $event, $ocsf
  }
  "fileinfo" => {
    suricata::ocsf::logs::fileinfo $event, $ocsf
  }
  "flow" | "netflow" => {
    suricata::ocsf::logs::flow $event, $ocsf
  }
  "ftp" | "ftp_data" => {
    suricata::ocsf::logs::ftp $event, $ocsf
  }
  // HTTP/2 also logs frames that control the connection, such as SETTINGS
  // or GOAWAY, without a request or response.
  "http" if $event.http.url? != null or $event.http.http_method? != null or $event.http.status? != null => {
    suricata::ocsf::logs::http $event, $ocsf
  }
  "http" => {
    suricata::ocsf::logs::traffic $event, $ocsf
  }
  "krb5" => {
    suricata::ocsf::logs::krb5 $event, $ocsf
  }
  "ldap" => {
    suricata::ocsf::logs::ldap $event, $ocsf
  }
  "mqtt" => {
    suricata::ocsf::logs::mqtt $event, $ocsf
  }
  "pop3" => {
    suricata::ocsf::logs::pop3 $event, $ocsf
  }
  "quic" => {
    suricata::ocsf::logs::quic $event, $ocsf
  }
  "rdp" => {
    suricata::ocsf::logs::rdp $event, $ocsf
  }
  "rfb" => {
    suricata::ocsf::logs::rfb $event, $ocsf
  }
  "sip" => {
    suricata::ocsf::logs::sip $event, $ocsf
  }
  "smb" => {
    suricata::ocsf::logs::smb $event, $ocsf
  }
  "smtp" => {
    suricata::ocsf::logs::smtp $event, $ocsf
  }
  "snmp" => {
    suricata::ocsf::logs::snmp $event, $ocsf
  }
  "ssh" => {
    suricata::ocsf::logs::ssh $event, $ocsf
  }
  "tls" => {
    suricata::ocsf::logs::tls $event, $ocsf
  }
  "websocket" => {
    suricata::ocsf::logs::websocket $event, $ocsf
  }
  _ => {
    suricata::ocsf::base $event, $ocsf
  }
}

// Map connection control bits on network classes only.
if $ocsf.category_uid == 4 and $ocsf.connection_info? != null and $event.tcp?.tcp_flags? != null {
  $ocsf.connection_info.tcp_flags = int(move $event.tcp.tcp_flags, base=16)
}

// --- Epilogue ---------------------------------

drop $event.event_type
$ocsf.unmapped = move $event
// `read_suricata` fills every field of the EVE schema that a record lacks with
// null. A null source field carries no fact worth keeping. The record itself
// stays, even when empty.
drop_null_fields $ocsf.unmapped
