---
description: Maps a structured Suricata EVE event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---


// Helpful information for mappers:
// - https://github.com/OISF/suricata/blob/main/etc/schema.json

// Event types with a dedicated mapping below. Others become base events and
// retain their connection fields under the original keys.
let $mapped_types = [
  "alert", "anomaly", "dhcp", "dns", "fileinfo", "flow", "netflow", "ftp", "http",
  "krb5", "mqtt", "sip", "smb", "smtp", "snmp", "ssh", "tls",
]
// Authentication and Email Activity have no `connection_info`.
let $types_without_connection_info = ["krb5", "smtp"]
// Alerts and these classes describe the application protocol elsewhere.
let $types_without_app_proto = ["alert", "krb5", "smtp"]
let $proto_nums = {
  TCP: 6,
  UDP: 17,
  ICMP: 1,
  "IPv6-ICMP": 58,
  SCTP: 132,
}
let $ip_versions = {
  "true": 6,
  "false": 4,
}

$ocsf = {
  category_uid: 4,
  severity_id: 1,
  time: move $event.timestamp,
  metadata: {
    log_format: "json",
    log_name: $event.event_type,
    product: {
      name: "Suricata",
      vendor_name: "Open Information Security Foundation",
      cpe_name: "cpe:2.3:a:oisf:suricata",
    },
    version: "1.9.0",
    sequence: move $event.pcap_cnt?,
    original_event_uid: $event.flow_id?.string(),
    correlation_uid: $event.flow_id?.string(),
  },
}

if $event.event_type in $mapped_types {
  // An endpoint needs an address. Alert packets can point in the opposite
  // direction of the flow that triggered them, so prefer the flow initiator
  // and responder when Suricata logs them.
  if $event.flow?.src_ip? != null {
    $ocsf.src_endpoint = {ip: move $event.flow.src_ip, port: move $event.flow.src_port?}
    $ocsf.dst_endpoint = {ip: move $event.flow.dest_ip?, port: move $event.flow.dest_port?}
  } else if $event.src_ip? != null {
    $ocsf.src_endpoint = {ip: move $event.src_ip, port: move $event.src_port?}
    $ocsf.dst_endpoint = {ip: move $event.dest_ip?, port: move $event.dest_port?}
  }
  // Events without addresses, such as non-IP packet alerts, have no connection.
  if $ocsf.src_endpoint? != null and not ($event.event_type in $types_without_connection_info) {
    $ocsf.connection_info = {
      protocol_ver_id: move $event.ip_v? else $ip_versions[$ocsf.src_endpoint?.ip?.is_v6().string()]?,
      uid: $event.flow_id?.string(),
      protocol_name: $event.proto?.to_lower(),
      // Unknown protocols have no number.
      protocol_num: $proto_nums[$event.proto?]?,
      community_uid: move $event.community_id?,
      // Suricata's `direction` describes packet flow, not the network
      // perimeter crossing that OCSF means.
      direction_id: 0,
    }
    drop $event.proto?
  }
  if $event.app_proto? != "failed" and not ($event.event_type in $types_without_app_proto) {
    $ocsf.app_protocol_name = move $event.app_proto?
  }
  drop $event.flow_id?
}

// --- Event-specific mapping -------------------

match $event.event_type {
  "alert" => {
    suricata::ocsf::logs::alert $event, $ocsf
  }
  "anomaly" => {
    suricata::ocsf::logs::anomaly $event, $ocsf
  }
  "dhcp" => {
    suricata::ocsf::logs::dhcp $event, $ocsf
  }
  "dns" => {
    suricata::ocsf::logs::dns $event, $ocsf
  }
  "fileinfo" => {
    suricata::ocsf::logs::fileinfo $event, $ocsf
  }
  "flow" | "netflow" => {
    suricata::ocsf::logs::flow $event, $ocsf
  }
  "ftp" => {
    suricata::ocsf::logs::ftp $event, $ocsf
  }
  "http" => {
    suricata::ocsf::logs::http $event, $ocsf
  }
  "krb5" => {
    suricata::ocsf::logs::krb5 $event, $ocsf
  }
  "mqtt" => {
    suricata::ocsf::logs::mqtt $event, $ocsf
  }
  "sip" => {
    suricata::ocsf::logs::sip $event, $ocsf
  }
  "smb" => {
    suricata::ocsf::logs::smb $event, $ocsf
  }
  "smtp" => {
    suricata::ocsf::logs::smtp $event, $ocsf
  }
  "snmp" => {
    suricata::ocsf::logs::snmp $event, $ocsf
  }
  "ssh" => {
    suricata::ocsf::logs::ssh $event, $ocsf
  }
  "tls" => {
    suricata::ocsf::logs::tls $event, $ocsf
  }
  _ => {
    suricata::ocsf::base $event, $ocsf
  }
}

// Map connection control bits on network classes only.
if $ocsf.category_uid == 4 and $ocsf.connection_info? != null {
  $ocsf.connection_info.tcp_flags = int(move $event.tcp?.tcp_flags?, base=16)
}

// --- Epilogue ---------------------------------

drop $event.event_type
$ocsf.unmapped = move $event
