---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
assert $event.dns.has("queries")

$ocsf.query = {
  hostname: $event.dns.queries[0].rrname,
  type: $event.dns.queries[0].rrtype,
}
// TODO: is there ever more than one query in practice?
//assert suricata.dns.queries.length() == 1
drop $event.dns.queries