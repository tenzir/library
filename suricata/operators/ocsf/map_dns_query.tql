---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
$ocsf.query = {
  hostname: $event.dns.queries[0].rrname,
  type: $event.dns.queries[0].rrtype,
}
// OCSF holds one question. Further questions stay under their original key.
$event.dns.queries = $event.dns.queries.slice(begin=1)
if $event.dns.queries.is_empty() {
  drop $event.dns.queries
}
