---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// A URL needs a path. Suricata's `url` also carries the query string.
if $event.http.url? != null {
  $ocsf.http_request.url = {
    // JSON readers infer IP values; the host is always a string.
    hostname: (move $event.http.hostname?).string(),
    // Suricata logs `http_port` when the Host header names a port, such as
    // `Host: example.org:8080`, and port 0 for requests without a host. The
    // URL never takes the port of the connection.
    port: $event.http.http_port? if $event.http.http_port? != 0 else null,
    path: $event.http.url.split("?", max=1)[0],
    query_string: $event.http.url.split("?", max=1)[1]?,
    scheme: "http",
  }
  $ocsf.http_request.url.url_string = (
    "http://"
    + $ocsf.http_request.url.hostname
    + (f":{$ocsf.http_request.url.port}" if $ocsf.http_request.url.port != null else "")
    + $event.http.url
  )
  drop $event.http.url
  if $ocsf.http_request.url.port != null {
    drop $event.http.http_port
  }
}
// HTTP/2 logs HPACK dynamic table size updates among the headers. They are no
// headers and keep their original key.
if $event.http.request_headers? != null {
  $event._headers = $event.http.request_headers.where(x => x.name? != null).map(x => {name: x.name, value: x.value?})
}
if $event.http.http_method? != null or $ocsf.http_request? != null {
  $ocsf.http_request = {
    ...$ocsf.http_request?,
    // OCSF uses the case-sensitive method token, just like Suricata.
    http_method: move $event.http.http_method?,
    referrer: move $event.http.http_refer?,
    user_agent: (move $event.http.http_user_agent?).string(),
    version: move $event.http.protocol?,
    http_headers: $event._headers? if $event._headers? != [] else null,
  }
  // HTTP/2 logs no request line, only the version of the protocol.
  if $ocsf.http_request.version == null and $event.http.version? != null {
    $ocsf.http_request.version = "HTTP/" + move $event.http.version
  }
  if $event._headers? != null {
    $event.http.request_headers = $event.http.request_headers.where(x => x.name? == null)
  }
}
drop $event._headers?
// The X-Forwarded-For header lists the addresses of the client and of the
// proxies that forwarded its request, in that order. `http.xff` holds the
// header as Suricata logs it, which can be shortened or reduced to an address
// that Suricata extracted. With the `xff` setting in `extra-data` mode,
// Suricata also logs the one address that it picked from a configurable header
// as `xff`; in `overwrite` mode, it replaces the logged address instead.
// Clients control the header, so its addresses can be forged.
if $event.http.xff? != null or $event.xff? != null {
  $event.xff_header = ($event.http.xff? else $event.xff).string()
  $event.xff_ips = $event.xff_header.split(",").map(x => ip(x.trim())).where(x => x != null)
  // The header joins the request headers, unless extended logging already
  // lists it there.
  $event.xff_values = ($ocsf.http_request.http_headers? else []).where(x => x.name.to_lower() == "x-forwarded-for").map(x => x.value)
  if $event.xff_values.is_empty() {
    $ocsf.http_request.http_headers = [
      ...$ocsf.http_request.http_headers? else [],
      {name: "X-Forwarded-For", value: $event.xff_header},
    ]
    $event.xff_values = [$event.xff_header]
  }
  // The addresses describe the client side, so they need a client endpoint.
  if $ocsf.src_endpoint? != null and not $event.xff_ips.is_empty() {
    $ocsf.src_endpoint.intermediate_ips = $event.xff_ips
  }
  // The header keeps the raw value, even if an entry is no address, so the
  // copies that it covers leave `unmapped`.
  if $event.xff_header in $event.xff_values {
    drop $event.http.xff?
    if ip($event.xff?.string()) in $event.xff_ips {
      drop $event.xff
    }
  }
  drop $event.xff_header, $event.xff_ips, $event.xff_values
}
// A response needs a status code.
if $event.http.status? != null {
  $ocsf.http_response = {
    code: move $event.http.status,
    body_length: move $event.http.length?,
    content_type: move $event.http.http_content_type?,
    http_headers: $event.http.response_headers?.where(x => x.name? != null).map(x => {name: x.name, value: x.value?}),
  }
  if $event.http.response_headers? != null {
    $event.http.response_headers = $event.http.response_headers.where(x => x.name? == null)
  }
  if $ocsf.http_response.http_headers? == [] {
    drop $ocsf.http_response.http_headers
  }
}
if $event.http.request_headers? == [] {
  drop $event.http.request_headers
}
if $event.http.response_headers? == [] {
  drop $event.http.response_headers
}
