---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
assert $event.has("http")

if $event.http.url? != null {
  $event.http._url = move $event.http.url
  $event.http._url_parts = $event.http._url.split("?", max=1)
  $ocsf.http_request.url.path = $event.http._url_parts[0]
  if $event.http.hostname? != null {
    $ocsf.http_request.url.hostname = (move $event.http.hostname).string()
    $ocsf.http_request.url.scheme = "http"
    $ocsf.http_request.url.url_string = f"http://{$ocsf.http_request.url.hostname}{$event.http._url}"
  }
  if $event.http._url_parts.length() == 2 {
    $ocsf.http_request.url.query_string = $event.http._url_parts[1]
  }
  drop $event.http._url, $event.http._url_parts
}
if $event.http.http_method? != null {
  $ocsf.http_request.http_method = move $event.http.http_method
}
if $event.http.http_refer? != null {
  $ocsf.http_request.referrer = move $event.http.http_refer
}
if $event.http.http_user_agent? != null {
  $ocsf.http_request.user_agent = (move $event.http.http_user_agent).string()
}
if $event.http.protocol? != null {
  $ocsf.http_request.version = move $event.http.protocol
}
if $event.http.request_headers? != null {
  $ocsf.http_request.http_headers = move $event.http.request_headers
}

if $event.http.status? != null {
  $ocsf.http_response.body_length = move $event.http.length?
  $ocsf.http_response.content_type = move $event.http.http_content_type?
  $ocsf.http_response.code = move $event.http.status
  if $event.http.response_headers? != null {
    $ocsf.http_response.http_headers = move $event.http.response_headers
  }
}
