---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
assert $event.smb.has("filename")

$ocsf.file = {
  accessed_time: (move $event.smb.accessed?).seconds().from_epoch(),
  created_time: (move $event.smb.created?).seconds().from_epoch(),
  modified_time: (move $event.smb.modified?).seconds().from_epoch(),
  name: move $event.smb.filename,
  type_id: 0,
}
