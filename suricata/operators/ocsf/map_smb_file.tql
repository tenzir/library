---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// Suricata logs the path within the share as `filename`, or as `directory`
// for folders. The UNC share path is known only when Suricata logs a
// non-empty `share`. Without it, the path stays relative to the share.
$event.smb._path = $event.smb.filename? else $event.smb.directory?
$event.smb._share = $event.smb.share? if $event.smb.share? != "" else null
// The pseudo name `<share_root>` denotes the share folder itself, which has
// no name to report without a share path.
if $event.smb._path != "<share_root>" or $event.smb._share != null {
  $ocsf.file = {
    name: $event.smb._path.file_name(),
    // EVE does not tell regular from executable files.
    type_id: 2 if $event.smb.directory? != null else 1,
    path: $event.smb._share + "\\" + $event.smb._path if $event.smb._share != null else $event.smb._path,
    size: move $event.smb.size?,
    // Suricata logs an empty file ID when a create request fails.
    uid: $event.smb.fuid? if $event.smb.fuid? != "" else null,
    // Suricata logs Unix seconds and 0 for unknown times.
    accessed_time: (move $event.smb.accessed?).seconds().from_epoch() if $event.smb.accessed? != 0 else null,
    created_time: (move $event.smb.created?).seconds().from_epoch() if $event.smb.created? != 0 else null,
    modified_time: (move $event.smb.modified?).seconds().from_epoch() if $event.smb.modified? != 0 else null,
  }
  if $ocsf.file.uid != null {
    drop $event.smb.fuid
  }
  if $event.smb._path == "<share_root>" {
    $ocsf.file.name = $event.smb._share.file_name()
    $ocsf.file.type_id = 2
    $ocsf.file.path = $event.smb._share
  }
  drop $event.smb.filename?, $event.smb.directory?
}
drop $event.smb._path, $event.smb._share
