---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// --- OCSF: classification attributes ----------

$ocsf.activity_id = 6

$ocsf.category_uid = 4
$ocsf.class_uid = 4001
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.app_protocol_name = "tls"
$ocsf.tls = {
  sni: move $event.tls.sni?,
  version: move $event.tls.version? else "Unknown",
}
if $event.tls.ja3?.hash? != null {
  $ocsf.tls.ja3_hash = {
    algorithm_id: 1,
    value: move $event.tls.ja3.hash,
  }
}
if $event.tls.ja3s?.hash? != null {
  $ocsf.tls.ja3s_hash = {
    algorithm_id: 1,
    value: move $event.tls.ja3s.hash,
  }
}

// Resumed sessions carry no certificate. OCSF requires issuer and serial
// number, so leave partial certificate data in `unmapped`.
if $event.tls.issuerdn? != null and $event.tls.serial? != null {
  $ocsf.tls.certificate = {
    created_time: move $event.tls.notbefore?,
    expiration_time: move $event.tls.notafter?,
    issuer: move $event.tls.issuerdn,
    serial_number: move $event.tls.serial,
    subject: move $event.tls.subject?,
  }
  if $event.tls.fingerprint? != null {
    $ocsf.tls.certificate.fingerprints = [{
      algorithm_id: 2,
      value: (move $event.tls.fingerprint).replace(":", ""),
    }]
  }
  $ocsf.tls.certificate.sans = (move $event.tls.subjectaltname?).map(name => {
    name: name,
    type: "DNSName",
  })
}

if $event.tls.ja4? != null {
  $ocsf.ja4_fingerprint_list = [{
    type_id: 1,
    value: move $event.tls.ja4,
  }]
}
// --- OCSF: primary attributes -----------------

$ocsf.status_id = 0

drop_null_fields

// --- Finalize ---------------------------------

@name = "ocsf.network_activity"
