---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// --- OCSF: classification attributes ----------

$ocsf.activity_id = 6

$ocsf.category_uid = 4
$ocsf.class_uid = 4007
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: primary attributes -----------------

if $event.ssh.server?.proto_version? != null {
  $ocsf.protocol_ver = move $event.ssh.server.proto_version
} else if $event.ssh.client?.proto_version? != null {
  $ocsf.protocol_ver = move $event.ssh.client.proto_version
}

if $event.ssh.client?.has("hassh") {
  $ocsf.client_hassh = {
    algorithm: move $event.ssh.client.hassh.string,
    fingerprint: {
      algorithm_id: 20,
      value: move $event.ssh.client.hassh.hash,
    },
  }
}

if $event.ssh.server?.has("hassh") {
  $ocsf.server_hassh = {
    algorithm: move $event.ssh.server.hassh.string,
    fingerprint: {
      algorithm_id: 20,
      value: move $event.ssh.server.hassh.hash,
    },
  }
}

// Server and client can advertise different versions; retain the differing
// client version rather than overwrite the negotiated/server-side value.
if $event.ssh.client?.proto_version? == $ocsf.protocol_ver {
  drop $event.ssh.client.proto_version
}
if $event.ssh.client?.software_version? != null {
  $ocsf.src_endpoint.agent_list = [{
    name: move $event.ssh.client.software_version,
    type_id: 9,
  }]
}
if $event.ssh.server?.software_version? != null {
  $ocsf.dst_endpoint.agent_list = [{
    name: move $event.ssh.server.software_version,
    type_id: 9,
  }]
}
$ocsf.status_id = 0

// --- Finalize ---------------------------------

@name = "ocsf.ssh_activity"
