---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// --- OCSF: classification attributes ----------

if $event.dns.has("answers") {
  $ocsf.activity_id = 2
} else if $event.dns.has("queries") {
  $ocsf.activity_id = 1
} else {
  $ocsf.activity_id = 0
}


$ocsf.class_uid = 4003
$ocsf.opcode_id = 0
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: primary attributes -----------------

// TODO: support `grouped`.

if $event.dns.has("queries") {
  suricata::ocsf::map_dns_query $event, $ocsf
}

if $event.dns.has("answers") {
  $ocsf.answers = ($event.dns.answers).map(answer => {
    rdata: answer.rdata,
    type: answer.rrtype,
    ttl: answer.ttl,
  })
}

if $event.dns.has("rcode") {
  let $rcode_id = {
    NOERROR: 0,
    FORMERROR: 1,
    SERVERROR: 2,
    NXDOMAIN: 3,
    NOTIMP: 4,
    REFUSED: 5,
    YXDOMAIN: 6,
    YXRRSET: 7,
    NXRRSET: 8,
    NOTAUTH: 9,
    NOTZONE: 10,
    DSOTYPENI: 11,
    BADSIG_VERS: 99,
    BADKEY: 17,
    BADTIME: 18,
    BADMODE: 19,
    BADNAME: 20,
    BADALG: 21,
    BADTRUNC: 22,
    BADCOOKIE: 23,
  }
  $ocsf.rcode_id = $rcode_id[$event.dns.rcode]? else 99
  if $ocsf.rcode_id == 99 {
    $ocsf.rcode = $event.dns.rcode
  }
  $ocsf.status_id = 1 if $ocsf.rcode_id == 0 else 2
  drop $event.dns.rcode
} else {
  $ocsf.status_id = 0
}

// --- Finalize ---------------------------------

@name = "ocsf.dns_activity"
