---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// --- OCSF: classification attributes ----------

// EVE version 3 logs requests and responses, older versions queries and
// answers.
let $activity_ids = {
  request: 1,
  query: 1,
  response: 2,
  answer: 2,
}
$ocsf.activity_id = $activity_ids[move $event.dns.type?]? else 0
$ocsf.class_uid = 4003
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// Suricata logs responses in packet direction, from the server. DNS Activity
// puts the client into `src_endpoint`.
if $ocsf.activity_id == 2 {
  $ocsf = {
    ...$ocsf,
    src_endpoint: $ocsf.dst_endpoint?,
    dst_endpoint: $ocsf.src_endpoint?,
  }
}

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_version = (move $event.dns.version?).string()

// --- OCSF: primary attributes -----------------

$ocsf.opcode_id = move $event.dns.opcode? else 0
$ocsf.transaction_id = move $event.dns.id?

if $event.dns.queries? != null {
  suricata::ocsf::map_dns_query $event, $ocsf
} else if $event.dns.rdata? != null {
  // EVE version 1 logs each answer record on its own.
  $ocsf.answers = [{
    hostname: move $event.dns.rrname?,
    type: move $event.dns.rrtype?,
    rdata: (move $event.dns.rdata).string(),
    ttl: move $event.dns.ttl?,
  }]
} else if $event.dns.rrname? != null {
  // EVE version 2 logs the question at the top level.
  $ocsf.query = {
    hostname: move $event.dns.rrname,
    type: move $event.dns.rrtype?,
  }
}

if $event.dns.answers? != null {
  suricata::ocsf::map_dns_records $event.dns.answers, $ocsf.answers
} else if $event.dns.grouped? != null {
  // The grouped format lists the data of each record type without names and
  // TTLs. Unlisted record types stay under their original keys.
  $ocsf.answers = [
    ...(move $event.dns.grouped.A?).map(x => {type: "A", rdata: x.string()}),
    ...(move $event.dns.grouped.AAAA?).map(x => {type: "AAAA", rdata: x.string()}),
    ...(move $event.dns.grouped.CNAME?).map(x => {type: "CNAME", rdata: x}),
    ...(move $event.dns.grouped.MX?).map(x => {type: "MX", rdata: x}),
    ...(move $event.dns.grouped.NS?).map(x => {type: "NS", rdata: x}),
    ...(move $event.dns.grouped.PTR?).map(x => {type: "PTR", rdata: x}),
    ...(move $event.dns.grouped.TXT?).map(x => {type: "TXT", rdata: x}),
    ...(move $event.dns.grouped.SOA?).map(x => {
      type: "SOA",
      rdata: f"{x.mname} {x.rname} {x.serial} {x.refresh} {x.retry} {x.expire} {x.minimum}",
    }),
    ...(move $event.dns.grouped.SRV?).map(x => {
      type: "SRV",
      rdata: f"{x.priority} {x.weight} {x.port} {x.name}",
    }),
  ]
}
if $event.dns.authorities? != null {
  suricata::ocsf::map_dns_records $event.dns.authorities, $ocsf.authority
}
if $event.dns.additionals? != null {
  // The additional section belongs to the message that Suricata logged.
  if $ocsf.activity_id == 1 {
    suricata::ocsf::map_dns_records $event.dns.additionals, $ocsf.query_additional.records
  } else {
    suricata::ocsf::map_dns_records $event.dns.additionals, $ocsf.response_additional.records
  }
}

let $rcode_ids = {
  NOERROR: 0,
  FORMERR: 1,
  SERVFAIL: 2,
  NXDOMAIN: 3,
  NOTIMP: 4,
  REFUSED: 5,
  YXDOMAIN: 6,
  YXRRSET: 7,
  NXRRSET: 8,
  NOTAUTH: 9,
  NOTZONE: 10,
  // Suricata prints codes without a name as numbers.
  "11": 11,
  "BADVERS/BADSIG": 16,
}
// EVE version 3 logs the empty response code bits of requests as NOERROR. A
// request has no response code, so the value keeps its original key.
if $event.dns.rcode? != null and $ocsf.activity_id != 1 {
  $ocsf.rcode_id = $rcode_ids[$event.dns.rcode]? else 99
  if $ocsf.rcode_id == 99 {
    $ocsf.rcode = $event.dns.rcode
  }
  $ocsf.status_id = 1 if $ocsf.rcode_id == 0 else 2
  drop $event.dns.rcode
} else {
  $ocsf.status_id = 0
}

// EVE logs the raw header flags as hex and adds booleans for some set flags,
// but none for AD and CD. Keep the raw header for reserved bits; normalize
// only OCSF's six defined flags. Queries of EVE version 2 log no flags.
$event._flags = int($event.dns.flags?, base=16)
$ocsf.flag_ids = [
  1 if bit_and($event._flags, 1024) == 1024 or $event.dns.aa? == true,
  2 if bit_and($event._flags, 512) == 512 or $event.dns.tc? == true,
  3 if bit_and($event._flags, 256) == 256 or $event.dns.rd? == true,
  4 if bit_and($event._flags, 128) == 128 or $event.dns.ra? == true,
  5 if bit_and($event._flags, 32) == 32,
  6 if bit_and($event._flags, 16) == 16,
].collect()
drop $event._flags, $event.dns.aa?, $event.dns.tc?, $event.dns.rd?, $event.dns.ra?
drop $event.dns.qr?

// --- Finalize ---------------------------------

drop_null_fields $event.dns
if $event.dns.grouped? == {} {
  drop $event.dns.grouped
}
if $event.dns == {} {
  drop $event.dns
}

@name = "ocsf.dns_activity"
