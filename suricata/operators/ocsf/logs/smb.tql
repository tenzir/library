---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// --- OCSF: classification attributes ----------

/*
 * Map SMB disposition values to OCSF SMB Activity activities:
 * - FILE_SUPERSEDE: File Supersede = activity_id 1
 * - FILE_OPEN: File Open = activity_id 2
 * - FILE_CREATE: File Create = activity_id 3
 * - FILE_OPEN_IF: File Open If = activity_id 4
 * - FILE_OVERWRITE: File Overwrite = activity_id 5
 * - FILE_OVERWRITE_IF: File Overwrite If = activity_id 6
 */
let $smb_activity_id = {
  FILE_SUPERSEDE: 1,
  FILE_OPEN: 2,
  FILE_CREATE: 3,
  FILE_OPEN_IF: 4,
  FILE_OVERWRITE: 5,
  FILE_OVERWRITE_IF: 6,
}

$ocsf.activity_id = $smb_activity_id[$event.smb.disposition?]? else 0

$ocsf.category_uid = 4
$ocsf.class_uid = 4006

// Severity: informational for normal operations
$ocsf.severity_id = 1

$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.client_dialects = move $event.smb.client_dialects?
$ocsf.dialect = move $event.smb.dialect?

// NTLMSSP session setups name the authenticating account and client host.
if $event.smb.ntlmssp?.user? not in [null, ""] {
  $ocsf.metadata.profiles = ["host"]
  $ocsf.actor.user = {
    name: move $event.smb.ntlmssp.user,
    domain: move $event.smb.ntlmssp.domain? if $event.smb.ntlmssp.domain? != "" else null,
  }
}
$ocsf.src_endpoint.hostname = move $event.smb.ntlmssp?.host?
// Session setups report the operating systems of client and server.
if $event.smb.request?.native_os? not in [null, ""] {
  $ocsf.src_endpoint.os = {name: move $event.smb.request.native_os, type_id: 0}
}
if $event.smb.response?.native_os? not in [null, ""] {
  $ocsf.dst_endpoint.os = {name: move $event.smb.response.native_os, type_id: 0}
}

// --- OCSF: primary attributes -----------------

$ocsf.command = move $event.smb.command?
$ocsf.connection_info.session.uid = (move $event.smb.session_id?).string()
$ocsf.tree_uid = (move $event.smb.tree_id?).string()
// Tree connects to IPC$ log the share as `named_pipe`.
$ocsf.share = $event.smb.share? else move $event.smb.named_pipe?
let $share_type_ids = {
  FILE: 1,
  PIPE: 2,
  PRINT: 3,
}
$ocsf.share_type_id = $share_type_ids[move $event.smb.share_type?]?
$ocsf.open_type = move $event.smb.access?

if $event.smb.filename? != null or $event.smb.directory? != null {
  suricata::ocsf::map_smb_file $event, $ocsf
}
drop $event.smb.share?

$ocsf.status_code = move $event.smb.status_code?
$ocsf.status_detail = move $event.smb.status?
// STATUS_MORE_PROCESSING_REQUIRED asks the client to continue a session setup.
match $ocsf.status_detail {
  "STATUS_SUCCESS" => {
    $ocsf.status_id = 1
  }
  "STATUS_MORE_PROCESSING_REQUIRED" | null => {
    $ocsf.status_id = 0
  }
  _ => {
    $ocsf.status_id = 2
  }
}

// --- Finalize ---------------------------------

@name = "ocsf.smb_activity"
