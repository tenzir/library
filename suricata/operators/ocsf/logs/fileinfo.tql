---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// --- OCSF: classification attributes ----------

$ocsf.class_uid = 4010
$ocsf.category_uid = 4
$ocsf.activity_id = 0
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: primary attributes -----------------

$ocsf.file = {
  type_id: 0,
  name: move $event.fileinfo.filename,
  size: move $event.fileinfo.size,
  hashes: [
    {algorithm_id: 1, value: $event.fileinfo.md5?} if $event.fileinfo.md5? != null,
    {algorithm_id: 2, value: $event.fileinfo.sha1?} if $event.fileinfo.sha1? != null,
    {algorithm_id: 3, value: $event.fileinfo.sha256?} if $event.fileinfo.sha256? != null,
  ].collect(),
  desc: move $event.fileinfo.magic?,
}

drop $event.fileinfo.md5?, $event.fileinfo.sha1?, $event.fileinfo.sha256?

// --- Finalize ---------------------------------

@name = "ocsf.network_file_activity"
