---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// --- OCSF: classification attributes ----------

// TODO: coudl be more precise
$ocsf.activity_id = 6

$ocsf.class_uid = 4001
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: primary attributes -----------------

suricata::ocsf::map_flow $event, $ocsf
$ocsf.traffic.start_time = move $event.flow.start?
$ocsf.traffic.end_time = move $event.flow.end?

if $event.flow.state? != null {
  $ocsf.status_detail = move $event.flow.state
}
if $event.flow.reason? != null {
  $ocsf.status_code = move $event.flow.reason
}
$ocsf.status_id = 1 if $ocsf.status_detail? == "established" else 0

// --- Finalize ---------------------------------

@name = "ocsf.network_activity"
