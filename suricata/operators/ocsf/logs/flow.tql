---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// --- OCSF: classification attributes ----------

// Suricata logs a flow when it ends or times out. For TCP, its flags and
// state tell how the connection went, as Zeek's connection states do:
// - A responder that resets the connection without a SYN refused it.
// - Any other reset resets the connection.
// - Both sides closing it closes the connection, a closing side alone fails
//   it.
// - A connection that is still open, or only a SYN, opens a connection.
// Other protocols, NetFlow records, and the state `none`, which Suricata logs
// when it tracked no TCP state, report traffic. NetFlow records describe one
// direction only.
let $tcp_states = {
  syn_sent: 1,
  syn_recv: 1,
  established: 1,
  fin_wait1: 4,
  fin_wait2: 4,
  close_wait: 4,
  closing: 2,
  last_ack: 2,
  time_wait: 2,
  closed: 2,
}
if $event.event_type == "netflow" {
  $ocsf.activity_id = 6
} else if $event.tcp?.rst? == true {
  // `tcp_flags_tc` holds the flags of the responder in hex: RST is 0x04, SYN
  // 0x02.
  $event._flags_tc = int($event.tcp.tcp_flags_tc? else "00", base=16)
  $ocsf.activity_id = 5 if bit_and($event._flags_tc, 4) == 4 and bit_and($event._flags_tc, 2) == 0 else 3
  drop $event._flags_tc
} else {
  $ocsf.activity_id = $tcp_states[$event.tcp?.state?]? else 6
}
$ocsf.class_uid = 4001
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: primary attributes -----------------

if $event.flow? != null {
  suricata::ocsf::map_flow $event, $ocsf
  $ocsf.traffic.start_time = move $event.flow.start?
  $ocsf.traffic.end_time = move $event.flow.end?
  $ocsf.status_detail = move $event.flow.state?
  $ocsf.status_code = move $event.flow.reason?
} else {
  // NetFlow records count one direction only.
  $ocsf.traffic = {
    bytes: move $event.netflow.bytes?,
    packets: move $event.netflow.pkts?,
    start_time: move $event.netflow.start?,
    end_time: move $event.netflow.end?,
  }
}
$ocsf.status_id = 1 if $ocsf.status_detail? == "established" else 0

// --- Finalize ---------------------------------

drop_null_fields $event.flow?
if $event.flow? == {} {
  drop $event.flow
}
drop_null_fields $event.netflow?
if $event.netflow? == {} {
  drop $event.netflow
}

@name = "ocsf.network_activity"
