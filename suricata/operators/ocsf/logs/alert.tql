---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// --- OCSF: classification attributes ----------

$ocsf.category_uid = 2

$ocsf.activity_id = 1 // Create
$ocsf.class_uid = 2004
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.metadata.profiles = ["security_control"]

// Suricata severity 1 is the most severe.
let $severities = [0, 4, 3, 2, 1]
$ocsf.severity_id = $severities[move $event.alert.severity]? else 0

// --- OCSF: primary attributes -----------------

$ocsf.is_alert = true

let $actions = {
  allowed: {action_id: 1, disposition_id: 1},
  blocked: {action_id: 2, disposition_id: 2},
}
if $event.alert.action? != null {
  $ocsf = {
    ...$ocsf,
    ...($actions[$event.alert.action]? else {
      action: $event.alert.action,
      action_id: 99,
      disposition: $event.alert.action,
      disposition_id: 99,
    }),
  }
  drop $event.alert.action
}

let $confidence_ids = {
  low: 1,
  medium: 2,
  high: 3,
}
if $event.alert.metadata?.confidence? != null {
  $ocsf.confidence_id = $confidence_ids[$event.alert.metadata.confidence[0].to_lower()]? else 99
  if $ocsf.confidence_id == 99 {
    $ocsf.confidence = $event.alert.metadata.confidence[0]
  }
  drop $event.alert.metadata.confidence
}

// Suricata alerts can have a bunch of different records, based on the
// respective protocol analyzer. Our strategy here is to map them as evidence.
// The HTTP mapping adds the X-Forwarded-For addresses to the source endpoint,
// so it runs before the endpoints move into the evidence.
if $event.http? != null {
  suricata::ocsf::map_http $event, $ocsf
}
$ocsf.evidence = {
  src_endpoint: move $ocsf.src_endpoint?,
  dst_endpoint: move $ocsf.dst_endpoint?,
  connection_info: move $ocsf.connection_info?,
}
if $event.dns?.queries? != null {
  suricata::ocsf::map_dns_query $event, $ocsf
  $ocsf.evidence.query = move $ocsf.query
}
if $event.http? != null {
  $ocsf.evidence.http_request = move $ocsf.http_request?
  $ocsf.evidence.http_response = move $ocsf.http_response?
}
if $event.smb?.filename? != null {
  suricata::ocsf::map_smb_file $event, $ocsf
  $ocsf.evidence.file = move $ocsf.file
}
// Evidence needs at least one attribute. Non-IP packet alerts have none.
$ocsf.evidences = [move $ocsf.evidence].where(x => x.values().map(v => v != null).any())

$ocsf.finding_info = {
  uid: $event.alert.signature_id.string(),
  title: $event.alert.signature,
  analytic: {
    type: "Rule",
    type_id: 1,
    // The generator ID is a reasonable field for algorithm.
    algorithm: (move $event.alert.gid).string(),
    category: move $event.alert.category,
    name: $event.alert.signature,
    uid: $event.alert.signature_id.string(),
    version: (move $event.alert.rev).string(),
  },
}
drop $event.alert.signature, $event.alert.signature_id

// --- Finalize ---------------------------------

suricata::ocsf::drop_empty $event.alert
suricata::ocsf::drop_empty $event.http?
suricata::ocsf::drop_empty $event.smb?

@name = "ocsf.detection_finding"
