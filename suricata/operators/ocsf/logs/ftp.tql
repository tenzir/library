---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// FTP data connections log the command and file name of the control
// connection that opened them. Suricata logs them in the direction of the data
// connection. Its initiator is the client in passive mode, but the server in
// active mode, which the event does not tell, so the endpoints stay as logged.
$event._command = $event.ftp?.command? else $event.ftp_data?.command?
$event._argument = $event.ftp?.command_data? else $event.ftp_data?.filename?

// --- OCSF: classification attributes ----------

// Other commands, such as USER or PASV, are activities that OCSF does not
// list. Server greetings have no command.
let $commands = {
  // 1 - Put (Upload)
  STOR: 1,
  STOU: 1,
  PUT: 1,
  APPE: 1,
  // 2 - Get (Download)
  GET: 2,
  RETR: 2,
  // 3 - Poll (Directory/file checking, navigation)
  MLST: 3,
  SIZE: 3,
  CWD: 3,
  CDUP: 3,
  PWD: 3,
  STAT: 3,
  // 4 - Delete
  DELE: 4,
  RMD: 4,
  XRMD: 4,
  // 5 - Rename
  RNFR: 5,
  RNTO: 5,
  // 6 - List
  NLST: 6,
  LIST: 6,
  MLSD: 6,
}

$ocsf.activity_id = $commands[$event._command]? else (99 if $event._command != null else 0)
if $ocsf.activity_id == 99 {
  $ocsf.activity_name = $event._command
}
$ocsf.class_uid = 4008
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

if $event._command == "USER" and $event._argument != null {
  $ocsf.metadata.profiles = ["host"]
  $ocsf.actor.user.name = $event._argument
  drop $event.ftp?.command_data?
}

// Only these commands take a file or folder argument. OCSF prefers Regular
// File when the source does not distinguish file types.
let $file_types = {
  APPE: 1,
  DELE: 1,
  MDTM: 1,
  RETR: 1,
  RNFR: 1,
  RNTO: 1,
  SIZE: 1,
  STOR: 1,
  STOU: 1,
  MKD: 2,
  XMKD: 2,
  RMD: 2,
  XRMD: 2,
}
if $file_types[$event._command]? != null and $event._argument != null {
  $ocsf.file = {
    name: $event._argument.file_name(),
    path: $event._argument,
    type_id: $file_types[$event._command],
  }
  drop $event.ftp?.command_data?, $event.ftp_data?.filename?
}

// --- OCSF: primary attributes -----------------

$ocsf.command = $event._command
drop $event.ftp?.command?, $event.ftp_data?.command?
$ocsf.command_responses = move $event.ftp?.reply?
$ocsf.codes = (move $event.ftp?.completion_code?).map(code => int(code))
$ocsf.port = move $event.ftp?.dynamic_port?
$ocsf.type = move $event.ftp?.mode?

// The last reply tells the outcome of the command.
$ocsf.status_code = $ocsf.codes[-1]?.string()
// Range bounds are exclusive.
match $ocsf.codes[-1]? {
  // Preliminary, completion, and intermediate replies
  99..400 => {
    $ocsf.status_id = 1
  }
  // Transient and permanent negative replies
  399..600 => {
    $ocsf.status_id = 2
  }
  _ => {
    $ocsf.status_id = 0
  }
}

// --- Finalize ---------------------------------

drop $event._command, $event._argument
drop_null_fields $event.ftp?
if $event.ftp? == {} {
  drop $event.ftp
}
drop_null_fields $event.ftp_data?
if $event.ftp_data? == {} {
  drop $event.ftp_data
}

@name = "ocsf.ftp_activity"
