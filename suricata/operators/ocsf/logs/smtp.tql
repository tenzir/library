---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// --- OCSF: classification attributes ----------

$ocsf.activity_id = 5

$ocsf.category_uid = 4
$ocsf.class_uid = 4009

// Severity: informational for normal operations
$ocsf.severity_id = 1

$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.direction_id = 0

// --- OCSF: primary attributes -----------------

$ocsf.protocol_name = "SMTP"
$ocsf.smtp_hello = move $event.smtp.helo?
$ocsf.email = {
  smtp_from: move $event.smtp?.mail_from?,
  smtp_to: move $event.smtp?.rcpt_to?,
  from_mailbox: move $event.email?.from?,
  to_mailboxes: move $event.email?.to?,
}
$ocsf.status_id = 1 if $event.email?.status? == "PARSE_DONE" else 0
$ocsf.status_detail = move $event.email?.status?

drop_null_fields

// --- Finalize ---------------------------------

@name = "ocsf.email_activity"
