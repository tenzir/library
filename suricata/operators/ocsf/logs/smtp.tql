---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// Email Activity identifies a message by its sender and recipients. Suricata
// logs the SMTP envelope (RFC 5321) once the client sends MAIL FROM and
// RCPT TO, and the header addresses (RFC 5322) only when its MIME parser found
// them. Plain HELO/STARTTLS sessions lack both, so these records describe SMTP
// traffic instead. Suricata logs no SMTP reply codes, so neither class tells
// the outcome. The email `status` describes the parser state, not the outcome
// of the transaction.
if (
  $event.smtp?.mail_from? != null
  or $event.smtp?.rcpt_to? not in [null, []]
  or $event.email?.from? != null
  or $event.email?.to? not in [null, []]
) {
  // --- OCSF: classification attributes ----------

  $ocsf.activity_id = 1
  $ocsf.category_uid = 4
  $ocsf.class_uid = 4009
  $ocsf.severity_id = 1
  $ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

  // --- OCSF: context attributes -----------------

  $ocsf.direction_id = 0

  // --- OCSF: primary attributes -----------------

  $ocsf.protocol_name = "SMTP"
  // The HELO/EHLO argument carries the client's self-reported host name.
  // Suricata doesn't log which of the two verbs the client sent.
  $ocsf.command = move $event.smtp.helo?
  // The header fields hold human-readable mailboxes such as
  // `Name <user@example.org>`, from which the machine-readable fields take the
  // address. Without header addresses, such as for a rejected envelope or an
  // unparsed message, `from` and `to` fall back to the envelope, and the
  // mailbox fields stay empty. The envelope sender is the reverse-path that
  // the receiving server records as `Return-Path` (RFC 5321, section 4.4), and
  // the envelope recipients are the addresses that a `Delivered-To` header
  // records (RFC 9228).
  let $address = "^.*<([^>]*)>.*$"
  $ocsf.email = {
    from: $event.email?.from?.replace_regex($address, "\\1").trim() else $event.smtp?.mail_from?.trim("<>"),
    from_mailbox: move $event.email?.from?,
    to: $event.email?.to?.map(x => x.replace_regex($address, "\\1").trim()) else $event.smtp?.rcpt_to?.map(x => x.trim("<>")),
    to_mailboxes: move $event.email?.to?,
    return_path: (move $event.smtp.mail_from?).trim("<>"),
    delivered_to_list: (move $event.smtp.rcpt_to?).map(x => x.trim("<>")),
    cc: $event.email?.cc?.map(x => x.replace_regex($address, "\\1").trim()),
    cc_mailboxes: move $event.email?.cc?,
    subject: move $event.email?.subject?,
    message_uid: move $event.email?.message_id?,
    files: (move $event.email?.attachment?).map(x => {name: x, type_id: 1}),
    // Suricata logs URLs without their scheme.
    urls: (move $event.email?.url?).map(x => {url_string: x}),
  }

  @name = "ocsf.email_activity"
} else {
  // The envelope and any partial message details keep their original keys,
  // because Network Activity has no attributes for them.
  $ocsf.activity_id = 6
  $ocsf.category_uid = 4
  $ocsf.class_uid = 4001
  $ocsf.severity_id = 1
  $ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
  suricata::ocsf::map_connection_info $event, $ocsf
  $ocsf.app_protocol_name = "smtp"

  @name = "ocsf.network_activity"
}

// --- Cleanup ----------------------------------

suricata::ocsf::drop_empty $event.smtp?
suricata::ocsf::drop_empty $event.email?
