---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
suricata::ocsf::logs::traffic $event, $ocsf
$ocsf.app_protocol_name = "websocket"

// Suricata logs WebSocket frames in packet direction. Clients mask every
// frame that they send, servers none (RFC 6455).
$ocsf.initiator_id = 1 if $event.websocket.mask? != null else 2
