---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// SIP messages travel over a connection, but do not open, close, or fail it.
// INVITE and BYE begin and end a call, and an error response fails a
// request.
suricata::ocsf::logs::traffic $event, $ocsf
$ocsf.app_protocol_name = "sip"

$ocsf.message = move $event.sip.request_line? else move $event.sip.response_line?
$ocsf.status_detail = move $event.sip.reason?
$ocsf.status_code = move $event.sip.code?
// Suricata logs SIP messages in packet direction. Responses answer a
// request of the destination.
if $event.sip.method? != null {
  $ocsf.initiator_id = 1
} else if $ocsf.status_code != null {
  $ocsf.initiator_id = 2
}
// Requests have no outcome.
$ocsf.status_id = (2 if int($ocsf.status_code) >= 400 else 1) if $ocsf.status_code != null else 0

// --- Finalize ---------------------------------

drop_null_fields $event.sip
if $event.sip == {} {
  drop $event.sip
}
