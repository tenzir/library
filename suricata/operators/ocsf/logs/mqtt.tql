---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// --- OCSF: classification attributes ----------

/*
 * Map MQTT message types to OCSF Network Activity activities:
 * - connack (failure): Connection failed = activity_id 4
 * - connect/connack (success): Network connection opened = activity_id 1
 * - disconnect: Network connection closed = activity_id 2
 * - any other message, such as publish or subscribe: Traffic = activity_id 6
 */
if $event.mqtt.connack?.return_code? not in [null, 0] {
  $ocsf.activity_id = 4
} else if $event.mqtt.connect? != null or $event.mqtt.connack? != null {
  $ocsf.activity_id = 1
} else if $event.mqtt.disconnect? != null {
  $ocsf.activity_id = 2
} else if $event.mqtt.values().map(x => x != null).any() {
  $ocsf.activity_id = 6
} else {
  $ocsf.activity_id = 0
}

$ocsf.category_uid = 4
$ocsf.class_uid = 4001
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.app_protocol_name = "mqtt"
$ocsf.connection_info.session.uid = move $event.mqtt.connect?.client_id?

// --- OCSF: primary attributes -----------------

$ocsf.message = move $event.mqtt.publish?.topic?
// The payload is binary.
drop $event.mqtt.publish?.message?

// CONNACK return codes other than 0 and MQTT 5 disconnect reason codes from
// 0x80 on report failures. MQTT 3 disconnects carry no reason and always
// close the connection normally.
$ocsf.status_code = (move $event.mqtt.connack?.return_code? else move $event.mqtt.disconnect?.reason_code?).string()
if $ocsf.status_code == null {
  $ocsf.status_id = 1 if $event.mqtt.disconnect? != null else 0
} else if $event.mqtt.disconnect? != null {
  $ocsf.status_id = 1 if int($ocsf.status_code) < 128 else 2
} else {
  $ocsf.status_id = 1 if $ocsf.status_code == "0" else 2
}

// --- Finalize ---------------------------------

@name = "ocsf.network_activity"
