---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// --- OCSF: classification attributes ----------

let $activity_ids = {
  discover: 1,
  offer: 2,
  request: 3,
  decline: 4,
  ack: 5,
  nak: 6,
  release: 7,
  inform: 8,
}

$ocsf.class_uid = 4004
$ocsf.activity_id = $activity_ids[$event.dhcp.dhcp_type?]? else 0
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: primary attributes -----------------

// OCSF describes the client as source and the server as destination.
if $event.dhcp.type? == "reply" {
  $ocsf = {
    ...$ocsf,
    src_endpoint: $ocsf.dst_endpoint?,
    dst_endpoint: $ocsf.src_endpoint?,
  }
}

$ocsf.src_endpoint.hostname = move $event.dhcp.hostname?
$ocsf.src_endpoint.mac = move $event.dhcp.client_mac?
// The assigned address replaces broadcast and unspecified packet addresses.
// Suricata logs 0.0.0.0 when the server assigned none.
if $event.dhcp.assigned_ip? not in [null, 0.0.0.0] {
  $ocsf.src_endpoint.ip = move $event.dhcp.assigned_ip
}
$ocsf.lease_dur = move $event.dhcp.lease_time?

let $status_ids = {
  offer: 1,
  ack: 1,
  decline: 2,
  nak: 2,
}
$ocsf.status_id = $status_ids[$event.dhcp.dhcp_type?]? else 0

$ocsf.transaction_uid = (move $event.dhcp.id).string()

// --- Finalize ---------------------------------

@name = "ocsf.dhcp_activity"
