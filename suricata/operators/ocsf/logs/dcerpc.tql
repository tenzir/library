---
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---
// Network Activity has no DCE/RPC object, so the call details keep their
// original keys.
suricata::ocsf::logs::traffic $event, $ocsf
$ocsf.app_protocol_name = "dcerpc"
