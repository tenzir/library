---
description: Maps NetFlow and IPFIX records to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---



// IPFIX uses version 10 for both flow and options records. Only flow records
// map to Network Activity.
match $event.netflow.version? {
  5 | 9 | 10 => {
    if $event.netflow.record_type? == "flow" {
      netflow::ocsf::events::network_activity $event, $ocsf
    } else {
      netflow::ocsf::base $event, $ocsf
    }
  }
  _ => {
    netflow::ocsf::base $event, $ocsf
  }
}

// Construct metadata after dispatch so shared fields move at their last use.
$ocsf.metadata = {
  version: "1.9.0",
  log_name: "netflow",
  log_version: (move $event.netflow.version?).string(),
  type: move $event.netflow.record_type?,
  sequence: move $event.netflow.sequence_number?,
  transmit_time: move $event.netflow.export_time?,
  reporter: {
    ip: move $event.netflow.exporter?.ip?,
  },
  product: {
    name: "NetFlow/IPFIX",
  },
}



$ocsf.unmapped = move $event
