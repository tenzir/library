---
description: Maps NetFlow and IPFIX records to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The NetFlow or IPFIX record to map.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the OCSF event.
---


// Keep all mapping work inside the selected event scope.
$into = {source: $event, ocsf: {}}

// IPFIX uses version 10 for both flow and options records. Only flow records
// map to Network Activity.
match $into.source.netflow.version? {
  5 | 9 | 10 if $into.source.netflow.record_type? == "flow" => {
    netflow::ocsf::events::network_activity event=$into
  }
  _ => {
    netflow::ocsf::base event=$into
  }
}

// Construct metadata after dispatch so shared fields move at their last use.
$into.ocsf.metadata = {
  version: "1.9.0",
  log_name: "netflow",
  log_version: (move $into.source.netflow.version?).string(),
  type: move $into.source.netflow.record_type?,
  sequence: move $into.source.netflow.sequence_number?,
  transmit_time: move $into.source.netflow.export_time?,
  reporter: {
    ip: move $into.source.netflow.exporter?.ip?,
  },
  product: {
    name: "NetFlow/IPFIX",
  },
}



$into = {...$into.ocsf, unmapped: $into.source}
