---
description: Completes OCSF enums and retains unidentifiable optional objects.
args:
  positional:
    - name: ocsf
      type: field
      description: The OCSF record to finalize.
---

if (
  $ocsf.metadata?.reporter? != null
  and $ocsf.metadata?.reporter?.hostname? == null
  and $ocsf.metadata?.reporter?.ip? == null
  and $ocsf.metadata?.reporter?.name? == null
  and $ocsf.metadata?.reporter?.uid? == null
) {
  if not drop_null_fields($ocsf.metadata.reporter).flatten().is_empty() {
    $ocsf.unmapped.metadata.reporter = {
      ...drop_null_fields($ocsf.metadata.reporter),
      ...$ocsf.unmapped?.metadata?.reporter?,
    }
  }
  drop $ocsf.metadata.reporter
}
if (
  $ocsf.src_endpoint?.autonomous_system? != null
  and $ocsf.src_endpoint?.autonomous_system?.number? == null
  and $ocsf.src_endpoint?.autonomous_system?.name? == null
) {
  if not drop_null_fields($ocsf.src_endpoint.autonomous_system).flatten().is_empty() {
    $ocsf.unmapped.src_endpoint.autonomous_system = {
      ...drop_null_fields($ocsf.src_endpoint.autonomous_system),
      ...$ocsf.unmapped?.src_endpoint?.autonomous_system?,
    }
  }
  drop $ocsf.src_endpoint.autonomous_system
}
if (
  $ocsf.dst_endpoint?.autonomous_system? != null
  and $ocsf.dst_endpoint?.autonomous_system?.number? == null
  and $ocsf.dst_endpoint?.autonomous_system?.name? == null
) {
  if not drop_null_fields($ocsf.dst_endpoint.autonomous_system).flatten().is_empty() {
    $ocsf.unmapped.dst_endpoint.autonomous_system = {
      ...drop_null_fields($ocsf.dst_endpoint.autonomous_system),
      ...$ocsf.unmapped?.dst_endpoint?.autonomous_system?,
    }
  }
  drop $ocsf.dst_endpoint.autonomous_system
}
if (
  $ocsf.src_endpoint?.proxy_endpoint? != null
  and $ocsf.src_endpoint?.proxy_endpoint?.ip? == null
  and $ocsf.src_endpoint?.proxy_endpoint?.uid? == null
  and $ocsf.src_endpoint?.proxy_endpoint?.name? == null
  and $ocsf.src_endpoint?.proxy_endpoint?.hostname? == null
  and $ocsf.src_endpoint?.proxy_endpoint?.svc_name? == null
  and $ocsf.src_endpoint?.proxy_endpoint?.instance_uid? == null
  and $ocsf.src_endpoint?.proxy_endpoint?.interface_uid? == null
  and $ocsf.src_endpoint?.proxy_endpoint?.interface_name? == null
  and $ocsf.src_endpoint?.proxy_endpoint?.domain? == null
) {
  if not drop_null_fields($ocsf.src_endpoint.proxy_endpoint).flatten().is_empty() {
    $ocsf.unmapped.src_endpoint.proxy_endpoint = {
      ...drop_null_fields($ocsf.src_endpoint.proxy_endpoint),
      ...$ocsf.unmapped?.src_endpoint?.proxy_endpoint?,
    }
  }
  drop $ocsf.src_endpoint.proxy_endpoint
}
if (
  $ocsf.dst_endpoint?.proxy_endpoint? != null
  and $ocsf.dst_endpoint?.proxy_endpoint?.ip? == null
  and $ocsf.dst_endpoint?.proxy_endpoint?.uid? == null
  and $ocsf.dst_endpoint?.proxy_endpoint?.name? == null
  and $ocsf.dst_endpoint?.proxy_endpoint?.hostname? == null
  and $ocsf.dst_endpoint?.proxy_endpoint?.svc_name? == null
  and $ocsf.dst_endpoint?.proxy_endpoint?.instance_uid? == null
  and $ocsf.dst_endpoint?.proxy_endpoint?.interface_uid? == null
  and $ocsf.dst_endpoint?.proxy_endpoint?.interface_name? == null
  and $ocsf.dst_endpoint?.proxy_endpoint?.domain? == null
) {
  if not drop_null_fields($ocsf.dst_endpoint.proxy_endpoint).flatten().is_empty() {
    $ocsf.unmapped.dst_endpoint.proxy_endpoint = {
      ...drop_null_fields($ocsf.dst_endpoint.proxy_endpoint),
      ...$ocsf.unmapped?.dst_endpoint?.proxy_endpoint?,
    }
  }
  drop $ocsf.dst_endpoint.proxy_endpoint
}
if (
  $ocsf.traffic?.timespan? != null
  and $ocsf.traffic?.timespan?.duration? == null
  and $ocsf.traffic?.timespan?.duration_days? == null
  and $ocsf.traffic?.timespan?.duration_hours? == null
  and $ocsf.traffic?.timespan?.duration_mins? == null
  and $ocsf.traffic?.timespan?.duration_months? == null
  and $ocsf.traffic?.timespan?.duration_secs? == null
  and $ocsf.traffic?.timespan?.duration_weeks? == null
  and $ocsf.traffic?.timespan?.duration_years? == null
  and $ocsf.traffic?.timespan?.end_time? == null
  and $ocsf.traffic?.timespan?.start_time? == null
) {
  if not drop_null_fields($ocsf.traffic.timespan).flatten().is_empty() {
    $ocsf.unmapped.traffic.timespan = {
      ...drop_null_fields($ocsf.traffic.timespan),
      ...$ocsf.unmapped?.traffic?.timespan?,
    }
  }
  drop $ocsf.traffic.timespan
}
if (
  $ocsf.src_endpoint? != null
  and $ocsf.src_endpoint?.ip? == null
  and $ocsf.src_endpoint?.uid? == null
  and $ocsf.src_endpoint?.name? == null
  and $ocsf.src_endpoint?.hostname? == null
  and $ocsf.src_endpoint?.svc_name? == null
  and $ocsf.src_endpoint?.instance_uid? == null
  and $ocsf.src_endpoint?.interface_uid? == null
  and $ocsf.src_endpoint?.interface_name? == null
  and $ocsf.src_endpoint?.domain? == null
) {
  if not drop_null_fields($ocsf.src_endpoint).flatten().is_empty() {
    $ocsf.unmapped.src_endpoint = {
      ...drop_null_fields($ocsf.src_endpoint),
      ...$ocsf.unmapped?.src_endpoint?,
    }
  }
  drop $ocsf.src_endpoint
}
if (
  $ocsf.dst_endpoint? != null
  and $ocsf.dst_endpoint?.ip? == null
  and $ocsf.dst_endpoint?.uid? == null
  and $ocsf.dst_endpoint?.name? == null
  and $ocsf.dst_endpoint?.hostname? == null
  and $ocsf.dst_endpoint?.svc_name? == null
  and $ocsf.dst_endpoint?.instance_uid? == null
  and $ocsf.dst_endpoint?.interface_uid? == null
  and $ocsf.dst_endpoint?.interface_name? == null
  and $ocsf.dst_endpoint?.domain? == null
) {
  if not drop_null_fields($ocsf.dst_endpoint).flatten().is_empty() {
    $ocsf.unmapped.dst_endpoint = {
      ...drop_null_fields($ocsf.dst_endpoint),
      ...$ocsf.unmapped?.dst_endpoint?,
    }
  }
  drop $ocsf.dst_endpoint
}
if $ocsf.src_endpoint? == null and $ocsf.dst_endpoint? == null {
  // Keep source facts when the selected class cannot be identified.
  $ocsf = {
    ...drop_null_fields({
      time: $ocsf.time,
      metadata: {...$ocsf.metadata, profiles: []},
      message: $ocsf.message?,
      raw_data: $ocsf.raw_data?,
      raw_data_size: $ocsf.raw_data_size?,
      severity_id: $ocsf.severity_id,
      status_id: $ocsf.status_id?,
      status_code: $ocsf.status_code?,
      status_detail: $ocsf.status_detail?,
      start_time: $ocsf.start_time?,
      end_time: $ocsf.end_time?,
      duration: $ocsf.duration?,
      count: $ocsf.count?,
    }),
    category_uid: 0, class_uid: 0, activity_id: 0, type_uid: 0,
    unmapped: {
      ...$ocsf.unmapped?,
      ...$ocsf.entries().where(entry => entry.value != null and entry.key not in [
        "time", "metadata", "message", "raw_data",
        "raw_data_size", "severity_id", "status_id", "status_code",
        "status_detail", "start_time", "end_time", "duration",
        "count", "category_uid", "category_name", "class_uid",
        "class_name", "activity_id", "activity_name", "type_uid",
        "type_name", "severity", "unmapped",
      ]).map(entry => {
        key: entry.key,
        value: {...entry.value, ...($ocsf.unmapped? else {}).get(entry.key, null)}
          if type_kind(entry.value) == "record" and type_kind(($ocsf.unmapped? else {}).get(entry.key, null)) == "record"
          else ($ocsf.unmapped? else {}).get(entry.key, entry.value),
      }).collect_record().drop_null_fields(),
    },
  }
  @name = "ocsf.base_event"
}
