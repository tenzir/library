---
description: NetFlow or IPFIX record to OCSF Base Event.
args:
  positional:
    - name: event
      description: The structured source event.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.base_event"

$ocsf.category_uid = 0
$ocsf.class_uid = 0
$ocsf.activity_id = 0
$ocsf.severity_id = 1
$ocsf.status_id = 0
$ocsf.type_uid = 0
$ocsf.time = $event.netflow.export_time?
