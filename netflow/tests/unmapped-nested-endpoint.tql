from {
  ocsf: {
    class_uid: 4001,
    category_uid: 4,
    src_endpoint: {port: 53, proxy_endpoint: {port: 3128}},
    dst_endpoint: {ip: 192.0.2.1},
    unmapped: {src_endpoint: {label: "original"}},
  },
}
netflow::ocsf::finalize ocsf
assert ocsf.src_endpoint? == null
assert ocsf.unmapped.src_endpoint.port == 53
assert ocsf.unmapped.src_endpoint.proxy_endpoint.port == 3128
assert ocsf.unmapped.src_endpoint.label == "original"
select ocsf.unmapped
