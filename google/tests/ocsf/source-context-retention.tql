from {metadata: {eventTimestamp: 2026-01-01, eventType: "FILE_CREATION"}, principal: {hostname: "host-1", user: {userid: "alice"}, process: {commandLine: "/bin/example --verbose", file: {fullPath: "/bin/example"}}}, target: {file: {names: ["result"], fullPath: "/tmp/result"}}},
     {metadata: {eventTimestamp: 2026-01-01, eventType: "FILE_CREATION"}, principal: {hostname: "host-1", user: {emailAddresses: ["alice@example.org"]}}, target: {file: {names: ["result"], fullPath: "/tmp/result"}, user: {emailAddresses: ["bob@example.org"]}}}
google::ocsf::from_udm
assert class_uid == 1001
assert device.hostname == "host-1"
if actor?.user? != null {
  assert actor.user.uid == "alice"
  assert unmapped.principal.process.commandLine == "/bin/example --verbose"
  assert unmapped.principal.process.file.fullPath == "/bin/example"
} else {
  assert unmapped.principal.user.emailAddresses == ["alice@example.org"]
  assert unmapped.target.user.emailAddresses == ["bob@example.org"]
}
select class_uid, actor?, device, unmapped
