---
description: Translates a Google SecOps UDM record to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The UDM event or entity record to translate.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the OCSF event.
---

$into = $event
if $into.metadata?.entityType? != null or $into.entity? != null {
  google::ocsf::udm::entity::map event=$into
} else {
  google::ocsf::udm::event::map event=$into
}
