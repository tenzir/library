---
description: Translates an OCSF 1.9 event to Google SecOps UDM.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The OCSF event to translate.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the UDM record.
---

$into = $event
match $into.class_uid? {
  5000..5005 | 5005..5024 | 5040 => {
    google::udm::entity::ocsf::map event=$into
  }
  _ => {
    google::udm::event::ocsf::map event=$into
  }
}
