---
description: Fetches Okta System Log events and keeps polling for new ones
args:
  positional:
    - name: domain
      type: string
      description: The Okta domain of the org, such as `example.okta.com`.
  named:
    - name: lookback
      type: duration
      default: 1h
      description: How far back the first request starts.
    - name: interval
      type: duration
      default: 5s
      description: The time to wait between two requests.
    - name: limit
      type: int
      default: 1000
      description: The number of events per request, up to 1000.
    - name: bearer_token
      type: secret
      default: null
      description: An OAuth 2.0 access token with the scope `okta.logs.read`.
    - name: swss_token
      type: secret
      default: null
      description: An Okta API token, used without `bearer_token`.
---

// The first request starts in the past and asks for ascending order without
// an end, which makes it a polling request: every response carries a `next`
// link with an opaque cursor, also when it has no events yet. Following the
// links returns every event once, in the order in which Okta stored it.
// https://developer.okta.com/docs/reference/system-log-query/
// Okta takes the start time with whole seconds.
let $since = (now() - $lookback).format_time("%Y-%m-%dT%H:%M:%S").slice(end=19)
let $endpoint = f"https://{$domain}/api/v1/logs?since={$since}Z&sortOrder=ASCENDING&limit={$limit}"
let $auth = f"Bearer {$bearer_token}" if $bearer_token != null else f"SSWS {$swss_token}"

// Okta answers with status 429 once the org exceeds its rate limit, which
// resets every minute. The retries of a request span two minutes.
from_http $endpoint,
  headers={Authorization: $auth},
  paginate="link",
  paginate_delay=$interval,
  retry_delay=4s {
  okta::read arrays_of_objects=true
}
