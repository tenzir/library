---
description: "Okta → OCSF API Activity (6003)"
args:
  positional:
    - name: event
      description: The field that holds the source event.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.api_activity"

$ocsf.category_uid = 6

// Okta names the API endpoint whose rate limit applies as a URL pattern.
$event._pattern = $event.target?.where(t => t.type? == "URL Pattern")[0]?
if $event._pattern?.id? != null {
  $ocsf.api.operation = $event._pattern.id
  if $event._pattern.alternateId? == null and $event._pattern.displayName? == null {
    $event._mapped = [$event._pattern]
  }
}
if $ocsf.http_request?.uid? != null {
  $ocsf.api.request.uid = $ocsf.http_request.uid
}
drop $event._pattern?
