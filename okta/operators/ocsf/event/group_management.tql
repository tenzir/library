---
description: "Okta → OCSF Group Management (3006)"
args:
  positional:
    - name: event
      description: The field that holds the source event.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// --- OCSF: classification attributes ----------

let $activity_map = {
  "group.lifecycle.create": 1,
  "group.user_membership.add": 3,
  "group.user_membership.remove": 4,
  "group.lifecycle.delete": 5,
  "group.privilege.grant": 99,
  "group.application_assignment.add": 99,
  "group.application_assignment.remove": 99,
  "group.application_assignment.update": 99,
  "group.user_membership.rule.add_exclusion": 99,
}
$ocsf.activity_id = $activity_map[$ocsf.metadata.event_code]? else 99
$ocsf.category_uid = 3
$ocsf.class_uid = 3006
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.status_id = okta::$status_map[$event.outcome.result?]? else 0
$ocsf.status_detail = move $event.outcome.reason?
drop $event.outcome?

// --- OCSF: group and user from target[] -------

if $event.target? != null {
  $ocsf.group = $event.target.where(t => t.type == "UserGroup").map(t => {
    uid: t.id,
    name: t.displayName,
  })[0]?
  $ocsf.group.privileges = move $event.debugContext.debugData.privilegeGranted?
  $ocsf.user = $event.target.where(t => t.type == "User").map(t => {
    uid: t.id,
    name: t.alternateId?.split("@")[0]?,
    full_name: string(t.displayName?),
    email_addr: t.alternateId,
    type_id: 1,
  })[0]?
}

@name = "ocsf.group_management"
