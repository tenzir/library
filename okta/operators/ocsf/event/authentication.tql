---
description: "Okta → OCSF Authentication (3002)"
args:
  positional:
    - name: event
      description: The field that holds the source event.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.authentication"

$ocsf.category_uid = 3

// Okta Support signs in to the org as one of its admins.
if $ocsf.activity_id == 7 {
  $ocsf.account_switch_type_id = 2
}

// The user to authenticate is the User target. The sign-in events of a user
// name no such target, and then the actor is the user who signs in.
$event._user = $event.target?.where(t => t.type? == "User")[0]?
if $event._user?.id? != null or $event._user?.alternateId? != null {
  $ocsf.user = {
    uid: $event._user.id?,
    name: $event._user.alternateId?.split("@")[0]?,
    domain: $event._user.alternateId?.split("@")[1]?,
    email_addr: $event._user.alternateId? if $event._user.alternateId?.match_regex("@") else null,
    full_name: $event._user.displayName?,
    type_id: 1,
  }
} else if $ocsf.actor?.user?.type_id? == 1 {
  $ocsf.user = $ocsf.actor.user
}

// The user authenticates to the app that Okta names, and to Okta itself when
// it names none.
$event._app = $event.target?.where(t => t.type? == "AppInstance")[0]?
if $event._app?.id? != null or $event._app?.displayName? != null {
  $ocsf.service = {
    uid: $event._app.id?,
    name: $event._app.displayName?,
  }
} else {
  $ocsf.service = {
    name: "Okta",
  }
}
// The label of an app that differs from its name stays in `unmapped`.
if $event._app?.alternateId? != null and $event._app?.alternateId? != $event._app?.displayName? {
  drop $event._app
}
$event._mapped = [$event._user?, $event._app?]
drop $event._user?, $event._app?

// The sign-on mode of the app is the protocol of the sign-in.
let $auth_protocol_ids = {
  "OpenID Connect": 4,
  "SAML 2.0": 5,
}
if $event.debugContext?.debugData?.signOnMode? != null {
  $ocsf.auth_protocol_id = $auth_protocol_ids[$event.debugContext.debugData.signOnMode]? else 99
  if $ocsf.auth_protocol_id == 99 {
    $ocsf.auth_protocol = $event.debugContext.debugData.signOnMode
  }
  drop $event.debugContext.debugData.signOnMode
} else if $ocsf.metadata.event_code == "user.authentication.auth_via_radius" {
  $ocsf.auth_protocol_id = 10
}

// The factor that the user verifies or that Okta sends a challenge for. Okta
// does not document the names of the factors, so the type follows the words
// in the name, and the name stays in `unmapped`.
if $event.debugContext?.debugData?.factor? != null {
  $event._factor = $event.debugContext.debugData.factor.to_lower()
  $ocsf.auth_factors = [{
    factor_type_id: (
      5 if $event._factor.match_regex("push")
      else 1 if $event._factor.match_regex("sms")
      else 3 if $event._factor.match_regex("call")
      else 8 if $event._factor.match_regex("email")
      else 10 if $event._factor.match_regex("webauthn")
      else 9 if $event._factor.match_regex("u2f")
      else 2 if $event._factor.match_regex("question")
      else 7 if $event._factor.match_regex("totp|soft_token")
      else 11 if $event._factor.match_regex("password")
      else 99
    ),
    provider: move $event.authenticationContext?.credentialProvider?,
  }]
  if $ocsf.auth_factors[0].factor_type_id == 99 {
    $ocsf.auth_factors = [{
      ...$ocsf.auth_factors[0],
      factor_type: $event.debugContext.debugData.factor,
    }]
  }
  drop $event._factor
}

// The policy that Okta evaluated for the sign-in. The rules that decided stay
// in `unmapped`, because Okta gives one result for all of them.
$event._policy = $event.target?.where(t => t.type? == "PolicyEntity" or t.type? == "Policy")[0]?
if $event._policy?.id? != null or $event._policy?.displayName? != null {
  $ocsf.policy = {
    uid: $event._policy.id?,
    name: $event._policy.displayName?,
  }
}
drop $event._policy?
