---
description: "Okta → OCSF Entity Management (3004)"
args:
  positional:
    - name: event
      description: The field that holds the source event.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.entity_management"

$ocsf.category_uid = 3

// The first target is the entity that the actor manages: an app, a policy, a
// network zone, an identity provider, a device, and so on. Where OCSF has no
// type for the entity, the Okta type names it.
$event._entity = $event.target?[0]?
if $event._entity?.id? != null or $event._entity?.displayName? != null {
  let $entity_type_ids = {
    UDDevice: 1,
    PolicyEntity: 5,
    Policy: 5,
  }
  $ocsf.entity = {
    uid: $event._entity.id?,
    name: $event._entity.displayName?,
    type_id: $entity_type_ids[$event._entity.type?]? else 99,
  }
  if $ocsf.entity.type_id == 99 {
    $ocsf.entity.type = $event._entity.type?
  }
  if $event._entity.alternateId? == null or $event._entity.alternateId? == $event._entity.displayName? {
    $event._mapped = [$event._entity]
  }
}
drop $event._entity?
