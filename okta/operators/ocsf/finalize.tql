---
description: Completes required enums and preserves incomplete source objects.
args:
  positional:
    - name: ocsf
      type: field
      description: The OCSF record to finalize.
---

if (
  $ocsf.src_endpoint?.owner? != null
  and $ocsf.src_endpoint?.owner?.account? == null
  and $ocsf.src_endpoint?.owner?.name? == null
  and $ocsf.src_endpoint?.owner?.uid? == null
) {
  if not drop_null_fields($ocsf.src_endpoint.owner).flatten().is_empty() {
    $ocsf.unmapped.src_endpoint.owner = {
      ...drop_null_fields($ocsf.src_endpoint.owner),
      ...$ocsf.unmapped?.src_endpoint?.owner?,
    }
  }
  drop $ocsf.src_endpoint.owner
}
if (
  $ocsf.src_endpoint?.location? != null
  and $ocsf.src_endpoint?.location?.city? == null
  and $ocsf.src_endpoint?.location?.country? == null
  and $ocsf.src_endpoint?.location?.postal_code? == null
  and $ocsf.src_endpoint?.location?.region? == null
) {
  if not drop_null_fields($ocsf.src_endpoint.location).flatten().is_empty() {
    $ocsf.unmapped.src_endpoint.location = {
      ...drop_null_fields($ocsf.src_endpoint.location),
      ...$ocsf.unmapped?.src_endpoint?.location?,
    }
  }
  drop $ocsf.src_endpoint.location
}
$ocsf.metadata.loggers = $ocsf.metadata.loggers.map(l => {...l, name: l.name? else "Okta"})
if (
  $ocsf.http_request?.url? != null
  and $ocsf.http_request.url.url_string? == null
  and $ocsf.http_request.url.path? == null
) {
  if not drop_null_fields($ocsf.http_request.url).flatten().is_empty() {
    $ocsf.unmapped.http_request.url = {
      ...drop_null_fields($ocsf.http_request.url),
      ...$ocsf.unmapped?.http_request?.url?,
    }
  }
  drop $ocsf.http_request.url
}
if $ocsf.api? != null and $ocsf.api.operation? == null {
  $ocsf.api.operation = $ocsf.metadata.event_code
}
if $ocsf.class_uid == 3002 and $ocsf.service? == null and $ocsf.dst_endpoint? == null {
  $ocsf.service = {name: "Okta"}
}
if $ocsf.evidences? != null {
  $ocsf.unmapped.evidences = $ocsf.evidences.where(e => e.src_endpoint?.owner? != null
    and e.src_endpoint.owner.account? == null
    and e.src_endpoint.owner.name? == null
    and e.src_endpoint.owner.uid? == null).map(x => drop_null_fields(x)).where(x => not x.flatten().is_empty())
  if $ocsf.unmapped.evidences.is_empty() {
    drop $ocsf.unmapped.evidences
  }
  $ocsf.evidences = $ocsf.evidences.map(e => {
    ...e,
    src_endpoint: {
      ...e.src_endpoint,
      owner: e.src_endpoint.owner? if e.src_endpoint.owner?.account? != null
        or e.src_endpoint.owner?.name? != null
        or e.src_endpoint.owner?.uid? != null else null
    } if e.src_endpoint? != null else null
  })
}
if (
  $ocsf.user? != null
  and $ocsf.user?.account? == null
  and $ocsf.user?.name? == null
  and $ocsf.user?.uid? == null
) {
  if not drop_null_fields($ocsf.user).flatten().is_empty() {
    $ocsf.unmapped.user = {
      ...drop_null_fields($ocsf.user),
      ...$ocsf.unmapped?.user?,
    }
  }
  drop $ocsf.user
}
if (
  $ocsf.entity?.policy? != null
  and $ocsf.entity.policy.name? == null
  and $ocsf.entity.policy.type? == null
  and $ocsf.entity.policy.uid? == null
) {
  $ocsf.entity.policy.name = $ocsf.entity.name?
  $ocsf.entity.policy.uid = $ocsf.entity.uid?
}
if $ocsf.class_uid in [3001, 3002] and $ocsf.user? == null {
  // Keep source facts when the selected class cannot be identified.
  $ocsf = {
    ...drop_null_fields({
      time: $ocsf.time,
      metadata: {...$ocsf.metadata, profiles: []},
      message: $ocsf.message?,
      raw_data: $ocsf.raw_data?,
      raw_data_size: $ocsf.raw_data_size?,
      severity_id: $ocsf.severity_id,
      status_id: $ocsf.status_id?,
      status_code: $ocsf.status_code?,
      status_detail: $ocsf.status_detail?,
      start_time: $ocsf.start_time?,
      end_time: $ocsf.end_time?,
      duration: $ocsf.duration?,
      count: $ocsf.count?,
    }),
    category_uid: 0, class_uid: 0, activity_id: 0, type_uid: 0,
    unmapped: {
      ...$ocsf.unmapped?,
      ...$ocsf.entries().where(entry => entry.value != null and entry.key not in [
        "time", "metadata", "message", "raw_data",
        "raw_data_size", "severity_id", "status_id", "status_code",
        "status_detail", "start_time", "end_time", "duration",
        "count", "category_uid", "category_name", "class_uid",
        "class_name", "activity_id", "activity_name", "type_uid",
        "type_name", "severity", "unmapped",
      ]).map(entry => {
        key: entry.key,
        value: {...entry.value, ...($ocsf.unmapped? else {}).get(entry.key, null)}
          if type_kind(entry.value) == "record" and type_kind(($ocsf.unmapped? else {}).get(entry.key, null)) == "record"
          else ($ocsf.unmapped? else {}).get(entry.key, entry.value),
      }).collect_record().drop_null_fields(),
    },
  }
  @name = "ocsf.base_event"
}
