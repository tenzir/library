---
description: Maps a structured Okta System Log event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---


$ocsf = {}

// Raw System Log input must pass through okta::read before OCSF mapping.

let $severity_map = {
  HIGH: 4,
  MEDIUM: 3,
  LOW: 2,
}
$ocsf.severity_id = $severity_map[$event.debugContext.debugData.risk?]? else 1
drop $event.debugContext.debugData.risk?

$ocsf.time = time(move $event.published)
$ocsf.message = move $event.displayMessage

$ocsf.metadata = {
  event_code: move $event.eventType,
  log_provider: "Okta",
  product: {
    name: "Okta",
    vendor_name: "Okta",
    version: move $event.version?,
  },
  profiles: ["cloud"],
  version: "1.9.0",
  loggers: [{event_uid: move $event.uuid?}],
}

$ocsf.http_request = {
  uid: move $event.debugContext.debugData.requestId?,
  url: {
    path: move $event.debugContext.debugData.url?,
    hostname: move $event.debugContext.debugData.authnRequestId? else move $event.debugContext.debugData.origin?,
  },
}
if $event.client.userAgent? != null {
  $ocsf.http_request.user_agent = move $event.client.userAgent.rawUserAgent?
}

$ocsf.cloud = {
  provider: "AWS" if $event.source?.contains("aws.partner") else "Other",
  region: move $event.region?,
}

let $actor_type_id = {
  User: 1,
  SystemPrincipal: 2,
}

$ocsf.actor = {
  user: {
    uid: move $event.actor.id?,
    name: $event.actor.alternateId?.split("@")[0]?,
    domain: $event.actor.alternateId?.split("@")[1]?,
    full_name: string(move $event.actor.displayName?),
    email_addr: move $event.actor.alternateId?,
    type_id: $actor_type_id[$event.actor.type?]? else 99,
  },
  session: {
    uid: $event.authenticationContext.externalSessionId?,
    uid_alt: move $event.authenticationContext.rootSessionId?,
  },
}
drop $event.actor?

let $device_type_map = {
  Computer: "Desktop",
  Mobile: "Mobile",
}

$ocsf.src_endpoint = {
  ip: move $event.client.ipAddress?,
  uid: move $event.client.id?,
  type: $device_type_map[move $event.client.device?]?,
  domain: move $event.securityContext.domain?,
  autonomous_system: {
    number: move $event.securityContext.asNumber?,
  },
  owner: {
    org: {
      name: move $event.securityContext.asOrg?,
    },
  },
}
$ocsf.src_endpoint.location.isp = move $event.securityContext.isp?
if $event.client.geographicalContext? != null {
  $ocsf.src_endpoint.location = {
    ...$ocsf.src_endpoint.location?,
    city: move $event.client.geographicalContext.city?,
    country: move $event.client.geographicalContext.country?,
    postal_code: move $event.client.geographicalContext.postalCode?,
    lat: move $event.client.geographicalContext.geolocation?.lat?,
    long: move $event.client.geographicalContext.geolocation?.lon?,
  }
}

// Okta reports "Mac OS X (iPhone)" for iPhones, so check for mobile OS
// indicators before the generic "Mac" match.
let $os_type_map = {
  iOS: {name: "iOS", type_id: 301},
  iPadOS: {name: "iPadOS", type_id: 302},
  Android: {name: "Android", type_id: 201},
  Windows: {name: "Windows", type_id: 100},
  macOS: {name: "macOS", type_id: 300},
  Linux: {name: "Linux", type_id: 200},
  ChromeOS: {name: "ChromeOS", type: "ChromeOS", type_id: 99},
}
if $event.client.userAgent?.os? != null {
  if $event.client.userAgent.os.contains("iPhone") or $event.client.userAgent.os == "iOS" {
    $ocsf.src_endpoint.os = $os_type_map["iOS"]
  } else if $event.client.userAgent.os.contains("iPad") or $event.client.userAgent.os == "iPadOS" {
    $ocsf.src_endpoint.os = $os_type_map["iPadOS"]
  } else if $event.client.userAgent.os.contains("Android") {
    $ocsf.src_endpoint.os = $os_type_map["Android"]
  } else if $event.client.userAgent.os.contains("Windows") {
    $ocsf.src_endpoint.os = $os_type_map["Windows"]
  } else if $event.client.userAgent.os.contains("Mac") {
    $ocsf.src_endpoint.os = $os_type_map["macOS"]
  } else if $event.client.userAgent.os.contains("Linux") or $event.client.userAgent.os.contains("Ubuntu") {
    $ocsf.src_endpoint.os = $os_type_map["Linux"]
  } else if $event.client.userAgent.os.contains("ChromeOS") or
            $event.client.userAgent.os.contains("Chrome OS") or
            $event.client.userAgent.os.contains("CrOS") {
    $ocsf.src_endpoint.os = $os_type_map["ChromeOS"]
  }
}

match $ocsf.metadata.event_code {
  "policy.evaluate_sign_on" |
  "system.push.send_factor_verify_push" |
  "application.policy.sign_on.deny_access" => {
    okta::ocsf::event::authentication $event, $ocsf
  }
  "user.account.report_suspicious_activity_by_enduser" |
  "security.threat.detected" |
  "user.mfa.attempt_bypass" |
  "security.protected_action.attempt" => {
    okta::ocsf::event::detection_finding $event, $ocsf
  }
  "application.configuration.read_client_secret" => {
    okta::ocsf::event::api_activity $event, $ocsf
  }
  _ => {
    match $ocsf.metadata.event_code.split(".")[0]? {
      "user" => {
        match $ocsf.metadata.event_code.split(".")[1]? {
          "session" | "authentication" => {
            okta::ocsf::event::authentication $event, $ocsf
          }
          "lifecycle" | "account" => {
            okta::ocsf::event::account_change $event, $ocsf
          }
          "mfa" => {
            match $ocsf.metadata.event_code.split(".")[2]? {
              "factor" => {
                okta::ocsf::event::account_change $event, $ocsf
              }
              _ => {
                okta::ocsf::base $event, $ocsf
              }
            }
          }
          _ => {
            okta::ocsf::base $event, $ocsf
          }
        }
      }
      "app" => {
        match $ocsf.metadata.event_code.split(".")[1]? {
          "generic" => {
            match $ocsf.metadata.event_code.split(".")[2]? {
              "unauth_app_access_attempt" => {
                okta::ocsf::event::authentication $event, $ocsf
              }
              _ => {
                okta::ocsf::base $event, $ocsf
              }
            }
          }
          "oauth2" => {
            match $ocsf.metadata.event_code.split(".")[2]? {
              "authorize" => {
                okta::ocsf::event::authentication $event, $ocsf
              }
              "token" | "client" | "credentials" => {
                okta::ocsf::event::api_activity $event, $ocsf
              }
              _ => {
                okta::ocsf::base $event, $ocsf
              }
            }
          }
          _ => {
            okta::ocsf::base $event, $ocsf
          }
        }
      }
      "system" => {
        match $ocsf.metadata.event_code.split(".")[1]? {
          "api_token" | "idp" | "log_stream" => {
            okta::ocsf::event::api_activity $event, $ocsf
          }
          _ => {
            okta::ocsf::base $event, $ocsf
          }
        }
      }
      "group" => {
        okta::ocsf::event::group_management $event, $ocsf
      }
      "workflows" => {
        okta::ocsf::event::api_activity $event, $ocsf
      }
      "application" | "policy" | "zone" | "device" | "directory" => {
        okta::ocsf::event::entity_management $event, $ocsf
      }
      "security" => {
        match $ocsf.metadata.event_code.split(".")[1]? {
          "trusted_origin" => {
            okta::ocsf::event::entity_management $event, $ocsf
          }
          _ => {
            okta::ocsf::base $event, $ocsf
          }
        }
      }
      _ => {
        okta::ocsf::base $event, $ocsf
      }
    }
  }
}

drop $event.severity?
drop $event.legacyEventType?
drop $event.debugContext?.debugData?.threatSuspected?
drop $event.debugContext?.debugData?.responseTime?
drop $event.target?
drop $event.client?
drop $event.securityContext?
drop $event.request?
drop $event.transaction?
drop $event.authenticationContext?

$ocsf.unmapped = move $event
