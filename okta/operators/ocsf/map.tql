---
description: Maps a structured Okta System Log event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

// Raw System Log input must pass through `okta::read` before OCSF mapping.

$ocsf = {
  metadata: {
    version: "1.9.0",
    product: {
      vendor_name: "Okta",
      name: "Okta",
    },
    log_name: "System Log",
    profiles: ["cloud"],
  },
  cloud: {
    provider: "Okta",
  },
}
$ocsf.metadata.event_code = move $event.eventType?
$ocsf.metadata.original_event_uid = move $event.uuid?
$ocsf.metadata.log_version = move $event.version?
// The transaction ties together the events of one request or job.
$ocsf.metadata.correlation_uid = move $event.transaction?.id?
$ocsf.message = move $event.displayMessage?

// A time that `okta::read` could not parse stays in `unmapped`.
if type_kind($event.published?) == "time" {
  $ocsf.time = move $event.published
}

// The severity of Okta is the level at which it logs the event.
let $severity_ids = {
  DEBUG: 1,
  INFO: 1,
  WARN: 3,
  ERROR: 4,
}
$ocsf.severity_id = $severity_ids[$event.severity?]? else 0
$ocsf.metadata.log_level = move $event.severity?

// The event type tells the class and the activity. Okta adds event types with
// every release; the ones that the table does not list become a Base Event.
$event._type = okta::$event_types[$ocsf.metadata.event_code?]?
$ocsf.class_uid = $event._type?.class_uid? else 0
$ocsf.activity_id = $event._type?.activity_id? else 0
if $event._type?.activity_name? != null {
  $ocsf.activity_name = $event._type.activity_name
}
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
drop $event._type

// The result tells how the activity ended. ALLOW, DENY, and CHALLENGE are the
// decisions of a policy, so they also are the action of a security control. A
// challenge asks for another factor and neither allows nor denies yet.
match $event.outcome?.result? {
  "SUCCESS" => {
    $ocsf.status_id = 1
  }
  "FAILURE" => {
    $ocsf.status_id = 2
  }
  "ALLOW" => {
    $ocsf.status_id = 1
    $ocsf.action_id = 1
    $ocsf.disposition_id = 1
  }
  "DENY" => {
    $ocsf.status_id = 2
    $ocsf.action_id = 2
    $ocsf.disposition_id = 2
  }
  "CHALLENGE" => {
    $ocsf.status_id = 99
    $ocsf.status = $event.outcome.result
    $ocsf.action_id = 99
    $ocsf.action = $event.outcome.result
    $ocsf.disposition_id = 99
    $ocsf.disposition = $event.outcome.result
  }
  _ => {
    // SKIPPED, DEFERRED, and the like are neither a success nor a failure.
    if $event.outcome?.result? != null {
      $ocsf.status_id = 99
      $ocsf.status = $event.outcome.result
    } else {
      $ocsf.status_id = 0
    }
  }
}
$ocsf.status_detail = move $event.outcome?.reason?
drop $event.outcome?.result?

// Debug data that is no record stays in `unmapped` as it is.
if $event.debugContext?.debugData? != null and type_kind($event.debugContext.debugData) != "record" {
  $event._debug_data = move $event.debugContext.debugData
}

// Okta rates the risk of a request as LOW, MEDIUM, or HIGH and names its
// reasons. Older events carry both in one string such as
// `{level=HIGH, reasons=Anomalous Location}`.
let $risk_level_ids = {
  LOW: 1,
  MEDIUM: 2,
  HIGH: 3,
}
if $risk_level_ids[$event.securityContext?.risk?.level?]? != null {
  $ocsf.risk_level_id = $risk_level_ids[move $event.securityContext.risk.level]
  if $event.securityContext.risk.reasons? != null {
    $ocsf.risk_details = (move $event.securityContext.risk.reasons).join(", ")
  }
} else if $event.debugContext?.debugData?.risk?.match_regex("^\\{level=(LOW|MEDIUM|HIGH)(, reasons=.*)?\\}$") {
  $event._risk = $event.debugContext.debugData.risk.parse_grok("\\{level=%{WORD:level}(, reasons=%{GREEDYDATA:reasons})?\\}", raw=true)
  $ocsf.risk_level_id = $risk_level_ids[$event._risk.level]
  $ocsf.risk_details = $event._risk.reasons?
  drop $event._risk, $event.debugContext.debugData.risk
}
// ThreatInsight marks the requests that it suspects.
if $event.debugContext?.debugData?.threatSuspected?.string() == "true" {
  $ocsf.is_alert = true
}

// A Base Event has no place for the actor, the client, and the request, so
// they stay in `unmapped` as Okta wrote them.
if $ocsf.class_uid != 0 {
  // The actor is who performed the action: a user, the Okta system, or an
  // app. Other actors, such as the IP address of a detected threat, are no
  // OCSF actor.
  if $event.actor?.id? != null or $event.actor?.alternateId? != null {
    if $event.actor.type? == "User" or $event.actor.type? == "SystemPrincipal" {
      $ocsf.actor.user = {
        uid: move $event.actor.id?,
        name: $event.actor.alternateId?.split("@")[0]?,
        domain: $event.actor.alternateId?.split("@")[1]?,
        email_addr: $event.actor.alternateId? if $event.actor.alternateId?.match_regex("@") else null,
        full_name: move $event.actor.displayName?,
        type_id: 3 if $event.actor.type == "SystemPrincipal" else 1,
      }
      drop $event.actor.alternateId?, $event.actor.type
    } else if $event.actor.type? == "PublicClientApp" or $event.actor.type? == "AppInstance" {
      // The Okta type of the app stays in `unmapped`.
      $ocsf.actor.application = {
        uid: move $event.actor.id?,
        name: move $event.actor.displayName?,
      }
    }
  }
  // An authentication event is about the Okta session itself, any other
  // event happens within the session of the actor.
  if $event.authenticationContext?.externalSessionId? != null {
    if $ocsf.class_uid == 3002 {
      $ocsf.session.uid = move $event.authenticationContext.externalSessionId
    } else {
      $ocsf.actor.session.uid = move $event.authenticationContext.externalSessionId
    }
  }
  // A request with an API token names the token.
  if $event.transaction?.detail?.requestApiTokenId? != null {
    $ocsf.actor.session.credential_uid = move $event.transaction.detail.requestApiTokenId
  }

  // Without a proxy, the IP chain only repeats the client.
  if $event.request?.ipChain? == [] {
    drop $event.request.ipChain
  } else if $event.request?.ipChain?.length() == 1 and
            $event.request.ipChain[0].ip? == $event.client?.ipAddress?.string() and
            $event.request.ipChain[0].geographicalContext? == $event.client?.geographicalContext? {
    drop $event.request.ipChain
  }

  // The client is where the request came from. The device is the one that
  // Okta Verify registered on the client.
  if type_kind($event.client?.ipAddress?) == "ip" {
    $ocsf.src_endpoint.ip = move $event.client.ipAddress
  }
  if $event.device?.id? != null {
    $ocsf.src_endpoint.uid = move $event.device.id
    $ocsf.src_endpoint.name = move $event.device.name?
  }
  if $ocsf.src_endpoint? != null {
    $ocsf.src_endpoint.zone = move $event.client?.zone?
    $ocsf.src_endpoint.domain = move $event.securityContext?.domain?
    $ocsf.src_endpoint.isp = move $event.securityContext?.isp?
    if $event.securityContext?.asNumber? != null or $event.securityContext?.asOrg? != null {
      $ocsf.src_endpoint.autonomous_system = {
        number: move $event.securityContext.asNumber?,
        name: move $event.securityContext.asOrg?,
      }
    }
    // Okta writes the full names of the country and the state, where OCSF
    // asks for their ISO codes, so both stay in `unmapped`.
    if $event.client?.geographicalContext?.city? != null or $event.client?.geographicalContext?.postalCode? != null {
      $ocsf.src_endpoint.location = {
        city: move $event.client.geographicalContext.city?,
        postal_code: move $event.client.geographicalContext.postalCode?,
        lat: float($event.client.geographicalContext.geolocation?.lat?),
        long: float($event.client.geographicalContext.geolocation?.lon?),
      }
      drop $event.client.geographicalContext.geolocation?.lat?, $event.client.geographicalContext.geolocation?.lon?
    }
    // Okta tells a phone and a tablet from a computer, which can be a
    // desktop, a laptop, or a server.
    if $event.client?.device? == "Mobile" {
      $ocsf.src_endpoint.type_id = 5
      drop $event.client.device
    } else if $event.client?.device? == "Tablet" {
      $ocsf.src_endpoint.type_id = 4
      drop $event.client.device
    } else if $event.client?.device? != null {
      $ocsf.src_endpoint.type_id = 99
      $ocsf.src_endpoint.type = move $event.client.device
    }
    // The user agent names the operating system, such as `Windows 10` or
    // `Mac OS X (iPhone)`, and a registered device its platform and version.
    if $event.client?.userAgent?.os? != null {
      $ocsf.src_endpoint.os.name = move $event.client.userAgent.os
    } else if $event.device?.os_platform? != null {
      $ocsf.src_endpoint.os.name = move $event.device.os_platform
    }
    if $ocsf.src_endpoint.os? != null {
      $event._os = $ocsf.src_endpoint.os.name.to_lower()
      $ocsf.src_endpoint.os.type_id = (
        301 if $event._os.match_regex("iphone|ios")
        else 302 if $event._os.match_regex("ipad")
        else 201 if $event._os.match_regex("android")
        else 100 if $event._os.match_regex("windows")
        else 300 if $event._os.match_regex("mac|osx")
        else 200 if $event._os.match_regex("linux|ubuntu")
        else 0
      )
      $ocsf.src_endpoint.os.version = move $event.device?.os_version?
      drop $event._os
    }
    // The first entry of the IP chain is the client, the others are the
    // proxies that forwarded the request.
    if ($event.request?.ipChain?.length() else 0) > 1 {
      $ocsf.src_endpoint.intermediate_ips = $event.request.ipChain.slice(begin=1).map(x => x.ip?.ip())
    }
  }

  // The HTTP request that led to the event. Okta writes its URL once with
  // and once without the query string.
  if $event.debugContext?.debugData?.requestId? != null or
     $event.debugContext?.debugData?.url? != null or
     $event.client?.userAgent?.rawUserAgent? != null {
    $ocsf.http_request = {
      uid: move $event.debugContext?.debugData?.requestId?,
      user_agent: move $event.client?.userAgent?.rawUserAgent?,
    }
    if $event.debugContext?.debugData?.url? != null {
      $ocsf.http_request.url.path = $event.debugContext.debugData.url.split("?", max=1)[0]
      if $event.debugContext.debugData.url.split("?", max=1)[1]? != "" {
        $ocsf.http_request.url.query_string = $event.debugContext.debugData.url.split("?", max=1)[1]?
      }
      if $event.debugContext.debugData.requestUri? == $ocsf.http_request.url.path {
        drop $event.debugContext.debugData.requestUri
      }
      drop $event.debugContext.debugData.url
    }
  }
}

match $ocsf.class_uid {
  3002 => {
    okta::ocsf::event::authentication $event, $ocsf
  }
  3007 => {
    okta::ocsf::event::user_management $event, $ocsf
  }
  3006 => {
    okta::ocsf::event::group_management $event, $ocsf
  }
  3004 => {
    okta::ocsf::event::entity_management $event, $ocsf
  }
  2004 => {
    okta::ocsf::event::detection_finding $event, $ocsf
  }
  6003 => {
    okta::ocsf::event::api_activity $event, $ocsf
  }
  _ => {
    okta::ocsf::base $event, $ocsf
  }
}

// The decision of a policy and the risk of a request come from the security
// controls of Okta.
if $ocsf.action_id? != null or $ocsf.policy? != null or
   ($ocsf.class_uid != 2004 and ($ocsf.risk_level_id? != null or $ocsf.is_alert? != null)) {
  $ocsf.metadata.profiles = ["cloud", "security_control"]
}

if $event._debug_data? != null {
  $event.debugContext.debugData = move $event._debug_data
}

// A target that the class mapped in full leaves `unmapped`. A target with
// further details stays as a whole.
if $event._mapped? != null and $event.target? != null {
  $event.target = $event.target.where(t => t not in $event._mapped or t.detailEntry? != null or t.changeDetails? != null)
}
drop $event._mapped?
if $event.target? == [] {
  drop $event.target
}
// The authentication step is unused and always 0.
drop $event.authenticationContext?.authenticationStep?

// What has no place in OCSF stays in `unmapped`, without the nulls and the
// records that the mapping emptied.
$ocsf = drop_null_fields($ocsf)
$event = drop_null_fields($event)
replace $event, what={}, with=null
$event = drop_null_fields($event)
replace $event, what={}, with=null
$event = drop_null_fields($event)
if $event != {} {
  $ocsf.unmapped = $event
}
