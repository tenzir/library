---
description: Maps a structured Okta System Log event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---


$ocsf = {}

// Raw System Log input must pass through okta::read before OCSF mapping.

let $severity_map = {
  HIGH: 4,
  MEDIUM: 3,
  LOW: 2,
}
$ocsf.severity_id = $severity_map[$event.debugContext?.debugData?.risk?]? else 1
if $event.debugContext?.debugData?.risk? in ["HIGH", "MEDIUM", "LOW"] {
  drop $event.debugContext?.debugData?.risk
}

$ocsf.time = time(move $event.published)
$ocsf.message = move $event.displayMessage

$ocsf.metadata = {
  event_code: move $event.eventType,
  log_provider: "Okta",
  log_level: move $event.severity?,
  product: {
    name: "Okta",
    vendor_name: "Okta",
    version: move $event.version?,
  },
  profiles: ["cloud"],
  version: "1.9.0",
  loggers: [{
    name: "Okta",
    event_uid: move $event.uuid?,
  }],
}

// Select the source class before consuming class-specific context.
match $ocsf.metadata.event_code {
  "policy.evaluate_sign_on" |
  "system.push.send_factor_verify_push" |
  "application.policy.sign_on.deny_access" => {
    $ocsf.class_uid = 3002
  }
  "user.account.report_suspicious_activity_by_enduser" |
  "security.threat.detected" |
  "user.mfa.attempt_bypass" |
  "security.protected_action.attempt" => {
    $ocsf.class_uid = 2004
  }
  "application.configuration.read_client_secret" => {
    $ocsf.class_uid = 6003
  }
  _ => {
    match $ocsf.metadata.event_code.split(".")[0]? {
      "user" => {
        match $ocsf.metadata.event_code.split(".")[1]? {
          "session" | "authentication" => {
            $ocsf.class_uid = 3002
          }
          "lifecycle" | "account" => {
            $ocsf.class_uid = 3001
          }
          "mfa" => {
            match $ocsf.metadata.event_code.split(".")[2]? {
              "factor" => {
                $ocsf.class_uid = 3001
              }
              _ => {
                $ocsf.class_uid = 0
              }
            }
          }
          _ => {
            $ocsf.class_uid = 0
          }
        }
      }
      "app" => {
        match $ocsf.metadata.event_code.split(".")[1]? {
          "generic" => {
            match $ocsf.metadata.event_code.split(".")[2]? {
              "unauth_app_access_attempt" => {
                $ocsf.class_uid = 3002
              }
              _ => {
                $ocsf.class_uid = 0
              }
            }
          }
          "oauth2" => {
            match $ocsf.metadata.event_code.split(".")[2]? {
              "authorize" => {
                $ocsf.class_uid = 3002
              }
              "token" | "client" | "credentials" => {
                $ocsf.class_uid = 6003
              }
              _ => {
                $ocsf.class_uid = 0
              }
            }
          }
          _ => {
            $ocsf.class_uid = 0
          }
        }
      }
      "system" => {
        match $ocsf.metadata.event_code.split(".")[1]? {
          "api_token" | "idp" | "log_stream" => {
            $ocsf.class_uid = 6003
          }
          _ => {
            $ocsf.class_uid = 0
          }
        }
      }
      "group" => {
        $ocsf.class_uid = 3006
      }
      "workflows" => {
        $ocsf.class_uid = 6003
      }
      "application" | "policy" | "zone" | "device" | "directory" => {
        $ocsf.class_uid = 3004
      }
      "security" => {
        match $ocsf.metadata.event_code.split(".")[1]? {
          "trusted_origin" => {
            $ocsf.class_uid = 3004
          }
          _ => {
            $ocsf.class_uid = 0
          }
        }
      }
      _ => {
        $ocsf.class_uid = 0
      }
    }
  }
}

$ocsf.cloud = {
  provider: "AWS" if $event.source?.search("aws.partner") else "Other",
  region: move $event.region?,
}

// Only construct objects supported by the selected class. Base Events keep
// these attributes in their original source shape under unmapped.
if $ocsf.class_uid != 0 {
  if $event.debugContext?.debugData?.requestId? != null or
     $event.debugContext?.debugData?.url? != null or
     $event.client?.userAgent?.rawUserAgent? != null {
    $ocsf.http_request = {
      uid: move $event.debugContext?.debugData?.requestId?,
      user_agent: move $event.client?.userAgent?.rawUserAgent?,
    }
    if $event.debugContext?.debugData?.url? != null {
      $ocsf.http_request.url = {path: move $event.debugContext?.debugData?.url}
    }
  }

  let $actor_type_id = {User: 1, SystemPrincipal: 3}
  if $event.actor?.type? in ["User", "SystemPrincipal"] and
     ($event.actor?.id? != null or $event.actor?.alternateId? != null) {
    $ocsf.actor.user = {
      uid: move $event.actor?.id?,
      name: $event.actor?.alternateId?.split("@")[0]?,
      domain: $event.actor?.alternateId?.split("@")[1]?,
      full_name: string(move $event.actor?.displayName?),
      email_addr: move $event.actor?.alternateId?,
      type_id: $actor_type_id[move $event.actor?.type],
    }
  } else if $event.actor?.type? in ["PublicClientApp", "PublicClientAppEntity"] and
            ($event.actor?.id? != null or $event.actor?.displayName? != null) {
    $ocsf.actor.app_uid = move $event.actor?.id?
    $ocsf.actor.app_name = move $event.actor?.displayName?
    drop $event.actor?.type
  }
  if drop_null_fields($event.actor?).is_empty() {
    drop $event.actor
  }
  if $event.authenticationContext?.externalSessionId? != null or
     $event.authenticationContext?.rootSessionId? != null {
    $ocsf.actor.session = {
      uid: move $event.authenticationContext?.externalSessionId?,
      uid_alt: move $event.authenticationContext?.rootSessionId?,
    }
  }

  if $event.client?.ipAddress? != null or $event.client?.id? != null or
     $event.securityContext?.domain? != null or
     $event.device?.id? != null or $event.device?.name? != null {
    $ocsf.src_endpoint = {
      ip: move $event.client?.ipAddress?,
      uid: move $event.client?.id?,
      domain: move $event.securityContext?.domain?,
    }
    if $event.client?.device? == "Mobile" {
      $ocsf.src_endpoint.type_id = 5
      drop $event.client?.device
    } else if $event.client?.device? == "Computer" {
      // Computer does not distinguish a desktop, laptop, or server.
      $ocsf.src_endpoint.type_id = 0
    }
    if $event.securityContext?.asNumber? != null {
      $ocsf.src_endpoint.autonomous_system = {
        number: move $event.securityContext?.asNumber,
      }
    }
    if $event.client?.geographicalContext?.city? != null or
       $event.client?.geographicalContext?.country? != null or
       $event.client?.geographicalContext?.postalCode? != null {
      $ocsf.src_endpoint.location = {
        city: move $event.client?.geographicalContext.city?,
        country: move $event.client?.geographicalContext.country?,
        postal_code: move $event.client?.geographicalContext.postalCode?,
        lat: move $event.client?.geographicalContext.geolocation?.lat?,
        long: move $event.client?.geographicalContext.geolocation?.lon?,
      }
      if drop_null_fields($event.client?.geographicalContext.geolocation?).is_empty() {
        drop $event.client?.geographicalContext.geolocation
      }
      if drop_null_fields($event.client?.geographicalContext).is_empty() {
        drop $event.client?.geographicalContext
      }
    }
    let $os_type_map = {
      iOS: {
        name: "iOS",
        type_id: 301,
      },
      iPadOS: {
        name: "iPadOS",
        type_id: 302,
      },
      Android: {
        name: "Android",
        type_id: 201,
      },
      Windows: {
        name: "Windows",
        type_id: 100,
      },
      macOS: {
        name: "macOS",
        type_id: 300,
      },
      Linux: {
        name: "Linux",
        type_id: 200,
      },
      ChromeOS: {
        name: "ChromeOS",
        type: "ChromeOS",
        type_id: 99,
      },
    }
    if $event.client?.userAgent?.os? != null {
      if $event.client?.userAgent?.os.search("iPhone") or $event.client?.userAgent?.os == "iOS" {
        $ocsf.src_endpoint.os = $os_type_map["iOS"]
      } else if $event.client?.userAgent?.os.search("iPad") or $event.client?.userAgent?.os == "iPadOS" {
        $ocsf.src_endpoint.os = $os_type_map["iPadOS"]
      } else if $event.client?.userAgent?.os.search("Android") {
        $ocsf.src_endpoint.os = $os_type_map["Android"]
      } else if $event.client?.userAgent?.os.search("Windows") {
        $ocsf.src_endpoint.os = $os_type_map["Windows"]
      } else if $event.client?.userAgent?.os.search("Mac") {
        $ocsf.src_endpoint.os = $os_type_map["macOS"]
      } else if $event.client?.userAgent?.os.search("Linux") or $event.client?.userAgent?.os.search("Ubuntu") {
        $ocsf.src_endpoint.os = $os_type_map["Linux"]
      } else if $event.client?.userAgent?.os.search("ChromeOS") or
                $event.client?.userAgent?.os.search("Chrome OS") or
                $event.client?.userAgent?.os.search("CrOS") {
        $ocsf.src_endpoint.os = $os_type_map["ChromeOS"]
      }
    }
    if $event.device? != null {
      if $ocsf.src_endpoint.uid? == null {
        $ocsf.src_endpoint.uid = move $event.device.id?
      }
      $ocsf.src_endpoint.name = move $event.device.name?
      if $event.device.osVersion? != null {
        if $ocsf.src_endpoint.os? == null {
          $ocsf.src_endpoint.os = {type_id: 0}
        }
        $ocsf.src_endpoint.os.version = move $event.device.osVersion
      }
    }
  }
}

match $ocsf.class_uid {
  3002 => { okta::ocsf::event::authentication $event, $ocsf }
  2004 => { okta::ocsf::event::detection_finding $event, $ocsf }
  6003 => { okta::ocsf::event::api_activity $event, $ocsf }
  3001 => { okta::ocsf::event::account_change $event, $ocsf }
  3006 => { okta::ocsf::event::group_management $event, $ocsf }
  3004 => { okta::ocsf::event::entity_management $event, $ocsf }
  _ => { okta::ocsf::base $event, $ocsf }
}


$event = drop_null_fields($event)
if $event.client?.is_empty() == true {
  drop $event.client
}
$ocsf.unmapped = move $event
