---
description: "Okta → OCSF Base Event (0)"
args:
  positional:
    - name: event
      description: The field that holds the source event.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// --- OCSF: classification attributes ----------

$ocsf.activity_id = 0
$ocsf.category_uid = 0
$ocsf.class_uid = 0
$ocsf.severity_id = 0
$ocsf.type_uid = 0

$event._actor = move $ocsf.actor?
$event._http_request = move $ocsf.http_request?
$event._src_endpoint = move $ocsf.src_endpoint?

@name = "ocsf.base_event"
