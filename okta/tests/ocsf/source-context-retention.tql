from_file f"{env("TENZIR_INPUTS")}/system-log.ndjson" {
  okta::read
}
where eventType == "system.email.delivery"
head 1
client.geographicalContext = {geolocation: {lat: 47.37, lon: 8.55}}
this = {source: this, ocsf: {}}
okta::ocsf::map source, ocsf
assert ocsf.unmapped.securityContext.isp == "Example ISP"
assert ocsf.unmapped.securityContext.asOrg == "Example Org"
assert ocsf.unmapped.client.geographicalContext.geolocation == {lat: 47.37, lon: 8.55}
select unmapped=ocsf.unmapped
