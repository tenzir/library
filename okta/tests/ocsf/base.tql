// Synthetic Okta System Log events; every value is invented. The structure
// follows the Okta System Log API LogEvent object.
// https://developer.okta.com/docs/reference/api/system-log/
from_file env("TENZIR_INPUT") {
  okta::read
}
this = {source: this, ocsf: {}}
okta::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
drop time
