from_file f"{env("TENZIR_INPUTS")}/system-log.ndjson" {
  okta::read
}
where eventType == "user.lifecycle.create"
// These source attributes are optional; preserve the reported NewUser target.
drop client, securityContext.asNumber, authenticationContext
source = this
okta::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select class_uid, user, actor, src_endpoint, session?
drop_null_fields
