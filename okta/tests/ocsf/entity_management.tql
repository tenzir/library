from_file f"{env("TENZIR_INPUTS")}/system-log.ndjson" {
  okta::read
}
where eventType == "policy.lifecycle.create" or eventType == "application.user_membership.add" or eventType == "device.enrollment.create"
this = {source: this, ocsf: {}}
okta::ocsf::map source, ocsf
this = ocsf
ocsf_cast
sort time
