from_file f"{env("TENZIR_INPUTS")}/system-log.ndjson" {
  okta::read
}
where eventType == "user.session.start"
source = this
okta::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
select url=http_request.url,
       authnRequestId=unmapped.debugContext.debugData.authnRequestId,
       origin=unmapped.debugContext.debugData.origin
drop_null_fields
