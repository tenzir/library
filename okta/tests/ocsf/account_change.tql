---
pre-compare: sort
---

from_file f"{env("TENZIR_INPUTS")}/system-log.ndjson" {
  okta::read
}
where eventType == "user.lifecycle.create" or eventType == "user.account.lock" or eventType == "user.account.update_password"
this = {source: this, ocsf: {}}
okta::ocsf::map source, ocsf
this = ocsf
ocsf_cast
