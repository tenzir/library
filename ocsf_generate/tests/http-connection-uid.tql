// Web servers log no connection ID, so their events have no connection_info.uid
// field; the firewall and the network sensors have one.
ocsf_generate::generate count=512, class_uid=4002, raw="none"
_web_server = metadata.product.name in ["nginx", "HTTP Server"]
assert connection_info.has("uid") != _web_server
assert not connection_info.has("uid") or connection_info.uid != null
summarize events=count()
