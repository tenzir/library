// Windows network logons (4624, 4625, 4634) have a null subject, so the event
// names only the target account and its NetBIOS domain, as the record does.
ocsf_generate::generate count=2048, class_uid=3002
where metadata.product.name == "Windows Security"
assert actor? == null
assert user.domain == "ACME"
_data = raw_data.parse_xml()[0].EventData.Data
assert _data.where(d => d["@Name"] == "TargetDomainName")[0]["#text"] == user.domain
_sid = _data.where(d => d["@Name"] == "TargetUserSid")[0]["#text"]
// A failed logon reports the null SID and comes in over SMB with NTLM.
assert (user.uid_alt? else "S-1-0-0") == _sid
assert (status_id == 2) == (auth_protocol == "NTLM")
assert dst_endpoint.port == (445 if auth_protocol == "NTLM" else 88)
// The access policy of the SSH bastion does not apply to the domain controller.
assert policy? == null
summarize logons=count()
assert logons > 1000
this = {windows_logons: "passed"}
