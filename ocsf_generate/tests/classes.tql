let $class_uids = ocsf_generate::$class_uids
ocsf_generate::generate count=32768, raw="none"
assert type_id(time) == type_id(now())
assert type_uid == class_uid * 100 + activity_id
assert class_uid in $class_uids
if class_uid == 4003 {
  if query_time? != null { assert type_id(query_time) == type_id(now()) }
  if response_time? != null { assert type_id(response_time) == type_id(now()) }
}
ocsf_cast
ocsf_derive
summarize events=count(), classes=count_distinct(class_uid)
