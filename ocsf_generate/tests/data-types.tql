// Inspect native values before JSON serialization erases their type information.
ocsf_generate::generate count=32768, raw="none"
_binary = null
if class_uid == 1012 {
  _binary = clipboard.contents[0].binary_data?
}
_types = [
  type_kind(this),
  type_kind(observables),
  type_kind(metadata.uid),
  type_kind(time),
  type_kind(severity_id),
  type_kind(unmapped.cache_hit?),
  type_kind(device?.location?.lat?),
  type_kind(src_endpoint?.ip?),
  type_kind(device?.subnet?),
  type_kind(unmapped.collector?.sequence?),
  type_kind(unmapped.collector?.latency?),
  type_kind(unmapped.collector?.note?),
  type_kind(_binary),
]
unroll _types
summarize native_types=count_distinct(_types)
assert native_types == 13
