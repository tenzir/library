let $start = 2026-10-01T00:00:00
ocsf_generate::generate_historical eps_office_hours=2, eps_off=1, start=$start, days=1, raw="none"
assert time >= $start and time < $start + 1d
_base = 1 if class_uid == 0
summarize events=count(), base_events=count(_base)
// The default share of base events is 35%; this sample stays within ±2%.
assert base_events > events * 0.33 and base_events < events * 0.37
this = {events: events, base_event_share: "passed"}
