ocsf_generate::generate count=4096, raw="kv"
_source = raw_data.parse_kv(unflatten_separator=".")
assert string(_source.event_id) == metadata.uid
assert _source.product == metadata.product.name
assert _source.message == message
assert int(_source.activity) == activity_id
assert int(_source.timestamp) == int(round(time.since_epoch().count_milliseconds()))
if class_uid != 0 {
  assert int(_source.status) == status_id
  assert string(_source.extra.observed_host) == string(unmapped.observed_host)
} else {
  assert int(_source.status?) == status_id?
}
if class_uid == 4002 {
  assert _source.url == http_request.url.url_string
}
summarize events=count()
