// UTC office hours run daily from 08:00 inclusive to 17:00 exclusive.
// These settings generate 1,134,000,000 events. Output is not paced in real time.
ocsf_generate::generate_historical eps_office_hours=1000, eps_off=100,
  start=now() - 30d, days=30
to_file "ocsf-historical.ndjson" {
  write_ndjson
}
