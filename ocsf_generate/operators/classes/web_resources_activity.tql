// OCSF 1.9.0: web_resources_activity; independently sampled source scenarios.
@name = "ocsf.web_resources_activity"
class_uid = 6001
category_uid = 6
ocsf_generate::internal::application_base
drop actor
let $randomization = ocsf_generate::$randomization
activity_id = [2, 1, 3, 8][_ctx.scenario]
_ctx.web_resource = {uid: f"document-{_ctx.user.uid}", name: "Team report", url_string: f"https://docs.acme.example/reports/{_ctx.user.uid}"}
if random() < $randomization.uri_probability {
  _ctx.web_resource.url_string = f"{_ctx.web_resource.url_string}?request_id={uuid()}"
}
web_resources = [_ctx.web_resource]
message = f"Web resource activity {activity_id} for {web_resources[0].url_string}"
_ctx.source.web_resource_uid = web_resources[0].uid
_ctx.source.web_resource_url = web_resources[0].url_string
