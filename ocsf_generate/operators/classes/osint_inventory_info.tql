// OCSF 1.9.0: osint_inventory_info; sampled source observations.
@name = "ocsf.osint_inventory_info"
class_uid = 5021
category_uid = 5
ocsf_generate::internal::discovery_base
metadata.profiles = ["host"]
metadata.product = {name: "Threat intelligence feed", vendor_name: "Acme"}
osint = [{type_id: 1, value: _ctx.service.ip, name: "Synthetic endpoint intelligence", confidence_id: 3, tlp: "CLEAR", created_time: time - 1d, vendor_name: "Acme"}]
message = f"Collected threat intelligence for {_ctx.service.ip}"
