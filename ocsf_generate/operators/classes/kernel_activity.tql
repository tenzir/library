// OCSF 1.9.0: kernel_activity; sampled source observations.
@name = "ocsf.kernel_activity"
class_uid = 1003
category_uid = 1
ocsf_generate::internal::coverage_system_base
activity_id = [1, 2, 3, 4][_ctx.scenario]
kernel = {name: ["openat", "execve", "connect", "bind"][_ctx.scenario], type_id: 2, is_system: true}
message = f"Kernel call {kernel.name} activity {activity_id} on {_ctx.host.hostname}"
