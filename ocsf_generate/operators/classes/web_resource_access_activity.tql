// OCSF 1.9.0: web_resource_access_activity; sampled source observations.
@name = "ocsf.web_resource_access_activity"
class_uid = 6004
category_uid = 6
ocsf_generate::internal::coverage_system_base
metadata.product = {name: "Nextcloud", vendor_name: "Nextcloud"}
activity_id = [1, 2, 3, 4][_ctx.scenario]
status_id = 1 if activity_id == 1 else 2
http_request = {http_method: "GET", url: {scheme: "https", hostname: "docs.acme.example", path: "/reports", url_string: "https://docs.acme.example/reports"}}
web_resources = [{uid: f"report-{_ctx.user.uid}", name: "Team report", url_string: http_request.url.url_string}]
message = f"Web resource access {activity_id} for {web_resources[0].name}"
