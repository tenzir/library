// OCSF 1.9.0: file_hosting_activity; independently sampled source scenarios.
@name = "ocsf.file_hosting"
class_uid = 6006
category_uid = 6
ocsf_generate::internal::application_base
let $files = ocsf_generate::$files
_ctx.file = $files[int(random() * $files.length())]
activity_id = [2, 1, 12, 4][_ctx.scenario]
file = {name: _ctx.file.name, path: f"/team-documents/{_ctx.file.name}", type_id: 1, size: _ctx.file.size}
ocsf_generate::internal::randomize_file
share = "team-documents"
message = f"File hosting activity {activity_id} on {file.path}"
_ctx.source.target_file_path = file.path
_ctx.source.share = share
