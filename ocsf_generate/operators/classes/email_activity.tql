let $email_actions = ["send", "receive", "scan"]
let $subjects = ocsf_generate::$subjects
let $division_count = ocsf_generate::$division_count
let $division_size = ocsf_generate::$division_size
let $first_names = ocsf_generate::$first_names
let $last_names = ocsf_generate::$last_names

// Email field shapes follow zeek::ocsf_generate::logs::smtp.
@name = "ocsf.email_activity"
class_uid = 4009
category_uid = 4
metadata.log_name = "mail.log"
metadata.product = {name: "Mail server"}
activity_id = 1
direction_id = 3
protocol_name = "SMTP"
dst_endpoint = {ip: 10.20.0.25, hostname: "mail.acme.example", port: 587}
_ctx.partner = f"partner-{1 + int(random() * 100)}.example"
// The recipient is a colleague in the same division with another first name.
_ctx.sender_seat = _ctx.user_index - _ctx.division * $division_size
_ctx.recipient_seat = _ctx.sender_seat + 1 + int(random() * ($division_size - 1))
_ctx.recipient_seat = _ctx.recipient_seat - int(_ctx.recipient_seat / $division_size) * $division_size
_ctx.recipient_surname = _ctx.recipient_seat + _ctx.division
_ctx.recipient_surname = _ctx.recipient_surname - int(_ctx.recipient_surname / $last_names.length()) * $last_names.length()
_ctx.recipient_email = f"{$first_names[_ctx.recipient_seat + int(_ctx.division / 20) * 20]}.{$last_names[_ctx.recipient_surname]}@{_ctx.user.domain}"
email = {
  from: _ctx.user.email_addr,
  to: [_ctx.recipient_email],
  subject: f"{$subjects[int(random() * $subjects.length())]} / team {1 + int(random() * $division_count)}",
  message_uid: f"<{metadata.uid}@acme.example>",
}
if _ctx.variant >= 70 and _ctx.variant < 80 {
  activity_id = 2
  direction_id = 1
  email.from = f"notifications@{_ctx.partner}"
  email.to = [_ctx.user.email_addr]
  src_endpoint = {ip: 192.0.2.25, hostname: f"mail.{_ctx.partner}", port: 49152}
  dst_endpoint.port = 25
} else if _ctx.variant >= 80 and _ctx.variant < 95 {
  activity_id = 3
  message = f"Scanned email from {email.from} to {email.to[0]}"
} else if _ctx.variant >= 95 {
  direction_id = 2
  email.to = [f"support@{_ctx.partner}"]
}
drop actor
message = f"SMTP {$email_actions[activity_id - 1]} from {email.from} to {email.to[0]}"
if _ctx.detail > 0.75 {
  email.cc = ["helpdesk@acme.example"]
}
if _ctx.detail < 0.2 {
  drop email.subject
}
