// OCSF 1.9.0: incident_finding; independently sampled source scenarios.
@name = "ocsf.incident_finding"
class_uid = 2005
category_uid = 2
ocsf_generate::internal::finding_base
metadata.product = {name: "ServiceNow Security Incident Response", vendor_name: "ServiceNow"}
_ctx.native = null
activity_id = [1, 2, 2, 3][_ctx.scenario]
status_id = [1, 2, 3, 5][_ctx.scenario]
finding_info.title = ["Repeated login failures", "Suspicious endpoint execution", "Unusual data transfer", "Resolved account compromise"][_ctx.scenario]
finding_info_list = [finding_info]
assignee = _ctx.user
assignee_group = {uid: "group-security", name: "Security"}
priority_id = 3
message = finding_info.title
_ctx.source.incident_finding_uid = finding_info.uid
_ctx.source.assignee_uid = assignee.uid
drop finding_info, resources
