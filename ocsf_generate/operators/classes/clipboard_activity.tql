// OCSF 1.9.0: clipboard_activity; sampled source observations.
@name = "ocsf.clipboard_activity"
class_uid = 1012
category_uid = 1
ocsf_generate::internal::coverage_system_base
activity_id = [1, 2, 3, 2][_ctx.scenario]
clipboard = {name: "system", contents: [{mime_type: "text/plain", string_data: ["Team meeting at 10:00", "https://portal.acme.example/", "CASE-2048", "Synthetic document excerpt"][_ctx.scenario]}]}
message = f"Clipboard activity {activity_id} on {_ctx.host.hostname}"
if _ctx.detail > 0.50 {
  clipboard.contents = clipboard.contents.map(i => {...i, binary_data: decode_base64(encode_base64(i.string_data))})
}
