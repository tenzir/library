// OCSF 1.9.0: os_patch_state; independently sampled source scenarios.
@name = "ocsf.patch_state"
class_uid = 5004
category_uid = 5
ocsf_generate::internal::discovery_base
drop actor
device.os = {name: "Ubuntu", type_id: 200, version: ["24.04.3", "24.04.2", "24.04.1", "22.04.5"][_ctx.scenario]}
message = f"Observed OS patch level {device.os.version} on {device.hostname}"
_ctx.source.inventory_hostname = device.hostname
_ctx.source.inventory_os_version = device.os.version
