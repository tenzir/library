// OCSF 1.9.0: entity_management; independently sampled source scenarios.
@name = "ocsf.entity_management"
class_uid = 3004
category_uid = 3
ocsf_generate::internal::iam_base
activity_id = [2, 1, 3, 9][_ctx.scenario]
entity = {uid: _ctx.host.uid, name: _ctx.host.hostname, type_id: 1}
if activity_id == 3 {
  updated_entity = entity
  updated_entity.version = "2"
}
message = f"Managed entity {entity.name} activity {activity_id}"
_ctx.source.entity_uid = entity.uid
_ctx.source.entity_name = entity.name
