// OCSF 1.9.0: scheduled_job_activity; independently sampled source scenarios.
@name = "ocsf.scheduled_job_activity"
class_uid = 1006
category_uid = 1
ocsf_generate::internal::system_base
activity_id = [6, 1, 2, 5][_ctx.scenario]
job = {uid: f"job-backup-{_ctx.host.uid}", name: "User document backup", type_id: 3, created_time: time - 7d, user: _ctx.user, job_actions: [{type_id: 2, cmd_line: f"/usr/bin/rsync -a /home/{_ctx.user.name}/Documents/ /srv/backup/{_ctx.user.uid}/"}]}
job.run_state_id = 3 if activity_id == 6 else 5 if activity_id == 5 else 1
message = f"Scheduled job {job.name} activity {activity_id} on {_ctx.host.hostname}"
_ctx.source.job_uid = job.uid
_ctx.source.job_command = job.job_actions[0].cmd_line
