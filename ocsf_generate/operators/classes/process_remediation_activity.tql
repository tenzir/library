// OCSF 1.9.0: process_remediation_activity; independently sampled source scenarios.
@name = "ocsf.process_remediation_activity"
class_uid = 7003
category_uid = 7
ocsf_generate::internal::remediation_base
let $processes = ocsf_generate::$processes
_ctx.executable = $processes[int(random() * $processes.length())]
activity_id = [2, 1, 5, 2][_ctx.scenario]
process = {uid: uuid(), name: _ctx.executable.name, pid: 1000 + int(random() * 30000), file: {name: _ctx.executable.name, path: _ctx.executable.path, type_id: 8}, user: _ctx.user}
message = f"Process remediation activity {activity_id} for {process.name}"
_ctx.source.target_process_uid = process.uid
_ctx.source.target_process_name = process.name
