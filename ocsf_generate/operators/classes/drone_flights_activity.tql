// OCSF 1.9.0: drone_flights_activity; sampled source observations.
@name = "ocsf.drone_flights_activity"
class_uid = 8001
category_uid = 8
ocsf_generate::internal::aerial_base
src_endpoint = {ip: ip(f"192.0.2.{100 + _ctx.scenario}"), port: 14550}
dst_endpoint = {ip: ip(_ctx.host.ip), hostname: _ctx.host.hostname, port: 14550}
protocol_name = "MAVLink"
message = f"Drone flight telemetry from {unmanned_aerial_system.name}"
