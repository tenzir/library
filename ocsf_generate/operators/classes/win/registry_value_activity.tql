// OCSF 1.9.0: win/registry_value_activity; sampled source observations.
@name = "ocsf.win.registry_value_activity"
class_uid = 201002
category_uid = 1
ocsf_generate::internal::windows_base
activity_id = [1, 2, 3, 4][_ctx.scenario]
reg_value = {path: r"HKEY_LOCAL_MACHINE\Software\Acme\Endpoint", name: "Enabled", type_id: 4, data: 1 if _ctx.scenario != 2 else 0, is_system: true}
message = f"Registry value activity {activity_id} for {reg_value.path}\\{reg_value.name}"
