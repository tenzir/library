// OCSF 1.9.0: win/registry_key_activity; sampled source observations.
@name = "ocsf.win.registry_key_activity"
class_uid = 201001
category_uid = 1
ocsf_generate::internal::windows_base
activity_id = [1, 2, 3, 7][_ctx.scenario]
reg_key = {path: r"HKEY_LOCAL_MACHINE\Software\Acme\Endpoint", is_system: true}
message = f"Registry key activity {activity_id} for {reg_key.path}"
