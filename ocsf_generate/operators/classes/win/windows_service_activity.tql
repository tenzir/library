// OCSF 1.9.0: win/windows_service_activity; sampled source observations.
@name = "ocsf.win.windows_service_activity"
class_uid = 201004
category_uid = 1
ocsf_generate::internal::windows_base
activity_id = [1, 3, 4, 2][_ctx.scenario]
win_service = {name: "AcmeAgent", uid: "service-acme-agent", cmd_line: r"C:\Program Files\Acme\agent.exe --service", service_start_name: "LocalSystem"}
message = f"Windows service {win_service.name} activity {activity_id}"
