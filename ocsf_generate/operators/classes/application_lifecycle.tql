// OCSF 1.9.0: application_lifecycle; independently sampled source scenarios.
@name = "ocsf.application_lifecycle"
class_uid = 6002
category_uid = 6
ocsf_generate::internal::application_base
drop actor, src_endpoint, dst_endpoint
metadata.product = {name: "systemd", vendor_name: "systemd Project"}
application = {uid: "app-nginx", name: "nginx", version: "1.26.3"}
activity_id = [3, 5, 8, 4][_ctx.scenario]
if _ctx.scenario == 3 { status_detail = "Service stop timed out" }
message = f"Application {application.name} lifecycle activity {activity_id}"
_ctx.source.application_uid = application.uid
_ctx.source.application_version = application.version
