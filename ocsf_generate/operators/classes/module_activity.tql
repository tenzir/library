// OCSF 1.9.0: module_activity; independently sampled source scenarios.
@name = "ocsf.module_activity"
class_uid = 1005
category_uid = 1
ocsf_generate::internal::system_base
activity_id = [1, 2, 3, 1][_ctx.scenario]
module = {file: {name: "libssl.so.3", path: "/usr/lib/x86_64-linux-gnu/libssl.so.3", type_id: 1}, type: "Shared library", function_name: "SSL_read"}
if _ctx.scenario == 3 {
  module.file.name = "libcrypto.so.3"
  module.file.path = "/usr/lib/x86_64-linux-gnu/libcrypto.so.3"
  module.function_name = "EVP_DigestInit_ex"
}
message = f"{actor.process.name} module activity {activity_id} on {module.file.path}"
_ctx.source.module_path = module.file.path
_ctx.source.function_name = module.function_name
