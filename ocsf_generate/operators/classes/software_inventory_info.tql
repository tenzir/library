// OCSF 1.9.0: software_inventory_info; independently sampled source scenarios.
@name = "ocsf.software_info"
class_uid = 5020
category_uid = 5
ocsf_generate::internal::discovery_base
product = {name: ["Firefox", "OpenSSH", "Python", "Git"][_ctx.scenario], vendor_name: ["Mozilla", "OpenBSD", "Python Software Foundation", "Git Project"][_ctx.scenario], version: ["143.0", "9.6p1", "3.12.3", "2.43.0"][_ctx.scenario]}
message = f"Inventory {product.name} {product.version} on {device.hostname}"
_ctx.source.inventory_hostname = device.hostname
_ctx.source.inventory_product = product.name
_ctx.source.inventory_product_version = product.version
