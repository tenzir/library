// OCSF 1.9.0: file_remediation_activity; independently sampled source scenarios.
@name = "ocsf.file_remediation_activity"
class_uid = 7002
category_uid = 7
ocsf_generate::internal::remediation_base
let $files = ocsf_generate::$files
_ctx.file = $files[int(random() * $files.length())]
activity_id = [2, 3, 1, 2][_ctx.scenario]
file = {name: _ctx.file.name, path: f"/home/{_ctx.user.name}/{_ctx.file.path}", type_id: 1}
ocsf_generate::internal::randomize_file
message = f"File remediation activity {activity_id} for {file.path}"
_ctx.source.target_file_path = file.path
