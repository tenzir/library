// OCSF 1.9.0: ntp_activity; independently sampled source scenarios.
@name = "ocsf.ntp_activity"
class_uid = 4013
category_uid = 4
ocsf_generate::internal::network_base
metadata.log_name = "ntp.log"
connection_info = {protocol_num: 17, protocol_name: "udp", direction_id: 3}
src_endpoint.port = 49152 + int(random() * 16384)
dst_endpoint = {ip: 10.20.0.123, hostname: "ntp.acme.example", port: 123}
activity_id = [3, 4, 3, 4][_ctx.scenario]
version = "4"
stratum_id = 2 if status_id == 1 else 16
delay = [2, 3, 15, 1000][_ctx.scenario]
precision = -20
if status_id == 2 { status_detail = "Server clock unsynchronized" }
message = f"NTP activity {activity_id} with {dst_endpoint.hostname}, delay {delay} ms"
_ctx.source.ntp_version = version
_ctx.source.ntp_delay = delay
_ctx.source.ntp_stratum_id = stratum_id
// Zeek connection IDs: "C" followed by 17 base62 characters.
connection_info.uid = f"C{encode_base64(decode_hex(hash_md5(metadata.uid))).replace("+", "x").replace("/", "Z").slice(end=17)}"
