// OCSF 1.9.0: cloud_resources_inventory_info; independently sampled source scenarios.
@name = "ocsf.cloud_resources_inventory_info"
class_uid = 5023
category_uid = 5
ocsf_generate::internal::discovery_base
drop device, actor
metadata.product = {name: "Config", vendor_name: "Amazon Web Services"}
resources = [{uid: ["arn:aws:s3:::team-documents", "arn:aws:s3:::audit-archive", "arn:aws:iam::123456789012:role/WorkspaceReader", "arn:aws:iam::123456789012:role/WorkspaceWriter"][_ctx.scenario], name: ["team-documents", "audit-archive", "WorkspaceReader", "WorkspaceWriter"][_ctx.scenario], type: "Bucket" if _ctx.scenario < 2 else "Role"}]
message = f"Collected cloud inventory for {resources[0].name}"
_ctx.source.inventory_resource_uid = resources[0].uid
