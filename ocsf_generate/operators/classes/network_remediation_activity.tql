// OCSF 1.9.0: network_remediation_activity; independently sampled source scenarios.
@name = "ocsf.network_remediation_activity"
class_uid = 7004
category_uid = 7
ocsf_generate::internal::remediation_base
activity_id = [1, 2, 3, 4][_ctx.scenario]
connection_info = {uid: f"network-{_ctx.host.uid}", protocol_num: 6, protocol_name: "tcp", direction_id: 3}
message = f"Network remediation activity {activity_id} for {_ctx.host.hostname}"
_ctx.source.target_connection_uid = connection_info.uid
