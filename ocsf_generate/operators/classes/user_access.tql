// OCSF 1.9.0: user_access; sampled source observations.
@name = "ocsf.user_access"
class_uid = 3005
category_uid = 3
ocsf_generate::internal::iam_base
activity_id = [1, 2, 3, 4][_ctx.scenario]
user = _ctx.user
privileges = ["documents:read", "documents:write"]
iam_role = {uid: "role-document-editor", name: "Document editor"}
message = f"User {user.name} access-management activity {activity_id}"
