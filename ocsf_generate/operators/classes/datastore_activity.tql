// OCSF 1.9.0: datastore_activity; independently sampled source scenarios.
@name = "ocsf.datastore_activity"
class_uid = 6005
category_uid = 6
ocsf_generate::internal::application_base
metadata.product = {name: "PostgreSQL", vendor_name: "PostgreSQL Global Development Group"}
dst_endpoint = {ip: 10.20.0.54, hostname: "db.acme.example", port: 5432}
activity_id = [4, 5, 2, 4][_ctx.scenario]
database = {uid: "database-workspace", name: "workspace", type_id: 1}
query_info = {uid: metadata.uid, query_time: time, query_string: ["SELECT project_id, name FROM projects WHERE active = true", "INSERT INTO audit_log (action) VALUES ('report')", "UPDATE projects SET reviewed = true WHERE project_id = 42", "SELECT * FROM restricted_payroll"][_ctx.scenario]}
message = f"Datastore activity {activity_id} on {database.name}"
_ctx.source.database_uid = database.uid
_ctx.source.sql_query = query_info.query_string
