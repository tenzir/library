// OCSF 1.9.0: ssh_activity; independently sampled source scenarios.
@name = "ocsf.ssh_activity"
class_uid = 4007
category_uid = 4
ocsf_generate::internal::network_base
// The bastion's sshd logs connection lifecycle messages to auth.log.
metadata.product = {name: "OpenSSH", vendor_name: "OpenBSD", version: "9.6p1"}
metadata.log_name = "auth.log"
_ctx.native = "sshd"
dst_endpoint = {ip: 10.20.0.10, hostname: "bastion-01.acme.example", port: 22}
activity_id = [6, 1, 2, 4][_ctx.scenario]
protocol_ver = "2.0"
message = f"SSH activity {activity_id} from {_ctx.host.hostname}"
_ctx.source.protocol_version = protocol_ver
