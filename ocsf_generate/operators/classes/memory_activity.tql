// OCSF 1.9.0: memory_activity; sampled source observations.
@name = "ocsf.memory_activity"
class_uid = 1004
category_uid = 1
ocsf_generate::internal::coverage_system_base
ocsf_generate::internal::coverage_process
activity_id = [1, 7, 8, 4][_ctx.scenario]
base_address = "0x7f000000"
size = 4096 * (1 + _ctx.scenario)
severity_id = 4 if activity_id == 4 else 1
message = f"Memory activity {activity_id} in {process.name} at {base_address}"
