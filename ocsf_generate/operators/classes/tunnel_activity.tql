// OCSF 1.9.0: tunnel_activity; independently sampled source scenarios.
@name = "ocsf.tunnel_activity"
class_uid = 4014
category_uid = 4
ocsf_generate::internal::network_base
metadata.product = {name: "OpenVPN", vendor_name: "OpenVPN"}
_ctx.native = null
metadata.log_name = "vpn.log"
dst_endpoint = {ip: 10.20.0.119, hostname: "vpn.acme.example", port: 1194}
connection_info = {protocol_num: 17, protocol_name: "udp", direction_id: 1}
activity_id = [1, 3, 2, 1][_ctx.scenario]
user = _ctx.user
tunnel_type_id = 1
protocol_name = "SSL"
message = f"VPN activity {activity_id} for {user.name}"
_ctx.source.tunnel_protocol = protocol_name
_ctx.source.tunnel_type_id = tunnel_type_id
