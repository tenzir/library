// OCSF 1.9.0: application_error; independently sampled source scenarios.
@name = "ocsf.application_error"
class_uid = 6008
category_uid = 6
ocsf_generate::internal::application_base
drop actor, src_endpoint, dst_endpoint
metadata.product = {name: "nginx", vendor_name: "F5"}
metadata.log_name = "error.log"
_ctx.native = "nginx_error"
activity_id = 1
status_id = 2
severity_id = 4
message = ["Upstream request timed out", "Connection to upstream refused", "Upstream sent an invalid response header", "No live upstreams available"][_ctx.scenario]
drop status_detail?
_ctx.source.error_message = message
