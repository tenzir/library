// OCSF 1.9.0: rdp_activity; independently sampled source scenarios.
@name = "ocsf.rdp_activity"
class_uid = 4005
category_uid = 4
ocsf_generate::internal::network_base
metadata.log_name = "rdp.log"
dst_endpoint = {ip: 10.20.0.60, hostname: "rdp.acme.example", port: 3389}
activity_id = [4, 6, 7, 3][_ctx.scenario]
protocol_ver = "10.0"
user = _ctx.user
message = f"RDP activity {activity_id} for {user.name}"
_ctx.source.protocol_version = protocol_ver
// Zeek connection IDs: "C" followed by 17 base62 characters.
connection_info.uid = f"C{encode_base64(decode_hex(hash_md5(metadata.uid))).replace("+", "x").replace("/", "Z").slice(end=17)}"
