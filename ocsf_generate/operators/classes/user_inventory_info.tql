// OCSF 1.9.0: user_inventory_info; independently sampled source scenarios.
@name = "ocsf.user_inventory"
class_uid = 5003
category_uid = 5
ocsf_generate::internal::discovery_base
drop device
user = _ctx.user
user.account = {uid: user.uid, type_id: 9, is_disabled: _ctx.scenario == 3}
user.type_id = 2 if _ctx.scenario == 2 else 1
message = f"Collected user inventory for {user.name}"
_ctx.source.target_user_uid = user.uid
_ctx.source.user_disabled = user.account.is_disabled
_ctx.source.user_type_id = user.type_id
