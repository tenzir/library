// OCSF 1.9.0: iam_analysis_finding; sampled source observations.
@name = "ocsf.iam_analysis_finding"
class_uid = 2008
category_uid = 2
ocsf_generate::internal::finding_base
metadata.product = {name: "IAM analyzer", vendor_name: "Acme"}
_ctx.native = "generic"
