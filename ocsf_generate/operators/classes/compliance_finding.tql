// OCSF 1.9.0: compliance_finding; independently sampled source scenarios.
@name = "ocsf.compliance_finding"
class_uid = 2003
category_uid = 2
ocsf_generate::internal::finding_base
finding_info.title = ["Audit logging enabled", "Password policy review", "Public access restriction failed", "Public access restriction remediated"][_ctx.scenario]
compliance = {control: ["Enable audit logging", "Enforce password policy", "Restrict public access", "Restrict public access"][_ctx.scenario], standards: ["Acme infrastructure baseline"], status_id: [1, 2, 3, 1][_ctx.scenario]}
message = f"{finding_info.title} on {_ctx.host.hostname}"
_ctx.source.finding_uid = finding_info.uid
_ctx.source.compliance_control = compliance.control
_ctx.source.compliance_status_id = compliance.status_id
