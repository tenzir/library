// OCSF 1.9.0: folder_query; sampled source observations.
@name = "ocsf.folder_query"
class_uid = 5008
category_uid = 5
ocsf_generate::internal::query_base
folder = {name: "Documents", path: f"C:\\Users\\{_ctx.user.name}\\Documents" if _ctx.windows else f"/Users/{_ctx.user.name}/Documents" if _ctx.macos else f"/home/{_ctx.user.name}/Documents", type_id: 2}
message = f"Folder query for {folder.path}: result {query_result_id}"
