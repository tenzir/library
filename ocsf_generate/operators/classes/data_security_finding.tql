// OCSF 1.9.0: data_security_finding; independently sampled source scenarios.
@name = "ocsf.data_security_finding"
class_uid = 2006
category_uid = 2
ocsf_generate::internal::finding_base
metadata.product = {name: "Purview", vendor_name: "Microsoft"}
_ctx.native = null
finding_info.title = ["Sensitive document in shared folder", "Financial data classification", "Credential pattern in export", "Sharing exposure resolved"][_ctx.scenario]
data_security = {category_id: [1, 3, 6, 1][_ctx.scenario], confidentiality_id: 2, detection_system_id: 4, data_lifecycle_state_id: 1, detection_pattern: ["personal-contact", "bank-account", "credential", "personal-contact"][_ctx.scenario]}
message = f"{finding_info.title} on {_ctx.host.hostname}"
_ctx.source.finding_uid = finding_info.uid
_ctx.source.data_category_id = data_security.category_id
_ctx.source.detection_pattern = data_security.detection_pattern
