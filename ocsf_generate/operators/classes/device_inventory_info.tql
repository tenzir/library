// OCSF 1.9.0: device_inventory_info; independently sampled source scenarios.
@name = "ocsf.inventory_info"
class_uid = 5001
category_uid = 5
ocsf_generate::internal::discovery_base
device.os = {name: "Ubuntu", version: ["24.04", "24.04.1", "24.04.2", "22.04"][_ctx.scenario], type_id: 200}
message = f"Collected device inventory for {device.hostname}"
_ctx.source.inventory_hostname = device.hostname
_ctx.source.inventory_os_version = device.os.version
