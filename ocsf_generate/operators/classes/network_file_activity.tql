// OCSF 1.9.0: network_file_activity; sampled source observations.
@name = "ocsf.network_file_activity"
class_uid = 4010
category_uid = 4
ocsf_generate::internal::coverage_system_base
metadata.product = {name: "Nextcloud", vendor_name: "Nextcloud"}
ocsf_generate::internal::coverage_file
activity_id = [1, 2, 3, 4][_ctx.scenario]
src_endpoint = {ip: ip(_ctx.host.ip), hostname: _ctx.host.hostname, port: 50000}
dst_endpoint = {ip: 10.20.0.15, hostname: "files.acme.example", port: 443}
message = f"Network file activity {activity_id} for {file.path}"
