// OCSF 1.9.0: role_management; independently sampled source scenarios.
@name = "ocsf.role_management"
class_uid = 3008
category_uid = 3
ocsf_generate::internal::iam_base
activity_id = [4, 5, 8, 9][_ctx.scenario]
iam_role = {uid: "role-workspace-reader", name: "Workspace reader"}
if activity_id in [4, 5] { privileges = ["workspace:read"] }
else { policies = [{uid: "policy-workspace-read", name: "Workspace read access"}] }
message = f"Role {iam_role.name} activity {activity_id} by {_ctx.user.name}"
_ctx.source.target_role_uid = iam_role.uid
