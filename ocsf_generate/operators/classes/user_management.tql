// OCSF 1.9.0: user_management; independently sampled source scenarios.
@name = "ocsf.user_management"
class_uid = 3007
category_uid = 3
ocsf_generate::internal::iam_base
activity_id = [8, 9, 4, 5][_ctx.scenario]
user = _ctx.user
message = f"{["Password changed", "Password reset", "Account enabled", "Failed to disable account"][_ctx.scenario]} for {user.name}"
_ctx.source.target_user_uid = user.uid
