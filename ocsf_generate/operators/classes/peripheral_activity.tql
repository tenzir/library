// OCSF 1.9.0: peripheral_activity; sampled source observations.
@name = "ocsf.peripheral_activity"
class_uid = 1010
category_uid = 1
ocsf_generate::internal::coverage_system_base
activity_id = [1, 2, 3, 4][_ctx.scenario]
peripheral_device = {uid: f"usb-{_ctx.host.uid}", name: "Encrypted USB storage", type_id: 1, model: "Acme Secure Storage", serial_number: f"USB-{_ctx.host.uid}"}
message = f"Peripheral {peripheral_device.name} activity {activity_id}"
