// OCSF 1.9.0: authorize_session; independently sampled source scenarios.
@name = "ocsf.authorize_session"
class_uid = 3003
category_uid = 3
ocsf_generate::internal::iam_base
activity_id = [2, 1, 3, 1][_ctx.scenario]
user = _ctx.user
session = {uid: f"session-{_ctx.user.uid}-{time.floor(1h)}", created_time: time.floor(1h), expiration_time: time.floor(1h) + 1h}
actor.session = session
if activity_id == 1 { privileges = ["workspace:read", "workspace:write"] }
else if activity_id == 2 { groups = [{uid: "group-workspace-users", name: "Workspace users"}] }
else { iam_roles = [{uid: "role-workspace-reader", name: "Workspace reader"}] }
message = f"Session authorization activity {activity_id} for {user.name}"
_ctx.source.target_user_uid = user.uid
_ctx.source.session_uid = session.uid
