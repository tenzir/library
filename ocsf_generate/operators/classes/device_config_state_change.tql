// OCSF 1.9.0: device_config_state_change; independently sampled source scenarios.
@name = "ocsf.device_config_state_change"
class_uid = 5019
category_uid = 5
ocsf_generate::internal::discovery_base
state_id = 2 if _ctx.scenario in [0, 1] else 1
prev_security_level_id = 2 if state_id == 2 else 1
security_level_id = 1 if state_id == 2 else 2
if state_id == 1 { security_states = [{state_id: 4 if _ctx.scenario == 2 else 16}] }
message = f"Protection configuration changed on {device.hostname}, state {state_id}"
_ctx.source.inventory_hostname = device.hostname
_ctx.source.config_state_id = state_id
_ctx.source.security_level_id = security_level_id
