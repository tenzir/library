// OCSF 1.9.0: application_security_posture_finding; sampled source observations.
@name = "ocsf.application_security_posture_finding"
class_uid = 2007
category_uid = 2
ocsf_generate::internal::finding_base
metadata.product = {name: "Application posture scanner", vendor_name: "Acme"}
_ctx.native = "generic"
finding_info.title = ["Dependency vulnerability", "Application policy violation", "Exposed application endpoint", "Application issue resolved"][_ctx.scenario]
application = {uid: "app-acme-portal", name: "Acme Portal", version: "2.4.0"}
message = f"{finding_info.title} in {application.name}"
