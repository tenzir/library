// OCSF 1.9.0: networks_query; sampled source observations.
@name = "ocsf.networks_query"
class_uid = 5013
category_uid = 5
ocsf_generate::internal::query_base
network_interfaces = [{uid: f"nic-{_ctx.host.uid}", name: "Ethernet" if _ctx.windows else "en0" if _ctx.macos else "eth0", ip: ip(_ctx.host.ip), hostname: _ctx.host.hostname, type_id: 1}]
message = f"Network interface query on {_ctx.host.hostname}: result {query_result_id}"
