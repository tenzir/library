// OCSF 1.9.0: kernel_extension_activity; sampled source observations.
@name = "ocsf.kernel_extension_activity"
class_uid = 1002
category_uid = 1
ocsf_generate::internal::coverage_system_base
activity_id = [1, 2, 1, 2][_ctx.scenario]
_ctx.driver_name = "acme-filter.sys" if _ctx.windows else "AcmeEndpoint.kext" if _ctx.macos else "acme_filter.ko"
driver = {file: {name: _ctx.driver_name, type_id: 1,
  path: f"C:\\Windows\\System32\\drivers\\{_ctx.driver_name}" if _ctx.windows else f"/Library/Extensions/{_ctx.driver_name}" if _ctx.macos else f"/lib/modules/{_ctx.driver_name}"}}
message = f"Kernel extension {driver.file.name} activity {activity_id} on {_ctx.host.hostname}"
