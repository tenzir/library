// OCSF 1.9.0: security_finding; sampled source observations.
@name = "ocsf.security_finding"
class_uid = 2001
category_uid = 2
drop actor, src_endpoint, dst_endpoint
metadata.product = {name: "Legacy SIEM", vendor_name: "Acme"}
metadata.log_name = "legacy-findings"
_ctx.native = "generic"
activity_id = [1, 2, 2, 3][_ctx.scenario]
state_id = [1, 2, 3, 4][_ctx.scenario]
finding = {uid: metadata.uid, title: ["Suspicious logon", "Finding investigation", "Approved exception", "Finding resolved"][_ctx.scenario], created_time: time}
message = finding.title
