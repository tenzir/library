// OCSF 1.9.0: group_management; independently sampled source scenarios.
@name = "ocsf.group_management"
class_uid = 3006
category_uid = 3
ocsf_generate::internal::iam_base
activity_id = [3, 4, 1, 2][_ctx.scenario]
group = {uid: "group-workspace-users", name: "Workspace users", domain: _ctx.user.domain}
if activity_id in [3, 4] { users = [_ctx.user] }
else { privileges = ["workspace:write"] }
message = f"Group {group.name} activity {activity_id} by {_ctx.user.name}"
_ctx.source.target_group_uid = group.uid
if users? != null { _ctx.source.target_user_uid = users[0].uid }
