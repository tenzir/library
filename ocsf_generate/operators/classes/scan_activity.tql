// OCSF 1.9.0: scan_activity; independently sampled source scenarios.
@name = "ocsf.scan_activity"
class_uid = 6007
category_uid = 6
ocsf_generate::internal::application_base
drop actor, src_endpoint, dst_endpoint
metadata.product = {name: "Falcon", vendor_name: "CrowdStrike", version: "7.29.20108"}
_ctx.native = "falcon"
activity_id = [2, 1, 3, 6][_ctx.scenario]
scan = {uid: metadata.uid, name: f"Endpoint scan {_ctx.host.hostname}", type_id: 2}
start_time = time if activity_id == 1 else time - 5min
if activity_id != 1 { end_time = time }
if activity_id == 2 {
  num_files = 1000 + int(random() * 10000)
  num_detections = int(random() * 3)
  num_resolutions = num_detections
  if _ctx.detail > 0.50 {
    num_folders = int(num_files / 20)
    num_network_items = 8
    num_processes = 50 + int(random() * 150)
    num_registry_items = 1000 + int(random() * 9000) if _ctx.windows else 0
    num_skipped_items = int(num_files * 0.01)
    num_trusted_items = num_files - num_skipped_items - num_detections
  }
}
if activity_id == 6 { status_detail = "Scan engine initialization failed" }
message = f"Scan {scan.name} activity {activity_id}"
_ctx.source.scan_uid = scan.uid
_ctx.source.scan_name = scan.name
