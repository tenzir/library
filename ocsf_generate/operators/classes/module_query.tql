// OCSF 1.9.0: module_query; sampled source observations.
@name = "ocsf.module_query"
class_uid = 5011
category_uid = 5
ocsf_generate::internal::query_base
ocsf_generate::internal::coverage_process
module = {file: {name: "acme-runtime.dll" if _ctx.windows else "libacme.dylib" if _ctx.macos else "libacme.so", path: r"C:\Program Files\Acme\acme-runtime.dll" if _ctx.windows else "/usr/local/lib/libacme.dylib" if _ctx.macos else "/usr/lib/libacme.so", type_id: 1}}
module.load_type_id = 1
message = f"Module query for {module.file.name}: result {query_result_id}"
