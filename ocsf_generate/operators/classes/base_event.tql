// OCSF 1.9.0: base_event; sources without a specific class keep native fields in unmapped.
@name = "ocsf.base_event"
class_uid = 0
category_uid = 0
drop actor, src_endpoint, dst_endpoint, status_id
activity_id = 0
// Many unclassified sources carry no meaningful level; profiles map the ones they have.
severity_id = 0 if random() < 0.45 else 1
// Source profiles add their own fields after the shared enrichment steps; see
// internal/base_sources.tql.
