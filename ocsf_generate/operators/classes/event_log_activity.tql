// OCSF 1.9.0: event_log_activity; independently sampled source scenarios.
@name = "ocsf.event_log_actvity"
class_uid = 1008
category_uid = 1
ocsf_generate::internal::system_base
activity_id = [5, 3, 4, 1][_ctx.scenario]
log_name = "system.journal"
log_provider = "systemd-journald"
message = f"{_ctx.user.name} performed log activity {activity_id} on {log_name}"
_ctx.source.log_name = log_name
_ctx.source.log_provider = log_provider
