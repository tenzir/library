// OCSF 1.9.0: email_url_activity; sampled source observations.
@name = "ocsf.email_url_activity"
class_uid = 4012
category_uid = 4
ocsf_generate::internal::coverage_system_base
metadata.product = {name: "Mail security gateway", vendor_name: "Acme"}
activity_id = [1, 2, 3, 3][_ctx.scenario]
email_uid = f"<{metadata.uid}@acme.example>"
url = {scheme: "https", hostname: _ctx.service.hostname, path: "/documents", url_string: f"https://{_ctx.service.hostname}/documents"}
message = f"Email URL {url.url_string} activity {activity_id}"
