---
description: Generate a continuous synthetic OCSF stream at up to eps events per second.
args:
  named:
    - name: eps
      type: int
      default: 1000
    - name: class_uid
      type: int
      default: null
    - name: base_event_share
      type: float
      default: 0.35
    - name: raw
      type: string
      default: native
    - name: raw_message
      type: bool
      default: false
    - name: observables_probability
      type: float
      default: 1.0
    - name: drift_probability
      type: float
      default: 0.0
    - name: unknown_probability
      type: float
      default: 0.0
    - name: vendor_probability
      type: float
      default: 0.0
---

// Bounded rounds let every branch finish, including when a caller stops reading.
// Each round generates fresh UUIDs and timestamps from the same entity pools.
every 5s {
  ocsf_generate::generate count=$eps * 5, eps=$eps, time_eps=null, class_uid=$class_uid,
    base_event_share=$base_event_share, raw=$raw, raw_message=$raw_message,
    observables_probability=$observables_probability,
    drift_probability=$drift_probability,
    unknown_probability=$unknown_probability,
    vendor_probability=$vendor_probability
}
