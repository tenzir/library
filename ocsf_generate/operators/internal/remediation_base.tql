drop actor, src_endpoint, dst_endpoint
metadata.product = {name: "Falcon", vendor_name: "CrowdStrike", version: "7.29.20108"}
metadata.log_name = "response-actions"
_ctx.native = "falcon"
command_uid = uuid()
activity_id = [1, 2, 3, 4][_ctx.scenario]
if _ctx.scenario == 3 {
  status_id = 6
  status_detail = "Endpoint did not acknowledge the command"
}
_ctx.source.command_uid = command_uid
