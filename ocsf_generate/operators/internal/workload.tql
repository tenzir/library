---
description: Generate four independent event batches concurrently from each seed batch.
args:
  named:
    - name: count
      type: int
    - name: time_eps
      type: int
    - name: end_time
      type: time
    - name: historical_start
      type: time
      default: null
    - name: eps_office_hours
      type: int
      default: 1000
    - name: eps_off
      type: int
      default: 100
    - name: class_uid
      type: int
    - name: base_event_share
      type: float
    - name: raw
      type: string
    - name: raw_message
      type: bool
    - name: needle_ip_count
      type: int
      default: 0
    - name: needle_dns_count
      type: int
      default: 0
    - name: needle_command_count
      type: int
      default: 0
    - name: observables_probability
      type: float
      default: 1.0
    - name: drift_probability
      type: float
      default: 0.0
    - name: unknown_probability
      type: float
      default: 0.0
    - name: vendor_probability
      type: float
      default: 0.0
---

// Seeds carry no identities. Each branch samples entities and makes fresh UUIDs.
// Explicit subpipelines avoid relying on automatic Nova operator parallelization.
fork_merge {
  ocsf_generate::internal::populate offset=0, count=$count, time_eps=$time_eps, end_time=$end_time,
    historical_start=$historical_start, eps_office_hours=$eps_office_hours, eps_off=$eps_off,
    class_uid=$class_uid, base_event_share=$base_event_share, raw=$raw,
    raw_message=$raw_message,
    needle_ip_count=$needle_ip_count,
    needle_dns_count=$needle_dns_count,
    needle_command_count=$needle_command_count,
    observables_probability=$observables_probability,
    drift_probability=$drift_probability,
    unknown_probability=$unknown_probability,
    vendor_probability=$vendor_probability
}, {
  ocsf_generate::internal::populate offset=1, count=$count, time_eps=$time_eps, end_time=$end_time,
    historical_start=$historical_start, eps_office_hours=$eps_office_hours, eps_off=$eps_off,
    class_uid=$class_uid, base_event_share=$base_event_share, raw=$raw,
    raw_message=$raw_message,
    needle_ip_count=$needle_ip_count,
    needle_dns_count=$needle_dns_count,
    needle_command_count=$needle_command_count,
    observables_probability=$observables_probability,
    drift_probability=$drift_probability,
    unknown_probability=$unknown_probability,
    vendor_probability=$vendor_probability
}, {
  ocsf_generate::internal::populate offset=2, count=$count, time_eps=$time_eps, end_time=$end_time,
    historical_start=$historical_start, eps_office_hours=$eps_office_hours, eps_off=$eps_off,
    class_uid=$class_uid, base_event_share=$base_event_share, raw=$raw,
    raw_message=$raw_message,
    needle_ip_count=$needle_ip_count,
    needle_dns_count=$needle_dns_count,
    needle_command_count=$needle_command_count,
    observables_probability=$observables_probability,
    drift_probability=$drift_probability,
    unknown_probability=$unknown_probability,
    vendor_probability=$vendor_probability
}, {
  ocsf_generate::internal::populate offset=3, count=$count, time_eps=$time_eps, end_time=$end_time,
    historical_start=$historical_start, eps_office_hours=$eps_office_hours, eps_off=$eps_off,
    class_uid=$class_uid, base_event_share=$base_event_share, raw=$raw,
    raw_message=$raw_message,
    needle_ip_count=$needle_ip_count,
    needle_dns_count=$needle_dns_count,
    needle_command_count=$needle_command_count,
    observables_probability=$observables_probability,
    drift_probability=$drift_probability,
    unknown_probability=$unknown_probability,
    vendor_probability=$vendor_probability
}
