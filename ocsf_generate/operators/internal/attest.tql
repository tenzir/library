---
description: Fingerprint the final event, excluding the fingerprint itself.
---

// The generator's canonical representation is compact NDJSON in emitted field
// order. At this point raw rendering and observable extraction have finished.
attestation_list = [{authority_uid: "ocsf-gen", uid: metadata.uid}]
attestation_list = [{...attestation_list[0], fingerprint: {
  algorithm_id: 3, encoding_id: 1, serialization_id: 99,
  serialization: "Compact NDJSON in emitted field order, without trailing newline",
  value: hash_sha256(print_ndjson(this)),
}}]
