---
description: Add file metadata to _ctx.entity, preserving existing hashes and identity.
---

_ctx.entity.created_time = time.floor(1d) - 30d
_ctx.entity.modified_time = time.floor(1d) - 1d
_ctx.entity.accessed_time = time
_ctx.entity.mime_type = ("application/pdf" if _ctx.entity.name.ends_with(".pdf")
  else "text/csv" if _ctx.entity.name.ends_with(".csv")
  else "application/json" if _ctx.entity.name.ends_with(".json")
  else "text/plain" if _ctx.entity.name.ends_with(".txt")
  else "application/octet-stream")
_ctx.entity.owner = (_ctx.user if _ctx.entity.type_id != 8 else
  {uid: "S-1-5-18", name: "SYSTEM", type_id: 3} if _ctx.windows else
  {uid: "0", name: "root", type_id: 2})
if _ctx.entity.type_id == 8 {
  _ctx.entity.company_name = ("Python Software Foundation" if _ctx.entity.name.starts_with("python")
    else "Acme packaged software")
  _ctx.entity.version = "1.0-fixture"
}
