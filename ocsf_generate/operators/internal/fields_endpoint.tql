---
description: Add optional endpoint results, inventory assessments, and before/after state.
---

match class_uid {
  1001 => {
    if status_id == 1 and activity_id in [1, 3] {
      file_result = file
    }
  }
  1007 => {
    if activity_id == 1 {
      launch_type_id = 1
    } else if activity_id == 3 and _ctx.windows {
      // Match the access masks in the selected product's handle event.
      requested_permissions = 4096 if _ctx.native == "winsec" else 5136 if _ctx.native == "sysmon" else 1052928
      actual_permissions = requested_permissions
    }
  }
  1008 => {
    log_type_id = 1
  }
  5002 => {
    assessments = [{uid: f"assessment-{_ctx.scenario}", name: [
      "Disk encryption", "Host firewall", "Screen lock", "Endpoint baseline",
    ][_ctx.scenario], meets_criteria: _ctx.scenario != 3}]
  }
  5019 => {
    prev_security_states = [{state_id: 4}] if prev_security_level_id == 2 else []
  }
  5020 => {
    package = {name: product.name, version: product.version, vendor_name: product.vendor_name}
  }
  201001 => {
    if activity_id == 2 {
      open_mask = 131097
    } else if activity_id in [3, 7] {
      prev_reg_key = {...reg_key, modified_time: time - 1d}
      reg_key.modified_time = time
    }
  }
  201002 => {
    if activity_id == 3 {
      prev_reg_value = {...reg_value, data: 1, modified_time: time - 1d}
      reg_value.modified_time = time
    }
  }
  201004 => {
    if activity_id == 2 {
      prev_win_service = win_service
      win_service.cmd_line = win_service.cmd_line + " --verify"
    }
  }
  205019 => {
    last_run_time = time - 1h
    run_count = 1 + int(random() * 100)
  }
  _ => { pass }
}
