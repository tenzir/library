---
description: Add optional file results, process access details, and previous security states.
---

match class_uid {
  1001 => {
    if status_id == 1 and activity_id in [1, 3] {
      file_result = file
    }
  }
  1007 => {
    if activity_id == 1 {
      launch_type_id = 1
    } else if activity_id == 3 and _ctx.windows {
      // Match the access masks in the Windows products' handle events.
      requested_permissions = 4096 if _ctx.native == "winsec" else 5136 if _ctx.native == "sysmon" else 1052928
      actual_permissions = requested_permissions
    }
  }
  1008 => {
    log_type_id = 1
  }
  5019 => {
    if prev_security_level_id == 2 {
      prev_security_states = [{state_id: 4}]
    }
  }
  _ => { pass }
}
