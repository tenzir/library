// Shared endpoint identity for the additional system classes.
drop src_endpoint, dst_endpoint
device = {uid: _ctx.host.uid, hostname: _ctx.host.hostname, ip: ip(_ctx.host.ip), type_id: 99, type: "Workstation"}
// Falcon identifies processes by their sensor-assigned ContextProcessId.
_ctx.native = "falcon"
actor.process = {uid: string(100000000000 + int(random() * 899999999999)), name: "python3", pid: 1000 + int(random() * 30000), file: {name: "python3", path: "/usr/bin/python3", type_id: 8}}
metadata.product = {name: "Falcon", vendor_name: "CrowdStrike", version: "7.29.20108"}
metadata.log_name = "endpoint-audit"
