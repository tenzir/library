drop actor, src_endpoint, dst_endpoint
metadata.product = {name: "Security Hub", vendor_name: "Amazon Web Services"}
metadata.log_name = "security-findings"
_ctx.native = "securityhub"
severity_id = 3
resources = [{uid: _ctx.host.uid, name: _ctx.host.hostname, type: "Host"}]
activity_id = 1 if _ctx.scenario == 0 else 2 if _ctx.scenario in [1, 2] else 3
status_id = 1 if _ctx.scenario == 0 else 2 if _ctx.scenario in [1, 2] else 4
finding_info = {uid: uuid(), title: "", created_time: time}
