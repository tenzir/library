---
description: Add analyst notes and incident impact assessments.
---

if class_uid in [2002, 2003, 2004, 2005, 2006, 2007, 2008] {
  notes = [{uid: f"note-{metadata.uid}", created_time: time,
    title: "Analyst review", comment: "Reviewed the source evidence and assigned the finding to the security team."}]
}
if class_uid == 2005 {
  desc = f"Security incident: {message}"
  impact_id = [1, 3, 2, 3][_ctx.scenario]
  impact_score = [20, 75, 50, 75][_ctx.scenario]
  is_suspected_breach = _ctx.scenario == 3
}
