---
description: Select a recurring document as _ctx.file with its name, relative path, and size.
---

let $files = ocsf_generate::$files
let $division_count = ocsf_generate::$division_count

// Each division keeps its own numbered copy of the six documents.
_ctx.file_kind = int(random() * $files.length())
_ctx.file_copy = int(random() * $division_count)
_ctx.file = {
  name: (f"{$files[_ctx.file_kind].stem}.{$files[_ctx.file_kind].extension}" if _ctx.file_copy == 0
    else f"{$files[_ctx.file_kind].stem}-{_ctx.file_copy + 1}.{$files[_ctx.file_kind].extension}"),
  size: $files[_ctx.file_kind].size + _ctx.file_copy * 1024,
}
_ctx.file.path = f"{$files[_ctx.file_kind].directory}/{_ctx.file.name}"
drop _ctx.file_kind, _ctx.file_copy
