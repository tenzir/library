let $processes = ocsf_generate::$processes
_ctx.executable = $processes[int(random() * $processes.length())]
process = {
  uid: uuid(), pid: 1000 + int(random() * 30000), user: _ctx.user,
  name: _ctx.executable.win_name if _ctx.windows else _ctx.executable.name,
  cmd_line: _ctx.executable.win_cmd_line if _ctx.windows else _ctx.executable.cmd_line,
  file: {name: _ctx.executable.win_name if _ctx.windows else _ctx.executable.name,
    path: _ctx.executable.win_path if _ctx.windows else _ctx.executable.path, type_id: 8},
}
