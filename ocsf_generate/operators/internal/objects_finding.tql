---
description: Relate sampled findings to MITRE ATT&CK tactics and techniques.
---

if class_uid == 2004 {
  finding_info.attacks = [{
    tactic: {uid: "TA0006", name: "Credential Access"},
    technique: {uid: "T1110", name: "Brute Force"},
  }]
  if _ctx.variant >= 70 and _ctx.variant < 80 {
    finding_info.attacks = [{tactic: {uid: "TA0002", name: "Execution"}, technique: {uid: "T1059", name: "Command and Scripting Interpreter"}}]
  } else if _ctx.variant >= 80 and _ctx.variant < 95 {
    finding_info.attacks = [{tactic: {uid: "TA0011", name: "Command and Control"}, technique: {uid: "T1071", name: "Application Layer Protocol"}}]
  } else if _ctx.variant >= 95 {
    finding_info.attacks = [{tactic: {uid: "TA0001", name: "Initial Access"}, technique: {uid: "T1078", name: "Valid Accounts"}}]
  }
  if metadata.profiles? != null {
    if "security_control" in metadata.profiles {
      attacks = finding_info.attacks
    }
  }
  _ctx.source.attack_technique = finding_info.attacks[0].technique.uid
  _ctx.source.attack_tactic = finding_info.attacks[0].tactic.uid
}
