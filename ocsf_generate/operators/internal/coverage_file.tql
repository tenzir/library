let $files = ocsf_generate::$files
_ctx.file = $files[int(random() * $files.length())]
file = {name: _ctx.file.name, type_id: 1, size: _ctx.file.size,
  path: ("C:\\Users\\" + _ctx.user.name + "\\" + _ctx.file.path.replace("/", "\\") if _ctx.windows
    else f"/Users/{_ctx.user.name}/{_ctx.file.path}" if _ctx.macos
    else f"/home/{_ctx.user.name}/{_ctx.file.path}"),
}
ocsf_generate::internal::randomize_file
