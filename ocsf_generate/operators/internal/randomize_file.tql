// Keep recurring files, and add unique artifacts without changing extensions.
let $randomization = ocsf_generate::$randomization
if random() < $randomization.file_probability {
  _ctx.original_file_name = file.name
  _ctx.file_name_parts = file.name.split(".", max=1, reverse=true)
  file.name = f"{_ctx.file_name_parts[0]}-{uuid()}"
  if _ctx.file_name_parts.length() == 2 {
    file.name = f"{file.name}.{_ctx.file_name_parts[1]}"
  }
  file.path = file.path.replace(_ctx.original_file_name, file.name)
  drop _ctx.original_file_name, _ctx.file_name_parts
}
