---
description: Build a 1.6 internal TCP connection to an HTTPS service.
---

let $services = ocsf_generate::$services
@name = "ocsf.network_activity"
category_uid = 4
activity_id = 1
actor.process = _ctx.process
src_endpoint = {ip: device.ip, hostname: device.hostname, port: 49152 + int(random() * 16384)}
dst_endpoint = {
  ip: ip($services.ip[_ctx.service_index]), hostname: $services.hostname[_ctx.service_index],
  port: 443,
}
connection_info = {protocol_num: 6, protocol_name: "tcp", direction_id: 3}
message = f"Opened TCP connection to {dst_endpoint.hostname}:443"
_ctx.source = {src_ip: string(src_endpoint.ip), dst_ip: string(dst_endpoint.ip), dst_port: dst_endpoint.port}
