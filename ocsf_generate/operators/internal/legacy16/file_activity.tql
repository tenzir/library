---
description: Build a 1.6 file creation with its singular digital signature.
---

@name = "ocsf.file_activity"
category_uid = 1
activity_id = 1
actor.process = _ctx.process
file = {
  name: "agent.exe" if _ctx.windows else "agent",
  path: "C:\\Program Files\\Acme\\agent.exe" if _ctx.windows else "/opt/acme/agent",
  type_id: 8, size: 262144,
}
if _ctx.windows {
  // Synthetic signature metadata; its verification state is unknown.
  file.signature = {algorithm_id: 4, state_id: 0, developer_uid: "synthetic-acme"}
}
message = f"Created {file.path}"
_ctx.source = {file_path: file.path, process_id: actor.process.uid}
