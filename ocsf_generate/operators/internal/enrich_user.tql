---
description: Decorate the user in _ctx.entity without changing its identity or account state.
---

_ctx.entity.full_name = _ctx.entity.name? else _ctx.entity.uid
_ctx.entity.has_mfa = _ctx.entity.type_id? in [1, 2]
_ctx.entity.account = {
  uid: _ctx.entity.uid? else _ctx.entity.name,
  name: _ctx.entity.name? else _ctx.entity.uid,
  type_id: 1,
  is_locked: false,
  ...(_ctx.entity.account? else {}),
}
