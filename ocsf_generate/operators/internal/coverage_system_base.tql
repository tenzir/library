// Generic endpoint observations; no invented native vendor event family.
drop src_endpoint, dst_endpoint
metadata.product = {name: "osquery", vendor_name: "osquery Project"}
metadata.log_name = "endpoint-observations"
metadata.profiles = ["host"]
_ctx.native = "generic"
device = {uid: _ctx.host.uid, hostname: _ctx.host.hostname, ip: ip(_ctx.host.ip), type_id: 99, type: "Workstation"}
device.os = ({name: "Windows", type_id: 100, version: "11"} if _ctx.windows
  else {name: "macOS", type_id: 300, version: "15.0"} if _ctx.macos
  else {name: "Ubuntu", type_id: 200, version: "24.04"})
actor = {user: _ctx.user, process: {
  uid: uuid(), pid: 700,
  name: "osqueryd.exe" if _ctx.windows else "osqueryd",
  file: {name: "osqueryd.exe" if _ctx.windows else "osqueryd",
    path: r"C:\Program Files\osquery\osqueryd.exe" if _ctx.windows else "/usr/local/bin/osqueryd" if _ctx.macos else "/usr/bin/osqueryd", type_id: 8},
}}
