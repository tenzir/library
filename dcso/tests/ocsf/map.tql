// Start with unrolled events.
from_file f"{env("TENZIR_INPUTS")}/sample.json" {
  read_json raw=true
}

// Type cleaning copied from dcso::tie::fetch
// DCSO writes microseconds. Rounding to them undoes the one-nanosecond error
// with which Tenzir 6.23 and 7.0.0-rc.6 parse some fractions; remove it once
// every supported version parses times exactly (Linear TNZ-2181).
created = created.time().round(1us)
modified = modified.time().round(1us)
if (firstSeen? != null) {
  firstSeen = firstSeen.time().round(1us)
}
if (lastSeen? != null) {
  lastSeen = lastSeen.time().round(1us)
}
lastFeedOccurence = lastFeedOccurence.time().round(1us)

// The tested operator.
this = {source: this, ocsf: {}}
dcso::tie::ocsf::map source, ocsf
this = ocsf

// Ensure OCSF compliance.
this = ocsf_cast(this)

// Fix non-determinism.
time = 2025-01-01
