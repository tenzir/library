---
description: Maps a structured DCSO TIE IOC to OCSF 1.9 OSINT Inventory Info.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---


// Official schema definition: https://docs.dcso.de/docs/tie/tiev3/ioc_schema_definition

// ------ OSINT Object --------

$ocsf = {}
$ocsf.osint = {}

// MITRE ATT&CK
$ocsf.osint.attacks = [
  ...$event.mitreTactics.map(x => {tactic: {uid: x}}),
  ...$event.mitreTechniques.map(x => {technique: {uid: x}}),
]
drop $event.mitreTactics, $event.mitreTechniques

// The OCSF OSINT object has just one campaign per IOC. This is arguably
// incorrect, as an IOC can certainly be part of multiple campaigns.
// Our workaround is to join the provided campaigns with a comma.
$ocsf.osint.campaign = {
  name: $event.targetCampaigns?.join(", ")
}
drop $event.targetCampaigns

// The TIE confidence is in [0,100].
match $event.confidence? {
  null => {}
  0..29 => {
    $ocsf.osint.confidence_id = 1 // Low
  }
  30..69 => {
    $ocsf.osint.confidence_id = 2 // Medium
  }
  _ => {
    $ocsf.osint.confidence_id = 3 // High
  }
}
drop $event.confidence?
$ocsf.osint.created_time = move $event.created
$ocsf.osint.labels = move $event.tags

// This is not the best place to put the MISP event IDs.
$ocsf.osint.malware = $event.malpedia?.map(x => {
  name: x,
  classification_ids: [0], // unknown
})
drop $event.malpedia

$ocsf.osint.modified_time = move $event.modified
$ocsf.osint.references = move $event.eventIDs
$ocsf.osint.src_url = "https://api.dcso.de/tie/v3/iocs/" + encode_url($event.ioc)

// Map threat actors.
let $tlps = {
  clear: "CLEAR",
  green: "GREEN",
  amber: "AMBER",
  "amber+strict": "AMBER STRICT",
  red: "RED",
}
$ocsf.osint.tlp = $tlps[move $event.tlpLevel]?
// Same as above: our source has an array here but we must map it to a
// singular object.
$ocsf.osint.threat_actor = {
  name: $event.threatActors?.join(", "),
}
drop $event.threatActors

// Map severity from [0,100].
match $event.severity? {
  null => {}
  0..19 => {
    $ocsf.osint.severity_id = 1 // Informational
  }
  20..39 => {
    $ocsf.osint.severity_id = 2 // Low
  }
  40..59 => {
    $ocsf.osint.severity_id = 3 // Medium
  }
  60..79 => {
    $ocsf.osint.severity_id = 4 // High
  }
  80..89 => {
    $ocsf.osint.severity_id = 5 // Critical
  }
  _ => {
    $ocsf.osint.severity_id = 6 // Fatal
  }
}
drop $event.severity?
// Map IOC type.
let $type_ids = {
  domain: 2,
  domainPort: 99,
  ip: 1,
  ipPort: 99,
  md5: 4,
  filename: 11,
  filepath: 11,
  email: 9, // API mismatch, doesn't exist in docs but in data
  emailAddress: 9,
  emailSubject: 8,
  registryKey: 12,
  registryValue: 13,
  mutex: 99,
  sha1: 4,
  sha256: 4,
  ssdeep: 4,
  url: 5,
  userAgent: 6,
}
$ocsf.osint.type_id = $type_ids[move $event.iocType]
$ocsf.osint.value = move $event.ioc

$ocsf.osint.vendor_name = "DCSO"

// ------ OSINT Inventory Info --------

// Classification
$ocsf.activity_id = 2
$ocsf.category_uid = 5
$ocsf.class_uid = 5021
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
// Context
$ocsf.actor = {
  app_name: "Tenzir"
}
$ocsf.metadata = {
  product: {
    name: "TIE",
    vendor_name: "DCSO",
  },
  version: "1.9.0",
}
// Occurence
$ocsf.time = $ocsf.osint.modified_time? else $ocsf.osint.created_time? else now()
// Primary
$ocsf.osint = [$ocsf.osint]

// ------ Epilogue --------


@name = "ocsf.osint_inventory_info"

$ocsf.unmapped = move $event
