---
description: Maps a structured DCSO TIE IOC to OCSF 1.9 OSINT Inventory Info.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The structured TIE IOC to map.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the OCSF event.
---


// Official schema definition: https://docs.dcso.de/docs/tie/tiev3/ioc_schema_definition

// ------ OSINT Object --------

$into = {tie: $event, ocsf: {}}
$into.osint = {}

// MITRE ATT&CK
$into.tactics = $into.tie.mitreTactics.map(x => {
  tactic: {
    uid: x
  }
})
$into.techniques = $into.tie.mitreTechniques.map(x => {
  technique: {
    uid: x
  }
})
$into.osint.attacks = [...(move $into.tactics), ...(move $into.techniques)]
drop $into.tie.mitreTactics, $into.tie.mitreTechniques

// The OCSF OSINT object has just one campaign per IOC. This is arguably
// incorrect, as an IOC can certainly be part of multiple campaigns.
// Our workaround is to join the provided campaigns with a comma.
$into.osint.campaign = {
  name: $into.tie.targetCampaigns?.join(", ")
}
drop $into.tie.targetCampaigns

// The TIE confidence is in [0,100].
if $into.tie.confidence? != null {
  if $into.tie.confidence < 30 {
    $into.osint.confidence_id = 1 // Low
  } else if $into.tie.confidence < 70 {
    $into.osint.confidence_id = 2 // Medium
  } else {
    $into.osint.confidence_id = 3 // High
  }
  drop $into.tie.confidence
}
$into.osint.created_time = move $into.tie.created
$into.osint.labels = move $into.tie.tags

// This is not the best place to put the MISP event IDs.
$into.osint.malware = $into.tie.malpedia?.map(x => {
  name: x,
  classification_ids: [0], // unknown
})
drop $into.tie.malpedia

$into.osint.modified_time = move $into.tie.modified
$into.osint.references = move $into.tie.eventIDs
$into.osint.src_url = "https://api.dcso.de/tie/v3/iocs/" + encode_url($into.tie.ioc)

// Map threat actors.
let $tlps = {
  clear: "CLEAR",
  green: "GREEN",
  amber: "AMBER",
  "amber+strict": "AMBER STRICT",
  red: "RED",
}
$into.osint.tlp = $tlps[move $into.tie.tlpLevel]?
// Same as above: our source has an array here but we must map it to a
// singular object.
$into.osint.threat_actor = {
  name: $into.tie.threatActors?.join(", "),
}
drop $into.tie.threatActors

// Map severity from [0,100].
if $into.tie.severity? != null {
  if $into.tie.severity < 20 {
    $into.osint.severity_id = 1 // Informational
  } else if $into.tie.severity < 40 {
    $into.osint.severity_id = 2 // Low
  } else if $into.tie.severity < 60 {
    $into.osint.severity_id = 3 // Medium
  } else if $into.tie.severity < 80 {
    $into.osint.severity_id = 4 // High
  } else if $into.tie.severity < 90 {
    $into.osint.severity_id = 5 // Critical
  } else {
    $into.osint.severity_id = 6 // Fatal
  }
  drop $into.tie.severity
}
// Map IOC type.
let $type_ids = {
  domain: 2,
  domainPort: 99,
  ip: 1,
  ipPort: 99,
  md5: 4,
  filename: 11,
  filepath: 11,
  email: 9, // API mismatch, doesn't exist in docs but in data
  emailAddress: 9,
  emailSubject: 8,
  registryKey: 12,
  registryValue: 13,
  mutex: 99,
  sha1: 4,
  sha256: 4,
  ssdeep: 4,
  url: 5,
  userAgent: 6,
}
$into.osint.type_id = $type_ids[move $into.tie.iocType]
$into.osint.value = move $into.tie.ioc

$into.osint.vendor_name = "DCSO"

// ------ OSINT Inventory Info --------

$into.ocsf = {}
// Classification
$into.ocsf.activity_id = 2
$into.ocsf.category_uid = 5
$into.ocsf.class_uid = 5021
$into.ocsf.severity_id = 1
$into.ocsf.type_uid = $into.ocsf.class_uid * 100 + $into.ocsf.activity_id
// Context
$into.ocsf.actor = {
  app_name: "Tenzir"
}
$into.ocsf.metadata = {
  product: {
    name: "TIE",
    vendor_name: "DCSO",
  },
  version: "1.9.0",
}
// Occurence
$into.ocsf.time = $into.osint.modified_time? else $into.osint.created_time? else now()
// Primary
$into.ocsf.osint = [move $into.osint]

// ------ Epilogue --------


@name = "ocsf.osint_inventory_info"

$into = {...$into.ocsf, unmapped: $into.tie}
