---
{
  "fixtures": [
    {
      "jev_api": {
        "secrets": false
      }
    }
  ],
  "assertions": {
    "fixtures": {
      "jev_api": {
        "batch_sizes": [
          1
        ],
        "questions": [
          {
            "question": {
              "type": "score",
              "instructions": "Assess this security log.",
              "criteria": [
                "Routine",
                "Soon",
                "Immediate"
              ]
            }
          }
        ],
        "states": [
          "Log"
        ],
        "model": "local-model",
        "authorization": null
      }
    }
  }
}
---

from {raw: "Log"}
jev::score "Assess this security log.", ["Routine", "Soon", "Immediate"], state=raw, url=env("JEV_API_URL"), model="local-model", api_key_secret_name=""
write_ndjson
