---
{
  "fixtures": [
    "jev_api"
  ],
  "assertions": {
    "fixtures": {
      "jev_api": {
        "batch_sizes": [
          1
        ],
        "state_batches": [
          [
            "1"
          ]
        ],
        "authorization": "Bearer override-dummy",
        "model": "test-model",
        "paths": [
          "/v1/systemone/batch"
        ]
      }
    }
  }
}
---

from {states: ["1"], questions: {pii: {type: "noul", instructions: "Personal data?"}}}
jev::ask_batch states, questions, url=env("JEV_API_URL") + "/batch", model="test-model", api_key="JEV_REVIEW_DUMMY"
select probability=results[0].answers.pii.noul
write_ndjson
