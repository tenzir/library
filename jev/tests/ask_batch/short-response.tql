---
{
  "fixtures": [
    {
      "jev_api": {
        "omit_last_batch_result": true
      }
    }
  ],
  "assertions": {
    "fixtures": {
      "jev_api": {
        "batch_sizes": [
          1
        ],
        "state_batch_sizes": [
          2
        ],
        "paths": [
          "/v1/systemone/batch"
        ]
      }
    }
  }
}
---

from {states: ["1", "2"], questions: {pii: {type: "noul", instructions: "Personal data?"}}}
jev::ask_batch states, questions, url=env("JEV_API_URL") + "/batch"
summarize returned=count()
write_ndjson
