---
{
  "fixtures": [
    {
      "jev_api": {
        "secrets": false
      }
    }
  ],
  "assertions": {
    "fixtures": {
      "jev_api": {
        "batch_sizes": [
          1
        ],
        "state_batches": [
          [
            "1",
            "2"
          ]
        ],
        "authorization": null,
        "paths": [
          "/v1/systemone/batch"
        ]
      }
    }
  }
}
---

from {states: ["1", "2"], questions: {pii: {type: "noul", instructions: "Personal data?"}}}
jev::ask_batch states, questions, url=env("JEV_API_URL") + "/batch", api_key_secret_name=""
select probabilities=results.map(r => r.answers.pii.noul), total_usage
write_ndjson
