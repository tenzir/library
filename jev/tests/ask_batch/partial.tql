          "/v1/systemone/batch"
        ]
      }
    }
  }
}
---

from {original: "preserved"}
repeat 65
enumerate id
window size=64 {
  summarize events=collect(this)
  states = events.map(e => string(e.id))
  questions = {pii: {type: "noul", instructions: "Does this log contain personal data?"}}
  jev::ask_batch states, questions, url=env("JEV_API_URL") + "/batch"
  pairs = zip(events, results)
  unroll pairs
  this = {...pairs.left, answer: pairs.right.answers.pii.noul, usage: pairs.right.usage}
}
summarize events=count(), unique_ids=count_distinct(id),
  matched=all(answer == id / 1000.0),
  preserved=all(original == "preserved" and usage.input_tokens == 10)
write_ndjson
