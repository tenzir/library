---
fixtures: [{jev_api: {response_delay: 0.2}}]
assertions:
  fixtures:
    jev_api:
      batch_sizes: [1, 1, 1]
      state_batch_sizes: [2, 2, 2]
      paths: [/v1/systemone/batch, /v1/systemone/batch, /v1/systemone/batch]
      max_concurrent_requests: 1
---

from {states: ["1", "2"], questions: {check: {type: "noul", instructions: "Personal data?"}}}
repeat 3
enumerate id
jev::ask_batch states, questions, url=env("JEV_API_URL") + "/batch"
select id, probabilities=results.map(r => r.answers.check.noul)
write_ndjson
