---
{
  "fixtures": [
    "jev_api"
  ],
  "assertions": {
    "fixtures": {
      "jev_api": {
        "batch_sizes": [
          1,
          1
        ],
        "questions": [
          {
            "question": {
              "type": "noul",
              "instructions": {
                "task": "Question 1",
                "treat_as_data": true
              }
            }
          },
          {
            "question": {
              "type": "noul",
              "instructions": {
                "task": "Question 2",
                "treat_as_data": true
              }
            }
          }
        ],
        "states": [
          "Context: Log 1",
          "Context: Log 2"
        ]
      }
    }
  }
}
---

from {"id": 1, "raw": "Log 1", "instructions": {"task": "Question 1", "treat_as_data": true}, "criteria": ["Low", "High"]},
     {"id": 2, "raw": "Log 2", "instructions": {"task": "Question 2", "treat_as_data": true}, "criteria": ["Low", "Medium", "High"]}
jev::noul instructions, state=f"Context: {raw}", url=env("JEV_API_URL")
select id, answer
sort id
write_ndjson
