---
{
  "fixtures": [
    {
      "jev_api": {
        "secrets": false
      }
    }
  ],
  "assertions": {
    "fixtures": {
      "jev_api": {
        "batch_sizes": [
          1
        ],
        "questions": [
          {
            "question": {
              "type": "noul",
              "instructions": "Assess this security log."
            }
          }
        ],
        "states": [
          "Log"
        ],
        "model": "local-model",
        "authorization": null
      }
    }
  }
}
---

from {raw: "Log"}
jev::noul "Assess this security log.", state=raw, url=env("JEV_API_URL"), model="local-model", api_key=""
write_ndjson
