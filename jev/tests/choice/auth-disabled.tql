---
{
  "fixtures": [
    {
      "jev_api": {
        "secrets": false
      }
    }
  ],
  "assertions": {
    "fixtures": {
      "jev_api": {
        "batch_sizes": [
          1
        ],
        "questions": [
          {
            "question": {
              "type": "choice",
              "instructions": "Assess this security log.",
              "criteria": {
                "authentication": "Authentication",
                "unknown": "Unknown"
              }
            }
          }
        ],
        "states": [
          "Log"
        ],
        "model": "local-model",
        "authorization": null
      }
    }
  }
}
---

from {raw: "Log"}
jev::choice "Assess this security log.", {"authentication": "Authentication", "unknown": "Unknown"}, state=raw, url=env("JEV_API_URL"), model="local-model", api_key=""
write_ndjson
