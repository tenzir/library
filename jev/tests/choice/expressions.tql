---
{
  "fixtures": [
    "jev_api"
  ],
  "assertions": {
    "fixtures": {
      "jev_api": {
        "batch_sizes": [
          1,
          1
        ],
        "questions": [
          {
            "question": {
              "type": "choice",
              "instructions": {
                "task": "Question 1",
                "treat_as_data": true
              },
              "criteria": {
                "a": "Authentication",
                "b": "Unknown"
              }
            }
          },
          {
            "question": {
              "type": "choice",
              "instructions": {
                "task": "Question 2",
                "treat_as_data": true
              },
              "criteria": {
                "b": "DNS",
                "a": "Unknown"
              }
            }
          }
        ],
        "states": [
          "Context: Log 1",
          "Context: Log 2"
        ]
      }
    }
  }
}
---

from {"id": 1, "raw": "Log 1", "instructions": {"task": "Question 1", "treat_as_data": true}, "criteria": {"a": "Authentication", "b": "Unknown"}},
     {"id": 2, "raw": "Log 2", "instructions": {"task": "Question 2", "treat_as_data": true}, "criteria": {"b": "DNS", "a": "Unknown"}}
jev::choice instructions, criteria, state=f"Context: {raw}", url=env("JEV_API_URL")
select id, answer
sort id
write_ndjson
