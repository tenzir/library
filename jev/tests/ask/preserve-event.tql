---
fixtures: [jev_api]
assertions:
  fixtures:
    jev_api:
      batch_sizes: [1, 1]
      questions:
        - check:
            type: "noul"
            instructions: "First question"
        - check:
            type: "noul"
            instructions: "Second question"
      states: ["Each question carries its own data.", "Each question carries its own data."]
---

from {
  id: 1,
  jev_questions: "keep me",
  event: "keep me too",
  payload: {
    questions: {
      check: {
        type: "noul",
        instructions: "First question",
      },
    },
  },
  answers: {
    old: "replace me",
  },
  usage: {
    old: "replace me",
  },
},
     {
       id: 2,
       jev_questions: "also keep me",
       event: "also keep me too",
       payload: {
         questions: {
           check: {
             type: "noul",
             instructions: "Second question",
           },
         },
       },
       answers: {
         old: "replace me",
       },
       usage: {
         old: "replace me",
       },
     }
jev::ask payload.questions, url=env("JEV_API_URL")
sort id
write_ndjson
