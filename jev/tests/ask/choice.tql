---
fixtures: [jev_api]
assertions:
  fixtures:
    jev_api:
      batch_sizes: [1]
      questions:
        - check:
            type: "choice"
            instructions:
              message: "Login succeeded for alex.morgan@example.com."
              question: "Which OCSF class fits this log?"
            criteria:
              authentication: "Authentication"
              http_activity: "HTTP Activity"
---

from {
  questions: {
    check: {
      type: "choice",
      instructions: {
        message: "Login succeeded for alex.morgan@example.com.",
        question: "Which OCSF class fits this log?",
      },
      criteria: {
        authentication: "Authentication",
        http_activity: "HTTP Activity",
      },
    },
  },
}
jev::ask questions, url=env("JEV_API_URL")
select answers, usage
write_ndjson
