---
fixtures: [jev_api]
assertions:
  fixtures:
    jev_api:
      batch_sizes: [1]
      authorization: "Bearer default-dummy"
---

from {
  questions: {
    check: {
      type: "noul",
      instructions: "Does this log contain personal data?",
    },
  },
}
jev::ask questions, url=env("JEV_API_URL"), api_key=null
select answers
write_ndjson
