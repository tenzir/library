---
fixtures:
  - jev_api:
      reverse_answers: true
assertions:
  fixtures:
    jev_api:
      batch_sizes: [3]
---

from {questions: {
  "2": {type: "noul", instructions: "Does this event contain personal data?"},
  "10": {type: "noul", instructions: "Does this event contain personal data?"},
  named: {type: "noul", instructions: "Does this event contain personal data?"},
}}
jev::ask questions, url=env("JEV_API_URL")
select ids=answer_list.map(answer => answer.id)
write_ndjson
