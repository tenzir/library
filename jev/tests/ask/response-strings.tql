---
fixtures: [jev_api]
assertions:
  fixtures:
    jev_api:
      batch_sizes: [1]
      questions:
        - check:
            type: "choice"
            instructions: "Select a label."
            criteria:
              "192.0.2.1": "An address"
              other: "Other"
---

from {
  questions: {
    check: {
      type: "choice",
      instructions: "Select a label.",
      criteria: {
        "192.0.2.1": "An address",
        other: "Other",
      },
    },
  },
}
jev::ask questions, url=env("JEV_API_URL")
select choice=answers.check.choice, kind=type_of(answers.check.choice).kind
write_ndjson
