---
fixtures: [jev_api]
assertions:
  fixtures:
    jev_api:
      batch_sizes: [1]
      questions:
        - check:
            type: "score"
            instructions: "How urgent is this security event?"
            criteria:
              - "Routine"
              - "Soon"
              - "Immediate"
---

from {
  questions: {
    check: {
      type: "score",
      instructions: "How urgent is this security event?",
      criteria: ["Routine", "Soon", "Immediate"],
    },
  },
}
jev::ask questions, url=env("JEV_API_URL")
select answers, usage
write_ndjson
