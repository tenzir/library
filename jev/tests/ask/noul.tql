---
fixtures: [jev_api]
assertions:
  fixtures:
    jev_api:
      batch_sizes: [1]
      states: [Each question carries its own data.]
      questions:
        - check:
            type: noul
            instructions: Does this log contain personal data?
---

from {questions: {check: {type: "noul", instructions: "Does this log contain personal data?"}}}
jev::ask questions, url=env("JEV_API_URL")
select answers, usage
