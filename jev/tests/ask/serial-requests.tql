---
fixtures: [{jev_api: {response_delay: 0.2}}]
assertions:
  fixtures:
    jev_api:
      batch_sizes: [1, 1, 1]
      states: ["Log 0", "Log 1", "Log 2"]
      max_concurrent_requests: 1
---

from {questions: {check: {type: "noul", instructions: "Personal data?"}}}
repeat 3
enumerate id
jev::ask questions, state=f"Log {id}", url=env("JEV_API_URL")
select id, probability=answers.check.noul
write_ndjson
