from {questions: {
  pii: {type: "noul", instructions: "Does this event contain personal data?"},
  category: {type: "choice", instructions: "Which OCSF class fits?", criteria: {"3002": "Authentication", unknown: "Unknown"}},
  priority: {type: "score", instructions: "How urgent is this event?", criteria: ["Routine", "Immediate"]},
}}
jev::ask questions, url=env("JEV_API_URL")
select array
write_ndjson
