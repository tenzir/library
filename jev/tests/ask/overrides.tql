---
fixtures: [jev_api]
assertions:
  fixtures:
    jev_api:
      batch_sizes: [1]
      model: "test-model"
      authorization: "Bearer override-dummy"
      states: ["Test state"]
      questions:
        - check:
            type: "noul"
            instructions: "Does this log contain personal data?"
---

from {
  questions: {
    check: {
      type: "noul",
      instructions: "Does this log contain personal data?",
    },
  },
}
jev::ask questions, url=env("JEV_API_URL"), model="test-model", api_key_secret_name="JEV_REVIEW_DUMMY", state="Test state"
select answers
write_ndjson
