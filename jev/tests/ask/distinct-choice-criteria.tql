---
fixtures: [jev_api]
assertions:
  fixtures:
    jev_api:
      batch_sizes: [2]
      questions:
        - ocsf:
            type: choice
            instructions: Class?
            criteria:
              "3002": Authentication
              unknown: Unknown
          severity:
            type: choice
            instructions: Severity?
            criteria:
              "1": Informational
              "0": Unknown
---

from {questions: {
  ocsf: {type: "choice", instructions: "Class?", criteria: {"3002": "Authentication", unknown: "Unknown"}},
  severity: {type: "choice", instructions: "Severity?", criteria: {"1": "Informational", "0": "Unknown"}},
}}
jev::ask questions, url=env("JEV_API_URL")
select class_choice=answers.ocsf.choice, severity_choice=answers.severity.choice
write_ndjson
