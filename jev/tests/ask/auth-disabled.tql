---
fixtures: [{jev_api: {secrets: false}}]
assertions:
  fixtures:
    jev_api:
      batch_sizes: [1]
      authorization: null
      questions:
        - check:
            type: "noul"
            instructions: "Does this log contain personal data?"
---

from {
  questions: {
    check: {
      type: "noul",
      instructions: "Does this log contain personal data?",
    },
  },
}
jev::ask questions, url=env("JEV_API_URL"), api_key_secret_name=""
select answers
write_ndjson
