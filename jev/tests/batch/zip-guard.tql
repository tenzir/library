from {case: "matching", events: [{index: 1}, {index: 0}], array: [{id: "1", score: 0.8}, {id: "0", score: 0.2}]},
     {case: "missing", events: [{index: 0}, {index: 1}], array: [{id: "0", score: 0.2}]},
     {case: "wrong-id", events: [{index: 0}, {index: 1}], array: [{id: "0", score: 0.2}, {id: "2", score: 0.8}]}
events = events.sort(cmp=(a, b) => a.index < b.index)
array = array.sort(cmp=(a, b) => int(a.id) < int(b.id))
assert array.length() == events.length(), message="Answer count does not match event count"
pairs = zip(events, array)
assert pairs.map(pair => pair.right.id == string(pair.left.index)).all(),
  message="Answer IDs do not match event IDs"
unroll pairs
this = {case: case, ...pairs.left, answer: pairs.right}

write_ndjson
