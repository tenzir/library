---
fixtures: [jev_api]
assertions:
  fixtures:
    jev_api:
      batch_sizes: []
      states: []
---

from {message: "Test message", original: "preserved"}
where false
enumerate id
window size=64 {
  summarize events=collect(this), questions=collect_record(string(id), {type: "noul", instructions: message})
  jev::ask questions, url=env("JEV_API_URL")
  unroll events
  this = {...events, answer: answers[string(events.id)].noul}
}
write_ndjson
