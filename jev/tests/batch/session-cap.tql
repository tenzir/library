---
fixtures: [jev_api]
assertions:
  fixtures:
    jev_api:
      batch_sizes: [3, 3, 1]
      question_ids: ["0", "1", "2", "3", "4", "5", "6"]
---

from {time: 2026-09-29T12:00:00, message: "Same message"}
repeat 7
enumerate id
window gap=2s, size=3, on=time {
  summarize events=collect(this), questions=collect({
    key: string(id),
    value: {type: "noul", instructions: message},
  })
  jev::collect_record questions
  jev::ask questions, url=env("JEV_API_URL")
  unroll events
  this = {...events, answer: answers[string(events.id)].noul}
}
select id, message, answer
sort id
write_ndjson
