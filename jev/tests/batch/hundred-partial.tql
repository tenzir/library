---
fixtures: [jev_api]
assertions:
  fixtures:
    jev_api:
      batch_sizes: [100, 100, 1]
      states:
        - "Each question carries its own data."
        - "Each question carries its own data."
        - "Each question carries its own data."
---

from {message: "Test message", original: "preserved"}
repeat 201
enumerate id
window size=100 {
  summarize events=collect(this), questions=collect_record(string(id), {type: "noul", instructions: message})
  jev::ask questions, url=env("JEV_API_URL")
  unroll events
  this = {...events, answer: answers[string(events.id)].noul}
}
summarize events=count(), unique_ids=count_distinct(id), answered=count(answer),
  matched=all(answer == id / 1000.0),
  preserved=all(original == "preserved" and message == "Test message")
write_ndjson
