---
fixtures:
  - jev_api:
      reverse_answers: true
assertions:
  fixtures:
    jev_api:
      batch_sizes: [100, 100, 1]
---

from {time: 2026-09-30T12:00:00, message: "Synthetic command event"}
repeat 201
enumerate index

window gap=2s, size=100, on=time {
  summarize events=collect(this), questions=collect({
    key: string(index),
    value: {type: "noul", instructions: message},
  })
  jev::collect_record questions
  jev::ask questions, url=env("JEV_API_URL")

  assert answer_list.length() == events.length(), message="Answer count does not match event count"
  pairs = zip(events, answer_list)
  assert pairs.map(pair => pair.right.id == string(pair.left.index)).all(),
    message="Answer IDs do not match event IDs"
  unroll pairs
  this = {...pairs.left, answer: pairs.right.noul}
}

enumerate output_index
summarize events=count(), order_preserved=all(index == output_index),
  answers_matched=all(answer == index / 1000.0)
write_ndjson
