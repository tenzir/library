from {
  activity_id: 1,
  category_uid: 3,
  class_uid: 3002,
  type_uid: 300201,
  severity_id: 1,
  time: 1790683200000,
  metadata: {
    version: "1.9.0",
    product: {name: "Synthetic identity provider", vendor_name: "Example"},
  },
  service: {name: "ssh"},
  status_id: 1,
  user: {
    type_id: 1,
    name: "alex.morgan",
    full_name: "Alex Morgan",
    email_addr: "alex.morgan@example.com",
  },
  src_endpoint: {ip: "192.0.2.10"},
  message: "User logon succeeded",
}, {
  activity_id: 1,
  category_uid: 3,
  class_uid: 3002,
  type_uid: 300201,
  severity_id: 1,
  time: 1790683200000,
  metadata: {
    version: "1.9.0",
    product: {name: "Synthetic identity provider", vendor_name: "Example"},
  },
  service: {name: "ssh"},
  status_id: 1,
  user: {type_id: 4, name: "svc-backup"},
  src_endpoint: {ip: "192.0.2.10"},
  message: "Service account logon succeeded",
}

this = {event: this}

questions = {
  email: {type: "noul", instructions: "Does this event contain a personal email address?"},
  person: {type: "noul", instructions: "Does this event contain the full name of a person?"},
}
jev::ask questions, state=print_json(event)

// Check known identity fields independently of model predictions.
privacy.populated_identity_fields = [
  "user.email_addr" if (event.user.email_addr? else "") != "" else null,
  "user.full_name" if (event.user.full_name? else "") != "" else null,
].where(path => path != null)

privacy.email_probability = answers.email.noul
privacy.person_name_probability = answers.person.noul
privacy.model_usage = usage

drop questions, answers, array, usage
