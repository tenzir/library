---
description: |
  Sends `questions` (a record of typed Jev questions, keyed by id) to Jev in
  one request and adds `answers` and `usage` to the event. All other fields
  of the event are kept. `url`, `model`, and `api_key` default to the
  package constants in `constants.tql`.
args:
  positional:
    - name: questions
      type: field
      description: The record of questions to ask.
  named:
    - name: url
      type: string
      description: The System One endpoint. Defaults to `jev::$url`.
      default: null
    - name: model
      type: string
      description: The model slug. Defaults to `jev::$model`.
      default: null
    - name: api_key
      type: string
      description: Name of the secret that holds the API key. Defaults to `jev::$api_key`. Use an empty string to omit authentication.
      default: null
    - name: state
      type: string
      description: Shared context for the questions, evaluated for each input event.
      default: "Each question carries its own data."
---

let $jev_url = $url else jev::$url
let $jev_model = $model else jev::$model
let $jev_api_key = $api_key else jev::$api_key

this = {event: this, questions: $questions, state: $state}
each {
  let $body = {
    model: $jev_model,
    state: $this.state,
    questions: $this.questions,
  }

  from_http $jev_url,
    headers=({} if $jev_api_key == "" else {Authorization: f"Bearer {secret($jev_api_key)}"}),
    body=$body {
    read_json raw=true
  }
  this = {...$this.event, answers: answers, usage: usage}
}
