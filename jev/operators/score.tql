---
description: |
  Score against ordered criteria through `jev::ask`.
  Preserves input fields and sets `answer` to the complete typed answer and
  `usage` to the request usage, replacing those fields if present.
args:
  positional:
    - name: instructions
      description: The question instructions, evaluated for each input event.
    - name: criteria
      description: An ordered list of descriptions, from lowest to highest score.
  named:
    - name: state
      type: string
      description: Context for the question, evaluated for each input event.
      default: "Each question carries its own data."
    - name: url
      type: string
      description: The System One endpoint. Defaults to `jev::$url`.
      default: null
    - name: model
      type: string
      description: The model identifier. Defaults to `jev::$model`.
      default: null
    - name: api_key_secret_name
      type: string
      description: The managed secret name. Use an empty string to omit authentication.
      default: null
---

this = {event: this, state: $state, questions: {question: {
  type: "score",
  instructions: $instructions,
  criteria: $criteria,
}}}
jev::ask questions, state=state, url=$url, model=$model, api_key_secret_name=$api_key_secret_name
this = {...event, answer: answers.question, usage: usage}
