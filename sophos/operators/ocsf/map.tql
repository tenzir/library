---
description: Maps a structured Sophos Central event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The structured Sophos event to map.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the OCSF event.
---


$into = {sophos: $event, ocsf: {}}

$into.ocsf.metadata = {
  product: {
    vendor_name: "Sophos",
    feature: {
      name: "Sophos Central",
    },
  },
  version: "1.9.0",
}

if $into.sophos.customer_id? != null {
  $into.ocsf.metadata.tenant_uid = move $into.sophos.customer_id
}
if $into.sophos.tenant?.id? != null {
  $into.ocsf.metadata.tenant_uid = move $into.sophos.tenant.id
}
if $into.sophos.id? != null {
  $into.ocsf.metadata.original_event_uid = move $into.sophos.id
}
if $into.sophos.data? != null and $into.sophos.data.correlation_id? != null {
  $into.ocsf.metadata.correlation_uid = move $into.sophos.data.correlation_id
}

let $severities = {
  informational: 1,
  info: 1,
  low: 2,
  medium: 3,
  high: 4,
  critical: 5,
}
$into.ocsf.severity_id = $severities[$into.sophos.severity?]? else 1

match @name {
  "sophos.endpoint" => {
    sophos::ocsf::events::endpoint event=$into
  }
  "sophos.detection" => {
    sophos::ocsf::events::detection event=$into
  }
  "sophos.common.alert" => {
    sophos::ocsf::events::common_alert event=$into
  }
  "sophos.alert" => {
    sophos::ocsf::events::alert event=$into
  }
  "sophos.event" => {
    match $into.sophos.type {
      "Event::Endpoint::CoreDetection" |
      "Event::Endpoint::CorePuaDetection" |
      "Event::Endpoint::CorePuaRemoteDetection" |
      "Event::Endpoint::HmpaExploitPrevented" => {
        sophos::ocsf::events::siem_detection event=$into
      }
      "Event::Endpoint::CoreClean" |
      "Event::Endpoint::CorePuaClean" => {
        sophos::ocsf::events::file_remediation_activity event=$into
      }
      "Event::Endpoint::WebFilteringBlocked" => {
        sophos::ocsf::events::web_resource_access_activity event=$into
      }
      _ => {
        sophos::ocsf::base event=$into
      }
    }
  }
  _ => {
    sophos::ocsf::base event=$into
  }
}



$into = {...$into.ocsf, unmapped: $into.sophos}
