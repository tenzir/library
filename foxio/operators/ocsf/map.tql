---
description: Maps FoxIO JA4+ fingerprints to OCSF 1.9 OSINT Inventory Info.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

$ocsf.fingerprints = [
  {field: "ja4_fingerprint", type: "JA4", value: $event.ja4_fingerprint?},
  {field: "ja4h_fingerprint", type: "JA4HTTP", value: $event.ja4h_fingerprint?},
  {field: "ja4s_fingerprint", type: "JA4Server", value: $event.ja4s_fingerprint?},
  {field: "ja4t_fingerprint", type: "JA4TCP", value: $event.ja4t_fingerprint?},
  {field: "ja4ts_fingerprint", type: "JA4TCPServer", value: $event.ja4ts_fingerprint?},
  {field: "ja4tscan_fingerprint", type: "JA4TCPScan", value: $event.ja4tscan_fingerprint?},
  {field: "ja4x_fingerprint", type: "JA4X509", value: $event.ja4x_fingerprint?},
]
unroll $ocsf.fingerprints
where $ocsf.fingerprints.value != null

$ocsf = {
  activity_id: 2,
  actor: {app_name: "Tenzir"},
  category_uid: 5,
  class_uid: 5021,
  metadata: {
    product: {
      name: "JA4+ Database",
      vendor_name: "FoxIO",
    },
    version: "1.9.0",
  },
  osint: [{
    category: $ocsf.fingerprints.type,
    confidence_id: 0,
    labels: [
      $event.application?,
      $event.os?,
      $event.device?,
      $event.library?,
      $event.user_agent?,
    ].collect(),
    name: $ocsf.fingerprints.field,
    src_url: "https://ja4db.com/",
    type_id: 4,
    value: $ocsf.fingerprints.value,
    vendor_name: "FoxIO",
  }],
  severity_id: 1,
  time: now(),
  type_uid: 502102,
}

drop $event.ja4_fingerprint?, $event.ja4h_fingerprint?,
     $event.ja4s_fingerprint?, $event.ja4t_fingerprint?,
     $event.ja4ts_fingerprint?, $event.ja4tscan_fingerprint?,
     $event.ja4x_fingerprint?, $event.application?, $event.os?,
     $event.device?, $event.library?, $event.user_agent?

@name = "ocsf.osint_inventory_info"

$ocsf.unmapped = move $event
