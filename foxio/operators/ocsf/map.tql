---
description: Maps FoxIO JA4+ fingerprints to OCSF 1.9 OSINT Inventory Info.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The structured FoxIO response to map.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives each OCSF event.
---


$into = {foxio: $event, ocsf: {}}

$into.fingerprint = [
  {
    field: "ja4_fingerprint",
    type: "JA4",
    value: $into.foxio.ja4_fingerprint?,
  },
  {
    field: "ja4h_fingerprint",
    type: "JA4HTTP",
    value: $into.foxio.ja4h_fingerprint?,
  },
  {
    field: "ja4s_fingerprint",
    type: "JA4Server",
    value: $into.foxio.ja4s_fingerprint?,
  },
  {
    field: "ja4t_fingerprint",
    type: "JA4TCP",
    value: $into.foxio.ja4t_fingerprint?,
  },
  {
    field: "ja4ts_fingerprint",
    type: "JA4TCPServer",
    value: $into.foxio.ja4ts_fingerprint?,
  },
  {
    field: "ja4tscan_fingerprint",
    type: "JA4TCPScan",
    value: $into.foxio.ja4tscan_fingerprint?,
  },
  {
    field: "ja4x_fingerprint",
    type: "JA4X509",
    value: $into.foxio.ja4x_fingerprint?,
  },
]
unroll $into.fingerprint
where $into.fingerprint.value != null

$into.labels = [
  $into.foxio.application?,
  $into.foxio.os?,
  $into.foxio.device?,
  $into.foxio.library?,
  $into.foxio.user_agent?,
].where(x => x != null)

$into.osint = {}
$into.osint.category = move $into.fingerprint.type
$into.osint.confidence_id = 0
$into.osint.labels = $into.labels if $into.labels.length() > 0
$into.osint.name = move $into.fingerprint.field
$into.osint.src_url = "https://ja4db.com/"
$into.osint.type_id = 4
$into.osint.value = move $into.fingerprint.value
$into.osint.vendor_name = "FoxIO"

$into.ocsf = {}
$into.ocsf.activity_id = 2
$into.ocsf.actor = {
  app_name: "Tenzir",
}
$into.ocsf.category_uid = 5
$into.ocsf.class_uid = 5021
$into.ocsf.metadata = {
  product: {
    name: "JA4+ Database",
    vendor_name: "FoxIO",
  },
  version: "1.9.0",
}
$into.ocsf.osint = [move $into.osint]
$into.ocsf.severity_id = 1
$into.ocsf.time = now()
$into.ocsf.type_uid = $into.ocsf.class_uid * 100 + $into.ocsf.activity_id

drop $into.labels

@name = "ocsf.osint_inventory_info"

$into = {...$into.ocsf, unmapped: $into.foxio}
