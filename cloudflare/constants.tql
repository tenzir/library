// Package-wide constants shared across the Cloudflare OCSF mappers.

// OCSF HTTP Activity `activity_id` for HTTP request methods.
let $http_activity_ids = {
  CONNECT: 1,
  DELETE: 2,
  GET: 3,
  HEAD: 4,
  OPTIONS: 5,
  POST: 6,
  PUT: 7,
  TRACE: 8,
  PATCH: 9,
  ACL: 10,
  "BASELINE-CONTROL": 11,
  BIND: 12,
  CHECKIN: 13,
  CHECKOUT: 14,
  COPY: 15,
  LABEL: 16,
  LINK: 17,
  LOCK: 18,
  MERGE: 19,
  MKACTIVITY: 20,
  MKCALENDAR: 21,
  MKCOL: 22,
  MKREDIRECTREF: 23,
  MKWORKSPACE: 24,
  MOVE: 25,
  ORDERPATCH: 26,
  PRI: 27,
  PROPFIND: 28,
  PROPPATCH: 29,
  QUERY: 30,
  REBIND: 31,
  REPORT: 32,
  SEARCH: 33,
  UNBIND: 34,
  UNCHECKOUT: 35,
  UNLINK: 36,
  UNLOCK: 37,
  UPDATE: 38,
  UPDATEREDIRECTREF: 39,
  "VERSION-CONTROL": 40,
}

// OCSF `action_id` and `disposition_id` for the actions of Cloudflare security
// products, keyed by the lowercase action. The HTTP requests dataset spells
// actions in camel case, such as `managedChallenge`, and the firewall events
// dataset in lowercase, such as `managedchallenge`.
//
// Issuing a challenge replaces the response, so it modifies the activity. A
// solved or bypassed challenge lets the request through.
let $security_actions = {
  unknown: {action_id: 0, disposition_id: 0},
  allow: {action_id: 1, disposition_id: 1},
  block: {action_id: 2, disposition_id: 2},
  challenge: {action_id: 4, disposition_id: 22},
  jschallenge: {action_id: 4, disposition_id: 23},
  managedchallenge: {action_id: 4, disposition_id: 23},
  precursorinterstitialpageissued: {action_id: 4, disposition_id: 23},
  log: {action_id: 3, disposition_id: 17},
  connectionclose: {action_id: 2, disposition_id: 6},
  forceconnectionclose: {action_id: 2, disposition_id: 6},
  challengesolved: {action_id: 1, disposition_id: 1},
  challengebypassed: {action_id: 1, disposition_id: 1},
  jschallengesolved: {action_id: 1, disposition_id: 1},
  jschallengebypassed: {action_id: 1, disposition_id: 1},
  managedchallengenoninteractivesolved: {action_id: 1, disposition_id: 1},
  managedchallengeinteractivesolved: {action_id: 1, disposition_id: 1},
  managedchallengebypassed: {action_id: 1, disposition_id: 1},
  precursorinterstitialpagesolved: {action_id: 1, disposition_id: 1},
  precursorinterstitialpagebypassed: {action_id: 1, disposition_id: 1},
  bypass: {action_id: 1, disposition_id: 1},
  skip: {action_id: 1, disposition_id: 1},
  rewrite: {action_id: 4, disposition_id: 99, disposition: "Rewrite"},
}

// OCSF `type_id` of a network endpoint for Cloudflare's `ClientDeviceType`.
let $device_type_ids = {
  desktop: 2,
  tablet: 4,
  mobile: 5,
}

// OCSF API Activity `activity_id` for audit log action types.
let $api_activity_ids = {
  create: 1,
  view: 2,
  update: 3,
  delete: 4,
}

// OCSF `status_id` for audit log action results.
let $audit_status_ids = {
  success: 1,
  failure: 2,
}

// OCSF `user.type_id` for audit log actor types. A `delegated_service` or
// `system` actor is Cloudflare itself and does not identify a user.
let $actor_type_ids = {
  user: 1,
  cloudflare_admin: 2,
  account: 4,
  system: 3,
}
