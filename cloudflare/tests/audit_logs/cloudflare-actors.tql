// Actions that Cloudflare performs itself carry no actor IP address. The
// mapping does not invent a source endpoint, so OCSF validation warns that
// API Activity lacks the required `src_endpoint`.
from_file f"{env("TENZIR_INPUTS")}/audit_logs_v2.ndjson" {
  read_ndjson
}
where ActorType in ["system", "delegated_service"]
cloudflare::ocsf::normalize
this = ocsf_cast(this)
sort time
