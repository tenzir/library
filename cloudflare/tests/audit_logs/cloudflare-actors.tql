// Actions that Cloudflare performs itself carry no actor IP address, so
// Cloudflare is both the actor and the source endpoint.
from_file f"{env("TENZIR_INPUTS")}/audit_logs_v2.ndjson" {
  read_ndjson
}
where ActorType in ["system", "delegated_service"]
cloudflare::ocsf::normalize
this = ocsf_cast(this)
sort time
