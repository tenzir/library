// Audit logs from the API map like their Logpush counterparts once
// `to_logpush` reshapes them.
from_file f"{env("TENZIR_INPUTS")}/audit_logs_api.json" {
  read_json arrays_of_objects=true
}
where actor.type not in ["system", "delegated_service"]
cloudflare::audit_logs::to_logpush
cloudflare::ocsf::normalize
this = ocsf_cast(this)
sort time
