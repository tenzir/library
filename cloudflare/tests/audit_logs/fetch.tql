---
fixtures: [cloudflare_api]
---

// The token comes from the environment here; pipelines use `secret(...)`.
cloudflare::audit_logs::fetch env("CLOUDFLARE_ACCOUNT_ID"),
  api_token=env("CLOUDFLARE_API_TOKEN"),
  since=2026-12-17T00:00:00Z,
  before=2026-12-18T00:00:00Z,
  api=env("CLOUDFLARE_API_URL")
select AuditLogID, ActionTimestamp, ActionType, ActorType, ActorTokenDetails
