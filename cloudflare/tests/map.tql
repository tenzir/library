// The mapper writes into a field and leaves the rest of the event alone.
// `dataset` overrides the recognition by fields, which a job with few
// fields can need.
from {
  source: "logpush",
  cloudflare: {
    ClientIP: "203.0.113.7",
    ClientRequestMethod: "POST",
    ClientRequestPath: "/login",
    EdgeResponseStatus: 401,
    EdgeStartTimestamp: 1797508800000000000,
  },
}
cloudflare::ocsf::map cloudflare, ocsf, dataset="http_requests"
drop cloudflare
ocsf = ocsf_cast(ocsf)
