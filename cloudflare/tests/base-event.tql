// Records of datasets without a mapping, such as `dns_logs`, become Base
// Events that keep the record under `unmapped`. The mapping knows no time
// field of other datasets, so OCSF validation warns about the missing `time`.
from {
  ColoCode: "FRA",
  QueryName: "www.example.com",
  QueryType: 1,
  ResponseCode: 0,
  Timestamp: 2026-12-17T12:00:00Z,
}
cloudflare::ocsf::normalize
this = ocsf_cast(this)
