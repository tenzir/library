---
description: |
  Converts a Logpush timestamp in place to a time value.

  Logpush writes timestamps as Unix nanoseconds (API default), Unix seconds,
  or RFC 3339 strings (dashboard default), depending on the job's
  `timestamp_format`.
args:
  positional:
    - name: timestamp
      type: field
      description: The timestamp field to convert.
---

$timestamp = (
  from_epoch($timestamp * (1ns if $timestamp > 100000000000 else 1s))
  if $timestamp.type_kind() == "int"
  else time($timestamp)
)
