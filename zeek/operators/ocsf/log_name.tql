---
description: |
  Sets the log name of a Zeek event, such as `conn.log`.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// Zeek readers name the schema, such as `zeek.weird`, instead of writing
// `_path`.
$ocsf.metadata.log_name = (
  ($event._path? else (@name if @name.starts_with("zeek.") else null))
    .replace_regex("^zeek\\.", "")
  + ".log"
)
