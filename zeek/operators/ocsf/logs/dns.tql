---
description: |
  Zeek dns.log → OCSF DNS Activity.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

zeek::ocsf::map_network $event, $ocsf

// --- OCSF: classification attributes ----------

$ocsf.activity_id = 6
$ocsf.class_uid = 4003
$ocsf.opcode_id = 0
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = "dns.log"

// --- OCSF: primary attributes -----------------

let $rcode_names = {
  NOERROR: "NoError",
  FORMERR: "FormError",
  SERVFAIL: "ServError",
  NXDOMAIN: "NXDomain",
  NOTIMP: "NotImp",
  REFUSED: "Refused",
  YXDOMAIN: "YXDomain",
  YXRRSET: "YXRRSet",
  "NXRRSet": "NXRRSet",
  NOTAUTH: "NotAuth",
  NOTZONE: "NotZone",
  "unassigned-11": "DSOTYPENI",
  BADVERS: "BADVERS",
  BADKEY: "BADKEY",
  BADTIME: "BADTIME",
  BADMODE: "BADMODE",
  BADNAME: "BADNAME",
  BADALG: "BADALG",
  BADTRUNC: "BADTRUNC",
  BADCOOKIE: "BADCOOKIE",
  BADSIG: "BADSIG",
}
$ocsf.answers = zip(move $event.answers?, move $event.TTLs?).map(x => {
  rdata: x.left.string(),
  ttl: int(count_seconds(x.right) if type_kind(x.right) == "duration" else x.right),
})
if $event.query? != null {
  $ocsf.query = {
    class: move $event.qclass_name?,
    hostname: move $event.query,
    type: move $event.qtype_name?,
  }
  // qclass/qtype repeat the names already mapped above.
  drop $event.qclass?, $event.qtype?
}
// OCSF 1.9 distinguishes the DNS transaction ID from a packet UID.
$ocsf.transaction_id = move $event.trans_id?
$ocsf.flag_ids = [
  1 if $event.AA?,
  2 if $event.TC?,
  3 if $event.RD?,
  4 if $event.RA?,
  5 if $event.AD?,
  6 if $event.CD?,
].collect()
drop $event.AA?, $event.TC?, $event.RD?, $event.RA?, $event.AD?, $event.CD?

$ocsf.query_time = $ocsf.time
// Zeek measures a round-trip time only when it saw a response. Native JSON
// stores it as seconds instead of a duration.
if type_kind($event.rtt?) in ["int", "uint", "float"] {
  $event.rtt = $event.rtt.seconds()
}
$ocsf.response_time = $ocsf.time + (move $event.rtt?)
// Range bounds are exclusive. OCSF collapses the IANA unassigned and reserved
// ranges into one identifier each, so the source keeps the original wire code.
match $event.rcode? {
  // 12–15, 24–3840, and 4096–65534
  11..16 | 23..3841 | 4095..65535 => {
    $ocsf.rcode = "Unassigned"
    $ocsf.rcode_id = 24
  }
  // 3841–4095 and 65535
  3840..4096 | 65535 => {
    $ocsf.rcode = "Reserved"
    $ocsf.rcode_id = 25
  }
  _ => {
    $ocsf.rcode = $rcode_names[$event.rcode_name?]? else $event.rcode_name?
    // BADSIG shares code 16 with BADVERS, which OCSF defines.
    $ocsf.rcode_id = 99 if $event.rcode_name? == "BADSIG" else int($event.rcode?)
    drop $event.rcode?, $event.rcode_name?
  }
}
$ocsf.status = "Unknown"
$ocsf.status_id = 0

@name = "ocsf.dns_activity"
