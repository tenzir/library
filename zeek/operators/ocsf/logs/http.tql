---
description: |
  Zeek http.log → OCSF HTTP Activity.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

zeek::ocsf::map_network $event, $ocsf

// --- OCSF: classification attributes ----------

let $methods = {
  CONNECT: 1,
  DELETE: 2,
  GET: 3,
  HEAD: 4,
  OPTIONS: 5,
  POST: 6,
  PUT: 7,
  TRACE: 8,
  PATCH: 9,
}
$ocsf.activity_id = $methods[$event.method?]? else 0
$ocsf.class_uid = 4002
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = "http.log"
$ocsf.metadata.profiles = ["host"]
if $event.username? != null {
  $ocsf.actor.user.name = move $event.username
}

// --- OCSF: primary attributes -----------------

$ocsf.http_request = {
  body_length: move $event.request_body_len?,
  // OCSF uses the case-sensitive method token, just like Zeek.
  http_method: move $event.method?,
  referrer: move $event.referrer?,
  user_agent: move $event.user_agent?,
  version: move $event.version?,
  http_headers: (move $event.client_headers?).map(x => x.split(": ", max=1)).map(xs => {
    name: xs[0],
    value: xs[1],
  }),
}
// A URL needs a path. Zeek's `uri` also carries the query string.
if $event.uri? != null {
  $ocsf.http_request.url = {
    // JSON readers infer IP values; the host is always a string.
    hostname: (move $event.dest_host? else move $event.host?).string(),
    path: $event.uri.split("?", max=1)[0],
    query_string: $event.uri.split("?", max=1)[1]?,
  }
  drop $event.uri
}
// A response needs a status code.
if $event.status_code? != null {
  $ocsf.http_response = {
    body_length: move $event.response_body_len?,
    code: move $event.status_code,
    status: move $event.status_msg?,
    http_headers: (move $event.server_headers?).map(x => x.split(": ", max=1)).map(xs => {
      name: xs[0],
      value: xs[1],
    }),
  }
}

$ocsf.connection_info.protocol_name = "tcp"
$ocsf.connection_info.protocol_num = 6

// Range bounds are exclusive.
match $ocsf.http_response?.code? {
  // 2xx and 3xx
  199..400 => {
    $ocsf.status = "Success"
    $ocsf.status_id = 1
  }
  // 4xx and 5xx
  399..600 => {
    $ocsf.status = "Failure"
    $ocsf.status_id = 2
  }
  _ => {
    $ocsf.status = "Unknown"
    $ocsf.status_id = 0
  }
}

@name = "ocsf.http_activity"
