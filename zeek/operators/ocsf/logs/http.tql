---
description: |
  Zeek http.log → OCSF HTTP Activity.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

zeek::ocsf::map_network $event, $ocsf

// --- OCSF: classification attributes ----------

let $methods = {
  CONNECT: 1,
  DELETE: 2,
  GET: 3,
  HEAD: 4,
  OPTIONS: 5,
  POST: 6,
  PUT: 7,
  TRACE: 8,
  PATCH: 9,
  ACL: 10,
  "BASELINE-CONTROL": 11,
  BIND: 12,
  CHECKIN: 13,
  CHECKOUT: 14,
  COPY: 15,
  LABEL: 16,
  LINK: 17,
  LOCK: 18,
  MERGE: 19,
  MKACTIVITY: 20,
  MKCALENDAR: 21,
  MKCOL: 22,
  MKREDIRECTREF: 23,
  MKWORKSPACE: 24,
  MOVE: 25,
  ORDERPATCH: 26,
  PRI: 27,
  PROPFIND: 28,
  PROPPATCH: 29,
  QUERY: 30,
  REBIND: 31,
  REPORT: 32,
  SEARCH: 33,
  UNBIND: 34,
  UNCHECKOUT: 35,
  UNLINK: 36,
  UNLOCK: 37,
  UPDATE: 38,
  UPDATEREDIRECTREF: 39,
  "VERSION-CONTROL": 40,
}
// A method that OCSF does not list is Other and keeps its name. Without a
// method, the activity is unknown.
if $event.method? == null {
  $ocsf.activity_id = 0
} else if $methods[$event.method]? != null {
  $ocsf.activity_id = $methods[$event.method]
} else {
  $ocsf.activity_id = 99
  $ocsf.activity_name = $event.method
}
$ocsf.class_uid = 4002
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = "http.log"
$ocsf.metadata.profiles = ["host"]
if $event.username? != null {
  $ocsf.actor.user.name = move $event.username
}

// --- OCSF: primary attributes -----------------

$ocsf.http_request = {
  body_length: move $event.request_body_len?,
  // OCSF uses the case-sensitive method token, just like Zeek.
  http_method: move $event.method?,
  referrer: move $event.referrer?,
  user_agent: move $event.user_agent?,
  version: move $event.version?,
  http_headers: (move $event.client_headers?).map(x => x.split(": ", max=1)).map(xs => {
    name: xs[0],
    value: xs[1],
  }),
}
// Zeek logs the proxy headers of a request, such as X-Forwarded-For and Via,
// in `proxied` as `NAME -> value`, with the name in upper case. They are
// request headers, so they join the ones from `client_headers`, unless that
// already lists the same header and value.
if not ($event.proxied? else []).is_empty() {
  $event.proxied = $event.proxied.map(x => x.split(" -> ", max=1)).map(xs => {
    name: xs[0],
    value: xs[1]?,
  })
  $event.logged_headers = ($ocsf.http_request.http_headers? else []).map(x => f"{x.name.to_lower()}: {x.value}")
  $ocsf.http_request.http_headers = [
    ...$ocsf.http_request.http_headers? else [],
    ...$event.proxied.where(x => f"{x.name.to_lower()}: {x.value}" not in $event.logged_headers),
  ]
  // X-Forwarded-For lists the addresses of the client and of the proxies that
  // forwarded its request, in that order. Clients control the header, so its
  // addresses can be forged. Entries that are no address, such as `unknown`,
  // only stay in the header.
  $event.xff = $event.proxied.where(x => x.name == "X-FORWARDED-FOR").map(x => x.value)
  if not $event.xff.is_empty() {
    $event.xff_ips = $event.xff.join(",").split(",").map(x => ip(x.trim())).where(x => x != null)
    if not $event.xff_ips.is_empty() {
      $ocsf.src_endpoint.intermediate_ips = $event.xff_ips
    }
  }
  drop $event.proxied, $event.logged_headers, $event.xff, $event.xff_ips?
}
// Zeek logs the request target as `uri`, including the query string. Zeek's
// HTTP analyzer only parses cleartext HTTP, so every URL that a request target
// names has the scheme `http`, unless an absolute target names another one.
if $event.uri? != null {
  if $event.uri.starts_with("/") {
    // A target in origin form is the path and query of the URL. RFC 9110
    // §7.1 rebuilds the URL from the scheme, the Host header, and the target.
    // JSON readers infer IP values; the host is always a string.
    if $event.dest_host? not in [null, ""] {
      $event.url_authority = (move $event.dest_host).string()
    } else if $event.host? not in [null, ""] {
      $event.url_authority = (move $event.host).string()
    }
    $event.url_target = $event.uri
    if $event.url_authority? != null {
      $event.url_string = "http://" + $event.url_authority + $event.uri
    }
  } else if $event.uri.match_regex(r"^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]") {
    // A client sends a target in absolute form to a proxy. The URL is the
    // target as sent, and its authority takes precedence over the Host header.
    $event.url_scheme = $event.uri.split("://", max=1)[0].to_lower()
    $event.url_rest = $event.uri.split("://", max=1)[1]
    $event.url_authority = $event.url_rest.replace_regex(r"^(?:[^/?#@]*@)?([^/?#]*).*$", "\\1")
    $event.url_target = $event.url_rest.replace_regex(r"^[^/?#]*", "")
    $event.url_string = $event.uri
  }
  // Targets in authority form, such as `example.org:443` of a CONNECT
  // request, and other targets name no URL, so `uri` stays in `unmapped`.
  if $event.url_target? != null {
    // The URL takes the port that the authority names, never the port of the
    // connection. IPv6 literals in brackets also contain colons.
    $event.url_port = $event.url_authority?.replace_regex(r"^(\[[^\]]*\]|[^:\[\]]*):(\d+)$", "\\2")
    $event.url_hostname = $event.url_authority?.replace_regex(r"^(\[[^\]]*\]|[^:\[\]]*):(\d+)$", "\\1")
    $event.url_path = $event.url_target.split("?", max=1)[0]
    $ocsf.http_request.url = {
      hostname: $event.url_hostname.replace_regex(r"^\[(.*)\]$", "\\1"),
      port: $event.url_port.int() if $event.url_port != $event.url_authority? else null,
      path: $event.url_path if $event.url_path != "" else null,
      query_string: $event.url_target.split("?", max=1)[1]?,
      scheme: $event.url_scheme? else "http",
      url_string: $event.url_string?,
    }
    // The Host header of an absolute target stays only if it names another
    // host.
    if $event.host?.string() in [$event.url_authority?, $event.url_hostname] {
      drop $event.host
    }
    if $event.dest_host?.string() in [$event.url_authority?, $event.url_hostname] {
      drop $event.dest_host
    }
    drop $event.uri, $event.url_hostname, $event.url_path, $event.url_port
  }
  drop $event.url_authority?, $event.url_rest?, $event.url_scheme?, $event.url_string?, $event.url_target?
}
// A response needs a status code.
if $event.status_code? != null {
  $ocsf.http_response = {
    body_length: move $event.response_body_len?,
    code: move $event.status_code,
    status: move $event.status_msg?,
    http_headers: (move $event.server_headers?).map(x => x.split(": ", max=1)).map(xs => {
      name: xs[0],
      value: xs[1],
    }),
  }
}

$ocsf.connection_info.protocol_name = "tcp"
$ocsf.connection_info.protocol_num = 6

// Range bounds are exclusive.
match $ocsf.http_response?.code? {
  // 2xx and 3xx
  199..400 => {
    $ocsf.status = "Success"
    $ocsf.status_id = 1
  }
  // 4xx and 5xx
  399..600 => {
    $ocsf.status = "Failure"
    $ocsf.status_id = 2
  }
  _ => {
    $ocsf.status = "Unknown"
    $ocsf.status_id = 0
  }
}

@name = "ocsf.http_activity"
