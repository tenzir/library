---
description: |
  Zeek radius.log → OCSF Authentication, or Network Activity without a user.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

zeek::ocsf::map_network $event, $ocsf

// --- OCSF: classification attributes ----------

// The network access server authenticates the user that `username` names.
// Without a user, the record shows RADIUS traffic.
if $event.username? != null {
  $ocsf.activity_id = 1
  $ocsf.category_uid = 3
  $ocsf.class_uid = 3002
} else {
  $ocsf.activity_id = 6
  $ocsf.class_uid = 4001
}
$ocsf.severity_id = 2 if $event.result? == "failed" else 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = "radius.log"

// --- OCSF: primary attributes -----------------

// Zeek logs `success` for an Access-Accept, `failed` for an Access-Reject,
// and `unknown` without a reply.
if $event.result? == "success" {
  $ocsf.status = "Success"
  $ocsf.status_id = 1
  drop $event.result
} else if $event.result? == "failed" {
  $ocsf.status = "Failure"
  $ocsf.status_id = 2
  drop $event.result
} else {
  $ocsf.status = "Unknown"
  $ocsf.status_id = 0
  drop $event.result?
}
$ocsf.status_detail = move $event.reply_msg?

if $ocsf.class_uid == 3002 {
  $ocsf.auth_protocol = "RADIUS"
  $ocsf.auth_protocol_id = 10
  $ocsf.user.name = move $event.username
  // Authentication has no connection details. The UID stays in the metadata,
  // and the Community ID keeps its original key.
  $event.community_id = $ocsf.connection_info.community_uid?
  drop $ocsf.connection_info
  @name = "ocsf.authentication"
} else {
  $ocsf.app_protocol_name = "radius"
  @name = "ocsf.network_activity"
}
