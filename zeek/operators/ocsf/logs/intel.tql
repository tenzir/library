---
description: |
  Zeek intel.log → OCSF Detection Finding.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// --- OCSF: classification attributes ----------

$ocsf.activity_id = 1
$ocsf.category_uid = 2
$ocsf.class_uid = 2004
// Intel matches carry no severity.
$ocsf.severity_id = 0
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = "intel.log"
drop $event._path?

// --- OCSF: primary attributes -----------------

// Intel matches have no identifier of their own, so the finding UID derives
// from the facts that tell matches apart.
$ocsf.finding_info = {
  uid: hash_sha256(f"{$ocsf.time}|{$event.seen?.indicator?}|{$event.seen?.where?}|{$ocsf.metadata.correlation_uid?}|{$event.fuid?}"),
}
$ocsf.status_id = 1

// The indicator types of the Zeek intel framework. Types without an OCSF
// indicator type are Other and keep their name.
let $indicator_types = {
  "Intel::ADDR": 1,
  "Intel::DOMAIN": 2,
  "Intel::FILE_HASH": 4,
  "Intel::URL": 5,
  "Intel::CERT_HASH": 7,
  "Intel::EMAIL": 9,
  "Intel::FILE_NAME": 11,
}
if $event.seen?.indicator? != null {
  $ocsf.metadata.profiles = ["osint"]
  $event.indicator = {
    value: move $event.seen.indicator,
    type_id: $indicator_types[$event.seen.indicator_type?]? else 0,
  }
  if $event.indicator.type_id != 0 {
    drop $event.seen.indicator_type
  } else if $event.seen.indicator_type? != null {
    $event.indicator.type_id = 99
    $event.indicator.type = move $event.seen.indicator_type
  }
  $ocsf.osint = [move $event.indicator]
}

// The connection of a match is the evidence. The sources of the indicators,
// where Zeek saw it, and the matched types keep their original keys.
if $event.id?.orig_h? != null {
  $event._evidence = {
    src_endpoint: {ip: $event.id.orig_h, port: $event.id.orig_p?},
    dst_endpoint: {ip: $event.id.resp_h, port: $event.id.resp_p?},
  }
  drop $event.id
}
// A file needs a name, which only the file description provides.
if $event.file_desc? != null {
  $event._evidence.file = {
    name: $event.file_desc.file_name(),
    path: $event.file_desc if not $event.file_desc.starts_with("http") else null,
    mime_type: move $event.file_mime_type?,
    uid: move $event.fuid?,
    type_id: 1,
  }
  if $event.file_desc.starts_with("http") {
    $event._evidence.url.url_string = $event.file_desc
  }
  drop $event.file_desc
}
$ocsf.evidences = [move $event._evidence?].collect()

@name = "ocsf.detection_finding"
