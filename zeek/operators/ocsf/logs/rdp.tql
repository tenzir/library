---
description: |
  Zeek rdp.log → OCSF RDP Activity.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

zeek::ocsf::map_network $event, $ocsf

// --- OCSF: classification attributes ----------

let $results = {
  "encrypted": 0,
  "Success": 1,
  "User rejected": 2,
  "Resources not available": 2,
  "Rejected for symmetry breaking": 2,
  "Locked conference": 2,
}
$ocsf.activity_id = 6
$ocsf.class_uid = 4005
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = "rdp.log"
// --- OCSF: primary attributes -----------------

$ocsf.connection_info.protocol_name = "tcp"
$ocsf.connection_info.protocol_num = 6

$ocsf.protocol_ver = move $event.client_build?
$ocsf.identifier_cookie = move $event.cookie
$ocsf.keyboard_info = {
  keyboard_layout: move $event.keyboard_layout?,
}
$ocsf.remote_display = {
  physical_height: move $event.desktop_height?,
  physical_width: move $event.desktop_width?,
  color_depth: int(replace(move $event.requested_color_depth?, "bit", "")),
}
$ocsf.tls = {
  key_length: int(replace(move $event.encryption_method?, "bit", "")),
  // The version is required, but not present in the data.
  version: null,
}
$ocsf.status_detail = move $event.result
$ocsf.status_id = $results[$ocsf.status_detail] else 0

// --- OCSF: context attributes -----------------

$ocsf.device = {
  name: move $event.client_name?,
  os: {
    name: "Windows",
    cpe_name: "cpe:2.3:o:microsoft:windows",
    type_id: 100,
    type: "Windows",
  },
  // 64-byte clientDigProductId
  uid: move $event.client_dig_product_id?,
  type_id: 2,
  type: "Desktop",
}

@name = "ocsf.rdp_activity"
