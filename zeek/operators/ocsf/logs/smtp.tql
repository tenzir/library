---
description: |
  Zeek smtp.log → OCSF Email Activity.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// TODO:
// - Generate one Email URL Activity event for each element in the `url`
//   array, linking the resulting events via a shared UUID.
// - Surface Zeek file UIDs (`fuids`) for corresponding Network File Activity
//   events when possible.

zeek::ocsf::map_network $event, $ocsf
drop $ocsf.connection_info?

// --- OCSF: classification attributes ----------

$ocsf.activity_id = 1
$ocsf.class_uid = 4009
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = "smtp.log"

// --- OCSF: primary attributes -----------------

$ocsf.dst_endpoint.intermediate_ips = move $event.path

$ocsf.email = {
  from_mailbox: move $event.from,
  from: move $event.mailfrom,
  cc: move $event.cc?,
  reply_to: move $event.reply_to?,
  message_uid: move $event.msg_id,
  to: move $event.rcptto,
  to_mailboxes: move $event.to,
  subject: move $event.subject,
}
$ocsf.command = move $event.helo
$ocsf.protocol_name = "SMTP"
$ocsf.status_detail = move $event.last_reply

@name = "ocsf.email_activity"
