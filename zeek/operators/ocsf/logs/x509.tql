---
description: |
  Zeek x509.log → OCSF Network Activity.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

zeek::ocsf::map_network $event, $ocsf

// --- OCSF: classification attributes ----------

$ocsf.activity_id = 6
$ocsf.class_uid = 4001
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = "x509.log"

$ocsf.tls = {
  certificate: {
    serial_number: move $event.certificate.serial,
    created_time: move $event.certificate.not_valid_before,
    expiration_time: move $event.certificate.not_valid_after,
    issuer: move $event.certificate.issuer,
    subject: move $event.certificate.subject,
    version: (move $event.certificate.version).string(),
  },
  sans: (move $event.san.dns).map(name => {
    name: name,
    type: "DNSName",
  }),
  version: null,
}
if $event.fingerprint? != null {
  $ocsf.tls.certificate.fingerprints = [{
    algorithm_id: 3,
    value: move $event.fingerprint,
  }]
}

@name = "ocsf.network_activity"
