---
description: |
  Zeek x509.log → OCSF Base Event with the certificate fields retained.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// A certificate log describes a certificate, not an observed connection.
zeek::ocsf::base $event, $ocsf
$ocsf.metadata.log_name = "x509.log"
