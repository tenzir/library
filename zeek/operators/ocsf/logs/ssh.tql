---
description: |
  Zeek ssh.log → OCSF SSH Activity.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

zeek::ocsf::map_network $event, $ocsf

// --- OCSF: classification attributes ----------

// The activity attributes relate to the underlying TCP connection. Since
// we have a ssh.log entry, it means we already have an established
// connection and must assume data is being exchanged, even if it's just
// the SSH handshake.
$ocsf.activity_id = 6
$ocsf.class_uid = 4007
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
if "ABP" in $event.inferences? or "BFS" in $event.inferences? {
  // Client authentication bypass (ABP) or brute force success (BFS) are
  // worthwhile escalating.
  $ocsf.severity_id = 4
} else if "BF" in $event.inferences? or "SV" in $event.inferences? or "SC" in $event.inferences? or "SP" in $event.inferences? {
  // Noteworthy are brute force attempts (BF), version scanning (SV),
  // capability scanning (SC), or other scanning (SP).
  $ocsf.severity_id = 3
} else {
  // Everything else is standard.
  $ocsf.severity_id = 1
}

// OCSF has no attribute for the number of authentication attempts, so
// `auth_attempts` stays unmapped. `count` counts aggregated events instead.

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = "ssh.log"
$ocsf.protocol_ver = (move $event.version?).string()
let $statuses = {
  "true": 1,
  "false": 2,
}
$ocsf.status_id = $statuses[(move $event.auth_success?).string()]? else 0

// --- OCSF: primary attributes -----------------

$ocsf.connection_info.protocol_name = "tcp"
$ocsf.connection_info.protocol_num = 6

// The Direction enum in Zeek can be INBOUND, OUTBOUND, BIDIRECTIONAL, or
// NO_DIRECTION. NB: there is no equivalent to Lateral in Zeek, so we
// cannot map to it.
let $directions = {
  // The connection originator is not within the locally-monitored
  // network, but the other endpoint is.
  INBOUND: {
    direction: "Inbound",
    direction_id: 1,
  },
  // The connection originator is within the locally-monitored network,
  // but the other endpoint is not.
  OUTBOUND: {
    direction: "Outbound",
    direction_id: 2,
  },
  // Only one endpoint is within the locally-monitored network, meaning
  // the connection is either outbound or inbound.
  BIDIRECTIONAL: {
    direction: "Unknown",
    direction_id: 0,
  },
  // This value doesn't match any connection.
  NO_DIRECTION: {
    direction: "Unknown",
    direction_id: 0,
  },
}
// Without the direction extension, the Unknown default from
// `map_network` remains.
$ocsf.connection_info = {
  ...$ocsf.connection_info,
  ...$directions[move $event.direction?]?,
}

if $event.client? != null {
  $ocsf.src_endpoint.agent_list = [{
    name: move $event.client,
    type: "Remote Access",
    type_id: 9,
  }]
}
if $event.server? != null {
  $ocsf.dst_endpoint.agent_list = [{
    name: move $event.server,
    type: "Remote Access",
    type_id: 9,
  }]
}

if $event.hasshServer? != null {
  $ocsf.server_hassh = {
    algorithm: move $event.hasshServerAlgorithms?,
    fingerprint: {
      algorithm_id: 20,
      value: move $event.hasshServer,
    },
  }
}
if $event.hassh? != null {
  $ocsf.client_hassh = {
    algorithm: move $event.hasshAlgorithms?,
    fingerprint: {
      algorithm_id: 20,
      value: move $event.hassh,
    },
  }
}

// The Authentication Type can be deduced if we have the `inferences`
// package.
if "KS" in $event.inferences? {
  $ocsf.auth_type_id = 4
  $ocsf.auth_type = "Keyboard Interactive"
} else {
  $ocsf.auth_type_id = 0
  $ocsf.auth_type = "Unknown"
}

@name = "ocsf.ssh_activity"
