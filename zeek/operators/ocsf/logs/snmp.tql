---
description: |
  Zeek snmp.log → OCSF Network Activity.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

zeek::ocsf::map_network $event, $ocsf

// --- OCSF: classification attributes ----------

// Zeek logs the requests and responses of an SNMP session.
$ocsf.activity_id = 6
$ocsf.class_uid = 4001
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = "snmp.log"
$ocsf.app_protocol_name = "snmp"

// --- OCSF: primary attributes -----------------

// Network Activity has no attributes for the PDU counts, the community, or
// the device description, so they keep their original keys.
$ocsf.status_id = 0

@name = "ocsf.network_activity"
