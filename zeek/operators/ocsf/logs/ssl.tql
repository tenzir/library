---
description: |
  Zeek ssl.log → OCSF Network Activity.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

zeek::ocsf::map_network $event, $ocsf

// --- OCSF: classification attributes ----------

$ocsf.activity_id = 6
$ocsf.class_uid = 4001
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = "ssl.log"

// Converted from:
// https://github.com/zeek/zeek/blob/fdf887ce3bd80e0b466a973d5063c5882303d282/scripts/base/protocols/ssl/consts.zeek#L113
let $alert_codes = {
  close_notify: 0,
  unexpected_message: 10,
  bad_record_mac: 20,
  decryption_failed: 21,
  record_overflow: 22,
  decompression_failure: 30,
  handshake_failure: 40,
  no_certificate: 41,
  bad_certificate: 42,
  unsupported_certificate: 43,
  certificate_revoked: 44,
  certificate_expired: 45,
  certificate_unknown: 46,
  illegal_parameter: 47,
  unknown_ca: 48,
  access_denied: 49,
  decode_error: 50,
  decrypt_error: 51,
  export_restriction: 60,
  protocol_version: 70,
  insufficient_security: 71,
  internal_error: 80,
  inappropriate_fallback: 86,
  user_canceled: 90,
  no_renegotiation: 100,
  unsupported_extension: 110,
  certificate_unobtainable: 111,
  unrecognized_name: 112,
  bad_certificate_status_response: 113,
  bad_certificate_hash_value: 114,
  unknown_psk_identity: 115,
  certificate_required: 116, // RFC8446
  no_application_protocol: 120,
  ech_required: 121, // draft-ietf-tls-esni-17
}

// A TLS object models a negotiated session and requires its version, which
// Zeek takes from the ServerHello. Without one, the handshake never finished
// and the event stays Network Activity without a TLS object.
if $event.version? != null {
  $ocsf.tls = {
    cipher: move $event.cipher?,
    // JSON readers infer IP values; the SNI is always a string.
    sni: $event.server_name?.string(),
    version: move $event.version,
    // NB: If we have an alert, `ssl_history` also contains [lL].
    alert: $alert_codes[$event.last_alert?]?,
  }
  // A fingerprint requires its value.
  if $event.ja3? != null {
    $ocsf.tls.ja3_hash = {algorithm_id: 1, value: $event.ja3}
  }
  if $event.ja3s? != null {
    $ocsf.tls.ja3s_hash = {algorithm_id: 1, value: $event.ja3s}
  }
}
// JA3 and JA3S identify the client and server implementations, even when the
// handshake failed. OCSF has no algorithm ID for them.
if $event.ja3? != null {
  $ocsf.src_endpoint.fingerprints = [{
    algorithm_id: 99,
    algorithm: "JA3",
    value: move $event.ja3,
  }]
}
if $event.ja3s? != null {
  $ocsf.dst_endpoint.fingerprints = [{
    algorithm_id: 99,
    algorithm: "JA3S",
    value: move $event.ja3s,
  }]
}
// The SNI names the server, unless the client sent an IP literal, optionally
// with a port. It never replaces a different host name.
if (
  $event.server_name? != null
  and ip($event.server_name) == null
  and ":" not in $event.server_name
  and ($ocsf.dst_endpoint.hostname? else $event.server_name) == $event.server_name
) {
  $ocsf.dst_endpoint.hostname = move $event.server_name
}
// The TLS object already holds the SNI. Otherwise, an SNI that names no host
// stays unmapped as the string the client sent.
if $ocsf.tls? != null {
  drop $event.server_name?
} else if $event.server_name? != null {
  $event.server_name = $event.server_name.string()
}

// --- OCSF: primary attributes -----------------

$ocsf.connection_info.protocol_name = "tcp"
$ocsf.connection_info.protocol_num = 6

if not $event.established or $event.last_alert? != null {
  $ocsf.status_id = 2
  $ocsf.status = "Failure"
  $ocsf.status_code = $alert_codes[$event.last_alert?]?.string()
  $ocsf.status_detail = move $event.last_alert?
} else if $event.validation_status? == "ok" {
  // There could be more `validation_status` values that mean success,
  // but it's difficult to find them. In Zeek, we'd need to grep through
  // all invocations of `x509_result_record` and trace the arguments.
  //
  // Going with just "ok" here is simply going off empirical data.
  $ocsf.status_id = 1
  $ocsf.status = "Success"
  $ocsf.status_detail = move $event.validation_status?
} else {
  $ocsf.status_id = 0
  $ocsf.status = "Unknown"
  $ocsf.status_detail = move $event.validation_status?
}
drop $event.established

@name = "ocsf.network_activity"
