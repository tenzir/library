---
description: |
  Zeek ftp.log → OCSF FTP Activity.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

zeek::ocsf::map_network $event, $ocsf

// --- OCSF: classification attributes ----------

let $commands = {
  STOR: 1,
  APPE: 1,
  RETR: 2,
  MLST: 3,
  MLSD: 6,
  LIST: 6,
  NLST: 6,
  DELE: 4,
  RNFR: 5,
  RNTO: 5,
  RMD: 4,
}
$ocsf.activity_id = $commands[$event.command]? else 0
$ocsf.class_uid = 4008
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = "ftp.log"
$ocsf.metadata.profiles = ["host"]
if $event.user? != null {
  $ocsf.actor.user.name = move $event.user
}

// Only these commands take a file or folder argument. OCSF prefers Regular
// File when the source does not distinguish file types.
let $file_types = {
  APPE: 1,
  DELE: 1,
  MDTM: 1,
  RETR: 1,
  RNFR: 1,
  RNTO: 1,
  SIZE: 1,
  STOR: 1,
  STOU: 1,
  MKD: 2,
  RMD: 2,
}
if $file_types[$event.command]? != null and $event.arg? != null {
  // Zeek logs transferred files as absolute `ftp://` URLs.
  $ocsf.file = {
    name: $event.arg.file_name(),
    path: $event.arg.replace_regex("^ftp://[^/]*", ""),
    size: move $event.file_size?,
    mime_type: move $event.mime_type?,
    uid: move $event.fuid?,
    type_id: $file_types[$event.command],
  }
  if $event.arg.starts_with("ftp://") {
    $ocsf.file.url.url_string = $event.arg
  }
  drop $event.arg
}

// --- OCSF: primary attributes -----------------

$ocsf.connection_info.protocol_name = "tcp"
$ocsf.connection_info.protocol_num = 6

$ocsf.command = move $event.command
$ocsf.status_code = $event.reply_code?.string()
$ocsf.status_detail = move $event.reply_msg?
// Range bounds are exclusive.
match $event.reply_code? {
  // Preliminary, completion, and intermediate replies
  99..400 => {
    $ocsf.status = "Success"
    $ocsf.status_id = 1
  }
  // Transient and permanent negative replies
  399..600 => {
    $ocsf.status = "Failure"
    $ocsf.status_id = 2
  }
  _ => {}
}
$ocsf.codes = [move $event.reply_code?].collect()

let $channel_types = {
  "true": "passive",
  "false": "active",
}
$ocsf.type = $channel_types[(move $event.data_channel?.passive?).string()]?
$ocsf.port = move $event.data_channel?.resp_p?

@name = "ocsf.ftp_activity"
