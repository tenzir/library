---
description: |
  Zeek syslog.log → OCSF Network Activity.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

zeek::ocsf::map_network $event, $ocsf

// --- OCSF: classification attributes ----------

// Zeek logs each syslog message that it sees on the wire.
$ocsf.activity_id = 6
$ocsf.class_uid = 4001
// The facility and severity belong to the transported message, not to its
// transfer, so they keep their original keys.
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = "syslog.log"
$ocsf.app_protocol_name = "syslog"

// --- OCSF: primary attributes -----------------

$ocsf.message = move $event.message?
$ocsf.status_id = 0

@name = "ocsf.network_activity"
