---
description: |
  Zeek smb_files.log → OCSF SMB Activity.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

zeek::ocsf::map_network $event, $ocsf

// --- OCSF: classification attributes ----------

// The Zeek actions don't naturally map to the corresponding OCSF
// class. Zeek actions have the pattern `SMB::{TYPE}_{ACTION}` where
// `TYPE` is one of `FILE`, `PIPE`, or `PRINT`.
if $event.action.ends_with("_OPEN") {
  $ocsf.activity_id = 2
} else {
  $ocsf.activity_id = 99
  $ocsf.activity_name = $event.action
}
$ocsf.class_uid = 4006
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = "smb_files.log"

// --- OCSF: primary attributes -----------------

$ocsf.connection_info.protocol_name = "tcp"
$ocsf.connection_info.protocol_num = 6

// Native JSON stores each Zeek time as Unix seconds instead of a time value,
// and any of them can be absent. Both forms carry microsecond precision, which
// the rounding restores.
let $unix_kinds = ["int", "uint", "float"]
if $event.times? != null {
  $event.times = {
    accessed: (
      $event.times.accessed?.seconds().from_epoch()
        if type_kind($event.times.accessed?) in $unix_kinds
        else $event.times.accessed?
    ).round(1us),
    changed: (
      $event.times.changed?.seconds().from_epoch()
        if type_kind($event.times.changed?) in $unix_kinds
        else $event.times.changed?
    ).round(1us),
    created: (
      $event.times.created?.seconds().from_epoch()
        if type_kind($event.times.created?) in $unix_kinds
        else $event.times.created?
    ).round(1us),
    modified: (
      $event.times.modified?.seconds().from_epoch()
        if type_kind($event.times.modified?) in $unix_kinds
        else $event.times.modified?
    ).round(1us),
  }
}
// Zeek's `path` names the UNC share, and `name` the file within it.
$ocsf.share = move $event.path?
// Without a share path, the share root has no name to report.
if $event.name? != null and ($event.name != "<share_root>" or $ocsf.share != null) {
  $ocsf.file = {
    name: $event.name.file_name(),
    type_id: 6 if $event.action.starts_with("SMB::PIPE_") else 1,
    path: $ocsf.share + "\\" + $event.name,
    accessed_time: move $event.times?.accessed?,
    created_time: move $event.times?.created?,
    modified_time: move $event.times?.modified?,
    size: move $event.size?,
    uid: move $event.fuid?,
  }
  // The pseudo name `<share_root>` denotes the share folder itself.
  if $event.name == "<share_root>" {
    $ocsf.file.name = $ocsf.share?.file_name()
    $ocsf.file.type_id = 2
    $ocsf.file.path = $ocsf.share
  }
  drop $event.name
}
let $share_types = {
  FILE: {share_type_id: 1, share_type: "File"},
  PIPE: {share_type_id: 2, share_type: "Pipe"},
  PRINT: {share_type_id: 3, share_type: "Print"},
}
$ocsf = {
  ...$ocsf,
  ...($share_types[$event.action.split("::")[1].split("_")[0]]? else {share_type_id: 0, share_type: "Unknown"}),
}
drop $event.action

@name = "ocsf.smb_activity"
