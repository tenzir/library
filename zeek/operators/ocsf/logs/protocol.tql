---
description: |
  Zeek application protocol logs without a protocol class, such as
  mysql.log or modbus.log → OCSF Network Activity.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// Zeek readers name the schema, such as `zeek.mysql`, instead of writing
// `_path`.
$event.log = ($event._path? else @name).replace_regex("^zeek\\.", "")
zeek::ocsf::map_network $event, $ocsf

// --- OCSF: classification attributes ----------

// Each record reports a transaction or message within a connection.
$ocsf.activity_id = 6
$ocsf.class_uid = 4001
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = $event.log + ".log"
// The application protocol is the name of the Zeek analyzer.
let $protocols = {
  dce_rpc: "dce_rpc",
  dnp3: "dnp3",
  irc: "irc",
  ldap: "ldap",
  ldap_search: "ldap",
  modbus: "modbus",
  modbus_register_change: "modbus",
  mqtt_connect: "mqtt",
  mqtt_publish: "mqtt",
  mqtt_subscribe: "mqtt",
  mysql: "mysql",
  postgresql: "postgresql",
  quic: "quic",
  redis: "redis",
  rfb: "rfb",
  socks: "socks",
  websocket: "websocket",
}
$ocsf.app_protocol_name = $protocols[$event.log]?

// --- OCSF: primary attributes -----------------

// Zeek logs the outcome of a transaction as a flag or as the result that the
// server sent. Network Activity has no attributes for the protocol details,
// so they keep their original keys.
if $event.success? == true {
  $ocsf.status = "Success"
  $ocsf.status_id = 1
  drop $event.success
} else if $event.success? == false {
  $ocsf.status = "Failure"
  $ocsf.status_id = 2
  drop $event.success
} else if $event.log in ["ldap", "ldap_search"] and $event.result? != null {
  // LDAP names the result code of RFC 4511 §4.1.9, such as `success` or
  // `invalidCredentials`.
  if $event.result == "success" {
    $ocsf.status = "Success"
    $ocsf.status_id = 1
  } else {
    $ocsf.status = $event.result
    $ocsf.status_id = 99
  }
  $ocsf.status_code = move $event.result
  $ocsf.status_detail = move $event.diagnostic_message?
} else if $event.log == "socks" and $event.status? != null {
  // SOCKS replies name whether the server granted the request, such as
  // `succeeded` or `connection refused`.
  if $event.status == "succeeded" {
    $ocsf.status = "Success"
    $ocsf.status_id = 1
  } else {
    $ocsf.status = $event.status
    $ocsf.status_id = 99
  }
  $ocsf.status_code = move $event.status
} else {
  $ocsf.status_id = 0
}
drop $event.log

@name = "ocsf.network_activity"
