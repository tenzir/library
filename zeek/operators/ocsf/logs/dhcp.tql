---
description: |
  Zeek dhcp.log → OCSF DHCP Activity.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// --- Preamble ---------------------------------

// Zeek's DHCP log is an aggregation of multiple packets that constitute a
// DORA "session". See https://docs.zeek.org/en/master/logs/dhcp.html for
// details. In OCSF, an event represents a single DORA message, which is
// why we simply unroll the array.
unroll $event.msg_types
zeek::ocsf::map_network $event, $ocsf

// --- OCSF: classification attributes ----------

// Zeek doesn't emit an event when DHCP lease expires, so there is no EXPIRE
// message type.
let $msg_types = {
  DISCOVER: 1,
  OFFER: 2,
  REQUEST: 3,
  DECLINE: 4,
  ACK: 5,
  NAK: 6,
  RELEASE: 7,
  INFORM: 8,
}
$ocsf.activity_id = $msg_types[$event.msg_types]? else 99
$ocsf.class_uid = 4004
$ocsf.severity_id = 1
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = "dhcp.log"
// The `uids` field in the DHCP log is an array of all conn UIDs. To keep at
// least the uniqueness constraint intact, we sort and join them.
$event._uids = sort(move $event.uids).join(",")
$ocsf.metadata.original_event_uid = $event._uids
$ocsf.metadata.correlation_uid = move $event._uids

// --- OCSF: primary attributes -----------------

$ocsf.connection_info.protocol_name = "udp"
$ocsf.connection_info.protocol_num = 17
$ocsf.src_endpoint.hostname = move $event.host_name?
$ocsf.src_endpoint.ip = move $event.client_addr? else $event.assigned_addr?
$ocsf.src_endpoint.domain = move $event.client_fqdn?
$ocsf.src_endpoint.mac = move $event.mac?
$ocsf.dst_endpoint.ip = move $event.server_addr?
$ocsf.dst_endpoint.domain = move $event.domain?
$ocsf.lease_dur = int(move $event.lease_time?)

@name = "ocsf.dhcp_activity"
