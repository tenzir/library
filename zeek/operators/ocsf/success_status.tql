---
description: |
  Maps the `success` flag of a Zeek event to the OCSF status.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// Zeek only logs `success` once it sees the outcome.
if $event.success? == true {
  $ocsf.status = "Success"
  $ocsf.status_id = 1
} else if $event.success? == false {
  $ocsf.status = "Failure"
  $ocsf.status_id = 2
} else {
  $ocsf.status = "Unknown"
  $ocsf.status_id = 0
}
drop $event.success?
