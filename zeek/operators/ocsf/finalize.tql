---
description: Preserves incomplete optional objects as unmapped data.
args:
  positional:
    - name: ocsf
      type: field
      description: The OCSF record to finalize.
---

if (
  $ocsf.src_endpoint? != null
  and $ocsf.src_endpoint.ip? == null
  and $ocsf.src_endpoint.uid? == null
  and $ocsf.src_endpoint.name? == null
  and $ocsf.src_endpoint.hostname? == null
  and $ocsf.src_endpoint.svc_name? == null
  and $ocsf.src_endpoint.instance_uid? == null
  and $ocsf.src_endpoint.interface_uid? == null
  and $ocsf.src_endpoint.interface_name? == null
  and $ocsf.src_endpoint.domain? == null
) {
  if not drop_null_fields($ocsf.src_endpoint).flatten().is_empty() {
    $ocsf.unmapped.src_endpoint = {
      ...drop_null_fields($ocsf.src_endpoint),
      ...$ocsf.unmapped?.src_endpoint?,
    }
  }
  drop $ocsf.src_endpoint
}
if (
  $ocsf.dst_endpoint? != null
  and $ocsf.dst_endpoint.ip? == null
  and $ocsf.dst_endpoint.uid? == null
  and $ocsf.dst_endpoint.name? == null
  and $ocsf.dst_endpoint.hostname? == null
  and $ocsf.dst_endpoint.svc_name? == null
  and $ocsf.dst_endpoint.instance_uid? == null
  and $ocsf.dst_endpoint.interface_uid? == null
  and $ocsf.dst_endpoint.interface_name? == null
  and $ocsf.dst_endpoint.domain? == null
) {
  if not drop_null_fields($ocsf.dst_endpoint).flatten().is_empty() {
    $ocsf.unmapped.dst_endpoint = {
      ...drop_null_fields($ocsf.dst_endpoint),
      ...$ocsf.unmapped?.dst_endpoint?,
    }
  }
  drop $ocsf.dst_endpoint
}
if (
  $ocsf.actor?.user? != null
  and $ocsf.actor?.user.account? == null
  and $ocsf.actor?.user.name? == null
  and $ocsf.actor?.user.uid? == null
) {
  if not drop_null_fields($ocsf.actor.user).flatten().is_empty() {
    $ocsf.unmapped.actor.user = {
      ...drop_null_fields($ocsf.actor.user),
      ...$ocsf.unmapped?.actor?.user?,
    }
  }
  drop $ocsf.actor.user
}
if $ocsf.query? != null and $ocsf.query.hostname? == null {
  if not drop_null_fields($ocsf.query).flatten().is_empty() {
    $ocsf.unmapped.query = {
      ...drop_null_fields($ocsf.query),
      ...$ocsf.unmapped?.query?,
    }
  }
  drop $ocsf.query
}
if (
  $ocsf.http_request?.url? != null
  and $ocsf.http_request?.url.path? == null
  and $ocsf.http_request?.url.url_string? == null
) {
  if not drop_null_fields($ocsf.http_request.url).flatten().is_empty() {
    $ocsf.unmapped.http_request.url = {
      ...drop_null_fields($ocsf.http_request.url),
      ...$ocsf.unmapped?.http_request?.url?,
    }
  }
  drop $ocsf.http_request.url
}
if $ocsf.http_response? != null and $ocsf.http_response.code? == null {
  if not drop_null_fields($ocsf.http_response).flatten().is_empty() {
    $ocsf.unmapped.http_response = {
      ...drop_null_fields($ocsf.http_response),
      ...$ocsf.unmapped?.http_response?,
    }
  }
  drop $ocsf.http_response
}
if $ocsf.tls?.ja3_hash? != null and $ocsf.tls?.ja3_hash.value? == null {
  if not drop_null_fields($ocsf.tls.ja3_hash).flatten().is_empty() {
    $ocsf.unmapped.tls.ja3_hash = {
      ...drop_null_fields($ocsf.tls.ja3_hash),
      ...$ocsf.unmapped?.tls?.ja3_hash?,
    }
  }
  drop $ocsf.tls.ja3_hash
}
if $ocsf.tls?.ja3s_hash? != null and $ocsf.tls?.ja3s_hash.value? == null {
  if not drop_null_fields($ocsf.tls.ja3s_hash).flatten().is_empty() {
    $ocsf.unmapped.tls.ja3s_hash = {
      ...drop_null_fields($ocsf.tls.ja3s_hash),
      ...$ocsf.unmapped?.tls?.ja3s_hash?,
    }
  }
  drop $ocsf.tls.ja3s_hash
}
if $ocsf.file? != null and $ocsf.file.name? == null {
  if not drop_null_fields($ocsf.file).flatten().is_empty() {
    $ocsf.unmapped.file = {
      ...drop_null_fields($ocsf.file),
      ...$ocsf.unmapped?.file?,
    }
  }
  drop $ocsf.file
}
if (
  $ocsf.tls?.certificate? != null
  and ($ocsf.tls?.certificate.issuer? == null
  or $ocsf.tls?.certificate.serial_number? == null)
) {
  if not drop_null_fields($ocsf.tls.certificate).flatten().is_empty() {
    $ocsf.unmapped.tls.certificate = {
      ...drop_null_fields($ocsf.tls.certificate),
      ...$ocsf.unmapped?.tls?.certificate?,
    }
  }
  drop $ocsf.tls.certificate
}
if $ocsf.tls? != null and $ocsf.tls?.version? == null {
  if not drop_null_fields($ocsf.tls).flatten().is_empty() {
    $ocsf.unmapped.tls = {
      ...drop_null_fields($ocsf.tls),
      ...$ocsf.unmapped?.tls?,
    }
  }
  drop $ocsf.tls
}
if (
  $ocsf.device? != null
  and $ocsf.device.ip? == null
  and $ocsf.device.uid? == null
  and $ocsf.device.name? == null
  and $ocsf.device.hostname? == null
) {
  if not drop_null_fields($ocsf.device).flatten().is_empty() {
    $ocsf.unmapped.device = {
      ...drop_null_fields($ocsf.device),
      ...$ocsf.unmapped?.device?,
    }
  }
  drop $ocsf.device
}
if $ocsf.email? != null and $ocsf.email.from? == null and $ocsf.email.to? == null {
  if not drop_null_fields($ocsf.email).flatten().is_empty() {
    $ocsf.unmapped.email = {
      ...drop_null_fields($ocsf.email),
      ...$ocsf.unmapped?.email?,
    }
  }
  drop $ocsf.email
}
// Standalone certificates establish no network endpoints.
if (
  ($ocsf.class_uid == 4009
  and $ocsf.email? == null)
  or ($ocsf.category_uid == 4
  and $ocsf.class_uid != 4009
  and $ocsf.src_endpoint? == null
  and $ocsf.dst_endpoint? == null)
) {
  $ocsf = {
    ...drop_null_fields({
      time: $ocsf.time,
      metadata: {...$ocsf.metadata, profiles: []},
      message: $ocsf.message?,
      raw_data: $ocsf.raw_data?,
      raw_data_size: $ocsf.raw_data_size?,
      severity_id: $ocsf.severity_id,
      status_id: $ocsf.status_id?,
      status_code: $ocsf.status_code?,
      status_detail: $ocsf.status_detail?,
      start_time: $ocsf.start_time?,
      end_time: $ocsf.end_time?,
      duration: $ocsf.duration?,
      count: $ocsf.count?,
    }),
    category_uid: 0, class_uid: 0, activity_id: 0, type_uid: 0,
    unmapped: {
      ...$ocsf.unmapped?,
      ...$ocsf.entries().where(entry => entry.value != null and entry.key not in [
        "time", "metadata", "message", "raw_data",
        "raw_data_size", "severity_id", "status_id", "status_code",
        "status_detail", "start_time", "end_time", "duration",
        "count", "category_uid", "category_name", "class_uid",
        "class_name", "activity_id", "activity_name", "type_uid",
        "type_name", "severity", "unmapped",
      ]).map(entry => {
        key: entry.key,
        value: {...entry.value, ...($ocsf.unmapped? else {}).get(entry.key, null)}
          if type_kind(entry.value) == "record" and type_kind(($ocsf.unmapped? else {}).get(entry.key, null)) == "record"
          else ($ocsf.unmapped? else {}).get(entry.key, entry.value),
      }).collect_record().drop_null_fields(),
    },
  }
  @name = "ocsf.base_event"
}

if $ocsf.actor? != null and drop_null_fields($ocsf.actor).is_empty() {
  drop $ocsf.actor
}
