---
description: |
  Removes the connection details from an OCSF class without them.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// The UID stays in the metadata, and the Community ID keeps its original key.
$event.community_id = $ocsf.connection_info.community_uid?
drop $ocsf.connection_info?
