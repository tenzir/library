---
description: |
  Zeek events → OCSF Network Activity.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// --- OCSF: classification attributes ----------

$ocsf.category_uid = 4

// --- OCSF: occurence & context attributes------

if $ocsf.metadata.original_event_uid? != null {
  $ocsf.connection_info.uid = $ocsf.metadata.original_event_uid
}

// Implied in metadata.log_name.
drop $event._path?

// --- OCSF: primary attributes -----------------

// Map source/destination endpoints.
if $event.has("id") {
  $ocsf.src_endpoint = {
    ip: $event.id.orig_h,
    port: $event.id.orig_p,
  }
  $ocsf.dst_endpoint = {
    ip: $event.id.resp_h,
    port: $event.id.resp_p,
  }
  drop $event.id
  // Fill protocol version based on endpoints.
  // This could at some point go into `ocsf_derive`.
  if $ocsf.src_endpoint.ip.is_v6() or $ocsf.dst_endpoint.ip.is_v6() {
    $ocsf.connection_info.protocol_ver_id = 6
  } else {
    $ocsf.connection_info.protocol_ver_id = 4
  }
}
if $event.has("orig_l2_addr") {
  $ocsf.src_endpoint.mac = move $event.orig_l2_addr
}
if $event.has("resp_l2_addr") {
  $ocsf.dst_endpoint.mac = move $event.resp_l2_addr
}
if $event.has("orig_cc") {
  $ocsf.src_endpoint.location = {
    country: move $event.orig_cc,
  }
}
if $event.has("resp_cc") {
  $ocsf.dst_endpoint.location = {
    country: move $event.resp_cc,
  }
}

// Map Community ID.
if $event.has("community_id") {
  $ocsf.connection_info.community_uid = move $event.community_id
}

// Map transport-layer protocol details.
let $proto_nums = {
  tcp: 6,
  udp: 17,
  icmp: 1,
  icmpv6: 58,
  ipv6: 41,
}
if $event.has("proto") {
  $ocsf.connection_info.protocol_num = $proto_nums[$event.proto]? else -1
  $ocsf.connection_info.protocol_name = move $event.proto
}
