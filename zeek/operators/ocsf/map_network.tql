---
description: |
  Zeek events → OCSF Network Activity.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// --- OCSF: classification attributes ----------

$ocsf.category_uid = 4
$ocsf.connection_info.direction_id = 0

// --- OCSF: occurence & context attributes------

$ocsf.connection_info.uid = $ocsf.metadata.correlation_uid?

// Implied in metadata.log_name.
drop $event._path?

// --- OCSF: primary attributes -----------------

// An endpoint needs an address, so the link-layer address only accompanies
// the connection 4-tuple.
if $event.id? != null {
  $ocsf.src_endpoint = {
    ip: $event.id.orig_h,
    port: $event.id.orig_p,
    mac: move $event.orig_l2_addr?,
  }
  $ocsf.dst_endpoint = {
    ip: $event.id.resp_h,
    port: $event.id.resp_p,
    mac: move $event.resp_l2_addr?,
  }
  drop $event.id
  // This could at some point go into `ocsf_derive`.
  $ocsf.connection_info.protocol_ver_id = 6 if $ocsf.src_endpoint.ip.is_v6() or $ocsf.dst_endpoint.ip.is_v6() else 4
}
// A location needs at least one of its attributes.
if $event.orig_cc? != null {
  $ocsf.src_endpoint.location = {
    country: move $event.orig_cc,
  }
}
if $event.resp_cc? != null {
  $ocsf.dst_endpoint.location = {
    country: move $event.resp_cc,
  }
}
if $event.remote_location? != null {
  $ocsf.dst_endpoint.location = {
    city: $event.remote_location.city?,
    country: $event.remote_location.country_code?,
    lat: $event.remote_location.latitude?,
    long: $event.remote_location.longitude?,
    region: $event.remote_location.region?,
  }
  drop $event.remote_location
}

$ocsf.connection_info.community_uid = move $event.community_id?

// Map transport-layer protocol details. Zeek's `unknown_transport` has no
// IANA protocol number.
let $proto_nums = {
  tcp: 6,
  udp: 17,
  icmp: 1,
  icmpv6: 58,
  ipv6: 41,
}
$ocsf.connection_info.protocol_num = $proto_nums[$event.proto?]?
$ocsf.connection_info.protocol_name = move $event.proto?
