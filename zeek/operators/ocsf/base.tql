---
description: |
  Zeek log → OCSF Base Event.
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// --- OCSF: classification attributes ----------

$ocsf.activity_id = 0
$ocsf.class_uid = 0
$ocsf.category_uid = 0
$ocsf.severity_id = 1
$ocsf.type_uid = 0

// --- OCSF: context attributes -----------------

$ocsf.metadata.log_name = move $event._path?

// --- OCSF: primary attributes -----------------

$ocsf.status_id = 0

// --- Finalize ---------------------------------

@name = "ocsf.base_event"
