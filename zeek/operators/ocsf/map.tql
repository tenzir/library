---
description: Maps a structured Zeek log record to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---


$ocsf = {}

// --- OCSF: occurrence attributes --------------

if type_of($event.ts).kind == "time" {
  $ocsf.time = move $event.ts
} else if type_of($event.ts).kind == "double" {
  $ocsf.time = (move $event.ts).seconds().from_epoch()
}


// --- OCSF: context attributes -----------------

$ocsf.metadata = {
  logged_time: move $event._write_ts?,
  product: {
    name: "Zeek",
    vendor_name: "Zeek",
    cpe_name: "cpe:2.3:a:zeek:zeek",
  },
  version: "1.9.0",
}
if $event.uid? != null {
  $ocsf.metadata.original_event_uid = $event.uid
  $ocsf.metadata.correlation_uid = move $event.uid
}

match $event._path? else @name {
  "conn" | "zeek.conn" => {
    zeek::ocsf::logs::conn $event, $ocsf
  }
  "dhcp" | "zeek.dhcp" => {
    zeek::ocsf::logs::dhcp $event, $ocsf
  }
  "dns" | "zeek.dns" => {
    zeek::ocsf::logs::dns $event, $ocsf
  }
  "ftp" | "zeek.ftp" => {
    zeek::ocsf::logs::ftp $event, $ocsf
  }
  "http" | "zeek.http" => {
    zeek::ocsf::logs::http $event, $ocsf
  }
  "rdp" | "zeek.rdp" => {
    zeek::ocsf::logs::rdp $event, $ocsf
  }
  "smb_files" | "zeek.smb_files" => {
    zeek::ocsf::logs::smb_files $event, $ocsf
  }
  "smtp" | "zeek.smtp" => {
    zeek::ocsf::logs::smtp $event, $ocsf
  }
  "ssh" | "zeek.ssh" => {
    zeek::ocsf::logs::ssh $event, $ocsf
  }
  "ssl" | "zeek.ssl" => {
    zeek::ocsf::logs::ssl $event, $ocsf
  }
  "x509" | "zeek.x509" => {
    zeek::ocsf::logs::x509 $event, $ocsf
  }
  _ => {
    zeek::ocsf::base $event, $ocsf
  }
}



$ocsf.unmapped = move $event
