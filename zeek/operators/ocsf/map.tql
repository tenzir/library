---
description: Maps a structured Zeek log record to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      default: this
      description: The structured Zeek record to map.
  named:
    - name: into
      type: field
      default: this
      description: The field that receives the OCSF event.
---


$into = {zeek: $event, ocsf: {}}

// --- OCSF: occurrence attributes --------------

if type_of($into.zeek.ts).kind == "time" {
  $into.ocsf.time = move $into.zeek.ts
} else if type_of($into.zeek.ts).kind == "double" {
  $into.ocsf.time = (move $into.zeek.ts).seconds().from_epoch()
}


// --- OCSF: context attributes -----------------

$into.ocsf.metadata = {
  logged_time: move $into.zeek._write_ts?,
  product: {
    name: "Zeek",
    vendor_name: "Zeek",
    cpe_name: "cpe:2.3:a:zeek:zeek",
  },
  version: "1.9.0",
}
if $into.zeek.uid? != null {
  $into.ocsf.metadata.original_event_uid = $into.zeek.uid
  $into.ocsf.metadata.correlation_uid = move $into.zeek.uid
}

match $into.zeek._path? else @name {
  "conn" | "zeek.conn" => {
    zeek::ocsf::logs::conn event=$into
  }
  "dhcp" | "zeek.dhcp" => {
    zeek::ocsf::logs::dhcp event=$into
  }
  "dns" | "zeek.dns" => {
    zeek::ocsf::logs::dns event=$into
  }
  "ftp" | "zeek.ftp" => {
    zeek::ocsf::logs::ftp event=$into
  }
  "http" | "zeek.http" => {
    zeek::ocsf::logs::http event=$into
  }
  "rdp" | "zeek.rdp" => {
    zeek::ocsf::logs::rdp event=$into
  }
  "smb_files" | "zeek.smb_files" => {
    zeek::ocsf::logs::smb_files event=$into
  }
  "smtp" | "zeek.smtp" => {
    zeek::ocsf::logs::smtp event=$into
  }
  "ssh" | "zeek.ssh" => {
    zeek::ocsf::logs::ssh event=$into
  }
  "ssl" | "zeek.ssl" => {
    zeek::ocsf::logs::ssl event=$into
  }
  "x509" | "zeek.x509" => {
    zeek::ocsf::logs::x509 event=$into
  }
  _ => {
    zeek::ocsf::base event=$into
  }
}



$into = {...$into.ocsf, unmapped: $into.zeek}
