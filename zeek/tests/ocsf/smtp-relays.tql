// The `smtp.log` that Zeek 8.0.10 writes for an invented SMTP session. The two
// messages passed through one and two hosts before reaching the client.
from_file env("TENZIR_INPUT") {
  read_zeek_tsv
}
zeek::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
select class_uid, src_endpoint, dst_endpoint, unmapped
