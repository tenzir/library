// Data: Zeek repository (BSD 3-Clause). See tests/THIRD-PARTY.md.
// The input is the `smtp.log` that Zeek 8.0.10 writes for the trace
// `testing/btest/Traces/smtp/smtp-bdat-pipeline-8bitmime.pcap` of the Zeek
// repository (https://github.com/zeek/zeek, BSD 3-Clause license, see its
// `COPYING` file). It matches the test baseline
// `scripts.base.protocols.smtp.bdat-pipeline-8bitmime` except for the
// timestamps, connection UID, and set order, which the baseline masks or
// varies. The two messages passed through one and two hosts before reaching
// the client.
from_file env("TENZIR_INPUT") {
  read_zeek_tsv
}
zeek::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
select class_uid, src_endpoint, dst_endpoint, unmapped
