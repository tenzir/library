from_file f"{env("TENZIR_INPUTS")}/dhcp.log" {
  read_json
  this = this.unflatten(".")
}
// The original long session includes retransmitted INFORM/ACK messages.
where msg_types.length() > 1
_path = "dhcp"
this = {source: this, ocsf: {}}
zeek::ocsf::map source, ocsf
this = ocsf_cast(ocsf)
// Snapshot one value of each message type; the count test covers repeats.
slice begin=0, end=2
