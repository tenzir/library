// A transient negative reply (4xx), here to a spam bot that exceeds the send
// limits of its relays, fails the transaction just like a permanent one. The
// records are from the M57 capture.
from_file env("TENZIR_INPUT") {
  read_zeek_tsv
}
zeek::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
select metadata.correlation_uid, class_name, status, status_code, status_detail
