// An X-Forwarded-For entry that is no address, such as `unknown`, only stays in
// the header; the other entries still become intermediate IPs, as in Suricata.
// The record is the real M57 Cloudflare request C6cd602pZMftOf8vkf, with
// `unknown` added to its X-Forwarded-For header.
from_file env("TENZIR_INPUT") {
  read_zeek_tsv
}
zeek::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
select src_endpoint, http_request.http_headers
drop_null_fields
