strict {
  from_file f"{env("TENZIR_INPUTS")}/conn.log" {
    read_json
    this = this.unflatten(".")
  }
  duration = duration.seconds()
  this = {source: this, ocsf: {}, expected_end: time(ts) + duration}
  zeek::ocsf::map source, ocsf
  assert ocsf.traffic.end_time == expected_end
}
this = {end_time: ocsf.traffic.end_time}
