// Without header addresses, `from` and `to` take the SMTP envelope, which
// `return_path` and `delivered_to_list` always hold. The empty mailbox fields
// tell that the addresses came from the envelope. The synthetic records are
// from a spam bot whose envelopes the servers rejected before any message
// data.
from_file env("TENZIR_INPUT") {
  read_ndjson
}
zeek::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
select class_name, activity_name, email, status, status_code, status_detail, command
