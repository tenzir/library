// Synthetic Check Point Log Exporter syslog record with RFC 5424 key=value
// structured data; every value is invented.
from_file env("TENZIR_INPUT") {
  read_syslog raw=true
}
checkpoint::syslog::parse_structured_data sd_id="Fields@1.3.6.1.4.1.2620"
checkpoint::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
