// Synthetic Check Point Log Exporter RFC 3164 syslog record with
// pipe-delimited content and no time in the payload; every value is invented.
from_file env("TENZIR_INPUT") {
  read_syslog raw=true
}
checkpoint::syslog::parse_kv_content
checkpoint::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
// The year-less header time resolves against the current time.
time_is_set = type_kind(time) == "time"
drop time
