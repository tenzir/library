---
description: Maps a structured Check Point event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---

$ocsf = {}

// Values that `checkpoint::parse` could not convert keep their source type.
// Set them aside so that no mapping puts them where OCSF expects an address
// or a number; they return to `unmapped` as they are.
_unparsed = {}
if $event.src? != null and type_kind($event.src) != "ip" {
  _unparsed.src = move $event.src
}
if $event.dst? != null and type_kind($event.dst) != "ip" {
  _unparsed.dst = move $event.dst
}
if $event.origin? != null and type_kind($event.origin) != "ip" {
  _unparsed.origin = move $event.origin
}
if $event.snatip? != null and type_kind($event.snatip) != "ip" {
  _unparsed.snatip = move $event.snatip
}
if $event.dnatip? != null and type_kind($event.dnatip) != "ip" {
  _unparsed.dnatip = move $event.dnatip
}
if $event.s_port? != null and type_kind($event.s_port) != "int" {
  _unparsed.s_port = move $event.s_port
}
if $event.service? != null and type_kind($event.service) != "int" {
  _unparsed.service = move $event.service
}
if $event.snatport? != null and type_kind($event.snatport) != "int" {
  _unparsed.snatport = move $event.snatport
}
if $event.dnatport? != null and type_kind($event.dnatport) != "int" {
  _unparsed.dnatport = move $event.dnatport
}
if $event.bytes? != null and type_kind($event.bytes) != "int" {
  _unparsed.bytes = move $event.bytes
}
if $event.bytes_in? != null and type_kind($event.bytes_in) != "int" {
  _unparsed.bytes_in = move $event.bytes_in
}
if $event.bytes_out? != null and type_kind($event.bytes_out) != "int" {
  _unparsed.bytes_out = move $event.bytes_out
}
if $event.packets_in? != null and type_kind($event.packets_in) != "int" {
  _unparsed.packets_in = move $event.packets_in
}
if $event.packets_out? != null and type_kind($event.packets_out) != "int" {
  _unparsed.packets_out = move $event.packets_out
}
if $event.size? != null and type_kind($event.size) != "int" {
  _unparsed.size = move $event.size
}

// The severity comes only from the record's own severity level. The action
// tells the security decision, not the severity.
$ocsf.severity_id = 0
// Check Point writes the threat severity as 0 (Informational) to 4 (Critical)
// or as its name; CEF exports call Critical Very-High. Other values, such as
// the syslog level of audit records, stay in `unmapped`.
if $event.severity? != null {
  let $severities = {
    "0": 1,
    "1": 2,
    "2": 3,
    "3": 4,
    "4": 5,
    informational: 1,
    info: 1,
    low: 2,
    medium: 3,
    high: 4,
    critical: 5,
    "very-high": 5,
  }
  if $severities[$event.severity.string().to_lower()]? != null {
    $ocsf.severity_id = $severities[$event.severity.string().to_lower()]
    drop $event.severity
  }
}

$ocsf.metadata = {
  // The product is the Software Blade that the record names.
  product: {
    vendor_name: "Check Point",
    name: (move $event.product?).string(),
  },
  profiles: ["host"],
  version: "1.9.0",
}
// The log UID is Check Point's identifier of the logged event. Updates of a
// connection log repeat it with a new sequence number.
$ocsf.metadata.original_event_uid = (move $event.loguid?).string()
$ocsf.metadata.event_code = (move $event.logid?).string()
$ocsf.metadata.log_version = (move $event.h_version?).string()
if $event.sequencenum?.string().match_regex("^[0-9]+$") {
  $ocsf.metadata.sequence = int(move $event.sequencenum)
}
if $event.syslog? != null {
  $ocsf.metadata.log_format = "syslog"
}

// The syslog header time and hostname stay in `unmapped` when the payload
// carries its own.
if $event.time? != null {
  $ocsf.time = move $event.time
} else if $event.syslog?.timestamp? != null {
  $ocsf.time = move $event.syslog.timestamp
  // An RFC 3164 header carries its time as a string, usually without a year,
  // such as `Nov  6 09:13:01`.
  if type_kind($ocsf.time) == "string" {
    $ocsf.time = (
      time($ocsf.time) if $ocsf.time.match_regex("^\\d")
      else $ocsf.time.parse_time("%b %e %H:%M:%S", reference=now())
    )
  }
}
$ocsf.message = move $event.message_info?
// Prefer the Check Point payload hostname over the syslog header hostname,
// because forwarded syslog headers often identify a relay.
_endpoint = ($event.product_family? else "").string().to_lower() == "endpoint"
if _endpoint {
  // The header of an exported Harmony Endpoint record names the server that
  // sent it; it stays in `unmapped`.
} else if $event.hostname? != null {
  _hostname = (move $event.hostname).string()
} else if $event.syslog?.hostname? != null {
  _hostname = (move $event.syslog.hostname).string()
}
_gateway = @name.starts_with("checkpoint.firewall.") or
  (@name == "checkpoint.authentication" and
   ($ocsf.metadata.product.name? else "").to_lower() in ["identity awareness", "mobile access", "connectra"])
if _endpoint {
  // Harmony Endpoint records describe the endpoint computer. Their origin is
  // the management or log server that collected them.
  checkpoint::ocsf::endpoint_device $event, $ocsf
} else if _hostname? != null or $event.origin? != null {
  // Gateway blades log from a Security Gateway. Management records come from
  // a management or log server whose device type the record does not tell.
  $ocsf.device = {
    hostname: _hostname?,
    ip: move $event.origin?,
    type_id: 9 if _gateway else 0,
  }
}
drop _hostname?, _gateway, _endpoint

match @name {
  "checkpoint.authentication" => {
    checkpoint::ocsf::events::authentication $event, $ocsf
  }
  "checkpoint.firewall.threat" | "checkpoint.firewall.detection" => {
    checkpoint::ocsf::security_context $event, $ocsf
    checkpoint::ocsf::events::detection_finding $event, $ocsf
  }
  "checkpoint.endpoint.scan" => {
    checkpoint::ocsf::events::scan_activity $event, $ocsf
  }
  "checkpoint.firewall.network" => {
    checkpoint::ocsf::security_context $event, $ocsf
    checkpoint::ocsf::events::network_activity $event, $ocsf
  }
  "checkpoint.firewall.web_resource" => {
    checkpoint::ocsf::events::web_resource_access_activity $event, $ocsf
  }
  "checkpoint.firewall.dlp" => {
    checkpoint::ocsf::events::data_security_finding $event, $ocsf
  }
  "checkpoint.firewall.email" => {
    checkpoint::ocsf::events::email_activity $event, $ocsf
  }
  "checkpoint.firewall.vpn" => {
    checkpoint::ocsf::events::tunnel_activity $event, $ocsf
  }
  "checkpoint.management.api" => {
    checkpoint::ocsf::events::api_activity $event, $ocsf
  }
  "checkpoint.management.audit" => {
    checkpoint::ocsf::events::entity_management $event, $ocsf
  }
  _ => {
    checkpoint::ocsf::base $event, $ocsf
  }
}



// Observation points are network-class attributes, not finding attributes.
// The gateway observes traffic between other hosts, or is itself the source
// or destination.
if $ocsf.category_uid == 4 and $ocsf.class_uid != 4009 {
  _device_ip = $ocsf.device?.ip?
  if _device_ip != null and _device_ip == $ocsf.src_endpoint?.ip? {
    $ocsf.observation_point_id = 1
  } else if _device_ip != null and _device_ip == $ocsf.dst_endpoint?.ip? {
    $ocsf.observation_point_id = 2
  } else if $ocsf.src_endpoint? != null or $ocsf.dst_endpoint? != null {
    $ocsf.observation_point_id = 3
  }
  drop _device_ip
  if $ocsf.device?.hostname? != null or $event.ifname? != null {
    $ocsf.network_observation_point = {
      hostname: $ocsf.device?.hostname?,
      interface_name: move $event.ifname?,
    }
  }
}

$ocsf.unmapped = {...$event, ..._unparsed}
drop _unparsed, $event
