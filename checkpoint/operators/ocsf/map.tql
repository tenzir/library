---
description: Maps a structured Check Point event to OCSF 1.9.
args:
  positional:
    - name: event
      description: The structured Check Point event to map.
      type: field
      default: this
  named:
    - name: into
      description: The field that receives the OCSF event.
      type: field
      default: this
---


$into = {checkpoint: $event, ocsf: {}}

let $severities = {
  Accept: 1,
  Detect: 3,
  Drop: 2,
  Prevent: 2,
  Reject: 2,
}
$into.ocsf.severity_id = $severities[$into.checkpoint.action?]? else 0
if $into.checkpoint.severity? != null {
  let $severity_names = {
    informational: 1,
    info: 1,
    low: 2,
    medium: 3,
    high: 4,
    critical: 5,
    fatal: 6,
  }
  $into.ocsf.severity_id = $severity_names[$into.checkpoint.severity.string().to_lower()]? else $into.ocsf.severity_id
  drop $into.checkpoint.severity
}

$into.ocsf.metadata = {
  product: {
    vendor_name: "Check Point",
    name: "Check Point Firewall",
  },
  profiles: ["host"],
  version: "1.9.0",
}
if $into.checkpoint.product? != null {
  $into.ocsf.metadata.product.name = move $into.checkpoint.product
}
if $into.checkpoint.loguid? != null {
  $into.ocsf.metadata.uid = move $into.checkpoint.loguid
}
if $into.checkpoint.logid? != null {
  $into.ocsf.metadata.event_code = (move $into.checkpoint.logid).string()
}
if $into.checkpoint.h_version? != null {
  $into.ocsf.metadata.log_version = (move $into.checkpoint.h_version).string()
}
if $into.checkpoint.sequencenum? != null {
  $into.ocsf.metadata.original_event_uid = (move $into.checkpoint.sequencenum).string()
}
if $into.checkpoint.syslog? != null {
  $into.ocsf.metadata.log_format = "syslog"
}
if $into.checkpoint.action? != null {
  $into.ocsf.metadata.log_name = $into.checkpoint.action
}

if $into.checkpoint.time? == null and $into.checkpoint.syslog?.timestamp? != null {
  $into.ocsf.time = move $into.checkpoint.syslog.timestamp
}
if $into.checkpoint.time? != null {
  $into.ocsf.time = move $into.checkpoint.time
}
if $into.checkpoint.action? != null {
  $into.ocsf.message = $into.checkpoint.action
}
if $into.checkpoint.message_info? != null {
  $into.ocsf.message = move $into.checkpoint.message_info
}

// Prefer the Check Point payload hostname over the syslog header hostname,
// because forwarded syslog headers often identify a relay.
if $into.checkpoint.hostname? == null and $into.checkpoint.syslog?.hostname? != null {
  $into.ocsf.device.hostname = (move $into.checkpoint.syslog.hostname).string()
}
if $into.checkpoint.hostname? != null {
  $into.ocsf.device.hostname = (move $into.checkpoint.hostname).string()
}
if $into.checkpoint.origin? != null {
  $into.ocsf.device.ip = move $into.checkpoint.origin
}

match @name {
  "checkpoint.firewall.threat" | "checkpoint.firewall.detection" => {
    checkpoint::ocsf::security_context event=$into
    checkpoint::ocsf::events::detection_finding event=$into
  }
  "checkpoint.firewall.network" => {
    checkpoint::ocsf::security_context event=$into
    checkpoint::ocsf::events::network_activity event=$into
  }
  "checkpoint.firewall.web_resource" => {
    checkpoint::ocsf::events::web_resource_access_activity event=$into
  }
  "checkpoint.firewall.dlp" => {
    checkpoint::ocsf::events::data_security_finding event=$into
  }
  "checkpoint.firewall.email" => {
    checkpoint::ocsf::events::email_activity event=$into
  }
  "checkpoint.firewall.vpn" => {
    checkpoint::ocsf::events::tunnel_activity event=$into
  }
  "checkpoint.management.api" => {
    checkpoint::ocsf::events::api_activity event=$into
  }
  "checkpoint.management.audit" => {
    checkpoint::ocsf::events::entity_management event=$into
  }
  _ if $into.checkpoint.action? == "Detect" or $into.checkpoint.message_info? != null => {
    checkpoint::ocsf::security_context event=$into
    checkpoint::ocsf::events::detection_finding event=$into
  }
  _ if $into.checkpoint.action? != null => {
    checkpoint::ocsf::security_context event=$into
    checkpoint::ocsf::events::network_activity event=$into
  }
  _ => {
    checkpoint::ocsf::base event=$into
  }
}



$into = {...$into.ocsf, unmapped: $into.checkpoint}
