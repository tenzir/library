---
description: Maps a structured Check Point event to OCSF 1.9.
args:
  positional:
    - name: event
      type: field
      description: The structured source event to map.
    - name: ocsf
      type: field
      description: The field that receives the OCSF event.
---


$ocsf = {}

let $severities = {
  Accept: 1,
  Detect: 3,
  Drop: 2,
  Prevent: 2,
  Reject: 2,
}
$ocsf.severity_id = $severities[$event.action?]? else 0
if $event.severity? != null {
  let $severity_names = {
    informational: 1,
    info: 1,
    low: 2,
    medium: 3,
    high: 4,
    critical: 5,
    fatal: 6,
  }
  $ocsf.severity_id = $severity_names[$event.severity.string().to_lower()]? else $ocsf.severity_id
  drop $event.severity
}

$ocsf.metadata = {
  product: {
    vendor_name: "Check Point",
    name: "Check Point Firewall",
  },
  profiles: ["host"],
  version: "1.9.0",
}
if $event.product? != null {
  $ocsf.metadata.product.name = move $event.product
}
$ocsf.metadata.uid = move $event.loguid?
$ocsf.metadata.event_code = (move $event.logid?).string()
$ocsf.metadata.log_version = (move $event.h_version?).string()
$ocsf.metadata.original_event_uid = (move $event.sequencenum?).string()
if $event.syslog? != null {
  $ocsf.metadata.log_format = "syslog"
}
if $event.action? != null {
  $ocsf.metadata.log_name = $event.action
}

$ocsf.time = move $event.time? else move $event.syslog?.timestamp?
$ocsf.message = move $event.message_info? else $event.action?
// Prefer the Check Point payload hostname over the syslog header hostname,
// because forwarded syslog headers often identify a relay.
$ocsf.device.hostname = (move $event.hostname? else move $event.syslog?.hostname?).string()
$ocsf.device.ip = move $event.origin?

match @name {
  "checkpoint.firewall.threat" | "checkpoint.firewall.detection" => {
    checkpoint::ocsf::security_context $event, $ocsf
    checkpoint::ocsf::events::detection_finding $event, $ocsf
  }
  "checkpoint.firewall.network" => {
    checkpoint::ocsf::security_context $event, $ocsf
    checkpoint::ocsf::events::network_activity $event, $ocsf
  }
  "checkpoint.firewall.web_resource" => {
    checkpoint::ocsf::events::web_resource_access_activity $event, $ocsf
  }
  "checkpoint.firewall.dlp" => {
    checkpoint::ocsf::events::data_security_finding $event, $ocsf
  }
  "checkpoint.firewall.email" => {
    checkpoint::ocsf::events::email_activity $event, $ocsf
  }
  "checkpoint.firewall.vpn" => {
    checkpoint::ocsf::events::tunnel_activity $event, $ocsf
  }
  "checkpoint.management.api" => {
    checkpoint::ocsf::events::api_activity $event, $ocsf
  }
  "checkpoint.management.audit" => {
    checkpoint::ocsf::events::entity_management $event, $ocsf
  }
  _ => {
    if $event.action? == "Detect" or $event.message_info? != null {
      checkpoint::ocsf::security_context $event, $ocsf
      checkpoint::ocsf::events::detection_finding $event, $ocsf
    } else if $event.action? != null {
      checkpoint::ocsf::security_context $event, $ocsf
      checkpoint::ocsf::events::network_activity $event, $ocsf
    } else {
      checkpoint::ocsf::base $event, $ocsf
    }
  }
}



$ocsf.unmapped = move $event
