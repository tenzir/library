---
description: Apply shared Check Point traffic counters
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

$ocsf.traffic = {
  bytes: move $event.bytes?,
  bytes_in: move $event.bytes_in?,
  bytes_out: move $event.bytes_out?,
  packets: move $event.packets?,
  packets_in: move $event.packets_in?,
  packets_out: move $event.packets_out?,
}
$ocsf.traffic.bytes = $ocsf.traffic.bytes? else
  $ocsf.traffic.bytes_in? + $ocsf.traffic.bytes_out?
$ocsf.traffic.packets = $ocsf.traffic.packets? else
  $ocsf.traffic.packets_in? + $ocsf.traffic.packets_out?

if $event.duration? != null and $ocsf.time? != null {
  $ocsf.traffic.end_time = $ocsf.time
  $ocsf.traffic.start_time = $ocsf.time - (move $event.duration)
}
