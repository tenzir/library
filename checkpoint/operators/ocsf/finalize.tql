---
description: Completes OCSF enums and retains unidentifiable optional objects.
args:
  positional:
    - name: ocsf
      type: field
      description: The OCSF record to finalize.
---

if $ocsf.device? != null {
  $ocsf.device.type_id = $ocsf.device?.type_id? else 0
}
if $ocsf.entity?.device? != null {
  $ocsf.entity.device.type_id = $ocsf.entity?.device?.type_id? else 0
}
if $ocsf.connection_info? != null {
  $ocsf.connection_info.direction_id = $ocsf.connection_info?.direction_id? else 0
}
if (
  $ocsf.device? != null
  and $ocsf.device?.ip? == null
  and $ocsf.device?.uid? == null
  and $ocsf.device?.name? == null
  and $ocsf.device?.hostname? == null
  and $ocsf.device?.instance_uid? == null
  and $ocsf.device?.interface_uid? == null
  and $ocsf.device?.interface_name? == null
) {
  $ocsf.unmapped.ocsf_residue.device = move $ocsf.device
}
if (
  $ocsf.actor?.user? != null
  and $ocsf.actor?.user?.account? == null
  and $ocsf.actor?.user?.name? == null
  and $ocsf.actor?.user?.uid? == null
) {
  $ocsf.unmapped.ocsf_residue.actor_user = move $ocsf.actor.user
}
if (
  $ocsf.src_endpoint?.proxy_endpoint? != null
  and $ocsf.src_endpoint?.proxy_endpoint?.ip? == null
  and $ocsf.src_endpoint?.proxy_endpoint?.uid? == null
  and $ocsf.src_endpoint?.proxy_endpoint?.name? == null
  and $ocsf.src_endpoint?.proxy_endpoint?.hostname? == null
  and $ocsf.src_endpoint?.proxy_endpoint?.svc_name? == null
  and $ocsf.src_endpoint?.proxy_endpoint?.instance_uid? == null
  and $ocsf.src_endpoint?.proxy_endpoint?.interface_uid? == null
  and $ocsf.src_endpoint?.proxy_endpoint?.interface_name? == null
  and $ocsf.src_endpoint?.proxy_endpoint?.domain? == null
) {
  $ocsf.unmapped.ocsf_residue.src_endpoint_proxy_endpoint = move $ocsf.src_endpoint.proxy_endpoint
}
if (
  $ocsf.dst_endpoint?.proxy_endpoint? != null
  and $ocsf.dst_endpoint?.proxy_endpoint?.ip? == null
  and $ocsf.dst_endpoint?.proxy_endpoint?.uid? == null
  and $ocsf.dst_endpoint?.proxy_endpoint?.name? == null
  and $ocsf.dst_endpoint?.proxy_endpoint?.hostname? == null
  and $ocsf.dst_endpoint?.proxy_endpoint?.svc_name? == null
  and $ocsf.dst_endpoint?.proxy_endpoint?.instance_uid? == null
  and $ocsf.dst_endpoint?.proxy_endpoint?.interface_uid? == null
  and $ocsf.dst_endpoint?.proxy_endpoint?.interface_name? == null
  and $ocsf.dst_endpoint?.proxy_endpoint?.domain? == null
) {
  $ocsf.unmapped.ocsf_residue.dst_endpoint_proxy_endpoint = move $ocsf.dst_endpoint.proxy_endpoint
}
if (
  $ocsf.network_observation_point? != null
  and $ocsf.network_observation_point?.ip? == null
  and $ocsf.network_observation_point?.uid? == null
  and $ocsf.network_observation_point?.name? == null
  and $ocsf.network_observation_point?.hostname? == null
  and $ocsf.network_observation_point?.svc_name? == null
  and $ocsf.network_observation_point?.instance_uid? == null
  and $ocsf.network_observation_point?.interface_uid? == null
  and $ocsf.network_observation_point?.interface_name? == null
  and $ocsf.network_observation_point?.domain? == null
) {
  $ocsf.unmapped.ocsf_residue.network_observation_point = move $ocsf.network_observation_point
}
if $ocsf.evidences? != null {
  if (
    $ocsf.evidences.where(e => (e.src_endpoint?.proxy_endpoint? != null
    and e.src_endpoint?.proxy_endpoint?.ip? == null
    and e.src_endpoint?.proxy_endpoint?.uid? == null
    and e.src_endpoint?.proxy_endpoint?.name? == null
    and e.src_endpoint?.proxy_endpoint?.hostname? == null
    and e.src_endpoint?.proxy_endpoint?.svc_name? == null
    and e.src_endpoint?.proxy_endpoint?.instance_uid? == null
    and e.src_endpoint?.proxy_endpoint?.interface_uid? == null
    and e.src_endpoint?.proxy_endpoint?.interface_name? == null
    and e.src_endpoint?.proxy_endpoint?.domain? == null)
    or (e.dst_endpoint?.proxy_endpoint? != null
    and e.dst_endpoint?.proxy_endpoint?.ip? == null
    and e.dst_endpoint?.proxy_endpoint?.uid? == null
    and e.dst_endpoint?.proxy_endpoint?.name? == null
    and e.dst_endpoint?.proxy_endpoint?.hostname? == null
    and e.dst_endpoint?.proxy_endpoint?.svc_name? == null
    and e.dst_endpoint?.proxy_endpoint?.instance_uid? == null
    and e.dst_endpoint?.proxy_endpoint?.interface_uid? == null
    and e.dst_endpoint?.proxy_endpoint?.interface_name? == null
    and e.dst_endpoint?.proxy_endpoint?.domain? == null)).length() > 0
  ) {
    $ocsf.unmapped.ocsf_residue.evidences = $ocsf.evidences.where(e => (e.src_endpoint?.proxy_endpoint? != null
      and e.src_endpoint?.proxy_endpoint?.ip? == null
      and e.src_endpoint?.proxy_endpoint?.uid? == null
      and e.src_endpoint?.proxy_endpoint?.name? == null
      and e.src_endpoint?.proxy_endpoint?.hostname? == null
      and e.src_endpoint?.proxy_endpoint?.svc_name? == null
      and e.src_endpoint?.proxy_endpoint?.instance_uid? == null
      and e.src_endpoint?.proxy_endpoint?.interface_uid? == null
      and e.src_endpoint?.proxy_endpoint?.interface_name? == null
      and e.src_endpoint?.proxy_endpoint?.domain? == null)
      or (e.dst_endpoint?.proxy_endpoint? != null
      and e.dst_endpoint?.proxy_endpoint?.ip? == null
      and e.dst_endpoint?.proxy_endpoint?.uid? == null
      and e.dst_endpoint?.proxy_endpoint?.name? == null
      and e.dst_endpoint?.proxy_endpoint?.hostname? == null
      and e.dst_endpoint?.proxy_endpoint?.svc_name? == null
      and e.dst_endpoint?.proxy_endpoint?.instance_uid? == null
      and e.dst_endpoint?.proxy_endpoint?.interface_uid? == null
      and e.dst_endpoint?.proxy_endpoint?.interface_name? == null
      and e.dst_endpoint?.proxy_endpoint?.domain? == null))
  }
  $ocsf.evidences = $ocsf.evidences.map(e => {
    ...e,
    src_endpoint: {
      ...e.src_endpoint?,
      proxy_endpoint: e.src_endpoint?.proxy_endpoint? if not (e.src_endpoint?.proxy_endpoint? != null
        and e.src_endpoint?.proxy_endpoint?.ip? == null
        and e.src_endpoint?.proxy_endpoint?.uid? == null
        and e.src_endpoint?.proxy_endpoint?.name? == null
        and e.src_endpoint?.proxy_endpoint?.hostname? == null
        and e.src_endpoint?.proxy_endpoint?.svc_name? == null
        and e.src_endpoint?.proxy_endpoint?.instance_uid? == null
        and e.src_endpoint?.proxy_endpoint?.interface_uid? == null
        and e.src_endpoint?.proxy_endpoint?.interface_name? == null
        and e.src_endpoint?.proxy_endpoint?.domain? == null) else null
    } if e.src_endpoint? != null else null,
    dst_endpoint: {
      ...e.dst_endpoint?,
      proxy_endpoint: e.dst_endpoint?.proxy_endpoint? if not (e.dst_endpoint?.proxy_endpoint? != null
        and e.dst_endpoint?.proxy_endpoint?.ip? == null
        and e.dst_endpoint?.proxy_endpoint?.uid? == null
        and e.dst_endpoint?.proxy_endpoint?.name? == null
        and e.dst_endpoint?.proxy_endpoint?.hostname? == null
        and e.dst_endpoint?.proxy_endpoint?.svc_name? == null
        and e.dst_endpoint?.proxy_endpoint?.instance_uid? == null
        and e.dst_endpoint?.proxy_endpoint?.interface_uid? == null
        and e.dst_endpoint?.proxy_endpoint?.interface_name? == null
        and e.dst_endpoint?.proxy_endpoint?.domain? == null) else null
    } if e.dst_endpoint? != null else null,
    connection_info: {
      ...e.connection_info,
      direction_id: e.connection_info.direction_id? else 0
    } if e.connection_info? != null else null
  })
}
if (
  $ocsf.actor? != null
  and $ocsf.actor.process? == null
  and $ocsf.actor.user? == null
  and $ocsf.actor.iam_role? == null
  and $ocsf.actor.invoked_by? == null
  and $ocsf.actor.session? == null
  and $ocsf.actor.application? == null
  and $ocsf.actor.app_name? == null
  and $ocsf.actor.app_uid? == null
) {
  $ocsf.unmapped.ocsf_residue.actor = move $ocsf.actor
}
