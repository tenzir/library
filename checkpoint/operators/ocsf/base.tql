---
description: "Check Point → OCSF Base Event (0)"
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.base_event"

$ocsf.category_uid = 0
$ocsf.class_uid = 0
$ocsf.activity_id = 0
$ocsf.type_uid = 0

if $ocsf.message? == null and $event.description? != null {
  $ocsf.message = move $event.description
}

// A record without a time keeps no time rather than the processing time.
