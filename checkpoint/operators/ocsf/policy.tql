---
description: Apply the Check Point policy that the record names
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// The policy that the gateway or the Harmony Endpoint blade enforced, with its
// version on Harmony Endpoint.
if $event.policy_name? != null {
  $ocsf.policy = {
    name: move $event.policy_name,
    version: (move $event.policy_number?).string(),
  }
}
