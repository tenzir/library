---
description: Apply shared Check Point security-control action outcome
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// The Check Point action is the security decision. Detect observes, Prevent,
// Block, Drop, Reject, Restrict, and Quarantine stop the activity, Inform User
// lets it pass with an alert, and the VPN and HTTPS inspection actions let it
// pass. Harmony Endpoint also reports the treatment of an infected file, and
// Threat Extraction removes content from a file.
match $event.action? {
  "Accept" | "Allow" | "Encrypt" | "Decrypt" | "Bypass" | "HTTPS Bypass" |
  "Inspect" | "HTTPS Inspect" => {
    $ocsf.action_id = 1
    $ocsf.disposition_id = 1
  }
  "Detect" => {
    $ocsf.action_id = 3
    $ocsf.disposition_id = 15
  }
  "Prevent" | "Block" => {
    $ocsf.action_id = 2
    $ocsf.disposition_id = 2
  }
  "Drop" => {
    $ocsf.action_id = 2
    $ocsf.disposition_id = 6
  }
  "Reject" => {
    $ocsf.action_id = 2
    $ocsf.disposition_id = 25
  }
  "Quarantine" | "Quarantined" => {
    $ocsf.action_id = 2
    $ocsf.disposition_id = 3
  }
  "Restrict" => {
    $ocsf.action_id = 2
    $ocsf.disposition_id = 2
  }
  "Inform User" | "Warn User" => {
    $ocsf.action_id = 1
    $ocsf.disposition_id = 19
  }
  "Extract" | "Cleaned" | "Cured" => {
    $ocsf.action_id = 4
    $ocsf.disposition_id = 11
  }
  "Deleted" => {
    $ocsf.action_id = 4
    $ocsf.disposition_id = 5
  }
  _ => {}
}
if $ocsf.action_id? != null {
  drop $event.action
  // In activity classes, a stopped activity failed. Findings use `status_id`
  // for their own lifecycle, which the action does not tell.
  if $ocsf.category_uid != 2 {
    $ocsf.status_id = 2 if $ocsf.action_id == 2 else 1
  }
}
