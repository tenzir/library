---
description: Apply shared Check Point security-control context
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

if $event.hll_key? != null {
  $ocsf.connection_info.uid = (move $event.hll_key).string()
}
if $event.proto? != null {
  match $event.proto {
    1 => {
      $ocsf.connection_info.protocol_name = "icmp"
    }
    6 => {
      $ocsf.connection_info.protocol_name = "tcp"
    }
    17 => {
      $ocsf.connection_info.protocol_name = "udp"
    }
    _ => {}
  }
  $ocsf.connection_info.protocol_num = move $event.proto
}
if $event.protocol_name? != null {
  $ocsf.connection_info.protocol_name = move $event.protocol_name
}

let $connection_direction_ids = {
  Incoming: 1,
  Outgoing: 2,
}
if $connection_direction_ids[$event.conn_direction?]? != null {
  $ocsf.connection_info.direction_id = $connection_direction_ids[$event.conn_direction?]
}
drop $event.conn_direction?
if $event.inzone? != null and $event.outzone? != null {
  if $event.inzone == "Internal" and $event.outzone == "Internal" {
    $ocsf.connection_info.direction_id = 3
  } else if $event.inzone == "External" and $event.outzone != "External" {
    $ocsf.connection_info.direction_id = 1
  } else if $event.inzone != "External" and $event.outzone == "External" {
    $ocsf.connection_info.direction_id = 2
  }
}

if $event.src? != null {
  $ocsf.src_endpoint.ip = move $event.src
}
if $event.s_port? != null {
  $ocsf.src_endpoint.port = move $event.s_port
}
if $event.sname? != null {
  $ocsf.src_endpoint.hostname = move $event.sname
}
if $event.inzone? != null {
  $ocsf.src_endpoint.zone = move $event.inzone
}
if $event.dst? != null {
  $ocsf.dst_endpoint.ip = move $event.dst
}
if $event.service? != null {
  $ocsf.dst_endpoint.port = move $event.service
}
if $event.service_id? != null {
  $ocsf.dst_endpoint.svc_name = move $event.service_id
}
if $event.dname? != null {
  $ocsf.dst_endpoint.hostname = move $event.dname
}
if $event.dst_domain_name? != null {
  $ocsf.dst_endpoint.domain = move $event.dst_domain_name
}
if $event.outzone? != null {
  $ocsf.dst_endpoint.zone = move $event.outzone
}

if $event.snatip? != null {
  $ocsf.src_endpoint.proxy_endpoint.ip = move $event.snatip
}
if $event.snatport? != null {
  $ocsf.src_endpoint.proxy_endpoint.port = move $event.snatport
}
if $event.dnatip? != null {
  $ocsf.dst_endpoint.proxy_endpoint.ip = move $event.dnatip
}
if $event.dnatport? != null {
  $ocsf.dst_endpoint.proxy_endpoint.port = move $event.dnatport
}

if $event.user? != null {
  $ocsf.actor.user.name = move $event.user
}
if $event.app_name? != null {
  $ocsf.app_name = move $event.app_name
}

if $event.rule_name? != null or $event.rule_uid? != null {
  $ocsf.firewall_rule = {
    name: $event.rule_name[0]?
      if type_of($event.rule_name?).kind == "list"
      else $event.rule_name?,
    uid: $event.rule_uid[0]?
      if type_of($event.rule_uid?).kind == "list"
      else $event.rule_uid?,
  }
  drop $event.rule_name?
  drop $event.rule_uid?
}

if $ocsf.src_endpoint?.ip? != null or $ocsf.dst_endpoint?.ip? != null {
  $ocsf.connection_info.protocol_ver_id = 4
}
if ($ocsf.src_endpoint?.ip? != null and $ocsf.src_endpoint.ip.is_v6()) or
   ($ocsf.dst_endpoint?.ip? != null and $ocsf.dst_endpoint.ip.is_v6()) {
  $ocsf.connection_info.protocol_ver_id = 6
}
