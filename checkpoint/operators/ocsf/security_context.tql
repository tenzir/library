---
description: Apply shared Check Point security-control context
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

$ocsf.connection_info.uid = (move $event.hll_key?).string()
if $event.proto? != null {
  match $event.proto {
    1 => {
      $ocsf.connection_info.protocol_name = "icmp"
    }
    6 => {
      $ocsf.connection_info.protocol_name = "tcp"
    }
    17 => {
      $ocsf.connection_info.protocol_name = "udp"
    }
    _ => {}
  }
  $ocsf.connection_info.protocol_num = move $event.proto
}
if $event.protocol_name? != null {
  $ocsf.connection_info.protocol_name = move $event.protocol_name
}

let $connection_direction_ids = {
  Incoming: 1,
  Outgoing: 2,
}
$ocsf.connection_info.direction_id = $connection_direction_ids[move $event.conn_direction?]?
if $event.inzone? != null and $event.outzone? != null {
  if $event.inzone == "Internal" and $event.outzone == "Internal" {
    $ocsf.connection_info.direction_id = 3
  } else if $event.inzone == "External" and $event.outzone != "External" {
    $ocsf.connection_info.direction_id = 1
  } else if $event.inzone != "External" and $event.outzone == "External" {
    $ocsf.connection_info.direction_id = 2
  }
}

$ocsf.src_endpoint = {
  ip: move $event.src?,
  port: move $event.s_port?,
  hostname: move $event.sname?,
  zone: move $event.inzone?,
  proxy_endpoint: {
    ip: move $event.snatip?,
    port: move $event.snatport?,
  },
}
$ocsf.dst_endpoint = {
  ip: move $event.dst?,
  port: move $event.service?,
  svc_name: move $event.service_id?,
  hostname: move $event.dname?,
  domain: move $event.dst_domain_name?,
  zone: move $event.outzone?,
  proxy_endpoint: {
    ip: move $event.dnatip?,
    port: move $event.dnatport?,
  },
}
$ocsf.actor.user.name = move $event.user?
if $event.app_name? != null {
  $ocsf.app_name = move $event.app_name
}

if $event.rule_name? != null or $event.rule_uid? != null {
  $ocsf.firewall_rule = {
    name: $event.rule_name[0]?
      if type_of($event.rule_name?).kind == "list"
      else $event.rule_name?,
    uid: $event.rule_uid[0]?
      if type_of($event.rule_uid?).kind == "list"
      else $event.rule_uid?,
  }
  drop $event.rule_name?
  drop $event.rule_uid?
}

if $ocsf.src_endpoint?.ip? != null or $ocsf.dst_endpoint?.ip? != null {
  $ocsf.connection_info.protocol_ver_id = 4
}
if ($ocsf.src_endpoint?.ip? != null and $ocsf.src_endpoint.ip.is_v6()) or
   ($ocsf.dst_endpoint?.ip? != null and $ocsf.dst_endpoint.ip.is_v6()) {
  $ocsf.connection_info.protocol_ver_id = 6
}
