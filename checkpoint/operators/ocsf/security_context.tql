---
description: Apply shared Check Point security-control context
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// The high-level log key groups the connections of one session, so it does not
// identify a connection and stays in `unmapped`.
$ocsf.connection_info = {}
if $event.proto? != null {
  match $event.proto {
    1 => {
      $ocsf.connection_info.protocol_name = "icmp"
    }
    6 => {
      $ocsf.connection_info.protocol_name = "tcp"
    }
    17 => {
      $ocsf.connection_info.protocol_name = "udp"
    }
    _ => {}
  }
  $ocsf.connection_info.protocol_num = move $event.proto
}
if $event.protocol_name? != null {
  $ocsf.connection_info.protocol_name = move $event.protocol_name
}
// Check Point names the TCP flags, such as FIN-ACK. Only names that are TCP
// control bits become the bitmask; others stay in `unmapped`.
if type_kind($event.tcp_flags?) == "string" {
  let $tcp_bits = {FIN: 1, SYN: 2, RST: 4, PSH: 8, ACK: 16, URG: 32, ECE: 64, CWR: 128}
  _bits = $event.tcp_flags.split("-").map(x => $tcp_bits[x.trim().to_upper()]?)
  if not _bits.contains_null() {
    $ocsf.connection_info.tcp_flags = _bits.distinct().sum()
    drop $event.tcp_flags
  }
  drop _bits
}

let $connection_direction_ids = {
  Incoming: 1,
  Outgoing: 2,
}
$ocsf.connection_info.direction_id = $connection_direction_ids[$event.conn_direction?]? else 0
if $ocsf.connection_info.direction_id != 0 {
  drop $event.conn_direction
}
if $event.inzone? != null and $event.outzone? != null {
  if $event.inzone == "Internal" and $event.outzone == "Internal" {
    $ocsf.connection_info.direction_id = 3
  } else if $event.inzone == "External" and $event.outzone != "External" {
    $ocsf.connection_info.direction_id = 1
  } else if $event.inzone != "External" and $event.outzone == "External" {
    $ocsf.connection_info.direction_id = 2
  }
}

// Build each object only from fields the record carries.
if $event.src? != null or $event.sname? != null {
  $ocsf.src_endpoint = {
    ip: move $event.src?,
    port: move $event.s_port?,
    hostname: move $event.sname?,
    zone: $event.security_inzone? else $event.inzone?,
  }
  // The security zone names the zone; inzone only tells whether it is
  // internal or external.
  if $event.security_inzone? != null {
    drop $event.security_inzone
  } else {
    drop $event.inzone?
  }
  if $event.snatip? != null {
    $ocsf.src_endpoint.proxy_endpoint = {
      ip: move $event.snatip,
      port: move $event.snatport?,
    }
  }
}
// A record can name the service without the destination address.
if $event.dst? != null or $event.dname? != null or $event.dst_domain_name? != null or
   $event.service? != null or $event.service_id? != null {
  $ocsf.dst_endpoint = {
    ip: move $event.dst?,
    port: move $event.service?,
    svc_name: move $event.service_id?,
    hostname: move $event.dname?,
    domain: move $event.dst_domain_name?,
    zone: $event.security_outzone? else $event.outzone?,
  }
  if $event.security_outzone? != null {
    drop $event.security_outzone
  } else {
    drop $event.outzone?
  }
  if $event.dnatip? != null {
    $ocsf.dst_endpoint.proxy_endpoint = {
      ip: move $event.dnatip,
      port: move $event.dnatport?,
    }
  }
}
if $event.user? != null {
  $ocsf.actor.user.name = move $event.user
  if $event.user_sid? != null {
    $ocsf.actor.user.uid = move $event.user_sid
  }
}
if $event.app_name? != null {
  $ocsf.app_name = move $event.app_name
}
// Application Control rates application risk from 1 (Very low) to 5
// (Critical); 0 means unknown. Check Point's own exports render Very low and
// Low both as Low.
let $risk_levels = {"1": 1, "2": 1, "3": 2, "4": 3, "5": 4}
if $risk_levels[$event.app_risk?.string()]? != null {
  $ocsf.risk_level_id = $risk_levels[$event.app_risk.string()]
  drop $event.app_risk
}

// The match table has one entry per policy layer that matched. The rule that
// decided the logged action represents the event; all entries stay in
// `unmapped`.
if type_kind($event.rule_name?) == "list" or type_kind($event.rule_uid?) == "list" {
  if type_kind($event.rule_name?) == "list" and
     type_kind($event.rule_uid?) == "list" and
     type_kind($event.rule_action?) == "list" {
    _rules = zip(zip($event.rule_name, $event.rule_uid), $event.rule_action).map(x => {
      name: x.left.left,
      uid: x.left.right,
      action: x.right,
    })
    _rule = _rules.where(x => x.action == $event.action?).first() else _rules.first()
    $ocsf.firewall_rule = {name: _rule.name, uid: _rule.uid}
    drop _rules, _rule
  } else {
    $ocsf.firewall_rule = {
      name: $event.rule_name[0]? if type_kind($event.rule_name?) == "list" else $event.rule_name?,
      uid: $event.rule_uid[0]? if type_kind($event.rule_uid?) == "list" else $event.rule_uid?,
    }
  }
} else if $event.rule_name? != null or $event.rule_uid? != null {
  $ocsf.firewall_rule = {
    name: move $event.rule_name?,
    uid: move $event.rule_uid?,
  }
}

if $ocsf.src_endpoint?.ip? != null or $ocsf.dst_endpoint?.ip? != null {
  $ocsf.connection_info.protocol_ver_id = 4
}
if ($ocsf.src_endpoint?.ip? != null and $ocsf.src_endpoint.ip.is_v6()) or
   ($ocsf.dst_endpoint?.ip? != null and $ocsf.dst_endpoint.ip.is_v6()) {
  $ocsf.connection_info.protocol_ver_id = 6
}
if $ocsf.connection_info.protocol_num? == null and
   $ocsf.connection_info.protocol_name? == null and
   $ocsf.connection_info.protocol_ver_id? == null and
   $ocsf.connection_info.tcp_flags? == null and
   $ocsf.connection_info.direction_id == 0 {
  drop $ocsf.connection_info
}
