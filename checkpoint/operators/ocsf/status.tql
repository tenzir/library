---
description: Apply shared Check Point status outcome
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

match $event.status? {
  "Success" => {
    $ocsf.status_id = 1
  }
  "Failure" => {
    $ocsf.status_id = 2
  }
  _ => {}
}
drop $event.status?
