---
description: Apply shared Check Point status outcome
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

// `audit_status` is the outcome of a management operation or login. It can be
// Failure while the exporter `action` is Accept.
match ($event.audit_status? else $event.status?) {
  "Success" => {
    $ocsf.status_id = 1
    drop $event.audit_status?, $event.status?
  }
  "Failure" => {
    $ocsf.status_id = 2
    drop $event.audit_status?, $event.status?
  }
  _ => {}
}
