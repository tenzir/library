---
description: "Check Point DLP/Content Awareness → OCSF Data Security Finding (2006)"
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.data_security_finding"

$ocsf.metadata.profiles = ["host", "security_control"]

$ocsf.category_uid = 2
$ocsf.class_uid = 2006
$ocsf.activity_id = 1  // Create
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
$ocsf.is_alert = true

checkpoint::ocsf::security_control_outcome $event, $ocsf

$ocsf.finding_info = {
  title: $event.data_type? else $event.reason? else $ocsf.message? else "Check Point DLP finding",
  desc: $event.reason?,
  uid: $ocsf.metadata.uid? else $ocsf.metadata.original_event_uid?,
  analytic: {
    name: $event.policy? else "Check Point DLP",
    type_id: 1,
    uid: $ocsf.metadata.uid? else $ocsf.metadata.original_event_uid?,
  },
}

$ocsf.data_security = {
  data_lifecycle_state_id: 2,
  detection_system_id: 2,
  detection_pattern: move $event.data_type?,
}
if $event.policy? != null {
  $ocsf.data_security.policy.name = move $event.policy
}

if $event.object? != null {
  $ocsf.file.name = move $event.object
  $ocsf.file.type_id = 1
}
if $event.objecttype? != null {
  $ocsf.file.type_id = 99
  $ocsf.file.type = move $event.objecttype
}
if $event.size? != null {
  $ocsf.file.size = move $event.size
}

if $event.src? != null {
  $ocsf.src_endpoint.ip = move $event.src
}
if $event.dst? != null {
  $ocsf.dst_endpoint.ip = move $event.dst
}
if $event.service? != null {
  $ocsf.dst_endpoint.port = move $event.service
}
if $event.user? != null {
  $ocsf.actor.user.name = move $event.user
}
if $event.sender? != null {
  $ocsf.actor.user.email_addr = move $event.sender
}
if $event.reason? != null {
  $ocsf.status_detail = move $event.reason
}
