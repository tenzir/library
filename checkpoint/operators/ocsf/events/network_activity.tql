---
description: "Check Point firewall traffic → OCSF Network Activity (4001)"
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.network_activity"

$ocsf.metadata.profiles = ["host", "security_control"]

$ocsf.category_uid = 4
$ocsf.class_uid = 4001
$ocsf.activity_id = 6  // Traffic
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

checkpoint::ocsf::security_control_outcome $event, $ocsf
checkpoint::ocsf::policy $event, $ocsf

checkpoint::ocsf::traffic $event, $ocsf

// The reason for the outcome: the error, the reason for dropping the
// connection, or the drop reason of SecureXL. Further reasons stay in
// `unmapped`.
if $event.reason? != null {
  $ocsf.status_detail = move $event.reason
} else if $event.action_reason? != null {
  $ocsf.status_detail = move $event.action_reason
} else if $event.drop_reason? != null {
  $ocsf.status_detail = move $event.drop_reason
}
