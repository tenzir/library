---
description: "Check Point firewall traffic → OCSF Network Activity (4001)"
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.network_activity"

$ocsf.metadata.profiles = ["host", "security_control"]

$ocsf.category_uid = 4
$ocsf.class_uid = 4001
$ocsf.activity_id = 6  // Traffic
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

match $event.action? {
  "Accept" => {
    $ocsf.action_id = 1
    $ocsf.disposition_id = 1
    $ocsf.status_id = 1
  }
  "Drop" => {
    $ocsf.action_id = 2
    $ocsf.disposition_id = 6
    $ocsf.status_id = 2
  }
  "Reject" => {
    $ocsf.action_id = 2
    $ocsf.disposition_id = 25
    $ocsf.status_id = 2
  }
  _ => {
    $ocsf.action_id = 0
    $ocsf.disposition_id = 0
    $ocsf.status_id = 0
  }
}

if $event.action? in ["Accept", "Drop", "Reject"] {
  drop $event.action
}

checkpoint::ocsf::traffic $event, $ocsf
