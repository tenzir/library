---
description: "Check Point WEB_API → OCSF API Activity (6003)"
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.api_activity"

$ocsf.metadata.profiles = ["host"]

$ocsf.category_uid = 6
$ocsf.class_uid = 6003
let $activities = {
  Create: 1,
  Read: 2,
  Update: 3,
  Delete: 4,
}
$ocsf.activity_id = $activities[$event.action?]? else 0
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

$ocsf.api = {
  operation: $event.action? else $event.subject? else "unknown",
}
drop $event.action?

checkpoint::ocsf::status $event, $ocsf

$ocsf.actor.user.name = move $event.user?
$ocsf.src_endpoint.ip = move $event.src?
if $event.object? != null or $event.objecttype? != null {
  $ocsf.resources = [{
    name: move $event.object?,
    type: move $event.objecttype?,
  }]
}
$ocsf.api.request.uid = move $event.subject?
