---
description: "Check Point → OCSF API Activity (6003)"
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.api_activity"

$ocsf.metadata.profiles = ["host"]

$ocsf.category_uid = 6
$ocsf.class_uid = 6003
// The Management API operation is the API call. The subject describes the
// audit record and a session UID is no request identifier.
if $event.operation? != null {
  $ocsf.api.operation = $event.operation
}
checkpoint::ocsf::management_activity $event, $ocsf
drop $event.operation?
drop $event.session_uid?

if $event.object? != null or $event.uid? != null {
  $ocsf.resources = [{
    name: move $event.object?,
    uid: (move $event.uid?).string(),
    type: move $event.objecttype?,
  }]
}
