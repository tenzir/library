---
description: "Check Point → OCSF Tunnel Activity (4014)"
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.tunnel_activity"

$ocsf.metadata.profiles = ["host", "security_control"]

$ocsf.category_uid = 4
$ocsf.class_uid = 4014
// A Key Install record does not tell a new tunnel from a renewed one.
$ocsf.activity_id = 99
$ocsf.activity_name = move $event.action
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

checkpoint::ocsf::status $event, $ocsf

if $event.src? != null or $event.sname? != null {
  $ocsf.src_endpoint = {
    ip: move $event.src?,
    port: move $event.s_port?,
    hostname: move $event.sname?,
  }
}
if $event.dst? != null or $event.dname? != null {
  $ocsf.dst_endpoint = {
    ip: move $event.dst?,
    port: move $event.service?,
    hostname: move $event.dname?,
  }
}
if $event.user? != null {
  $ocsf.user.name = move $event.user
}
if $event.session_uid? != null {
  $ocsf.session.uid = (move $event.session_uid).string()
}
if $event.proto? != null {
  $ocsf.connection_info = {
    protocol_num: move $event.proto,
    direction_id: 0,
  }
}

checkpoint::ocsf::traffic $event, $ocsf
