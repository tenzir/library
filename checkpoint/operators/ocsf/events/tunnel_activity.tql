---
description: "Check Point VPN/Mobile Access → OCSF Tunnel Activity (4014)"
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.tunnel_activity"

$ocsf.metadata.profiles = ["host", "security_control"]

$ocsf.category_uid = 4
$ocsf.class_uid = 4014
let $activities = {
  Connect: 1,
  Login: 1,
  "Log In": 1,
  Disconnect: 2,
  Logout: 2,
  "Log Out": 2,
  Renew: 3,
}
$ocsf.activity_id = $activities[$event.action?]? else 0
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id
drop $event.action?

checkpoint::ocsf::status $event, $ocsf

$ocsf.src_endpoint = {
  ip: move $event.src?,
  port: move $event.s_port?,
}
$ocsf.dst_endpoint = {
  ip: move $event.dst?,
  port: move $event.service?,
}
$ocsf.user.name = move $event.user?
$ocsf.session.uid = move $event.session?
if $event.vpn_feature? != null {
  $ocsf.tunnel_type_id = 99
  $ocsf.tunnel_type = move $event.vpn_feature
}
$ocsf.connection_info.protocol_num = move $event.proto?
$ocsf.protocol_name = "VPN"

checkpoint::ocsf::traffic $event, $ocsf
