---
description: "Check Point MTA/Anti-Spam/Email Security → OCSF Email Activity (4009)"
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.email_activity"

$ocsf.metadata.profiles = ["host", "security_control"]

$ocsf.category_uid = 4
$ocsf.class_uid = 4009
$ocsf.activity_id = 3  // Scan
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

checkpoint::ocsf::security_control_outcome $event, $ocsf

let $direction_ids = {
  Inbound: 1,
  Outbound: 2,
  Incoming: 1,
  Outgoing: 2,
}
$ocsf.direction_id = $direction_ids[$event.direction?]? else $direction_ids[$event.conn_direction?]? else 0
drop $event.direction?
drop $event.conn_direction?

$ocsf.email = {
  from: move $event.sender?,
  to: [move $event.recipient?],
  subject: move $event.subject?,
  size: move $event.size?,
}

if $event.src? != null {
  $ocsf.src_endpoint.ip = move $event.src
}
if $event.s_port? != null {
  $ocsf.src_endpoint.port = move $event.s_port
}
if $event.dst? != null {
  $ocsf.dst_endpoint.ip = move $event.dst
}
if $event.service_id? != null {
  $ocsf.protocol_name = move $event.service_id
} else if $event.service? == 25 {
  $ocsf.protocol_name = "SMTP"
}
if $event.service? != null {
  $ocsf.dst_endpoint.port = move $event.service
}
if $event.status? != null {
  $ocsf.status_detail = move $event.status
}
