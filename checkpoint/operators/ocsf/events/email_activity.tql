---
description: "Check Point MTA/Anti-Spam/Email Security → OCSF Email Activity (4009)"
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.email_activity"

$ocsf.metadata.profiles = ["host", "security_control"]

$ocsf.category_uid = 4
$ocsf.class_uid = 4009
$ocsf.activity_id = 3  // Scan
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

checkpoint::ocsf::security_control_outcome $event, $ocsf

let $direction_ids = {
  Inbound: 1,
  Outbound: 2,
  Incoming: 1,
  Outgoing: 2,
}
$ocsf.direction_id = $direction_ids[$event.direction?]? else $direction_ids[$event.conn_direction?]? else 0
if $direction_ids[$event.direction?]? != null {
  drop $event.direction
} else if $direction_ids[$event.conn_direction?]? != null {
  drop $event.conn_direction
}

if $event.sender? != null or $event.recipient? != null or
   $event.subject? != null or $event.email_message_id? != null {
  $ocsf.email = {
    from: move $event.sender?,
    to: [move $event.recipient?] if $event.recipient? != null else null,
    subject: move $event.subject?,
    size: move $event.size?,
    message_uid: move $event.email_message_id?,
  }
}

if $event.src? != null or $event.sname? != null {
  $ocsf.src_endpoint = {
    ip: move $event.src?,
    port: move $event.s_port?,
    hostname: move $event.sname?,
  }
}
if $event.dst? != null or $event.dname? != null {
  $ocsf.dst_endpoint = {
    ip: move $event.dst?,
    port: move $event.service?,
    hostname: move $event.dname?,
  }
}
$ocsf.protocol_name = move $event.service_id?
$ocsf.status_detail = move $event.status?
