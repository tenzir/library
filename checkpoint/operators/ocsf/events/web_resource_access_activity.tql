---
description: "Check Point URL/Application Control -> OCSF HTTP Activity (4002)"
args:
  positional:
    - name: event
      description: The field that holds the event to map.
      type: field
    - name: ocsf
      description: The OCSF output field.
      type: field
---

@name = "ocsf.http_activity"

$ocsf.metadata.profiles = ["host", "security_control"]

$ocsf.category_uid = 4
$ocsf.class_uid = 4002

$ocsf.activity_id = 0
checkpoint::ocsf::security_control_outcome $event, $ocsf
$ocsf.type_uid = $ocsf.class_uid * 100 + $ocsf.activity_id

drop $event.action?

$ocsf.http_request.url.url_string = move $event.url?
$ocsf.src_endpoint = {
  ip: move $event.src?,
  port: move $event.s_port?,
  hostname: move $event.sname?,
}
$ocsf.status_detail = move $event.reason?
