---
name: Detect credential stuffing
description: |
  Reads OCSF HTTP Activity from edge logs, such as CDN or WAF request logs,
  from a Kafka topic, detects bursts of failed logins against the login
  endpoints, and sends the OCSF Detection Findings to Splunk.
---

from_kafka "ocsf-http-activity"
this = message.parse_json()
// OCSF JSON carries timestamps as milliseconds since the epoch.
time = from_epoch(time * 1ms)
this = ocsf_cast(this)
tenzir::detect::http::credential_stuffing paths=["/login", "/api/login"]
to_splunk "https://splunk.example.com:8088", hec_token=secret("splunk-hec-token")
