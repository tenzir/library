// A time 10 minutes ahead is untimely by default but fine with a 1h tolerance.
from {case: "default", class_uid: 4001, activity_id: 1, type_uid: 400101},
  {case: "tolerant", class_uid: 4001, activity_id: 1, type_uid: 400101}
time = now() + 10min
if case == "default" {
  tenzir::ocsf::quality
} else {
  tenzir::ocsf::quality tolerance=1h
}
select case, tags=metadata?.tags?
