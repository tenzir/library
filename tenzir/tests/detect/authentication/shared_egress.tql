// A corporate egress address carries the morning logon wave: 300 users log
// in, and 40 of them mistype their password first. Plenty of accounts fail,
// but at 12% the failure share stays far below min_failure_share.
from {}
repeat 340
enumerate n
this = {
  time: 2024-01-01T08:00:00Z + n * 1s,
  class_uid: 3002,
  activity_id: 1,
  status_id: 2 if n < 40 else 1,
  user: {name: f"user{n if n < 40 else n - 40}@example.com"},
  src_endpoint: {ip: 192.0.2.10},
}
tenzir::detect::authentication::credential_stuffing
summarize findings=count()
