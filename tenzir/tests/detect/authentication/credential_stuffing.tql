// A client tries 30 leaked credentials in two and a half minutes. One of them
// works, which raises the severity and names the account. Logoffs and events
// without a source address don't count.
from {}
repeat 32
enumerate n
this = {
  time: 2024-01-01T10:00:00Z + n * 5s,
  class_uid: 3002,
  activity_id: 2 if n == 31 else 1,
  status_id: 1 if n in [17, 31] else 2,
  user: {name: f"user{n}@example.com"},
  src_endpoint: {ip: 198.51.100.23 if n != 30},
}
tenzir::detect::authentication::credential_stuffing
this = ocsf_cast(this)
drop time, metadata.uid
