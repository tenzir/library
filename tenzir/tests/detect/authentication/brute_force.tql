// A hundred failed logons against one account are brute force, not
// credential stuffing, and stay below min_users.
from {}
repeat 100
enumerate n
this = {
  time: 2024-01-01T10:00:00Z + n * 3s,
  class_uid: 3002,
  activity_id: 1,
  status_id: 2,
  user: {name: "alice@example.com"},
  src_endpoint: {ip: 198.51.100.23},
}
tenzir::detect::authentication::credential_stuffing
summarize findings=count()
