from {
  marker: "preserved",
  device: {hostname: "ws-42"},
  process: {name: "mimikatz.exe"},
  behavior: {
    feature: "process.name",
    entity: "ws-42",
    value: "mimikatz.exe",
    status: "ready",
    baseline_count: 10,
    familiarity: 0.0,
    drift: null,
    score: 1.0,
  },
}
tenzir::detect::behavior::categorical::finding into=finding
select marker, finding.risk_score, finding.finding_info.title
