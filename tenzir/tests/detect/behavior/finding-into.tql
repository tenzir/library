from {
  marker: "preserved",
  device: {hostname: "ws-42"},
  process: {name: "mimikatz.exe"},
  behavior: {
    status: "ready",
    baseline_count: 10,
    familiarity: 0.0,
    drift: null,
    score: 1.0,
  },
}
tenzir::detect::behavior::categorical::finding \
  feature_name="process.name",
  result=behavior,
  into=finding
select marker, finding.risk_score, finding.finding_info.title
