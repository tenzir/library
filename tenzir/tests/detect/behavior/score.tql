let $ready = {
  features: frequency_table(["chrome.exe", "chrome.exe", "chrome.exe", "outlook.exe", "teams.exe"]),
  samples: 5,
  updated_at: now(),
}
from {case: "missing", process: {name: "mimikatz.exe"}, baseline: null},
     {case: "immature", process: {name: "mimikatz.exe"}, baseline: {features: $ready.features, samples: 2, updated_at: now()}},
     {case: "stale", process: {name: "mimikatz.exe"}, baseline: {features: $ready.features, samples: 5, updated_at: 2020-01-01T00:00:00Z}},
     {case: "ready-unfamiliar", process: {name: "mimikatz.exe"}, baseline: $ready},
     {case: "ready-familiar", process: {name: "chrome.exe"}, baseline: $ready},
     {case: "ready-rare", process: {name: "teams.exe"}, baseline: $ready}
tenzir::detect::behavior::score min_samples=5
select case, baseline_status, familiarity, drift, score
