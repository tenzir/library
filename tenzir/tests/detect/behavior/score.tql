let $ready = {
  distribution: frequency_table([
    "chrome.exe",
    "chrome.exe",
    "chrome.exe",
    "outlook.exe",
    "teams.exe",
  ]),
  trained_at: now(),
}
from {case: "missing", process: {name: "mimikatz.exe"}, baseline: null},
     {case: "immature", process: {name: "mimikatz.exe"}, baseline: {distribution: frequency_table(["chrome.exe", "outlook.exe"]), trained_at: now()}},
     {case: "stale", process: {name: "mimikatz.exe"}, baseline: {distribution: $ready.distribution, trained_at: 2020-01-01T00:00:00Z}},
     {case: "ready-unfamiliar", process: {name: "mimikatz.exe"}, baseline: $ready},
     {case: "ready-familiar", process: {name: "chrome.exe"}, baseline: $ready},
     {case: "ready-rare", process: {name: "teams.exe"}, baseline: $ready}
tenzir::detect::behavior::categorical::score min_samples=5, into=behavior
select case, behavior
