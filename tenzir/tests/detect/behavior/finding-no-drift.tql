from {
  src_endpoint: {ip: 10.0.0.9},
  dst_endpoint: {port: 4444},
  behavior: {
    status: "ready",
    baseline_count: 1149,
    familiarity: 0.25,
    drift: null,
    score: 0.75,
  },
}
tenzir::detect::behavior::categorical::finding \
  entity=src_endpoint.ip,
  feature=dst_endpoint.port,
  feature_name="dst_endpoint.port",
  result=behavior
select finding_info.analytic,
       finding_info.title,
       finding_info.desc,
       risk_score,
       evidences
