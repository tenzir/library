let $ready = {
  distribution: frequency_table([
    "chrome.exe",
    "chrome.exe",
    "chrome.exe",
    "outlook.exe",
    "teams.exe",
  ]),
  trained_at: now(),
}
from {time: 2024-01-03T09:00:00Z, process: {name: "chrome.exe"}, baseline: $ready},
     {time: 2024-01-03T09:01:00Z, process: {name: "mimikatz.exe"}, baseline: $ready},
     {time: 2024-01-03T09:02:00Z, process: {name: "mimikatz.exe"}, baseline: $ready}
window size=5min, on=time {
  summarize current=frequency_table(process.name), options={output: "events"}
}
tenzir::detect::behavior::categorical::score \
  current=current,
  min_samples=5,
  drift_weight=0.5,
  into=behavior
select process.name, behavior
