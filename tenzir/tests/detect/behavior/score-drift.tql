let $ready = {
  distribution: frequency_table([
    "chrome.exe",
    "chrome.exe",
    "chrome.exe",
    "outlook.exe",
    "teams.exe",
  ]),
  trained_at: now(),
}
from {time: 2024-01-03T09:00:00Z, device: {hostname: "ws-42"}, process: {name: "chrome.exe"}, baseline: $ready},
     {time: 2024-01-03T09:01:00Z, device: {hostname: "ws-42"}, process: {name: "mimikatz.exe"}, baseline: $ready},
     {time: 2024-01-03T09:02:00Z, device: {hostname: "ws-42"}, process: {name: "mimikatz.exe"}, baseline: $ready}
tenzir::detect::behavior::categorical::score \
  window_size=5min,
  min_samples=5,
  drift_weight=0.5,
  into=behavior
select process.name, behavior
// Ignore platform-dependent last-bit differences while checking twelve decimals.
behavior.drift = round(behavior.drift * 1e12) / 1e12
behavior.score = round(behavior.score * 1e12) / 1e12
