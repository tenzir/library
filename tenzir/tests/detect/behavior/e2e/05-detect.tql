from {time: 2024-01-03T09:00:00Z, device: {hostname: "ws-42"}, process: {name: "chrome.exe"}},
     {time: 2024-01-03T09:01:00Z, device: {hostname: "ws-42"}, process: {name: "outlook.exe"}},
     {time: 2024-01-03T09:02:00Z, device: {hostname: "ws-42"}, process: {name: "mimikatz.exe"}},
     {time: 2024-01-03T09:03:00Z, device: {hostname: "srv-01"}, process: {name: "sqlservr.exe"}},
     {time: 2024-01-03T09:04:00Z, device: {hostname: "srv-01"}, process: {name: "psexec.exe"}},
     {time: 2024-01-03T09:05:00Z, device: {hostname: "ws-99"}, process: {name: "mimikatz.exe"}}
context_enrich "process-name-baselines", key=device.hostname, into=baseline
tenzir::detect::behavior::categorical::score \
  window_size=5min,
  min_samples=5
where behavior.status == "ready" and behavior.score >= 0.5
tenzir::detect::behavior::categorical::finding
ocsf_cast
drop time, metadata.uid
