from {time: 2024-01-03T09:02:00Z, device: {hostname: "ws-42"}, process: {name: "mimikatz.exe"}},
     {time: 2024-01-03T09:04:00Z, device: {hostname: "srv-01"}, process: {name: "psexec.exe"}},
     {time: 2024-01-03T09:05:00Z, device: {hostname: "ws-99"}, process: {name: "mimikatz.exe"}}
