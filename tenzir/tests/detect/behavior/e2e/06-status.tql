from {device: {hostname: "ws-42"}, process: {name: "mimikatz.exe"}},
     {device: {hostname: "srv-01"}, process: {name: "psexec.exe"}},
     {device: {hostname: "ws-99"}, process: {name: "mimikatz.exe"}}
context_enrich "process-name-baselines", key=device.hostname, into=baseline
tenzir::detect::behavior::categorical::score min_samples=5, into=behavior
select device.hostname, behavior
