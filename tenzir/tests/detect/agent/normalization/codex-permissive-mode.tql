from_file env("TENZIR_INPUT") {
  read_json
}
modes = ["danger-full-access", "read-only"]
unroll modes
attributes.sandbox_policy = move modes
@name = "otel.log"
openai::codex::ocsf::normalize
this = ocsf_cast(ocsf_derive(this))
assert class_uid == 3003
tenzir::detect::agent::permissive_mode
this = ocsf_cast(ocsf_derive(this))
assert class_uid == 2004
assert start_time == 2026-07-30T08:00:02Z
assert evidences[0].ai_agent.name != null
summarize findings=count()
assert findings == 1
