strict {
  from_file env("TENZIR_INPUT") {
    read_json
  }
  modes = ["bypassPermissions", "default"]
  unroll modes
  attributes.to_mode = move modes
  @name = "otel.log"
  anthropic::claude_code::ocsf::normalize
  this = ocsf_cast(ocsf_derive(this))
  assert class_uid == 0
  tenzir::detect::agent::permissive_mode
  this = ocsf_cast(ocsf_derive(this))
  assert class_uid == 2004
  assert start_time == 2026-07-30T08:01:40Z
  assert evidences[0].ai_agent.name != null
}
summarize findings=count()
strict {
  assert findings == 1
}
