// Tumbling windows split bursts at their epoch-aligned boundaries. A burst of
// 60 failures across 10:05 puts 30 into each window and goes unreported. A
// burst of 100 failures across 10:15 reaches 50 in both windows and yields
// one finding per window.
from {}
repeat 160
enumerate n
this = {
  time: 2024-01-01T10:04:00Z + n * 4s if n < 60
        else 2024-01-01T10:14:10Z + (n - 60) * 1s,
  class_uid: 4002,
  http_request: {http_method: "POST", url: {path: "/login"}},
  http_response: {code: 401},
  src_endpoint: {ip: 203.0.113.7 if n < 60 else 203.0.113.9},
}
tenzir::detect::http::credential_stuffing
select start_time, end_time, finding_info.uid, finding_info.desc
sort start_time
