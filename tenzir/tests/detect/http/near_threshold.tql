// Neither source crosses both thresholds: 49 failures are one short of
// min_failures, and 50 failures with 6 successes are an 89% failure share.
from {}
repeat 105
enumerate n
this = {
  time: 2024-01-01T10:00:00Z + n * 2s,
  class_uid: 4002,
  http_request: {http_method: "POST", url: {path: "/login"}},
  http_response: {code: 302 if n >= 99 else 401},
  src_endpoint: {ip: 203.0.113.7 if n < 49 else 203.0.113.8},
}
tenzir::detect::http::credential_stuffing
summarize findings=count()
