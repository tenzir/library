// A script fires 60 failed logins at /login within three minutes. A second
// client logs in once, and a GET of the login page doesn't count.
from {}
repeat 60
enumerate n
this = {
  time: 2024-01-01T10:00:00Z + n * 3s,
  class_uid: 4002,
  http_request: {http_method: "POST", url: {path: "/login"}, user_agent: "python-requests/2.31"},
  http_response: {code: 401},
  src_endpoint: {ip: 203.0.113.7},
}
merge {
  from {time: 2024-01-01T10:01:00Z, class_uid: 4002, http_request: {http_method: "POST", url: {path: "/login"}}, http_response: {code: 302}, src_endpoint: {ip: 198.51.100.4}},
       {time: 2024-01-01T10:01:00Z, class_uid: 4002, http_request: {http_method: "GET", url: {path: "/login"}}, http_response: {code: 401}, src_endpoint: {ip: 203.0.113.7}}
}
tenzir::detect::http::credential_stuffing
this = ocsf_cast(this)
drop time, metadata.uid
