---
description: Trims OCSF events according to a size profile.
args:
  named:
    - name: size
      type: string
      default: M
      description: |
        Size profile: S, M, or L.
---

match $size {
  "S" => {
    this = ocsf_trim(this, drop_optional=true, drop_recommended=true)
  }
  "L" => {
    this = ocsf_trim(this, drop_optional=false, drop_recommended=false)
  }
  _ => {
    this = ocsf_trim(this, drop_optional=true, drop_recommended=false)
  }
}
