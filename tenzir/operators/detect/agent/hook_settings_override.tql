---
description: Detects an agent hook registered through a CLI or deeplink settings
  override rather than a committed project or user settings file.
args:
  named:
    - name: analytic_uid
      type: string
      default: "tenzir::detect::agent::hook_settings_override"
      description: Analytic identifier to attach to findings.
---

where class_uid == 6002 and unmapped.hook_source == "flagSettings"
agent = ai_agent.name
hook_label = application.name
hook_event = unmapped.hook_event?
this = {
  time: now(),
  metadata: {
    product: {name: "Tenzir", vendor_name: "Tenzir"},
    uid: uuid(),
    version: "1.9.0",
  },
  category_uid: 2,
  class_uid: 2004,
  activity_id: 1,
  type_uid: 200401,
  severity_id: 3,
  status_id: 1,
  is_alert: true,
  start_time: time,
  end_time: time,
  finding_info: {
    uid: uuid(),
    title: f"Hook {hook_label} registered via a CLI settings override on {agent}",
    desc: f"hook_source=flagSettings for event {hook_event}; this settings tier " +
          "ranks above committed project and user files, matching the " +
          "mechanism behind CVE-2025-59536 and CVE-2026-21852",
    analytic: {
      name: "Hook registered via settings override",
      uid: $analytic_uid,
      type_id: 1,
      version: "1.0",
    },
    attacks: [{
      tactic: {uid: "TA0003", name: "Persistence"},
      technique: {uid: "T1546", name: "Event Triggered Execution"},
    }],
  },
  evidences: [{ai_agent: ai_agent}],
}
