---
description: Detects credential or secret material in agent prompts, completions, or tool arguments.
---

where "ai_operation" in metadata.profiles
text = message_context?.prompt_text? else message_context?.response_text? else process.cmd_line?
where text != null
kind = "aws_access_key_id" if text.match_regex(r"AKIA[0-9A-Z]{16}") else
       "private_key" if text.match_regex(r"-----BEGIN (RSA |EC |OPENSSH |)PRIVATE KEY-----") else
       "github_token" if text.match_regex(r"gh[pousr]_[A-Za-z0-9]{36,}") else
       "slack_token" if text.match_regex(r"xox[baprs]-[0-9A-Za-z-]{10,}") else
       null
where kind != null
event_time = time
// The matched value never leaves this operator; only its kind and a hash do.
evidence_hash = hash_sha256(text)
this = {
  time: now(),
  metadata: {
    product: {name: "Tenzir", vendor_name: "Tenzir"},
    uid: uuid(),
    version: "1.9.0",
    profiles: ["ai_operation"],
  },
  category_uid: 2,
  class_uid: 2004,
  activity_id: 1,
  type_uid: 200401,
  severity_id: 3,
  status_id: 1,
  is_alert: true,
  start_time: event_time,
  end_time: event_time,
  finding_info: {
    uid: uuid(),
    title: f"Credential material ({kind}) exposed to an agent",
    desc: f"Matched {kind}; evidence hash {evidence_hash}. Raw content withheld from this finding.",
    analytic: {
      name: "Agent credential exposure",
      uid: "tenzir::detect::agent::credential_exposure",
      type_id: 1,
      version: "1.0",
    },
    attacks: [{
      tactic: {uid: "TA0006", name: "Credential Access"},
      technique: {uid: "T1552", name: "Unsecured Credentials"},
    }],
  },
  evidences: [{ai_agent: ai_agent}],
  unmapped: {kind: kind, evidence_hash: evidence_hash},
}
