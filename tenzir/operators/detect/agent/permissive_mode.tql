---
description: Detects an agent session assigned a full-autonomy permission or sandbox mode.
---

where class_uid == 3003 and
      ("approval:bypassPermissions" in privileges or
       "sandbox:danger-full-access" in privileges)
this = {
  time: now(),
  metadata: {
    product: {name: "Tenzir", vendor_name: "Tenzir"},
    uid: uuid(),
    version: "1.9.0",
  },
  category_uid: 2,
  class_uid: 2004,
  activity_id: 1,
  type_uid: 200401,
  severity_id: 3,
  status_id: 1,
  is_alert: true,
  start_time: time,
  end_time: time,
  finding_info: {
    uid: uuid(),
    title: f"Agent session assigned a disallowed permission mode",
    desc: f"Session for agent {ai_agent.name} was assigned {privileges}, which policy does not allow regardless of who or what assigned it.",
    analytic: {
      name: "Agent permissive mode",
      uid: "tenzir::detect::agent::permissive_mode",
      type_id: 1,
      version: "1.0",
    },
    attacks: [{
      tactic: {uid: "TA0004", name: "Privilege Escalation"},
      technique: {uid: "T1548", name: "Abuse Elevation Control Mechanism"},
    }],
  },
  evidences: [{
    user: user,
    ai_agent: ai_agent,
  }],
}
