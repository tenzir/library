---
description: Detects feature values that deviate from an entity's learned baseline.
args:
  named:
    - name: entity
      type: field
      default: device.hostname
      description: Field that identifies the entity to score against its baseline.
    - name: feature
      type: field
      default: process.name
      description: Categorical field to score against the learned distribution.
    - name: context
      type: string
      default: behavior-baselines
      description: Lookup-table context that holds the learned baselines.
    - name: feature_name
      type: string
      default: process.name
      description: Label of the scored feature that identifies the analytic; set it to match `feature` when deploying the operator for several features.
    - name: min_samples
      type: int
      default: 500
      description: Minimum number of learned observations before a baseline scores events.
    - name: max_age
      type: duration
      default: 2d
      description: Maximum time since the last baseline update before it counts as stale.
    - name: lambda
      type: float
      default: 0.5
      description: Weight of distribution drift relative to per-value familiarity.
    - name: threshold
      type: float
      default: 0.5
      description: Minimum anomaly score for emitting a finding.
    - name: window_size
      type: duration
      default: 5min
      description: Event-time window over which to measure the current feature distribution.
    - name: tolerance
      type: duration
      default: 1min
      description: Maximum expected lateness for out-of-order events.
    - name: idle_timeout
      type: duration
      default: 5min
      description: Inactivity after which the current window closes.
---

window size=$window_size, on=time, tolerance=$tolerance,
       idle_timeout=$idle_timeout {
  summarize $entity,
            current=frequency_table($feature),
            options={output: "events"}
}
context_enrich $context, key=$entity, into=baseline
where baseline != null
where baseline.samples >= $min_samples
where now() - baseline.updated_at < $max_age
familiarity = frequency_table_count(baseline.features, $feature) *
              baseline.features.values.length() / baseline.features.count
familiarity = 1.0 if familiarity > 1.0 else familiarity
drift = model_divergence(baseline.features, current,
                         method="jensen_shannon") / log(2.0)
score = (1.0 - familiarity) * (1.0 - $lambda) + drift * $lambda
where score >= $threshold
this = {
  time: now(),
  metadata: {
    product: {name: "Tenzir", vendor_name: "Tenzir"},
    uid: uuid(),
    version: "1.9.0",
  },
  category_uid: 2,
  class_uid: 2004,
  activity_id: 1,
  type_uid: 200401,
  severity_id: 3,
  status_id: 1,
  risk_score: round(score * 100),
  finding_info: {
    uid: uuid(),
    title: f"Unfamiliar {$feature} for {$entity}",
    desc: f"familiarity {familiarity}, drift {drift}, baseline of {baseline.samples} samples",
    analytic: {
      name: f"Abnormal features: {$feature_name}",
      uid: f"tenzir::detect::behavior::abnormal_features:{$feature_name}",
      type_id: 3,
      version: "1.0",
    },
  },
  evidences: [{
    data: {entity: $entity, value: $feature},
  }],
}
