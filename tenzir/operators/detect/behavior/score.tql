---
description: Scores a feature value against the entity's baseline row carried by the event.
args:
  named:
    - name: feature
      type: field
      default: process.name
      description: Categorical field to score against the baseline distribution.
    - name: baseline
      type: field
      default: baseline
      description: Field holding the baseline row from `tenzir::detect::behavior::model`.
    - name: current
      type: field
      default: null
      description: Optional frequency table of the current window; without it, drift is null and the score uses familiarity alone.
    - name: lambda
      type: float
      default: 0.5
      description: Weight of distribution drift relative to per-value familiarity.
    - name: min_samples
      type: int
      default: 500
      description: Minimum number of learned observations before a baseline counts as ready.
    - name: max_age
      type: duration
      default: 2d
      description: Maximum time since the last baseline update before it counts as stale.
---

baseline_status = "missing" if $baseline == null else (
  "immature" if $baseline.samples < $min_samples else (
    "stale" if now() - $baseline.updated_at >= $max_age else "ready"
  )
)
// Conditional expressions instead of an `if` block keep every row on one
// schema and sidestep an engine assertion in `frequency_table_count` over
// sliced batches.
familiarity = (
  frequency_table_count($baseline.features?, $feature) *
  $baseline.features?.values?.length() / $baseline.features?.count?
) if baseline_status == "ready" else null
familiarity = 1.0 if familiarity > 1.0 else familiarity
if $current != null {
  drift = model_divergence($baseline.features?, $current,
                           method="jensen_shannon") / log(2.0)
  drift = drift if baseline_status == "ready" else null
} else {
  drift = null
}
score = null if baseline_status != "ready" else (
  1.0 - familiarity if drift == null else (
    (1.0 - familiarity) * (1.0 - $lambda) + drift * $lambda
  )
)
