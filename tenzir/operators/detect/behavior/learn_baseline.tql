---
description: Learns per-entity behavioral baselines into a lookup-table context.
args:
  named:
    - name: entity
      type: field
      default: device.hostname
      description: Field that identifies the entity to baseline.
    - name: feature
      type: field
      default: process.name
      description: Categorical field whose distribution to learn per entity.
    - name: context
      type: string
      default: behavior-baselines
      description: Lookup-table context that stores one baseline per entity.
    - name: window_size
      type: duration
      default: 5min
      description: Processing-time interval at which to fold new observations into the stored baselines.
---

window size=$window_size {
  summarize entity=$entity,
            features=frequency_table($feature),
            hours=histogram(time.hour(), bins=24, width=1, start=0),
            samples=count()
}
context_enrich $context, key=entity, into=previous
features = model_merge([previous?.features?, features])
hours = model_merge([previous?.hours?, hours])
samples = samples + (previous?.samples? else 0)
updated_at = now()
context_update $context,
  key=entity,
  value={
    features: features,
    hours: hours,
    samples: samples,
    updated_at: updated_at,
  }
