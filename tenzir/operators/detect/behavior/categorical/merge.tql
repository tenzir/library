---
description: Merges a categorical baseline with an earlier compatible baseline.
args:
  positional:
    - name: baseline
      type: field
      description: Current baseline to update in place.
    - name: previous
      type: field
      description: Earlier baseline to merge into the current baseline.
---

if $previous != null {
  $baseline.distribution = model_merge([
    $previous.distribution,
    $baseline.distribution,
  ])
}
