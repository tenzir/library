// A record that nothing parsed, or that is not a Kunai event, becomes a Base
// Event, so no event disappears. A record keeps its fields under `unmapped`.
from {kunai: null},
     {kunai: {message: "not a Kunai event", level: 3}}
this = {...this, ocsf: {}}
kunai::ocsf::map kunai, ocsf
this = ocsf
assert type_kind(time) == "time"
time = 2026-01-01
this = ocsf_cast(this)
drop_null_fields
