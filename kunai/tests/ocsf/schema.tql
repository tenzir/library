// Cast every Kunai event type to OCSF and record schema validation diagnostics.
// The baseline includes warnings for incomplete source records.
from_file f"{env("TENZIR_INPUTS")}/events.ndjson" {
  read_ndjson
}
kunai::ocsf::normalize
this = ocsf_cast(this)
summarize class_uid, activity_id, events=count()
sort class_uid, activity_id
