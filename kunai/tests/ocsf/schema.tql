// Every event type that Kunai defines must satisfy the OCSF schema: `ocsf_cast`
// warns about each attribute that the schema does not know, and the harness
// fails on warnings.
from_file f"{env("TENZIR_INPUTS")}/events.ndjson" {
  read_ndjson
}
kunai::ocsf::normalize
ocsf_derive
ocsf_cast
summarize class_name, activity_name, events=count()
sort class_name, activity_name
