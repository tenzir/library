from_file f"{env("TENZIR_INPUTS")}/events.ndjson" {
  read_ndjson
}
where info.event.name in ["read", "read_config", "write", "write_config", "write_close", "file_create", "file_rename", "file_unlink"]
this = {source: this, ocsf: {}}
kunai::ocsf::map source, ocsf
this = ocsf
ocsf_cast
drop_null_fields
