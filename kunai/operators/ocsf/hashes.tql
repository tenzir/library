---
description: |
  Builds OCSF Fingerprints from the hashes that Kunai computed.

  The output is `null` when Kunai computed no hash at all, for example when the
  file vanished before Kunai could read it.
args:
  positional:
    - name: kunai_hashes
      type: field
      description: The Kunai record with the `md5`, `sha1`, `sha256`, and `sha512` hashes to consume.
    - name: hashes
      type: field
      description: The field that receives the OCSF fingerprints.
---

$hashes = [
  {algorithm_id: 1, value: move $kunai_hashes.md5?},
  {algorithm_id: 2, value: move $kunai_hashes.sha1?},
  {algorithm_id: 3, value: move $kunai_hashes.sha256?},
  {algorithm_id: 4, value: move $kunai_hashes.sha512?},
].where(hash => hash.value != null)
if $hashes.length() == 0 {
  $hashes = null
}
