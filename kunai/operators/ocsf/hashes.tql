---
description: |
  Builds OCSF Fingerprints from the hashes that Kunai computed.

  Kunai writes `?` or an empty string for a hash that it could not compute, for
  example when the file vanished before it could be read, and the operator leaves
  those out. The output is `null` when Kunai computed no hash at all.
args:
  positional:
    - name: kunai_hashes
      type: field
      description: The Kunai record with the `md5`, `sha1`, `sha256`, and `sha512` hashes to consume.
    - name: hashes
      type: field
      description: The field that receives the OCSF fingerprints.
---

$hashes = [
  {algorithm_id: 1, value: $kunai_hashes.md5?},
  {algorithm_id: 2, value: $kunai_hashes.sha1?},
  {algorithm_id: 3, value: $kunai_hashes.sha256?},
  {algorithm_id: 4, value: $kunai_hashes.sha512?},
].where(hash => hash.value != null and hash.value not in ["", "?"])
if $hashes.length() == 0 {
  $hashes = null
}
drop $kunai_hashes.md5?, $kunai_hashes.sha1?, $kunai_hashes.sha256?, $kunai_hashes.sha512?
