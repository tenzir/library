---
description: Kunai `file_scan` with a positive match → OCSF Detection Finding (2004, Create).
args:
  positional:
    - name: kunai
      type: field
      description: The Kunai event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

@name = "ocsf.detection_finding"
$ocsf.category_uid = 2
$ocsf.class_uid = 2004
$ocsf.activity_id = 1
// Kunai scans a file because a rule asked for it, and a match requires a
// closer look.
$ocsf.status_id = 1
$ocsf.is_alert = true

kunai::ocsf::process $kunai, $ocsf.actor.process
$ocsf.finding_info = {
  uid: $ocsf.metadata.uid,
  title: "File matches YARA signatures",
  desc: f"Kunai scanned {$kunai.data.path} and matched the YARA signatures {$kunai.data.signatures.join(", ")}.",
  analytic: {
    name: "Kunai file scan",
    type_id: 1,
  },
  related_analytics: (move $kunai.data.signatures).map(name => {name: name, type_id: 1}),
  // The scan runs because of another Kunai event, which this field references.
  related_events: [{uid: move $kunai.data.source_event}],
}
// The scanned file serves as the evidence of the match. What the file mapping
// does not consume, such as a hashing error, stays in the source event.
$kunai.data.meta.path = move $kunai.data.path
kunai::ocsf::file $kunai.data.meta, $ocsf._file
$ocsf.evidences = [{file: move $ocsf._file}]
drop $kunai.data.positives
