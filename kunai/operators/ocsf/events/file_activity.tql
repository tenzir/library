---
description: Kunai `read`, `read_config`, `write`, `write_config`, `write_close`, `file_create`, and `file_unlink` → OCSF File System Activity (1001).
args:
  positional:
    - name: kunai
      type: field
      description: The Kunai event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

@name = "ocsf.file_activity"
$ocsf.category_uid = 1
$ocsf.class_uid = 1001

// The `_config` variants fire for files below `/etc`, and `write_close` fires
// when a written file closes. `metadata.event_code` tells them apart.
match $ocsf.metadata.event_code {
  "file_create" => {
    $ocsf.activity_id = 1
  }
  "read" | "read_config" => {
    $ocsf.activity_id = 2
  }
  "write" | "write_config" | "write_close" => {
    $ocsf.activity_id = 3
  }
  "file_unlink" => {
    $ocsf.activity_id = 4
    // Only an unlink reports whether it succeeded.
    $ocsf.status_id = 1 if (move $kunai.data.success) else 2
  }
  _ => {
    $ocsf.activity_id = 99
  }
}

kunai::ocsf::process $kunai, $ocsf.actor.process
$ocsf.file = {
  name: file_name($kunai.data.path),
  path: move $kunai.data.path,
  type_id: 1,
}
