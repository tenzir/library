---
description: Kunai `bpf_socket_filter` → OCSF Kernel Extension Activity (1002, Load).
args:
  positional:
    - name: kunai
      type: field
      description: The Kunai event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

@name = "ocsf.kernel_extension_activity"
$ocsf.category_uid = 1
$ocsf.class_uid = 1002
// A socket filter is a BPF program that the kernel runs for the socket.
$ocsf.activity_id = 1

kunai::ocsf::process $kunai, $ocsf.actor.process
$ocsf.driver.file = {
  name: "socket_filter",
  type_id: 99,
  type: "BPF Socket Filter",
  size: $kunai.data.filter?.size,
}
kunai::ocsf::hashes $kunai.data.filter, $ocsf.driver.file.hashes
drop $kunai.data.filter.size?
if $kunai.data.attached? != null {
  $ocsf.status_id = 1 if $kunai.data.attached else 2
  drop $kunai.data.attached
}
// The socket and the instruction count have no OCSF attribute and remain under
// `unmapped`.
