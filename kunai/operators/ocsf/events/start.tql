---
description: Kunai `start` → OCSF Application Lifecycle (6002, Start).
args:
  positional:
    - name: kunai
      type: field
      description: The Kunai event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

@name = "ocsf.application_lifecycle"
$ocsf.category_uid = 6
$ocsf.class_uid = 6002
$ocsf.activity_id = 3

$ocsf.metadata.product.version = $kunai.data.kunai.version
$ocsf.application = {
  name: "Kunai",
  version: move $kunai.data.kunai.version,
}
// The event describes the Kunai process itself.
kunai::ocsf::process $kunai, $ocsf.actor.process
kunai::ocsf::file $kunai.data.kunai.exe, $ocsf.actor.process.file, type_id=8

$ocsf.device.boot_time = move $kunai.data.system.boot_time
// Kunai runs on Linux only.
$ocsf.device.os = {
  name: move $kunai.data.system.sysname,
  type_id: 200,
  kernel_release: move $kunai.data.system.release,
  build: move $kunai.data.system.version,
}
// The uptime, the machine type, the domain name, and the configuration hash
// have no OCSF attribute and remain under `unmapped`.
