---
description: Kunai `io_uring_sqe` → OCSF Kernel Activity (1003, Invoke).
args:
  positional:
    - name: kunai
      type: field
      description: The Kunai event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

@name = "ocsf.kernel_activity"
$ocsf.category_uid = 1
$ocsf.class_uid = 1003
$ocsf.activity_id = 4

kunai::ocsf::process $kunai, $ocsf.actor.process
// An io_uring operation performs the work of a system call without one. The
// numeric operation code remains under `unmapped`.
$ocsf.kernel = {
  type_id: 2,
  name: $kunai.data.op.name,
}
drop $kunai.data.op.name
