---
description: Kunai event → OCSF Base Event.
args:
  positional:
    - name: kunai
      type: field
      description: The Kunai event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

// Nothing in the event tells which OCSF class fits, so all that is left to say is
// that an event happened. Kunai records without a name, such as `null`, end up
// here, and so do events that a later Kunai version defines.
@name = "ocsf.base_event"
$ocsf.category_uid = 0
$ocsf.class_uid = 0
$ocsf.activity_id = 0
