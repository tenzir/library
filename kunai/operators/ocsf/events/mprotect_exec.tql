---
description: Kunai `mprotect_exec` → OCSF Memory Activity (1004, Modify Page).
args:
  positional:
    - name: kunai
      type: field
      description: The Kunai event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

@name = "ocsf.memory_activity"
$ocsf.category_uid = 1
$ocsf.class_uid = 1004
$ocsf.activity_id = 2

// A process changes the protection of its own memory, so the actor and the
// target coincide. The ancestry and the parent describe the target only.
kunai::ocsf::process $kunai, $ocsf.process
$ocsf.actor.process = $ocsf.process
drop $ocsf.actor.process.ancestry?, $ocsf.actor.process.parent_process?
$ocsf.base_address = move $kunai.data.addr?
// The protection flags, such as `0x5` for read and execute.
$ocsf.requested_permissions = int(move $kunai.data.prot, base=16)
