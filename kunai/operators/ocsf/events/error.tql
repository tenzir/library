---
description: Kunai `error` → OCSF Application Error (6008, General Error).
args:
  positional:
    - name: kunai
      type: field
      description: The Kunai event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

@name = "ocsf.application_error"
$ocsf.category_uid = 6
$ocsf.class_uid = 6008
$ocsf.activity_id = 1

// Kunai throttles the file system events of a task when it produces too many,
// and the error describes the task that it throttled.
kunai::ocsf::process $kunai, $ocsf.actor.process
$ocsf.message = move $kunai.data.message
$ocsf.status_code = (move $kunai.data.code).string()
