---
description: Kunai `ptrace` → OCSF Process Activity (1007, Open).
args:
  positional:
    - name: kunai
      type: field
      description: The Kunai event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

@name = "ocsf.process_activity"
$ocsf.category_uid = 1
$ocsf.class_uid = 1007
// Kunai reports the access check that precedes a tracer attaching to a task.
$ocsf.activity_id = 3

kunai::ocsf::process $kunai, $ocsf.actor.process
kunai::ocsf::target $kunai.data.target, $ocsf.process
// The ptrace access mode has no OCSF attribute and remains under `unmapped`.
