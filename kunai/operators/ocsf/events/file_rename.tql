---
description: Kunai `file_rename` → OCSF File System Activity (1001, Rename).
args:
  positional:
    - name: kunai
      type: field
      description: The Kunai event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

@name = "ocsf.file_activity"
$ocsf.category_uid = 1
$ocsf.class_uid = 1001
$ocsf.activity_id = 5

kunai::ocsf::process $kunai, $ocsf.actor.process
$ocsf.file = {
  path: $kunai.data.old,
  name: file_name($kunai.data.old),
  type_id: 1,
}
$ocsf.file_result = {
  path: $kunai.data.new,
  name: file_name($kunai.data.new),
  type_id: 1,
}
drop $kunai.data.old, $kunai.data.new
