---
description: Kunai `connect` → OCSF Network Activity (4001, Open or Fail).
args:
  positional:
    - name: kunai
      type: field
      description: The Kunai event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

@name = "ocsf.network_activity"
$ocsf.category_uid = 4
$ocsf.class_uid = 4001
// The monitored host initiates every connection that Kunai reports.
$ocsf.initiator_id = 1
if $kunai.data.connected? == true {
  $ocsf.activity_id = 1
  $ocsf.status_id = 1
} else {
  $ocsf.activity_id = 4
  $ocsf.status_id = 2
}
drop $kunai.data.connected?

kunai::ocsf::process $kunai, $ocsf.actor.process
kunai::ocsf::connection $kunai, $ocsf.connection_info, remote=$kunai.data.dst, initiated=true
kunai::ocsf::endpoint $kunai.data.src, $ocsf.src_endpoint
kunai::ocsf::endpoint $kunai.data.dst, $ocsf.dst_endpoint
