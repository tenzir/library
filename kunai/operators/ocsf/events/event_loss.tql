---
description: Kunai `event_loss` → OCSF Application Error (6008, General Error).
args:
  positional:
    - name: kunai
      type: field
      description: The Kunai event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

@name = "ocsf.application_error"
$ocsf.category_uid = 6
$ocsf.class_uid = 6008
$ocsf.activity_id = 1

// The event describes the Kunai process, which could not keep up with the
// kernel. The counters and the rate have no OCSF attribute and remain under
// `unmapped`.
kunai::ocsf::process $kunai, $ocsf.actor.process
$ocsf.message = f"Kunai lost {$kunai.data.lost} events while reading {$kunai.data.read} events."
