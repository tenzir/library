---
description: Kunai `mmap_exec` → OCSF Module Activity (1005, Load).
args:
  positional:
    - name: kunai
      type: field
      description: The Kunai event to consume.
    - name: ocsf
      type: field
      description: The OCSF event to build.
---

@name = "ocsf.module_activity"
$ocsf.category_uid = 1
$ocsf.class_uid = 1005
$ocsf.activity_id = 1

kunai::ocsf::process $kunai, $ocsf.actor.process
kunai::ocsf::file $kunai.data.mapped, $ocsf.module.file, type_id=8
// The process maps the file into its memory.
$ocsf.module.load_type_id = 4
