---
description: |
  Builds an OCSF Network Endpoint from a Kunai address.

  Kunai resolves the hostname of a destination from the DNS responses it saw
  earlier and writes `?` when it has none. It also flags destinations that are
  public. OCSF has no such flag, so the operator maps it to the network scope: a
  public destination is external, anything else is internal to the monitored
  network.
args:
  positional:
    - name: kunai_endpoint
      type: field
      description: The Kunai address to consume.
    - name: endpoint
      type: field
      description: The field that receives the OCSF endpoint.
---

$endpoint = {
  ip: $kunai_endpoint.ip?,
  port: $kunai_endpoint.port?,
  hostname: $kunai_endpoint.hostname? if $kunai_endpoint.hostname? != "?" else null,
  network_scope_id: 2 if $kunai_endpoint.public? == true else 1 if $kunai_endpoint.public? == false else null,
}
// The IP version follows from the address and the socket.
drop $kunai_endpoint.ip?, $kunai_endpoint.port?, $kunai_endpoint.hostname?, $kunai_endpoint.public?, $kunai_endpoint.is_v6?
