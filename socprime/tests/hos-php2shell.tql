// Two of three stages create the chain, the third updates it. A kernel log
// message matches the keyword rule of the first stage.
from_file f"{env("TENZIR_INPUTS")}/php2shell.tql" {
  read_tql
}
socprime::hos::php2shell
select time, activity_id, severity_id, confidence_score, device.hostname,
  finding_info.attacks, finding_info.traits,
  stage_rules=finding_info.related_events.map(event => event.title)
