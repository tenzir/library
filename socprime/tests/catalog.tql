// HoS rules carry their complete threat. Behavior rules that belong to several
// threats only reference them.
socprime::active_threats
socprime::ocsf::map
socprime::catalog
select uid, threats=threats.map(threat => {value: threat.value, full: threat.desc? != null})
where threats.length() > 2 or uid == socprime::$hos.kimsuky_diplomats.uid
sort uid
