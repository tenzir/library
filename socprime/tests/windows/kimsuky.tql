// Sysmon process creation events, normalized to OCSF 1.9 by the Microsoft
// package, drive the Kimsuky chain end to end.
from_file f"{env("TENZIR_INPUTS")}/sysmon/*.xml" {
  read_all
}
microsoft::windows::ocsf::normalize data
sort time
socprime::hos::kimsuky_diplomats
select time, activity_id, confidence_score, device.hostname,
  stage_rules=finding_info.related_events.map(event => event.title)
