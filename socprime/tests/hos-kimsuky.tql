// WS-17 covers two of three stages at 10:05, which creates the chain, and the
// third stage at 10:12, which updates it. The repeated third stage at 10:14
// produces no finding, and neither does WS-9, whose two stages are 44 minutes
// apart.
from_file f"{env("TENZIR_INPUTS")}/kimsuky.tql" {
  read_tql
}
socprime::hos::detect "kimsuky_diplomats"
select time, activity_id, type_uid, severity_id, confidence_score,
  device.hostname, finding_info.uid, finding_info.traits,
  stage_rules=finding_info.related_events.map(event => event.title),
  sources=evidences.map(evidence => evidence.data.metadata.uid)
