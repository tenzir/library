// OCSF 1.9 Process Activity (Launch) events for a Kimsuky intrusion on WS-17
// and unrelated activity on WS-9.
{
  time: 2026-07-01T10:00:00Z,
  metadata: {version: "1.9.0", uid: "ws-17-1"},
  class_uid: 1007, category_uid: 1, activity_id: 1, type_uid: 100701,
  device: {hostname: "WS-17", os: {type_id: 100, name: "Windows"}},
  // Stage seq1: The user opens a shortcut that pretends to be a PDF.
  process: {
    file: {path: "C:\\Windows\\explorer.exe", name: "explorer.exe"},
    cmd_line: "C:\\Windows\\explorer.exe C:\\Users\\kim\\Downloads\\invitation.pdf.lnk",
    parent_process: {file: {path: "C:\\Windows\\System32\\userinit.exe", name: "userinit.exe"}},
  },
}
{
  time: 2026-07-01T10:01:00Z,
  metadata: {version: "1.9.0", uid: "ws-9-1"},
  class_uid: 1007, category_uid: 1, activity_id: 1, type_uid: 100701,
  device: {hostname: "WS-9", os: {type_id: 100, name: "Windows"}},
  // Stage seq1 on another host, which never progresses.
  process: {
    file: {path: "C:\\Windows\\explorer.exe", name: "explorer.exe"},
    cmd_line: "C:\\Windows\\explorer.exe C:\\Users\\lee\\Desktop\\report.docx.lnk",
    parent_process: {file: {path: "C:\\Windows\\System32\\userinit.exe", name: "userinit.exe"}},
  },
}
{
  time: 2026-07-01T10:05:00Z,
  metadata: {version: "1.9.0", uid: "ws-17-2"},
  class_uid: 1007, category_uid: 1, activity_id: 1, type_uid: 100701,
  device: {hostname: "WS-17", os: {type_id: 100, name: "Windows"}},
  // Stage seq2: The shortcut drops a VBScript into the public profile and runs
  // it with wscript.exe.
  process: {
    file: {path: "C:\\Windows\\System32\\wscript.exe", name: "wscript.exe"},
    cmd_line: "wscript.exe C:\\Users\\Public\\update.vbs",
    parent_process: {file: {path: "C:\\Windows\\System32\\cmd.exe", name: "cmd.exe"}},
  },
}
{
  time: 2026-07-01T10:12:00Z,
  metadata: {version: "1.9.0", uid: "ws-17-3"},
  class_uid: 1007, category_uid: 1, activity_id: 1, type_uid: 100701,
  device: {hostname: "WS-17", os: {type_id: 100, name: "Windows"}},
  // Stage seq3: The implant enumerates the logged-on user.
  process: {
    file: {path: "C:\\Windows\\System32\\whoami.exe", name: "whoami.exe"},
    cmd_line: "whoami.exe /all",
    parent_process: {file: {path: "C:\\Windows\\System32\\cmd.exe", name: "cmd.exe"}},
  },
}
{
  time: 2026-07-01T10:14:00Z,
  metadata: {version: "1.9.0", uid: "ws-17-4"},
  class_uid: 1007, category_uid: 1, activity_id: 1, type_uid: 100701,
  device: {hostname: "WS-17", os: {type_id: 100, name: "Windows"}},
  // Stage seq3 again: A repeated stage does not advance the chain.
  process: {
    file: {path: "C:\\Windows\\System32\\net.exe", name: "net.exe"},
    cmd_line: "net.exe localgroup administrators",
    parent_process: {file: {path: "C:\\Windows\\System32\\cmd.exe", name: "cmd.exe"}},
  },
}
{
  time: 2026-07-01T10:45:00Z,
  metadata: {version: "1.9.0", uid: "ws-9-2"},
  class_uid: 1007, category_uid: 1, activity_id: 1, type_uid: 100701,
  device: {hostname: "WS-9", os: {type_id: 100, name: "Windows"}},
  // Stage seq2 on WS-9, but outside the 30-minute timeframe of its seq1.
  process: {
    file: {path: "C:\\Windows\\System32\\wscript.exe", name: "wscript.exe"},
    cmd_line: "wscript.exe C:\\Users\\Public\\update.vbs",
    parent_process: {file: {path: "C:\\Windows\\System32\\cmd.exe", name: "cmd.exe"}},
  },
}
