// The PHP worker on web-01 crashes, spawns a shell, and the shell's curl child
// calls out. On web-02, a PHP worker spawns a shell, but the callout comes
// from an unrelated process, so the chain is incomplete.
from_file f"{env("TENZIR_INPUTS")}/php2shell-lineage.tql" {
  read_tql
}
socprime::native::php2shell
select time, activity_id, severity_id, device.hostname, finding_info.uid,
  stage_rules=finding_info.related_events.map(event => event.title),
  sources=evidences.map(evidence => evidence.data.metadata.uid)
