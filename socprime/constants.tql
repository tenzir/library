            - '.url' #%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\InnoCraft.url ;https://www.trendmicro.com/en_us/research/25/a/lumma-stealers-github-based-delivery-via-mdr.html; https://hunt.io/blog/exposed-byob-c2-infrastructure-multi-stage-malware-deployment
            - '.cmd' # https://phorion.io/blog/offical-claude-code-vsx-compromise/
            - '.hta'
            - '.ps1'
            - '.exe' #%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\customchecker.com.exe; https://cert.gov.ua/article/6282517; CVE-2025-8088 / CVE-2025-6218; https://www.bleepingcomputer.com/news/security/winrar-zero-day-flaw-exploited-by-romcom-hackers-in-phishing-attacks/; https://www.sentinelone.com/blog/cybervolk-returns-flawed-volklocker-brings-new-features-with-growing-pains/; https://www.splunk.com/en_us/blog/security/blankgrabber-trojan-stealer-analysis-detection.html; https://www.zscaler.com/blogs/security-research/2cloader-new-malware-loader-delivering-vidar-and-remus
            - '.lnk' # Startup LNK from Повідомлення 4726-49.rar https://virusbulletin.com/uploads/pdf/conference/vb2026/papers/Gorbag-Orcs-at-the-border.pdf; https://www.welivesecurity.com/en/eset-research/update-winrar-tools-now-romcom-and-others-exploiting-zero-day-vulnerability/; https://www.picussecurity.com/resource/blog/apt15-cyber-espionage-campaigns-and-ttps-analysis; https://cloud.google.com/blog/topics/threat-intelligence/exploiting-critical-winrar-vulnerability?e=48754805; https://www.bitdefender.com/en-us/blog/businessinsights/apt36-nightmare-vibeware; https://www.genians.co.kr/en/blog/threat_intelligence/kakaotalk; https://www.picussecurity.com/resource/blog/t1547-001-registry-run-keys-startup-folder; https://www.malwarebytes.com/blog/scams/2026/04/this-fake-windows-support-website-delivers-password-stealing-malware; https://cloud.google.com/blog/topics/threat-intelligence/unc6692-social-engineering-custom-malware/; https://dmpdump.github.io/posts/TelegramRat/; https://arcticwolf.com/resources/blog/bluenoroff-uses-clickfix-fileless-powershell-and-ai-generated-zoom-meetings-to-target-web3-sector/; https://www.netskope.com/blog/openclaw-hologram-fake-installer-ships-rust-infostealer; https://www.microsoft.com/en-us/security/blog/2026/05/26/poisoned-search-results-gpu-mining-cryptojacking-campaign-abusing-screenconnect-microsoft-net-utilities/; https://www.ibm.com/think/x-force/interlock-and-rhysida-within-the-ransonware-ecosystem; https://www.seqrite.com/blog/operation-shadowrecruit-a-recruitment-themed-malware-campaign-leveraging-controlr-and-google-sheets-to-target-indian-job-seekers/; https://slowmist.medium.com/threat-intelligence-job-scam-alert-interview-software-used-to-deliver-an-info-stealing-malware-37f018877e4c;  https://www.seqrite.com/blog/operation-quicsilver-china-nexus-actor-targets-myanmar-diplomats-via-vhd-delivered-go-backdoor/; https://cloud.google.com/blog/topics/threat-intelligence/financially-motivated-threat-actor-breeze-comet-targets-brazil/; https://blog-en.itochuci.co.jp/entry/2026/09/25/090000; https://www.trellix.com/blogs/research/sirius-backdoor-fileless-campaign-fedex-invoices/; https://www.welivesecurity.com/en/eset-research/eset-apt-activity-report-q2-2026-q3-2026/
            - '.tmp'
            - '.py'
            - '.pyw'
    selection_location:
        TargetFilename|contains|all:
            - 'Microsoft'
            - 'Windows'
            - 'Start'
            - 'Menu'
            - 'Programs'
            - 'Startup' #\Microsoft\Windows\Start Menu\Programs\Startup\ #CVE-2025-8088 / CVE-2025-6218; https://www.bleepingcomputer.com/news/security/winrar-zero-day-flaw-exploited-by-romcom-hackers-in-phishing-attacks/; https://cert.gov.ua/article/6285549; https://expel.com/blog/gootloaders-malformed-zip/
    selection_archivers: # archivers live in Program Files but write to Startup only via path traversal (CVE-2025-8088 / CVE-2025-6218)
        Image|endswith:
            - '\WinRAR.exe' # Повідомлення 4726-49.rar CVE-2025-8088 https://www.welivesecurity.com/en/eset-research/gorbag-orcs-border-harvesting-intelligence-ukraine/
            - '\7z.exe'
            - '\7zFM.exe'
            - '\7zG.exe'
    filters:
        Image|contains:
            - '\Program Files'
            - 'cloud-drive-ui.exe'
    filters_block1:
        Image|endswith: 'onenote.exe'
        TargetFilename|endswith: 'OneNote.lnk'
    filters_block2:
        Image|endswith: 'svchost.exe'
        TargetFilename|endswith: 'BGInfo.bat'
    condition: (selection_ext and selection_location) and not ((filters and not selection_archivers) or filters_block1 or filters_block2)
falsepositives:
    - Software installers.
level: medium
"#,
  // Suspicious Mshta Execution in an Embedded Mode (via cmdline)
  "2907aeac-1558-4538-85a6-6ea9af1548a8": r#"title: Suspicious Mshta Execution in an Embedded Mode (via cmdline)
id: 2907aeac-1558-4538-85a6-6ea9af1548a8
description: This rule detects the execution of mshta in embedded mode, likely as part of an automation, indirect execution script process, or post-exploitation chain.
status: stable
references:
  - https://www.trendmicro.com/en_us/research/24/g/CVE-2024-38112-void-banshee.html
  - https://tria.ge/240710-1e56ma1ekl/behavioral1
author: SOC Prime Team
tags:
  - attack.defense_evasion
  - attack.t1218.005
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    Image|endswith: 'mshta.exe'
    CommandLine|contains: 'Embedding'
  condition: selection
falsepositives:
  - Unlikely
level: medium
"#,
  // Java Binary Executed From Unusual Location (via process_creation)
  "299bad2b-1646-42b3-bf01-5d2f7a111041": r#"title: Java Binary Executed From Unusual Location (via process_creation)
id: 299bad2b-1646-42b3-bf01-5d2f7a111041
status: stable
author: SOC Prime Team
description: Adversaries may try to name their malicious payloads as legitimate Java binary in order to evade detection. The reliance on the surrounding environment may necessitate the implementation of additional filtering measures to prevent false positives.
references:
  - https://www.microsoft.com/en-us/security/blog/2026/10/30/help-desk-impersonation-ad-cs-abuse-investigating-esc1-esc8-intrusion-paths/
  - https://thedfirreport.com/2023/12/04/sql-brute-force-leads-to-bluesky-ransomware/
tags:
  - attack.t1036
  - attack.defense_evasion
logsource:
  category: process_creation
  product: windows
detection:
  selection:
    Image|endswith: 'java.exe' # portable java.exe from \AppData\Roaming\KB<digits>\ launching .java source https://www.microsoft.com/en-us/security/blog/2026/10/30/help-desk-impersonation-ad-cs-abuse-investigating-esc1-esc8-intrusion-paths/
  filters:
    - Image|contains:
      - '\jre\bin\'
      - '\jdk\bin\'
    - Image|contains|all:
      - 'Program'
      - 'Files'
    - Image|contains|all:
      - 'AppData'
      - 'Local'
      - 'Jetbrains'
  condition: selection and not filters
falsepositives:
  - Legitimate Java binary execution from uncommon directory.
  - The reliance on the surrounding environment may necessitate the implementation of additional filtering measures to prevent false positives.
level: low
"#,
  // Possible Data Infiltration / Exfiltration / C2 via Third Party Services / Tools (via dns_query)
  "2e025289-ae4b-4eab-a00a-58bc4a5623d7": r#"title: Possible Data Infiltration / Exfiltration / C2 via Third Party Services / Tools (via dns_query)
id: 2e025289-ae4b-4eab-a00a-58bc4a5623d7
status: stable
description: Need to exclude approved services! Attackers may utilize third-party services and tools in an effort to aid data infiltration / exfiltration and command and control efforts. The reliance on the surrounding environment may necessitate the implementation of additional filtering measures to prevent false positives.
author: SOC Prime Team
references:
  - https://asec.ahnlab.com/en/95599/
  - https://d01a.github.io/xloader/
  - https://cert.gov.ua/article/6318634
  - https://www.welivesecurity.com/en/eset-research/gamaredon-2025-leveraging-tunnels-workers-dead-drops-new-alliances/
  - https://blog.exatrack.com/Tracking_APT28_PixyNetLoader/
  - https://blog.sekoia.io/fsbs-matryoshka-1-3-gamaredons-gifts-that-keeps-unpacking-gammaphish-and-gammaworm/
  - https://thehackernews.com/2026/03/north-korean-hackers-publish-26-npm.html
  - https://kmsec.uk/blog/dprk-text-steganography/
  - https://www.microsoft.com/en-us/security/blog/2026/02/24/c2-developer-targeting-campaign/
tags:
  - attack.exfiltration
  - attack.t1537
  - attack.t1567.002
  - attack.command_and_control
  - attack.t1105
  - attack.t1071.001
logsource:
    category: dns_query
    product: windows
detection:
    selection_procs:
        Image|endswith:
            - 'cmd.exe'
            - 'powershell.exe'
            - 'python.exe'
            - 'wscript.exe'
            - 'cscript.exe'
            - 'mshta.exe'
            - 'ruby.exe'
    selection_domains:
        QueryName|contains:
            - 'cdn.imageurlgenerator.com' #https://cert.gov.ua/article/6318634
            - 'easysend.co' #https://cert.gov.ua/article/6318634
            - 'filemail.com' #https://cert.gov.ua/article/6318634
            - 'cleverapps.io'
            - 'pastee.dev'
            - 'nopaste.net'
            - 'lesma.eu'
            - 'write.as'
            - 'supabase.co'
            - 'loca.lt'
            - 'loophole.site'
            - 'loophole.cloud'
            - 'workers.dev'
            - 'glot.io' #https://blog.virustotal.com/2026/02/from-automation-to-infection-how.html
            - 'filen.io' #https://cert.gov.ua/article/6287250; CERT-UA#19542
            - 'filen.dev' #https://cert.gov.ua/article/6287250; CERT-UA#19542
            - 'filen.net' #https://cert.gov.ua/article/6287250; CERT-UA#19542
            - 'secfileshare.com' #https://cert.gov.ua/article/6284949
            - 'qaz.im' #CERT-UA#11776
            - 'qaz.is' #CERT-UA#11776
            - 'qaz.su' #CERT-UA#11776
            - 'filedn.eu'
            - 'onehub.com' #https://www.welivesecurity.com/en/eset-research/muddywater-snakes-riverbank/
            - 'terabox.com'
            - 'egnyte.com' #ttps://www.welivesecurity.com/en/eset-research/muddywater-snakes-riverbank/
            - 'sync.com'
            - 'filebin.net'
            - 'keep.sh'
            - 'gitea.com'
            - 'oshi.at' #OshiUpload
            - 'ipapi.co' #CERT-UA#7469, but noizy.
            - 'files.catbox.moe' #CERT-UA#6995, CERT-UA#7183
            - 'bayfiles.com'
            - 'usrfiles.com'
            - 'dropbox.com'
            - 'dropboxapi.com' # content.dropboxapi.com/2/files/upload
            - 'mediafire.com' #https://cloud.google.com/blog/topics/threat-intelligence/unc5142-etherhiding-distribute-malware/
            - 'onedrive.com' #api.onedrive.com; https://www.picussecurity.com/resource/blog/apt41-cyber-attacks-history-operations-and-full-ttp-analysis
            #- 'wire.com'
            - 'massive.io'
            - 'efilecabinet.com'
            - 'c-v.sh'
            - 'file.io' #CERT-UA#7469, used unc961 / also covered - ufile.io #https://www.cisa.gov/news-events/cybersecurity-advisories/aa25-022a
            - '0x0.st'
            - 'instant.io'
            - 'copy.com'
            - 'mega.co.nz'
            - 'mega.nz'
            - 'mega.io' #https://www.welivesecurity.com/en/eset-research/muddywater-snakes-riverbank/; https://www.picussecurity.com/resource/blog/hunters-international-ransomware
            - 'mega.io' #https://www.welivesecurity.com/en/eset-research/muddywater-snakes-riverbank/; https://sosransomware.com/en/ransomware-groups/worldleaks-between-pure-extortion-and-traditional-ransomware-whats-the-difference/
            - 'icloud.com'
            - 'pcloud.com'
            - 'icedrive.net' #https://cert.gov.ua/article/6284080
            - 'app.koofr.net' #https://cert.gov.ua/article/6284080; https://www.picussecurity.com/resource/blog/apt28-cyber-threat-profile-and-detailed-ttps
            - 'WeTransfer.com'
            - 'Onehub.com'
            - 'getfilecloud.com'
            - 'ki.tc'
            - 'uguu.se'
            - 'flyle.app'
            - 'transfer.sh'
            - 'expirebox.com'
            - 'disk.yandex.com'
            - 'filestage.io'
            - 'zippyshare.com'
            - 'drive.google.com' #https://any.run/cybersecurity-blog/major-cyber-attacks-november-2025/
            - 'docs.google.com' #https://www.picussecurity.com/resource/blog/fog-ransomware-2025-deep-dive-into-ttps; https://www.recordedfuture.com/research/purplebravos-targeting-it-software-supply-chain; https://www.zscaler.com/blogs/security-research/apt-attacks-target-indian-government-using-sheetcreep-firepower-and
            - 'firebase.google.com' #https://www.zscaler.com/blogs/security-research/apt-attacks-target-indian-government-using-sheetcreep-firepower-and
            - '.box.com'
            - 'hubic.com'
            - 'wikisend.com'
            - 'dropsend.com'
            - 'anonymousfiles.io'
            - 'anonfiles.com'
            - 'filedropper.com'
            - 'privatlab.com'
            - 'dropmefiles.com' #unc961
            - 'onionshare.org'
            - 'sendGB.com'
            - 'volafile.org'
            - 'openload.co'
            - 'uploadfiles.io'
            - 'gofile.io'
            - 'put.io'
            - '4shared.com'
            - 'dropboxusercontent.com' #https://www.trendmicro.com/en_us/research/26/a/analyzing-a-a-multi-stage-asyncrat-campaign-via-mdr.html
            - 'supabase.co' # https://blog.sekoia.io/fsbs-matryoshka-1-3-gamaredons-gifts-that-keeps-unpacking-gammaphish-and-gammaworm/
            - 'glitch.me'
            - 'run.app'
            - 'bitbucket.org'
            - 'temspend.com'
            - 'netlify.com' #https://www.picussecurity.com/resource/blog/fog-ransomware-2025-deep-dive-into-ttps
            - 'netlify.app'
            - 'vercel.app' #https://kmsec.uk/blog/dprk-text-steganography/
    condition: selection_procs and selection_domains
falsepositives:
  - Storage providers approved for business use.
  - The reliance on the surrounding environment may necessitate the implementation of additional filtering measures to prevent false positives.
level: medium
"#,
  // Windows Shortcut Was Executed With Suspicious Name (via file_event)
  "2ee3c0b5-8504-4212-b2a8-09e1f95c0bf8": r#"title: Windows Shortcut Was Executed With Suspicious Name (via file_event)
id: 2ee3c0b5-8504-4212-b2a8-09e1f95c0bf8
description: Identfies Windows shortcut file (.lnk) being executed containing suspicious words in the name, which may be an indicator of malicious activity.
author: SOC Prime Team
references:
  - https://cert.gov.ua/article/6282517
status: stable
tags:
  - attack.t1059.003
  - attack.execution
logsource:
  category: file_event
  product: windows
detection:
  selection_lnk:
    Image|contains: '.' #must exists.
    TargetFilename|endswith: '.lnk'
  selection_names:
    TargetFilename|contains:
      - 'Invoice'
      - 'Payment'
      - 'Important'
      - 'Urgent'
      - 'Critical'
      #- 'Document' #noizy.
      - 'Price'
      - 'Book'
      - 'Resume' #https://cert.gov.ua/article/6282517
      - 'CV_'
      - 'CV '
      - 'Please'
      - ' CV'
      - '_CV'
      - 'Password'
      - 'Detected'
  filters:
    - Image|contains:
      - '\Program Files'
    - TargetFilename|contains|all:
      - 'AppData'
      - 'Roaming'
      - 'Microsoft'
  condition: (selection_lnk and selection_names) and not filters
falsepositives:
  - Unknown
level: medium
