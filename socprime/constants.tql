tags:
    - attack.execution
    - attack.t1059.001
author: SOC Prime Team
logsource:
    product: windows
    service: powershell
detection:
    selection:
        ScriptBlockText|contains:
            - 'GlobalSession.ClearLog' #{[System.Diagnostics.Eventing.Reader.EventLogSession]::GlobalSession.ClearLog($l)}
            - 'NTLMType2Response' #https://www.attackiq.com/2025/05/21/response-to-cisa-advisory-aa25-141a
            - 'RemoteEndPoint.Address.IPAddressToString' #https://www.attackiq.com/2025/05/21/response-to-cisa-advisory-aa25-141a
            - '.HttpListener' #https://www.attackiq.com/2025/05/21/response-to-cisa-advisory-aa25-141a
            - 'AllowReversiblePasswordEncryption'
            - 'LocalSessionManager' #Hunting for Leaked Credentials in TerminalServices-LocalSessionManager/Operational logs
            - 'GetHostAddresses'
            - 'AddToHistoryHandler' # Set-PSReadLineOption -AddToHistoryHandler { return $false } - Disable historylogging
            - 'ConstrainedLanguage' #Constrained Language Mode
            - 'TrustAllCertsPolicy'
            - 'SecureStringToGlobalAllocUnicode'
            - 'IO.Compression.CompressionMode' #https://thedfirreport.com/2026/02/23/apache-activemq-exploit-leads-to-lockbit-ransomware/
            - 'System.IO.Compression.FileSystem' #{ Add-Type Assembly 'System.IO.Compression.FileSystem'; [10.Compression.ZipFile]::CreateFromDirectory(\$path1', 'Spath2');}; https://www.picussecurity.com/resource/blog/apt28-cyber-threat-profile-and-detailed-ttps; https://www.recordedfuture.com/research/graycharlie-hijacks-law-firm-sites-suspected-supply-chain-attack
            - 'NoCompression' # [System.IO.Compression.CompressionLevel]::NoCompression, $false); #https://app.any.run/tasks/28a029a0-295a-4eca-ae91-8e645cdb3f5d/
            #- 'UTF8.GetBytes'
            #- 'ASCII.GetBytes'
            - 'GetBytes' #https://www.acronis.com/en/tru/posts/fake-adult-websites-pop-realistic-windows-update-screen-to-deliver-stealers-via-clickfix/; https://www.fortinet.com/blog/threat-research/dprk-related-campaigns-with-lnk-and-github-c2; https://www.trendmicro.com/en_us/research/26/e/installfix-and-claude-code.html; https://www.trendmicro.com/en_us/research/26/e/banana-rat.html; https://www.microsoft.com/en-us/security/blog/2026/06/17/postinstall-payload-inside-mastra-npm-supply-chain-compromise/; https://blog.talosintelligence.com/uat-10147-chinese-speaking-adversary-integrates-agentic-ai-into-post-compromise-operations/; https://www.genians.co.kr/en/blog/threat_intelligence/ai-agent-opencode; https://socradar.io/blog/operation-conflict-compass-konni-ukraine-lnk-lure/
            - 'AsByteStream'
            #- 'Add-Type'
            - 'DllImport' # [DllImport("user32.dll")] ShowWindow (Silent DLL Deployer for Edge) https://www.darktrace.com/blog/cikabika-bot-inside-a-discord-rat
            - 'DefineDynamicAssembly'
            - 'DefineDynamicModule'
            - 'DefineType'
            - 'DefineConstructor'
            - 'CreateType'
            - 'DefineLiteral'
            - 'DefineEnum'
            - 'DefineField'
            - 'ILGenerator'
            #- 'Emit'
            - 'UnverifiableCodeAttribute'
            - 'DefinePInvokeMethod'
            - 'GetTypes'
            - 'GetAssemblies'
            #- 'Methods'
            - 'GetConstructor'
            - 'GetConstructors'
            - 'GetDefaultMembers'
            - 'GetEvent'
            #- 'GetEvents'
            - 'GetField'
            #- 'GetFields'
            - 'GetInterface'
            - 'GetInterfaceMap'
            - 'GetInterfaces'
            - 'GetMember'
            #- 'GetMembers'
            - 'GetMethod' # https://www.seqrite.com/blog/operation-dualscript-powershell-malware-retrorat-analysis/; https://www.huntress.com/blog/malspam-to-deskcvb-rat-delivery-chain-analysis
            #- 'GetMethods'
            - 'GetNestedType'
            #- 'GetNestedTypes'
            - 'GetProperties'
            - 'GetProperty'
            - 'InvokeMember'
            - 'MakeArrayType'
            - 'MakeByRefType'
            - 'MakeGenericType'
            - 'MakePointerType'
            - 'DeclaringMethod'
            - 'DeclaringType'
            - 'ReflectedType'
            - 'TypeHandle'
            - 'TypeInitializer'
            - 'UnderlyingSystemType'
            - 'InteropServices' # https://www.orangecyberdefense.com/global/blog/cert-news/smoking-out-an-affiliate-smokedham-qilin-a-few-google-ads-and-some-bossware
            - 'Marshal'
            - 'AllocHGlobal'
            - 'PtrToStructure'
            - 'StructureToPtr'
            - 'FreeHGlobal'
            - 'IntPtr'
            - 'MemoryStream' #https://cert.gov.ua/article/6281681; https://securityaffairs.com/wp-content/uploads/2025/05/Sarcoma-Ransomware.pdf
            - 'DeflateStream'
            - 'FromBase64String' #https://cert.gov.ua/article/6284949; https://www.sentinelone.com/labs/phantomcaptcha-multi-stage-websocket-rat-targets-ukraine-in-single-day-spearphishing-operation/; https://cert.gov.ua/article/6286219; https://www.acronis.com/en/tru/posts/fake-adult-websites-pop-realistic-windows-update-screen-to-deliver-stealers-via-clickfix/; https://any.run/cybersecurity-blog/major-cyber-attacks-november-2025/; https://asec.ahnlab.com/en/92160/; https://isc.sans.edu/diary/rss/32682; https://thedfirreport.com/2026/02/23/apache-activemq-exploit-leads-to-lockbit-ransomware/; https://isc.sans.edu/diary/rss/32754; https://www.picussecurity.com/resource/blog/t1059-001-powershell; https://www.trellix.com/blogs/research/malware-as-a-service-redefined-xworm-rat/; https://www.levelblue.com/blogs/spiderlabs-blog/tracing-a-multi-vector-malware-campaign-from-vbs-to-open-infrastructure; https://censys.com/blog/under-ctrl-dissecting-a-previously-undocumented-russian-net-access-framework/; https://www.pointwild.com/threat-intelligence/from-inbox-to-intrusion-multi-stage-remcos-rat-and-c2-delivered-payloads-in-network/; https://www.trendmicro.com/en_us/research/26/d/weaponizing-trust-claude-code-lures-and-github-release-payloads.html; https://www.pointwild.com/threat-intelligence/desckvb-rat-analysis-from-javascript-loader-to-fileless-net-rat/; https://www.esentire.com/blog/stx-rat-a-new-rat-in-2026-with-infostealer-capabilities; https://www.elastic.co/security-labs/phantom-in-the-vault; https://www.hornetsecurity.com/en/blog/remcos-rat-attack-chain/; https://www.pointwild.com/threat-intelligence/inside-vidar-2026-from-infection-to-memory-execution-via-jpeg-and-txt-payloads/; https://arcticwolf.com/resources/blog/bluenoroff-uses-clickfix-fileless-powershell-and-ai-generated-zoom-meetings-to-target-web3-sector/; https://www.vmray.com/threat-intelligence-insights-pivoting-off-the-blockchain/; https://www.splunk.com/en_us/blog/security/behind-the-code-layered-defense-evasion-vip-keylogger.html; https://www.bitdefender.com/en-us/blog/labs/microsofts-mshta-legacy-malware-windows; https://www.fortinet.com/blog/threat-research/phishing-campaign-deploys-javascript-driven-purelogs-variant-to-steal-sensitive-data; https://www.malwarebytes.com/blog/bugs/2026/05/700-education-and-tech-websites-hijacked-in-huge-clickfix-malware-campaign; https://blog.gdatasoftware.com/2026/05/38426-donutloader-remcos-rat; https://cofense.com/blog/from-fake-amazon-security-alert-to-harborwatch-agent-clickfix-delivery-of-a-custom-monitoring-rat; https://www.fortinet.com/blog/threat-research/threat-actors-weaponize-ai-hype-to-deliver-asyncrat; https://www.acronis.com/en/tru/posts/from-emerging-threat-to-top-tier-ransomware-as-a-service-the-evolution-of-inc-ransomware/; https://www.levelblue.com/blogs/spiderlabs-blog/lokibot-after-a-decade-an-analysis-of-a-recent-lokibot-campaign; https://asec.ahnlab.com/en/94432/; https://www.picussecurity.com/resource/blog/turla-secret-blizzard-apt-stockstay-and-kazuar-backdoors-explained; https://blog.talosintelligence.com/uat-11795-deploys-novel-starland-rat-and-bespoke-wldr-c2-implant-in-financially-motivated-campaign/; https://www.seqrite.com/blog/abusing-trusted-business-workflows-a-multi-stage-phantom-stealer-campaign/; https://www.jumpsec.com/guides/inside-a-dprk-bluenoroff-clickfix-kit/; https://arcticwolf.com/resources/blog/castleloader-new-campaigns-new-tooling-and-the-needlestealer-connection/; https://www.huntress.com/blog/bank-spam-rmm; https://asec.ahnlab.com/en/94847/; https://www.picussecurity.com/resource/blog/the-tradecraft-behind-2026s-least-prevented-ransomware-families; https://expel.com/blog/synkloader-when-you-throw-in-everything-but-the-kitchen-sink/; https://www.netskope.com/jp/blog/malware-on-the-blockchain-an-ongoing-campaigns-new-webrtc-twist; https://blog.talosintelligence.com/clearfake-webdav-infection-chain/; https://www.pointwild.com/threat-intelligence/asyncrat-delivered-via-autoit-full-chain-analysis/; https://www.elastic.co/security-labs/threat-command/malicious-browser-extension-kremlin-banking-malware; https://isc.sans.edu/diary/rss/33348; https://www.security.com/threat-intelligence/warlock-ransomware-critical-infrastructure; https://www.forescout.com/blog/from-clickfix-to-c2-comparative-analysis-of-two-malware-loaders/; https://www.reversinglabs.com/blog/how-rl-mapped-a-midnight-blizzard-linked-campaign-from-two-hashes; https://www.trellix.com/blogs/research/sirius-backdoor-fileless-campaign-fedex-invoices/
            - 'EncodedCommand' #https://www.huntress.com/blog/active-exploitation-solarwinds-web-help-desk-cve-2025-26399; https://blog.deception.pro/blog/clickfix-hok-velvet-tempest-termite; https://detect.fyi/playbook-hunting-chinese-apt-379a6b950492; https://www.microsoft.com/en-us/security/blog/2026/03/03/signed-malware-impersonating-workplace-apps-deploys-rmm-backdoors
            #- 'Bypass' #cross with cmdline-related rule.
            - 'ToBase64String' # https://asec.ahnlab.com/en/94552/; https://cert.gov.ua/article/6318863; https://www.genians.co.kr/en/blog/threat_intelligence/kimsuky_ai_llm; https://www.enki.co.kr/en/media-center/blog/inside-kimsuky-s-abuse-of-legitimate-remote-control-tools-across-northeast-asia; https://asec.ahnlab.com/en/95217/
            #- 'ExpandString'
            - 'GetPowerShell'
            - 'OpenProcess' #https://www.pointwild.com/threat-intelligence/when-malware-talks-back/
            - 'VirtualAlloc' #https://www.pointwild.com/threat-intelligence/when-malware-talks-back/; https://thedfirreport.com/2026/02/23/apache-activemq-exploit-leads-to-lockbit-ransomware/
            - 'VirtualFree'
            - 'WriteProcessMemory' #https://www.pointwild.com/threat-intelligence/when-malware-talks-back/
            - 'CreateUserThread'
            - 'CloseHandle'
            - 'GetDelegateForFunctionPointer'
            #- 'kernel32' #noizy
            - 'CreateThread' #https://thedfirreport.com/2026/02/23/apache-activemq-exploit-leads-to-lockbit-ransomware/
            - 'memcpy'
            #- 'LoadLibrary'
            - 'GetModuleHandle'
            - 'GetProcAddress' #https://www.picussecurity.com/resource/blog/apt28-cyber-threat-profile-and-detailed-ttps
            - 'VirtualProtect' #https://thedfirreport.com/2026/02/23/apache-activemq-exploit-leads-to-lockbit-ransomware/
            #- 'FreeLibrary' #noizy
            - 'ReadProcessMemory'
            - 'CreateRemoteThread' #https://www.pointwild.com/threat-intelligence/when-malware-talks-back/
            - 'AdjustTokenPrivileges'
            - 'WriteByte'
            - 'WriteInt32'
            - 'OpenThreadToken'
            - 'PtrToString'
            - 'FreeHGlobal'
            - 'ZeroFreeGlobalAllocUnicode'
            - 'OpenProcessToken'
            - 'GetTokenInformation'
            - 'SetThreadToken'
            - 'ImpersonateLoggedOnUser' #https://www.welivesecurity.com/en/eset-research/muddywater-snakes-riverbank/; https://www.picussecurity.com/resource/blog/apt15-cyber-espionage-campaigns-and-ttps-analysis
            - 'RevertToSelf'
            - 'GetLogonSessionData'
            - 'CreateProcessWithToken' #https://research.checkpoint.com/2025/cracking-valleyrat-from-builder-secrets-to-kernel-rootkits/
            - 'CreateProcessWithLogon'
            - 'DuplicateTokenEx'
            - 'OpenWindowStation'
            - 'OpenDesktop'
            - 'MiniDumpWriteDump' #https://research.checkpoint.com/2025/ink-dragons-relay-network-and-offensive-operation/
            - 'AddSecurityPackage' #https://research.checkpoint.com/2025/ink-dragons-relay-network-and-offensive-operation/; https://www.picussecurity.com/resource/blog/t1547-005-security-support-provider
            - 'EnumerateSecurityPackages'
            - 'GetProcessHandle'
            - 'DangerousGetHandle'
            - 'CryptoServiceProvider'
            #- 'Cryptography'
            - 'Cryptography.Aes' #https://cert.gov.ua/article/6282517
            - 'RijndaelManaged'
            - 'SHA1Managed'
            - 'CryptoStream'
            - 'CreateEncryptor'
            - 'CreateDecryptor'
            - 'TransformFinalBlock'
            - 'DeviceIoControl'
            - 'SetInformationProcess'
            - 'PasswordDeriveBytes'
            - 'GetKeyboardState'
            - 'GetForegroundWindow' # private static extern IntPtr GetForegroundWindow(); https://www.darktrace.com/blog/cikabika-bot-inside-a-discord-rat
            - 'BindingFlags'
            - 'NonPublic' # https://blog.eclecticiq.com/seo-poisoning-campaign-leverages-gemini-and-claude-code-impersonation-to-deliver-infostealer
            - 'ScriptBlockLogging'
            - 'LogPipelineExecutionDetails'
            - 'ProtectedEventLogging'
            - 'StreamWriter'
            - 'BinaryWriter'
            - 'Globalization.RegionInfo'
    filters:
        - ScriptBlockText|contains:
            - 'SymantecCommands'
            - 'TrendMicroCommands'
            - 'ADSyncSourceAnchor'
            - 'AttackSurfaceReductionRules'
            - 'ControlledFolderAccessProtectedFolders'
            - 'ExternalHelp'
            - 'MaxQueueSizePercentage'
            - 'InstallWdBoot'
            - 'Disable-Localuser'
            - 'Thor.ps1' #common scripts
            - 'secops.ps1'
            - 'AutorunsToWinEventLog.ps1'
            - 'Deploy-Sysmon.ps1'
            - 'MMA.ps1'
            - 'AzureDefenderForServers'
            - 'DisableLocalAccounts'
        - ScriptBlockText|contains|all:
            - 'ProgramData'
            - 'Microsoft'
            - 'Defender'
            - 'Threat'
            - 'DataCollection'
        - ScriptBlockText|contains|all:
            - 'Onboarding'
            - 'Sense'
            - 'Diagnostics'
        - ScriptBlockText|contains|all:
            - 'sysvol' # GPO PS Scripts.
            - 'Policies'
            - 'TelemetryCriticalOption'
        - ScriptBlockText|contains|all:
            - 'slackb.com'
            - 'error' #powershell.exe -c Invoke-WebRequest -Uri https://slackb.com/error -Method POST -Headers "@{'X-Slack-Ses-Id' = '9acc...
        - ScriptBlockText|contains|all:
            - 'AzureConnectedMachineAgent'
            - 'azcmagent_check_updates' #"powershell.exe" -File "C:\Program Files\AzureConnectedMachineAgent\azcmagent_check_updates.ps1"
        - ScriptBlockText|contains|all:
            - 'VeeamSlackNotifications' # "powershell.exe" -file C:\VeeamScripts\VeeamSlackNotifications\SlackVeeamAlertSender.ps1 -JobName "XXXX" -Id "c320e7f1-d732-42b9-a4f6-2b08f99efb98"
            #- 'SlackVeeamAlertSender'
        - ScriptBlockText|contains:
            - 'ZDEeMBwGA1UEChMVTWljcm9zb2Z0IENvcnBvcmF0aW9uMR4wHAYDVQQDExVNaWNy' #signature block part AzureConnectedMachineAgent
            - 'CgYipvqCjochior3gYxSN0w6jQRbNcvzG4N1vl0wggTsMIID1KADAgECAhMzAAAA' #signature block part AzureConnectedMachineAgent
            - 'oprhj8AHIfuaHwi308m'
            - '74D7B4D63D59' #GUID "Microsoft Corporation"
        - ScriptBlockText|contains|all:
            - 'AcwBpAG8AbgAuAFYAZQByAHMAaQBvAG4AIAA='
            - 'outputFormat'
            - 'inputFormat'
            - 'xml'
    condition: selection and not filters
falsepositives:
    - Administrative activity.
    - Administrative scripts.
level: low
"#,
  // Unusual Top Level Domain In Commandline (via cmdline)
  "342b3e62-2e60-498c-901a-75f56012f02c": r#"title: Unusual Top Level Domain In Commandline (via cmdline)
id: 342b3e62-2e60-498c-901a-75f56012f02c
status: stable
description: Identifies unusual TLD (top level domains) in process commandline, which may be an indicator of malicious activity.
author: SOC Prime Team
references:
    - https://www.malware-traffic-analysis.net/2026/07/31/index.html
    - https://isc.sans.edu/diary/rss/32566
    - https://asec.ahnlab.com/en/92160/
    - https://www.derp.ca/research/hellsuchecker-clickfix-etherhiding/
tags:
  - attack.exfiltration
  - attack.t1567.002
  - attack.command_and_control
  - attack.t1105
logsource:
    category: process_creation
    product: windows
detection:
    selection_bin:
        Image|endswith:
            - 'curl.exe' # https://www.malware-traffic-analysis.net/2026/07/31/index.html
            - '\cmd.exe'
            - 'powershell.exe'
            - 'appinstaller.exe'
            - 'bitsadmin.exe'
            - 'certoc.exe'
            - 'certreq.exe'
            - 'certutil.exe'
            - 'cmdl32.exe'
            - 'configsecuritypolicy.exe'
            - 'desktopimgdownldr.exe'
            - 'devtunnel.exe'
            - 'diantz.exe'
            - 'esentutl.exe'
            - 'excel.exe'
            - 'expand.exe'
            - 'extrac32.exe'
            - 'findstr.exe'
            - 'finger.exe'
            - 'ftp.exe'
            - 'hh.exe'
            - 'ieexec.exe'
            - 'imewdbld.exe'
            - 'installutil.exe'
            - 'ldifde.exe'
            - 'makecab.exe'
            - 'mpcmdrun.exe'
            - 'msaccess.exe'
            - 'msedge_proxy.exe'
            - 'mshta.exe'
            - 'msohtmed.exe'
            - 'mspub.exe'
            - 'msxsl.exe'
            - 'ngen.exe'
            - 'onedrivestandaloneupdater.exe'
            - 'powerpnt.exe'
            - 'presentationhost.exe'
            - 'printbrm.exe'
            - 'protocolhandler.exe'
            - 'replace.exe'
            - 'squirrel.exe'
           # - 'update.exe'
            - 'visio.exe'
            - 'vslaunchbrowser.exe'
            - 'winget.exe'
            - 'winproj.exe'
            - 'winword.exe'
            - 'wsl.exe'
            - 'xsd.exe'
            - 'xwizard.exe'
    selection_http:
        CommandLine|contains:
            - 'http://'
            - 'https://'
    selection_tld:
        CommandLine|contains:
            - 'anondns.net'
            - 'dnspod.com'
            - '.io'
            - '.gg'
            - '.cc'
            - '.top'
            - '.xyz' #https://asec.ahnlab.com/en/92160/
            - '.pw'
            - '.stream'
            - '.loan'
            - '.download'
            - '.click' #https://www.derp.ca/research/hellsuchecker-clickfix-etherhiding/
            - '.science'
            - '.today'
            - '.accountant'
            - '.gdn'
            - '.name'
            - '.space'
            - '.online'
            - '.phd'
            - '.mov'
            - '.vip'
            - '.buzz'
            - '.boo'
            - '.wf'
            - '.pm'
            - '.hair'
    condition: selection_bin and selection_http and selection_tld
falsepositives:
    - Unknown
level: medium
"#,
  // LOLBAS MsiExec Spawn Shell (via cmdline)
  "34fd38da-cb73-4582-8d29-c866ba4aa91c": r#"title: LOLBAS MsiExec Spawn Shell (via cmdline)
id: 34fd38da-cb73-4582-8d29-c866ba4aa91c
status: stable
description: Detects the use of MsiExec as a living-off-the-land technique.
references:
    - https://www.huntress.com/blog/pups-grow-fangs
    - https://lolbas-project.github.io/lolbas/Binaries/Msiexec/
author: SOC Prime Team
tags:
    - attack.defense_evasion
    - attack.execution
    - attack.t1218.007
logsource:
    category: process_creation
    product: windows
detection:
    selection_parent:
        ParentImage|endswith: 'MsiExec.exe'
        Image|endswith:
            - 'cmd.exe'
            - 'powershell.exe' # https://www.huntress.com/blog/pups-grow-fangs
    filters:
        CommandLine|contains:
            - 'ZSAMSInstaller'
    condition: selection_parent and not filters
falsepositives:
    - Software updates.
    - Software installers.
level: low
"#,
  // Possible Manual Service or Driver Install for Persistence (via cmdline)
  "39fd7f61-89d5-4fe2-8c00-534506d06b10": r#"title: Possible Manual Service or Driver Install for Persistence (via cmdline)
id: 39fd7f61-89d5-4fe2-8c00-534506d06b10
description: Adversaries may install a new service that can be configured to execute at startup by using utilities to interact with services.
status: stable
author: SOC Prime Team
references:
    - https://blog-en.itochuci.co.jp/entry/2026/09/25/090000
    - https://asec.ahnlab.com/en/95211/
    - https://www.acronis.com/en/tru/posts/cambodia-focused-cluster-uses-multi-stage-infection-chain-with-localized-lures/
    - https://ipurple.team/2026/07/06/windows-service/
    - https://security.googlecloudcommunity.com/community-blog-42/finding-malware-dirtybulk-and-friends-usb-infections-to-fuel-cybercriminal-coinmining-operations-5552
    - https://github.com/moiz-2x/CVE-2025-24990_POC
    - https://blog.sekoia.io/apt28-operation-phantom-net-voxel/
    - https://cert.gov.ua/article/6284080
    - https://hadess.io/the-art-of-windows-persistence/
    - https://arcticwolf.com/resources/blog/tellmethetruth-exploitation-of-cve-2023-46604-leading-to-ransomware/
    - https://www.cisa.gov/news-events/alerts/2023/09/20/fbi-and-cisa-release-advisory-snatch-ransomware
    - https://www.cisa.gov/news-events/cybersecurity-advisories/aa23-263a
    - https://www.cisa.gov/sites/default/files/2023-09/joint-cybersecurity-advisory-stopransomware-snatch-ransomware_0.pdf
    - https://www.microsoft.com/en-us/security/blog/2023/08/24/flax-typhoon-using-legitimate-software-to-quietly-access-taiwanese-organizations/
    - https://blogs.blackberry.com/en/2023/08/cuba-ransomware-deploys-new-tools-targets-critical-infrastructure-sector-in-the-usa-and-it-integrator-in-latin-america
    - https://digital.nhs.uk/cyber-alerts/2022/cc-4002
    - https://attack.mitre.org/techniques/T1050/
    - https://unit42.paloaltonetworks.com/alloy-taurus-targets-se-asian-government/
    - https://blog.talosintelligence.com/lazarus_new_rats_dlang_and_telegram/
    - https://thedfirreport.com/2023/12/18/lets-opendir-some-presents-an-analysis-of-a-persistent-actors-activity/
    - https://www.attackiq.com/2024/04/16/emulating-oceanlotus/
    - https://blog.talosintelligence.com/lilacsquid/
    - https://news.sophos.com/en-us/2024/06/05/operation-crimson-palace-a-technical-deep-dive/
    - https://www.securonix.com/blog/from-cobalt-strike-to-mimikatz-slowtempest/
    - https://www.welivesecurity.com/en/eset-research/embargo-ransomware-rocknrust/
    - https://www.trendmicro.com/en_us/research/24/k/breaking-down-earth-estries-persistent-ttps-in-prolonged-cyber-o.html
    - https://medium.com/@S3N4T0R/venomous-bear-apt-adversary-simulation-43a22ef9640f
    - https://www.microsoft.com/en-us/security/blog/2025/02/12/the-badpilot-campaign-seashell-blizzard-subgroup-conducts-multiyear-global-access-operation/
    - https://www.sentinelone.com/labs/follow-the-smoke-china-nexus-threat-actors-hammer-at-the-doors-of-top-tier-targets/
    - https://unit42.paloaltonetworks.com/windows-backdoor-for-novel-c2-communication/
    - https://lab52.io/blog/deedrat-backdoor-enhanced-by-chinese-apts-with-advanced-capabilities/
    - https://businessinsights.bitdefender.com/curly-comrades-new-threat-actor-targeting-geopolitical-hotbeds
    - https://www.trendmicro.com/en_no/research/25/h/crypto24-ransomware-stealth-attacks.html
    - https://www.picussecurity.com/resource/blog/breaking-down-mustang-panda-windows-endpoint-campaign
    - https://www.picussecurity.com/resource/blog/crypto24-ransomware-uncovered-stealth-persistence-and-enterprise-scale-impact
    - https://arcticwolf.com/resources/blog/smash-and-grab-aggressive-akira-campaign-targets-sonicwall-vpns/
    - https://blog.xlab.qianxin.com/apt-stealthserver-en/
    - https://blog.talosintelligence.com/uncovering-qilin-attack-methods-exposed-through-multiple-cases/
    - https://www.cybereason.com/blog/tangerine-turkey
    - https://www.picussecurity.com/resource/blog/prophet-spider-threat-actor-explained
    - https://www.picussecurity.com/resource/blog/apt41-cyber-attacks-history-operations-and-full-ttp-analysis
    - https://www.reversinglabs.com/blog/malicious-vs-code-fake-image
    - https://www.welivesecurity.com/en/eset-research/sednit-reloaded-back-trenches/
    - https://unit42.paloaltonetworks.com/espionage-campaign-against-military-targets/
    - https://www.trendmicro.com/en_us/research/26/c/dissecting-a-warlock-attack.html
    - https://www.cyfirma.com/research/crysome-rat-an-advanced-persistent-net-remote-access-trojan/
tags:
    - attack.execution
    - attack.t1569.002
logsource:
    category: process_creation
    product: windows
detection:
    selection_bins:
        Image|endswith:
            - '.exe'
            - '.com'
            - '.tmp'
            - '.scr'
    selection_1:
        Image|endswith: 'sc.exe'
        CommandLine|contains:
            - 'create'
            - 'binpath=' #https://cert.gov.ua/article/6284080; https://www.trendmicro.com/en_us/research/26/c/dissecting-a-warlock-attack.html; https://www.acronis.com/en/tru/posts/cambodia-focused-cluster-uses-multi-stage-infection-chain-with-localized-lures/; https://asec.ahnlab.com/en/95211/; https://blog-en.itochuci.co.jp/entry/2026/09/25/090000
    selection_3:
        - CommandLine|contains|all:
            - 'config' # sc.exe config Targetservice binPath= “C:\Windows\revshell.exe” start= auto obj= “LocalSystem”
            - 'binpath=' #sc create ltmdm64_srv binPath="C:\Windows\System32\DriverStore...\ltmdm64.sys" type=kernel && sc start ltmdm64_srv
            - 'start='
            - 'auto'
            - 'obj='
        - CommandLine|contains|all:
            - 'New-Service'
            - 'binarypathname'
        - CommandLine|contains|all:
            - 'Get-WmiObject'
            - 'win32_service'
        - CommandLine|contains|all:
            - 'gwmi'
            - 'win32_service'
    filters:
        - CommandLine|contains|all:
            - 'ExplorerPatcher' # Program Files\ExplorerPatcher
            - 'ep_dwm_'
        - ParentImage|endswith:
            - 'InstallHypervisor.exe'
            - 'microsoft.azure.activedirectory.synchronization.upgrader.exe'
        - ParentImage|contains|all:
            - ':\Program Files'
            - '\Dropbox\Client'
            - 'Dropbox.exe'
        - CommandLine|contains:
            - 'HpTouchpointAnalytics'
            - '\Program Files' #sc  create "RzActionSvc" displayname="Razer Central Service" start=auto binpath="C:\\Program Files (x86)\\Razer\\Razer Services\\Razer Central\\RazerCentralService.exe"
            - 'netprotection_network_filter.sys'
            - '\avelam.sys'
        - Image|endswith:
            - 'csc.exe'
            - 'ksomisc.exe' # WPS office
    condition: selection_bins and (selection_1 or selection_3) and not filters
falsepositives:
    - Manual service creation by host administrator.
level: medium
"#,
  // Possible CVE-2026-109618 / CVE-2026-109619 Exploitation Attempt - PHP Memory Exhaustion / PHP Worker Crash (via webserver error logs)
  "42cd03f3-6b9f-49ea-9bf4-ce0caed6f772": r#"title: Possible CVE-2026-109618 / CVE-2026-109619 Exploitation Attempt - PHP Memory Exhaustion / PHP Worker Crash (via webserver error logs)
id: 42cd03f3-6b9f-49ea-9bf4-ce0caed6f772
status: experimental
author: SOC Prime Team
description: Detects PHP fatal errors - Allowed memory size of N bytes exhausted ... in Unknown on line 0 in web server or PHP-FPM error logs. This error pattern matches the publicly available PoC for CVE-2026-109618, part of the PHP2Shell remote code execution chain, where a crafted request exhausts memory while PHP parses the request, before any script runs. The rule detects this crash symptom, not successful code execution. Requires PHP error logging (log_errors=On) to the collected error.log.
references:
    - https://www.huntress.com/blog/php2shell-leaked-critical-php-vulnerabilities
tags:
    - attack.initial_access
    - attack.t1190
logsource:
    category: webserver
    definition: Requires error.log log file collection (May be located at /var/log/php-fpm/error.log, /var/log/nginx/error.log, var/log/httpd/error_log, /var/log/apache2/error.log)
detection:
    keywords_mem_part1:
        - 'Allowed memory size of'
    keywords_mem_part2:
        - 'bytes exhausted' #Allowed memory size of xxxxx bytes exhausted
    keywords_unk:
        - 'in Unknown on line 0' # Unknown on line 0
        - 'rfc1867.c' # rfc1867.c (multipart parser)
    keywords_apache_signal:
        - 'exit signal Segmentation fault (11)'
        - 'exit signal Abort (6)' # AH00051: child pid 104 exit signal Abort (6) internal research
        - 'exit signal Aborted (6)'
        - 'exit signal Bus error (7)'
    keywords_leak:
        - 'PHP Request Startup: Session ID is too long' # PHP Warning:  PHP Request Startup: Session ID is too long or contains illegal characters internal research
    keywords_fpm_signal:
        - 'signal 11 (SIGSEGV'
        - 'signal 6 (SIGABRT'
        - 'signal 7 (SIGBUS'
    keywords_body_limit:
        - 'Request body no files data length is larger than the configured limit'
        - 'Request body excluding files is bigger than the maximum expected'
    condition: (keywords_mem_part1 and keywords_mem_part2 and keywords_unk) or keywords_apache_signal or keywords_fpm_signal or keywords_body_limit or keywords_leak
falsepositives:
    - Legitimate requests exhausting memory during request parsing (large POST/multipart bodies with low memory_limit)
level: medium
"#,
  // Possible TOR Domain in Powershell Script (via powershell)
  "42e2973c-cf5e-47fa-b0e6-e73792578684": r#"title: Possible TOR Domain in Powershell Script (via powershell)
id: 42e2973c-cf5e-47fa-b0e6-e73792578684
description: Tor address appeared in powershell arguments may be an indicator of c2 communication or data exfiltration attempt.
status: stable
references:
  - https://cert.gov.ua/article/6281701
  - https://www.mandiant.com/resources/blog/trojanized-windows-installers-ukrainian-government
author: SOC Prime Team
tags:
  - attack.execution
  - attack.t1059.001
  - attack.command_and_control
  - attack.t1071.001
logsource:
  product: windows
  service: powershell
detection:
  selection:
    ScriptBlockText|contains: '.onion'
  condition: selection
falsepositives:
  - unknown
level: high
"#,
  // Possible Self-Extracting Archive was Created (via file_event)
  "43665ad1-ac11-4069-ad47-7fc26f54acca": r#"title: Possible Self-Extracting Archive was Created (via file_event)
status: stable
description: Self-extracting archives are executable files that are designed to extract
  their contents automatically when run. Adversaries may attempt to use self-extracting
  archives as a way to deliver malicious payloads onto a victim's system.
author: SOC Prime Team
references:
- https://www.crowdstrike.com/blog/self-extracting-archives-decoy-files-and-their-hidden-payloads/
- https://www.picussecurity.com/resource/blog/prince-of-persia-apt-analysis-infy-foudre-and-tonnerre-malware
tags:
- attack.execution
- attack.t1204.002
- attack.defense_evasion
- attack.t1027
logsource:
  product: windows
  category: file_event
detection:
  selection:
    TargetFilename|endswith:
    - .sfx
    - .sea
  filters:
  - TargetFilename|contains|all:
    - \Program
    - Files
  condition: selection and not filters
falsepositives:
- Legitimate self-extracting archives execution, requires further investigation.
level: medium
id: 43665ad1-ac11-4069-ad47-7fc26f54acca
