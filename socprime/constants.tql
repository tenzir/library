logsource:
    category: process_creation
    product: windows
detection:
  selection:
    ParentImage|endswith: '.exe' #must exists.
    Image|endswith:
      - 'SystemSettings.exe'
      - 'calc.exe' # https://www.enki.co.kr/en/media-center/blog/kimsuky-s-advanced-attack-techniques-jsonping-webex-spoofing-and-a-new-httpspy-variant
      - '\smss.exe' # https://www.virustotal.com/gui/file/25802493e7ef64523d6ab13ad6e5555b2b08fd4576ae2edd905ad939d256aa3a/behavior; https://asec.ahnlab.com/en/94552/
      - '\svchost.exe' # https://www.cyberproof.com/blog/a-deep-dive-into-pxa-stealer/; https://www.darktrace.com/blog/inside-zionsiphon-darktraces-analysis-of-ot-malware-targeting-israeli-water-systems; https://www.welivesecurity.com/en/eset-research/frostyneighbor-fresh-mischief-digital-shenanigans/; https://blog.talosintelligence.com/from-pdb-strings-to-maas-tracking-a-commodity-badiis-ecosystem/; https://www.trendmicro.com/en_us/research/26/g/actor-behind-patriot-bait-used-ai-to-deploy-c2-botnet.html; https://www.proofpoint.com/us/blog/threat-insight/carry-compromise-ta4922-packs-packclient; https://asec.ahnlab.com/en/95230/; https://www.huntress.com/blog/fake-gta6-download-malware-analysis; https://checkmarx.com/zero-post/malfex-npm-malware-campaign-three-payloads-and-an-adversary-that-signs-their-work/
      - 'gpupdate.exe'
      - 'taskhostw.exe'
      - 'rundll32.exe'
      - '\sc.exe'
      - 'consent.exe'
      - 'VSSVC.exe' #%PUBLIC%\Libraries\VSSVC.exe
      - 'sethc.exe'
      - '\lsm.exe'
      #- '\dwm.exe'
      - 'spoolsv.exe'
      - '\csrss.exe' # https://www.vmray.com/execution-level-analysis-of-a-russian-speaking-multi-operator-intrusion-campaign-operation-standoff/
      - 'wininit.exe'
      - 'fontdrvhost.exe'
      #- '\conhost.exe'
      - 'ctfmon.exe'
      - 'RuntimeBroker.exe' # https://www.mcafee.com/blogs/other-blogs/mcafee-labs/weedhack-minecraft-malware-as-a-service-campaign-research/; https://www.lac.co.jp/lacwatch/report/20260604_004759.html; https://www.jumpsec.com/guides/an-emerging-silver-fox-like-cluster-papermill/; https://unit42.paloaltonetworks.com/blinder-tunnel-targets-critical-infrastructure/; https://dreamgroup.com/blog/darkblinders-inside-an-active-espionage-campaign
      - 'dllhost.exe'
      - 'route.exe'
      - 'winlogon.exe'
      - 'systeminfo.exe'
      - 'ntoskrnl.exe'
      - 'timeout.exe'
      - 'explorer.exe'
      - 'mblctr.exe'
    CommandLine|contains: '.exe' #must exists.
  selection_dotnet:
    ParentImage|endswith:
      - '.exe'
      - '.tmp'
      - '.src'
    Image|endswith:
      - 'RegAsm.exe'
      - 'RegSvcs.exe'
  #filter_dwm:
  #  Image|endswith: 'dwm.exe'
  #  ParentImage|endswith: 'svc.exe' #\\ProgramData\\{4CEC2908-5CE4-48F0-A717-8FC833D8017A}\\0.1.263\\{FECA2AA4-B5B5-447C-A8B7-1D21B3900D34}\\dwm.exe
  filter_dotnet:
    - Image|contains|all:
      - 'Windows' #C:\Windows\Microsoft.NET\Framework\v4.0.30319\RegAsm.exe
      - 'Microsoft.NET'
      - 'Framework'
    - Image|contains:
      - '\Program Files'
      - '\Lenovo\Vantage\Addins\LenovoBatteryGaugeAddin'
  filters:
    Image|contains:
      - '\Windows\System32'
      - 'Windows\SysWOW64'
      - ':\Program Files'
      - '.NET\Framework' #SMSvcHost.exe
      - '\Windows\explorer.exe'
  condition: (selection and not filters) or (selection_dotnet and not filter_dotnet)
falsepositives:
  - Unknown
level: medium
"#,
  // Suspicious Command Patterns In Scheduled Task Creation
  "f2c64357-b1d2-41b7-849f-34d2682c0fad": r#"title: Suspicious Command Patterns In Scheduled Task Creation
id: f2c64357-b1d2-41b7-849f-34d2682c0fad
status: test
description: Detects scheduled task creation using "schtasks" that contain potentially
  suspicious or uncommon commands
references:
  - https://app.any.run/tasks/512c1352-6380-4436-b27d-bb62f0c020d6/
  - https://twitter.com/RedDrip7/status/1506480588827467785
  - https://www.ncsc.gov.uk/static-assets/documents/malware-analysis-reports/devil-bait/NCSC-MAR-Devil-Bait.pdf
author: Florian Roth (Nextron Systems)
date: 2022-02-23
modified: 2024-03-19
tags:
  - attack.privilege-escalation
  - attack.persistence
  - attack.execution
  - attack.t1053.005
logsource:
  product: windows
  category: process_creation
detection:
  selection_schtasks:
    Image|endswith: \schtasks.exe
    CommandLine|contains: '/Create '
  selection_pattern_1:
    CommandLine|contains:
      - '/sc minute '
      - '/ru system '
  selection_pattern_2:
    CommandLine|contains:
      - cmd /c
      - cmd /k
      - cmd /r
      - 'cmd.exe /c '
      - 'cmd.exe /k '
      - 'cmd.exe /r '
  selection_uncommon:
    CommandLine|contains:
      - ' -decode '
      - ' -enc '
      - ' -w hidden '
      - ' bypass '
      - ' IEX'
      - .DownloadData
      - .DownloadFile
      - .DownloadString
      - '/c start /min '
      - FromBase64String
      - mshta http
      - mshta.exe http
  selection_anomaly_1:
    CommandLine|contains:
      - :\ProgramData\
      - :\Temp\
      - :\Tmp\
      - :\Users\Public\
      - :\Windows\Temp\
      - \AppData\
      - '%AppData%'
      - '%Temp%'
      - '%tmp%'
  selection_anomaly_2:
    CommandLine|contains:
      - cscript
      - curl
      - wscript
  condition: selection_schtasks and ( all of selection_pattern_* or selection_uncommon
    or all of selection_anomaly_* )
falsepositives:
  - Software installers that run from temporary folders and also install scheduled
    tasks are expected to generate some false positives
level: high
regression_tests_path: regression_data/rules/windows/process_creation/proc_creation_win_schtasks_susp_pattern/info.yml
