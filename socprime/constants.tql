tags:
    - attack.execution
    - attack.t1059.001
author: SOC Prime Team
logsource:
    product: windows
    service: powershell
    definition: 'It is recommended to use the new "Script Block Logging" of PowerShell v5 https://adsecurity.org/?p=2277'
detection:
    selection:
        - ScriptBlockText|contains|all:
            - 'System.Security.Cryptography'
            - 'Unprotect' #[System.Security.Cryptography.ProtectedData]::Unprotect # In Windows Data Protection API (DPAPI); https://www.picussecurity.com/resource/blog/gamaredon-primitive-bear-apt-profile-and-mitre-attck-breakdown
        - ScriptBlockText|contains:
            - 'Veeam.Backup.ProtectedStorage' #after loading veeam.backup.common.dll
            - 'System.Xml.XmlDocument' #https://app.any.run/tasks/efa2eb84-2a2b-45cb-bd20-5cdfa9f644d5/
            - 'GetProcessById'
            - 'GetDelegateForFunctionPointer'
            - 'NtProtectVirtualMemory'
            - 'WriteAllBytes' #https://cert.gov.ua/article/6281681; https://blog.synapticsystems.de/uac-0247-malware-targeting-fpv-operators/; https://www.huntress.com/blog/bank-spam-rmm; https://blog.talosintelligence.com/uat-10147-chinese-speaking-adversary-integrates-agentic-ai-into-post-compromise-operations/; https://www.security.com/threat-intelligence/warlock-ransomware-critical-infrastructure; https://www.darktrace.com/blog/cikabika-bot-inside-a-discord-rat#cq=i1
            - 'CredentialCache'
            - '.Net.Sockets.TcpClient' #System.Net.Sockets.TcpClient(; https://github.com/tihanyin/PSSW100AVB/blob/main/ReverseShell_2025_01.ps1; https://cert.gov.ua/article/6282946; https://www.picussecurity.com/resource/blog/apt41-cyber-attacks-history-operations-and-full-ttp-analysis; https://blackpointcyber.com/blog/novel-fake-captcha-chain-delivering-amatera-stealer/
            - '.Net.Security.SslStream' #System.Net.Security.SslStream; https://blackpointcyber.com/blog/novel-fake-captcha-chain-delivering-amatera-stealer/
            - 'ASCIIEncoding'
            - 'GetTypeFromCLSID'
            - 'System.Runtime.InteropServices.Marshal' # https://www.orangecyberdefense.com/global/blog/cert-news/smoking-out-an-affiliate-smokedham-qilin-a-few-google-ads-and-some-bossware
            - 'System.Windows.Forms.Clipboard' # https://www.seqrite.com/blog/operation-dualscript-powershell-malware-retrorat-analysis/
            - 'System.Drawing.Bitmap' #https://cert.gov.ua/article/6282902
            - '.CopyFromScreen(' #https://cert.gov.ua/article/6282902
            - 'Windows.Clipboard'
            - 'System.Net.Sockets.TcpListener'
            - 'Reflection.Assembly' #[Reflection.Assembly]::LoadWithPartialName; https://www.elastic.co/security-labs/mimicrat-custom-rat-mimics-c2-frameworks; https://blog.eclecticiq.com/seo-poisoning-campaign-leverages-gemini-and-claude-code-impersonation-to-deliver-infostealer; https://www.bitdefender.com/en-us/blog/labs/microsofts-mshta-legacy-malware-windows; https://www.microsoft.com/en-us/security/blog/2026/06/17/postinstall-payload-inside-mastra-npm-supply-chain-compromise/; https://labs.k7computing.com/index.php/a-multi-stage-steganographic-loader-campaign-deploying-diverse-payloads-globally/; https://www.picussecurity.com/resource/blog/the-tradecraft-behind-2026s-least-prevented-ransomware-families; https://labs.k7computing.com/index.php/from-registry-stored-powershell-to-in-memory-cryptocurrency-mining-a-multi-stage-infection-chain/
            - 'Net.Sockets.SocketFlags'
            - 'Cryptography.Aes' #https://cert.gov.ua/article/6282517; https://isc.sans.edu/diary/rss/32884; https://www.seqrite.com/blog/abusing-trusted-business-workflows-a-multi-stage-phantom-stealer-campaign/; https://expel.com/blog/synkloader-when-you-throw-in-everything-but-the-kitchen-sink/
            #- 'System.IO.File'
            - 'ReadAllBytes' # powershell -WindowStyle Hidden Start-Process 'Presentation_Generale.pdf.pdf' ...[IO.File]::ReadAllBytes(...);$key=$data[239];$file=$env:TEMP+'\IfyuUapz.txt';...[IO.File]::WriteAllBytes($file, $xdata);cmd /c $file https://www.darktrace.com/blog/cikabika-bot-inside-a-discord-rat; https://strikeready.com/blog/cn-apt-targets-serbian-government/; https://www.zscaler.com/blogs/security-research/apt-attacks-target-indian-government-using-sheetcreep-firepower-and; https://www.esentire.com/blog/stx-rat-a-new-rat-in-2026-with-infostealer-capabilities; https://intel.breakglass.tech/post/silverfox-valleyrat-telegram-chinese-langpack-zpaq-bytedance-ctg; https://www.vmray.com/threat-intelligence-insights-pivoting-off-the-blockchain/; https://asec.ahnlab.com/en/94847/; https://www.enki.co.kr/en/media-center/blog/inside-kimsuky-s-abuse-of-legitimate-remote-control-tools-across-northeast-asia
            #- 'System.Reflection.Assembly'
            - 'AssemblyBuilderAccess'
            - 'SuspendThread'
            - 'Runtime.InteropServices.DllImportAttribute'
            - 'Reflection.Emit.AssemblyBuilderAccess'
            #- 'System.Reflection.AssemblyName'
            - 'DownloadString' #https://www.seqrite.com/blog/judicial-notification-phish-colombia-svg-asyncrat/; https://asec.ahnlab.com/en/92160/; https://www.levelblue.com/blogs/spiderlabs-blog/tracing-a-multi-vector-malware-campaign-from-vbs-to-open-infrastructure; https://www.bluevoyant.com/blog/augmented-marauders-multi-pronged-casbaneiro-campaigns; https://www.rapid7.com/blog/post/ve-clickfix-phishing-campaign-fake-claude-installer/; https://www.malwarebytes.com/blog/threat-intel/2026/04/fake-google-antigravity-downloads-are-stealing-accounts-in-minutes; https://www.trendmicro.com/en_us/research/26/e/installfix-and-claude-code.html; https://blog.sekoia.io/fsbs-matryoshka-2-3-gamaredons-gifts-that-keeps-unpacking-gammaload/; https://cofense.com/blog/from-fake-amazon-security-alert-to-harborwatch-agent-clickfix-delivery-of-a-custom-monitoring-rat; https://www.threatdown.com/blog/prinz-eugen-ransomware-a-deep-dive-into-a-new-go-based-encryptor/; https://arcticwolf.com/resources/blog/castleloader-new-campaigns-new-tooling-and-the-needlestealer-connection/; https://asec.ahnlab.com/en/94786/; https://www.genians.co.kr/en/blog/threat_intelligence/operation-gitpower; https://socradar.io/blog/inc-gentlemen-ransomware-ai-infrastructure/; https://www.zscaler.com/blogs/security-research/seo-poisoning-campaign-delivers-new-armorsteal-malware
            - 'DownloadFile' #https://www.picussecurity.com/resource/blog/xhunt-apt-cyber-espionage-operations-targeting-kuwait-and-exchange-servers; https://www.darktrace.com/blog/darktrace-malware-analysis-jenkins-honeypot-reveals-emerging-botnet-targeting-online-games; https://thehackernews.com/2026/05/daemon-tools-supply-chain-attack.html; https://www.microsoft.com/en-us/security/blog/2026/05/26/poisoned-search-results-gpu-mining-cryptojacking-campaign-abusing-screenconnect-microsoft-net-utilities/; https://www.seqrite.com/blog/threat-actors-weaponizing-rar-archives-to-target-thailands-healthcare-sector/; https://www.forescout.com/blog/seasonalinvite-new-phishing-campaign-abuses-ecards-and-rmm/; https://asec.ahnlab.com/en/94685/; https://www.securonix.com/blog/smoke-screen-screenconnect-rmm-abuse-cloudflare-tunnels/; https://www.huntress.com/blog/chatgpt-custom-gpts-clickfix-rat; https://socradar.io/blog/n0n-ransomware-ai-assisted-extortion/
            - 'DownloadData' #https://www.attackiq.com/2025/04/09/emulating-catb-ransomware/; https://www.trendmicro.com/en_us/research/26/c/dissecting-a-warlock-attack.html; https://www.hornetsecurity.com/en/blog/remcos-rat-attack-chain/; https://www.trellix.com/blogs/research/purerat-fileless-utilizing-steganography-process-hollowing/; https://www.huntress.com/blog/potemkin-loader-rmmproject-clickfix-attack; https://asec.ahnlab.com/en/94432/; https://www.esentire.com/blog/dindoor-denorat-and-nightshadec2-analyzing-tag-150s-evolving-tradecraft; https://www.elastic.co/security-labs/threat-command/malicious-browser-extension-kremlin-banking-malware; https://www.huntress.com/blog/amazon-clickfix-finger
            - 'WebRequest' #https://www.elastic.co/security-labs/a-wretch-client; https://zenox.ai/en/venon-the-first-brazilian-banker-rat-in-rust/; https://www.recordedfuture.com/research/clickfix-campaigns-targeting-windows-and-macos; https://cert.gov.ua/article/6288271; https://www.levelblue.com/blogs/spiderlabs-blog/err-hiding-and-seek-how-errtraffic-v3-leverages-etherhiding-in-clickfix-campaign; https://flare.io/learn/resources/blog/telegram-session-stealerpastebin-hosted-powershell-script-targets-desktop-web-sessions; https://www.pointwild.com/threat-intelligence/inside-vidar-2026-from-infection-to-memory-execution-via-jpeg-and-txt-payloads/; https://arcticwolf.com/resources/blog/bluenoroff-uses-clickfix-fileless-powershell-and-ai-generated-zoom-meetings-to-target-web3-sector/; https://blog.synapticsystems.de/uac-0184-from-hta-to-a-signed-network-stack/; https://blog.gdatasoftware.com/2026/05/38426-donutloader-remcos-rat; https://www.levelblue.com/blogs/spiderlabs-blog/hiding-in-the-chain-multi-stage-lnk-attack-leveraging-ton-blockchain-to-deliver-node.js-backdoor; https://www.seqrite.com/blog/operation-shadowrecruit-a-recruitment-themed-malware-campaign-leveraging-controlr-and-google-sheets-to-target-indian-job-seekers/; https://www.levelblue.com/blogs/spiderlabs-blog/beyond-fake-updates-from-application-store-themed-phishing-to-large-scale-distribution-of-screenconnect; https://www.genians.co.kr/en/blog/threat_intelligence/kimsuky_ai_llm; https://blog.deception.pro/blog/clickfix-spacex1337-hok-2026; https://www.huntress.com/blog/defcon-phishing-google-doc-malware; https://www.malwarebytes.com/blog/threat-intel/2026/08/tracking-pavinloader-across-clickfix-and-fake-download-campaigns; https://asec.ahnlab.com/en/95516/; https://www.securonix.com/blog/task-stomp-powershell-backdoor-document-theft-remote-access; https://www.microsoft.com/en-us/security/blog/2026/09/29/phishing-abuses-rmm-tools-persistent-access/; https://www.acronis.com/en/tru/posts/the-gentlemen-a-closer-look-at-a-not-so-gentle-ransomware-as-a-service-operation/
            - 'UnsafeLoadFrom'
            - 'ReflectionOnlyLoad'
            - 'ReflectionOnlyLoadFrom'
            - 'LoadModule'
            #- 'LoadFrom' #noizy
            #- 'LoadFile'
            - 'CreateRunspacePool'
            - '.UploadFile' # $resp = $wc.UploadFile("http://127.0.0.1:5000/success","C:\Users\K3vin\Downloads\log.txt") ; https://asec.ahnlab.com/en/94552/
            - ' byte[] ' #https://0x3obad.github.io/posts/plugx-writeup/; $hwgccxmzh = New-Object byte[] $bbbxcti.Length
        - ScriptBlockText|contains|all:
            - '::Decompress'
            - 'CompressionMode'
    filters:
        - ScriptBlockText|contains|all:
            - 'SendWebRequest'
            - 'CmdletBinding'
            - 'X509Certificate'
            - 'protocolversion'
            - 'ServicePointManager'
        - ScriptBlockText|contains|all:
            - 'ProgramData'
            - 'Microsoft'
            - 'Defender'
            - 'Threat'
            - 'DataCollection'
        - ScriptBlockText|contains|all:
            - 'sysvol' # GPO PS Scripts.
            - 'Policies'
        - ScriptBlockText|contains|all:
            - 'slackb.com'
            - 'error' #powershell.exe -c Invoke-WebRequest -Uri https://slackb.com/error -Method POST -Headers "@{'X-Slack-Ses-Id' = '9acc...
        - ScriptBlockText|contains|all:
            - 'AzureConnectedMachineAgent'
            - 'azcmagent_check_updates' #"powershell.exe" -File "C:\Program Files\AzureConnectedMachineAgent\azcmagent_check_updates.ps1"
        - ScriptBlockText|contains|all:
            - 'VeeamSlackNotifications' # "powershell.exe" -file C:\VeeamScripts\VeeamSlackNotifications\SlackVeeamAlertSender.ps1 -JobName "XXXX" -Id "c320e7f1-d732-42b9-a4f6-2b08f99efb98"
            - 'SlackVeeamAlertSender'
        - ScriptBlockText|contains:
            - 'install.python-poetry.org'
            - 'c_jndiPayloadEmailAddressSuffix' #Microsoft ATP
            - 'ScanVmwareVcenter'
            - 'AzureUSGovernment'
            - 'AzureChinaCloud'
            - 'USER_MODALS_INFO_0'
            - 'GetOAASEndpoint'
            - 'MSFT_DSCMetaConfiguration'
            - 'DF3C24F9BFD666761B268073FE06D1CC8D4F82A4' #MsAzureThumbprint
            - 'jITkdJQ6ZkWsTFETxLLOEGxe9BkTkXZaBOHlhTt5QIq6UB6j8zNN' #signature block part
            - 'EeF7LNvUquYFRndiCUhgy624rW6ptcnQTiRfE0QL' #signature block part
            - 'ZDEeMBwGA1UEChMVTWljcm9zb2Z0IENvcnBvcmF0aW9uMR4wHAYDVQQDExVNaWNy' #signature block part AzureConnectedMachineAgent
            - 'CgYipvqCjochior3gYxSN0w6jQRbNcvzG4N1vl0wggTsMIID1KADAgECAhMzAAAA' #signature block part AzureConnectedMachineAgent
            - 'oprhj8AHIfuaHwi308m'
            - '74D7B4D63D59' #GUID "Microsoft Corporation"
            - '$WAAPI_ERROR_INSTALLATION_FAILED;' # AV
            - '([String]::IsNullOrEmpty($ScannerSignedArgs.ScannerArgs))' # AV
            - '%SYSTEMROOT%\Temp\packer-windows-update'
        - ScriptBlockText|contains|all:
            - 'EVENT_TYPE_LOG'
            - 'PROPERTY_TYPE_ALERT'
            - 'Mom.ScriptAPI'
            - 'PROPERTY_TYPE_PERFORMANCE'
        - ScriptBlockText|contains|all:
            - 'ExpressedInMB'
            - 'NumberSizeExpInMB'
            - 'DISKSIZE_BYTES_IN_MB'
        - ScriptBlockText|contains|all:
            - 'IsVolumeSupported'
            - 'WMIGetInstanceNoAbort'
            - 'Get-Volumes([bool]$IsNano'
        - ScriptBlockText|contains|all:
            - 'TestIsWidRunning()' # Microsoft adfsToolbox
            - 'adfsConfigurationDbTestResult'
            - 'ConfigurationDatabaseConnectionString'
            - 'MSSQL$MICROSOFT##WID'
        - ScriptBlockText|contains|all:
            - 'Get-NetAdapter'
            - 'Resolve-DnsName'
            - 'cloudsink.net' # Crowdstrike domain
        - ScriptBlockText|contains|all:
            - '/master'
            - '/install-pyenv-win.ps1'
    condition: selection and not filters
falsepositives:
    - Administrative activity.
    - Administrative scripts.
level: medium
"#,
  // LOLBAS Schtasks (via cmdline)
  "4d8473ff-1998-4d2b-ba4b-3709c0cfcc5d": r#"title: LOLBAS Schtasks (via cmdline)
id: 4d8473ff-1998-4d2b-ba4b-3709c0cfcc5d
status: stable
description: Detects use of schtasks as a living off the land technique by looking for tasks that involve other lolbas commonly used to hide the intent of the task.
author: SOC Prime Team
