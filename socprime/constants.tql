            - '.wsh' #https://www.trendmicro.com/en_us/research/26/a/analyzing-a-a-multi-stage-asyncrat-campaign-via-mdr.html; https://cofense.com/blog/abusing-windows-file-explorer-and-webdav-for-malware-delivery; https://blog.gdatasoftware.com/2026/03/38399-analysis-kissloader
    selection_parents:
        ParentImage|endswith:
            - 'WScript.exe'
            - 'cscript.exe'
        Image|endswith:
            - 'powershell.exe' # https://www.pointwild.com/threat-intelligence/inside-vidar-2026-from-infection-to-memory-execution-via-jpeg-and-txt-payloads/; https://www.fortinet.com/blog/threat-research/phishing-campaign-deploys-javascript-driven-purelogs-variant-to-steal-sensitive-data; https://asec.ahnlab.com/en/94552/
            - 'cmd.exe'
            - 'at.exe'
            - 'AtBroker.exe'
            - 'bash.exe'
            - 'bitsadmin.exe'
            - 'certoc.exe'
            - 'cmstp.exe'
            - 'diskshadow.exe'
            - 'DllHost.exe'
            - 'dnscmd.exe'
            - 'explorer.exe'
            - 'extexport.exe'
            - 'forfiles.exe'
            - 'ftp.exe'
            - 'gpscript.exe'
            - 'hh.exe'
            - 'ie4uinit.exe'
            - 'ieexec.exe'
            - 'infdefaultinstall.exe'
            - 'installutil.exe'
            - 'mavinject.exe'
            - 'microsoft.workflow.compiler.exe'
            - 'mmc.exe'
            - 'msconfig.exe'
            - 'MSBuild.exe'
            - 'msdt.exe'
            - 'mshta.exe'
            - 'msiexec.exe'
            - 'netsh.exe'
            - 'odbcconf.exe'
            - 'offlinescannershell.exe'
            - 'pcalua.exe'
            - 'pcwrun.exe'
            - 'pnputil.exe'
            - 'presentationhost.exe'
            - 'rasautou.exe'
            - 'RegAsm.exe'
            - 'register-cimprovider.exe'
            - 'regsvcs.exe'
            - 'regsvr32.exe'
            - 'rundll32.exe'
            - 'runonce.exe'
            - 'runscripthelper.exe'
            - 'schtasks.exe' #https://cert.gov.ua/article/6284949
            - 'scriptrunner.exe'
            - 'settingsynchost.exe'
            - 'stordiag.exe'
            - 'syncappvpublishingserver.exe'
            - 'ttdinject.exe'
            - 'tttracer.exe'
            - 'verclsid.exe'
            - 'wab.exe'
            - 'WMIC.exe'
            - 'workfolders.exe'
            - 'wuauclt.exe'
            - 'xwizard.exe'
            - 'node.exe' #https://kmsec.uk/blog/js-malware-bigmathix/
    filters:
        - CommandLine|contains|all:
            - '\msvcp1'
            - 'filever.vbs' #cscript.exe  //nologo filever.vbs "C:\WINDOWS\System32\msvcp120.dll"
        - CommandLine|contains|all:
            - 'schtasks.exe'
            - 'Delete' #"C:\Windows\System32\schtasks.exe" /Delete /TN "Office Subscription Maintenance" /F
        - CommandLine|endswith:
            - ' invisible.vbs run.bat' #\??\C:\Program Files (x86)\Cisco Systems\ASDM\invisible.vbs
            - ' print '
            - ' print'
        - CommandLine|contains:
            - 'HPQWare' #CSCRIPT  "c:\hp\HPQWare\Util\QueryWMI.vbs" HP scripts dir.
            - 'ospp.vbs' #Tools to manage volume activation of Office
            - '\TEMP\.eset-' #ESET PROTECT
            - 'ChangeEventModuleBatchSize.vbs'
            - 'MonitorKnowledgeDiscovery.vbs'
            - '\Program Files'
            - '/Program Files'
            - '\.pyenv\pyenv-win\' #python stuff
            - 'OffScrubC2R' #Office-IT-Pro-Deployment-Scripts
            - '\SYSVOL\' #domain scripts
            - '\Office\Office' #ex.:\Microsoft\Office\OfficeInventoryAgentLogOn" /F
            - '\slmgr.vbs'
            - 'epson' #printer noise
            - 'parseXML.vbs base_agentdata.xml' #\Program Files (x86)\ManageEngine\AssetExplorer\bin\aeagent.exe
            - 'ae_scan.vbs agentdata' #\Program Files (x86)\ManageEngine\AssetExplorer\bin\aeagent.exe
            - 'dbhome_1\bin\nmeo.vbs' #ASKOD software
            - 'QlikViewHKCU' #QlikTech software
        - ParentImage|endswith:
            - 'EnableGraphicsTools.exe' #"C:\Windows\System32\wscript.exe" /b /NoLogo C:\Users\Ihor\AppData\Local\Temp\RunDismForEnableGraphicsTools.vbs
            - 'PhotoshopApp.exe' #"C:\WINDOWS\system32\wscript.exe" "D:\Portable Adobe Photoshop/App/DefaultData/Settings/post.vbs"
            - 'MonitoringHost.exe' #"cscript.exe" /nologo "ChangeEventModuleBatchSize.vbs"; #\"C:\\Windows\\system32\\cscript.exe\" /nologo \"MonitorKnowledgeDiscovery.vbs\"",
            - 'userinit.exe'
            - 'svchost.exe'
            - 'taskeng.exe'
            - 'MSACCESS.EXE'
            - 'gpscript.exe'
            - 'services.exe'
            - 'HDSentinel.exe'
            - 'vmware-svi-ga.exe'
            - 'mms.exe'
            - 'EpsonInstaller.exe'
            - 'MultiCommander.exe'
    condition: (selection_scripts or selection_parents) and not filters
falsepositives:
    - Administrative script files.
    - The reliance on the surrounding environment may necessitate the implementation of additional filtering measures to prevent false positives.
level: medium
"#,
  // Possible Web Server or WebApp Exploitation [Windows] (via cmdline)
  "be5f785a-0a7f-438e-be60-0a4fb15adcec": r#"title: Possible Web Server or WebApp Exploitation [Windows] (via cmdline)
id: be5f785a-0a7f-438e-be60-0a4fb15adcec
status: stable
description: Abnormal child processes associated with the Internet Information Services (IIS) or Apache HTTP Server may indicate the presence of a web shell or a vulnerability being exploited. Examples of this include the ProxyNotShell vulnerabilities CVE-2022-41040 and CVE-2022-41082. The number and behavior of child processes associated with the w3wp or httpd process depend on the logic or architecture of your web application and it may be necessary to implement additional filtering.
references:
    - https://www.huntress.com/blog/php2shell-leaked-critical-php-vulnerabilities
    - https://www.jpcert.or.jp/at/2026/at260030.html
    - https://blog.securelayer7.net/cve-2026-45659-sharepoint-deserialization-rce/
    - https://asec.ahnlab.com/en/94847/
    - https://www.cyber.gc.ca/en/news-events/sharpviewstateking-stealthy-implant-framework#fn1
    - https://reliaquest.com/blog/threat-spotlight-reliaquests-agentic-ai-uncovers-new-china-linked-cluster-op-512
    - https://cloud.google.com/blog/topics/threat-intelligence/knowledgedeliver-viewstate-deserialization-vulnerability/
    - https://www.bitdefender.com/en-us/blog/businessinsights/famoussparrow-apt-targets-azerbaijani-oil-gas-industry
    - https://www.trendmicro.com/en_us/research/26/d/inside-shadow-earth-053.html
