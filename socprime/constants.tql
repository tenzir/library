detection:
    selection:
        Image|endswith:
            - '.exe'
            - '.com'
            - '.tmp'
            - '.src'
        CommandLine|contains:
            - '.exe.vbs' # https://cofense.com/blog/click-install-compromised-the-new-wave-of-zoom-themed-attacks
            - '.dll.vbs'
            - '.doc.vbs'
            - '.docx.vbs'
            - '.xls.vbs'
            - '.xlsx.vbs'
            - '.ppt.vbs'
            - '.pptx.vbs'
            - '.rtf.vbs'
            - '.pdf.vbs'
            - '.txt.vbs'
            - '.jpg.vbs'
            - '.gif.vbs'
            - '.png.vbs'
            - '.zip.vbs'
            - '.7z.vbs'
            - '.dat.vbs'
    condition: selection
falsepositives:
    - none
level: high
