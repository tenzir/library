author: SOC Prime Team
tags:
    - attack.persistence
    - attack.initial_access
    - attack.t1505.003
    - attack.t1190
logsource:
    category: process_creation
    product: windows
detection:
    selection:
        - ParentImage|endswith:
            - 'w3wp.exe' #CVE-2025-53770; https://www.picussecurity.com/resource/blog/cve-2025-53770-critical-unauthenticated-rce-in-microsoft-sharepoint; https://research.checkpoint.com/2025/ink-dragons-relay-network-and-offensive-operation/
            - 'httpd.exe' #https://www.huntress.com/blog/nezha-china-nexus-threat-actor-tool
            - 'php-cgi.exe' # https://www.huntress.com/blog/php2shell-leaked-critical-php-vulnerabilities
        - ParentImage|contains|all:
            - '.exe'
            - 'tomcat' #tomcat9.exe # CVE-2024-56337 / CVE-2024-50379
    filter_chain1:
        ParentImage|endswith: 'w3wp.exe'
        Image|endswith:
            - 'where.exe' #uaisevalPool.config
            - 'dotnet.exe' #"dotnet.exe" .\CVWebServer.dll --iis --instance Instance001 --mode WebServer
            - 'php-cgi.exe'
    filter_chain2:
        ParentImage|endswith: 'httpd.exe'
        Image|endswith: '.cgi'
    filters:
        - CommandLine|contains|all:
            - 'REG QUERY'
            - 'ProductName'
        - CommandLine|contains:
            - 'Get-AuthenticodeSignature' #w3wp.exe -> ps -> "Powershell.exe" "(Get-AuthenticodeSignature -FilePath 'C:\CyberArk\Password Vault Web Access\RDPFileSigning\Cyberark.FileSystemAPIWrraper.dll').Status"\u000a
        - Image|contains:
            - 'EnergySuite.OrganizationWeb'
            - '\Exchange Server\' #\Device\HarddiskVolume5\Exchange Server\V15\Bin\OleConverter.exe
            - '\Microsoft Shared\' #\Device\HarddiskVolume2\Program Files\Common Files\Microsoft Shared\Web Server Extensions\14\BIN\CsiSrvExe.exe
        - Image|endswith:
            - 'Select.Html.dep' #
            - 'rotatelogs.exe' #"C:\Program Files\Apache HTTP Proxy 2.4.46\bin\rotatelogs.exe" -n 10 "C:/Program Files/Apache HTTP Proxy 2.4.46/logs/error.log" 1M
            - 'conhost.exe'
            - 'cvtres.exe' #C:\Windows\Microsoft.NET\Framework64\v4.0.30319\cvtres.exe /NOLOGO /READONLY /MACHINE:IX86 "/OUT:C:\Users\xxx\AppData\Local\Temp\RES17BA.tmp" "C:\Users\xxx\AppData\Local\Temp\RES17B9.tmp"
            - 'wermgr.exe' #w3wp.exe -> wermgr.exe
            - 'WerFault.exe' #crashes
            - 'csc.exe'
            - 'vbc.exe'
            - 'TranscodingService.exe'
            - 'w3wp.exe' # If multiple instances of the w3wp.exe process are running on the server, each instance will be assigned a unique instance number.
            - 'httpd.exe'
            - 'inetinfo.exe' #This process is used to manage IIS and its related services.
            - 'aspnet_wp.exe' #This process is used to host ASP.NET web applications.
            - ':\Windows\System32\conhost.exe' #from sigma baselining
            - 'OWSTIMER.exe' # https://blog.securelayer7.net/cve-2026-45659-sharepoint-deserialization-rce/
            - 'SPWriter.exe' # https://blog.securelayer7.net/cve-2026-45659-sharepoint-deserialization-rce/
            - 'noderunner.exe' # https://blog.securelayer7.net/cve-2026-45659-sharepoint-deserialization-rce/
            - 'mssearch.exe' # https://blog.securelayer7.net/cve-2026-45659-sharepoint-deserialization-rce/
            - 'wsstracing.exe' # https://blog.securelayer7.net/cve-2026-45659-sharepoint-deserialization-rce/
            - 'dllhost.exe' # https://blog.securelayer7.net/cve-2026-45659-sharepoint-deserialization-rce/
    condition: selection and not (filters or filter_chain1 or filter_chain2)
falsepositives:
    - A web application that uses system binaries like powershell, cmd etc. to perform its tasks is rare.
level: high
