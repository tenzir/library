    - https://www.darkrelay.com/post/apt42-operations-iocs-tactics-detection-strategies
    - https://www.huntress.com/blog/openclaw-github-ghostsocks-infostealer
    - https://research.checkpoint.com/2026/handala-hack-unveiling-groups-modus-operandi/
    - https://gbhackers.com/iran-linked-handala/
    - https://unit42.paloaltonetworks.com/boggy-serpens-threat-assessment/
    - https://www.trendmicro.com/en_us/research/26/c/dissecting-a-warlock-attack.html
    - https://www.securonix.com/blog/faux-elevate-threat-actors-crypto-miners-and-infostealers/
    - https://www.derp.ca/research/interlock-tooling-teardown/
    - https://www.elastic.co/security-labs/brushworm-targets-financial-services
    - https://www.cyberproof.com/blog/a-deep-dive-into-pxa-stealer/
    - https://ctrlaltintel.com/research/MuddyWater/
    - https://www.bluevoyant.com/blog/augmented-marauders-multi-pronged-casbaneiro-campaigns
tags:
    - attack.defense_evasion
    - attack.t1564
logsource:
    category: process_creation
    product: windows
detection:
    selection_base:
        ParentImage|endswith:
            - '.exe'
            - '.tmp'
            - '.src'
    selection:
        - Image|contains: '\Users\Public' #C:\Users\Public\BRCRLa.exe; https://cert.gov.ua/article/6284949; %PUBLIC%\Downloads\GoogleUpdate.exe; https://www.zscaler.com/blogs/security-research/apt-attacks-target-indian-government-using-sheetcreep-firepower-and; https://unit42.paloaltonetworks.com/boggy-serpens-threat-assessment/; https://www.securonix.com/blog/faux-elevate-threat-actors-crypto-miners-and-infostealers/; https://ctrlaltintel.com/research/MuddyWater/; https://www.bluevoyant.com/blog/augmented-marauders-multi-pronged-casbaneiro-campaigns; https://www.acronis.com/en/tru/posts/same-packet-different-magic-mustang-panda-hits-indias-banking-sector-and-korea-geopolitics/; https://cert.gov.ua/article/6318634; https://blog.talosintelligence.com/uat-10147-chinese-speaking-adversary-integrates-agentic-ai-into-post-compromise-operations/
        - CommandLine|contains: '\Users\Public' #C:\Users\Public\test.vbs; "CommandLine": "C:\\Windows\\System32\\rundll32.exe C:\\Users\\Public\\Libraries\\netid2922538259.dll0,Main netid2922538259.dll0",  https://www.trendmicro.com/en_us/research/26/c/dissecting-a-warlock-attack.html; https://www.derp.ca/research/interlock-tooling-teardown/; https://www.elastic.co/security-labs/brushworm-targets-financial-services; https://detect.fyi/analyzing-global-group-blacklock-artifacts-72dabc14c500; https://blog.deception.pro/blog/xworm-sc-hok-may-2026; https://cert.gov.ua/article/6318634
    filters:
        - ParentImage|contains:
            - 'pdfelement-pro' #\\Users\\Public\\Documents\\Wondershare\\xx-pdfelement-pro_64bit_full5488.exe
        - ParentImage|endswith:
            - 'AGCInvokerUtility.exe'
            - 'WeChat.exe'
            - 'UnityXL.exe'
            - 'services.exe'
        - CommandLine|contains:
            - '\WinStep\' #Windows themes.
            - 'AndroidSDK' #C:\Windows\system32\cmd.exe /c ""e:\Users\Public\Documents\Embarcadero\Studio\22.0\CatalogRepository\AndroidSDK-2525-22.0.48361.3236\cmdline-tools\latest\bin\avdmanager.bat" list avd"
            - 'AndroidNDK'
            - 'crash_log_file' #ffmpeg
            - 'desktop.ini' #"attrib" +H +S "C:\Users\Public\Desktop\desktop.ini"
            - 'xmlFilePath'
            #- 'ciscat'
            - 'ShOpenVerbShortcut'
            - 'dfs.link.shared'
            - 'WinScan2PDF.exe'
        - Image|contains:
            - 'Kingsoft'
            - 'AndroidSDK'
            - 'AndroidNDK'
            - 'V1ESUninstallTool' #Trend Micro SCUT Tool #"C:\Users\Public\trend\V1ESUninstallTool\Tools\DSA_CUT.exe" --jwt "C:\Users\Public\trend\V1ESUninstallTool\V1ESUninstallToken.txt" --logpath "C:\Windows\temp\V1ES"
            - 'SumatraPDF.exe'
            - '\Teams'
            - '\Program Files'
        - Image|endswith:
            - '\WinScan2PDF.exe'
            - 'CiscoCollabHost.exe'
        - CommandLine|contains|all:
            - '\Public\iVMS'
            - 'nginx.conf' #hikvision. "cmd.exe" /c cd /d "C:\Program Files (x86)\iVMS-4200 Site\Nginx" && nginx.exe -s stop -c "C:\Users\Public\iVMS-4200 Site\Nginx\conf\nginx.conf"
    condition: (selection_base and selection) and not filters
falsepositives:
    - highly possible, anyone can execute a binary from this location. Additional whitelisting is likely required
level: high
"#,
  // Possible Dynamic DNS Service Was Contacted (via dns)
  "4586d131-5d2a-4582-b028-a5841eea1d35": r#"title: Possible Dynamic DNS Service Was Contacted (via dns)
id: 4586d131-5d2a-4582-b028-a5841eea1d35
status: stable
description: Identifies requests to the dynamic DNS services, which may be potentially be abused by adversaries in order to, for example, deliver malware. It is highly recommended to baseline your activity and tune out common business use cases.
references:
  - https://www.welivesecurity.com/en/eset-research/mythicratatoskr-yggdrasil-enabled-backdoor-deployed-uac0099-sandworm-collaboration/
