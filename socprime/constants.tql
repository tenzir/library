  - https://www.seqrite.com/blog/operation-dualscript-powershell-malware-retrorat-analysis/
author: SOC Prime Team
tags:
  - attack.t1102
  - attack.command_and_control
logsource:
  category: dns
detection:
  selection:
    QueryName|endswith:
      - 'ddns.net' # https://www.noip.com/support/faq/frequently-asked-questions?utm_source=chatgpt.com
      - 'ddnsking.com' # https://www.rapid7.com/blog/post/tr-new-whitepaper-stealthy-bpfdoor-variants/
      - '3utilities.com'
      - 'bounceme.net'
      - 'freedynamicdns.net'
      - 'freedynamicdns.org'
      - 'gotdns.ch'
      - 'hopto.org'
      - 'myddns.me'
      - 'myftp.biz'
      - 'myftp.org'
      - 'myvnc.com'
      - 'onthewifi.com'
      - 'redirectme.net'
      - 'servebeer.com'
      - 'serveblog.net'
      - 'servecounterstrike.com'
      - 'serveftp.com'
      - 'servegame.com'
      - 'servehalflife.com'
      - 'servehttp.com'
      - 'serveirc.com'
      - 'serveminecraft.net'
      - 'servemp3.com'
      - 'servepics.com'
      - 'servequake.com'
      - 'sytes.net'
      - 'viewdns.net'
      - 'webhop.me'
      - 'zapto.org'
      - 'duckdns.org' # https://www.derp.ca/research/plog-rat-analysis/; https://www.acronis.com/en/tru/posts/new-janaware-ransomware-targets-turkey-via-adwind-rat/; https://www.catonetworks.com/blog/cato-ctrl-operation-poisson-analyzing-a-cybercriminals-entire-operation/; https://asec.ahnlab.com/en/94432/; https://www.proofpoint.com/us/blog/threat-insight/unpacking-cruciferra-analysis-sophisticated-crypter-service?utm_source=twitter&utm_medium=social_organic; https://www.acronis.com/en/tru/posts/patchcord-new-malware-cluster-targets-afghan-telecom-and-south-asian-critical-infrastructure/; https://www.levelblue.com/blogs/spiderlabs-blog/still-circling-inside-the-operator-behind-blind-eagles-github-loader; https://www.welivesecurity.com/en/eset-research/mythicratatoskr-yggdrasil-enabled-backdoor-deployed-uac0099-sandworm-collaboration/
      - 'ddnsfree.com'
      - 'ddnsgeek.com'
      - '1cooldns.com' # https://www.seqrite.com/blog/operation-dualscript-powershell-malware-retrorat-analysis/
      - 'ydns.eu' # https://www.hornetsecurity.com/en/blog/remcos-rat-attack-chain/; https://www.picussecurity.com/resource/blog/turla-secret-blizzard-apt-stockstay-and-kazuar-backdoors-explained
      - '.dpdns.org' # https://www.huntress.com/blog/nightmare-eclipse-intrusion
  condition: selection
falsepositives:
