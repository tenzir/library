author: SOC Prime Team
tags:
    - attack.execution
    - attack.t1059.001
    - attack.defense_evasion
    - attack.t1564.003
logsource:
    category: process_creation
    product: windows
detection:
    selection_pe:
        ParentImage|endswith:
            - '.exe'
            - '.com'
            - '.scr'
            - '.tmp'
        Image|endswith:
            - '.exe'
            - '.com'
            - '.scr'
            - '.tmp'
    selection:
        - CommandLine|contains|all:
            - 'bypass' # powershell -ExecutionPolicy Bypass -NoProfile -Command; powershell.exe -WindowStyle Hidden -executionpolicy bypass -noprofile -c Invoke-Expression (Get-Content "%TMP%\temporarydoc.txt" -Raw); https://www.bitdefender.com/en-us/blog/labs/fake-xeno-roblox-discord-executor; https://asec.ahnlab.com/en/95230/
            - 'NoProfile' #https://cert.gov.ua/article/6282902; https://cert.gov.ua/article/6284949; https://www.picussecurity.com/resource/blog/fog-ransomware-2025-deep-dive-into-ttps; https://www.pointwild.com/threat-intelligence/when-malware-talks-back/; https://www.picussecurity.com/resource/blog/t1059-001-powershell; https://slowmist.medium.com/threat-intelligence-job-scam-alert-interview-software-used-to-deliver-an-info-stealing-malware-37f018877e4c; https://www.huntress.com/blog/bank-spam-rmm
        - CommandLine|contains|all:
            - 'bypass' # -ep; -ExecutionPolicy; https://www.acronis.com/en/tru/posts/; https://any.run/cybersecurity-blog/major-cyber-attacks-november-2025/fake-adult-websites-pop-realistic-windows-update-screen-to-deliver-stealers-via-clickfix/; https://blog.sekoia.io/meet-iclickfix-a-widespread-wordpress-targeting-framework-using-the-clickfix-tactic/; https://isc.sans.edu/diary/rss/32754; https://www.microsoft.com/en-us/security/blog/2026/07/23/email-threat-landscape-q2-2026-trends-and-insights/; https://www.levelblue.com/blogs/spiderlabs-blog/cncmachinerms-the-undocumented-rat-at-the-end-of-a-babadeda-chain; https://www.genians.co.kr/en/blog/threat_intelligence/kimsuky_ai_llm
            - 'hidden' # -w;-WindowStyle; https://cert.gov.ua/article/6286219; powershell -ep bypass -windowstyle hidden -c $env:TEMP\updater.ps1; https://www.picussecurity.com/resource/blog/apt41-cyber-attacks-history-operations-and-full-ttp-analysis; https://www.acronis.com/en/tru/posts/boto-cor-de-rosa-campaign-reveals-astaroth-whatsapp-based-worm-activity-in-brazil/; https://www.mcafee.com/blogs/other-blogs/mcafee-labs/ai-written-malware-vibe-coded-campaign/; https://www.esentire.com/blog/stx-rat-a-new-rat-in-2026-with-infostealer-capabilities; https://www.seqrite.com/blog/operation-dragon-weave-uncovering-a-china-linked-campaign-targeting-czech-republic-and-taiwan-using-azure-cloud-c2/; https://www.fortra.com/blog/phishing-campaign-targets-banks-fileless-phantom-stealer-malware; https://www.levelblue.com/blogs/spiderlabs-blog/beyond-fake-updates-from-application-store-themed-phishing-to-large-scale-distribution-of-screenconnect; https://blog.talosintelligence.com/ransomware-incidents-in-japan-in-the-first-half-of-2026/
            #- 'UnRestricted' #"powershell.exe" "-ExecutionPolicy" "Unrestricted" "-Noninteractive"; https://socket.dev/blog/axios-npm-package-compromised
        - CommandLine|contains|all:
            - 'iex' #https://asec.ahnlab.com/en/94552/
            - 'hidden'
        - CommandLine|contains: ' -w H' #https://0x3obad.github.io/posts/plugx-writeup/; "C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe" -w H
        - CommandLine|contains|all:
            - 'hid ' # -w;-WindowStyle hidden; https://news.sophos.com/en-us/2025/10/10/whatsapp-worm-targets-brazilian-banking-customers/
            - 'enc '
        - CommandLine|contains|all:
            - '-NoL' #powershell.exe -NoP -NoL -NonI -Exec Bypass -Enc ...; https://malbearlabs.com/posts/novel-malware-built-to-survive-the-analyst
            - '-noP'
        - CommandLine|contains|all:
            - '-NonI' #powershell.exe -NoP -NoL -NonI -Exec Bypass -Enc ...; https://thedfirreport.com/2026/02/23/apache-activemq-exploit-leads-to-lockbit-ransomware/; https://www.malwarebytes.com/blog/threat-intel/2026/03/fake-temu-coin-airdrop-uses-clickfix-trick-to-install-stealthy-malware; https://www.fortinet.com/blog/threat-research/dprk-related-campaigns-with-lnk-and-github-c2; https://safedep.io/microsoftsystem64-binary-payload-analysis/; https://www.seqrite.com/blog/operation-shadowrecruit-a-recruitment-themed-malware-campaign-leveraging-controlr-and-google-sheets-to-target-indian-job-seekers/; https://www.huntress.com/blog/sql-injection-attacker-persistence
            - '-noP'
        - CommandLine|contains|all:
            - '-noI'
            - '-noP'
        - CommandLine|contains|all:
            - '-noni'
            - '-noe'
        - CommandLine|contains|all:
            - '-w '
            - '-nop'
        - CommandLine|contains|all:
            - '-w'
            - 'MINiM' #CSIDL_SYSTEM\windowspowershell\v1.0\powershell.exe" -wInDOwS MINiMiz; https://www.security.com/threat-intelligence/node-js-returns-ransomware
        - CommandLine|contains|all:
            - '-c ' #https://northwave-cybersecurity.com/ransomhouse-am-see
            - '-nop'
    selection_encoded:
        CommandLine|contains:
            - '-e '
            - '-en '
            - '-enc' # https://www.derp.ca/research/plog-rat-analysis/; https://any.run/cybersecurity-blog/monoglyphrat-attacks-us-enterprise/; https://isc.sans.edu/diary/rss/33348
    selection_combo:
        CommandLine|contains:
            - '-noni' #-NonInteractive; https://cert.gov.ua/article/6285731
            - '-noe'
            - '-noI' #-NonInteractive
            - '-noP' # https://www.malwarebytes.com/blog/threat-intel/2026/03/that-job-brief-on-google-forms-could-infect-your-device
            - '-NoL'
            - '-version ' # -version 2 "powershell downgrade"
            - '-w ' #-w hidden; https://news.sophos.com/en-us/2025/10/10/whatsapp-worm-targets-brazilian-banking-customers/;
            #- 'hidden'
    filters:
        - ParentImage|contains:
            - '\Program Files'
        - ParentImage|endswith:
            - 'AgentExecutor.exe'
            - 'zabbix_agentd.exe'
            - 'Miro.exe' #30f74b851aecb9648a639e64086bde89ac0336157afb888b54fa44d5354df616; "C:\Users\xxx\AppData\Local\Programs\RealtimeBoard\Miro.exe"
            - 'Un_A.exe'
            - 'Notion.exe'
            - 'glpi-agent.exe'
            - 'Canva.exe'
            - 'UDClientService.exe' #Lenovo
            - 'LenovoVantage-(LenovoSystemUpdateAddin).exe'
            - 'CcmExec.exe' #System Center Configuration Manager
            - 'smsexec.exe' #System Center Configuration Manager
            - 'gc_worker.exe' #C:\Program Files\AzureConnectedMachineAgent\GCArcService\GC\gc_worker.exe
            - 'senseir.exe'
            - 'microsoftdependencyagent.exe'
            - 'ISServerExec.exe'
            - 'Lenovo.Modern.ImController.exe'
            - 'Lenovo.Vantage.AddinInstaller.exe'
            - 'VMware.Hub.SfdAgent.DeployCmd.exe'
            - 'node.exe'
            - 'PBIDesktop.exe'
            - 'Microsoft.Management.Services.IntuneWindowsAgent.exe'
            - 'mgts-sw-install.exe'
            - 'discord.exe' #"powershell.exe -NoProfile -NoLogo -InputFormat Text -NoExit -ExecutionPolicy Unrestricted -Command -"
            - 'warp-svc.exe' #"PowerShell.exe" -NoProfile -NonInteractive -Command -
        - CommandLine|contains:
            - 'Microsoft Intune Management Extension'
            - 'Zabbix\scripts'
            - '::InstallWdBoot'
            - ':\Windows\CCM\SignedScripts\' #..."& 'C:\Windows\CCM\SignedScripts\DetectWindows8AppBundle.ps1'"  -AppName:'Microsoft....
            - 'AppXProvisionedPackage'
            - 'LenovoBatteryGaugeAddin' #C:\WINDOWS\system32\WindowsPowerShell\v1.0\PowerShell.exe -ExecutionPolicy bypass -NoProfile -NonInteractive -WindowStyle Hidden -File C:\ProgramData\Lenovo\Vantage\Addins\LenovoBatteryGaugeAddin\1.0.100.20\Install.ps1
            - '\Program Files\HP\Sure Click\' #"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "C:\Program Files\HP\Sure Click\4.4.21.937\servers\SetupBrHostExtension\Deploy-SBXEdge.ps1" -Uninstall
            - 'Get-AuthenticodeSignature'
            - 'CMakeFiles' #ninja.exe
            - '\Modules\SmbShare\DisableUnusedSmb1.ps1'
            - 'AzureDefenderForServers' #Powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File C:\Packages\Plugins\Microsoft.Azure.AzureDefenderForServers.MDE.Windows\1.0.3.1\\MdeExtensionHandler.ps1 -Action enable
            - 'AutorunsToWinEventLog'
            - 'PROD_SSIS_WORKING_DIR' #directory with scripts
            - 'Scripts\SFTP' #directory with scripts
            - 'git.exe' #git.exe -c core.quotepath=false -c log.showSignature=false status --ignored --porcelain -z no...
            - 'ReplaceOMCert' #"powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "New-CertificateNotificationTask -Type Replace -PSScript 'C:\Program Files\Microsoft Monitoring Agent\Agent\Tools\UpdateOMCert.ps1' -Name ReplaceOMCert -Channel System"
        - CommandLine|contains|all:
            - 'renderer'
            - 'sandbox' #Notion process
        - CommandLine|contains|all:
            - 'JetBrains'
            - 'PyCharm'
        - CommandLine|contains|all:
            - 'AppxPackage'
            - '.scratch' #...$isOfficeInstalled = Get-AppxPackage Microsoft.Office.Desktop -allusers;...
        - CommandLine|contains|all:
            - 'G4AdABdADoAOgBPAFM' #by c:\program files\azureconnectedmachineagent\gcarcservice\gc\gc_worker.exe
            - 'AVgBlAHIAcwBpAG8AbgAuAFYAZQBy'
            - 'outputFormat'
            - 'noninteractive'
            - 'encodedCommand'
        - CommandLine|contains|all:
            - 'Lenovo'
            - 'iMController'
            - 'ThinkAPSPackage'
        - CommandLine|contains|all:
            - 'Lenovo'
            - '\LenovoNow\'
        - CommandLine|endswith:
            - 'NoProfile' #"powershell.exe" -Version 5.1 -s -NoLogo -NoProfile
        - CommandLine|endswith:
            - 'UwBlAHQALQBMAG8AYwBhAHQAaQBvAG4AIAAnAEMAOgBcACcA' # Set-Location 'C:\'
            - 'XABTAHkAbQBhAG4AdABlAGMAIABFAG4AZABwAG8AaQBuAHQAIABQAHIAbwB0AGUAYwB0AGkAbwBuACcA' #\Symantec Endpoint Protection'
        - CommandLine|contains|all:
            - 'Defender'
            - 'Advanced' #C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe -ExecutionPolicy Bypass -NoProfile -NonInteractive -File "C:\ProgramData\Microsoft\Windows Defender Advanced Threat Protection\Downloads\PSScript_{B6A71383-285E-4039-B480-DABF6BA33ADE}.ps1" -ParamsAsBase64 ew0KICAgICJTY2FubmVy...
            - 'PSScript_{'
            - 'ParamsAsBase64'
        - CommandLine|contains|all:
            - 'CheckHookProcess'
            - 'Trend'
            - 'Micro' #"C:\Windows\sysnative\windowspowershell\v1.0\powershell.exe" -NonInteractive -NoProfile -file c:\temp\7597ed8d2925998a62a3281e938eaf02\CheckHookProcess.ps1 "C:\Program Files (x86)\Trend Micro\Security Agent\DatFHS.dll"
            - 'Agent'
        - CommandLine|contains|all:
            - 'WriteOnboardingMessage'
            - '5ECB0BAC-B930-47F5-A8A4-E8253529EDB7' #Microsoft Defender for Endpoint onboarding stuff
    condition: selection_pe and (selection or (selection_encoded and selection_combo)) and not filters
falsepositives:
    - Administrative powershell scripts.
    - Administrative activity.
level: medium
"#,
  // Possible Stomping Shadow Copies (via cmdline)
  "7fd732d8-5c80-43b4-845b-0b10c4f5a095": r#"title: Possible Stomping Shadow Copies (via cmdline)
id: 7fd732d8-5c80-43b4-845b-0b10c4f5a095
status: stable
description: Resizing is a relatively new approach among ransomware families compared to the previous methods like delete.
author: SOC Prime Team
references:
    - https://www.attackiq.com/2026/08/20/updated-response-to-aa25-071a/
    - https://www.cloudsek.com/blog/aurora-ransomware-affiliate-ai-attack-planning-crypto-payments
    - https://www.cisa.gov/news-events/cybersecurity-advisories/aa25-071a
    - https://www.fortinet.com/blog/threat-research/stomping-shadow-copies-a-second-look-into-deletion-methods
tags:
    - attack.impact
    - attack.t1490
logsource:
    category: process_creation
    product: windows
detection:
    selection:
        CommandLine|contains|all:
            - 'vssadmin'
            - 'resize'
            - 'shadowstorage'
    filters:
        ParentImage|endswith:
            - 'vssshadowfix.exe' #Dell stuff
    condition: selection and not filters
falsepositives:
    - Unknown
level: medium
