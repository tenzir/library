logsource:
    product: windows
    service: security
detection:
    selection:
        EventID: 4732
        TargetUserName|contains: 'adm'
    filter:
        SubjectUserName|endswith: '$'
    condition: selection and not filter
falsepositives:
    - Administrative activity.
level: medium
