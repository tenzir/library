tags:
    - attack.persistence
    - attack.t1547.001
    - attack.t1112
    - attack.defense_evasion
logsource:
    product: windows
    category: registry_event
detection:
    selection_aseps_base_chain1:
        TargetObject|contains:
            - 'SOFTWARE' #HKCU:\Software\Microsoft\Windows\CurrentVersion\Run -Name 'SecureModule' https://www.air.security/blog-posts/solanacry; Software\Microsoft\Windows\CurrentVersion\Run
            - 'Environment' #for coverage Environment\UserInitMprLogonScript in a detection chain.; https://www.trendmicro.com/en_us/research/26/g/actor-behind-patriot-bait-used-ai-to-deploy-c2-botnet.html
            - 'System' #SYSTEM\CurrentControlSet\Control\SafeBoot\AlternateShell'
    selection_aseps_base_chain2:
        TargetObject|contains:
            - 'Microsoft' #SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnceEx
            - 'Environment' #for coverage Environment\UserInitMprLogonScript in a detection chain.
            - 'CurrentControlSet' #SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp\InitialProgram
            - 'ControlSet001' # HKLM\SYSTEM\ControlSet001\Control\Print\Environments\Windows x64\Print Processors\VSPMsg
    selection_aseps:
        - TargetObject|endswith:
            - '\Run' #HKCU:\Software\Microsoft\Windows\CurrentVersion\Run -Name 'SecureModule' -Value "$staging\client32.exe" https://www.air.security/blog-posts/solanacry; HKCU\Software\Microsoft\Windows\CurrentVersion\Run -> C:\Users\<user>\AppData\Local\Microsoft\WpcMon\WpcMon.exe https://www.huntress.com/blog/camera-management-software-compromise-malware; Software\Microsoft\Windows NT\CurrentVersion\Windows\Run; https://cert.gov.ua/article/6284949; https://cert.gov.ua/article/6285731; https://cert.gov.ua/article/6286219; https://www.seqrite.com/blog/deceptive-layoff-themed-hr-email-distributes-remcos-rat-malware/; https://cert.gov.ua/article/6286942; https://www.cyfirma.com/research/solyximmortal-python-malware-analysis/; https://lab52.io/blog/plugx-meeting-invitation-via-msbuild-and-gdata/; https://sect.iij.ad.jp/blog/2026/02/plugx-executed-via-staticplugin/; https://arcticwolf.com/resources/blog/sloppylemming-deploys-burrowshell-and-rust-based-rat-to-target-pakistan-and-bangladesh/; https://cert.gov.ua/article/6287707; https://www.attackiq.com/2026/02/26/emulating-lokilocker-ransomware/; https://www.trellix.com/blogs/research/malware-as-a-service-redefined-xworm-rat/; https://isc.sans.edu/diary/32796; https://www.aikido.dev/blog/glassworm-strikes-react-packages-phone-numbers; https://www.picussecurity.com/resource/blog/t1547-001-registry-run-keys-startup-folder; https://www.malwarebytes.com/blog/threat-intel/2026/03/that-job-brief-on-google-forms-could-infect-your-device; https://www.aikido.dev/blog/glassworm-chrome-extension-rat; https://cert.gov.ua/article/6288047; https://labs.k7computing.com/index.php/resoker-a-telegram-based-remote-access-trojan/; https://www.zeroshadow.io/blog/malware-q27-customer-support/; https://www.netskope.com/blog/from-clickfix-to-maas-exposing-a-modular-windows-rat-and-its-admin-panel; https://www.esentire.com/blog/stx-rat-a-new-rat-in-2026-with-infostealer-capabilities; https://www.malwarebytes.com/blog/scams/2026/04/this-fake-windows-support-website-delivers-password-stealing-malware; https://www.malwarebytes.com/blog/threat-intel/2026/04/a-fake-slack-download-is-giving-attackers-a-hidden-desktop-on-your-machine; https://isc.sans.edu/diary/rss/32904; https://www.acronis.com/en/tru/posts/same-packet-different-magic-mustang-panda-hits-indias-banking-sector-and-korea-geopolitics/; https://www.levelblue.com/blogs/spiderlabs-blog/a-closer-look-at-the-novel-and-stealthy-karstorat-malware; https://www.netskope.com/blog/openclaw-hologram-fake-installer-ships-rust-infostealer; https://labs.infoguard.ch/posts/anatomy_deno_rat/; https://www.pointwild.com/threat-intelligence/how-a-windows-batch-script-quietly-delivered-azalea-rat/
            - '\Runonce' #SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\RunOnce; https://cert.gov.ua/article/6315762
            - '\RunOnce' #SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\RunOnce; https://cert.gov.ua/article/6315762
            - '\RunonceEx' #SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnceEx
            - '\RunOnceEx' #SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnceEx
            - '\Startup' #Software\Policies\Microsoft\Windows\System\Scripts\Startup
            - '\RunServicesOnce'
            - '\RunServices'
        - TargetObject|contains:
            - '\Run\' #Software\Microsoft\Windows NT\CurrentVersion\Windows\Run ## FOR LOGSOURCES WHICH CONCAT HIVE + KEYS + VALUES
            - '\Runonce\' #SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\RunOnce ## FOR LOGSOURCES WHICH CONCAT HIVE + KEYS + VALUES
            - '\RunOnce\' #SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\RunOnce ## FOR LOGSOURCES WHICH CONCAT HIVE + KEYS + VALUES; https://www.cyfirma.com/research/crysome-rat-an-advanced-persistent-net-remote-access-trojan/
            - '\RunonceEx\' #SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnceEx ## FOR LOGSOURCES WHICH CONCAT HIVE + KEYS + VALUES
            - '\RunOnceEx\' #SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnceEx ## FOR LOGSOURCES WHICH CONCAT HIVE + KEYS + VALUES
            - '\Startup\' #Software\Policies\Microsoft\Windows\System\Scripts\Startup ## FOR LOGSOURCES WHICH CONCAT HIVE + KEYS + VALUES
            - '\Load' #Software\Microsoft\Windows NT\CurrentVersion\Windows\Load; https://www.picussecurity.com/resource/blog/t1059-001-powershell
            - 'UserInitMprLogonScript' #Environment\UserInitMprLogonScript; https://www.picussecurity.com/resource/blog/apt28-cyber-threat-profile-and-detailed-ttps; https://www.splunk.com/en_us/blog/security/behind-the-code-layered-defense-evasion-vip-keylogger.html
            - '\Shell' #SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon\Shell; https://www.picussecurity.com/resource/blog/t1547-004-winlogon-helper; https://dmpdump.github.io/posts/TelegramRat/
            - '\Logoff' #Software\Policies\Microsoft\Windows\System\Scripts\Logoff
            - '\Logon' #Software\Policies\Microsoft\Windows\System\Scripts\Logon
            - '\Shutdown' #Software\Microsoft\Windows\CurrentVersion\Group Policy\Scripts\Shutdown
            - 'AutoStartOnConnect' #SOFTWARE\Microsoft\Windows CE Services\AutoStartOnConnect
            - 'AutoStartOnDisconnect' #SOFTWARE\Microsoft\Windows CE Services\AutoStartOnDisconnect
            - 'IconServiceLib' #Software\Microsoft\Windows NT\CurrentVersion\Windows\IconServiceLib
            - 'AvailableShells' #Software\Microsoft\Windows NT\CurrentVersion\Winlogon\AlternateShells\AvailableShells
            #- '\Installed Components' #SOFTWARE\Microsoft\Active Setup\Installed Components
            - 'AlternateShell' #SYSTEM\CurrentControlSet\Control\SafeBoot\AlternateShell
            - 'StartupPrograms' #System\CurrentControlSet\Control\Terminal Server\Wds\rdpwd\StartupPrograms
            - 'InitialProgram' #SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp\InitialProgram
            - '\NetSh' #SOFTWARE\Microsoft\NetSh'
            - 'Autorun' #SOFTWARE\Microsoft\Command Processor\Autorun
            - '\RunServicesOnce\'
            - '\RunServices\'
            - '\Monitors\'
            - '\Services' #\SYSTEM\CurrentControlSet\Services\; https://www.malwarebytes.com/blog/threat-intel/2026/02/fake-7-zip-downloads-are-turning-home-pcs-into-proxy-nodes; https://www.elastic.co/security-labs/badiis-to-the-bone-new-insights-to-global-seo-poisoning-campaign; https://www.picussecurity.com/resource/blog/t1547-003-time-providers; https://www.splunk.com/en_us/blog/security/detecting-ghost-rat-cloverplus-adware-loader-analysis.html
            - '\StartupApproved\StartupFolder' #HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved\StartupFolder\helper.lnk
            # - 'Processor' #SOFTWARE\Microsoft\Command Processor\Autorun
            - 'LegalNoticeText' #CurrentVersion\Winlogon /v LegalNoticeText; https://www.picussecurity.com/resource/blog/t1547-004-winlogon-helper
            - 'DefaultUserName' #CurrentVersion\Winlogon /v DefaultUserName; https://www.picussecurity.com/resource/blog/t1547-004-winlogon-helper
            - 'AutoLogonCount' #CurrentVersion\Winlogon /v AutoLogonCount; https://www.picussecurity.com/resource/blog/t1547-004-winlogon-helper
            - '\Print Processors\' #HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Control\Print\Environments\Windows x64\Print Processors\VSPMsg
    filters_chain1:
        Image|endswith: 'spoolsv.exe'
        TargetObject|contains:
            - '\Print\Monitors\Appmon\Ports' #HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Control\Print\Monitors\Appmon\Ports\Microsoft.Office.OneNote_16001.14326.21886.0_x64__8wekyb3d8bbwe_microsoft.onenoteim_S-1-5-21-xxx-xxx-xxxx-1002\
    filters:
        - TargetObject|contains:
            - '\MuiCache' #HKEY_CURRENT_USER\S-1-5-2...69-1264_Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache
            - 'wextract_cleanup0'
            - '\ShellCompatibility'
            - 'Microsoft\Office\ClickToRun\'
        - TargetObject|contains|all:
            - '\Program'
            - 'Files'
        - Image|contains|all:
            - '\Program'
            - 'Files'
        - Image|contains|all:
            - 'spool'
            - 'drivers'
        - Image|contains|all:
            - 'slack.exe'
            - 'appdata'
            - 'local'
        - Image|contains|all:
            - 'Windows'
            - 'Defender'
        - Image|contains|all:
            - 'Microsoft'
            - 'Teams'
        - Details|contains:
            - 'msiUninstall'
        - Details|contains|all:
            - 'ProgramData\dell\drivers' #"C:\ProgramData\dell\drivers\d65b698d-b16d-4733-8b67-9d84f7561975\Setup.exe" /debuglog"C:\ProgramData\dell\drivers\d65b698d-b16d-4733-8b67-9d84f7561975\DUPLogDir\DUP539E.tmp" /silent
            - 'debuglog'
        - Details|contains|all:
            - '\Program'
            - 'Files'
        - Details|contains|all:
            - 'burn.runonce'
            - 'Cache'
        - Image|contains:
            - '32\driverstore\'
        - Image|endswith:
            - 'bingchatinstaller.exe' #\Software\Microsoft\Windows\CurrentVersion\RunOnce\!BCILauncher / c:\windows\temp\mubstemp\bingchatinstaller.exe
            - 'opera\opera.exe'
            - 'bin\updater.exe' #google
            - '32\ctfmon.exe'
            - 'windowsazureguestagent.exe'
            - '32\logonui.exe'
            - 'compattelrunner.exe'
            - '32\wininit.exe'
            - 'setupplatform.exe'
            - 'mmasetup-amd64.exe'
            - 'taskmgr.exe'
            - 'zoom.exe'
            - 'steamsetup.exe'
            - 'viber.exe'
            - 'googleupdate.exe'
            - '32\runtimebroker.exe'
            - '32\openwith.exe'
            - 'bt\sources\setuphost.exe'
            - 'installing\assistant_installer.exe'
            - 'onedrivesetup.exe'
            - 'reg.exe'
            - 'MsiExec.exe'
            - '32\csrss.exe'
            - '32\drvinst.exe'
            - '32\poqexec.exe'
            - '32\userinit.exe'
            - 'Windows\Explorer.EXE'
            - '\system32\svchost.exe'
            - 'grammarlyinstaller.exe'
            - 'devicecensus.exe'
            - '32\searchindexer.exe'
            - '32\mousocoreworker.exe'
            - 'microsoft.sharepoint.exe'
    condition: (selection_aseps_base_chain1 and selection_aseps_base_chain2 and selection_aseps) and not (filters or filters_chain1)
falsepositives:
    - Software installers downloaded and used by users.
    - The reliance on the surrounding environment may necessitate the implementation of additional filtering measures to prevent false positives.
level: low
"#,
  // Possible php Application Command and Control by Reverse Shell Inline Execution (via cmdline)
  "8715c8a4-9bcb-47e2-ab10-98e6e8eb140c": r#"title: Possible php Application Command and Control by Reverse Shell Inline Execution (via cmdline)
id: 8715c8a4-9bcb-47e2-ab10-98e6e8eb140c
status: stable
description: This rule identifies a reverse shell that uses the php shell utility to handle streams of commands and output over a network device file
author: SOC Prime Team
references:
    - https://www.huntress.com/blog/php2shell-leaked-critical-php-vulnerabilities
    - https://highon.coffee/blog/reverse-shell-cheat-sheet/
    - https://www.php.net/manual/en/function.fsockopen.php
tags:
  - attack.execution
  - attack.t1059.004
logsource:
  category: process_creation
  product: linux
detection:
  selection_php_command:
    Image|endswith: 'php'
    CommandLine|contains|all:
      - '-r'
      - 'fsockopen('
      - 'exec('
  selection_shell_and_file_descriptor:
    CommandLine|re: '.{0,5}sh.*[3-9][0-9]*' # any of the shells in combination with FD 3-6 (most likely descriptors to be handed to the socket from the OS since 0-2 will be occupied in standard configurations)
  condition: selection_php_command and selection_shell_and_file_descriptor
falsepositives:
  - unknown
level: medium
"#,
  // Suspicious NodeJS Child Processes [Windows] (via cmdline)
  "878fb007-972d-46a7-8ce3-d050642cf7d0": r#"title: Suspicious NodeJS Child Processes [Windows] (via cmdline)
id: 878fb007-972d-46a7-8ce3-d050642cf7d0
status: stable
description: This rule is designed to identify suspicious activities involving NodeJS child processes initiated through the command line. It is highly recommended to baseline your activity and tune out common business use cases.
author: SOC Prime Team
references:
    - https://research.jfrog.com/post/beyond-testmetest-42-hijacked-github-repos/
    - https://webflow.sysdig.com/blog/node2shell-cve-2026-111497-detecting-the-node-js-brotli-rce
    - https://asec.ahnlab.com/en/95516/
    - https://blackpointcyber.com/blog/chainscript-tracing-a-nodejs-rat-across-the-blockchain/
    - https://www.elastic.co/security-labs/contagious-interview-malware-svg-steganography
    - https://www.sophos.com/en-us/blog/2607_agents_vs_telemetry
    - https://socket.dev/blog/axios-npm-package-compromised
    - https://unit42.paloaltonetworks.com/cve-2025-55182-react-and-CVE-2025-66478-next/
    - https://thehackernews.com/2025/12/critical-rsc-bugs-in-react-and-nextjs.html
    - https://www.fortinet.com/blog/threat-research/stealit-campaign-abuses-nodejs-single-executable-application
    - https://redcanary.com/blog/threat-intelligence/intelligence-insights-june-2025/
    - https://redcanary.com/blog/threat-intelligence/mocha-manakin-nodejs-backdoor/
    - https://www.greynoise.io/blog/cve-2025-55182-react2shell-opportunistic-exploitation-in-the-wild-what-the-greynoise-observation-grid-is-seeing-so-far
