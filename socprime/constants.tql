level: low
"#,
  // Admin Change the Password for other Admin (via audit)
  "a961fbe5-1acd-49cc-8233-413b46653f52": r#"title: Admin Change the Password for other Admin (via audit)
id: a961fbe5-1acd-49cc-8233-413b46653f52
description: To monitor when a domain admin user changes his password manually in AD for himself/other domain Admin
status: stable
author: SOC Prime Team
references:
    - https://docs.microsoft.com/en-us/windows/security/threat-protection/auditing/event-4724
    - https://socprime.com/detectflow/ # FOR DF DEMO
tags:
    - attack.credential_access
    - attack.t1098
logsource:
    product: windows
    service: security
detection:
    selection:
        EventID: 4724
        SubjectUserName|contains:
            - 'Adm' #for case-sensetive fields
            - 'adm'
        TargetUserName|contains:
            - 'Adm' #for case-sensetive fields
            - 'adm'
    condition: selection
falsepositives:
    - Administrative activity
level: medium
"#,
  // Suspicious Persistence Activity by Execution Of Shell Commands From Web Service Users And Groups (via auditd)
  "ac652c9a-dd0b-11ec-9d64-0242ac120002": r#"title: Suspicious Persistence Activity by Execution Of Shell Commands From Web Service Users And Groups (via auditd)
description: Detects when the effective user or group id associated with common web services has started a shell session. This behavior is indicative of webshell execution.
id: ac652c9a-dd0b-11ec-9d64-0242ac120002
author: SOC Prime Team
status: stable
references:
  - https://www.huntress.com/blog/php2shell-leaked-critical-php-vulnerabilities
  - https://www.wiz.io/blog/artex-in-the-wild-storm-0940-expands-targeting-of-it-and-software-vendors
  - https://japancyberwatch.com/articles/artex-ai-pentest-tool-japan-breach-wave-gmo-2026
  - https://ai-coding.wiselychen.com/crowdstrike-artex-korea-banks-open-directory-claude-code/
  - https://www.crowdstrike.com/en-us/blog/unknown-threat-actor-uses-artex-to-target-south-korean-finance/
  - https://media.defense.gov/2020/Jun/09/2002313081/-1/-1/0/CSI-DETECT-AND-PREVENT-WEB-SHELL-MALWARE-20200422.PDF
tags:
  - attack.persistence
  - attack.t1505.003
logsource:
  product: linux
  service: auditd
  definition: 'ensure the following rule is in auditd.rules: -a always,exit -F arch=b32 -F uid=33 -S execve; -a always,exit -F arch=b64 -F uid=33 -S execve. Also, ensure that the uid field value is set to the actul uid of the webservice user. Or alternatively use auditd plugins that resolve uid/gid to names such as laurel https://github.com/threathunters-io/laurel'
detection:
  selection_shell_execution:
    type: 'SYSCALL'
    comm|endswith: 'sh' # /bin/sh https://www.huntress.com/blog/php2shell-leaked-critical-php-vulnerabilities
    exe|endswith: 'sh'
  selection_web_service_user:
    euid:
      - 'apache'
      - 'nginx'
      - '33'
    egid:
      - 'apache'
      - 'nginx'
      - '33'
  condition: selection_shell_execution and selection_web_service_user
falsepositives:
  - unlikely
level: high
"#,
  // Possible Archive Containing Password In The File Name Was Created (via file_event)
  "b3a67b3c-b2f4-49f4-8398-da4734ca9ecb": r#"title: Possible Archive Containing Password In The File Name Was Created (via file_event)
status: stable
author: SOC Prime Team
description: Adversaries may try to deliver their malicious files in a password-protected archive, in order to gain initial access.
references:
  - https://www.cybereason.com/blog/from-cracked-to-hacked-malware-spread-via-youtube-videos
  - https://www.proofpoint.com/us/blog/threat-insight/threat-actors-deliver-malware-youtube-video-game-cracks
  - https://www.trellix.com/blogs/research/how-attackers-repackaged-a-threat-into-something-that-looked-benign/
tags:
  - attack.t1566.001
  - attack.initial_access
logsource:
  category: file_event
  product: windows
detection:
  selection_ext:
    TargetFilename|endswith:
      - '.zip'
      - '.rar'
      - '.7z'
  selection_name:
    TargetFilename|contains:
      - 'pass' # Setup (PA$S 5577).rar
      - 'pas$'
      - 'pa$s'
      - 'pa$$'
      - 'p@ss'
      - 'p@$s'
      - 'p@s$'
      - 'p@$$'
      - 'pswrd'
      - 'pswd' # Setup_Pswrd_1234.rar
      - 'p$wrd'
  condition: selection_ext and selection_name
falsepositives:
  - Unknown
level: medium
id: b3a67b3c-b2f4-49f4-8398-da4734ca9ecb
"#,
  // Explicit COMSPEC Usage in Service File Path (via audit)
  "b479ee8f-e292-4466-95b3-fa000ba3f724": r#"title: Explicit COMSPEC Usage in Service File Path (via audit)
id: b479ee8f-e292-4466-95b3-fa000ba3f724
status: stable
description: Adversaries may use COMSPEC environment variable to point to cmd.exe (to avoid cmd.exe string in the logs).
author: SOC Prime Team
references:
    - https://thedfirreport.com/2025/01/27/cobalt-strike-and-a-pair-of-socks-lead-to-lockbit-ransomware/
    - https://www.infosecurity-magazine.com/news/signature-techniques-of-asian-apt/
    - https://thedfirreport.com/2022/02/21/qbot-and-zerologon-lead-to-full-domain-compromise/
    - https://thedfirreport.com/2026/02/23/apache-activemq-exploit-leads-to-lockbit-ransomware/
    - https://www.genians.co.kr/en/blog/threat_intelligence/kakaotalk
    - https://isc.sans.edu/diary/SmartApeSG+campaign+pushes+Remcos+RAT+NetSupport+RAT+StealC+and+Sectop+RAT+ArechClient2/32826
    - https://socprime.com/detectflow/ # FOR DF DEMO
tags:
    - attack.execution
    - attack.t1059.003
logsource:
    product: windows
    service: security
detection:
    selection:
        EventID: 4697
        ServiceFileName|contains: 'COMSPEC' # %COMSPEC% /C "tasklist /f /im explorer.exe"; Service File Name: %COMSPEC% /Q /c echo route print > \\127.0.0.1\C$__output 2>^&1 > %TEMP%\ execute.bat & %COMSPEC% /Q /c %TEMP%\execute.bat & del %TEMP%\execute.bat
    condition: selection
falsepositives:
    - none
level: high
"#,
  // Possible Microsoft Defender Suspending / Abusing Attempt (via cmdline)
  "b6712d1a-1630-4626-9965-5ce22b73986d": r#"title: Possible Microsoft Defender Suspending / Abusing Attempt (via cmdline)
id: b6712d1a-1630-4626-9965-5ce22b73986d
status: stable
description: It detects potential attempts to suspend or manipulate a Microsoft Defender process using a tool such as PsSuspend (or similar), where the process name is provided as an argument or spawns suspicious child processes.
references:
  - https://www.cyderes.com/howler-cell/rogueplanet-windows-zero-day
  - https://github.com/MSNightmare/RoguePlanet
  - https://www.picussecurity.com/resource/blog/rogueplanet-anatomy-of-the-nightmare-eclipse-microsoft-defender-zero-day
  - https://twitter.com/0gtweet/status/1638069413717975046
tags:
  - attack.t1562.001
  - attack.defense_evasion
  - attack.t1068
  - attack.privilege_escalation
author: SOC Prime Team
logsource:
  product: windows
  category: process_creation
detection:
  selection_cmd:
    CommandLine|endswith: 'MsMpEng.exe' #pssuspend.exe msmpeng.exe
  selection_child:
    ParentImage:
      - 'MsMpEng.exe'
      - 'wermgr.exe' # rogueplanet exploit
    Image|endswith:
      - 'cmd.exe'
      - 'conhost.exe' # rogueplanet exploit
      - 'powershell.exe'
  condition: selection_cmd or selection_child
falsepositives:
  - Unknown
level: medium
"#,
  // LOLBAS WScript / CScript (via process_creation)
