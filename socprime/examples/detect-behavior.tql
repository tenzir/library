---
name: Detect with SOC Prime behavior rules
description: |
  Normalizes Windows Event Log XML to OCSF with the Microsoft package, matches
  the events against all SOC Prime behavior rules, and writes the findings,
  enriched with SOC Prime Active Threats, to NDJSON files. Requires the
  `microsoft` package.
---

// Replace this source with your Windows events, such as from `accept_wef`.
from_file "/var/log/windows/events.xml" {
  read_delimited "</Event>\n", include_separator=true
}
microsoft::windows::ocsf::normalize data
socprime::detect
socprime::enrich
// Replace this sink with your SIEM or another destination as needed.
to_file "/var/lib/tenzir/socprime/findings/behavior-{uuid}.ndjson" {
  write_ndjson
}
