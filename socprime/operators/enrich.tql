---
description: |
  Enriches detection findings with SOC Prime Active Threats.

  The operator looks up `finding_info.analytic.uid` in the catalog that
  `socprime::update_context` maintains and appends the OCSF `osint` objects
  of all matching Active Threats to `osint`. Chain findings get the complete
  threats, findings of single behavior rules only references to them. When
  the analytic is not in the catalog, the operator tries the first entry of
  `finding_info.related_analytics`, so that a custom detection can attribute
  its findings to the threats of a SOC Prime rule.
args:
  named:
    - name: context_name
      type: string
      default: socprime-active-threats
      description: Lookup-table context to query.
---

if class_uid == 2004 {
  context_enrich $context_name,
    key=finding_info?.analytic?.uid?,
    into=_socprime
}
if class_uid == 2004 and _socprime? == null and finding_info?.related_analytics? != null {
  context_enrich $context_name,
    key=finding_info.related_analytics[0].uid,
    into=_socprime
}
if _socprime? != null {
  osint = [...osint?, ..._socprime]
  metadata.profiles = (metadata.profiles? else []).add("osint")
}
drop _socprime
