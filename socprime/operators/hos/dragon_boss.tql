sigma rules=[...$stages.seq1, ...$stages.seq2, ...$stages.seq3, ...$stages.seq4, ...$stages.seq5].map(uid => socprime::$rules[uid])
socprime::hos::chain uid="f4624456-64f9-4344-a259-1054c4cedbe4",
  name="When PUPs Grow Fangs Dragon Boss Solutions Left an Open Door on 25,000+ Endpoints",
  level="high",
  tags=[
