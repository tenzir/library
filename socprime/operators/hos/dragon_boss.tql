    "cfdbe1fa-ff01-44a4-b8e4-782c86099768", // Suspicious Powershell Strings (via cmdline)
    "c77d19cf-3624-4e67-9474-69b44568d39f", // Powershell Executing File In Suspicious Directory Using Bypass Execution Policy (via cmdline)
    "7c01d1e4-89de-476f-a996-eb768978994a", // The Possibility of Execution Through Hidden PowerShell Command Lines (via cmdline)
  ],
  seq3: [
