    "5ed71dac-70f9-4f8d-9cbe-b2c2a6300271", // Powershell Script was Executed from Uncommon Directory (via cmdline)
    "4a73122b-10d6-4465-8cec-c11d616ec1de", // Possible Powershell Executing Process In Suspicious Working Directory (via cmdline)
  ],
  seq4: [
    "017ffc83-da26-4abc-b419-df6f9801cc2c", // Disable Windows Defender Realtime Monitoring and Other Preferences Changes (via cmdline)
    "f9e8820a-f863-4766-9b2b-761cf3702424", // Risky Microsoft Defender Exclusions Added (via cmdline)
    "b6712d1a-1630-4626-9965-5ce22b73986d", // Possible Microsoft Defender Suspending / Abusing Attempt (via cmdline)
  ],
  seq5: [
    "c135e89f-a9e5-4cbe-a86c-a25ffa674f1a", // Suspicious Scheduled Task (via audit)
    "f2c64357-b1d2-41b7-849f-34d2682c0fad", // Suspicious Command Patterns In Scheduled Task Creation
    "4d8473ff-1998-4d2b-ba4b-3709c0cfcc5d", // LOLBAS Schtasks (via cmdline)
