---
description: |
  Detects the SOC Prime High-Order Sigma rule "PHP2Shell, Leaked Critical PHP
  Vulnerabilities (CVE-2026-109618 & CVE-2026-109619)".

  Two critical remote code execution vulnerabilities in PHP, identified as
  CVE-2026-109618 and CVE-2026-109619, were leaked online prior to official
  disclosure. Both bugs trigger during multipart request parsing, before any
  application code runs, and allow attackers to execute arbitrary commands on
  affected web servers. The chain correlates exploitation symptoms (anomalous
  multipart bodies, memory exhaustion, PHP worker crashes) with follow-on web
  shell drops, PHP worker child processes and reverse shell / C2 tooling on
  the same host.

  The rule chains 3 stages of SOC Prime behavior rules by host. See
  `socprime::hos::chain` for the correlation and the resulting Detection
  Finding.
args:
  named:
    - name: timeframe
      type: duration
      default: 30min
      description: The time span that a chain must fit into.
    - name: threshold
      type: float
      default: 0.6
      description: The share of stages a host must cover, between 0 and 1.
    - name: tolerance
      type: duration
      default: 1min
      description: How far findings of a host may arrive out of time order.
---

// Generated by scripts/vendor.py from the SOC Prime HoS rule Riwu9NconRzw.
let $stages = {
  seq0: [
    "42cd03f3-6b9f-49ea-9bf4-ce0caed6f772", // Possible CVE-2026-109618 / CVE-2026-109619 Exploitation Attempt - PHP Memory Exhaustion / PHP Worker Crash (via webserver error logs)
    "0b13c412-f141-490d-a99a-4579ae614795", // Possible CVE-2026-109618 / CVE-2026-109619 Exploitation Attempt - PHP Worker Segfault (via syslog)
  ],
  seq2: [
    "0524fca5-8a89-4d38-9a75-fe7dcba39271", // Possible PHP Worker Spawning Unusual Process (via cmdline)
    "ac652c9a-dd0b-11ec-9d64-0242ac120002", // Suspicious Persistence Activity by Execution Of Shell Commands From Web Service Users And Groups (via auditd)
    "be5f785a-0a7f-438e-be60-0a4fb15adcec", // Possible Web Server or WebApp Exploitation [Windows] (via cmdline)
    "d0372d6b-b7c8-411f-8f20-4861d49494c4", // Possible Web Shell Drop - PHP Script or Web Config File Written by PHP Web Worker [Linux] (via file_event)
    "e7e64200-04ba-479a-9a51-c614bd74c4fb", // Possible Web Shell Drop - PHP Script or Web Config File Written by PHP Web Worker [Windows] (via file_event)
  ],
  seq3: [
    "8715c8a4-9bcb-47e2-ab10-98e6e8eb140c", // Possible php Application Command and Control by Reverse Shell Inline Execution (via cmdline)
    "d5c6360e-6637-44c8-bf60-46018f419a08", // FIFO Special File Creation (via cmdline)
    "e4b95599-8caf-41d4-b0a9-26478d133904", // Possible Data Exfiltration / Reverse Shell via Bash (via cmdline)
    "66b6f425-42f0-484d-b242-64211239f5d0", // Remote File Upload / Download via Standard Tools (via cmdline)
    "12c98d5b-1e6f-457f-a82e-b1240373d14b", // Possible Base64 Encoded Strings Manipulation (via cmdline)
  ],
}
sigma rules=[...$stages.seq0, ...$stages.seq2, ...$stages.seq3].map(uid => socprime::$rules[uid])
socprime::hos::chain uid="a1b2c3d4-e5f6-7a8b-9c0d-123456789abc",
  name="PHP2Shell, Leaked Critical PHP Vulnerabilities (CVE-2026-109618 & CVE-2026-109619)",
  level="critical",
  tags=[
    "attack.initial_access",
    "attack.t1190",
    "attack.persistence",
    "attack.t1505.003",
    "attack.execution",
    "attack.t1059.004",
    "attack.command_and_control",
    "attack.t1095",
  ],
  stages=$stages,
  timeframe=$timeframe,
  threshold=$threshold,
  tolerance=$tolerance
