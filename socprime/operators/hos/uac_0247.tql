sigma rules=[...$stages.seq1, ...$stages.seq2, ...$stages.seq3, ...$stages.seq4].map(uid => socprime::$rules[uid])
socprime::hos::chain uid="9438df10-05d4-424a-81b0-9646ec6497eb",
  name="Hospitals, Local Government Bodies and FPV Operators - Focus of Cyber Threat Cluster UAC-0247",
  level="high",
  tags=[
