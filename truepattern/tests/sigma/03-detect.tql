// The `sigma` operator loads the rule file without warnings. The events match
// the encoded PowerShell rule, the whoami rule, and the rule that starts with a
// document marker.
from {
  metadata: {version: "1.9.0", product: {name: "Synthetic EDR"}},
  category_uid: 1,
  class_uid: 1007,
  activity_id: 1,
  type_uid: 100701,
  device: {os: {type_id: 100}},
  process: {
    file: {path: "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", name: "powershell.exe"},
    cmd_line: "powershell.exe -EncodedCommand ZQBjAGgAbwA=",
  },
}, {
  metadata: {version: "1.9.0", product: {name: "Synthetic EDR"}},
  category_uid: 1,
  class_uid: 1007,
  activity_id: 1,
  type_uid: 100701,
  device: {os: {type_id: 100}},
  process: {
    file: {path: "C:\\Windows\\System32\\whoami.exe", name: "whoami.exe"},
    cmd_line: "whoami /all",
  },
}, {
  metadata: {version: "1.9.0", product: {name: "Synthetic EDR"}},
  category_uid: 1,
  class_uid: 1007,
  activity_id: 1,
  type_uid: 100701,
  device: {os: {type_id: 100}},
  process: {
    file: {path: "C:\\Windows\\System32\\certutil.exe", name: "certutil.exe"},
    cmd_line: "certutil.exe -urlcache -f http://example.com/a.txt a.txt",
  },
}
sigma path=f"{env("TRUEPATTERN_TEST_DIR")}/sigma.yaml"
select uid=finding_info.analytic.uid, title=finding_info.title, severity_id
