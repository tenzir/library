---
assertions:
  fixtures:
    truepattern_taxii:
      pages: 3
---

// Writes the latest version of each valid Sigma rule and forwards it. The
// hunting variant shares its Sigma ID with a newer rule, one rule has invalid
// YAML, and the correlation rule has two documents.
truepattern::feed credential=env("TRUEPATTERN_TEST_CREDENTIAL"),
  base_url=env("TRUEPATTERN_TEST_URL")
truepattern::sigma::update_rules path=f"{env("TRUEPATTERN_TEST_DIR")}/sigma.yaml"
select id, modified, name
