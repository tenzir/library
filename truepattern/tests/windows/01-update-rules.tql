// Only the rules for Windows reach the Windows rule file. The Zeek rule
// matches every event without a DNS query, so it must not see Windows events.
from {type: "indicator", pattern_type: "sigma", id: "indicator--0a000000-0000-4000-8000-000000000001", modified: 2026-09-01T00:00:00Z, name: "Synthetic Whoami Process",
   pattern: "title: Synthetic Whoami Process\nid: 3c2b1a09-8f7e-4d6c-9b5a-4f3e2d1c0b9a\nlogsource:\n    product: windows\n    service: security\ndetection:\n    selection:\n        Channel: Security\n        EventID: 4688\n        NewProcessName|endswith: '\\\\whoami.exe'\n    condition: selection\nlevel: low\n"},
  {type: "indicator", pattern_type: "sigma", id: "indicator--0a000000-0000-4000-8000-000000000002", modified: 2026-09-01T00:00:00Z, name: "Synthetic Auditing Provider",
   pattern: "title: Synthetic Auditing Provider\nid: 4d3c2b1a-0f9e-4d7c-8b6a-5f4e3d2c1b0a\nlogsource:\n    product: windows\n    service: security\ndetection:\n    selection:\n        Provider_Name: Microsoft-Windows-Security-Auditing\n        CommandLine|contains: '/all'\n    condition: selection\nlevel: low\n"},
  {type: "indicator", pattern_type: "sigma", id: "indicator--0a000000-0000-4000-8000-000000000003", modified: 2026-09-01T00:00:00Z, name: "Synthetic Unusual DNS Query",
   pattern: "title: Synthetic Unusual DNS Query\nid: 5e4d3c2b-1a0f-4e8d-9c7b-6a5f4e3d2c1b\nlogsource:\n    product: zeek\n    service: dns\ndetection:\n    selection:\n        query|endswith: '.example'\n    condition: not selection\nlevel: low\n"}
truepattern::sigma::update_rules path=f"{env("TRUEPATTERN_TEST_DIR")}/sigma-windows.yaml",
  product="windows"
select id, name
