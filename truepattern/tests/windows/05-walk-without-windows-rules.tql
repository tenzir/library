// A later walk in which both Windows rules moved to Linux has no rule for the
// Windows file, so the operator writes and forwards nothing.
from {type: "indicator", pattern_type: "sigma", id: "indicator--0a000000-0000-4000-8000-000000000001", modified: 2026-10-01T00:00:00Z, name: "Synthetic Whoami Process",
   pattern: "title: Synthetic Whoami Process\nid: 3c2b1a09-8f7e-4d6c-9b5a-4f3e2d1c0b9a\nlogsource:\n    product: linux\ndetection:\n    selection:\n        Image|endswith: '/whoami'\n    condition: selection\nlevel: low\n"},
  {type: "indicator", pattern_type: "sigma", id: "indicator--0a000000-0000-4000-8000-000000000002", modified: 2026-10-01T00:00:00Z, name: "Synthetic Auditing Provider",
   pattern: "title: Synthetic Auditing Provider\nid: 4d3c2b1a-0f9e-4d7c-8b6a-5f4e3d2c1b0a\nlogsource:\n    product: linux\ndetection:\n    selection:\n        CommandLine|contains: '-a'\n    condition: selection\nlevel: low\n"}
truepattern::sigma::update_rules path=f"{env("TRUEPATTERN_TEST_DIR")}/sigma-windows.yaml",
  product="windows"
select id, name
