// Compare actual instants, not timestamp spellings. Accept both string and
// native time values, and retain the first input when version instants tie.
from {
  id: "indicator--chronological",
  modified: "2026-10-01T10:00:00+02:00",
  name: "Older despite the later local clock",
}, {
  id: "indicator--chronological",
  modified: 2026-10-01T09:00:00Z,
  name: "Latest instant",
}, {
  id: "indicator--tie",
  modified: "2026-10-01T09:00:00Z",
  name: "First at this instant",
}, {
  id: "indicator--tie",
  modified: "2026-10-01T10:00:00+01:00",
  name: "Second spelling of the same instant",
}
truepattern::latest
select id, name
