// A known catalog key must return real OSINT and license metadata, not nulls.
from {
  class_uid: 2004,
  unmapped: {existing: "keep me"},
  category_uid: 2,
  metadata: {version: "1.9.0", profiles: ["security_control"]},
  finding_info: {
    analytic: {uid: "5b1d1e8c-0c51-4a77-9b3e-6f1f0d5e2a01"},
    title: "Synthetic catalog rule",
  },
}
truepattern::enrich
select id=osint[0].external_uid,
  license=unmapped.truepattern.license.name,
  profiles=metadata.profiles,
  rule_text=unmapped.truepattern.rule_text,
  external_references=unmapped.truepattern.external_references,
  existing=unmapped.existing
