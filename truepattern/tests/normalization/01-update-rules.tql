// Every rule must be a single YAML document. The operator removes document
// markers without losing comments and skips rules with several documents.
from {type: "indicator", pattern_type: "sigma", id: "indicator--00000000-0000-4000-8000-000000000001", modified: 2026-09-01T00:00:00Z, name: "plain rule",
   pattern: "title: Synthetic Alpha\nid: 00000000-0000-4000-8000-000000000001\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        CommandLine|contains: 'alpha'\n    condition: selection\nlevel: low\n"},
  {type: "indicator", pattern_type: "sigma", id: "indicator--00000000-0000-4000-8000-000000000002", modified: 2026-09-01T00:00:00Z, name: "leading document marker",
   pattern: "---\ntitle: Synthetic Bravo\nid: 00000000-0000-4000-8000-000000000002\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        CommandLine|contains: 'bravo'\n    condition: selection\nlevel: low\n"},
  {type: "indicator", pattern_type: "sigma", id: "indicator--00000000-0000-4000-8000-000000000003", modified: 2026-09-01T00:00:00Z, name: "Windows line endings",
   pattern: "---\r\ntitle: Synthetic Charlie\r\nid: 00000000-0000-4000-8000-000000000003\r\nlogsource:\r\n    category: process_creation\r\n    product: windows\r\ndetection:\r\n    selection:\r\n        CommandLine|contains: 'charlie'\r\n    condition: selection\r\nlevel: low\r\n"},
  {type: "indicator", pattern_type: "sigma", id: "indicator--00000000-0000-4000-8000-000000000004", modified: 2026-09-01T00:00:00Z, name: "comment before the marker",
   pattern: "# Synthetic header\n\n---\ntitle: Synthetic Delta\nid: 00000000-0000-4000-8000-000000000004\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        CommandLine|contains: 'delta'\n    condition: selection\nlevel: low\n"},
  {type: "indicator", pattern_type: "sigma", id: "indicator--00000000-0000-4000-8000-000000000005", modified: 2026-09-01T00:00:00Z, name: "marker with a comment",
   pattern: "--- # synthetic\ntitle: Synthetic Echo\nid: 00000000-0000-4000-8000-000000000005\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        CommandLine|contains: 'echo'\n    condition: selection\nlevel: low\n"},
  {type: "indicator", pattern_type: "sigma", id: "indicator--00000000-0000-4000-8000-000000000006", modified: 2026-09-01T00:00:00Z, name: "indented marker in a block scalar",
   pattern: "title: Synthetic Foxtrot\nid: 00000000-0000-4000-8000-000000000006\ndescription: |\n    Text with a separator\n    ---\n    inside.\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        CommandLine|contains: 'foxtrot'\n    condition: selection\nlevel: low\n"},
  {type: "indicator", pattern_type: "sigma", id: "indicator--00000000-0000-4000-8000-000000000007", modified: 2026-09-01T00:00:00Z, name: "document end marker",
   pattern: "title: Synthetic Golf\nid: 00000000-0000-4000-8000-000000000007\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        CommandLine|contains: 'golf'\n    condition: selection\nlevel: low\n... # end\n\n"},
  {type: "indicator", pattern_type: "sigma", id: "indicator--00000000-0000-4000-8000-000000000008", modified: 2026-09-01T00:00:00Z, name: "two documents",
   pattern: "title: Synthetic Hotel\nid: 00000000-0000-4000-8000-000000000008\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        CommandLine|contains: 'hotel'\n    condition: selection\nlevel: low\n---\ntitle: Synthetic India\nid: 00000000-0000-4000-8000-000000000009\nlogsource:\n    category: process_creation\n    product: windows\ndetection:\n    selection:\n        CommandLine|contains: 'india'\n    condition: selection\nlevel: low\n"}
truepattern::sigma::update_rules path=f"{env("TRUEPATTERN_TEST_DIR")}/normalized.yaml"
select id, name
