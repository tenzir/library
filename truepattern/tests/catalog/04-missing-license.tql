// The default writer catalogs the newest copy even without license metadata.
// Enrichment keeps its attribution and rule text while the license stays null.
from {
  class_uid: 2004,
  metadata: {version: "1.9.0", profiles: ["security_control"]},
  finding_info: {analytic: {uid: "8f6a2c4d-3b1e-4d5f-a6b7-c8d9e0f1a2b3"}},
}
truepattern::enrich
select id=osint[0].external_uid, license=unmapped.truepattern.license,
  source=osint[0].src_url, rule_text=unmapped.truepattern.rule_text
