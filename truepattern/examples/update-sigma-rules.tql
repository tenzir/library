---
name: Update TruePattern Sigma rules
description: |
  Walks the TruePattern feed daily, replaces the Sigma rule files that the
  detection pipelines read, and updates the rule catalog that enriches their
  findings, regardless of whether license metadata is present.
---

// Runs at 06:00 in the node's local time zone. A walk of all rule versions
// takes a handful of requests, so you can also run it more often for faster
// Sigma rule updates.
cron "0 0 6 * * *" {
  truepattern::feed credential=secret("TRUEPATTERN_CREDENTIAL")
  // Only Security-service rules with no additional logsource constraints.
  fork {
    truepattern::sigma::update_rules path="/var/lib/tenzir/truepattern/sigma-windows-security.yaml",
      logsource={product: "windows", service: "security"}
    discard
  }
  // The complete rule file, whose rules also feed the catalog.
  truepattern::sigma::update_rules path="/var/lib/tenzir/truepattern/sigma.yaml"
  truepattern::ocsf::normalize
  truepattern::update_context
}
