---
name: Detect with TruePattern Sigma rules
description: |
  Reads OCSF events from NDJSON, matches them against the TruePattern Sigma
  rules, and writes enriched detection findings to NDJSON files.
---

// Point this source at your OCSF export, or replace it with a streaming source.
// The `sigma` operator reloads the rule file within 5 seconds of an update.
from_file "/var/log/ocsf/events.ndjson" {
  read_ndjson
}
sigma path="/var/lib/tenzir/truepattern/sigma.yaml"
truepattern::enrich
// Replace this sink with your SIEM or another destination as needed.
to_file "/var/lib/tenzir/truepattern/findings/ocsf-{uuid}.ndjson" {
  write_ndjson
}
